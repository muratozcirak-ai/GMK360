@using GMK360.Core.Entities
@using GMK360.Core.Entities.Construction
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var agency = ViewBag.Agency as Agency;
    var projects = ViewBag.Projects as List<ConstructionProject> ?? new List<ConstructionProject>();
    string subdomain = ViewBag.Subdomain as string ?? agency?.Subdomain ?? "";
    string primaryColor = !string.IsNullOrWhiteSpace(agency?.ThemePrimaryColor) && agency.ThemePrimaryColor.StartsWith("#")
        ? agency.ThemePrimaryColor
        : "#1d4ed8";
    string accentColor = !string.IsNullOrWhiteSpace(agency?.ThemeAccentColor) && agency.ThemeAccentColor.StartsWith("#")
        ? agency.ThemeAccentColor
        : "#f97316";
    bool hasRealLogo = !string.IsNullOrWhiteSpace(agency?.LogoUrl) && agency.LogoUrl != "-" && !agency.LogoUrl.Contains("default-logo");
    bool hasRealBanner = !string.IsNullOrWhiteSpace(agency?.BannerUrl) && agency.BannerUrl != "-";
    ViewData["Title"] = $"{agency?.CompanyName ?? "İnşaat Firması"} • Kurumsal Vitrin";
}

<div class="container py-5 mt-3">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="text-white p-4 p-md-5 position-relative"
             style="background: @(hasRealBanner ? $"linear-gradient(120deg, {primaryColor}e6, {primaryColor}cc), url('{agency!.BannerUrl}') center/cover no-repeat" : $"linear-gradient(135deg, {primaryColor}, {accentColor})")">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    @if (hasRealLogo)
                    {
                        <img src="@agency!.LogoUrl" alt="@agency.CompanyName" style="height:72px;max-width:120px;object-fit:contain;" class="rounded-3 bg-white p-2 shadow-sm" />
                    }
                    <div>
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 mb-2 fw-semibold">
                            Kurumsal İnşaat &amp; Proje Portalı
                        </span>
                        <h1 class="fw-bold h2 mb-1">@(agency?.CompanyName ?? "İnşaat Firması")</h1>
                        <p class="mb-0 opacity-75">
                            @if (!string.IsNullOrWhiteSpace(agency?.Address) && agency.Address != "-")
                            {
                                <span><i class="bi bi-geo-alt-fill me-1"></i>@agency.Address</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(subdomain))
                            {
                                <span class="ms-2 badge bg-dark bg-opacity-25">@($"{subdomain}.gmk360.com")</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(agency?.WhatsAppNumber) && agency.WhatsAppNumber != "-")
                    {
                        var digits = new string(agency.WhatsAppNumber.Where(char.IsDigit).ToArray());
                        if (digits.Length >= 10)
                        {
                            <a href="https://wa.me/@(digits.StartsWith("90") ? digits : "90" + digits.TrimStart('0'))" target="_blank"
                               class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-whatsapp me-1"></i> İletişim
                            </a>
                        }
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a href="/Account/Start" class="btn btn-light fw-bold rounded-pill px-4 shadow-sm" style="color:@primaryColor;">
                            <i class="bi bi-speedometer2 me-1"></i> Firma / Müşteri Paneline Geç &rarr;
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-light fw-bold rounded-pill px-4 shadow-sm" style="color:@primaryColor;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ekip / Müşteri / Taşeron Girişi &rarr;
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="card-body bg-white p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <h5 class="fw-bold mb-0"><i class="bi bi-buildings me-2" style="color:@primaryColor;"></i>Projelerimiz (@projects.Count)</h5>
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(agency?.TaxNumber) && agency.TaxNumber != "-" && agency.TaxNumber != "1111111111")
                    {
                        <span class="badge bg-light text-muted border rounded-pill px-3 py-2">Vergi No: @agency.TaxNumber</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(agency?.WhatsAppNumber) && agency.WhatsAppNumber != "-")
                    {
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                            <i class="bi bi-telephone-fill text-success me-1"></i> @agency.WhatsAppNumber
                        </span>
                    }
                </div>
            </div>
            @if (!projects.Any())
            {
                <div class="alert alert-light border rounded-3 small text-muted mb-0">
                    Firma vitrininde henüz yayınlanmış proje bulunmuyor. Firma yetkilisi olarak giriş yapıp projelerinizi yayınlayabilirsiniz.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var p in projects)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border rounded-4 shadow-xs p-3" style="border-top: 3px solid @primaryColor !important;">
                                <span class="badge rounded-pill mb-2 align-self-start text-white" style="background-color:@accentColor;">@p.Status</span>
                                <h6 class="fw-bold text-dark mb-1">@p.Name</h6>
                                <p class="small text-muted mb-0">@(!string.IsNullOrWhiteSpace(p.Description) ? p.Description : "Devam eden / tamamlanan inşaat projesi.")</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
