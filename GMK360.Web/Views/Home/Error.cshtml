@model ErrorViewModel
@{
    ViewData["Title"] = "Sunucu Hatası";
}
<div class="container text-center py-5 mt-5">
    <h1 class="display-1 text-danger fw-bold">500</h1>
    <h2 class="mb-3">Sunucu Hatası (İşlem Sırasında Beklenmeyen Durum)</h2>
    <p class="lead text-muted">İşlem sırasında teknik bir hata oluştu. Lütfen birkaç saniye sonra tekrar deneyiniz.</p>
    @if (ViewBag.ErrorType != null)
    {
        <div class="alert alert-light border small text-start mx-auto mt-3" style="max-width: 680px;">
            <strong>Teknik Referans:</strong> <code>@ViewBag.ErrorType</code>
            @if (!string.IsNullOrEmpty(ViewBag.ErrorPath as string))
            {
                <span class="ms-2 text-muted">(@ViewBag.ErrorPath)</span>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || (ViewBag.ErrorDetail is string d && d.Contains("Invalid column name", StringComparison.OrdinalIgnoreCase)))
            {
                <div class="mt-1 text-danger"><code>@ViewBag.ErrorDetail</code></div>
            }
        </div>
    }
    <a href="/" class="btn btn-primary rounded-pill px-4 mt-3">Ana Sayfaya Dön</a>
</div>
