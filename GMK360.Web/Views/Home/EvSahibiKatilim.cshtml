@{
    ViewData["Title"] = "Evini Satma & Kiraya Verme";
}

<div class="position-relative overflow-hidden p-3 p-md-5 mt-4 text-center bg-dark text-white rounded-5 shadow-lg" style="background: url('/img/landing/hero_ev_sahibi.jpg') no-repeat center center; background-size: cover; min-height: 70vh; display: flex; align-items: center;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0, 0, 0, 0.65); z-index: 1;"></div>
    
    <div class="col-md-9 mx-auto position-relative" style="z-index: 2;">
        <span class="badge bg-danger px-4 py-2 rounded-pill fs-6 mb-4 shadow-sm">Mülk Sahipleri İçin</span>
        <h1 class="display-3 fw-bolder mb-4 text-white drop-shadow">Evini Sat & Kiraya Ver</h1>
        
        <p class="lead fw-normal mb-5 fs-3 text-light" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
            "Mülkünüzü Şansa Bırakmayın. En İyi Uzmanlarla, En Doğru Fiyata, Hızla Sonuç Alın."
        </p>
        
        <div class="d-flex flex-wrap gap-3 justify-content-center mt-5">
            <a href="#" class="btn btn-danger btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-hover fs-5">
                <i class="fas fa-home me-2"></i> İlan Ver
            </a>
            <a href="#" class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-hover fs-5">
                <i class="fas fa-chart-line me-2"></i> Hızlı Değerleme Al
            </a>
        </div>
    </div>
</div>

<style>
    .transition-hover { transition: all 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.4) !important; }
    .drop-shadow { text-shadow: 2px 2px 5px rgba(0,0,0,0.7); }
</style>
