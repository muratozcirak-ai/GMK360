@{
    ViewData["Title"] = "İletişim - GMK360";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-light py-5">
    <div class="container py-4 text-center">
        <h1 class="display-4 fw-bolder text-navy mb-3">İletişim</h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">Sorularınız, iş ortaklıkları ve demo talepleri için bize ulaşın.</p>
    </div>
</div>

<div class="container py-5 my-3">
    <div class="row g-5">
        <!-- İletişim Bilgileri -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-5">
                    <h4 class="fw-bold text-navy mb-4">Bize Ulaşın</h4>
                    
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-orange bg-opacity-10 text-orange rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-geo-alt-fill fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Merkez Ofis</h6>
                            <p class="text-muted mb-0 small">Ataşehir, İstanbul / Türkiye</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-orange bg-opacity-10 text-orange rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-envelope-fill fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">E-Posta</h6>
                            <p class="text-muted mb-0 small">info@gmk360.com</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center">
                        <div class="bg-orange bg-opacity-10 text-orange rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-telephone-fill fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Telefon</h6>
                            <p class="text-muted mb-0 small">+90 (850) 123 45 67</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5">
                    <h4 class="fw-bold text-navy mb-4">Mesaj Gönderin</h4>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Adınız Soyadınız</label>
                                <input type="text" class="form-control form-control-lg bg-light border-0" placeholder="John Doe">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">E-Posta Adresiniz</label>
                                <input type="email" class="form-control form-control-lg bg-light border-0" placeholder="ornek@sirket.com">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Konu</label>
                                <select class="form-select form-select-lg bg-light border-0">
                                    <option>Demo Talebi</option>
                                    <option>Satış & Fiyatlandırma</option>
                                    <option>Teknik Destek</option>
                                    <option>Diğer</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Mesajınız</label>
                                <textarea class="form-control bg-light border-0" rows="4" placeholder="Size nasıl yardımcı olabiliriz?"></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="button" class="btn btn-orange btn-lg w-100 rounded-pill fw-bold">Mesajı Gönder</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>