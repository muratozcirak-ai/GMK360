@{
    var title = "Yasal Dokümanlar";
    var docType = ViewBag.DocType as string;
    
    if (docType == "kvkk") title = "KVKK Aydınlatma Metni";
    else if (docType == "terms") title = "Kullanım Koşulları";
    else if (docType == "privacy") title = "Gizlilik Politikası";
    
    ViewData["Title"] = title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-navy py-5 text-center text-white" style="min-height: 50vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <i class="bi bi-shield-check text-orange mb-4" style="font-size: 5rem;"></i>
    <h1 class="display-5 fw-bolder mb-3 text-white">@title</h1>
    <p class="lead text-white-50 max-w-700">Hukuk departmanımız tarafından hazırlanan kurumsal dokümanlarımız çok yakında bu sayfada yayına alınacaktır.</p>
</div>
