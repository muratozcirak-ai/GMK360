@{
    ViewData["Title"] = "Hoş Geldiniz";
}

<!-- HERO SECTION -->
<div class="bg-navy text-white text-center py-5" style="background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%); position: relative; overflow: hidden;">
    <!-- Abstract background circles -->
    <div style="position:absolute; top:-50%; left:-10%; width: 500px; height: 500px; background: rgba(249,115,22,0.1); border-radius: 50%; filter: blur(50px);"></div>
    <div style="position:absolute; bottom:-30%; right:-5%; width: 400px; height: 400px; background: rgba(59,130,246,0.2); border-radius: 50%; filter: blur(60px);"></div>

    <div class="container py-5 my-5 position-relative z-1">
        <h1 class="display-4 fw-bolder mb-4" style="letter-spacing: -1px;">
            Yaşam ve İş Alanınızın <br/> 
            <span class="text-orange">İhtiyaç Duyduğu Her Şey</span>
        </h1>
        <p class="lead text-white-50 mb-5 mx-auto" style="max-width: 700px;">
            Bina aidatlarından günlük kiralama süreçlerine, teknik servisten dijital mülk yönetimine kadar tüm yaşam ekosisteminizi tek platformdan yönetin.
        </p>
        
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Account" asp-action="Register" class="btn btn-orange btn-lg px-5 rounded-pill shadow-lg">Ücretsiz Başla</a>
            <a href="#" class="btn btn-outline-light btn-lg px-5 rounded-pill"><i class="ph ph-play-circle me-2"></i>Canlı Demoyu İncele</a>
        </div>
        <p class="mt-4 text-white-50 small"><i class="ph ph-shield-check text-success me-1"></i> Kredi kartı gerekmez. Hemen test edin.</p>
    </div>
</div>

<!-- MODULES SECTION -->
<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h6 class="text-orange fw-bold text-uppercase tracking-wide">360° Çözüm Ekosistemi</h6>
        <h2 class="fw-bold text-navy">İhtiyacınıza Göre Tasarlanmış Modüller</h2>
    </div>

    <div class="row g-4">
        <!-- 1. Bireysel & Kiracı -->
        <div class="col-md-6 col-lg-4">
            <a href="/Cozumler/Bireysel-Kiraci" class="text-decoration-none text-dark card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-lift d-block">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-4 mx-auto" style="width: 70px; height: 70px;">
                    <i class="ph-fill ph-house-line" style="font-size: 32px;"></i>
                </div>
                <h5 class="fw-bold text-navy mb-3">Bireysel ve Kiracı Takip</h5>
                <p class="text-muted small mb-0">Ev sahipleri ve kiracılar için sözleşme, ödeme ve şeffaf dijital borç yönetimi platformu.</p>
            </a>
        </div>

        <!-- 2. Bina & Site Yönetimi -->
        <div class="col-md-6 col-lg-4">
            <a href="/Cozumler/Bina-Site-Yonetimi" class="text-decoration-none text-dark card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-lift d-block">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-4 mx-auto" style="width: 70px; height: 70px;">
                    <i class="ph-fill ph-buildings" style="font-size: 32px;"></i>
                </div>
                <h5 class="fw-bold text-navy mb-3">Bina & Site Yönetimi</h5>
                <p class="text-muted small mb-0">Yöneticiler için aidat tahakkuku, gelir-gider raporları ve dijital karar defteri ekosistemi.</p>
            </a>
        </div>

        <!-- 3. Esnaf, Hizmet & Mimarlık -->
        <div class="col-md-6 col-lg-4">
            <a href="/Cozumler/Esnaf-Hizmet" class="text-decoration-none text-dark card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-lift d-block">
                <div class="d-inline-flex align-items-center justify-content-center bg-orange bg-opacity-10 text-orange rounded-circle mb-4 mx-auto" style="width: 70px; height: 70px;">
                    <i class="ph-fill ph-wrench" style="font-size: 32px;"></i>
                </div>
                <h5 class="fw-bold text-navy mb-3">Esnaf, Hizmet ve Mimarlık</h5>
                <p class="text-muted small mb-0">Ustalar, temizlik firmaları ve mimarlar için kapalı devre iş bulma ve hizmet platformu.</p>
            </a>
        </div>

        <!-- 4. İnşaat & Proje -->
        <div class="col-md-6 col-lg-4">
            <a href="/Cozumler/Insaat-Proje" class="text-decoration-none text-dark card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-lift d-block">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-4 mx-auto" style="width: 70px; height: 70px;">
                    <i class="ph-fill ph-crane" style="font-size: 32px;"></i>
                </div>
                <h5 class="fw-bold text-navy mb-3">İnşaat ve Proje Firmaları</h5>
                <p class="text-muted small mb-0">Yeni konut projeleriniz için blok yönetimi, demirbaş teslimi ve satış sonrası destek.</p>
            </a>
        </div>

        <!-- 5. Günlük Kiralama -->
        <div class="col-md-6 col-lg-4">
            <a href="/Cozumler/Gunluk-Kiralama" class="text-decoration-none text-dark card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-lift d-block">
                <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info rounded-circle mb-4 mx-auto" style="width: 70px; height: 70px;">
                    <i class="ph-fill ph-calendar-check" style="font-size: 32px;"></i>
                </div>
                <h5 class="fw-bold text-navy mb-3">Günlük Kiralama (Airbnb)</h5>
                <p class="text-muted small mb-0">Pansiyon veya yazlık gibi kısa dönem kiralama süreçlerinizi tam entegre takvimle yönetin.</p>
            </a>
        </div>
        
        <!-- 6. Emlak & Danışman -->
        <div class="col-md-6 col-lg-4">
            <a href="/Cozumler/Emlak-Danisman" class="text-decoration-none text-dark card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-lift d-block">
                <div class="d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-10 text-secondary rounded-circle mb-4 mx-auto" style="width: 70px; height: 70px;">
                    <i class="ph-fill ph-handshake" style="font-size: 32px;"></i>
                </div>
                <h5 class="fw-bold text-navy mb-3">Emlak ve Danışman Ofisleri</h5>
                <p class="text-muted small mb-0">İlan portföyünüzü ve kiracı-mal sahibi eşleştirmelerini profesyonel CRM ile yönetin.</p>
            </a>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .hover-lift:hover { transform: translateY(-10px); box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important; }
</style>
