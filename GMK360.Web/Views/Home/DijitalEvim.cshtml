@{
    ViewData["Title"] = "Dijital Evim & Sakin";
}

<!-- HERO -->
<div class="bg-navy text-white py-5" style="background: linear-gradient(135deg, #064e3b 0%, #022c22 100%);">
    <div class="container py-5 my-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-success bg-opacity-25 text-white rounded-pill px-3 py-2 mb-3 border border-success">Mülk Sahipleri ve Kiracılar</span>
                <h1 class="display-4 fw-bolder mb-4">Ev Hayatınızın <br/><span class="text-success">Uzaktan Kumandası</span></h1>
                <p class="lead text-white-50 mb-5">Evinizle ilgili her şeyi telefonunuzdan çözün. Aidatınızı ödeyin, sitenizin güvenlik kamerasına bağlanın, komşularınızla dijitalden tanışın.</p>
                <div class="d-flex gap-3">
                    <a href="/Account/Register?preselect=Individual" class="btn btn-success btn-lg px-5 rounded-pill fw-bold text-white shadow">Sakin Olarak Kayıt Ol</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="https://illustrations.popsy.co/amber/home-office.svg" alt="Dijital Evim" class="img-fluid" style="filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));" />
            </div>
        </div>
    </div>
</div>

<div class="container py-5 mt-4">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h6 class="text-success fw-bold text-uppercase">Akıllı Yaşam</h6>
            <h2 class="fw-bold text-navy">Uygulamadan Evinize Hükmedin</h2>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="p-4 border border-success border-opacity-25 rounded-4 bg-white h-100 shadow-sm">
                <i class="ph-fill ph-credit-card text-success fs-1 mb-3"></i>
                <h5 class="fw-bold">Ödemeler Merkezi</h5>
                <p class="text-muted small">Kiranızı ve site aidatınızı kredi kartıyla otomatik ödeyin. "Acaba ödedim mi?" derdine son verin.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="p-4 border border-warning border-opacity-25 rounded-4 bg-white h-100 shadow-sm">
                <i class="ph-fill ph-wrench text-warning fs-1 mb-3"></i>
                <h5 class="fw-bold">Hızlı Teknik Servis</h5>
                <p class="text-muted small">Evinizde arıza mı var? Çevrenizdeki onaylı elektrikçi ve tesisatçıları saniyeler içinde çağırın.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="p-4 border border-primary border-opacity-25 rounded-4 bg-white h-100 shadow-sm">
                <i class="ph-fill ph-megaphone text-primary fs-1 mb-3"></i>
                <h5 class="fw-bold">Site Panosu</h5>
                <p class="text-muted small">Asansöre asılan kağıtlardan kurtulun. Yönetim duyuruları, havuz kapanış saatleri cebinize bildirim gelsin.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="p-4 border border-info border-opacity-25 rounded-4 bg-white h-100 shadow-sm">
                <i class="ph-fill ph-chat-teardrop-text text-info fs-1 mb-3"></i>
                <h5 class="fw-bold">Komşu İletişimi</h5>
                <p class="text-muted small">Gürültü şikayetini kibarca iletin, ortak etkinlikler düzenleyin, dijital sosyalleşmenin tadını çıkarın.</p>
            </div>
        </div>
    </div>
</div>
