@{
    ViewData["Title"] = "İlk 1000 Kurucu Ofis";
}

<style>
    /* Campaign Page Specific Styles */
    .campaign-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        color: white;
        padding: 6rem 0 4rem 0;
        margin-top: 60px; /* Offset for navbar */
        position: relative;
        overflow: hidden;
    }

    .campaign-hero::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.2), transparent 50%);
        pointer-events: none;
    }

    .hero-heading {
        font-size: 4.5rem;
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        background: linear-gradient(to right, #ffffff, #93c5fd);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 1.4rem;
        font-weight: 400;
        margin-bottom: 2.5rem;
        line-height: 1.6;
        color: #e2e8f0;
    }

    .highlight-text {
        color: #fbbf24;
        font-weight: 700;
        background: rgba(251, 191, 36, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

    .feature-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .feature-list li {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .feature-icon {
        background: rgba(251, 191, 36, 0.1);
        color: #fbbf24;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        border: 1px solid rgba(251, 191, 36, 0.2);
    }

    /* Form Card */
    .form-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .form-control-custom {
        background: white;
        border: none;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        width: 100%;
        margin-bottom: 1rem;
        font-size: 1rem;
        font-family: inherit;
        outline: none;
        transition: all 0.3s ease;
    }

    .form-control-custom:focus {
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.5);
    }

    .btn-warning-custom {
        background: #f59e0b;
        color: white;
        border: none;
        width: 100%;
        padding: 1rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-warning-custom:hover {
        background: #d97706;
        transform: translateY(-2px);
    }

    /* Share Section */
    .share-section {
        background: linear-gradient(90deg, #1e40af 0%, #3b82f6 100%);
        padding: 3rem 0;
        color: white;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .share-btn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 50px;
        padding: 0.75rem 1.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .share-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        transform: translateY(-2px);
    }

    .share-btn.whatsapp:hover { background: #25D366; border-color: #25D366; }
    .share-btn.linkedin:hover { background: #0077b5; border-color: #0077b5; }
    .share-btn.x:hover { background: #000000; border-color: #000000; }

    /* FAQ Section */
    .faq-section {
        padding: 5rem 0;
        background: #f8fafc;
    }

    .accordion-item {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px !important;
        margin-bottom: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .accordion-button {
        font-weight: 600;
        font-size: 1.1rem;
        color: #1e293b;
        padding: 1.5rem;
        background: white;
        box-shadow: none !important;
    }

    .accordion-button:not(.collapsed) {
        background: #f1f5f9;
        color: var(--primary);
    }

    .accordion-body {
        padding: 1.5rem;
        color: #475569;
        font-size: 1.05rem;
        line-height: 1.6;
    }
</style>

<!-- Hero Section -->
<section class="campaign-hero">
    <div class="container">
        <div class="row align-items-center gx-5">
            <div class="col-lg-7 mb-5 mb-lg-0">
                <h1 class="hero-heading">İLK 1000<br />KURUCU OFİS</h1>
                <p class="hero-subtitle">
                    Kurucu Ofislere özel ayrıcalıklarla,<br />
                    Pro Paket'i <span class="highlight-text">ömür boyu</span> en uygun fiyattan kullan.
                </p>
                
                <ul class="feature-list mt-4">
                    <li>
                        <div class="feature-icon">
                            <i class="ph-fill ph-shield-check"></i>
                        </div>
                        <span>Pro Paket'te En Uygun Fiyat Garantisi</span>
                    </li>
                    <li>
                        <div class="feature-icon">
                            <i class="ph-fill ph-storefront"></i>
                        </div>
                        <span>"Kurucu Ofis" Rozeti</span>
                    </li>
                    <li>
                        <div class="feature-icon">
                            <i class="ph-fill ph-infinity"></i>
                        </div>
                        <span>Sınırsız İlan, Sınırsız Kullanıcı</span>
                    </li>
                </ul>
            </div>

            <div class="col-lg-5">
                <div class="form-card">
                    <h3 class="fw-bold mb-2">Kurucu Ofis Ön Başvurusu</h3>
                    <p class="text-light opacity-75 mb-4">Bilgilerinizi bırakın, ekibimiz sizi arasın.</p>
                    
                    <form>
                        <input type="text" class="form-control-custom" placeholder="Ad Soyad" required>
                        <div class="d-flex mb-3 gap-2">
                            <input type="text" class="form-control-custom w-25 mb-0 text-center" value="+90" readonly style="background:#f1f5f9; color:#475569;">
                            <input type="tel" class="form-control-custom w-75 mb-0" placeholder="(5__) __ __ __" required>
                        </div>
                        <input type="text" class="form-control-custom" placeholder="Şirket Adı" required>
                        <select class="form-control-custom" required>
                            <option value="">Şehir Seçin</option>
                            <option value="34">İstanbul</option>
                            <option value="6">Ankara</option>
                            <option value="35">İzmir</option>
                        </select>
                        
                        <button type="button" class="btn-warning-custom mt-3">Kurucu Ofis'e Başvur</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Share Section -->
<section class="share-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h3 class="fw-bold mb-2">İlk 1000 Kurucu Ofis'i <span style="color:#fbbf24;">birlikte büyütelim</span></h3>
                <p class="mb-0 opacity-75" style="font-size:1.1rem;">
                    Çevrendeki firmaları İlk 1000 Kurucu Ofis Programı'na davet edebilirsin.<br />
                    Beraber büyür, sektörü birlikte geliştiririz.
                </p>
                <button class="share-btn mt-4" style="background:rgba(0,0,0,0.2);">
                    <i class="ph ph-link"></i> Linki Kopyala
                </button>
            </div>
            <div class="col-lg-6 text-lg-end">
                <div class="d-flex flex-column align-items-lg-end gap-3">
                    <a href="#" class="share-btn whatsapp w-auto justify-content-start">
                        <i class="ph-fill ph-whatsapp-logo" style="color:#25D366; font-size:1.5rem;"></i> WhatsApp'ta Paylaş
                    </a>
                    <a href="#" class="share-btn linkedin w-auto justify-content-start">
                        <i class="ph-fill ph-linkedin-logo" style="color:#0077b5; font-size:1.5rem;"></i> LinkedIn'de Paylaş
                    </a>
                    <a href="#" class="share-btn x w-auto justify-content-start">
                        <i class="ph-fill ph-x-logo" style="font-size:1.5rem;"></i> X'te Paylaş
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="faq-section">
    <div class="container" style="max-width: 900px;">
        <h2 class="text-center fw-bold mb-5" style="color: #1e293b;">Sıkça Sorulan Sorular</h2>
        
        <div class="accordion" id="faqAccordion">
            <!-- FAQ Item 1 -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="true">
                        Kurucu Ofis nedir?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Kurucu Ofis, GMK360'nın "İlk 1000 Kurucu Ofis Programı" kapsamında kampanyalı Pro Paket satın alan kurumsal firmalara verilen özel statüdür. Kurucu Ofis statüsüne sahip firmalar, programa özel avantajlardan <strong>ömür boyu</strong> yararlanır.
                    </div>
                </div>
            </div>

            <!-- FAQ Item 2 -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2" aria-expanded="false">
                        İlk 1000 Kurucu Ofis Programı'na kimler katılabilir?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Vergi levhası bulunan, gayrimenkul danışmanlığı veya inşaat sektöründe faaliyet gösteren tüm tüzel kişilikler başvuru yapabilir. Başvurular uzman ekibimiz tarafından değerlendirilmektedir.
                    </div>
                </div>
            </div>
            
            <!-- FAQ Item 3 -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" aria-expanded="false">
                        "Sınırsız İlan" paketinin detayları nelerdir?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Sınırsız ilan paketi, ajansınızın veya firmanızın herhangi bir kısıtlamaya tabi olmadan dilediği kadar portföy yayınlamasına olanak tanır. Herhangi bir sürpriz fatura ile karşılaşmazsınız.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
