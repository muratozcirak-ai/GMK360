@{
    ViewData["Title"] = "Bina, Site ve Proje Yönetimi";
}

<div class="position-relative overflow-hidden p-3 p-md-5 mt-4 text-center bg-dark text-white rounded-5 shadow-lg" style="background: url('/img/landing/hero_bina_yonetim.jpg') no-repeat center center; background-size: cover; min-height: 70vh; display: flex; align-items: center;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(0,50,0,0.8) 0%, rgba(0,0,0,0.5) 100%); z-index: 1;"></div>
    
    <div class="col-md-9 mx-auto position-relative" style="z-index: 2;">
        <span class="badge bg-success px-4 py-2 rounded-pill fs-6 mb-4 shadow-sm">Site & Proje Yönetim Sistemi</span>
        <h1 class="display-3 fw-bolder mb-4 text-white drop-shadow">Bina ve Site Yönetimi</h1>
        
        <p class="lead fw-normal mb-5 fs-3 text-light" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
            "Düzenli, Şeffaf ve Kusursuz Yaşam Alanları. Yönetimi Bize Bırakın, Hayatın Tadını Çıkarın."
        </p>
        
        <div class="d-flex flex-wrap gap-3 justify-content-center mt-5">
            <a href="#" class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-hover fs-5">
                <i class="fas fa-building me-2"></i> Yönetim Paneline Git
            </a>
            <a href="#" class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-hover fs-5">
                <i class="fas fa-users-cog me-2"></i> Yöneticiliğe Başvur
            </a>
        </div>
    </div>
</div>

<style>
    .transition-hover { transition: all 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.4) !important; }
    .drop-shadow { text-shadow: 2px 2px 5px rgba(0,0,0,0.7); }
</style>
