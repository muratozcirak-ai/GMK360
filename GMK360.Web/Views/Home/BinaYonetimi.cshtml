@{
    ViewData["Title"] = "Bina & Site Yönetimi";
}

<!-- HERO -->
<div class="bg-navy text-white py-5" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
    <div class="container py-5 my-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-primary bg-opacity-25 text-white rounded-pill px-3 py-2 mb-3 border border-primary">Kapsamlı Yönetim Çözümü</span>
                <h1 class="display-4 fw-bolder mb-4">Mülk Yönetiminde <br/><span class="text-orange">Yeni Dönem</span></h1>
                <p class="lead text-white-50 mb-5">Tekil daireden devasa sitelere, iş merkezlerinden dükkanlara kadar tüm gayrimenkullerinizin finansal ve operasyonel süreçlerini tek merkezden yönetin.</p>
                <div class="d-flex gap-3">
                    <a href="/Account/Register?preselect=Corporate" class="btn btn-orange btn-lg px-5 rounded-pill fw-bold">Hemen Yönetici Olarak Kaydol</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="https://illustrations.popsy.co/amber/work-from-home.svg" alt="Bina Yönetimi" class="img-fluid" style="filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));" />
            </div>
        </div>
    </div>
</div>

<!-- KAPASİTE VE ÖLÇEKLENEBİLİRLİK -->
<div class="container py-5 mt-4">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h6 class="text-orange fw-bold text-uppercase">Sınırları Kaldırın</h6>
            <h2 class="fw-bold text-navy">Her Ölçekteki Mülk İçin Tasarlandı</h2>
            <p class="text-muted mx-auto mt-3" style="max-width: 700px;">İster tek bir daireniz olsun, ister binlerce konutluk bir siteniz. GMK360 altyapısı her senaryoya uyum sağlar.</p>
        </div>
    </div>
    
    <div class="row g-4 justify-content-center">
        <!-- Tekil Daire -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info rounded-circle mb-4 mx-auto" style="width: 60px; height: 60px;">
                    <i class="ph-fill ph-house fs-2"></i>
                </div>
                <h5 class="fw-bold">Tekil Daire Yönetimi</h5>
                <p class="text-muted small">Birden fazla daireniz mi var? Kiracı takibi, kira sözleşmeleri ve düzenli tahsilat işlemlerini dijitale taşıyın.</p>
            </div>
        </div>
        
        <!-- Dükkan & İş Yeri -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mb-4 mx-auto" style="width: 60px; height: 60px;">
                    <i class="ph-fill ph-storefront fs-2"></i>
                </div>
                <h5 class="fw-bold">Dükkan & Ofis Yönetimi</h5>
                <p class="text-muted small">İş yerleri için stopaj takibi, ticari sözleşme yenilemeleri ve mülk giderlerinin profesyonelce yönetimi.</p>
            </div>
        </div>

        <!-- Bina Yönetimi -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-4 mx-auto" style="width: 60px; height: 60px;">
                    <i class="ph-fill ph-buildings fs-2"></i>
                </div>
                <h5 class="fw-bold">Bina (Apartman) Yönetimi</h5>
                <p class="text-muted small">Apartman yöneticileri için aidat toplama, asansör bakımı, temizlik takibi ve şeffaf karar defteri.</p>
            </div>
        </div>
        
        <!-- Site Yönetimi -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-4 mx-auto" style="width: 60px; height: 60px;">
                    <i class="ph-fill ph-city fs-2"></i>
                </div>
                <h5 class="fw-bold">Site & Kompleks Yönetimi</h5>
                <p class="text-muted small">Çok bloklu siteler için; havuz, peyzaj, güvenlik personeli yönetimi ve devasa bütçelerin hatasız kontrolü.</p>
            </div>
        </div>
    </div>
</div>

<!-- ÖZELLİKLER DETAY -->
<div class="bg-light py-5">
    <div class="container py-5">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="https://illustrations.popsy.co/amber/finance.svg" alt="Finans" class="img-fluid" />
            </div>
            <div class="col-lg-6 ps-lg-5">
                <h3 class="fw-bold text-navy mb-4">Otomatik Aidat ve Muhasebe</h3>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex align-items-start">
                        <i class="ph-fill ph-check-circle text-success fs-5 me-3 mt-1"></i>
                        <div>
                            <strong>Kredi Kartı ile Online Tahsilat</strong>
                            <p class="text-muted small mb-0">Banka dolaşmaya, elden para toplamaya son. Sakinleriniz aidatlarını sistem üzerinden Iyzico güvencesiyle anında öder.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="ph-fill ph-check-circle text-success fs-5 me-3 mt-1"></i>
                        <div>
                            <strong>Gecikme Zammı ve Borçlandırma</strong>
                            <p class="text-muted small mb-0">Zamanı geçen ödemelere otomatik yasal gecikme faizi uygulanır, icra takipleri tek tuşla avukat modülüne aktarılır.</p>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="ph-fill ph-check-circle text-success fs-5 me-3 mt-1"></i>
                        <div>
                            <strong>Şeffaf Gelir Gider Tablosu</strong>
                            <p class="text-muted small mb-0">Binanın kasasında ne kadar var? Çatı tamiratına ne ödendi? Tüm sakinler şeffaf bir şekilde görebilir, itimat artar.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
