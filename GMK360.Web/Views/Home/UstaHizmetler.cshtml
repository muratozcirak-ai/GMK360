@{
    ViewData["Title"] = "Usta & Kurumsal Hizmetler";
}

<!-- HERO -->
<div class="bg-navy text-white py-5" style="background: linear-gradient(135deg, #7c2d12 0%, #431407 100%);">
    <div class="container py-5 my-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 mb-3 fw-bold">İşinizi Büyütün</span>
                <h1 class="display-4 fw-bolder mb-4">Binlerce Müşteriye <span class="text-warning">Anında Ulaşın</span></h1>
                <p class="lead text-white-50 mb-5">Tekil ustalardan, dev enerji ve mimarlık firmalarına kadar; GMK360 ekosistemi, işinizi büyütmeniz için gereken tek dijital köprüdür.</p>
                <div class="d-flex gap-3">
                    <a href="/Account/Register?preselect=ServiceProvider" class="btn btn-warning btn-lg px-5 rounded-pill fw-bold text-dark shadow">Hizmet Veren Olarak Kaydol</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="https://illustrations.popsy.co/amber/engineer.svg" alt="Hizmet Veren" class="img-fluid" style="filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));" />
            </div>
        </div>
    </div>
</div>

<!-- KATEGORİLER -->
<div class="container py-5 mt-4">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h6 class="text-orange fw-bold text-uppercase">Hizmet Yelpazemiz</h6>
            <h2 class="fw-bold text-navy">Kimler Bu Platformda Yer Almalı?</h2>
            <p class="text-muted mx-auto mt-3" style="max-width: 800px;">Bireysel ihtiyaçlardan kurumsal site projelerine kadar; hizmet kalitesine güvenen her işletme bu ekosistemin parçası olabilir.</p>
        </div>
    </div>
    
    <div class="row g-4">
        <!-- Kurumlar -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-inline-block mb-3 mx-auto">
                    <i class="ph-fill ph-factory fs-1"></i>
                </div>
                <h4 class="fw-bold text-navy">Kurumsal Çözüm Ortakları</h4>
                <ul class="text-start text-muted small mt-4 list-unstyled lh-lg">
                    <li><i class="ph-bold ph-check text-primary me-2"></i> <strong>Mimarlık & İç Tasarım</strong> Ofisleri</li>
                    <li><i class="ph-bold ph-check text-primary me-2"></i> <strong>Güneş Paneli & Enerji</strong> Firmaları</li>
                    <li><i class="ph-bold ph-check text-primary me-2"></i> <strong>Özel Güvenlik</strong> Şirketleri</li>
                    <li><i class="ph-bold ph-check text-primary me-2"></i> <strong>Profesyonel İlaçlama</strong> Firmaları</li>
                    <li><i class="ph-bold ph-check text-primary me-2"></i> <strong>Asansör Bakım</strong> Şirketleri</li>
                </ul>
            </div>
        </div>

        <!-- Esnaf / Usta -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 bg-warning text-dark px-3 py-1 fw-bold" style="border-bottom-left-radius: 10px;">En Çok Aranan</div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle d-inline-block mb-3 mx-auto mt-3">
                    <i class="ph-fill ph-wrench fs-1"></i>
                </div>
                <h4 class="fw-bold text-navy">Bireysel Ustalar & Esnaf</h4>
                <ul class="text-start text-muted small mt-4 list-unstyled lh-lg">
                    <li><i class="ph-bold ph-check text-warning me-2"></i> Su ve Elektrik <strong>Tesisatçıları</strong></li>
                    <li><i class="ph-bold ph-check text-warning me-2"></i> Boya, Badana ve <strong>Tadilat Ustaları</strong></li>
                    <li><i class="ph-bold ph-check text-warning me-2"></i> Beyaz Eşya & Klima <strong>Servisleri</strong></li>
                    <li><i class="ph-bold ph-check text-warning me-2"></i> Mobilya ve Marangozluk</li>
                    <li><i class="ph-bold ph-check text-warning me-2"></i> Çilingir ve Camcı Hizmetleri</li>
                </ul>
            </div>
        </div>
        
        <!-- Temizlik ve Destek -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle d-inline-block mb-3 mx-auto">
                    <i class="ph-fill ph-broom fs-1"></i>
                </div>
                <h4 class="fw-bold text-navy">Günlük Destek Hizmetleri</h4>
                <ul class="text-start text-muted small mt-4 list-unstyled lh-lg">
                    <li><i class="ph-bold ph-check text-success me-2"></i> Ev ve Ofis <strong>Temizlikçileri</strong></li>
                    <li><i class="ph-bold ph-check text-success me-2"></i> Nakliyat ve <strong>Taşıma Şirketleri</strong></li>
                    <li><i class="ph-bold ph-check text-success me-2"></i> Bahçıvan ve Peyzaj Uzmanları</li>
                    <li><i class="ph-bold ph-check text-success me-2"></i> Kuru Temizleme ve Ütü Servisleri</li>
                    <li><i class="ph-bold ph-check text-success me-2"></i> Havuz Bakım Elemanları</li>
                </ul>
            </div>
        </div>
    </div>
</div>
