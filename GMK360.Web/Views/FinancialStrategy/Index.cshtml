@model IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>
@{
    ViewData["Title"] = "Finansal Strateji ve Karar Destek";
    Layout = "_ConstructionLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white overflow-hidden position-relative">
            <div class="position-absolute top-0 end-0 opacity-25 p-4">
                <i class="bi bi-graph-up-arrow" style="font-size: 8rem;"></i>
            </div>
            <div class="card-body p-4 position-relative z-index-1">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="bi bi-lightbulb-fill text-warning me-2"></i> Finansal Strateji & Karar Destek Kokpiti</h2>
                        <p class="mb-0 fs-5 text-white-50">Ön Fizibilite, Maliyet Genetiği ve TCMB Verileriyle Kur/Enflasyon Koruması</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Makro Ekonomik Kokpit -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-info">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">TCMB Politika Faizi</h6>
                    <span class="badge bg-info bg-opacity-10 text-info p-2 rounded-3"><i class="bi bi-bank"></i> TCMB API</span>
                </div>
                <h2 class="fw-bold text-dark mb-1">%50.00</h2>
                <small class="text-muted"><i class="bi bi-arrow-up-right text-success"></i> Alternatif Getiri Kıyası İçin</small>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-danger">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">Beklenen Yıl Sonu Enflasyon</h6>
                    <span class="badge bg-danger bg-opacity-10 text-danger p-2 rounded-3"><i class="bi bi-graph-up"></i> TCMB OVP</span>
                </div>
                <h2 class="fw-bold text-dark mb-1">%41.50</h2>
                <small class="text-muted"><i class="bi bi-exclamation-triangle text-warning"></i> Gelecek Maliyet Etkisi</small>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-muted mb-0">Asgari Ücret Zam Beklentisi</h6>
                    <span class="badge bg-warning bg-opacity-10 text-warning p-2 rounded-3"><i class="bi bi-person-workspace"></i> İşçilik</span>
                </div>
                <h2 class="fw-bold text-dark mb-1">%35.00</h2>
                <small class="text-muted"><i class="bi bi-hammer text-secondary"></i> Taşeron ve Personel Maliyeti</small>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                <h6 class="fw-bold text-white-50 mb-2">Sistem Projeksiyonu</h6>
                <h3 class="fw-bold text-warning mb-1"><i class="bi bi-bullseye"></i> Hedef Birim Maliyet</h3>
                <h4 class="fw-bold">14.500 ₺ / m²</h4>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Proje Maliyet Genetiği Arşivi -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom p-4">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-archive-fill text-primary me-2"></i> Proje Maliyet Genetiği (Arşiv)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Proje Adı</th>
                                <th>m²</th>
                                <th>Malzeme Gideri</th>
                                <th>İşçilik Gideri</th>
                                <th>Toplam Maliyet</th>
                                <th class="text-end pe-4">Teslim Kuru (USD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Mock Data -->
                            <tr>
                                <td class="ps-4 fw-bold">Beyaz Konak Evleri</td>
                                <td>2.450</td>
                                <td class="text-danger">12.500.000 ₺</td>
                                <td class="text-info">8.200.000 ₺</td>
                                <td class="fw-bold">20.700.000 ₺</td>
                                <td class="text-end pe-4 text-muted">28,50 ₺</td>
                            </tr>
                            <tr>
                                <td class="ps-4 fw-bold">Güneşli Vadi Villaları</td>
                                <td>1.800</td>
                                <td class="text-danger">18.200.000 ₺</td>
                                <td class="text-info">6.100.000 ₺</td>
                                <td class="fw-bold">24.300.000 ₺</td>
                                <td class="text-end pe-4 text-muted">32,10 ₺</td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-center py-3 text-muted">
                                    <small><i class="bi bi-info-circle"></i> Teslim edilen projelerin kesinleşmiş verileridir. Gelecek projelerin Ön Fizibilitesi bu arşivdeki malzeme/işçilik kırılımlarına göre Dolar ve Enflasyon bazlı hesaplanır.</small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Satayım mı, Bekleteyim mi Asistanı -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-light">
            <div class="card-header bg-white border-bottom p-4">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-robot text-success me-2"></i> Satayım mı, Bekleteyim mi?</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-4">Elinizdeki stok dairenin fırsat maliyeti analizini yapmak için güncel değerini girin.</p>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Dairenin Bugünkü Değeri (₺)</label>
                    <input type="text" class="form-control border-secondary" value="10.000.000" disabled>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Karar Vadesi</label>
                    <select class="form-select border-secondary" disabled>
                        <option>6 Ay Sonra</option>
                    </select>
                </div>

                <div class="p-3 bg-white rounded-3 border border-success mb-3 shadow-sm">
                    <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Satar ve Faize/Arsaya Koyarsan:</h6>
                    <h4 class="fw-bold mb-0">12.500.000 ₺</h4>
                    <small class="text-muted">(TCMB Faiz Beklentisi ile)</small>
                </div>

                <div class="p-3 bg-white rounded-3 border border-danger mb-4 shadow-sm">
                    <h6 class="fw-bold text-danger mb-2"><i class="bi bi-house-door-fill me-1"></i> Bekletir ve Sonra Satarsan:</h6>
                    <h4 class="fw-bold mb-0">14.150.000 ₺</h4>
                    <small class="text-muted">(OVP Enflasyon/Maliyet Endeksi ile)</small>
                </div>

                <button class="btn btn-dark w-100 fw-bold py-2" disabled>Yapay Zeka Kararı: BEKLET</button>
            </div>
        </div>
    </div>
</div>