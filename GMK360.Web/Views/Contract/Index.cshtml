@{
    ViewData["Title"] = "Dijital Sözleşmelerim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #2b5876, #4e4376); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Dijital Sözleşmelerim
            </h2>
            <p class="text-muted">Tüm kira, emlakçı yetki ve yer gösterme sözleşmelerinizi dijital olarak yönetin ve PDF olarak indirin.</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Contract/Wizard" class="btn btn-primary rounded-pill shadow-sm px-4">
                <i class="bi bi-file-earmark-plus me-2"></i> Yeni Sözleşme Oluştur
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Quick Filters -->
    <ul class="nav nav-pills mb-4" id="contractTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-bold" data-bs-toggle="pill" data-bs-target="#active" type="button" role="tab">Aktif Sözleşmeler (2)</button>
        </li>
        <li class="nav-item ms-2" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-bold text-muted bg-light" data-bs-toggle="pill" data-bs-target="#drafts" type="button" role="tab">Taslaklar (1)</button>
        </li>
        <li class="nav-item ms-2" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-bold text-muted bg-light" data-bs-toggle="pill" data-bs-target="#expired" type="button" role="tab">Eskiler/Bitenler (4)</button>
        </li>
    </ul>

    <div class="tab-content" id="contractTabsContent">
        <!-- Active Contracts -->
        <div class="tab-pane fade show active" id="active" role="tabpanel">
            <div class="row g-4">
                <!-- Contract Card 1 -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left: 5px solid #11998e !important;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill mb-2">Kira Sözleşmesi</span>
                                    <h5 class="fw-bold text-dark mb-0">Kadıköy 3+1 Daire</h5>
                                    <small class="text-muted">ID: #10550</small>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-circle" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                    <ul class="dropdown-menu border-0 shadow">
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-file-pdf text-danger me-2"></i> PDF İndir</a></li>
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-x-circle text-warning me-2"></i> Feshet</a></li>
                                    </ul>
                                </div>
                            </div>
                            
                            <hr class="text-muted opacity-25">
                            
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Karşı Taraf (Kiracı)</small>
                                    <span class="fw-bold">Ali Yılmaz</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Aylık Tutar</small>
                                    <span class="fw-bold text-primary">35.000 ₺</span>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center text-muted small">
                                <i class="bi bi-calendar-check me-2 text-success"></i> Bitiş: 12 Kasım 2027 (1 Yıl)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contract Card 2 -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left: 5px solid #0052D4 !important;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill mb-2">Emlakçı Yetki Belgesi</span>
                                    <h5 class="fw-bold text-dark mb-0">Beşiktaş Ofis Satışı</h5>
                                    <small class="text-muted">ID: #10294</small>
                                </div>
                                <button class="btn btn-light btn-sm rounded-circle" title="İndir"><i class="bi bi-download"></i></button>
                            </div>
                            
                            <hr class="text-muted opacity-25">
                            
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Yetkili Danışman</small>
                                    <span class="fw-bold">GMK360 Merkez</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Komisyon Oranı</small>
                                    <span class="fw-bold text-primary">%2 + KDV</span>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center text-muted small">
                                <i class="bi bi-calendar-check me-2 text-success"></i> Bitiş: 30 Ekim 2026
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
