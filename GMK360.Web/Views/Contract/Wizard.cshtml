@{
    ViewData["Title"] = "Akıllı Sözleşme Sihirbazı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row mb-5 text-center">
        <div class="col-12">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #11998e, #38ef7d); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Akıllı Sözleşme Oluşturucu
            </h2>
            <p class="text-muted">Kırtasiye evraklarına son! İlan bilgilerini ve tarafları seçin, sistem resmi sözleşmeyi saniyeler içinde (PDF) hazırlasın.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <form action="/Contract/GeneratePDF" method="post">
                    
                    <!-- Adım 1: Sözleşme Tipi -->
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary rounded-circle p-2 me-2">1</span> Sözleşme Tipini Seçin</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <input type="radio" class="btn-check" name="contractType" id="typeRental" value="0" autocomplete="off" checked>
                            <label class="btn btn-outline-success w-100 p-3 rounded-4" for="typeRental">
                                <i class="bi bi-house-door d-block fs-2 mb-2"></i> Kira Sözleşmesi
                            </label>
                        </div>
                        <div class="col-md-6">
                            <input type="radio" class="btn-check" name="contractType" id="typeAgency" value="2" autocomplete="off">
                            <label class="btn btn-outline-primary w-100 p-3 rounded-4" for="typeAgency">
                                <i class="bi bi-file-earmark-person d-block fs-2 mb-2"></i> Emlakçı Yetki Belgesi
                            </label>
                        </div>
                        <div class="col-md-6">
                            <input type="radio" class="btn-check" name="contractType" id="typeShow" value="3" autocomplete="off">
                            <label class="btn btn-outline-info w-100 p-3 rounded-4" for="typeShow">
                                <i class="bi bi-geo-alt d-block fs-2 mb-2"></i> Yer Gösterme Belgesi
                            </label>
                        </div>
                        <div class="col-md-6">
                            <input type="radio" class="btn-check" name="contractType" id="typeSales" value="1" autocomplete="off">
                            <label class="btn btn-outline-warning text-dark w-100 p-3 rounded-4" for="typeSales">
                                <i class="bi bi-cash-coin d-block fs-2 mb-2"></i> Satış Vaadi (Kapora)
                            </label>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 mb-4">

                    <!-- Adım 2: İlgili İlan (Otomatik Doldurma) -->
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary rounded-circle p-2 me-2">2</span> Hangi İlan İçin Yapılıyor?</h5>
                    <div class="mb-4">
                        <label class="form-label text-muted small">Mevcut İlanlarınızdan Birini Seçin (Adres ve Eşya Listesi Otomatik Çekilecektir)</label>
                        <select class="form-select form-select-lg rounded-pill bg-light border-0" name="propertyId">
                            <option value="10550">#10550 - Kadıköy Merkezde 3+1 Daire</option>
                            <option value="10294">#10294 - Beşiktaş Lüks Ofis</option>
                        </select>
                        <div class="form-text text-success mt-2"><i class="bi bi-robot"></i> Sistem seçtiğiniz ilanın DASK numarasını ve Demirbaş listesini sözleşmeye otomatik ekleyecektir.</div>
                    </div>

                    <hr class="text-muted opacity-25 mb-4">

                    <!-- Adım 3: İkinci Taraf Bilgileri -->
                    <h5 class="fw-bold text-dark mb-3"><span class="badge bg-primary rounded-circle p-2 me-2">3</span> Karşı Taraf (Kiracı / Alıcı)</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Ad Soyad / Unvan</label>
                            <input type="text" class="form-control rounded-pill bg-light border-0" name="secondPartyFullName" placeholder="Örn: Ali Yılmaz">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">TCKN / Vergi No</label>
                            <input type="text" class="form-control rounded-pill bg-light border-0" name="secondPartyTc" placeholder="Örn: 12345678901">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted small">Özel Şartlar (Madde 5 vb.)</label>
                            <textarea class="form-control rounded-4 bg-light border-0" name="terms" rows="3" placeholder="Sözleşmeye eklemek istediğiniz özel maddeleri yazın... (Örn: Aidat kiracıya aittir.)"></textarea>
                        </div>
                    </div>

                    <div class="text-end mt-5">
                        <a href="/Contract" class="btn btn-light rounded-pill px-4 me-2">İptal</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-file-pdf me-2"></i> Taslağı Oluştur ve İncele
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
