<!-- Vitrin (Boost) Modal -->
<div class="modal fade" id="boostModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
      <div class="modal-header border-0 bg-primary bg-opacity-10">
        <h5 class="modal-title fw-bold text-primary"><i class="ph ph-lightning text-warning"></i> İlanı Vitrine Taşı</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <h5 id="boostPropertyTitle" class="mb-3 text-truncate fw-bold text-dark"></h5>
        <div class="alert alert-light border shadow-sm p-4 mb-4 rounded-4">
            <h1 class="display-4 fw-bold text-warning mb-0">50 <span class="fs-5 text-muted">Kredi</span></h1>
            <p class="text-muted mb-0 mt-2">30 Günlük Vitrin Süresi</p>
        </div>
        <p class="text-muted">Bu işlem cüzdan bakiyenizden 50 Kredi düşecektir. İlanınız anında tüm sayfalarda "Öne Çıkan" statüsünde sergilenecektir.</p>
        <div id="boostErrorAlert" class="alert alert-danger d-none border-0 rounded-3"></div>
      </div>
      <div class="modal-footer border-0 bg-light rounded-bottom-4">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
        <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold text-dark" id="btnConfirmBoost">
            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span> 
            Onayla ve Öde
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        let currentBoostId = 0;
        const boostModal = new bootstrap.Modal(document.getElementById('boostModal'));
        
        function toggleState(id, newState) {
            if(confirm("İlan durumunu değiştirmek istediğinize emin misiniz?")) {
                $.post('/Property/ToggleState', { id: id }, function(res) {
                    if(res.success) {
                        location.reload();
                    } else {
                        alert("İşlem başarısız oldu.");
                    }
                });
            }
        }

        function discardDraft(id) {
            if(confirm("Bu taslağı tamamen silmek istediğinize emin misiniz?")) {
                $.post('/api/PropertyApi/DiscardDraft?propertyId=' + id, function(res) {
                    if(res.success) {
                        location.reload();
                    } else {
                        alert("Silme işlemi başarısız oldu.");
                    }
                });
            }
        }

        function openBoostModal(id, title) {
            currentBoostId = id;
            document.getElementById('boostPropertyTitle').innerText = title;
            document.getElementById('boostErrorAlert').classList.add('d-none');
            boostModal.show();
        }

        document.getElementById('btnConfirmBoost').addEventListener('click', function() {
            const btn = this;
            btn.disabled = true;
            btn.querySelector('.spinner-border').classList.remove('d-none');
            
            $.post('/Property/BoostProperty', { id: currentBoostId }, function(res) {
                if(res.success) {
                    location.reload();
                } else {
                    const errAlert = document.getElementById('boostErrorAlert');
                    errAlert.innerText = res.message;
                    errAlert.classList.remove('d-none');
                    btn.disabled = false;
                    btn.querySelector('.spinner-border').classList.add('d-none');
                    
                    if(res.redirectUrl) {
                        errAlert.innerHTML += `<br><button onclick="document.getElementById('boostModal').querySelector('.btn-close').click(); document.getElementById('v-pills-wallet-tab').click();" class="btn btn-sm btn-dark mt-3 rounded-pill px-4">Cüzdana Git</button>`;
                    }
                }
            });
        });

        // URL hash kontrolü ile istenen tab'ı açma
        $(document).ready(function() {
            let hash = window.location.hash;
            if(hash) {
                let triggerEl = document.querySelector('button[data-bs-target="' + hash + '"]');
                if(triggerEl) {
                    let tab = new bootstrap.Tab(triggerEl);
                    tab.show();
                }
            }
        });
    </script>
}
