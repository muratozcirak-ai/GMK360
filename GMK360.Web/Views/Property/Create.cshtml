    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            var locationSelects = ['#citySelect', '#districtSelect', '#neighborhoodSelect', '#streetSelect', '#complexSelect'];
            
            locationSelects.forEach(function(id) {
                $(id).select2({
                    theme: "bootstrap-5",
                    width: '100%',
                    placeholder: "Seçiniz..."
                });
            });

            locationSelects.forEach(function(id, index) {
                $(id).on('select2:select', function (e) {
                    for (var i = index + 1; i < locationSelects.length; i++) {
                        var nextId = locationSelects[i];
                        var $next = $(nextId);
                        if ($next.length && !$next.prop('disabled') && $next.is(':visible')) {
                            setTimeout(function() { $next.select2('open'); }, 50);
                            break;
                        }
                    }
                });
            });

            // EİDS Yetki Belgesi Göster/Gizle
            $('#hasAuthorizationSwitch').change(function() {
                if(this.checked) {
                    $('#eidsFields').slideDown();
                } else {
                    $('#eidsFields').slideUp();
                }
            });

            // Taslak Kurtarma Modalı
            var hasDrafts = @(ViewBag.UserDrafts != null && ((IEnumerable<GMK360.Core.Entities.Property>)ViewBag.UserDrafts).Any() ? "true" : "false");
            var draftStep = @(Model?.DraftStep ?? 0);
            
            console.log("hasDrafts:", hasDrafts, "draftStep:", draftStep);
            
            if(hasDrafts) {
                var draftModal = new bootstrap.Modal(document.getElementById('draftRecoveryModal'));
                draftModal.show();
            } else if(draftStep > 1 && draftStep <= 7) {
                setTimeout(function() {
                    moveToStep(draftStep);
                }, 500);
            }
        });

        function discardDraft(propertyId) {
            if(!propertyId || propertyId == "0") return;
            
            if(!confirm("Bu taslağı kalıcı olarak silmek istediğinize emin misiniz?")) return;

            fetch('/api/PropertyApi/DiscardDraft?propertyId=' + propertyId, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
                // Sadece o satırı tablodan kaldır
                var row = document.getElementById('draft-row-' + propertyId);
                if(row) {
                    row.remove();
                }
                
                // Eğer tabloda başka taslak kalmadıysa modalı kapat ve sayfayı yenile
                var tbody = document.querySelector('#draftRecoveryModal tbody');
                if(tbody && tbody.children.length === 0) {
                    window.location.href = '/Property/Create';
                }
            })
            .catch(err => {
                console.error(err);
                alert("Taslak silinirken bir hata oluştu.");
            });
        }

        function verifyEids() {
            var authDoc = document.getElementById('authDocNo').value;
            var ownerId = document.getElementById('ownerIdNo').value;
            
            if(!authDoc || !ownerId) {
                alert("Lütfen Yetki Belgesi Numarası ve Mal Sahibi TC/VKN alanlarını doldurunuz.");
                return;
            }

            var btn = document.getElementById('btnVerifyEids');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Bakanlıktan Doğrulanıyor...';
            btn.disabled = true;

            // Simüle edilmiş bekleme süresi (1.5 saniye)
            setTimeout(function() {
                btn.style.display = 'none';
                document.getElementById('eidsSuccess').style.display = 'block';
                document.getElementById('btnSubmitPublish').disabled = false; // Yayınla Butonunu Aktif Et
            }, 1500);
        }

        // UX İyileştirmesi: Rakam alanlarına tıklandığında içindeki "0" değerini temizle
        document.addEventListener('DOMContentLoaded', function() {
            var numberInputs = document.querySelectorAll('input[type="number"]');
            numberInputs.forEach(function(input) {
                input.addEventListener('focus', function() {
                    if (this.value === '0') {
                        this.value = '';
                    }
                });
                input.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        this.value = '0';
                    }
                });
            });
        });
    
        function openReportBuildingModal() {
            var val = document.getElementById('complexSelect').value;
            if(!val) { alert("Lütfen önce listeden hatalı binayı seçin."); return; }
            var modal = new bootstrap.Modal(document.getElementById('reportBuildingModal'));
            modal.show();
        }

        async function submitBuildingTypo() {
            var val = document.getElementById('complexSelect').value;
            var correctName = document.getElementById('correctBuildingNameInput').value;
            if(!correctName) { alert("Lütfen doğru ismi yazın."); return; }

            await fetch('/api/ComplexApi/ReportBuildingTypo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ BuildingId: parseInt(val), CorrectName: correctName })
            })
            .then(res => res.json())
            .then(data => {
                alert("Bildiriminiz yöneticilere iletildi. En kısa sürede düzeltilecektir. İlan verme işleminize devam edebilirsiniz.");
                bootstrap.Modal.getInstance(document.getElementById('reportBuildingModal')).hide();
            });
        }

        async function submitNewStreet() {
            var streetName = document.getElementById('newStreetNameInput').value;
            var cityId = document.getElementById('citySelect').value;
            var districtId = document.getElementById('districtSelect').value;
            var neighborhoodId = document.getElementById('neighborhoodSelect').value;

            if(!streetName || !neighborhoodId) { alert("Lütfen sokak adını yazın ve mahallenin seçili olduğundan emin olun."); return; }

            await fetch('/api/ComplexApi/CreateUnapprovedStreet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    CityId: parseInt(cityId),
                    DistrictId: parseInt(districtId),
                    NeighborhoodId: parseInt(neighborhoodId),
                    StreetName: streetName 
                })
            })
            .then(res => res.json())
            .then(data => {
                var streetSelect = document.getElementById('streetSelect');
                var opt = document.createElement('option');
                opt.value = data.id;
                opt.innerHTML = data.name + " (Yeni Eklendi)";
                streetSelect.appendChild(opt);
                streetSelect.value = data.id;

                bootstrap.Modal.getInstance(document.getElementById('newStreetModal')).hide();
                streetSelect.dispatchEvent(new Event('change'));
                alert("Yeni sokak sisteme eklendi ve seçildi! Yöneticiler onaylayana kadar işleminize devam edebilirsiniz.");
            });
        }

    function handleUnitInput(el) {
        var container = el.parentElement;
        var inputs = container.querySelectorAll('.unit-input');
        var lastInput = inputs[inputs.length - 1];
        
        var note = document.getElementById('unitNumberNote');
        if (el.value.trim() !== '') {
            if (note) note.style.display = 'block';
        }
        
        if (lastInput.value.trim() !== '') {
            var newInput = document.createElement('input');
            newInput.name = 'UnitNumber';
            newInput.type = 'text';
            newInput.className = 'form-control form-control-lg mb-2 unit-input';
            newInput.placeholder = 'Diğer Daire No (Opsiyonel)';
            newInput.oninput = function() { handleUnitInput(this); };
            container.appendChild(newInput);
        }
    }
