                    .then(data => {
                        var buildingNoInput = document.getElementById('BuildingNumber');
                        if (buildingNoInput) {
                            buildingNoInput.value = data.buildingNumber || '';
                        }
                        
                        var totalFloorsInput = document.getElementById('TotalFloors');
                        var blockContainer = document.getElementById('blockSelectionContainer');
                        var blockSelectDropdown = document.getElementById('blockSelectDropdown');
                        var hasBlockInput = document.getElementById('HasBlock');
                        var blockNameInput = document.getElementById('BlockName');
                        
                        if (data.hasBlocks) {
                            blockContainer.style.display = 'block';
