                        });
                    })
                    .catch(err => console.error('Complex features error:', err));
            } else {
                if(alertBox) alertBox.style.display = 'none';
                // Reset
                document.querySelectorAll('#complexFeaturesContainer .exam-input').forEach(el => {
                    el.checked = false;
                });
            }
        });

        // Location API Fetch
        document.addEventListener('DOMContentLoaded', function() {
            // UserType Kimden Filtreleme
            var fromWhomItems = document.querySelectorAll('#fromWhomList .fromwhom-item');
            var defaultClicked = false;
            fromWhomItems.forEach(function(item) {
                var code = item.getAttribute('data-code');
                var show = true;
                
                if (currentUserType === 'Individual') {
                    show = (code === 'OWNER');
                } else if (currentUserType === 'Consultant') {
                    show = (code === 'CONSULTANT' || code === 'AGENCY');
                } else if (currentUserType === 'Corporate') {
                    show = (code !== 'OWNER' && code !== 'CONSULTANT');
                }
                
                if (show) {
                    item.style.display = 'block';
                    if (!defaultClicked) {
                        item.click(); // Otomatik olarak ilk uygun olanı seç
                        defaultClicked = true;
                    }
                } else {
                    item.style.display = 'none';
                    item.classList.remove('active', 'fw-bold');
                }
            });

            // Matrix Toggle Logic
            document.addEventListener('change', function(e) {
                if (e.target && e.target.classList.contains('matrix-toggle')) {
                    var detailsDiv = e.target.closest('.row.align-items-center').querySelector('.matrix-details');
                    if (detailsDiv) {
                        detailsDiv.style.display = e.target.checked ? 'block' : 'none';
                    }
                }
            });

            // Zorunlu alanlara kırmızı yıldız ekle
            var requiredInputs = document.querySelectorAll('input[data-val-required], select[data-val-required], textarea[data-val-required]');
            requiredInputs.forEach(function(input) {
                var label = document.querySelector('label[for="' + input.id + '"]');
                if (label && !label.innerHTML.includes('text-danger')) {
                    label.innerHTML += ' <span class="text-danger">*</span>';
                }
            });

            var citySelect = document.getElementById('citySelect');
            var districtSelect = document.getElementById('districtSelect');
            var neighborhoodSelect = document.getElementById('neighborhoodSelect');
            var streetSelect = document.getElementById('streetSelect');
            var complexSelect = document.getElementById('complexSelect');

            // 1. İlleri Yükle
            fetch('/api/Location/Cities')
                .then(res => res.json())
                .then(data => {
                    citySelect.innerHTML = '<option value="">İl Seçiniz...</option>';
                    data.forEach(city => {
                        citySelect.innerHTML += `<option value="${city.id}">${city.name}</option>`;
                    });
                });

            // 2. İlçe Yükle
            citySelect.addEventListener('change', function() {
                var cityId = this.value;
                districtSelect.innerHTML = '<option value="">Yükleniyor...</option>';
                neighborhoodSelect.innerHTML = '<option value="">Önce İlçe Seçiniz...</option>';
                streetSelect.innerHTML = '<option value="">Önce Mahalle Seçiniz...</option>';
                
                if(!cityId) {
                    districtSelect.innerHTML = '<option value="">Önce İl Seçiniz...</option>';
                    return;
                }

                fetch('/api/Location/Districts/' + cityId)
                    .then(res => res.json())
                    .then(data => {
                        districtSelect.innerHTML = '<option value="">İlçe Seçiniz...</option>';
                        let currentGroup = '';
                        let html = '';
                        data.forEach(d => {
                            if(d.regionName) {
                                if(currentGroup !== d.regionName) {
                                    if(currentGroup !== '') html += '</optgroup>';
                                    currentGroup = d.regionName;
                                    html += `<optgroup label="${currentGroup}">`;
                                }
                            } else {
                                if(currentGroup !== '') {
                                    html += '</optgroup>';
                                    currentGroup = '';
                                }
                            }
                            html += `<option value="${d.id}">${d.name}</option>`;
                        });
                        if(currentGroup !== '') html += '</optgroup>';
                        districtSelect.innerHTML += html;
                    });
            });

            // 3. Mahalle Yükle
            districtSelect.addEventListener('change', function() {
                var districtId = this.value;
                neighborhoodSelect.innerHTML = '<option value="">Yükleniyor...</option>';
                streetSelect.innerHTML = '<option value="">Önce Mahalle Seçiniz...</option>';

                if(!districtId) {
                    neighborhoodSelect.innerHTML = '<option value="">Önce İlçe Seçiniz...</option>';
                    return;
                }

                fetch('/api/Location/Neighborhoods/' + districtId)
                    .then(res => res.json())
                    .then(data => {
                        neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçiniz...</option>';
                        if(data && data.length > 0) {
                            data.forEach(n => {
                                neighborhoodSelect.innerHTML += `<option value="${n.id}">${n.name}</option>`;
                            });
                        } else {
                            neighborhoodSelect.innerHTML = '<option value="">Mahalle Bulunamadı</option>';
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        neighborhoodSelect.innerHTML = '<option value="">Hata Oluştu</option>';
                    });
            });

            // 4. Sokak Yükle
            neighborhoodSelect.addEventListener('change', function() {
                var neighborhoodId = this.value;
                streetSelect.innerHTML = '<option value="">Yükleniyor...</option>';
                complexSelect.innerHTML = '<option value="">Yükleniyor...</option>';
                
                // POI'leri Yükle (Otomatik Bilgilendirme)
                fetch('/api/Location/POIs/' + neighborhoodId)
                    .then(res => res.json())
                    .then(data => {
                        var container = document.getElementById('poiContainer');
                        var list = document.getElementById('poiList');
                        list.innerHTML = '';
                        if(data && data.length > 0) {
                            container.style.display = 'block';
                            
                            // Kategorilere göre grupla
                            var groupedData = {};
                            data.forEach(p => {
                                if(!groupedData[p.categoryName]) groupedData[p.categoryName] = [];
                                groupedData[p.categoryName].push(p);
                            });

                            for (var category in groupedData) {
                                var html = `<div class="col-md-6 mb-3">
                                                <h6 class="text-secondary border-bottom pb-1">${category}</h6>
                                                <div class="d-flex flex-wrap gap-2 mt-2">`;
                                
                                groupedData[category].forEach(p => {
                                    html += `<span class="badge bg-light text-dark border"><i class="ph ph-check-circle text-success"></i> ${p.poiName} <small class="text-muted ms-1">(${Math.round(p.distanceInMeters)}m)</small></span>`;
                                });
                                
                                html += `</div></div>`;
                                list.innerHTML += html;
                            }
                        } else {
                            container.style.display = 'none';
                        }
                    })
                    .catch(err => console.error("POI yüklenirken hata:", err));

                if(!neighborhoodId) {
                    streetSelect.innerHTML = '<option value="">Önce Mahalle Seçiniz...</option>';
                    complexSelect.innerHTML = '<option value="">Önce Konum Seçiniz...</option>';
                    return;
                }

                // Sokakları Yükle
                fetch('/api/Location/Streets/' + neighborhoodId)
                    .then(res => res.json())
                    .then(data => {
                        if(data && data.length > 0) {
                            streetSelect.innerHTML = '<option value="">Sokak/Cadde Seçiniz...</option>';
                            data.forEach(s => {
                                streetSelect.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                            });
                        } else {
                            streetSelect.innerHTML = '<option value="">Bu mahalleye kayıtlı sokak yok</option>';
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        streetSelect.innerHTML = '<option value="">Hata Oluştu</option>';
                    });
                    
                // Binaları Yükle
                fetch('/api/ComplexApi/GetByNeighborhood/' + neighborhoodId)
                    .then(res => res.json())
                    .then(data => {
                        if(data && data.results && data.results.length > 0) {
                            complexSelect.innerHTML = '<option value="">Bina/Site Seçiniz...</option>';
                            data.results.forEach(c => {
                                complexSelect.innerHTML += `<option value="${c.id}">${c.text}</option>`;
                            });
                        } else {
                            complexSelect.innerHTML = '<option value="">Bu konumda kayıtlı bina/site yok</option>';
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        complexSelect.innerHTML = '<option value="">Hata Oluştu</option>';
                    });
            });
        });

        var modalMap = null;
        var modalMarker = null;

        document.getElementById('newComplexModal').addEventListener('shown.bs.modal', function () {
            var lat = 41.0082;
            var lng = 28.9784; // Default İstanbul
            
            var reverseGeocodeModal = function(lat, lng) {
                fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`)
                    .then(res => res.json())
                    .then(data => {
                        if (data && data.address) {
                            var roadName = data.address.road || data.address.pedestrian;
                            if (roadName) {
                                window.lastDetectedRoadName = roadName;
                                // We don't modify the dropdown here anymore to avoid annoying the user during pin drag.
                                // It will be handled during saveNewComplex.
                            }
                        }
                    })
                    .catch(err => console.error("Reverse geocode error:", err));
            };

            var initMap = function(latitude, longitude, zoomLevel) {
                if (!modalMap) {
                    modalMap = L.map('modalMap').setView([latitude, longitude], zoomLevel);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19
                    }).addTo(modalMap);

                    modalMarker = L.marker([latitude, longitude], { draggable: true }).addTo(modalMap);
                    
                    document.getElementById('ncLat').value = latitude.toFixed(6);
                    document.getElementById('ncLng').value = longitude.toFixed(6);

                    modalMarker.on('dragend', function (e) {
                        var position = modalMarker.getLatLng();
                        document.getElementById('ncLat').value = position.lat.toFixed(6);
                        document.getElementById('ncLng').value = position.lng.toFixed(6);
                        reverseGeocodeModal(position.lat, position.lng);
                    });

                    modalMap.on('click', function(e) {
                        modalMarker.setLatLng(e.latlng);
                        document.getElementById('ncLat').value = e.latlng.lat.toFixed(6);
                        document.getElementById('ncLng').value = e.latlng.lng.toFixed(6);
                        reverseGeocodeModal(e.latlng.lat, e.latlng.lng);
                    });
                } else {
                    setTimeout(function() {
                        modalMap.invalidateSize();
                        modalMap.setView([latitude, longitude], zoomLevel);
                        modalMarker.setLatLng([latitude, longitude]);
                        document.getElementById('ncLat').value = latitude.toFixed(6);
                        document.getElementById('ncLng').value = longitude.toFixed(6);
                    }, 100);
                }
            };
            
            // Eğer formda seçili il/ilçe varsa onun koordinatını geocode edelim
            var citySelect = document.getElementById('citySelect');
            var distSelect = document.getElementById('districtSelect');
            var neighSelect = document.getElementById('neighborhoodSelect');
            var streetSelect = document.getElementById('streetSelect');
            
            var cityName = citySelect.options[citySelect.selectedIndex]?.text || '';
            var distName = distSelect.options[distSelect.selectedIndex]?.text || '';
            var neighName = neighSelect.options[neighSelect.selectedIndex]?.text || '';
            
            if(cityName && distName && neighName) {
                var query = `${neighName}, ${distName}, ${cityName}, Turkey`;
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`)
                    .then(res => res.json())
                    .then(data => {
                        if(data && data.length > 0) {
                            initMap(parseFloat(data[0].lat), parseFloat(data[0].lon), 16);
                        } else {
                            // Bulamazsa sadece İlçe/İl ile dene
                            var fallbackQuery = `${distName}, ${cityName}, Turkey`;
                            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(fallbackQuery)}&limit=1`)
                                .then(res => res.json())
                                .then(data2 => {
                                    if(data2 && data2.length > 0) {
                                        initMap(parseFloat(data2[0].lat), parseFloat(data2[0].lon), 14);
                                    } else {
                                        initMap(lat, lng, 14);
                                    }
                                }).catch(() => initMap(lat, lng, 14));
                        }
                    })
                    .catch(err => {
                        console.error("Geocoding failed", err);
                        initMap(lat, lng, 14);
                    });
            } else {
                initMap(lat, lng, 14);
            }
        });

