@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Matrix Complex Logic
        function syncRadioSelectionComplex(radioElement, featureIndex, questionId) {
            var allHiddenForQuestion = document.querySelectorAll('.radio-hidden-sync-complex-' + questionId);
            allHiddenForQuestion.forEach(function(el) {
                el.value = 'false';
            });
            var myHidden = document.getElementById('hiddenComplex_' + radioElement.value);
            if(myHidden) {
                myHidden.value = 'true';
            }
        }

        var currentUserType = '@ViewBag.UserType';

        // UI Toggle Logic
        function toggleSiteLogic() {
            var isSiteInput = document.getElementById('hdnIsSite');
            var isSite = isSiteInput ? (isSiteInput.value === 'true') : false;
            
            var lblSelect = document.getElementById('lblComplexSelect');
            var btnNew = document.getElementById('btnNewComplex');
            
            function onBlockSelected() {
                var select = document.getElementById('blockSelectDropdown');
                var selectedOption = select.options[select.selectedIndex];
                
                var blockNameEl = document.getElementById('BlockName');
                var totalFloorsEl = document.getElementById('TotalFloors');
                
                if (selectedOption && selectedOption.value) {
                    if (blockNameEl) blockNameEl.value = selectedOption.value;
                    if (totalFloorsEl) totalFloorsEl.value = selectedOption.dataset.floors || '';
                } else {
                    if (blockNameEl) blockNameEl.value = '';
                    if (totalFloorsEl) totalFloorsEl.value = '';
                }
            } 
            
            if(isSite) {
                if(lblSelect) lblSelect.innerText = 'Site Seçiniz';
                if(btnNew) btnNew.innerHTML = '<i class="ph ph-plus"></i> Listede yoksa ekle ve haritadan seç';
            } else {
                if(lblSelect) lblSelect.innerText = 'Bina / Apartman Seçiniz';
                if(btnNew) btnNew.innerHTML = '<i class="ph ph-plus"></i> Listede yoksa ekle ve haritadan seç';
            }
        }
        
        function toggleBlockLogic() {
            var hasBlock = document.getElementById('HasBlock').checked;
            if(hasBlock) {
                document.getElementById('blockNameInputArea').style.display = 'block';
            } else {
                document.getElementById('blockNameInputArea').style.display = 'none';
            }
        }

        // Wizard Logic
        function validateStep(currentStep) {
            if (currentStep === 1) {
                var status = document.getElementById('hdnStatus').value;
                if(!status) { alert("Lütfen işlem tipi seçiniz (Satılık, Kiralık vb.)."); return false; }
                var type = document.getElementById('hdnType').value;
                if(!type) { alert("Lütfen emlak türü seçiniz (Konut, İş Yeri vb.)."); return false; }
                var subType = document.getElementById('hdnSubType').value;
                if(!subType) { alert("Lütfen alt tür seçiniz (Daire, Ofis vb.)."); return false; }
                
                if (currentSubTypeCode === 'RES_DAIRE' || currentSubTypeCode === 'RES_VILLA') {
                    var isSite = document.getElementById('hdnIsSite').value;
                    if(isSite === '') { alert("Lütfen Yapı Tipi seçiniz (Site İçi veya Bağımsız Bina)."); return false; }
                }
            }
            else if (currentStep === 2) {
                var city = document.getElementById('citySelect').value;
                if(!city) { alert("İl seçimi zorunludur."); return false; }
                var dist = document.getElementById('districtSelect').value;
                if(!dist) { alert("İlçe seçimi zorunludur."); return false; }
                var neigh = document.getElementById('neighborhoodSelect').value;
                if(!neigh) { alert("Mahalle seçimi zorunludur."); return false; }
                var comp = document.getElementById('complexSelect').value;
                if(!comp) { alert("Bina / Yapı seçimi zorunludur. Listede bina yoksa 'Listede yoksa ekle ve haritadan seç' butonunu kullanın."); return false; }
            }
            else if (currentStep === 3) {
                var requiredIds = ['Title', 'Price', 'GrossArea', 'NetArea'];
                var labels = { 'Title': 'İlan Başlığı', 'Price': 'Fiyat', 'GrossArea': 'Brüt m²', 'NetArea': 'Net m²' };
                for(let id of requiredIds) {
                    var el = document.getElementById(id);
                    if(el && !el.value.trim()) {
                        alert(labels[id] + " alanı zorunludur.");
                        el.focus();
                        return false;
                    }
                }
                
                var hasBlock = document.getElementById('HasBlock');
                if (hasBlock && hasBlock.value === 'true') {
                    var dropdown = document.getElementById('blockSelectDropdown');
                    if (!dropdown || !dropdown.value) {
                        alert("Lütfen bulunduğunuz bloğu seçiniz.");
                        if(dropdown) dropdown.focus();
                        return false;
                    }
                    var blockNameEl = document.getElementById('BlockName');
                    if(blockNameEl) blockNameEl.value = dropdown.value;
                }
                var unitNo = document.getElementById('UnitNumber');
                if(unitNo && !unitNo.value.trim()) { alert("İç Kapı / Daire No alanı zorunludur."); unitNo.focus(); return false; }
            }
            return true;
        }

        function nextStep(step) {
            var currentStep = step - 1;
            if (currentStep > 0 && !validateStep(currentStep)) {
                return;
            }

            autoSaveDraft(currentStep);

            moveToStep(step);
        }

        function autoSaveDraft(step) {
            var form = document.getElementById('propertyWizardForm');
            if(!form) return;
            var formData = new FormData(form);
            formData.set('DraftStep', step);

            fetch('/Property/SaveDraft', {
                method: 'POST',
                body: formData // Form data sends natively as multipart/form-data
            })
            .then(res => res.json())
            .then(data => {
                if(data.success && data.draftId > 0) {
                    var idInput = document.querySelector('input[name="Id"]');
                    if(idInput) {
                        idInput.value = data.draftId;
                    }
                    showDraftSavedToast();
                }
            })
            .catch(err => console.log('Draft save error:', err));
        }

        // Otomatik kaydetme için zamanlayıcı (Debounce)
        var draftTimer = null;
        document.addEventListener('input', function(e) {
            if(e.target.closest('#propertyWizardForm')) {
                clearTimeout(draftTimer);
                draftTimer = setTimeout(function() {
                    var currentStep = 1;
                    document.querySelectorAll('.step-item').forEach(function(item) {
                        if(item.classList.contains('active')) {
                            currentStep = parseInt(item.getAttribute('data-step'));
                        }
                    });
                    autoSaveDraft(currentStep);
                }, 5000); // 5 saniye hareketsizlik sonrası otomatik kaydet
            }
        });

        function showDraftSavedToast() {
            var toast = document.getElementById('draftToast');
            if(!toast) {
                var html = '<div id="draftToast" style="position:fixed; bottom:20px; right:20px; background:#28a745; color:white; padding:10px 20px; border-radius:5px; z-index:9999; box-shadow:0 4px 6px rgba(0,0,0,0.1); display:none; transition: opacity 0.5s;">Taslak otomatik kaydedildi <i class="ph ph-check-circle"></i></div>';
                document.body.insertAdjacentHTML('beforeend', html);
                toast = document.getElementById('draftToast');
            }
            toast.style.display = 'block';
            toast.style.opacity = '1';
            setTimeout(function(){ toast.style.opacity = '0'; setTimeout(()=> toast.style.display='none', 500); }, 3000);
        }

        function moveToStep(step) {
            if (step === 2) {
                var isSite = currentSubTypeCode.includes('SITE') || currentSubTypeCode.includes('RESIDENCE');
                document.getElementById('IsSite').value = isSite ? 'true' : 'false';
                var buildingTitle = document.getElementById('step2BuildingTitle');
                if (buildingTitle) {
                    buildingTitle.innerHTML = isSite ? '<i class="ph ph-buildings"></i> Site / Kompleks Detayları' : '<i class="ph ph-buildings"></i> Bina / Apartman Detayları';
                }
                toggleSiteLogic();
            }
            if (step === 3) {
                updateSummaryHeader();
                var mustakilCodes = ['RES_MUSTAKIL', 'RES_VILLA', 'RES_CIFT', 'RES_YAZLIK', 'RES_VILLA_BINA', 'RES_VILLA_SITE'];
                var isMustakil = mustakilCodes.includes(currentSubTypeCode);
                if (isMustakil) {
                    var elFloor = document.getElementById('floorNumberContainer');
                    if (elFloor) elFloor.style.display = 'none';
                    var elBlock = document.getElementById('blockContainer');
                    if (elBlock) elBlock.style.display = 'none';
                } else {
                    var elFloor = document.getElementById('floorNumberContainer');
                    if (elFloor) elFloor.style.display = 'block';
                    var elBlock = document.getElementById('blockContainer');
                    if (elBlock) elBlock.style.display = 'block';
                }
            }
            if (step === 4) {
                var isSiteInput = document.getElementById('IsSite');
                var isSite = isSiteInput ? (isSiteInput.value === 'true') : false;
                var step4Title = document.getElementById('step4Title');
                var step4HeaderTitle = document.getElementById('step4HeaderTitle');
                if (step4Title) {
                    if (isSite) {
                        step4Title.innerHTML = '4. Adım: Site Özellikleri';
                        if(step4HeaderTitle) step4HeaderTitle.innerHTML = 'Site Özellikleri';
                    } else {
                        step4Title.innerHTML = '4. Adım: Yapı Özellikleri';
                        if(step4HeaderTitle) step4HeaderTitle.innerHTML = 'Yapı Özellikleri';
                    }
                }
            }
            if (step === 5) {
                // Akıllı Banyo Tikleme Logic (Banyo sayısı 2 ve üzeriyse otomatik Ebeveyn ve Duşakabin tikle)
                var bathroomCountInput = document.getElementById('BathroomCount');
                if (bathroomCountInput && parseInt(bathroomCountInput.value) >= 2) {
                    document.querySelectorAll('label.form-check-label').forEach(lbl => {
                        var text = lbl.innerText.trim();
                        if (text === 'Ebeveyn Banyosu' || text === 'Duşakabin') {
                            var checkboxId = lbl.getAttribute('for');
                            if (checkboxId) {
                                var checkbox = document.getElementById(checkboxId);
                                if (checkbox && !checkbox.checked) {
                                    checkbox.checked = true;
                                    checkbox.dispatchEvent(new Event('change')); // Varsa tetikleyicileri çalıştır
                                }
                            }
                        }
                    });
                }
            }

            document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');
            updateHeader(step);
        }
        function prevStep(step) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');
            updateHeader(step);
        }
        function updateHeader(currentStep) {
            for(let i=1; i<=8; i++) {
                const item = document.querySelector(`.step-item[data-step="${i}"]`);
                if(item) {
                    if(i < currentStep) {
                        item.classList.add('completed');
                        item.classList.remove('active');
                    } else if (i === currentStep) {
                        item.classList.add('active');
                        item.classList.remove('completed');
                    } else {
                        item.classList.remove('active', 'completed');
                    }
                }
                const line = document.getElementById('line' + i);
                if(line) {
                    line.style.width = (i < currentStep) ? '100%' : '0%';
                }
            }
        }

        // Smart UI Logic - Bathrooms
        function checkBathroomLogic() {
            var val = document.getElementById('bathroomSelect').value;
            var msg = document.getElementById('ensuiteMsg');
            if(parseInt(val) >= 2) {
                msg.style.display = 'block';
            } else {
                msg.style.display = 'none';
            }
        }

        // Smart UI Logic - Parking
        function checkParkingLogic() {
            var val = document.getElementById('parkingSelect').value;
            var alert = document.getElementById('lpgAlert');
            if(val === 'Kapalı') {
                alert.style.display = 'block';
            } else {
                alert.style.display = 'none';
            }
        }

        // Smart UI Logic - Furnished
        function checkFurnishedLogic() {
            var val = document.getElementById('furnishedSelect').value;
            var div = document.getElementById('furnishedDetailsWrap');
            if(val === 'true') {
                div.style.display = 'block';
            } else {
                div.style.display = 'none';
            }
        }

        // Category Selection UI (Open Lists)
        function selectStatusList(id, code, el) {
            document.getElementById('hdnStatus').value = id;
            
            // Remove active classes from siblings
            var siblings = document.querySelectorAll('#statusList .list-group-item');
            siblings.forEach(s => {
                s.classList.remove('active', 'fw-bold');
            });
            
            // Add active class to clicked item
            el.classList.add('active', 'fw-bold');
            
            if(code === 'DAILY') {
                document.getElementById('dailyRentAlert').style.display = 'block';
            } else {
                document.getElementById('dailyRentAlert').style.display = 'none';
            }
        }

        function selectTypeList(id, code, el) {
            document.getElementById('hdnType').value = id;
            
            // Remove active classes from siblings
            var siblings = document.querySelectorAll('#typeList .list-group-item');
            siblings.forEach(s => {
                s.classList.remove('active', 'fw-bold');
            });
            
            // Add active class to clicked item
            el.classList.add('active', 'fw-bold');
            
            if(code === 'TIMESHARE') {
                document.getElementById('timeshareDetails').style.display = 'block';
            } else {
                document.getElementById('timeshareDetails').style.display = 'none';
            }

            var landSection = document.getElementById('landDetailsSection');
            if(landSection) {
                if(code === 'LAND' || code.includes('ARSA') || el.innerText.trim().toUpperCase().includes('ARSA')) {
                    landSection.style.display = 'block';
                } else {
                    landSection.style.display = 'none';
                }
            }

            // FILTER: Devren Satılık/Kiralık only for COMMERCIAL or TOURISM
            var statusItems = document.querySelectorAll('#statusList .status-item');
            statusItems.forEach(s => {
                var sCode = s.getAttribute('data-code');
                if (sCode && sCode.startsWith('DEVREN_')) {
                    if (code === 'COMMERCIAL' || code === 'TOURISM') {
                        s.style.display = 'block';
                    } else {
                        s.style.display = 'none';
                        if (s.classList.contains('active')) {
                            s.classList.remove('active', 'fw-bold');
                            document.getElementById('hdnStatus').value = '';
                        }
                    }
                }
            });

            // FILTER: SubTypes
            var subTypeItems = document.querySelectorAll('#subTypeList .subtype-item');
            subTypeItems.forEach(s => {
                var parentCode = s.getAttribute('data-parent');
                if (parentCode === code) {
                    s.style.display = 'block';
                } else {
                    s.style.display = 'none';
                    s.classList.remove('active', 'fw-bold');
                }
            });

            document.getElementById('hdnSubType').value = '';
        }

