                        // Önce tüm matrix seçimlerini temizle
                        document.querySelectorAll('#complexFeaturesContainer .exam-input').forEach(el => {
                            el.checked = false;
                        });
                        document.querySelectorAll('#complexFeaturesContainer input[type="text"]').forEach(el => {
                            el.value = '';
                            el.style.display = 'none';
                        });

                        // Gelen veriye göre işaretle
                        data.forEach(feature => {
                            var input = document.getElementById('ansComplex_' + feature.definitionValueId);
                            if (input) {
                                input.checked = true;
                                // Eğer radio ise, trigger event veya hidden guncelleme
                                if (input.type === 'radio') {
                                    var hidden = document.getElementById('hiddenComplex_' + feature.definitionValueId);
                                    if (hidden) hidden.value = 'true';
                                }
                                
                                // Text input göster/doldur
                                var noteInput = document.getElementById('textComplex_' + feature.definitionValueId);
                                if (noteInput) {
                                    noteInput.style.display = 'inline-block';
                                    if(feature.note) noteInput.value = feature.note;
