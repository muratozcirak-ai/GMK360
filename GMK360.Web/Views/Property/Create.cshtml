@model GMK360.Web.Models.PropertyCreateViewModel
@{
    ViewData["Title"] = "Yeni İlan Ekle (Profesyonel)";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
<style>
    .wizard-step { display: none; }
    .wizard-step.active { display: block; animation: fadeIn 0.4s ease-in-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .wizard-header .step-indicator { width: 40px; height: 40px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-weight: bold; transition: all 0.3s; }
    .wizard-header .step-item.active .step-indicator { background-color: var(--primary); color: white; }
    .wizard-header .step-item.completed .step-indicator { background-color: #10b981; color: white; }
    .wizard-line { height: 4px; background-color: #e2e8f0; flex: 1; margin: 0 10px; border-radius: 2px; position: relative; }
    .wizard-line-fill { height: 100%; background-color: var(--primary); width: 0%; transition: width 0.3s ease; border-radius: 2px; }
    .category-box { border: 2px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.2s; }
    .category-box:hover { border-color: var(--primary); background: #f8fafc; }
    .category-box.active { border-color: var(--primary); background: #e0f2fe; color: var(--primary); font-weight: bold; }
    .feature-lock { opacity: 0.6; pointer-events: none; position: relative; }
    .feature-lock::after { content: "Tesis seçildiği için otomatik dolduruldu"; position: absolute; top: 0; right: 0; background: var(--bs-info); color: white; padding: 4px 8px; font-size: 12px; border-radius: 4px; }
</style>

<div class="container py-5" style="margin-top: 80px;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0" style="border-radius: 16px;">
                <div class="card-body p-5">
                    <h2 class="fw-bold mb-4 text-center">İlan Verme Sihirbazı</h2>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="ph ph-warning-circle"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <!-- Wizard Header 7 Adım -->
                    <div class="wizard-header d-flex align-items-center justify-content-between mb-5 px-2">
                        <div class="step-item active text-center" data-step="1">
                            <div class="step-indicator mx-auto mb-2">1</div>
                            <small class="fw-bold">Kategori</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line1"></div></div>
                        <div class="step-item text-center" data-step="2">
                            <div class="step-indicator mx-auto mb-2">2</div>
                            <small class="fw-bold">Konum</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line2"></div></div>
                        <div class="step-item text-center" data-step="3">
                            <div class="step-indicator mx-auto mb-2">3</div>
                            <small class="fw-bold">Temel Özellikler</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line3"></div></div>
                        <div class="step-item text-center" data-step="4">
                            <div class="step-indicator mx-auto mb-2">4</div>
                            <small class="fw-bold">İç Özellikler</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line4"></div></div>
                        <div class="step-item text-center" data-step="5">
                            <div class="step-indicator mx-auto mb-2">5</div>
                            <small class="fw-bold" id="step4HeaderTitle">Yapı Özellikleri</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line5"></div></div>
                        <div class="step-item text-center" data-step="6">
                            <div class="step-indicator mx-auto mb-2">6</div>
                            <small class="fw-bold">Medya</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line6"></div></div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line6"></div></div>
                        <div class="step-item text-center" data-step="7">
                            <div class="step-indicator mx-auto mb-2">7</div>
                            <small class="fw-bold">Eşya Detayı</small>
                        </div>
                        <div class="wizard-line"><div class="wizard-line-fill" id="line7"></div></div>
                        <div class="step-item text-center" data-step="8">
                            <div class="step-indicator mx-auto mb-2">8</div>
                            <small class="fw-bold">Onay</small>
                        </div>
                    </div>

                    <form id="propertyWizardForm" asp-action="Create" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="Id" value="@(Model?.Id ?? 0)" />
                        <input type="hidden" name="DraftStep" value="@(Model?.DraftStep ?? 0)" />
                        
                        <!-- STEP 1: Kategori Seçimi -->
                        <div class="wizard-step active" id="step1">
                            <h4 class="mb-4 text-primary">1. Adım: Kategori Seçimi</h4>
                            
                            <div class="row g-0 border rounded bg-white shadow-sm mb-4">
                                <div class="row g-0 text-center fw-bold bg-light border-bottom d-none d-md-flex text-secondary">
                                    <div class="col-md-4 p-3 border-end">İşlem Tipi</div>
                                    <div class="col-md-4 p-3 border-end">Emlak Türü</div>
                                    <div class="col-md-4 p-3">Alt Tür</div>
                                </div>
                                <!-- 1. İşlem Tipi Kolonu -->
                                <div class="col-md-3 border-end p-0">
                                    <div class="bg-light p-3 border-bottom fw-bold text-secondary d-md-none">
                                        İşlem Tipi
                                    </div>
                                    <div class="list-group list-group-flush" id="statusList" style="height: 300px; overflow-y: auto;">
                                        @if (ViewBag.PropertyStatuses != null)
                                        {
                                            var isFirst = true;
                                            foreach (var status in ViewBag.PropertyStatuses)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action status-item @(isFirst ? "active fw-bold" : "")" data-code="@status.SystemCode" onclick="selectStatusList(@status.Id, '@status.SystemCode', this)">
                                                    @status.Name
                                                </button>
                                                if (isFirst) isFirst = false;
                                            }
                                        }
                                    </div>
                                    <input type="hidden" asp-for="StatusId" id="hdnStatus" value="@(ViewBag.PropertyStatuses != null && ViewBag.PropertyStatuses.Count > 0 ? ViewBag.PropertyStatuses[0].Id : 1)" />
                                </div>
                                
                                <!-- 2. Emlak Türü Kolonu -->
                                <div class="col-md-3 border-end p-0">
                                    <div class="bg-light p-3 border-bottom fw-bold text-secondary d-md-none">
                                        Emlak Türü
                                    </div>
                                    <div class="list-group list-group-flush" id="typeList" style="height: 300px; overflow-y: auto;">
                                        @if (ViewBag.PropertyTypes != null)
                                        {
                                            var isFirstType = true;
                                            foreach (var type in ViewBag.PropertyTypes)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action type-item @(isFirstType ? "active fw-bold" : "")" data-code="@type.SystemCode" onclick="selectTypeList(@type.Id, '@type.SystemCode', this)">
                                                    @type.Name
                                                </button>
                                                if (isFirstType) isFirstType = false;
                                            }
                                        }
                                    </div>
                                    <input type="hidden" asp-for="TypeId" id="hdnType" value="@(ViewBag.PropertyTypes != null && ViewBag.PropertyTypes.Count > 0 ? ViewBag.PropertyTypes[0].Id : 1)" />
                                </div>

                                <!-- 3. Alt Tür Kolonu -->
                                <div class="col-md-3 border-end p-0">
                                    <div class="bg-light p-3 border-bottom fw-bold text-secondary d-md-none">
                                        Alt Tür
                                    </div>
                                    <div class="list-group list-group-flush" id="subTypeList" style="height: 300px; overflow-y: auto;">
                                        @if (ViewBag.PropertySubTypes != null)
                                        {
                                            foreach (var subType in ViewBag.PropertySubTypes)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action subtype-item" style="display:none;" data-parent="@subType.Category.SystemCode.Replace("SUB_TYPE_", "")" data-code="@subType.SystemCode" onclick="selectSubTypeList(@subType.Id, '@subType.SystemCode', this)">
                                                    @subType.Name
                                                </button>
                                            }
                                        }
                                    </div>
                                    <input type="hidden" asp-for="SubTypeId" id="hdnSubType" value="" />
                                    
                                    @if(ViewBag.UserType == "Consultant")
                                    {
                                        <div id="agencyVisibilityToggle" class="p-3 border-top">
                                            <div class="form-check form-switch">
                                                <input asp-for="ShowAgencyInfo" class="form-check-input" type="checkbox" id="showAgencyInfo" checked>
                                                <label class="form-check-label text-secondary small" for="showAgencyInfo">Bağlı olduğum kurumu ilanda göster</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                
                                <!-- 4. Yapı Tipi Kolonu (Sadece Daire ve Villa için dinamik görünür) -->
                                <div class="col-md-3 p-0" id="buildingTypeCol" style="display:none; background-color: #f8f9fa;">
                                    <div class="bg-light p-3 border-bottom fw-bold text-secondary d-md-none">
                                        Yapı Tipi
                                    </div>
                                    <div class="list-group list-group-flush" id="buildingTypeList" style="height: 300px; overflow-y: auto;">
                                        <button type="button" class="list-group-item list-group-item-action building-type-item" onclick="selectBuildingType(true, this)">
                                            <i class="ph ph-buildings me-2"></i> Site İçi
                                        </button>
                                        <button type="button" class="list-group-item list-group-item-action building-type-item" onclick="selectBuildingType(false, this)">
                                            <i class="ph ph-house me-2"></i> Apartman / Bağımsız Bina
                                        </button>
                                    </div>
                                    <input type="hidden" id="hdnIsSite" name="IsSite" value="" />
                                </div>
                            </div>
                            
                            <!-- Günlük Kiralık Uyarı -->
                            <div id="dailyRentAlert" class="alert alert-warning mt-4" style="display:none;">
                                <i class="ph ph-warning-circle"></i> <strong>Yasal Uyarı:</strong> Günlük kiralık ilanlarda, misafir girişlerinde Kimlik Bildirim Sistemi (KBS) kullanılması yasal zorunluluktur. İlan kiralandığında rezervasyon modülü üzerinden bildirim yapmanız gerekecektir.
                            </div>
                            
                            <!-- Devre Mülk Detayları -->
                            <div id="timeshareDetails" class="alert alert-info mt-4" style="display:none;">
                                <h5>Devre Mülk Dönem Bilgileri</h5>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label>Dönem Adı</label>
                                        <input asp-for="TimesharePeriod" class="form-control" placeholder="Örn: Kırmızı Dönem" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Başlangıç</label>
                                        <input type="date" asp-for="TimeshareStartDate" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Bitiş</label>
                                        <input type="date" asp-for="TimeshareEndDate" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-5">
                                <button type="button" class="btn btn-primary px-5" onclick="nextStep(2)">İleri <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 2: Konum & Bina -->
                        <div class="wizard-step" id="step2">
                            <h4 class="mb-4 text-primary">2. Adım: Konum & Tesis Seçimi</h4>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="CityId" class="form-label fw-bold">İl</label>
                                    <select asp-for="CityId" class="form-select form-select-lg" id="citySelect">
                                        <option value="">Yükleniyor...</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DistrictId" class="form-label fw-bold">İlçe</label>
                                    <select asp-for="DistrictId" class="form-select form-select-lg" id="districtSelect">
                                        <option value="">Önce İl Seçiniz...</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NeighborhoodId" class="form-label fw-bold">Mahalle</label>
                                    <select asp-for="NeighborhoodId" class="form-select form-select-lg" id="neighborhoodSelect">
                                        <option value="">Önce İlçe Seçiniz...</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="StreetId" class="form-label fw-bold">Sokak / Cadde</label>
                                    <select asp-for="StreetId" class="form-select form-select-lg" id="streetSelect">
                                        <option value="">Önce Mahalle Seçiniz...</option>
                                    </select>
                                </div>
                                
                                <div class="col-12 mt-3">
                                    <div class="form-check form-switch form-switch-lg">
                                        <input class="form-check-input" type="checkbox" id="chkHideLocation" asp-for="HideLocation" value="true">
                                        <label class="form-check-label fw-bold text-dark ms-2" for="chkHideLocation">
                                            Tam adresim gizlensin, haritada sadece bölge çemberi gösterilsin
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="col-12 mt-4 p-4 rounded bg-light border border-primary">
                                    <h5 class="text-primary mb-3" id="step2BuildingTitle"><i class="ph ph-buildings"></i> Bina / Yapı Detayları</h5>
                                    
                                    <input type="hidden" asp-for="IsSite" id="IsSite" value="true" />

                                    <div id="siteSelectionArea">
                                        <label id="lblComplexSelect" asp-for="ComplexId" class="form-label fw-bold">Bina / Site Seçiniz</label>
                                        <select asp-for="ComplexId" class="form-select form-select-lg" id="complexSelect">
                                            <option value="">Önce Konum Seçiniz...</option>
                                        </select>
                                        <div class="mt-2 text-end">
                                            <button type="button" class="btn btn-sm btn-outline-warning me-2" onclick="openReportBuildingModal()" style="display:none;" id="btnReportBuilding">
    <i class="ph ph-flag"></i> İsimde Hata Var
</button>
<button type="button" class="btn btn-sm btn-outline-secondary" id="btnNewComplex" data-bs-toggle="modal" data-bs-target="#newComplexModal" onclick="document.getElementById('newComplexIsSite').checked = (document.getElementById('IsSite').value === 'true');">
    <i class="ph ph-plus"></i> Listede yoksa ekle (Mühürle)
</button>
<button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#newStreetModal">
    <i class="ph ph-warning"></i> Sokağımı Bulamadım
</button>
                                                </button>
                                        </div>
                                    </div>



                                        <div class="col-md-6 mt-3" style="display:none;">
                                            <label asp-for="Latitude" class="form-label fw-bold">Enlem (Lat)</label>
                                            <input asp-for="Latitude" type="text" id="latInput" class="form-control form-control-lg" placeholder="41.0082" />
                                        </div>
                                        <div class="col-md-6 mt-3" style="display:none;">
                                            <label asp-for="Longitude" class="form-label fw-bold">Boylam (Lng)</label>
                                            <input asp-for="Longitude" type="text" id="lngInput" class="form-control form-control-lg" placeholder="28.9784" />
                                        </div>
                                </div>

                                <!-- POI Container -->
                                <div class="col-12 mt-4 p-4 rounded bg-light border border-info" id="poiContainer" style="display:none;">
                                    <h5 class="text-info mb-3"><i class="ph ph-map-pin"></i> Yakın Çevredeki Önemli Noktalar (Tesisler)</h5>
                                    <p class="text-muted small">Mahallenizde sistemin otomatik bulduğu bu tesisleri ilanınıza tek tıkla ekleyebilirsiniz. Seçtikleriniz ilanın "Yakın Çevre" özelliklerinde sergilenecektir.</p>
                                    <div id="poiList" class="row g-3 mt-2"></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-light px-5" onclick="prevStep(1)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-primary px-5" onclick="nextStep(3)">İleri <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 3: Temel Özellikler -->
                        <div class="wizard-step" id="step3">
                            <h4 class="mb-4 text-primary">3. Adım: Temel Özellikler</h4>
                            
                            <!-- Özet Bilgi Panosu -->
                            <div class="alert alert-info shadow-sm mb-4 d-flex align-items-center gap-3">
                                <i class="ph ph-map-pin fs-2 text-info"></i>
                                <div>
                                    <div class="fw-bold fs-5 text-dark" id="summaryBuildingName">Bina Adı Bekleniyor...</div>
                                    <div class="text-muted small" id="summaryLocation">İl / İlçe / Mahalle / Sokak</div>
                                </div>
                            </div>

                            <div class="row g-4">
                                <!-- Gizli Alanlar (Model Binding İçin) -->
                                <input type="hidden" asp-for="BuildingNumber" id="BuildingNumber" />
                                <input type="hidden" asp-for="TotalFloors" id="TotalFloors" />
                                
                                <!-- Blok Seçimi (Gizli/Görünür) -->
                                <div class="col-12" id="blockSelectionContainer" style="display:none;">
                                    <div class="p-3 bg-light border border-info rounded">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="form-label fw-bold text-primary mb-0">Blok Seçiniz</label>
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addNewBlockModal">
                                                <i class="ph ph-plus"></i> Yeni Blok Ekle
                                            </button>
                                        </div>
                                        <select class="form-select form-select-lg" id="blockSelectDropdown" onchange="onBlockSelected()">
                                            <option value="">Seçiniz...</option>
                                        </select>
                                        <input type="hidden" asp-for="HasBlock" id="HasBlock" value="false" />
                                        <input type="hidden" asp-for="BlockName" id="BlockName" />
                                    </div>
                                </div>

                                <!-- Kat / Daire No / Cephe -->
                                <div class="col-md-4" id="floorNumberContainer">
                                    <label asp-for="FloorNumber" class="form-label fw-bold">Bulunduğu Kat</label>
                                    <input asp-for="FloorNumber" type="number" class="form-control form-control-lg" placeholder="Örn: 3" />
                                </div>
                                <div class="col-md-4" id="unitNumbersContainer">
                                    <label class="form-label fw-bold">İç Kapı / Daire No</label>
                                    <div class="dynamic-unit-inputs">
                                        <input name="UnitNumber" type="text" class="form-control form-control-lg mb-2 unit-input" placeholder="Örn: 4" oninput="handleUnitInput(this)" required />
                                    </div>
                                    <small class="text-muted text-primary" style="display:none;" id="unitNumberNote">
                                        <i class="ph ph-info"></i> Bu binada başka bir daireniz varsa yeni açılan kutuya yazabilirsiniz. Tek seferde toplu ilan oluşturulacaktır.
                                    </small>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Facade" class="form-label fw-bold">Cephe</label>
                                    <select asp-for="Facade" class="form-select form-select-lg">
                                        <option value="">Seçiniz...</option>
                                        <option value="Kuzey">Kuzey</option>
                                        <option value="Güney">Güney</option>
                                        <option value="Doğu">Doğu</option>
                                        <option value="Batı">Batı</option>
                                        <option value="Kuzey-Doğu">Kuzey-Doğu</option>
                                        <option value="Kuzey-Batı">Kuzey-Batı</option>
                                        <option value="Güney-Doğu">Güney-Doğu</option>
                                        <option value="Güney-Batı">Güney-Batı</option>
                                    </select>
                                </div>

                                <!-- M2 / Oda / Banyo -->
                                <div class="col-md-2">
                                    <label asp-for="GrossArea" class="form-label fw-bold">Brüt m²</label>
                                    <input asp-for="GrossArea" type="number" class="form-control form-control-lg" />
                                </div>
                                <div class="col-md-2">
                                    <label asp-for="NetArea" class="form-label fw-bold">Net m²</label>
                                    <input asp-for="NetArea" type="number" class="form-control form-control-lg" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="RoomCount" class="form-label fw-bold">Oda / Salon Sayısı</label>
                                    <select asp-for="RoomCount" class="form-select form-select-lg">
                                        <option value="">Seçiniz...</option>
                                        <option value="1+0 (Stüdyo)">1+0 (Stüdyo)</option>
                                        <option value="1+1">1+1</option>
                                        <option value="2+1">2+1</option>
                                        <option value="3+1">3+1</option>
                                        <option value="4+1">4+1</option>
                                        <option value="5+1 ve üzeri">5+1 ve üzeri</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="BathroomCount" class="form-label fw-bold">Banyo Sayısı</label>
                                    <input asp-for="BathroomCount" type="number" class="form-control form-control-lg" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="WcCount" class="form-label fw-bold">Tuvalet (WC) Sayısı</label>
                                    <input asp-for="WcCount" type="number" class="form-control form-control-lg" placeholder="Banyosuz" />
                                </div>
                                <div class="col-md-2">
                                    <label asp-for="BalconyCount" class="form-label fw-bold">Balkon Sayısı</label>
                                    <input asp-for="BalconyCount" type="number" class="form-control form-control-lg" />
                                </div>

                                <!-- Bina Yaşı / Aidat / Eşyalı -->
                                <div class="col-md-4" id="buildingAgeContainer">
                                    <label asp-for="BuildingAge" class="form-label fw-bold">Bina Yaşı</label>
                                    <select asp-for="BuildingAge" class="form-select form-select-lg">
                                        <option value="">Seçiniz...</option>
                                        <option value="0 (Sıfır)">0 (Sıfır)</option>
                                        <option value="1-5 Arası">1-5 Arası</option>
                                        <option value="6-10 Arası">6-10 Arası</option>
                                        <option value="11-20 Arası">11-20 Arası</option>
                                        <option value="21 ve üzeri">21 ve üzeri</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Dues" class="form-label fw-bold">Aidat (Aylık)</label>
                                    <input asp-for="Dues" type="number" class="form-control form-control-lg" placeholder="Varsa giriniz" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end mb-2">
                                    <div class="form-check form-switch form-check-lg w-100 p-3 bg-light rounded border border-light">
                                        <input class="form-check-input ms-0 mt-1 me-2" type="checkbox" asp-for="IsFurnished" id="chkIsFurnished">
                                        <label class="form-check-label fw-bold" for="chkIsFurnished">Bu ilan eşyalı mı?</label>
                                    </div>
                                </div>

                                <!-- Fiyat / Başlık -->
                                <div class="col-md-4">
                                    <label asp-for="Price" class="form-label fw-bold">Fiyat</label>
                                    <div class="input-group input-group-lg">
                                        <input asp-for="Price" type="number" class="form-control" />
                                        <select asp-for="Currency" class="form-select" style="max-width: 100px;">
                                            <option value="TRY">TL</option>
                                            <option value="USD">USD</option>
                                            <option value="EUR">EUR</option>
                                        </select>
                                    </div>
                                    <small class="text-muted mt-1 d-block" id="priceCurrencyHelper">
                                        <i class="ph ph-info"></i> Güncel Kurlar yükleniyor...
                                    </small>
                                </div>
                                <div class="col-md-8">
                                    <label asp-for="Title" class="form-label fw-bold">İlan Başlığı</label>
                                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Örn: Moda'da Deniz Manzaralı Eşyalı Kiralık" />
                                </div>

                                <!-- ARSA / HİSSE DETAYLARI -->
                                <div class="col-12 mt-4" id="landDetailsSection" style="display:none;">
                                    <div class="p-3 bg-light border rounded">
                                        <h6 class="text-primary border-bottom pb-2 mb-3"><i class="ph ph-map-trifold"></i> Arsa / Tapu Bilgileri (Sadece Arsa İlanları İçin)</h6>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label asp-for="DeedStatus" class="form-label fw-bold">Tapu Durumu</label>
                                                <select asp-for="DeedStatus" class="form-select">
                                                    <option value="">Seçiniz</option>
                                                    <option value="Müstakil Tapu">Müstakil Tapu</option>
                                                    <option value="Hisseli Tapu">Hisseli Tapu</option>
                                                    <option value="Tahsis">Tahsis</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label asp-for="BlockNumber" class="form-label fw-bold">Ada No</label>
                                                <input asp-for="BlockNumber" class="form-control" />
                                            </div>
                                            <div class="col-md-4">
                                                <label asp-for="ParcelNumber" class="form-label fw-bold">Parsel No</label>
                                                <input asp-for="ParcelNumber" class="form-control" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="TotalAreaSqm" class="form-label fw-bold">Arsanın Toplam M²'si</label>
                                                <input asp-for="TotalAreaSqm" type="number" class="form-control" />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="ShareAreaSqm" class="form-label fw-bold">Hisseye Düşen M²</label>
                                                <input asp-for="ShareAreaSqm" type="number" class="form-control" />
                                                <small class="text-muted">Fiyat / M² hesaplanırken burası baz alınır.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- DINAMIK SELECT KUTULARI (Kategoriye Göre Değişen Seçimler) -->
                                @if (ViewBag.DynamicDropdowns != null)
                                {
                                    var dynamicDropdowns = (IEnumerable<GMK360.Core.Entities.DefinitionCategory>)ViewBag.DynamicDropdowns;
                                    foreach (var category in dynamicDropdowns)
                                    {
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold">@category.Name</label>
                                            <select name="DynamicSelects[@category.Id]" class="form-select form-select-lg">
                                                <option value="">Seçiniz...</option>
                                                @foreach (var val in category.Values)
                                                {
                                                    <option value="@val.Id">@val.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                }
                                
                                <div class="col-12 mt-4">
                                    <label asp-for="Description" class="form-label fw-bold">Detaylı Açıklama</label>
                                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="İlanınız hakkında detaylı bilgi verin..."></textarea>
                                </div>
                                
                            </div>
                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-light px-5" onclick="prevStep(2)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-primary px-5" onclick="nextStep(4)">İleri <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 5: Yapı Özellikleri -->
                        <div class="wizard-step" id="step5">
                            <h4 class="mb-4 text-primary" id="step4Title">5. Adım: Yapı Özellikleri</h4>
                            <div class="alert alert-info" id="complexFeaturesAlert" style="display:none;">
                                <i class="ph ph-info"></i> Bu özellikler 2. adımda seçtiğiniz <strong><span id="selectedComplexName"></span></strong> isimli yapı üzerinden otomatik olarak miras alınmıştır. Dilerseniz sadece bu ilan için değişiklik yapabilirsiniz.
                            </div>
                            
                            <div id="complexFeaturesContainer">
                                @{ int featureIndexComplex = 0; }
                                @if (ViewBag.MatrixCategoriesComplex != null)
                                {
                                    var matrixCategoriesComplex = (IEnumerable<GMK360.Core.Entities.DefinitionCategory>)ViewBag.MatrixCategoriesComplex;
                                    foreach (var group in matrixCategoriesComplex)
                                    {
                                        <div class="col-12 mt-4 p-4 rounded bg-light border border-secondary">
                                            <h5 class="text-primary mb-4 pb-2 border-bottom"><i class="ph ph-buildings"></i> @group.Name</h5>
                                            
                                            <div class="row g-4">
                                                @if (group.SubCategories != null)
                                                {
                                                    foreach (var question in group.SubCategories.OrderBy(q => q.Name))
                                                    {
                                                        <div class="col-12">
                                                            <div class="row align-items-center">
                                                                <div class="col-md-3">
                                                                    <p class="mb-0 fw-bold text-dark" style="font-size:1.05rem;">@question.Name</p>
                                                                    @if(question.IsMultiSelect) {
                                                                        <small class="text-muted" style="font-size:0.75rem;">(Birden çok seçilebilir)</small>
                                                                    }
                                                                </div>
                                                                
                                                                <div class="col-md-9 d-flex flex-wrap gap-3 align-items-center">
                                                                    @if (question.Values != null)
                                                                    {
                                                                        foreach (var answer in question.Values.OrderBy(v => v.Order))
                                                                        {
                                                                            <div class="form-check form-check-inline mb-0 me-3 d-flex align-items-center">
                                                                                <input type="hidden" name="MatrixFeaturesComplex[@featureIndexComplex].DefinitionValueId" value="@answer.Id" />
                                                                                
                                                                                @if (question.IsMultiSelect)
                                                                                {
                                                                                    <input class="form-check-input exam-input" type="checkbox" name="MatrixFeaturesComplex[@featureIndexComplex].IsSelected" value="true" id="ansComplex_@answer.Id" onchange="toggleTextInput(this, 'textComplex_@answer.Id')">
                                                                                }
                                                                                else
                                                                                {
                                                                                    <input class="form-check-input exam-input" type="radio" name="RadioGroupComplex_@question.Id" value="@answer.Id" id="ansComplex_@answer.Id" onchange="syncRadioSelectionComplex(this, @featureIndexComplex, @question.Id); toggleTextInput(this, 'textComplex_@answer.Id')">
                                                                                    
                                                                                    <input type="hidden" name="MatrixFeaturesComplex[@featureIndexComplex].IsSelected" id="hiddenComplex_@answer.Id" value="false" class="radio-hidden-sync-complex-@question.Id" />
                                                                                }
                                                                                
                                                                                <label class="form-check-label ms-2 cursor-pointer" for="ansComplex_@answer.Id">@answer.Name</label>
                                                                                
                                                                                @if(answer.RequiresTextInput) {
                                                                                    <input type="text" class="form-control form-control-sm ms-2" name="MatrixFeaturesComplex[@featureIndexComplex].Note" id="textComplex_@answer.Id" placeholder="Açıklama" style="display:none; width:180px;" />
                                                                                }
                                                                            </div>
                                                                            featureIndexComplex++;
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12"><hr class="my-1 border-light" /></div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-light px-5" onclick="prevStep(4)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-primary px-5" onclick="nextStep(6)">İleri <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 4: İç Özellikler -->
                        <div class="wizard-step" id="step4">
                            <h4 class="mb-4 text-primary">4. Adım: İç Özellikler</h4>
                            
                            <div class="row g-4">
                                @{ int featureIndex = 0; }
                                @if (ViewBag.MatrixCategoriesProperty != null)
                                {
                                    var matrixCategoriesProperty = (IEnumerable<GMK360.Core.Entities.DefinitionCategory>)ViewBag.MatrixCategoriesProperty;
                                    foreach (var group in matrixCategoriesProperty)
                                    {
                                        <div class="col-12 mt-4 p-4 rounded bg-light border border-secondary">
                                            <h5 class="text-primary mb-4 pb-2 border-bottom"><i class="ph ph-folder-open"></i> @group.Name</h5>
                                            
                                            <div class="row g-4">
                                                @if (group.SubCategories != null)
                                                {
                                                    foreach (var question in group.SubCategories.OrderBy(q => q.Name))
                                                    {
                                                        <div class="col-12">
                                                            <div class="row align-items-center">
                                                                <div class="col-md-3">
                                                                    <p class="mb-0 fw-bold text-dark" style="font-size:1.05rem;">@question.Name</p>
                                                                    @if(question.IsMultiSelect) {
                                                                        <small class="text-muted" style="font-size:0.75rem;">(Birden çok seçilebilir)</small>
                                                                    }
                                                                </div>
                                                                
                                                                <div class="col-md-9 d-flex flex-wrap gap-3 align-items-center">
                                                                    @if (question.Values != null)
                                                                    {
                                                                        foreach (var answer in question.Values.OrderBy(v => v.Order))
                                                                        {
                                                                            <div class="form-check form-check-inline mb-0 me-3 d-flex align-items-center">
                                                                                <input type="hidden" name="MatrixFeatures[@featureIndex].DefinitionValueId" value="@answer.Id" />
                                                                                
                                                                                @if (question.IsMultiSelect)
                                                                                {
                                                                                    <input class="form-check-input exam-input" type="checkbox" name="MatrixFeatures[@featureIndex].IsSelected" value="true" id="ans_@answer.Id" onchange="toggleTextInput(this, 'text_@answer.Id')" data-is-media-tag="@question.IsMediaTag.ToString().ToLower()">
                                                                                }
                                                                                else
                                                                                {
                                                                                    <input class="form-check-input exam-input" type="radio" name="RadioGroup_@question.Id" value="@answer.Id" id="ans_@answer.Id" onchange="syncRadioSelection(this, @featureIndex, @question.Id); toggleTextInput(this, 'text_@answer.Id')" data-is-media-tag="@question.IsMediaTag.ToString().ToLower()">
                                                                                    
                                                                                    <input type="hidden" name="MatrixFeatures[@featureIndex].IsSelected" id="hidden_@answer.Id" value="false" class="radio-hidden-sync-@question.Id" />
                                                                                }
                                                                                
                                                                                <label class="form-check-label ms-2 cursor-pointer" for="ans_@answer.Id">@answer.Name</label>
                                                                                
                                                                                @if(answer.RequiresTextInput) {
                                                                                    <input type="text" class="form-control form-control-sm ms-2" name="MatrixFeatures[@featureIndex].Note" id="text_@answer.Id" placeholder="Açıklama" style="display:none; width:180px;" />
                                                                                }
                                                                            </div>
                                                                            featureIndex++;
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12"><hr class="my-1 border-light" /></div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                }

                                <div class="col-12 mt-4 p-4 rounded bg-light border border-secondary">
                                    <h5 class="text-primary mb-3"><i class="ph ph-list-plus"></i> Ekstra Değerli Özellikler (Anahtar - Değer)</h5>
                                    <p class="text-muted small mb-3">Tavan yüksekliği, özel imkanlar gibi değer gerektiren özellikleri buradan ekleyebilirsiniz.</p>
                                    
                                    <div class="row g-2 align-items-center mb-3">
                                        <div class="col-md-5">
                                            <select id="newKvKey" class="form-select">
                                                <option value="">Özellik Seçiniz...</option>
                                                @if(ViewBag.DynamicFeatureKeys != null) {
                                                    foreach(var key in ViewBag.DynamicFeatureKeys) {
                                                        <option value="@key.Id" data-name="@key.Name">@key.Name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" id="newKvValue" class="form-control" placeholder="Değeri (Örn: 2.8m)" />
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-outline-primary w-100" onclick="addKvFeature()">Ekle</button>
                                        </div>
                                    </div>
                                    
                                    <div class="row g-3" id="featuresKvRow">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-light px-5" onclick="prevStep(3)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-primary px-5" onclick="nextStep(5)">İleri <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 6: Medya -->
                        <div class="wizard-step" id="step6">
                            <h4 class="mb-4 text-primary">6. Adım: Medya Galerisi</h4>
                            
                            <div class="alert alert-info mb-4">
                                <i class="ph ph-info"></i> Fotoğraf ve videolarınızı aşağıdaki alana sürükleyip bırakın. En başa koyduğunuz resim <strong>Kapak Fotoğrafı</strong> olur. İç özellikleri otomatik algılayıp hap butonlara yansıtırız; tıklayarak hızlıca etiketleyebilirsiniz (Zorunlu değildir).
                            </div>

                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="p-5 text-center border rounded bg-light position-relative" id="mediaDropzone" style="border: 2px dashed #cbd5e1 !important; cursor: pointer; transition: all 0.3s;" onclick="document.getElementById('mediaFileInput').click()">
                                        <i class="ph ph-cloud-arrow-up text-primary" style="font-size: 64px;"></i>
                                        <h4 class="mt-3">Fotoğraf veya Video Yüklemek İçin Tıklayın veya Sürükleyin</h4>
                                        <p class="text-muted">Aynı anda birden fazla dosya seçebilirsiniz (JPG, PNG, MP4)</p>
                                        <input type="file" id="mediaFileInput" multiple accept="image/*,video/mp4,video/x-m4v,video/webm" style="display:none;" onchange="handleMediaSelect(event)" />
                                    </div>
                                    
                                    <!-- Yükleniyor Göstergesi -->
                                    <div id="mediaUploadProgress" class="mt-3" style="display:none;">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                            <span class="fw-bold">Dosyalar Yükleniyor...</span>
                                        </div>
                                        <div class="progress" style="height: 10px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%"></div>
                                        </div>
                                    </div>
                                    
                                    <!-- Uploaded Media Grid -->
                                    <div id="mediaPreviewGrid" class="row g-3 mt-4 sortable-grid">
                                        <!-- Kartlar JS ile eklenecek -->
                                    </div>
                                </div>
                                
                                <div class="col-12 mt-4">
                                    <label class="form-label fw-bold"><i class="ph ph-youtube-logo text-danger"></i> veya YouTube / Vimeo Linki Ekle (İsteğe Bağlı)</label>
                                    <input type="url" asp-for="VideoUrl" class="form-control" placeholder="Örn: https://www.youtube.com/watch?v=..." />
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between mt-4 border-top pt-4">
                                <button type="button" class="btn btn-outline-secondary btn-lg" onclick="nextStep(5)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-primary btn-lg" onclick="nextStep(7)">İleri <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 7: Eşya Detayı -->
                        <div class="wizard-step" id="step7">
                            <h4 class="mb-4 text-primary">7. Adım: Eşya Detayı</h4>
                            <div class="p-4 bg-light border rounded shadow-sm">
                                <p class="text-muted"><i class="ph ph-info"></i> İlana ait eşya bilgilerini detaylandırın (sadece eşyalı ilanlar için).</p>
                                
                                <div class="row g-3 mt-3">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch mb-3 p-3 bg-white border rounded">
                                            <input class="form-check-input ms-0 mt-1 me-2" type="checkbox" asp-for="IsFurnished" id="chkIsFurnishedStep8" onchange="document.getElementById('chkIsFurnished').checked = this.checked;">
                                            <label class="form-check-label fw-bold" for="chkIsFurnishedStep8">Bu ilan eşyalı mı?</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-3 mt-2">
                                    <div class="col-md-12">
                                        <label class="form-label fw-bold">Eşya Listesi ve Durumu</label>
                                        <textarea class="form-control" name="FurnitureDetails" rows="4" placeholder="Beyaz eşyalar, mobilyalar vb. hakkında detaylı bilgi giriniz..."></textarea>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between mt-4 border-top pt-4">
                                <button type="button" class="btn btn-outline-secondary btn-lg" onclick="nextStep(6)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-primary btn-lg" onclick="nextStep(8)">İleri (Onay) <i class="ph ph-arrow-right"></i></button>
                            </div>
                        </div>

                        <!-- STEP 8: Onay -->
                        <div class="wizard-step" id="step8">
                            <h4 class="mb-4 text-primary">8. Adım: Özet ve Onay</h4>
                            <div class="alert alert-success">
                                <i class="ph ph-check-circle"></i> Tüm bilgileri başarıyla doldurdunuz! Güvenlik adımını geçtikten sonra ilanınızı yayınlayabilirsiniz.
                            </div>
                            
                            <!-- EİDS Yetki Belgesi Doğrulama (Simülasyon) -->
                            <div class="card border-info mb-4 shadow-sm">
                                <div class="card-header bg-info text-white fw-bold">
                                    <i class="ph ph-shield-check"></i> EİDS Satış Yetki Belgesi Doğrulama
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-warning mb-3">
                                        <i class="ph ph-warning-circle"></i> Yeni yönetmelik gereği, Taşınmaz Ticareti Yetki Belgeniz veya mülk sahibinin E-Devlet (EİDS) onayı olmadan bu ilanı yayınlayamazsınız.
                                    </div>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="hasAuthorizationSwitch" name="HasAuthorization" value="true">
                                        <label class="form-check-label fw-bold" for="hasAuthorizationSwitch">Mülk sahibi tarafından tarafıma yetki verilmiştir</label>
                                    </div>
                                    <div id="eidsFields" style="display:none;">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Taşınmaz Ticareti Yetki Belgesi No</label>
                                                <input type="text" class="form-control" name="AuthorizationDocumentNo" id="authDocNo" placeholder="Örn: 3400012">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Mal Sahibi T.C. Kimlik / VKN</label>
                                                <input type="text" class="form-control" name="OwnerIdNumber" id="ownerIdNo" placeholder="Örn: 12345678901">
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <button type="button" class="btn btn-outline-info w-100" id="btnVerifyEids" onclick="verifyEids()">
                                                <i class="ph ph-arrows-clockwise"></i> Sistemden Doğrula (Simülasyon)
                                            </button>
                                        </div>
                                        <div id="eidsSuccess" class="alert alert-success mt-3" style="display:none;">
                                            <i class="ph ph-check-circle"></i> EİDS Doğrulaması Başarılı! Bakanlık sisteminden onay alındı.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card bg-light border-0 mb-4">
                                <div class="card-body text-center py-4">
                                    <div class="mb-3">
                                        <i class="ph ph-robot" style="font-size:48px; color:var(--primary);"></i>
                                    </div>
                                    <div class="form-check d-inline-block text-start">
                                        <input class="form-check-input" type="checkbox" id="robotCheck" required>
                                        <label class="form-check-label fw-bold" for="robotCheck">
                                            Ben robot değilim (Mock reCAPTCHA)
                                        </label>
                                    </div>
                                    <input type="hidden" asp-for="RecaptchaToken" id="recaptchaToken" />
                                    <span asp-validation-for="RecaptchaToken" class="text-danger d-block mt-2"></span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-5">
                                <button type="button" class="btn btn-light px-5 btn-lg" onclick="nextStep(7)"><i class="ph ph-arrow-left"></i> Geri</button>
                                <button type="button" class="btn btn-success px-5 btn-lg" id="btnSubmitPublish" onclick="attemptSubmit()" disabled>İlanı Yayınla <i class="ph ph-rocket"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Blok Ekle Modal -->

<!-- YENİ SOKAK EKLE MODALI (ON-THE-FLY) -->
<div class="modal fade" id="newStreetModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="ph ph-warning"></i> Sokağımı Bulamadım</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Sokağınızı listede bulamadıysanız, adını yazarak ekleyebilir ve işleminize kesintisiz devam edebilirsiniz. Yöneticilerimiz arka planda kontrol edecektir.</p>
                <div class="mb-3">
                    <label class="form-label fw-bold">Yeni Sokak Adı</label>
                    <input type="text" id="newStreetNameInput" class="form-control" placeholder="Örn: Papatya Sokak" />
                </div>
