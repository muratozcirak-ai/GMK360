        function saveNewComplex() {
            var name = document.getElementById('ncName').value;
            var cityId = document.getElementById('citySelect').value;
            var districtId = document.getElementById('districtSelect').value;
            var neighborhoodId = document.getElementById('neighborhoodSelect').value;
            var streetId = document.getElementById('streetSelect').value;
            
            var buildingNumber = document.getElementById('ncBuildingNumber').value;
            var hasBlocks = document.getElementById('ncHasBlocks').checked;
            var totalFloors = document.getElementById('ncTotalFloors').value;

            if(!name) { alert("Lütfen Bina/Site adını giriniz."); return; }
            if(!cityId || !districtId || !neighborhoodId) {
                alert("Önce ana formdaki İl, İlçe ve Mahalle alanlarını doldurmalısınız.");
                return;
            }
            if (!hasBlocks && !totalFloors) { alert("Lütfen Binanın Kat Sayısını giriniz."); return; }
            if (!buildingNumber) { alert("Lütfen Dış Kapı No giriniz."); return; }

            var blocksData = [];
            if (hasBlocks) {
                var rows = document.querySelectorAll('.nc-block-row');
                if (rows.length === 0) { alert("Lütfen en az bir blok ekleyin."); return; }
                for (let row of rows) {
                    var bName = row.querySelector('.nc-block-name').value;
                    var bFloors = row.querySelector('.nc-block-floors').value;
                    if (!bName || !bFloors) { alert("Lütfen tüm blokların adını ve kat sayısını doldurunuz."); return; }
                    blocksData.push({ Name: bName, TotalFloors: parseInt(bFloors) });
                }
            }

            var payload = {
                name: name,
                cityId: parseInt(cityId),
                districtId: parseInt(districtId),
                neighborhoodId: parseInt(neighborhoodId),
                streetId: streetId ? parseInt(streetId) : null,
                newStreetName: window.lastDetectedRoadName,
                buildingNumber: buildingNumber,
                latitude: parseFloat(document.getElementById('ncLat').value || 0),
                longitude: parseFloat(document.getElementById('ncLng').value || 0),
                hasSecurity: false,
                hasPool: false,
                hasBlocks: hasBlocks,
                blocks: blocksData,
                totalUnits: null,
                totalFloors: hasBlocks ? null : parseInt(totalFloors)
            };

            var btn = document.getElementById('btnSaveComplex');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<i class="ph ph-spinner ph-spin"></i> Kaydediliyor...';
            btn.disabled = true;

            fetch('/api/ComplexApi/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(async res => {
                if(!res.ok) {
                    var errorText = await res.text();
                    throw new Error(errorText || "Kayıt hatası");
                }
                return res.json();
            })
            .then(data => {
                var complexSelect = document.getElementById('complexSelect');
                var opt = document.createElement('option');
                opt.value = data.id;
                opt.innerHTML = data.text + " (Yeni Eklendi)";
                complexSelect.appendChild(opt);
                complexSelect.value = data.id;

                // Close Modal
                var myModal = bootstrap.Modal.getInstance(document.getElementById('newComplexModal'));
                myModal.hide();

                // Trigger Change
                complexSelect.dispatchEvent(new Event('change'));

                alert("Bina başarıyla eklendi ve seçildi! Yöneticiler onaylayana kadar bu binayı sadece siz görebilirsiniz.");
            })
            .catch(err => {
                console.error(err);
                try {
                    var errObj = JSON.parse(err.message);
                    if (errObj.errors) {
                        var msgs = [];
                        for(var key in errObj.errors) {
                            msgs.push(key + ": " + errObj.errors[key].join(', '));
                        }
                        alert("Doğrulama Hatası:\n" + msgs.join('\n'));
                        return;
                    }
                } catch(e) {}
                alert("Bina kaydedilirken bir hata oluştu: " + err.message);
            })
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }

        // Authentication & Submit Logic
        var isAuthenticated = @User.Identity.IsAuthenticated.ToString().ToLower();

        function attemptSubmit() {
            // Verify ReCaptcha
            document.getElementById('recaptchaToken').value = document.getElementById('robotCheck').checked ? 'VERIFIED' : '';
            if(!document.getElementById('robotCheck').checked) {
                alert("Lütfen robot olmadığınızı doğrulayın.");
                return;
            }

            if (isAuthenticated) {
                document.getElementById('propertyWizardForm').submit();
            } else {
                var modal = new bootstrap.Modal(document.getElementById('ajaxLoginModal'));
                modal.show();
            }
        }

        function performAjaxLogin() {
            var email = document.getElementById('ajaxEmail').value;
            var pass = document.getElementById('ajaxPassword').value;
            var errDiv = document.getElementById('ajaxLoginError');
            
            fetch('/Account/LoginAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Email: email, Password: pass, RememberMe: true })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    isAuthenticated = true;
                    errDiv.style.display = 'none';
                    document.getElementById('propertyWizardForm').submit();
                } else {
                    errDiv.innerText = data.message;
                    errDiv.style.display = 'block';
                }
            })
            .catch(err => {
                errDiv.innerText = "Sunucu ile iletişim kurulamadı.";
                errDiv.style.display = 'block';
            });
        }

        function updateSummaryHeader() {
            var city = document.getElementById('citySelect').options[document.getElementById('citySelect').selectedIndex]?.text || '';
            var district = document.getElementById('districtSelect').options[document.getElementById('districtSelect').selectedIndex]?.text || '';
            var neighborhood = document.getElementById('neighborhoodSelect').options[document.getElementById('neighborhoodSelect').selectedIndex]?.text || '';
            var complex = document.getElementById('complexSelect').options[document.getElementById('complexSelect').selectedIndex]?.text || '';
            var bNo = document.getElementById('BuildingNumber')?.value || '';
            
            var locStr = `${city} / ${district} / ${neighborhood}`;
            var bStr = complex;
            if(bNo) bStr += ` - No: ${bNo}`;
            
            var sumLoc = document.getElementById('summaryLocation');
            var sumName = document.getElementById('summaryBuildingName');
            if (sumLoc) sumLoc.innerText = locStr;
            if (sumName) sumName.innerText = bStr;
        }

        async function saveNewBlockToComplex() {
            var complexId = document.getElementById('complexSelect').value;
            if(!complexId) {
                alert("Lütfen önce bir bina/site seçiniz.");
                return;
            }
            
            var name = document.getElementById('newBlockName').value.trim();
            var floors = document.getElementById('newBlockTotalFloors').value.trim();
            
            if(!name || !floors) {
                alert("Blok adı ve kat sayısı zorunludur.");
                return;
            }
            
            var btn = document.querySelector('#addNewBlockModal .btn-primary');
            var originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Kaydediliyor...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/ComplexApi/AddBlockToComplex', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ComplexId: parseInt(complexId),
                        Name: name,
                        TotalFloors: parseInt(floors)
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    
                    var dropdown = document.getElementById('blockSelectDropdown');
                    var opt = document.createElement('option');
                    opt.value = data.name;
                    opt.dataset.floors = data.totalFloors;
                    opt.innerHTML = data.name;
                    dropdown.appendChild(opt);
                    
                    dropdown.value = data.name;
                    onBlockSelected();
                    
                    var myModal = bootstrap.Modal.getInstance(document.getElementById('addNewBlockModal'));
                    if (myModal) myModal.hide();
                    
                    document.getElementById('newBlockName').value = '';
                    document.getElementById('newBlockTotalFloors').value = '';
                } else {
                    alert("Blok eklenirken bir hata oluştu.");
                }
            } catch (error) {
                console.error("Blok ekleme hatası:", error);
                alert("Bir ağ hatası oluştu.");
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            var selects = ['citySelect', 'districtSelect', 'neighborhoodSelect', 'streetSelect', 'complexSelect'];
            selects.forEach((id, index) => {
                var el = document.getElementById(id);
                if (el) {
                    el.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            for (var i = index + 1; i < selects.length; i++) {
                                var nextEl = document.getElementById(selects[i]);
                                if (nextEl && !nextEl.disabled && nextEl.offsetParent !== null) {
                                    nextEl.focus();
                                    break;
                                }
                            }
                        }
                    });
                }
            });
        });
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>


        function addNewFeature(type) {
            var featureName = prompt("Eklemek istediğiniz özelliğin adını yazınız:");
            if (!featureName || featureName.trim() === '') return;
            
            fetch('/api/FeatureApi/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ Name: featureName.trim(), Type: type })
            })
            .then(res => {
                if(!res.ok) throw new Error("Hata oluştu");
                return res.json();
            })
            .then(data => {
                if(data && data.id) {
                    var html = `
                        <div class="col-md-3 col-sm-4 col-6">
                            <div class="form-check form-switch form-check-lg">
                                <input class="form-check-input" type="checkbox" name="SelectedFeatureIds" value="${data.id}" id="feat_${data.id}" checked>
                                <label class="form-check-label" for="feat_${data.id}">${data.name}</label>
                            </div>
                        </div>
                    `;
                    var targetRow = type === 'IN' ? document.getElementById('featuresInRow') : document.getElementById('featuresOutRow');
                    targetRow.insertAdjacentHTML('beforeend', html);
                } else {
                    alert('Özellik eklenirken bir hata oluştu.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Özellik eklenemedi.');
            });
        }

        function addKvFeature() {
            var keySelect = document.getElementById('newKvKey');
            var keyId = keySelect.value;
            var keyName = keySelect.options[keySelect.selectedIndex] ? keySelect.options[keySelect.selectedIndex].getAttribute('data-name') : '';
            var valueStr = document.getElementById('newKvValue').value;
            
            if (!keyId || !valueStr || valueStr.trim() === '') {
                alert("Lütfen bir özellik seçin ve değerini giriniz.");
                return;
            }
            
            var html = `
                <div class="col-md-4 col-sm-6">
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-white text-primary fw-bold">${keyName}</span>
                        <input type="text" class="form-control" name="DynamicFeatures[${keyId}]" value="${valueStr.trim()}" readonly>
                        <button class="btn btn-outline-danger" type="button" onclick="this.parentElement.parentElement.remove()">X</button>
                    </div>
                </div>
            `;
            document.getElementById('featuresKvRow').insertAdjacentHTML('beforeend', html);
            document.getElementById('newKvKey').value = '';
            document.getElementById('newKvKey').value = '';
            document.getElementById('newKvValue').value = '';
        }

        function toggleTextInput(checkboxElement, textInputId) {
            var textInput = document.getElementById(textInputId);
            if (textInput) {
                if (checkboxElement.checked) {
                    textInput.style.display = 'inline-block';
                    textInput.focus();
                } else {
                    textInput.style.display = 'none';
                    textInput.value = ''; // Seçim kalkınca metni de sil
                }
            }
        }

        function syncRadioSelection(radioElement, featureIndex, questionId) {
            // Önce aynı soruya (questionId) ait tüm gizli IsSelected alanlarını false yap
            var hiddenFields = document.querySelectorAll('.radio-hidden-sync-' + questionId);
            hiddenFields.forEach(function (field) {
                field.value = "false";
            });

            // Sonra seçilen Radio'ya ait gizli IsSelected alanını true yap
            var selectedHiddenField = document.getElementById('hidden_' + radioElement.value);
            if (selectedHiddenField) {
                selectedHiddenField.value = "true";
            }
            
            // Seçili olmayan radio'ların varsa metin kutularını kapat
            var allRadios = document.querySelectorAll('input[name="RadioGroup_' + questionId + '"]');
            allRadios.forEach(function(r) {
                if(r !== radioElement) {
                    var txt = document.getElementById('text_' + r.value);
                    if(txt) {
                        txt.style.display = 'none';
                        txt.value = '';
                    }
                }
            });
        }

        // Media Gallery Upload and Tagging Logic
        var uploadedMediaFiles = [];
        var mediaCounter = 0;

        function getSelectedRoomTags() {
            var tags = [];
            // Adım 4 (Dış/Site Özellikleri) ve Adım 5 (İç Özellikler)
            var checkedInputs = document.querySelectorAll('#step4 input.exam-input:checked[data-is-media-tag="true"], #step5 input.exam-input:checked[data-is-media-tag="true"]');
            checkedInputs.forEach(function(input) {
                var label = document.querySelector('label[for="' + input.id + '"]');
                if(label) {
                    var text = label.innerText.trim();
                    if(text) tags.push(text);
                }
            });
            // Text girdilerini de ekleyelim (eğer onlar da etiket sayılacaksa, ama şimdilik sadece checkbox/radio etiketleri)
            return [...new Set(tags)];
        }

        var dropzone = document.getElementById('mediaDropzone');
        if(dropzone) {
            dropzone.addEventListener('dragover', function(e) {
                e.preventDefault();
                dropzone.style.borderColor = '#0d6efd';
                dropzone.style.backgroundColor = '#e9ecef';
            });
            dropzone.addEventListener('dragleave', function(e) {
                e.preventDefault();
                dropzone.style.borderColor = '#cbd5e1';
                dropzone.style.backgroundColor = '#f8f9fa';
            });
            dropzone.addEventListener('drop', function(e) {
                e.preventDefault();
                dropzone.style.borderColor = '#cbd5e1';
                dropzone.style.backgroundColor = '#f8f9fa';
                
                if(e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    document.getElementById('mediaFileInput').files = e.dataTransfer.files;
                    handleMediaSelect({ target: { files: e.dataTransfer.files } });
                }
            });
        }

        async function handleMediaSelect(event) {
            var files = event.target.files;
            if(!files || files.length === 0) return;

            document.getElementById('mediaUploadProgress').style.display = 'block';

            for(let i = 0; i < files.length; i++) {
                var file = files[i];
                var formData = new FormData();
                formData.append('file', file);

                try {
                    var response = await fetch('/api/PropertyImageApi/upload-and-label', {
                        method: 'POST',
                        body: formData
                    });
                    
                    if(response.ok) {
                        var data = await response.json();
                        addMediaToGrid(data);
                    } else {
                        console.error('Dosya yükleme hatası:', file.name);
                    }
                } catch(error) {
                    console.error('Bağlantı hatası:', error);
                }
            }

            document.getElementById('mediaUploadProgress').style.display = 'none';
            document.getElementById('mediaFileInput').value = '';
            updateMediaIndexes();
        }

        function addMediaToGrid(mediaData) {
            var grid = document.getElementById('mediaPreviewGrid');
            var index = mediaCounter++;
            
            var tags = getSelectedRoomTags();
            // Varsayılan bazı etiketleri ekleyelim, eğer hiç özellik seçilmediyse
            if(tags.length === 0) {
                tags = ['Salon', 'Banyo', 'Mutfak', 'Yatak Odası', 'Balkon', 'Manzara', 'Dış Cephe'];
            }
            
            // AI modelinden gelen etiket tags içinde yoksa ekle
            if (mediaData.aiLabel && mediaData.aiLabel !== "Oda" && !tags.includes(mediaData.aiLabel)) {
                tags.unshift(mediaData.aiLabel);
            }

            var tagsHtml = tags.map(tag => {
                var isSelected = (tag === mediaData.aiLabel) ? 'btn-primary text-white' : 'btn-outline-secondary';
                return `<button type="button" class="btn btn-sm ${isSelected} rounded-pill me-1 mb-1 room-tag-btn" onclick="selectRoomTag(this, '${tag}', ${index})">
                    ${tag}
                </button>`;
            }).join('');

            var aiBadgeHtml = mediaData.aiLabel ? `<span class="badge bg-success position-absolute top-0 end-0 m-2 me-5" style="z-index:10;"><i class="bi bi-robot"></i> AI: ${mediaData.aiLabel}</span>` : '';
            var isCoverBadge = (grid.children.length === 0) ? '<span class="badge bg-danger position-absolute top-0 start-0 m-2 cover-badge">KAPAK</span>' : '<span class="badge bg-secondary position-absolute top-0 start-0 m-2 cover-badge" style="display:none;">KAPAK</span>';

            var previewContent = mediaData.isVideo ? 
                `<video src="${mediaData.filePath}" class="card-img-top bg-dark" style="height: 150px; object-fit: cover;" controls></video>` :
                `<img src="${mediaData.filePath}" class="card-img-top bg-light" style="height: 150px; object-fit: cover;" alt="Preview" />`;

            var itemHtml = `
                <div class="col-md-4 col-sm-6 media-grid-item" id="media_item_${index}">
                    <div class="card shadow-sm h-100 position-relative border-0" style="background:#f8f9fa;">
                        ${isCoverBadge}
                        ${aiBadgeHtml}
                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle shadow" onclick="removeMediaItem(${index})" style="z-index:10;"><i class="ph ph-trash"></i></button>
                        
                        ${previewContent}
                        
                        <div class="card-body p-2" style="max-height: 120px; overflow-y: auto;">
                            <small class="text-muted d-block mb-2 fw-bold" style="font-size:0.75rem;"><i class="ph ph-tag"></i> Etiket Seç (İsteğe Bağlı):</small>
                            <div class="tags-container">
                                ${tagsHtml}
                            </div>
                        </div>
                        
                        <input type="hidden" name="ProcessedImages.Index" value="${index}" />
                        <input type="hidden" name="ProcessedImages[${index}].TempPath" value="${mediaData.tempPath || ''}" />
                        <input type="hidden" name="ProcessedImages[${index}].ImageUrl" value="${mediaData.filePath}" />
                        <input type="hidden" name="ProcessedImages[${index}].IsVideo" value="${mediaData.isVideo || false}" />
                        <input type="hidden" name="ProcessedImages[${index}].SortOrder" class="media-sort-order" value="" />
                        <input type="hidden" name="ProcessedImages[${index}].RoomTag" id="room_tag_${index}" value="${mediaData.aiLabel || ''}" />
                    </div>
                </div>
            `;
            grid.insertAdjacentHTML('beforeend', itemHtml);
            
            initSortable();
        }

        function selectRoomTag(btnElement, tagValue, index) {
            var card = btnElement.closest('.card-body');
            var buttons = card.querySelectorAll('.room-tag-btn');
            
            if(btnElement.classList.contains('btn-primary')) {
                btnElement.classList.remove('btn-primary', 'text-white');
                btnElement.classList.add('btn-outline-secondary');
                document.getElementById('room_tag_' + index).value = '';
                return;
            }
            
            buttons.forEach(b => {
                b.classList.remove('btn-primary', 'text-white');
                b.classList.add('btn-outline-secondary');
            });
            
            btnElement.classList.remove('btn-outline-secondary');
            btnElement.classList.add('btn-primary', 'text-white');
            document.getElementById('room_tag_' + index).value = tagValue;
        }

        function removeMediaItem(index) {
            var el = document.getElementById('media_item_' + index);
            if(el) {
                el.remove();
                updateMediaIndexes();
            }
        }

        function updateMediaIndexes() {
            var items = document.querySelectorAll('.media-grid-item');
            items.forEach((item, idx) => {
                var orderInput = item.querySelector('.media-sort-order');
                if(orderInput) orderInput.value = (idx + 1);
                
                var coverBadge = item.querySelector('.cover-badge');
                if(idx === 0) {
                    coverBadge.classList.replace('bg-secondary', 'bg-danger');
                    coverBadge.style.display = 'block';
                } else {
                    coverBadge.classList.replace('bg-danger', 'bg-secondary');
                    coverBadge.style.display = 'none';
                }
            });
        }

        var sortableInstance = null;
        function initSortable() {
            if(!sortableInstance && typeof Sortable !== 'undefined') {
                var grid = document.getElementById('mediaPreviewGrid');
                if(grid) {
                    sortableInstance = new Sortable(grid, {
                        animation: 150,
                        ghostClass: 'opacity-50',
                        onEnd: function () {
                            updateMediaIndexes();
                        }
                    });
                }
            }
        }
    </script>
