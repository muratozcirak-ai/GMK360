                                opt.dataset.floors = b.totalFloors;
                                opt.innerHTML = b.name;
                                blockSelectDropdown.appendChild(opt);
                            });
                            
                            if (data.blocks.length === 1) {
                                blockSelectDropdown.value = data.blocks[0].name;
