@model IEnumerable<GMK360.Core.Entities.Finance.CustomerCurrentAccount>
@{
    ViewData["Title"] = "Müþteri (Veresiye) Cari Hesaplarý";
    Layout = "_ConstructionLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-journal-album text-primary me-2"></i>Müþteri (Açýk Hesap) Defteri</h2>
        <p class="text-muted mb-0">Tadilat/malzeme sattýðýnýz müþterilerin açýk hesap (veresiye) kayýtlarý.</p>
    </div>
    <button class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-person-plus me-2"></i> Yeni Müþteri Cari Aç
    </button>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Müþteri Adý</th>
                        <th>Telefon</th>
                        <th class="text-end">Güncel Borcu (Bakiye)</th>
                        <th class="text-center pe-4">Ýþlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center py-5 text-muted">Henüz açýk hesap / müþteri carisi eklenmemiþ.</td></tr>
                    }
                    @foreach (var account in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                @account.CustomerUser?.FirstName @account.CustomerUser?.LastName
                            </td>
                            <td>@account.CustomerUser?.PhoneNumber</td>
                            <td class="text-end">
                                @if (account.CurrentBalance > 0) {
                                    <span class="text-danger fw-bold">@account.CurrentBalance.ToString("N2") TL</span>
                                } else if (account.CurrentBalance < 0) {
                                    <span class="text-success fw-bold">Avans/Alacaklý: @Math.Abs(account.CurrentBalance).ToString("N2") TL</span>
                                } else {
                                    <span class="text-muted">0.00 TL (Borcu Yok)</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Details" asp-route-id="@account.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-list-check me-1"></i> Defteri Gör
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
