@{
    ViewData["Title"] = "GMK360 - Günlük Kiralama & Pansiyon";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-2 px-md-4 bg-light min-vh-100">
    <div class="d-flex flex-column justify-content-center align-items-center text-center mt-5" style="min-height: 50vh;">
        <i class="ph ph-bed text-muted opacity-25" style="font-size: 8rem;"></i>
        <h2 class="fw-bold mt-4 text-dark">Kayıtlı Tesisiniz Bulunmuyor</h2>
        <p class="text-muted w-50">Otel, pansiyon veya günlük kiralık dairelerinizi buradan yönetebilirsiniz. Henüz bir tesis eklemediniz.</p>
        <button class="btn btn-primary btn-lg rounded-pill px-5 mt-3 shadow-sm" style="background-color: #8b5cf6; border-color: #8b5cf6;">
            <i class="ph ph-plus-circle me-2"></i>Yeni Tesis Ekle
        </button>
    </div>
</div>
