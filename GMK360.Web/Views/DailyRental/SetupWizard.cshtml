@model GMK360.Web.Models.DailyRentalSetupWizardViewModel
@{
    ViewData["Title"] = "0'dan Konaklama Yeri & Oda Kurulum Sihirbazı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <!-- Breadcrumb & Üst Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/DailyRental/Index" class="text-decoration-none">Günlük Kiralama</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sıfırdan Tesis Kurulum Sihirbazı</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-magic text-primary me-2"></i> Konaklama Yeri ve Oda Kurulum Sihirbazı
            </h2>
            <p class="text-muted small">
                Hiçbir sahte/mockup veri olmadan, elinizdeki gerçek varlıkları (tesis/yer) ve oda/dairelerinizi 2 adımda tanımlayın.
            </p>
        </div>
        <div>
            <a href="/DailyRental/Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Vazgeç / Geri Dön
            </a>
        </div>
    </div>

    <!-- Adım Göstergesi (Stepper) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row text-center">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center gap-3">
                        <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            1
                        </div>
                        <div class="text-start">
                            <h6 class="fw-bold mb-0 text-dark">Adım 1: Varlık & Tesis Bilgisi</h6>
                            <small class="text-muted">İşletmenizin veya mülkünüzün temel konumu ve özellikleri</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center justify-content-center gap-3">
                        <div class="rounded-circle bg-success text-white fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            2
                        </div>
                        <div class="text-start">
                            <h6 class="fw-bold mb-0 text-dark">Adım 2: Oda / Daireleri Tanımla</h6>
                            <small class="text-muted">Kullanıma açacağınız birimler, kapasiteler ve gecelik fiyatlar</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="SetupWizard" asp-controller="DailyRental" method="post" id="wizardForm">
        @Html.AntiForgeryToken()

        <!-- BÖLÜM 1: Tesis Bilgileri -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold">1. AŞAMA</span>
                    <h5 class="fw-bold mb-0 text-dark">Tesis / Yer Bilgileri</h5>
                </div>
                <p class="text-muted small mt-1 mb-0">Elinizdeki apart, pansiyon, villa veya günlük daire grubunun adını ve yerini belirtin.</p>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="FacilityName" class="form-label fw-bold">Tesis / İşletme Adı <span class="text-danger">*</span></label>
                        <input asp-for="FacilityName" class="form-control form-control-lg rounded-3" placeholder="Örn: Bodrum Yalıkavak Apart Evleri veya Güneş Butik Pansiyon" required />
                        <span asp-validation-for="FacilityName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FacilityType" class="form-label fw-bold">Tesis Türü</label>
                        <select asp-for="FacilityType" class="form-select form-select-lg rounded-3">
                            <option value="Apart Otel">Apart Otel / Daire Grubu</option>
                            <option value="Butik Pansiyon">Butik Pansiyon / Konukevi</option>
                            <option value="Müstakil Villa">Müstakil Villa / Tatil Evi</option>
                            <option value="Günlük Daire">Tekil Günlük Kiralık Daire</option>
                            <option value="Bungalov">Bungalov / Tiny House</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CityName" class="form-label fw-bold">İl</label>
                        <input asp-for="CityName" class="form-control rounded-3" placeholder="Örn: Muğla" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DistrictName" class="form-label fw-bold">İlçe</label>
                        <input asp-for="DistrictName" class="form-control rounded-3" placeholder="Örn: Bodrum" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NeighborhoodName" class="form-label fw-bold">Mahalle / Bölge</label>
                        <input asp-for="NeighborhoodName" class="form-control rounded-3" placeholder="Örn: Yalıkavak Marina Mevkii" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-bold">Açık Adres (Opsiyonel)</label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="Sokak, Bina No, Tarif" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CheckInTime" class="form-label fw-bold">Giriş Saati (Check-in)</label>
                        <input asp-for="CheckInTime" class="form-control rounded-3" value="14:00" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CheckOutTime" class="form-label fw-bold">Çıkış Saati (Check-out)</label>
                        <input asp-for="CheckOutTime" class="form-control rounded-3" value="11:00" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="KbsFacilityCode" class="form-label fw-bold">
                            <i class="bi bi-shield-check text-success me-1"></i> Emniyet / KBS Tesis Kodu (Opsiyonel)
                        </label>
                        <input asp-for="KbsFacilityCode" class="form-control rounded-3" placeholder="Emniyetten aldığınız KBS Tesis Kodu (varsa)" />
                        <small class="text-muted">Kimlik Bildirim Sistemi (KBS) entegrasyonu için kullanılır. Sonradan da eklenebilir.</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactPhone" class="form-label fw-bold">İletişim / Rezervasyon Telefonu</label>
                        <input asp-for="ContactPhone" class="form-control rounded-3" placeholder="Örn: 0532 000 00 00" />
                    </div>
                </div>
            </div>
        </div>

        <!-- BÖLÜM 2: Oda / Daireleri Tanımlama -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">2. AŞAMA</span>
                        <h5 class="fw-bold mb-0 text-dark">Oda ve Dairelerinizi Ekleyin</h5>
                    </div>
                    <p class="text-muted small mt-1 mb-0">Tesisinize ait yönetmek istediğiniz birimleri (daire, oda, stüdyo vb.) listeleyin.</p>
                </div>
                <button type="button" class="btn btn-outline-success rounded-pill fw-bold" onclick="addUnitRow()">
                    <i class="bi bi-plus-lg me-1"></i> + Yeni Birim / Oda Ekle
                </button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="unitsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 30%;">Birim / Daire / Oda Adı <span class="text-danger">*</span></th>
                                <th style="width: 20%;">Oda Düzeni</th>
                                <th style="width: 15%;">Kişi Kapasitesi</th>
                                <th style="width: 20%;">Gecelik Fiyat (₺)</th>
                                <th style="width: 15%;" class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="unitsTableBody">
                            <!-- Satır 1 -->
                            <tr class="unit-row">
                                <td>
                                    <input type="text" name="Units[0].Name" class="form-control rounded-3" value="Daire 1 (1+1)" placeholder="Örn: Daire 1 veya Oda 101" required />
                                </td>
                                <td>
                                    <select name="Units[0].RoomLayout" class="form-select rounded-3">
                                        <option value="1+0">1+0 (Stüdyo)</option>
                                        <option value="1+1" selected>1+1</option>
                                        <option value="2+1">2+1</option>
                                        <option value="3+1">3+1</option>
                                        <option value="Standart Oda">Standart Çift Kişilik</option>
                                        <option value="Suit Oda">Suit / Jakuzili</option>
                                        <option value="Müstakil Villa">Müstakil Villa</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Units[0].Capacity" class="form-control rounded-3" value="3" min="1" max="20" />
                                </td>
                                <td>
                                    <div class="input-group">
                                        <input type="number" name="Units[0].DailyPrice" class="form-control rounded-3" value="2000" min="0" step="50" required />
                                        <span class="input-group-text bg-light">₺</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="removeUnitRow(this)" title="Satırı Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            <!-- Satır 2 -->
                            <tr class="unit-row">
                                <td>
                                    <input type="text" name="Units[1].Name" class="form-control rounded-3" value="Daire 2 (2+1 Deniz Manzara)" placeholder="Örn: Daire 2 veya Oda 102" required />
                                </td>
                                <td>
                                    <select name="Units[1].RoomLayout" class="form-select rounded-3">
                                        <option value="1+0">1+0 (Stüdyo)</option>
                                        <option value="1+1">1+1</option>
                                        <option value="2+1" selected>2+1</option>
                                        <option value="3+1">3+1</option>
                                        <option value="Standart Oda">Standart Çift Kişilik</option>
                                        <option value="Suit Oda">Suit / Jakuzili</option>
                                        <option value="Müstakil Villa">Müstakil Villa</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Units[1].Capacity" class="form-control rounded-3" value="5" min="1" max="20" />
                                </td>
                                <td>
                                    <div class="input-group">
                                        <input type="number" name="Units[1].DailyPrice" class="form-control rounded-3" value="3200" min="0" step="50" required />
                                        <span class="input-group-text bg-light">₺</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="removeUnitRow(this)" title="Satırı Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold" onclick="addUnitRow()">
                        <i class="bi bi-plus-circle me-1"></i> Bir Başka Daire / Oda Satırı Ekle
                    </button>
                    <span class="text-muted small" id="unitCountBadge">Toplam 2 birim tanımlandı</span>
                </div>
            </div>
        </div>

        <!-- BÖLÜM 3: Tamamlama ve Gönder -->
        <div class="card border-0 shadow-sm rounded-4 bg-primary bg-opacity-10 border-primary border-opacity-25 mb-4">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="fw-bold text-primary mb-1">
                        <i class="bi bi-check2-circle me-2"></i> Kuruluma Hazır mısınız?
                    </h5>
                    <p class="text-muted small mb-0">
                        Kaydettiğinizde tesisiniz ve odalarınız hemen aktifleşir. Sahte veriler olmadan kendi gerçek odalarınızı yönetmeye başlarsınız.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/DailyRental/Index" class="btn btn-light rounded-pill px-4 fw-bold">İptal</a>
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                        <i class="bi bi-rocket-takeoff me-2"></i> Tesisimi ve Odalarımı Kur &rarr;
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    let unitIndex = 2;

    function addUnitRow() {
        const tbody = document.getElementById('unitsTableBody');
        const nextNum = tbody.querySelectorAll('tr').length + 1;

        const row = document.createElement('tr');
        row.className = 'unit-row';
        row.innerHTML = `
            <td>
                <input type="text" name="Units[${unitIndex}].Name" class="form-control rounded-3" value="Birim ${nextNum}" placeholder="Örn: Daire ${nextNum} veya Oda 10${nextNum}" required />
            </td>
            <td>
                <select name="Units[${unitIndex}].RoomLayout" class="form-select rounded-3">
                    <option value="1+0">1+0 (Stüdyo)</option>
                    <option value="1+1" selected>1+1</option>
                    <option value="2+1">2+1</option>
                    <option value="3+1">3+1</option>
                    <option value="Standart Oda">Standart Çift Kişilik</option>
                    <option value="Suit Oda">Suit / Jakuzili</option>
                    <option value="Müstakil Villa">Müstakil Villa</option>
                </select>
            </td>
            <td>
                <input type="number" name="Units[${unitIndex}].Capacity" class="form-control rounded-3" value="3" min="1" max="20" />
            </td>
            <td>
                <div class="input-group">
                    <input type="number" name="Units[${unitIndex}].DailyPrice" class="form-control rounded-3" value="2000" min="0" step="50" required />
                    <span class="input-group-text bg-light">₺</span>
                </div>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="removeUnitRow(this)" title="Satırı Sil">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(row);
        unitIndex++;
        updateUnitCount();
    }

    function removeUnitRow(button) {
        const tbody = document.getElementById('unitsTableBody');
        if (tbody.querySelectorAll('tr').length <= 1) {
            alert('En az 1 adet oda veya daire tanımlamanız gerekmektedir.');
            return;
        }
        button.closest('tr').remove();
        reindexRows();
        updateUnitCount();
    }

    function reindexRows() {
        const rows = document.querySelectorAll('#unitsTableBody tr');
        rows.forEach((row, i) => {
            row.querySelectorAll('input, select').forEach(input => {
                const name = input.getAttribute('name');
                if (name) {
                    input.setAttribute('name', name.replace(/Units\[\d+\]/, `Units[${i}]`));
                }
            });
        });
        unitIndex = rows.length;
    }

    function updateUnitCount() {
        const count = document.querySelectorAll('#unitsTableBody tr').length;
        document.getElementById('unitCountBadge').textContent = `Toplam ${count} birim tanımlandı`;
    }
</script>
