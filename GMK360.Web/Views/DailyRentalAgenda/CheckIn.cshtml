@{
    ViewData["Title"] = "Misafir Giriş (KBS Check-In)";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-person-plus"></i> Yeni Misafir Ekle (KBS Bildirimi)</h5>
    </div>
    <div class="card-body">
        <form id="checkInForm">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">TC Kimlik No</label>
                    <input type="text" id="guestTc" class="form-control" maxlength="11" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Ad</label>
                    <input type="text" id="guestName" class="form-control" oninput="this.value = this.value.toLocaleUpperCase('tr-TR').replace(/[^A-ZÇĞİÖŞÜ\s]/g, '')" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Soyad</label>
                    <input type="text" id="guestSurname" class="form-control" oninput="this.value = this.value.toLocaleUpperCase('tr-TR').replace(/[^A-ZÇĞİÖŞÜ\s]/g, '')" required />
                </div>
            </div>
            <button type="button" class="btn btn-success" onclick="submitKbs()">
                <i class="bi bi-shield-check"></i> Sisteme Kaydet ve Emniyete Bildir
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function submitKbs() {
            var tc = document.getElementById('guestTc').value;
            var name = document.getElementById('guestName').value;
            var surname = document.getElementById('guestSurname').value;

            if(tc.length !== 11) {
                Swal.fire('Hata!', 'TC Kimlik Numarası 11 haneli olmalıdır.', 'error');
                return;
            }
            if(name === '' || surname === '') {
                Swal.fire('Hata!', 'Ad ve Soyad alanları boş bırakılamaz.', 'error');
                return;
            }

            // AJAX Simülasyonu
            Swal.fire({
                title: 'Emniyet Sistemine İletiliyor...',
                text: 'Lütfen bekleyin',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            setTimeout(() => {
                Swal.fire('Başarılı!', 'Misafir kaydı Emniyet KBS sistemine başarıyla bildirildi.', 'success').then(() => {
                    document.getElementById('checkInForm').reset();
                });
            }, 1500);
        }
    </script>
}
