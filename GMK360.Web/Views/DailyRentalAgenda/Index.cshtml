@model IEnumerable<GMK360.Core.Entities.BuildingUnit>
@{
    ViewData["Title"] = "Günlük Kiralama Ajandası (KBS)";
    Layout = "_DashboardLayout";
    var facility = ViewBag.Facility as GMK360.Core.Entities.Building;
}

<!-- FullCalendar Premium CSS -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar-scheduler@6.1.10/main.min.css' rel='stylesheet' />
<style>
    .fc-event { border-radius: 8px; cursor: pointer; border: none; padding: 2px 4px; color: #fff !important; font-weight: bold; font-size: 0.85rem; }
    .status-bekliyor { background-color: #ef4444 !important; } /* Kırmızı */
    .status-kapora { background-color: #f59e0b !important; }   /* Sarı */
    .status-tamamlandi { background-color: #10b981 !important; } /* Yeşil */
    
    .kbs-indicator {
        position: absolute;
        top: 2px;
        right: 4px;
        background: white;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/DailyRental/Index" class="text-decoration-none">Günlük Kiralama</a></li>
                <li class="breadcrumb-item active" aria-current="page">Rezervasyon Ajandası</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-calendar-range text-primary me-2"></i> @(facility?.Name ?? "Günlük Kiralama Ajandası")
        </h2>
        <small class="text-muted">KBS Emniyet Bildirim Entegrasyonlu Canlı Doluluk Takvimi</small>
    </div>
    <div class="d-flex gap-2">
        <a href="/DailyRental/Index" class="btn btn-outline-secondary rounded-pill fw-bold">
            <i class="bi bi-grid me-1"></i> Oda Masası
        </a>
        <button class="btn btn-primary rounded-pill fw-bold" onclick="openReservationModal()">
            <i class="bi bi-plus-lg me-1"></i> Manuel Rezervasyon Gir
        </button>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 rounded-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-4 mb-3 align-items-center" style="font-size: 0.85rem;">
            <div><span class="d-inline-block rounded-circle me-1" style="width:12px; height:12px; background:#ef4444;"></span> Bekliyor</div>
            <div><span class="d-inline-block rounded-circle me-1" style="width:12px; height:12px; background:#f59e0b;"></span> Kapora Alındı</div>
            <div><span class="d-inline-block rounded-circle me-1" style="width:12px; height:12px; background:#10b981;"></span> Tamamlandı</div>
            <div class="ms-auto text-muted">
                ✅ KBS Emniyete Bildirildi &nbsp;|&nbsp; ❗️ KBS Bildirimi Bekliyor
            </div>
        </div>
        <div id='calendar'></div>
    </div>
</div>

<!-- Yeni Müşteri Kayıt Kartı Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-badge text-primary me-2"></i> Müşteri Kayıt Kartı & KBS</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="QuickAddReservation" asp-controller="DailyRental" method="post" id="reservationForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Daire / Oda <span class="text-danger">*</span></label>
                            <select class="form-select rounded-3" id="daireId" name="UnitId" required>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var unit in Model)
                                    {
                                        <option value="@unit.Id" data-price="@(unit.ListPrice ?? 1500)">
                                            @unit.DoorNumber (@(unit.RoomLayout ?? "Standart") - @(unit.ListPrice?.ToString("N0") ?? "1.500") ₺)
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="">Tanımlı Oda Yok</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Giriş Tarihi</label>
                            <input type="date" class="form-control rounded-3" id="checkInDate" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Çıkış Tarihi</label>
                            <input type="date" class="form-control rounded-3" id="checkOutDate" name="EndDate" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required>
                        </div>
                    </div>

                    <div class="card bg-light border-0 mb-4 rounded-3">
                        <div class="card-body">
                            <h6 class="fw-bold text-secondary mb-3">Finansal Bilgiler</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Toplam Tutar</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control rounded-3" id="totalAmount" name="TotalPrice" value="2000" required>
                                        <span class="input-group-text bg-light">₺</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Ödeme Durumu</label>
                                    <select class="form-select rounded-3" id="paymentStatus" name="PaymentStatus">
                                        <option value="Kapora">Kapora Alındı (Sarı)</option>
                                        <option value="Tamamlandi">Tamamlandı (Yeşil)</option>
                                        <option value="Bekliyor">Bekliyor (Kırmızı)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Kişi Sayısı</label>
                                    <input type="number" class="form-control rounded-3" name="GuestCount" value="2" min="1" max="10">
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary mb-3">Misafir Bilgileri (KBS Emniyet Bildirimi)</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Ad Soyad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3" name="GuestName" placeholder="Örn: Ahmet Yılmaz" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Telefon <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control rounded-3" name="GuestPhone" placeholder="0532 xxx xx xx" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">TC / Pasaport No</label>
                            <input type="text" class="form-control rounded-3" name="GuestIdNumber" placeholder="KBS için 11 haneli TCKN">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-between">
                    <span class="text-muted small">Kaydedildiğinde takvime anında işlenir.</span>
                    <div>
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-check-lg me-1"></i> Rezervasyonu Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar JS -->
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar-scheduler@6.1.10/index.global.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                schedulerLicenseKey: 'CC-Attribution-NonCommercial-NoDerivatives',
                initialView: 'resourceTimelineMonth',
                locale: 'tr',
                height: 600,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'resourceTimelineMonth,resourceTimelineWeek'
                },
                resourceAreaWidth: '220px',
                resourceAreaHeaderContent: 'Daireler / Odalar',
                resources: '/DailyRentalAgenda/GetResources',
                events: '/DailyRentalAgenda/GetEvents',
                eventContent: function(arg) {
                    let kbsIcon = arg.event.extendedProps && arg.event.extendedProps.kbs ? '✅' : '❗️';
                    return {
                        html: `<div class="fc-event-main px-1">${arg.event.title} <div class="kbs-indicator text-dark">${kbsIcon}</div></div>`
                    };
                },
                dateClick: function(info) {
                    document.getElementById('checkInDate').value = info.dateStr;
                    if (info.resource) {
                        document.getElementById('daireId').value = info.resource.id;
                    }
                    var myModal = new bootstrap.Modal(document.getElementById('reservationModal'));
                    myModal.show();
                },
                eventClick: function(info) {
                    alert('Rezervasyon: ' + info.event.title + '\nTarih: ' + info.event.startStr + ' - ' + info.event.endStr);
                }
            });

            calendar.render();
        });

        function openReservationModal() {
            var myModal = new bootstrap.Modal(document.getElementById('reservationModal'));
            myModal.show();
        }
    </script>
}
