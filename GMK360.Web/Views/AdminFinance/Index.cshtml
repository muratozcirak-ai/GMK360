@model GMK360.Core.Entities.GlobalFinanceSettings

@{
    ViewData["Title"] = "Finansal Ayarlar";
    var funds = ViewBag.Funds as List<GMK360.Core.Entities.SystemFund>;
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Settings Form -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="mb-0 text-primary fw-bold">Genel Finans Ayarları</h5>
                    <p class="text-muted small">Sistem genelindeki Stopaj, Havuz ve Çekim limitleri</p>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateSettings" method="post">
                        <div class="mb-3">
                            <label class="form-label">Varsayılan Stopaj Oranı (%)</label>
                            <div class="input-group">
                                <input type="number" step="0.01" class="form-control" asp-for="DefaultWithholdingTaxRate" />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">Bireysel kullanıcılara hak ediş yatırılırken kesilecek stopaj vergisi.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Havuz (Escrow) Bekleme Süresi</label>
                            <div class="input-group">
                                <input type="number" class="form-control" asp-for="EscrowHoldDays" />
                                <span class="input-group-text">Gün</span>
                            </div>
                            <small class="text-muted">İşlem yapıldıktan sonra paranın serbest kalacağı yasal bekleme süresi.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Minimum Para Çekme Limiti</label>
                            <div class="input-group">
                                <input type="number" step="0.01" class="form-control" asp-for="MinimumWithdrawalAmount" />
                                <span class="input-group-text">₺</span>
                            </div>
                            <small class="text-muted">Kullanıcının nakit talep edebilmesi için cüzdanında olması gereken minimum tutar.</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Ayarları Kaydet</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- System Funds -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="mb-0 text-success fw-bold">Sistem Fonları</h5>
                    <p class="text-muted small">Platform komisyonlarının dağıtılacağı alt fonlar</p>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-4">
                        @foreach (var fund in funds)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0 @(!fund.IsActive ? "text-muted text-decoration-line-through" : "")">
                                        @fund.Name
                                    </h6>
                                    <small class="text-muted">Pay: %@fund.Percentage | Bakiye: @fund.Balance.ToString("C")</small>
                                </div>
                                <form asp-action="ToggleFund" method="post">
                                    <input type="hidden" name="id" value="@fund.Id" />
                                    <button type="submit" class="btn btn-sm @(fund.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(fund.IsActive ? "Pasife Al" : "Aktifleştir")
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>

                    <form asp-action="AddFund" method="post" class="bg-light p-3 rounded">
                        <h6 class="mb-3">Yeni Fon Ekle</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="text" name="name" class="form-control" placeholder="Fon Adı (Örn: AR-GE)" required />
                            </div>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input type="number" step="0.1" name="percentage" class="form-control" placeholder="Yüzde" required />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-success w-100">+</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
            <a asp-action="Escrows" class="btn btn-outline-primary w-100 p-3 shadow-sm text-start d-flex justify-content-between align-items-center">
                <span><i class="bi bi-wallet2 me-2"></i> Havuz (Escrow) İşlemlerini Görüntüle</span>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>
</div>
