@model IEnumerable<GMK360.Core.Entities.FinancialObligationType>
@{
    ViewData["Title"] = "Dinamik Vergi & Yükümlülük Motoru";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-navy mb-1"><i class="ph-fill ph-bank me-2"></i> Vergi ve Yükümlülükler</h3>
        <p class="text-muted fs-6 mb-0">Sistemdeki tüm yasal vergi ve ödeme kalemlerini buradan yönetebilirsiniz.</p>
    </div>
    <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#obligationModal" onclick="resetObligationModal()">
        <i class="ph ph-plus me-1"></i> Yeni Kural Ekle
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
        <i class="ph-fill ph-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Vergi / Ödeme Türü</th>
                        <th>Kapsam (Mülk Tipi)</th>
                        <th>Sorumlu</th>
                        <th>Ödeme Sıklığı</th>
                        <th>1. Taksit</th>
                        <th>2. Taksit</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">
                                @item.Name
                            </td>
                            <td>
                                @if (item.TargetPropertyType == GMK360.Core.Entities.TargetPropertyType.All)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Tümü</span>
                                }
                                else if (item.TargetPropertyType == GMK360.Core.Entities.TargetPropertyType.OnlyResidential)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info">Sadece Konut</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning">Sadece İşyeri</span>
                                }
                            </td>
                            <td>
                                @(item.ResponsibleRole == GMK360.Core.Entities.ResponsibleRole.Owner ? "Mülk Sahibi" : "Kiracı")
                            </td>
                            <td>
                                @if (item.PaymentFrequency == GMK360.Core.Entities.PaymentFrequency.Yearly)
                                {
                                    <span>Yıllık (Tek)</span>
                                }
                                else if (item.PaymentFrequency == GMK360.Core.Entities.PaymentFrequency.Biannual)
                                {
                                    <span>Yılda İki Taksit</span>
                                }
                                else
                                {
                                    <span>Aylık</span>
                                }
                            </td>
                            <td>@(item.FirstInstallmentMonth?.ToString() ?? "-"). Ay</td>
                            <td>@(item.SecondInstallmentMonth?.ToString() ?? "-"). Ay</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3">Pasif</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light text-primary me-1" onclick="editObligation(@item.Id, '@Html.Raw(item.Name)', @((int)item.TargetPropertyType), @((int)item.ResponsibleRole), @((int)item.PaymentFrequency), @(item.FirstInstallmentMonth ?? 0), @(item.SecondInstallmentMonth ?? 0))">
                                    <i class="ph ph-pencil-simple"></i>
                                </button>
                                <form action="/AdminFinance/ToggleObligationType" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-light text-warning" title="Aktif/Pasif Yap">
                                        <i class="ph ph-power"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Henüz hiç vergi kuralı tanımlanmamış.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="obligationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form action="/AdminFinance/SaveObligationType" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="modId" value="0" />
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold" id="modTitle">Vergi/Yükümlülük Kuralı Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-medium small">Kural Adı (Vergi Türü)</label>
                        <input type="text" name="Name" id="modName" class="form-control" required placeholder="Örn: İlan Reklam Vergisi">
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium small">Kapsam (Mülk Tipi)</label>
                            <select name="TargetPropertyType" id="modTarget" class="form-select">
                                <option value="3">Tümü (Daire & Dükkan)</option>
                                <option value="1">Sadece Konut (Daire)</option>
                                <option value="2">Sadece İşyeri (Dükkan)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium small">Sorumlu Kişi</label>
                            <select name="ResponsibleRole" id="modRole" class="form-select">
                                <option value="1">Mülk Sahibi</option>
                                <option value="2">Kiracı</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium small">Ödeme Sıklığı</label>
                        <select name="PaymentFrequency" id="modFreq" class="form-select">
                            <option value="2">Yıllık (Tek Sefer)</option>
                            <option value="3">Yılda İki Taksit (Biannual)</option>
                            <option value="1">Aylık</option>
                        </select>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium small">1. Taksit Ayı (Rakamla)</label>
                            <input type="number" name="FirstInstallmentMonth" id="modFirst" class="form-control" min="1" max="12" placeholder="Örn: 3 (Mart)">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium small">2. Taksit Ayı (Rakamla)</label>
                            <input type="number" name="SecondInstallmentMonth" id="modSecond" class="form-control" min="1" max="12" placeholder="Örn: 11 (Kasım)">
                            <small class="text-muted" style="font-size: 0.7rem;">Sadece 2 taksitliyse doldurun.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function resetObligationModal() {
            document.getElementById('modId').value = "0";
            document.getElementById('modTitle').innerText = "Vergi/Yükümlülük Kuralı Ekle";
            document.getElementById('modName').value = "";
            document.getElementById('modTarget').value = "3";
            document.getElementById('modRole').value = "1";
            document.getElementById('modFreq').value = "2";
            document.getElementById('modFirst').value = "";
            document.getElementById('modSecond').value = "";
        }

        function editObligation(id, name, target, role, freq, first, second) {
            document.getElementById('modId').value = id;
            document.getElementById('modTitle').innerText = "Vergi Kuralını Düzenle";
            document.getElementById('modName').value = name;
            document.getElementById('modTarget').value = target;
            document.getElementById('modRole').value = role;
            document.getElementById('modFreq').value = freq;
            document.getElementById('modFirst').value = first > 0 ? first : "";
            document.getElementById('modSecond').value = second > 0 ? second : "";
            
            var modal = new bootstrap.Modal(document.getElementById('obligationModal'));
            modal.show();
        }
    </script>
}
