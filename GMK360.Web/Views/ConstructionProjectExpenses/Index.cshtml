@model IEnumerable<GMK360.Core.Entities.Construction.ConstructionProjectExpense>
@{
    ViewData["Title"] = "Proje Genel Giderleri";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-receipt"></i> Proje Genel Giderleri (Akaryakıt, İaşe, Ağırlama)</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
            <i class="bi bi-plus-circle"></i> Yeni Gider Ekle
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form method="get" class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Projeye Göre Filtrele</label>
                    <select name="projectId" class="form-select" asp-items="ViewBag.Projects" onchange="this.form.submit()">
                        <option value="">-- Tüm Projeler --</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Proje</th>
                            <th>Kategori</th>
                            <th>Başlık / Açıklama</th>
                            <th>Belge No</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ExpenseDate.ToShortDateString()</td>
                                <td>@item.Project?.Name</td>
                                <td><span class="badge bg-secondary">@item.ExpenseType</span></td>
                                <td>
                                    <strong>@item.Title</strong><br/>
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>@item.DocumentNo</td>
                                <td class="fw-bold">@item.Amount.ToString("C2")</td>
                                <td>
                                    @if(item.IsPaid)
                                    {
                                        <span class="badge bg-success">Ödendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Ödenecek</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if(!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">Henüz genel gider faturası/fişi girilmemiş.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Proje Gideri (Fiş/Fatura) Gir</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">İlgili Proje</label>
                        <select name="ProjectId" class="form-select" asp-items="ViewBag.Projects" required></select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Gider Türü</label>
                        <select name="ExpenseType" class="form-select" required>
                            <option value="1">Şantiye İaşesi (Yemek, Çay, Su)</option>
                            <option value="2">Temsil & Ağırlama (Müşteri Yemek, Lansman)</option>
                            <option value="3">Diğer Genel Gider (Akaryakıt, Ofis, Ulaşım)</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Kısa Başlık (Örn: Haftalık Akaryakıt)</label>
                        <input type="text" name="Title" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Detaylı Açıklama / Kişi Bilgisi (Örn: Ahmet Bey'e satış yemeği)</label>
                        <textarea name="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Tutar</label>
                        <input type="number" step="0.01" name="Amount" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Fiş / Fatura No</label>
                        <input type="text" name="DocumentNo" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Tarih</label>
                        <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-6 pt-4">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" name="IsPaid" value="true" id="isPaid" checked>
                            <label class="form-check-label" for="isPaid">Ödemesi Yapıldı (Kasadan Çıktı)</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>