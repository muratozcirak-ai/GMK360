                            </div>
                        </div>
                        <!-- 2. İMALAT (UYGULAMA) -->
                        <div class="col-lg-3 col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-light bg-opacity-25">
                                <div class="fw-bold text-warning text-dark mb-2 small d-flex align-items-center gap-1 border-bottom pb-2">
                                    <i class="fas fa-tools text-warning fs-6"></i> 2. İmalat (Saha Uygulama)
                                </div>
                                <div class="substeps-category-list">
                                    ${renderSubStepsCategory(s.stepCode, subSteps, 'Execution')}
                                </div>
                            </div>
                        </div>
                        <!-- 3. KALİTE KONTROL & KÜRLENME -->
                        <div class="col-lg-3 col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-light bg-opacity-25">
                                <div class="fw-bold text-success mb-2 small d-flex align-items-center gap-1 border-bottom pb-2">
                                    <i class="fas fa-vial text-success fs-6"></i> 3. Kalite Kontrol & Kürlenme
                                </div>
                                <div class="substeps-category-list">
                                    ${renderSubStepsCategory(s.stepCode, subSteps, 'QualityAndCuring')}
                                </div>
                            </div>
                        </div>
                        <!-- 4. İSG VE TEDBİRLER -->
                        <div class="col-lg-3 col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-light bg-opacity-25">
                                <div class="fw-bold text-danger mb-2 small d-flex align-items-center gap-1 border-bottom pb-2">
                                    <i class="fas fa-hard-hat text-danger fs-6"></i> 4. İSG & Saha Güvenliği
                                </div>
                                <div class="substeps-category-list">
                                    ${renderSubStepsCategory(s.stepCode, subSteps, 'SafetyIsg')}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </td>
        `;
    }

    function renderSubStepsCategory(stepCode, subSteps, category) {
        var items = subSteps.filter(item => item.category === category);
        if(items.length === 0) {
            return `<div class="text-muted small fst-italic py-2">Bu aşamada henüz kontrol maddesi yok.</div>`;
        }

        return items.map((item, idx) => `
            <div class="p-2 mb-2 bg-white rounded border shadow-xs">
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" ${item.isCompleted ? 'checked' : ''} 
                           id="chk-${stepCode}-${category}-${idx}"
                           onchange="toggleSubStepCheck('${stepCode}', '${item.title.replace(/'/g, "\\'")}', this.checked)">
                    <label class="form-check-label small fw-semibold text-dark" for="chk-${stepCode}-${category}-${idx}">
                        ${item.title}
                    </label>
                </div>
                ${item.testResultValue ? `
                    <div class="small text-info fw-bold bg-info bg-opacity-10 p-1 px-2 rounded border border-info border-opacity-25 mt-1">
                        <i class="fas fa-flask me-1"></i>${item.testResultValue}
                    </div>
                ` : ''}
                ${item.notes ? `
                    <div class="small text-muted mt-1">
                        <i class="fas fa-comment-dots me-1 text-secondary"></i>${item.notes}
                    </div>
                ` : ''}
                <div class="d-flex gap-1 mt-1 flex-wrap">
                    ${item.photoUrl ? `
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 small" onclick="alert('📸 Saha Fotoğrafı: ${item.title}')">
                            <i class="fas fa-camera me-1"></i> Foto
                        </button>
                    ` : ''}
                    ${item.documentUrl ? `
                        <button type="button" class="btn btn-xs btn-outline-dark rounded-pill py-0 px-2 small" onclick="alert('📄 Belge / Rapor: ${item.title}')">
                            <i class="fas fa-file-pdf me-1"></i> Rapor
                        </button>
                    ` : ''}
                </div>
            </div>
        `).join("");
    }

    function toggleSubStepCheck(stepCode, itemTitle, checked) {
        var step = cachedWorkflowSteps.find(s => s.stepCode === stepCode);
        if(step && step.subSteps) {
            var item = step.subSteps.find(i => i.title === itemTitle);
            if(item) {
                item.isCompleted = checked;
            }
        }
    }

    // =========================================================================
    // DİNAMİK ALAN GÜNCELLEMELERİ (INPUTLAR & REAL-TIME HESAPLAMA)
    // =========================================================================
    function updateStepQuantity(stepCode, val) {
        var step = cachedWorkflowSteps.find(s => s.stepCode === stepCode);
        if(step) {
            step.materialQuantity = parseFloat(val) || 0;
        }
    }

    function updateStepDuration(stepCode, val) {
        var step = cachedWorkflowSteps.find(s => s.stepCode === stepCode);
        if(step) {
            step.durationDays = parseInt(val) || 1;
            recalculateSummaryAndBadges(stepCode);
        }
    }

    function updateStepCrew(stepCode, val) {
        var step = cachedWorkflowSteps.find(s => s.stepCode === stepCode);
        if(step) {
            step.crewSize = parseInt(val) || 1;
            recalculateSummaryAndBadges(stepCode);
        }
    }

    function recalculateSummaryAndBadges(stepCode) {
        var step = cachedWorkflowSteps.find(s => s.stepCode === stepCode);
        if(step) {
            var manDays = step.durationDays * step.crewSize;
            step.totalManDays = manDays;
            
            // Tüm sekmelerdeki bu kalemin Adam-Gün rozetlerini anında güncelle
            document.querySelectorAll(`.badge-mandays-${stepCode}`).forEach(el => {
                el.innerText = manDays + " Adam-Gün";
            });
        }
        
        recalculateGlobalSummary();
    }

    function recalculateGlobalSummary() {
        var totalDays = cachedWorkflowSteps.reduce((sum, s) => sum + (parseInt(s.durationDays) || 0), 0);
        var totalMan = cachedWorkflowSteps.reduce((sum, s) => sum + ((parseInt(s.durationDays) || 0) * (parseInt(s.crewSize) || 0)), 0);
        var maxCrew = cachedWorkflowSteps.reduce((max, s) => Math.max(max, (parseInt(s.crewSize) || 0)), 0);
        
        var elDays = document.getElementById("wfTotalDays");
        if(elDays) elDays.innerText = "~" + totalDays + " İş Günü";
        var elMan = document.getElementById("wfTotalManDays");
        if(elMan) elMan.innerText = "~" + totalMan + " Adam-Gün";
        var elCrew = document.getElementById("wfMaxCrew");
        if(elCrew) elCrew.innerText = maxCrew + " Kişi";

        var elComp = document.getElementById("wfEstCompletion");
        if(elComp) {
            var startDateVal = document.getElementById("workflowStartDateInput")?.value;
            if(startDateVal && totalDays > 0) {
                var d = new Date(startDateVal);
                d.setDate(d.getDate() + totalDays);
                elComp.innerText = d.toLocaleDateString("tr-TR");
            } else {
                elComp.innerText = "-";
            }
        }
    }

    // =========================================================================
    // YENİ İMALAT VE ALT ADIM EKLEME MOTORU
    // =========================================================================
    function openAddStepModal(partIdx) {
        var pSelect = document.getElementById("newStepPartIndex");
        if(pSelect) pSelect.value = partIdx || 1;
        var modalEl = document.getElementById("addStepModal");
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    function saveNewStep() {
        var pIdx = parseInt(document.getElementById("newStepPartIndex").value) || 1;
        var phaseName = document.getElementById("newStepPhaseName").value.trim();
        if(!phaseName) {
            alert("Lütfen imalat adını giriniz.");
            return;
        }
        var profession = document.getElementById("newStepProfession").value.trim() || "İnşaat Ustası";
        var crewSize = parseInt(document.getElementById("newStepCrew").value) || 4;
        var durationDays = parseInt(document.getElementById("newStepDuration").value) || 5;
        var matTitle = document.getElementById("newStepMaterialTitle").value.trim() || phaseName + " Malzemesi";
        var matQty = parseFloat(document.getElementById("newStepQuantity").value) || 100;
        var matUnit = document.getElementById("newStepUnit").value.trim() || "m²";

        var codeNum = cachedWorkflowSteps.length + 1;
        var stepCode = (pIdx === 1 ? "K-" : (pIdx === 2 ? "S-" : (pIdx === 3 ? "D-" : "M-"))) + (codeNum < 10 ? "0" + codeNum : codeNum);

        var partDef = partDefinitions.find(p => p.index === pIdx) || partDefinitions[0];

        var newStep = {
            stepCode: stepCode,
            order: codeNum,
            phaseName: phaseName,
            stageCategory: partDef.name,
            partIndex: pIdx,
            partName: partDef.name,
            partBadgeClass: partDef.badgeClass,
            triggerRule: "Şantiye planına göre başlar",
            targetStructureName: currentActiveBuildingName,
            targetBuildingId: currentActiveBuildingId,
            materialTitle: matTitle,
            materialDescription: phaseName + " için gerekli malzeme sevkiyatı ve sarfiyatı",
            materialQuantity: matQty,
            materialUnit: matUnit,
            materialFormula: "Şantiye şefi girişi",
            supplierCategory: "İlgili İmalat Tedarikçisi",
            laborTitle: profession + " Ekibi",
            professionName: profession,
            crewComposition: crewSize + " Kişilik " + profession + " Ekibi",
            crewSize: crewSize,
            durationDays: durationDays,
            totalManDays: crewSize * durationDays,
            equipmentNeeded: "Standart şantiye el aletleri ve ekipmanı",
            predecessors: "Önceki aşamanın teslimi",
            criticalDependency: "İmalat kontrol tutanağı imzalanmadan bir sonraki işe geçilemez",
            dnaSource: "Şantiye Şefi Girişi",
            plannedStartDate: new Date(),
            plannedEndDate: new Date(Date.now() + durationDays * 86400000),
            plannedDateRange: "Tarih Girişe Göre Hesaplanır",
            subSteps: [
                { title: "T-3 Malzeme Siparişi & Sevkiyat Teyidi", category: "PrePreparation", isCompleted: false },
                { title: "T-1 Yüzey Hazırlığı & Ön Kontrol", category: "PrePreparation", isCompleted: false },
                { title: "Saha İmalat ve Uygulama", category: "Execution", isCompleted: false },
                { title: "Kalite & Tolerans Kontrolü", category: "QualityAndCuring", isCompleted: false },
                { title: "İSG ve KKD Denetimi", category: "SafetyIsg", isCompleted: true }
            ]
        };

        cachedWorkflowSteps.push(newStep);
        renderAllWorkflowTables(cachedWorkflowSteps);

        var modalEl = document.getElementById("addStepModal");
        var modal = bootstrap.Modal.getInstance(modalEl);
        if(modal) modal.hide();

        document.getElementById("newStepPhaseName").value = "";
        document.getElementById("newStepMaterialTitle").value = "";
    }

    function openAddSubStepModal(stepCode) {
        document.getElementById("subStepTargetCode").value = stepCode;
        var modalEl = document.getElementById("addSubStepModal");
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    function saveNewSubStep() {
        var stepCode = document.getElementById("subStepTargetCode").value;
        var title = document.getElementById("subStepTitle").value.trim();
        var category = document.getElementById("subStepCategory").value;
        var testVal = document.getElementById("subStepTestVal").value.trim();
        var notes = document.getElementById("subStepNotes").value.trim();

        if(!title) {
            alert("Lütfen kontrol maddesi başlığını giriniz.");
            return;
        }

        var step = cachedWorkflowSteps.find(s => s.stepCode === stepCode);
        if(step) {
            if(!step.subSteps) step.subSteps = [];
            step.subSteps.push({
                title: title,
                category: category,
                isCompleted: false,
                testResultValue: testVal || null,
                notes: notes || null
            });
            renderAllWorkflowTables(cachedWorkflowSteps);
        }

        var modalEl = document.getElementById("addSubStepModal");
        var modal = bootstrap.Modal.getInstance(modalEl);
        if(modal) modal.hide();

        document.getElementById("subStepTitle").value = "";
        document.getElementById("subStepTestVal").value = "";
        document.getElementById("subStepNotes").value = "";
    }

    function expandCollapseAll(expand) {
        for (var i = 1; i <= 4; i++) {
            ['collapseMaterialPart', 'collapseLaborPart', 'collapseTimePart'].forEach(prefix => {
                var el = document.getElementById(prefix + i);
                if (el) {
                    var bs = bootstrap.Collapse.getInstance(el) || new bootstrap.Collapse(el, { toggle: false });
                    if (expand) bs.show();
                    else bs.hide();
                }
            });
        }
    }

    function togglePartMaterials(partIdx, checked) {
        document.querySelectorAll(".part-mat-check-" + partIdx).forEach(cb => cb.checked = checked);
        updateMaterialCounter();
    }

    function togglePartLabor(partIdx, checked) {
        document.querySelectorAll(".part-lab-check-" + partIdx).forEach(cb => cb.checked = checked);
        updateLaborCounter();
    }

    function toggleAllMaterials(checked) {
        document.querySelectorAll(".material-step-check").forEach(cb => cb.checked = checked);
        updateMaterialCounter();
    }

    function updateMaterialCounter() {
        var count = document.querySelectorAll(".material-step-check:checked").length;
        var span = document.getElementById("selectedMaterialCount");
        if(span) span.innerText = count;
        var btn = document.getElementById("btnSendMaterialsB2B");
        if(btn) btn.disabled = (count === 0);
    }

    function toggleAllLabor(checked) {
        document.querySelectorAll(".labor-step-check").forEach(cb => cb.checked = checked);
        updateLaborCounter();
    }

    function updateLaborCounter() {
        var count = document.querySelectorAll(".labor-step-check:checked").length;
        var span = document.getElementById("selectedLaborCount");
        if(span) span.innerText = count;
        var btn = document.getElementById("btnSendLaborB2B");
        if(btn) btn.disabled = (count === 0);
    }

    function sendWorkflowTrack(track) {
        var selector = track === "Labor" ? ".labor-step-check:checked" : ".material-step-check:checked";
        var selectedCodes = Array.from(document.querySelectorAll(selector)).map(cb => cb.value);

        if(selectedCodes.length === 0) {
            alert("Lütfen en az bir aşama seçiniz.");
            return;
        }

        var btnId = track === "Labor" ? "btnSendLaborB2B" : "btnSendMaterialsB2B";
        var btn = document.getElementById(btnId);
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> İhale Paketi Gönderiliyor...`;

        fetch("/Metraj/SendWorkflowToB2B", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                ProjectId: currentProjectId,
                ProfileId: currentActiveProfileId,
                BuildingId: currentActiveBuildingId,
                TargetTrack: track,
                SelectedStepCodes: selectedCodes
            })
        })
        .then(res => res.json())
        .then(data => {
            if(data && data.success) {
                alert("🎉 " + data.message + "\n\nŞimdi B2B Satın Alma & Teklifler Masası yeni sekmede açılıyor.");
                window.open("/B2BPurchasing/Index", "_blank");
                btn.disabled = false;
                btn.innerHTML = track === "Labor" 
                    ? `<i class="fas fa-users-cog me-2"></i> Seçilen Branşlar İçin Taşeron / Kadro Çağrısı Aç`
                    : `<i class="fas fa-shopping-cart me-2"></i> Seçilen Malzemeleri B2B Satın Alma İhalesine Gönder`;
            } else {
                alert("Hata: " + (data ? data.message : "İşlem yapılamadı."));
                btn.disabled = false;
                btn.innerHTML = track === "Labor" 
                    ? `<i class="fas fa-users-cog me-2"></i> Seçilen Branşlar İçin Taşeron / Kadro Çağrısı Aç`
                    : `<i class="fas fa-shopping-cart me-2"></i> Seçilen Malzemeleri B2B Satın Alma İhalesine Gönder`;
            }
        })
        .catch(err => {
            console.error(err);
            alert("Sunucuya bağlanırken bir hata oluştu.");
            btn.disabled = false;
        });
    }

    function triggerWorkflowToAgenda() {
        var startDateVal = document.getElementById("workflowStartDateInput")?.value || "";
        if(!startDateVal) {
            alert("Lütfen bir işbaşı tarihi seçiniz.");
            return;
        }

        var selectedCodes = Array.from(document.querySelectorAll(".material-step-check:checked")).map(cb => cb.value);
        if(selectedCodes.length === 0) {
            selectedCodes = cachedWorkflowSteps.map(s => s.stepCode);
        }

        if(selectedCodes.length === 0) {
            alert("Ajandaya işlenecek hiçbir imalat kalemi bulunmuyor. Lütfen önce imalat ekleyiniz veya şablonu getiriniz.");
            return;
        }

        var btn = document.getElementById("btnTriggerAgenda");
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Kara Deftere İşleniyor...`;

        fetch("/Metraj/TriggerWorkflowAgenda", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                ProjectId: currentProjectId,
                ProfileId: currentActiveProfileId,
                BuildingId: currentActiveBuildingId,
                StartDate: startDateVal,
                SelectedStepCodes: selectedCodes
            })
        })
        .then(res => res.json())
        .then(data => {
            if(data && data.success) {
                alert("🚀 " + data.message + "\n\nŞantiye Ajandası ve Kara Defter yeni sekmede açılıyor.");
                window.open("/Metraj/SiteAgenda/" + currentProjectId + "?baseDate=" + startDateVal 
                            + (currentActiveProfileId ? "&profileId=" + currentActiveProfileId : "")
                            + (currentActiveBuildingId ? "&buildingId=" + currentActiveBuildingId : ""), "_blank");
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-check-circle me-2 text-success"></i> Ajandaya İşlendi & Puantaj Başlatıldı`;
            } else {
                alert("Hata: " + (data ? data.message : "Ajandaya işlenemedi."));
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-rocket me-2"></i> Kara Deftere & Ajandaya İşle (Puantajı Başlat)`;
            }
        })
        .catch(err => {
            console.error(err);
            alert("Sunucuya bağlanırken bir hata oluştu.");
            btn.disabled = false;
        });
    }
</script>
