<script>
    var currentProjectId = @projectId;
    var currentActiveProfileId = @(activeProfile?.Id ?? 0);
    var currentActiveBuildingId = @(activeStructure?.Id ?? 0);
    var currentActiveBuildingName = "@Html.Raw(activeStructure != null ? (activeStructure.BlockName ?? activeStructure.Name ?? "A Blok") : "A Blok")";
    var cachedWorkflowSteps = [];
    var cachedSiteSetupSteps = [];
    var cachedSiteHandoverSteps = [];
    var cachedStaticSummary = {};
    var currentWorkflowMode = "concrete"; // "concrete" or "empty"

    var partDefinitions = [
        {
            index: 1,
            name: "1. Kademe: Kaba Statik (Beton, Demir, Kalıp & Katlar — 1. Kat+ Vinç Tetiklemeli)",
            badgeClass: "bg-primary text-white",
            borderClass: "border-primary",
            bgHeader: "bg-primary bg-opacity-10",
            triggerRule: "İşbaşı ile başlar. Sırayla: Hafriyat -> Temel Yalıtımı -> Grobeton -> Radye Temel -> Karkas Katlar -> Çatı",
            icon: "fa-layer-group",
            collapsed: false
        },
        {
            index: 2,
            name: "2. Kademe: İnce Statik — Değişmezler (Duvar, Kaba Tesisat, Sıva, Şap, Yalıtım)",
            badgeClass: "bg-info text-dark",
            borderClass: "border-info",
            bgHeader: "bg-info bg-opacity-10",
            triggerRule: "Kaba 2 kat önden gidince alttan başlar! (Örn: 2. kat tabliyesi dökülünce bodrum/zemin duvarları başlar)",
            icon: "fa-running",
            collapsed: false
        },
        {
            index: 3,
            name: "3. Kademe: Değişken İnceler (Doğrama, Fayans, Parke, Boya — Hak Sahibi Seçimli)",
            badgeClass: "bg-warning text-dark",
            borderClass: "border-warning",
            bgHeader: "bg-warning bg-opacity-10",
            triggerRule: "Kat duvarları örülüp tesisat basınç ve sızdırmazlık testleri onaylandığında başlar!",
            icon: "fa-paint-roller",
            collapsed: true
        },
        {
            index: 4,
            name: "4. Kademe: Bağımsız Paketler & Montaj (Kapı, Mutfak, Kombi, Asansör, Kamelya)",
            badgeClass: "bg-success text-white",
            borderClass: "border-success",
            bgHeader: "bg-success bg-opacity-10",
            triggerRule: "Daire içi boya ve parke bitince temiz montaj başlar (Kapılar, mutfak, vitrifiye, asansör)",
            icon: "fa-door-open",
            collapsed: true
        }
    ];

    document.addEventListener("DOMContentLoaded", function () {
        loadWorkflowData();
    });

    function selectFocusStructure(bId, bName, cardEl) {
        currentActiveBuildingId = bId;
        currentActiveBuildingName = bName;

        // Kart stillerini güncelle
        document.querySelectorAll(".structure-focus-card").forEach(el => {
            el.className = "p-3 rounded-4 border-2 transition-card h-100 cursor-pointer structure-focus-card border-light bg-light bg-opacity-50";
            var badge = el.querySelector(".badge");
            if (badge) {
                badge.className = "badge bg-secondary text-white rounded-pill px-2 py-1 small";
                badge.innerText = "Seç";
            }
        });

        if (cardEl) {
            cardEl.className = "p-3 rounded-4 border-2 transition-card h-100 cursor-pointer structure-focus-card border-primary bg-primary bg-opacity-10 shadow-sm";
            var badge = cardEl.querySelector(".badge");
            if (badge) {
                badge.className = "badge bg-primary text-white rounded-pill px-2 py-1 small";
                badge.innerText = "✓ Odaklanılan Yapı";
            }
        }

        // Başlık Rozetini Güncelle
        var titleBadge = document.getElementById("activeStructureTitleBadge");
        if (titleBadge) {
            titleBadge.innerHTML = `<i class="fas fa-building me-1"></i> Yapı: ${bName}`;
        }

        loadWorkflowData();
    }

    function onStartDateChange() {
        loadWorkflowData();
    }

    function loadWorkflowData() {
        var startDateVal = document.getElementById("workflowStartDateInput")?.value || "";
        var url = "/Metraj/GetParametricWorkflow?projectId=" + currentProjectId 
                + (currentActiveProfileId ? "&profileId=" + currentActiveProfileId : "") 
                + (currentActiveBuildingId ? "&buildingId=" + currentActiveBuildingId : "") 
                + "&startDate=" + startDateVal;

        var mCont = document.getElementById("materialAccordionsContainer");
        if(mCont) mCont.innerHTML = `<div class="text-center p-5 text-muted"><div class="spinner-border text-primary me-2"></div><strong>${currentActiveBuildingName}</strong> için çalışma masası hazırlanıyor...</div>`;
        var lCont = document.getElementById("laborAccordionsContainer");
        if(lCont) lCont.innerHTML = `<div class="text-center p-5 text-muted"><div class="spinner-border text-warning me-2"></div><strong>${currentActiveBuildingName}</strong> için kadro planı hazırlanıyor...</div>`;
        var tCont = document.getElementById("timelineAccordionsContainer");
        if(tCont) tCont.innerHTML = `<div class="text-center p-5 text-muted"><div class="spinner-border text-success me-2"></div><strong>${currentActiveBuildingName}</strong> için takvim hazırlanıyor...</div>`;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                if(data && data.success) {
                    cachedWorkflowSteps = data.steps || [];
                    cachedSiteSetupSteps = data.siteSetupSteps || [];
                    cachedSiteHandoverSteps = data.siteHandoverSteps || [];
                    cachedStaticSummary = data.staticSummary || {};
                    renderTier1SiteSetup(cachedSiteSetupSteps, cachedStaticSummary);
                    renderTier3SiteHandover(cachedSiteHandoverSteps);
                    renderAllWorkflowTables(cachedWorkflowSteps, data.summary);
                }
            })
            .catch(err => {
                console.error(err);
                if(mCont) mCont.innerHTML = `<div class="alert alert-danger m-3">Veri yüklenirken hata oluştu.</div>`;
            });
    }

