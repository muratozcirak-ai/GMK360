                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info text-dark rounded-pill px-2.5 fw-bold" onclick="triggerCrossTeamMirrorTask('${s.stepCode}')">
                                <i class="fas fa-random me-1"></i> Çapraz Ekibe "Olay Anı" Pasla
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openAddSubStepModal('${s.stepCode}')">
                                <i class="fas fa-plus me-1"></i> Yeni Kontrol Maddesi Ekle
                            </button>
                        </div>
                    </div>
                    <div class="row g-3">
                        <!-- 1. ÖN HAZIRLIK (T- GÜNLER) -->
                        <div class="col-lg-3 col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-light bg-opacity-25">
