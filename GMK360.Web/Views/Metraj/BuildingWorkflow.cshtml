                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small">3. Yapılacak Ara İş / Müdahale Açıklaması</label>
                            <input type="text" id="fiTitle" class="form-control" placeholder="Örn: Temeli su bastı dalgıç pompayla boşaltılacak / Şap terazi hatası kırılıp düzeltilecek / 4 saat mobil vinç çağrıldı" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">4. Görev Verilen Ekip / Kişi</label>
                            <select id="fiAssignee" class="form-select">
                                <option value="🦺 Düz İşçi (Yevmiye / Puantaj)">🦺 Düz İşçi (Yevmiye / Puantaj)</option>
                                <option value="🏗️ Kiralık Mobil Vinç / Operatör">🏗️ Kiralık Mobil Vinç / Operatör</option>
                                <option value="🔧 Mekanik / Elektrik Tesisatçısı">🔧 Mekanik / Elektrik Tesisatçısı</option>
                                <option value="🔨 Kalıpçı / Demirci Ekibi">🔨 Kalıpçı / Demirci Ekibi</option>
                                <option value="🧱 Duvar / Sıva / Fayans Ustası">🧱 Duvar / Sıva / Fayans Ustası</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">5. Takvim Kayması (Gecikme Günü)</label>
                            <select id="fiDelayDays" class="form-select">
                                <option value="0">0 Gün (Takvimi Kaydırmaz)</option>
                                <option value="1">+1 Gün Tüm Sonraki İşleri Kaydır</option>
                                <option value="2">+2 Gün Tüm Sonraki İşleri Kaydır</option>
                                <option value="3">+3 Gün Tüm Sonraki İşleri Kaydır</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">6. Ekstra Maliyet / Yevmiye / Fatura (₺)</label>
                            <input type="number" id="fiExtraCost" class="form-control fw-bold" value="4500" placeholder="0" />
                        </div>
                        <div class="col-md-12" id="fiBlameRow">
                            <div class="p-2.5 rounded-3 bg-danger bg-opacity-10 border border-danger d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <span class="small fw-bold text-danger"><i class="fas fa-user-slash me-1"></i>Hatayı Yapan (Maliyetin Hakedişinden Kesileceği) Önceki Ekip:</span>
                                <select id="fiBlamedTeam" class="form-select form-select-sm w-auto fw-bold border-danger">
                                    <option value="Kalıpçı Taşeronu">Kalıpçı Taşeronu (Hakedişinden Düş)</option>
                                    <option value="Demirci Taşeronu">Demirci Taşeronu (Hakedişinden Düş)</option>
                                    <option value="Tesisatçı (Rezervasyon Unuttu)">Tesisatçı - Rezervasyon Unuttu (Hakedişinden Düş)</option>
                                    <option value="Şap / Sıva Ekibi (Terazi Bozuk)">Şap / Sıva Ekibi - Terazi Bozuk (Hakedişinden Düş)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="saveFieldIntervention()">
                        <i class="fas fa-check-circle me-1"></i> Deftere, Puantaja & Muhasebe Kalkanına İşle
                    </button>
                </div>
            </div>
        </div>
