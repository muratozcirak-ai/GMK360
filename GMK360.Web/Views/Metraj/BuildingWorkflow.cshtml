@model dynamic
@{
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var project = ViewBag.Project as GMK360.Core.Entities.Construction.ConstructionProject;
    int projectId = project?.Id ?? 0;
    ViewData["ProjectId"] = projectId;
    var structures = ViewBag.Structures as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var activeStructure = ViewBag.ActiveStructure as GMK360.Core.Entities.Building ?? structures.FirstOrDefault();
    var savedProfiles = ViewBag.SavedProfiles as List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile> ?? new List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile>();
    var activeProfile = ViewBag.ActiveProfile as GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile ?? savedProfiles.FirstOrDefault();
    ViewData["Title"] = $"{project?.Name ?? "Şantiye"} - Yapı Bazlı İş Akışı & Tedarik Masası";
}

<div class="container-fluid py-4">
    <!-- ÜST NAVİGASYON VE BAŞLIK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/Metraj/ProjectDNA/@projectId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-xs">
                    <i class="fas fa-arrow-left me-1"></i> Kanat 2: DNA Profillerine Dön
                </a>
                <span class="badge bg-success text-white px-3 py-1 rounded-pill fw-bold">
                    <i class="fas fa-check-circle me-1"></i> Onaylı Reçete: @(activeProfile?.Name ?? "Varsayılan DNA Reçetesi")
                </span>
            </div>
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="fas fa-network-wired text-primary"></i>
                <span>Şantiye İş Akışı, Malzeme Tedarik & Kadro Masası</span>
            </h3>
            <p class="text-muted small mt-1 mb-0">Müteahhit ve satın alma kontrol paneli. Başlayacağınız yapıyı seçin; malzeme alım sıralamasını ve ekip işbaşı takvimini izole olarak yönetin.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="dropdown">
                <button class="btn btn-light border dropdown-toggle rounded-pill px-3 fw-bold shadow-xs text-dark" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-dna text-primary me-1"></i> Reçete Değiştir
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    @foreach (var prof in savedProfiles.Where(p => p.Status == "Tamamlandı"))
                    {
                        <li>
                            <a class="dropdown-item @(activeProfile != null && activeProfile.Id == prof.Id ? "active fw-bold" : "")" 
                               href="/Metraj/BuildingWorkflow/@projectId?profileId=@prof.Id&buildingId=@(activeStructure?.Id ?? 0)">
                                <i class="fas fa-check-circle me-2 text-success"></i> @prof.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <a href="/Metraj/SiteAgenda/@projectId?profileId=@(activeProfile?.Id ?? 0)&buildingId=@(activeStructure?.Id ?? 0)" target="_blank" rel="noopener noreferrer" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-external-link-alt me-1"></i> Kara Defter & Ajanda &rarr;
            </a>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🌐 TIER 1: PROJE GENELİ & ŞANTİYE ORTAK SAHASI (HAFRİYAT ÖNCESİ 8 KURULUM) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-top border-4 border-dark" id="tier1SiteSetupMasterCard">
        <div class="card-header bg-dark text-white p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
                    <i class="fas fa-campground text-warning fs-5"></i>
                    <span>Üst Alan: Proje Geneli & Şantiye Ortak Sahası (Hafriyat Öncesi Kurulum)</span>
                </h6>
                <small class="text-white-50">Tüm parsel için hafriyat başlamadan önce 1 defa kurulur; blokların (A Blok, Bitişik Bloklar, Ortak Baza) altına asla tekrar girmez!</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold small">
                    <i class="fas fa-check-double me-1"></i> Tüm Parsel İçin 1 Defa Yapılır (8 Madde)
                </span>
                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#collapseTier1Setup" aria-expanded="true">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
        </div>
        <div id="collapseTier1Setup" class="collapse show">
            <div class="card-body p-4 bg-light bg-opacity-25">
                <div class="row g-4">
                    <!-- SOL: ADIM 0 STATİK OMURGA KARTI -->
                    <div class="col-xl-4 col-lg-5">
                        <div class="card border-0 shadow-xs rounded-4 bg-white p-3 h-100 border-start border-4 border-danger">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <i class="fas fa-atom text-danger"></i>
                                    <span>Adım 0: Statik Karakter</span>
                                </h6>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-2 py-1 small">
                                    Taşıyıcı Omurga
                                </span>
                            </div>
                            <p class="small text-muted mb-3">Projenin tüm yapılarını kapsayan ana statik parametreler ve mühendislik reçetesi:</p>
                            <div class="list-group list-group-flush rounded-3 small">
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 bg-light rounded-2 mb-2 border-0">
                                    <span class="text-muted"><i class="fas fa-cubes text-secondary me-1"></i> Taşıyıcı Beton:</span>
                                    <span class="fw-bold text-dark" id="tier1ConcreteClass">C30/37 Taşıyıcı Beton</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 bg-light rounded-2 mb-2 border-0">
                                    <span class="text-muted"><i class="fas fa-bars text-secondary me-1"></i> Donatı Çeliği:</span>
                                    <span class="fw-bold text-dark" id="tier1RebarClass">B420C Nervürlü Demir</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 bg-light rounded-2 mb-2 border-0">
                                    <span class="text-muted"><i class="fas fa-border-all text-secondary me-1"></i> Temel Tipi:</span>
                                    <span class="fw-bold text-dark" id="tier1FoundationType">Radye Genel Temel</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 bg-light rounded-2 mb-2 border-0">
                                    <span class="text-muted"><i class="fas fa-network-wired text-secondary me-1"></i> Karkas Taşıyıcı:</span>
                                    <span class="fw-bold text-dark" id="tier1StructureType">Betonarme Karkas</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 bg-light rounded-2 border-0">
                                    <span class="text-muted"><i class="fas fa-building text-secondary me-1"></i> Bağımsız Yapı:</span>
                                    <span class="fw-bold text-primary" id="tier1StructureCount">3 Bağımsız Yapı / Temel</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SAĞ: 8 ORTAK SAHA HAZIRLIĞI KARTI / LİSTESİ -->
                    <div class="col-xl-8 col-lg-7">
                        <div class="card border-0 shadow-xs rounded-4 bg-white p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <i class="fas fa-tools text-warning"></i>
                                    <span>Hafriyat Öncesi 8 Ortak Saha Hazırlığı (Şantiye Kurulumu)</span>
                                </h6>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                                    Parsel Geneli / Ortak Saha
                                </span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" id="tier1SetupTable">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th style="width: 55px;" class="text-center">Kod</th>
                                            <th>Ortak İmalat / Hazırlık Kalemi</th>
                                            <th>Tedarik Edilecek Malzeme / Hizmet</th>
                                            <th>Nereden Alınır? (Esnaf / Tedarikçi)</th>
                                            <th class="text-center" style="width: 130px;">B2B / Alt Adım</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tier1SetupTableBody">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted p-4">
                                                <div class="spinner-border spinner-border-sm text-dark me-2"></div>
                                                Ortak saha hazırlık maddeleri yükleniyor...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🏗️ 1. ADIM: HANGİ YAPIDAN BAŞLIYORUZ? (ODAKLANMA KARTLARI) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-light border-bottom p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="fas fa-cubes text-primary fs-5"></i>
                    <span>1. Adım: Hangi Yapıdan Başlıyoruz? (Yapı & Temel İzolasyonu)</span>
                </h6>
                <small class="text-muted">Projenizdeki bağımsız temeller aşağıda listelenmiştir. Nereden başlayacaksanız o yapıya tıklayarak odaklanın.</small>
            </div>
            <span class="badge bg-danger text-white rounded-pill px-3 py-2 fw-semibold small">
                <i class="fas fa-shield-alt me-1"></i> Şantiye Altın Kuralı: Yapılar Birbirine Karışamaz
            </span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3" id="structureCardsContainer">
                @if (structures != null && structures.Any())
                {
                    foreach (var s in structures)
                    {
                        bool isCurrent = (activeStructure != null && activeStructure.Id == s.Id);
                        var childBlocks = s.ChildBuildings != null && s.ChildBuildings.Any() ? s.ChildBuildings.ToList() : new List<GMK360.Core.Entities.Building>();
                        string sName = s.BlockName ?? s.Name;
                        string childNames = childBlocks.Any() ? $" ({string.Join(" & ", childBlocks.Select(c => c.BlockName ?? c.Name))})" : "";
                        int totalFloors = (s.TotalFloors ?? 0) + s.BasementFloors;
                        double bArea = s.BaseArea ?? 0;
                        int unitCount = (s.Units?.Count ?? 0) + childBlocks.Sum(c => c.Units?.Count ?? 0);

                        <div class="col-lg-4 col-md-6">
                            <div class="p-3 rounded-4 border-2 transition-card h-100 cursor-pointer structure-focus-card @(isCurrent ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "border-light bg-light bg-opacity-50")"
                                 onclick="selectFocusStructure(@s.Id, '@(sName + childNames)', this)"
                                 data-building-id="@s.Id"
                                 style="cursor: pointer; border-style: solid;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded-3 @(isCurrent ? "bg-primary text-white" : "bg-white text-secondary shadow-xs")">
                                            <i class="fas fa-building fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@sName@childNames</h6>
                                            <small class="text-muted">@(childBlocks.Any() ? "Bitişik / Bloklu Yapı" : "Tekil Taşıyıcı Kule")</small>
                                        </div>
                                    </div>
                                    <span class="badge @(isCurrent ? "bg-primary text-white" : "bg-secondary text-white") rounded-pill px-2 py-1 small">
                                        @(isCurrent ? "✓ Odaklanılan Yapı" : "Seç")
                                    </span>
                                </div>
                                <div class="row g-2 text-center mt-2 small">
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-3 border shadow-xs">
                                            <div class="text-muted small">Taban (TAKS)</div>
                                            <div class="fw-bold text-dark">@(bArea > 0 ? bArea.ToString("N0") + " m²" : "Belirtilmedi")</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-3 border shadow-xs">
                                            <div class="text-muted small">Kat Sayısı</div>
                                            <div class="fw-bold text-dark">@(totalFloors > 0 ? totalFloors + " Kat" : "-")</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-3 border shadow-xs">
                                            <div class="text-muted small">Bağımsız Bölüm</div>
                                            <div class="fw-bold text-dark">@(unitCount > 0 ? unitCount + " Daire" : "-")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 📋 2. ADIM: SEÇİLEN YAPIYA ÖZEL İŞ AKIŞI, MALZEME & KADRO ÇALIŞMA MASASI -->
    <!-- ========================================================================= -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 border-top border-4 border-primary overflow-hidden" id="workflowMasterCard">
        <!-- AKTİF YAPI BİLGİ ŞERİDİ & AKSİYON BUTONLARI -->
        <div class="card-header bg-white border-bottom p-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="fas fa-layer-group fa-2x"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-primary text-white px-3 py-1 rounded-pill fw-bold fs-6" id="activeStructureTitleBadge">
                            <i class="fas fa-building me-1"></i> Yapı: @(activeStructure?.BlockName ?? activeStructure?.Name ?? "A Blok")
                        </span>
                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1" id="badgeStepCount">
                            İnşaat Sıralaması: 4 Parça
                        </span>
                    </div>
                    <small class="text-muted">
                        Bu yapı için malzeme alım sıralaması, taşeron kadro ihtiyacı ve işbaşı takvimi aşağıda izole edilmiştir.
                    </small>
                </div>
            </div>

            <!-- ŞEF KONTROL VE AKSİYON ARAÇLARI -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2 bg-light p-1 px-3 rounded-pill border">
                    <label class="small fw-bold text-dark mb-0"><i class="far fa-calendar-alt text-primary me-1"></i>İşbaşı Tarihi:</label>
                    <input type="date" class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark" id="workflowStartDateInput" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="onStartDateChange()" style="width: 135px;">
                </div>
                
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-xs" onclick="loadWorkflowData()" title="Planı Yenile & Senkronize Et">
                    <i class="fas fa-sync-alt me-1"></i> Yenile
                </button>
                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-xs" onclick="openAddStepModal(1)">
                    <i class="fas fa-plus me-1"></i> ➕ Yeni İmalat Ekle
                </button>
                <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-2" onclick="expandCollapseAll(true)" title="Tüm akordeonları aç">Tümünü Aç</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" onclick="expandCollapseAll(false)" title="Tüm akordeonları kapat">Kapat</button>
            </div>
        </div>

        <!-- 3'LÜ ÇALIŞMA MASASI SEKMELERİ -->
        <ul class="nav nav-tabs nav-fill bg-light border-bottom px-3 pt-2" id="workflowMasterTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold py-3 text-primary border-bottom-0" id="tab-materials-btn" data-bs-toggle="tab" data-bs-target="#tab-materials-pane" type="button" role="tab">
                    <i class="fas fa-boxes me-2"></i> 1. Malzeme Sıralaması & Alım Planı (B2B Satın Alma)
                    <span class="badge bg-primary text-white ms-1 rounded-pill" id="badgeTotalMaterials">...</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-3 text-dark border-bottom-0" id="tab-crews-btn" data-bs-toggle="tab" data-bs-target="#tab-crews-pane" type="button" role="tab">
                    <i class="fas fa-hard-hat text-warning me-2"></i> 2. Branş Kadro Planı & Puantaj (İşbaşı & Ekipler)
                    <span class="badge bg-warning text-dark ms-1 rounded-pill" id="badgeTotalCrews">...</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-3 text-success border-bottom-0" id="tab-timeline-btn" data-bs-toggle="tab" data-bs-target="#tab-timeline-pane" type="button" role="tab">
                    <i class="fas fa-calendar-check me-2"></i> 3. Otonom İş Akış Takvimi (Kat Kat Kovalama)
                    <span class="badge bg-success text-white ms-1 rounded-pill">Domino Tetikleme</span>
                </button>
            </li>
        </ul>

        <div class="card-body p-0">
            <div class="tab-content" id="workflowMasterTabContent">

                <!-- ============================================================= -->
                <!-- SEKME 1: MALZEME SIRALAMASI & ALIM PLANI -->
                <!-- ============================================================= -->
                <div class="tab-pane fade show active p-4" id="tab-materials-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="small text-muted">
                            <i class="fas fa-info-circle text-primary me-1"></i>
                            Malzemeler inşaat imalat sıralamasına göre 4 parçada dizilmiştir. Firma satın alma masası ne zaman ne alacağını buradan görür. Miktarları doğrudan düzenleyebilirsiniz.
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="toggleAllMaterials(true)">Tümünü Seç</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleAllMaterials(false)">Temizle</button>
                        </div>
                    </div>

                    <!-- 4 PARÇA MALZEME AKORDEON KONTEYNERİ -->
                    <div id="materialAccordionsContainer">
                        <div class="text-center p-5 text-muted">
                            <div class="spinner-border text-primary me-2"></div>
                            Malzeme alım planı yükleniyor...
                        </div>
                    </div>

                    <!-- MALZEME AKSİYON BARI -->
                    <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-light rounded-4 border">
                        <div>
                            <span class="badge bg-dark text-warning px-3 py-2 rounded-pill fw-bold fs-6">
                                <span id="selectedMaterialCount">0</span> Malzeme Kalemi Seçili
                            </span>
                        </div>
                        <div>
                            <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" id="btnSendMaterialsB2B" onclick="sendWorkflowTrack('Material')">
                                <i class="fas fa-shopping-cart me-2"></i> Seçilen Malzemeleri B2B Satın Alma İhalesine Gönder
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ============================================================= -->
                <!-- SEKME 2: BRANŞ KADRO PLANI & PUANTAJ -->
                <!-- ============================================================= -->
                <div class="tab-pane fade p-4" id="tab-crews-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="small text-muted">
                            <i class="fas fa-info-circle text-warning me-1"></i>
                            <strong>Şantiye Şefi Giriş Alanları:</strong> Süre (Gün) ve Kadro (Kişi) sayılarını doğrudan kutulardan değiştirebilirsiniz. Toplam Adam-Gün anlık olarak otomatik hesaplanır.
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="toggleAllLabor(true)">Tümünü Seç</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleAllLabor(false)">Temizle</button>
                        </div>
                    </div>

                    <!-- 4 PARÇA KADRO AKORDEON KONTEYNERİ -->
                    <div id="laborAccordionsContainer">
                        <div class="text-center p-5 text-muted">
                            <div class="spinner-border text-warning me-2"></div>
                            Kadro ve taşeron planı yükleniyor...
                        </div>
                    </div>

                    <!-- KADRO AKSİYON BARI -->
                    <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-light rounded-4 border">
                        <div>
                            <span class="badge bg-dark text-warning px-3 py-2 rounded-pill fw-bold fs-6">
                                <span id="selectedLaborCount">0</span> Ekip/Taşeron Kalemi Seçili
                            </span>
                        </div>
                        <div>
                            <button type="button" class="btn btn-warning text-dark rounded-pill px-4 py-2 fw-bold shadow-sm" id="btnSendLaborB2B" onclick="sendWorkflowTrack('Labor')">
                                <i class="fas fa-users-cog me-2"></i> Seçilen Branşlar İçin Taşeron / Kadro Çağrısı Aç
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ============================================================= -->
                <!-- SEKME 3: OTONOM İŞ AKIŞ TAKVİMİ & AJANDA -->
                <!-- ============================================================= -->
                <div class="tab-pane fade p-4" id="tab-timeline-pane" role="tabpanel">
                    <!-- ÖZET KARTLARI -->
                    <div class="card border-0 bg-success bg-opacity-10 border border-success rounded-4 p-3 mb-3">
                        <div class="row g-2 text-center">
                            <div class="col-6 col-sm-3">
                                <div class="bg-white p-2 rounded-3 border shadow-xs">
                                    <div class="text-muted small">Tahmini Toplam Süre</div>
                                    <div class="fw-bold text-dark fs-6" id="wfTotalDays">...</div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="bg-white p-2 rounded-3 border shadow-xs">
                                    <div class="text-muted small">İş Gücü Hacmi</div>
                                    <div class="fw-bold text-dark fs-6" id="wfTotalManDays">...</div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="bg-white p-2 rounded-3 border shadow-xs">
                                    <div class="text-muted small">Zirve Kadro</div>
                                    <div class="fw-bold text-dark fs-6" id="wfMaxCrew">...</div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="bg-white p-2 rounded-3 border shadow-xs">
                                    <div class="text-muted small">Tahmini Teslim Tarihi</div>
                                    <div class="fw-bold text-success fs-6" id="wfEstCompletion">...</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4 PARÇA TAKVİM AKORDEON KONTEYNERİ -->
                    <div id="timelineAccordionsContainer">
                        <div class="text-center p-5 text-muted">
                            <div class="spinner-border text-success me-2"></div>
                            Takvim çizelgesi yükleniyor...
                        </div>
                    </div>

                    <!-- AJANDAYA İŞLEME BUTONU -->
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-4 border mt-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Bu Planı Şantiye Ajandama & Kara Deftere İşle</h6>
                            <small class="text-muted">Seçili yapıya ait tüm aşamaları, kat kovalama günlerini ve T- hazırlık kontrollerini puantaja işler.</small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm" id="btnTriggerAgenda" onclick="triggerWorkflowToAgenda()">
                                <i class="fas fa-rocket me-2"></i> Kara Deftere & Ajandaya İşle (Puantajı Başlat)
                            </button>
                        </div>
                    </div>
                </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 🌲 TIER 3: ŞANTİYE BİTİŞİ & DIŞ ÇEVRE / SOSYAL DONATILAR (PROJE TESLİMİ) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-top border-4 border-success" id="tier3SiteHandoverMasterCard">
        <div class="card-header bg-success text-white p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
                    <i class="fas fa-tree text-warning fs-5"></i>
                    <span>Alt Alan: Şantiye Bitişi & Dış Çevre / Sosyal Donatılar (Proje Teslim Aşaması)</span>
                </h6>
                <small class="text-white-50">Tüm blokların kaba ve ince imalatları bitip ağır makineler sahadan çıkınca uygulanır (7 Madde).</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold small">
                    <i class="fas fa-flag-checkered me-1"></i> Proje Teslimi Ortak Alanları
                </span>
                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#collapseTier3Handover" aria-expanded="true">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
        </div>
        <div id="collapseTier3Handover" class="collapse show">
            <div class="card-body p-4 bg-light bg-opacity-25">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="small text-muted">
                        <i class="fas fa-info-circle text-success me-1"></i>
                        <strong>Kritik Kural:</strong> Kule vinç sökülmeden, şantiye konteynerleri sahadan kaldırılmadan ve dış cephe iskeleleri inmeden peyzaj ve ortak çevre kaplamalarına girilemez!
                    </div>
                    <span class="badge bg-white text-dark border rounded-pill px-3 py-2 small fw-bold" id="badgeTier3HandoverCount">
                        7 Ortak Donatı / Teslim Kalemi
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 bg-white rounded-3 shadow-xs">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th style="width: 55px;" class="text-center">Kod</th>
                                <th>Teslim & Dış Çevre İmalatı</th>
                                <th>Gereken Malzeme / Ekipman</th>
                                <th>Usta Ekibi / Kadro</th>
                                <th>Tedarikçi / İmalatçı</th>
                                <th class="text-center" style="width: 120px;">Ölçü / Miktar</th>
                                <th class="text-center" style="width: 120px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="tier3HandoverTableBody">
                            <tr>
                                <td colspan="7" class="text-center text-muted p-4">
                                    <div class="spinner-border spinner-border-sm text-success me-2"></div>
                                    Teslim ve çevre ortak donatı maddeleri yükleniyor...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: YENİ İMALAT / İŞ KALEMİ EKLEME (ŞANTİYE ŞEFİ) -->
<!-- ========================================================================= -->
<div class="modal fade" id="addStepModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white p-3 px-4">
                <h6 class="modal-title fw-bold">
                    <i class="fas fa-plus-circle me-1"></i> Yeni Şantiye İmalat Kalemi Ekle
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold">İnşaat Parçası (Faz):</label>
                    <select class="form-select form-select-sm" id="newStepPartIndex">
                        <option value="1">1. Parça: Kaba İnşaat (Temel & Taşıyıcı İskelet)</option>
                        <option value="2">2. Parça: Statik İnce (Kovalayan İşler - Duvar/Tesisat/Sıva)</option>
                        <option value="3">3. Parça: Tercihe Göre İnce İşler (Daire İçi İmalatlar)</option>
                        <option value="4">4. Parça: Demirbaş, Montaj & Dış Çevre (Teslim)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Aşama / İmalat Başlığı:</label>
                    <input type="text" class="form-control form-control-sm" id="newStepPhaseName" placeholder="Örn: Bodrum Kat Perde İzolasyonu ve Drenaj Hattı">
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">İş Branşı (Taşeron):</label>
                        <input type="text" class="form-control form-control-sm" id="newStepProfession" placeholder="Örn: İzolasyoncu">
                    </div>
                    <div class="col-3">
                        <label class="form-label small fw-bold">Kadro (Kişi):</label>
                        <input type="number" min="1" class="form-control form-control-sm text-center" id="newStepCrew" value="4">
                    </div>
                    <div class="col-3">
                        <label class="form-label small fw-bold">Süre (İş Günü):</label>
                        <input type="number" min="1" class="form-control form-control-sm text-center" id="newStepDuration" value="5">
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Sipariş Edilecek Malzeme:</label>
                        <input type="text" class="form-control form-control-sm" id="newStepMaterialTitle" placeholder="Örn: Çift Kat Bitümlü Membran & Drenaj Levhası">
                    </div>
                    <div class="col-3">
                        <label class="form-label small fw-bold">Miktar:</label>
                        <input type="number" min="0" step="any" class="form-control form-control-sm text-center" id="newStepQuantity" value="350">
                    </div>
                    <div class="col-3">
                        <label class="form-label small fw-bold">Birim:</label>
                        <input type="text" class="form-control form-control-sm text-center" id="newStepUnit" value="m²">
                    </div>
                </div>
                <div class="alert alert-info py-2 small mb-0">
                    <i class="fas fa-info-circle me-1"></i> Bu imalata otomatik olarak <strong>Ön Hazırlık, İmalat, Kalite & Kür ve İSG</strong> 4 alt adımı şablon olarak bağlanacaktır.
                </div>
            </div>
            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold" onclick="saveNewStep()">
                    <i class="fas fa-check me-1"></i> İmalatı Kaydet & Ekle
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: YENİ ALT ADIM / KONTROL MADDESİ EKLEME -->
<!-- ========================================================================= -->
<div class="modal fade" id="addSubStepModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white p-3 px-4">
                <h6 class="modal-title fw-bold">
                    <i class="fas fa-tasks me-1"></i> Yeni Saha Kontrol / Alt Adım Maddesi Ekle
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="subStepTargetCode" value="">
                <div class="mb-3">
                    <label class="form-label small fw-bold">4 Hayati Ayaktan Hangisi?</label>
                    <select class="form-select form-select-sm" id="subStepCategory">
                        <option value="PrePreparation">1. Ön Hazırlık (T- Günler, Santral Siparişi, İzinler)</option>
                        <option value="Execution">2. İmalat (Sahada Uygulama, Pompa, Vibratör)</option>
                        <option value="QualityAndCuring">3. Kalite Kontrol & Kürlenme (Slump, Küpler, 7G/28G Lab, Sulama)</option>
                        <option value="SafetyIsg">4. İSG Tedbirleri (KKD, Pompa Bom Mesafesi, Güvenlik Şeridi)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Kontrol Maddesi / Alt Adım Başlığı:</label>
                    <input type="text" class="form-control form-control-sm" id="subStepTitle" placeholder="Örn: 28 Günlük Basınç Laboratuvar Raporu Onayı">
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Test / Numune Değeri (Opsiyonel):</label>
                    <input type="text" class="form-control form-control-sm" id="subStepTestVal" placeholder="Örn: 18 cm Slump, 38.5 MPa Basınç, vb.">
                </div>
                <div class="mb-0">
                    <label class="form-label small fw-bold">Şantiye Notu (Opsiyonel):</label>
                    <input type="text" class="form-control form-control-sm" id="subStepNotes" placeholder="Örn: Yapı denetim onay tutanağı şantiye klasörüne eklendi">
                </div>
            </div>
            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-sm btn-dark rounded-pill px-4 fw-bold" onclick="saveNewSubStep()">
                    <i class="fas fa-check me-1"></i> Alt Adımı Ekle
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var currentProjectId = @projectId;
    var currentActiveProfileId = @(activeProfile?.Id ?? 0);
    var currentActiveBuildingId = @(activeStructure?.Id ?? 0);
    var currentActiveBuildingName = "@Html.Raw(activeStructure != null ? (activeStructure.BlockName ?? activeStructure.Name ?? "A Blok") : "A Blok")";
    var cachedWorkflowSteps = [];
    var cachedSiteSetupSteps = [];
    var cachedSiteHandoverSteps = [];
    var cachedStaticSummary = {};
    var currentWorkflowMode = "concrete"; // "concrete" or "empty"

    var partDefinitions = [
        {
            index: 1,
            name: "1. Kaba İnşaat (Temel & Taşıyıcı İskelet)",
            badgeClass: "bg-primary text-white",
            borderClass: "border-primary",
            bgHeader: "bg-primary bg-opacity-10",
            triggerRule: "İşbaşı ile başlar. Sırayla: Hafriyat -> Temel Yalıtımı -> Grobeton -> Radye Temel -> Karkas Katlar -> Çatı",
            icon: "fa-layer-group",
            collapsed: false
        },
        {
            index: 2,
            name: "2. Statik İnce (Kovalayan İşler)",
            badgeClass: "bg-info text-dark",
            borderClass: "border-info",
            bgHeader: "bg-info bg-opacity-10",
            triggerRule: "Kaba 2 kat önden gidince alttan başlar! (Örn: 2. kat tabliyesi dökülünce bodrum/zemin duvarları başlar)",
            icon: "fa-running",
            collapsed: false
        },
        {
            index: 3,
            name: "3. Daire İçi İnce İşler",
            badgeClass: "bg-warning text-dark",
            borderClass: "border-warning",
            bgHeader: "bg-warning bg-opacity-10",
            triggerRule: "Kat duvarları örülüp tesisat basınç ve sızdırmazlık testleri onaylandığında başlar!",
            icon: "fa-paint-roller",
            collapsed: true
        },
        {
            index: 4,
            name: "4. Demirbaş & Montaj (Teslim)",
            badgeClass: "bg-success text-white",
            borderClass: "border-success",
            bgHeader: "bg-success bg-opacity-10",
            triggerRule: "Daire içi boya ve parke bitince temiz montaj başlar (Kapılar, mutfak, vitrifiye, asansör)",
            icon: "fa-door-open",
            collapsed: true
        }
    ];

    document.addEventListener("DOMContentLoaded", function () {
        loadWorkflowData();
    });

    function selectFocusStructure(bId, bName, cardEl) {
        currentActiveBuildingId = bId;
        currentActiveBuildingName = bName;

        // Kart stillerini güncelle
        document.querySelectorAll(".structure-focus-card").forEach(el => {
            el.className = "p-3 rounded-4 border-2 transition-card h-100 cursor-pointer structure-focus-card border-light bg-light bg-opacity-50";
            var badge = el.querySelector(".badge");
            if (badge) {
                badge.className = "badge bg-secondary text-white rounded-pill px-2 py-1 small";
                badge.innerText = "Seç";
            }
        });

        if (cardEl) {
            cardEl.className = "p-3 rounded-4 border-2 transition-card h-100 cursor-pointer structure-focus-card border-primary bg-primary bg-opacity-10 shadow-sm";
            var badge = cardEl.querySelector(".badge");
            if (badge) {
                badge.className = "badge bg-primary text-white rounded-pill px-2 py-1 small";
                badge.innerText = "✓ Odaklanılan Yapı";
            }
        }

        // Başlık Rozetini Güncelle
        var titleBadge = document.getElementById("activeStructureTitleBadge");
        if (titleBadge) {
            titleBadge.innerHTML = `<i class="fas fa-building me-1"></i> Yapı: ${bName}`;
        }

        loadWorkflowData();
    }

    function onStartDateChange() {
        loadWorkflowData();
    }

    function loadWorkflowData() {
        var startDateVal = document.getElementById("workflowStartDateInput")?.value || "";
        var url = "/Metraj/GetParametricWorkflow?projectId=" + currentProjectId 
                + (currentActiveProfileId ? "&profileId=" + currentActiveProfileId : "") 
                + (currentActiveBuildingId ? "&buildingId=" + currentActiveBuildingId : "") 
                + "&startDate=" + startDateVal;

        var mCont = document.getElementById("materialAccordionsContainer");
        if(mCont) mCont.innerHTML = `<div class="text-center p-5 text-muted"><div class="spinner-border text-primary me-2"></div><strong>${currentActiveBuildingName}</strong> için çalışma masası hazırlanıyor...</div>`;
        var lCont = document.getElementById("laborAccordionsContainer");
        if(lCont) lCont.innerHTML = `<div class="text-center p-5 text-muted"><div class="spinner-border text-warning me-2"></div><strong>${currentActiveBuildingName}</strong> için kadro planı hazırlanıyor...</div>`;
        var tCont = document.getElementById("timelineAccordionsContainer");
        if(tCont) tCont.innerHTML = `<div class="text-center p-5 text-muted"><div class="spinner-border text-success me-2"></div><strong>${currentActiveBuildingName}</strong> için takvim hazırlanıyor...</div>`;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                if(data && data.success) {
                    cachedWorkflowSteps = data.steps || [];
                    cachedSiteSetupSteps = data.siteSetupSteps || [];
                    cachedSiteHandoverSteps = data.siteHandoverSteps || [];
                    cachedStaticSummary = data.staticSummary || {};
                    renderTier1SiteSetup(cachedSiteSetupSteps, cachedStaticSummary);
                    renderTier3SiteHandover(cachedSiteHandoverSteps);
                    renderAllWorkflowTables(cachedWorkflowSteps, data.summary);
                }
            })
            .catch(err => {
                console.error(err);
                if(mCont) mCont.innerHTML = `<div class="alert alert-danger m-3">Veri yüklenirken hata oluştu.</div>`;
            });
    }

    // =========================================================================
    // TIER 1: ŞANTİYE ORTAK SAHA KURULUMU (HAFRİYAT ÖNCESİ 8 MADDE & STATİK KART)
    // =========================================================================
    function renderTier1SiteSetup(steps, staticSummary) {
        if(staticSummary) {
            var cEl = document.getElementById("tier1ConcreteClass");
            if(cEl) cEl.innerText = staticSummary.concreteClass || "C30/37 Taşıyıcı Beton";
            var rEl = document.getElementById("tier1RebarClass");
            if(rEl) rEl.innerText = staticSummary.rebarClass || "B420C Nervürlü Demir";
            var fEl = document.getElementById("tier1FoundationType");
            if(fEl) fEl.innerText = staticSummary.foundationType || "Radye Genel Temel";
            var sEl = document.getElementById("tier1StructureType");
            if(sEl) sEl.innerText = staticSummary.structureType || "Betonarme Karkas";
            var cntEl = document.getElementById("tier1StructureCount");
            if(cntEl) cntEl.innerText = (staticSummary.totalStructures || 3) + " Bağımsız Yapı / Temel";
        }

        var tbody = document.getElementById("tier1SetupTableBody");
        if(!tbody) return;

        if(!steps || steps.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted p-4">Ortak saha hazırlık maddesi bulunamadı.</td></tr>`;
            return;
        }

        tbody.innerHTML = steps.map(s => `
            <tr>
                <td class="text-center">
                    <span class="badge bg-dark px-2 py-1">${s.stepCode}</span>
                </td>
                <td>
                    <div class="fw-bold text-dark">${s.phaseName}</div>
                    <div class="small text-muted">${s.stageCategory} &bull; <span class="text-danger fw-semibold"><i class="fas fa-shield-alt me-1"></i>${s.criticalDependency || s.triggerRule || ''}</span></div>
                </td>
                <td>
                    <div class="fw-semibold text-primary">${s.materialTitle}</div>
                    <div class="small text-muted">${s.materialDescription || ''}</div>
                </td>
                <td>
                    <span class="badge bg-light text-dark border px-2 py-1 small fw-semibold">
                        <i class="fas fa-store text-secondary me-1"></i>${s.supplierCategory || 'Tedarikçi'}
                    </span>
                    <div class="small text-muted mt-1"><i class="fas fa-hard-hat text-secondary me-1"></i>${s.professionName || ''}</div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 small fw-bold" 
                            onclick="quickQuoteStep('${s.stepCode}', '${(s.materialTitle || '').replace(/'/g, "\\'")}', '${(s.supplierCategory || '').replace(/'/g, "\\'")}')" 
                            title="B2B Tedarikçi Havuzundan Fiyat / Teklif İste">
                        <i class="fas fa-hand-holding-usd me-1"></i> Fiyat İste
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 small mt-1 d-block mx-auto" 
                            data-bs-toggle="collapse" data-bs-target="#substeps-tier1-${s.stepCode}">
                        <i class="fas fa-list-check me-1"></i> 4 Alt Adım
                    </button>
                </td>
            </tr>
            <tr id="substeps-tier1-${s.stepCode}" class="collapse">
                ${renderSubStepsDrawerHtml(s, 5)}
            </tr>
        `).join("");
    }

    // =========================================================================
    // TIER 3: ŞANTİYE BİTİŞİ & DIŞ ÇEVRE / SOSYAL DONATILAR (7 MADDE)
    // =========================================================================
    function renderTier3SiteHandover(steps) {
        var tbody = document.getElementById("tier3HandoverTableBody");
        if(!tbody) return;

        var countBadge = document.getElementById("badgeTier3HandoverCount");
        if(countBadge) countBadge.innerText = (steps ? steps.length : 0) + " Ortak Donatı / Teslim Kalemi";

        if(!steps || steps.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted p-4">Ortak peyzaj / sosyal donatı maddesi bulunamadı.</td></tr>`;
            return;
        }

        tbody.innerHTML = steps.map(s => `
            <tr>
                <td class="text-center">
                    <span class="badge bg-success px-2 py-1">${s.stepCode}</span>
                </td>
                <td>
                    <div class="fw-bold text-dark">${s.phaseName}</div>
                    <div class="small text-muted">${s.stageCategory} &bull; <span class="text-success fw-semibold"><i class="fas fa-bolt me-1"></i>${s.triggerRule || ''}</span></div>
                </td>
                <td>
                    <div class="fw-semibold text-primary">${s.materialTitle}</div>
                    <div class="small text-muted">${s.materialDescription || ''}</div>
                </td>
                <td>
                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning px-2 py-1 small fw-semibold">
                        <i class="fas fa-hard-hat me-1"></i>${s.professionName || 'Usta Ekibi'}
                    </span>
                    <div class="small text-muted mt-1">${s.crewComposition || ''} (${s.durationDays || 0} Gün)</div>
                </td>
                <td>
                    <span class="badge bg-light text-dark border px-2 py-1 small fw-semibold">
                        <i class="fas fa-store text-secondary me-1"></i>${s.supplierCategory || 'Tedarikçi'}
                    </span>
                </td>
                <td class="text-center">
                    ${s.materialQuantity && s.materialQuantity > 0 ? `
                        <span class="badge bg-white text-dark border fw-bold px-2 py-1">
                            ${s.materialQuantity} ${s.materialUnit || ''}
                        </span>
                    ` : `
                        <span class="badge bg-light text-muted border px-2 py-1 small" title="Peyzaj ve vaziyet planından okunacak">
                            <i class="fas fa-ruler-combined me-1 text-secondary"></i>DXF Bekliyor
                        </span>
                    `}
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 small fw-bold" 
