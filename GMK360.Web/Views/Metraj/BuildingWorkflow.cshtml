@model dynamic
@{
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var project = ViewBag.Project as GMK360.Core.Entities.Construction.ConstructionProject;
    int projectId = project?.Id ?? 0;
    ViewData["ProjectId"] = projectId;
    var structures = ViewBag.Structures as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var activeStructure = ViewBag.ActiveStructure as GMK360.Core.Entities.Building ?? structures.FirstOrDefault();
    var savedProfiles = ViewBag.SavedProfiles as List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile> ?? new List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile>();
    var activeProfile = ViewBag.ActiveProfile as GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile ?? savedProfiles.FirstOrDefault();
    var step0 = ViewBag.Step0 as GMK360.Core.Entities.Construction.Workflows.DnaTemplateStep;
    ViewData["Title"] = $"{project?.Name ?? "Şantiye"} - Yapı Bazlı İş Akışı & Tedarik Masası";
}

<div class="container-fluid py-4">
    <!-- ÜST NAVİGASYON VE BAŞLIK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/Metraj/ProjectDNA/@projectId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-xs">
                    <i class="fas fa-arrow-left me-1"></i> Kanat 2: DNA Profillerine Dön
                </a>
                <span class="badge bg-success text-white px-3 py-1 rounded-pill fw-bold">
                    <i class="fas fa-check-circle me-1"></i> Onaylı Reçete: @(activeProfile?.Name ?? "Varsayılan DNA Reçetesi")
                </span>
            </div>
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="fas fa-network-wired text-primary"></i>
                <span>Şantiye İş Akışı, Malzeme Tedarik & Kadro Masası</span>
            </h3>
            <p class="text-muted small mt-1 mb-0">Müteahhit ve satın alma kontrol paneli. Başlayacağınız yapıyı seçin; malzeme alım sıralamasını ve ekip işbaşı takvimini izole olarak yönetin.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="dropdown">
                <button class="btn btn-light border dropdown-toggle rounded-pill px-3 fw-bold shadow-xs text-dark" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-dna text-primary me-1"></i> Reçete Değiştir
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    @foreach (var prof in savedProfiles.Where(p => p.Status == "Tamamlandı"))
                    {
                        <li>
                            <a class="dropdown-item @(activeProfile != null && activeProfile.Id == prof.Id ? "active fw-bold" : "")" 
                               href="/Metraj/BuildingWorkflow/@projectId?profileId=@prof.Id&buildingId=@(activeStructure?.Id ?? 0)">
                                <i class="fas fa-check-circle me-2 text-success"></i> @prof.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <a href="/Metraj/SiteAgenda/@projectId?profileId=@(activeProfile?.Id ?? 0)&buildingId=@(activeStructure?.Id ?? 0)" target="_blank" rel="noopener noreferrer" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-external-link-alt me-1"></i> Kara Defter & Ajanda &rarr;
            </a>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🏛️ KATMAN 1 (EN ÜST): ADIM 0 MECBURİ STATİK VE TAŞIYICILAR (20 KALEM TABLO) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-3 bg-white overflow-hidden border-top border-4 border-danger" id="step0StaticMasterCard">
        <div class="card-header bg-white p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 cursor-pointer"
             data-bs-toggle="collapse" data-bs-target="#collapseStep0Static" aria-expanded="false" style="cursor: pointer;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-2 text-danger">
                    <i class="fas fa-lock fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span>Adım 0: Mecburi Statik ve Taşıyıcılar (Sabit Alan)</span>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-2 py-1 small">
                            <i class="fas fa-ban me-1"></i> Değiştirilemez / DXF Sabiti (20 Kalem)
                        </span>
                    </h6>
                    <small class="text-muted">Toptan satın alma & demirci, betoncu, kalıpçı, iskeleci, şapçı ihaleleri için projenin ana taşıyıcı omurgası.</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small fw-semibold">
                    <i class="fas fa-layer-group text-danger me-1"></i> Beton, Donatı (Q8-Q26), Kalıp, 4 Cephe İskele, Şap & Paspayı
                </span>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                    <i class="fas fa-chevron-down me-1"></i> İncele / Aç
                </button>
            </div>
        </div>
        <div id="collapseStep0Static" class="collapse">
            <div class="card-body p-4 pt-2 border-top bg-light bg-opacity-25">
                <!-- BİLGİLENDİRME KUTUSU -->
                <div class="alert alert-danger bg-opacity-10 border-0 text-danger d-flex align-items-center mb-3 rounded-3 p-3">
                    <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                    <div class="small">
                        <strong>Şantiye Pazar Yeri & İhale Entegrasyonu:</strong> Bu 20 kalem için kullanıcıdan seçim istenmez; ölçüler doğrudan DXF mimari/statik katmanlarından ve akslarından hesaplanır. Her bir kalemin karşısındaki <strong>İş Branşı</strong>, projenin taşeron ve usta pazarında hangi meslek gruplarıyla ihaleye çıkacağını belirler. Tedarikçi firmalardan projenin tamamı için sabit fiyat anlaşması almak için kullanılır.
                    </div>
                </div>

                @{
                    var rawStep0List = new List<(int Order, string Title, string Notes, string Source, string Profession, string Unit)>();
                    if (step0 != null && step0.Questions != null && step0.Questions.Any())
                    {
                        foreach (var q in step0.Questions.OrderBy(x => x.QuestionOrder))
                        {
                            rawStep0List.Add((
                                q.QuestionOrder,
                                q.Title ?? "Statik Kalem",
                                string.IsNullOrWhiteSpace(q.Notes) ? "Statik projeden aks ve kesit bazında otomatik hesaplanır." : q.Notes,
                                "DXF / Statik",
                                q.Profession != null ? q.Profession.Name : "Satın Alma",
                                "DXF"
                            ));
                        }
                    }
                    else
                    {
                        rawStep0List.Add((1, "Radye Temel ve Kat Betonu (DXF)", "Tüm yapı ölçüsü alınacak toplam miktarı", "DXF / Statik", "Betoncu", "m³"));
                        rawStep0List.Add((2, "Nervürlü Taşıyıcı Donatı Çeliği (DXF)", "Tüm yapı ölçüsü alınacak toplam miktarı", "DXF / Statik", "Demirci", "Ton"));
                        rawStep0List.Add((3, "Q8 - Q12 (İnce Demir / Etriye / Döşeme)", "DXF'ten Ton olarak okunur.", "DXF / Statik", "Demirci", "Ton"));
                        rawStep0List.Add((4, "Q14 - Q16 (Orta Demir / Kiriş / Donatı)", "DXF'ten Ton olarak okunur.", "DXF / Statik", "Demirci", "Ton"));
                        rawStep0List.Add((5, "Q18 - Q26 (Kalın Demir / Kolon / Temel)", "DXF'ten Ton olarak okunur.", "DXF / Statik", "Demirci", "Ton"));
                        rawStep0List.Add((6, "Kalıp Toplam Yüzeyi (DXF)", "DXF'ten okunur.", "DXF / Statik", "Kalıpçı", "m²"));
                        rawStep0List.Add((7, "Standart Kat Metrekaresi (DXF)", "DXF'ten gelir", "DXF / Statik", "Kalıpçı", "m²"));
                        rawStep0List.Add((8, "Toplam Kat Sayısı (Künye)", "Proje künyesinden gelir.", "DXF / Statik", "Kalıpçı", "Kat"));
                        rawStep0List.Add((9, "Standart Bir Katın Yüksekliği (DXF)", "DXF'ten gelir.", "DXF / Statik", "Kalıpçı", "Metre"));
                        rawStep0List.Add((10, "Standart Bir Kattaki Kolon Sayısı (DXF)", "DXF'ten gelir", "DXF / Statik", "Kalıpçı", "Adet"));
                        rawStep0List.Add((11, "Standart Bir Kattaki Kiriş Sayısı (DXF)", "DXF'ten gelir", "DXF / Statik", "Kalıpçı", "Adet"));
                        rawStep0List.Add((12, "Asansör ve Perde Betonu Alanı (DXF)", "Tek katın metre karesi. DXF'ten okunur.", "DXF / Statik", "Kalıpçı", "m²"));
                        rawStep0List.Add((13, "Kuzey Cephe İskele Yüzey Alanı (DXF)", "DXF'ten okunur", "DXF / Statik", "İskeleci", "m²"));
                        rawStep0List.Add((14, "Güney Cephe İskele Yüzey Alanı (DXF)", "DXF'ten okunur", "DXF / Statik", "İskeleci", "m²"));
                        rawStep0List.Add((15, "Doğu Cephe İskele Yüzey Alanı (DXF)", "DXF'ten okunur", "DXF / Statik", "İskeleci", "m²"));
                        rawStep0List.Add((16, "Batı Cephe İskele Yüzey Alanı (DXF)", "DXF'ten okunur", "DXF / Statik", "İskeleci", "m²"));
                        rawStep0List.Add((17, "Kuru Hacim - Klasik Şap (DXF)", "Sistem Mahal Listesini okuyacak, oda ve salonların toplam metrekaresini çıkarıp buraya yazacak.", "DXF / Statik", "Şapçı", "m²"));
                        rawStep0List.Add((18, "Islak Hacim - Eğimli Şap (DXF)", "Sistem banyo, balkon ve terasları toplayacak.", "DXF / Statik", "Şapçı", "m²"));
                        rawStep0List.Add((19, "Endüstriyel - Helikopterli Şap (DXF)", "Sistem otopark ve sığınak metrajını alacak.", "DXF / Statik", "Şapçı", "m²"));
                        rawStep0List.Add((20, "Paspayları (DXF)", "Tüm katların toplam kalıp yüzey alanı (m²) * 20 adet olarak hesaplanacak. (Çuvalla/kiloyla alınsa da net adet çıkarılacak)", "DXF / Statik", "Satın Alma", "Adet"));
                    }

                    var tradeGroups = rawStep0List.GroupBy(x => x.Profession).ToList();
                }

                <!-- HIZLI BRANŞ İHALE PAKETLERİ (TOOLBAR) -->
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2 bg-white p-3 rounded-3 border shadow-xs">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="small fw-bold text-dark d-flex align-items-center gap-1">
                            <i class="fas fa-boxes-packing text-primary"></i>
                            <span>İş Branşı İhale Paketleri:</span>
                        </span>
                        @foreach (var grp in tradeGroups)
                        {
                            string tName = grp.Key;
                            int tCount = grp.Count();
                            string btnColor = "btn-outline-secondary";
                            if (tName.Contains("Beton")) { btnColor = "btn-outline-danger"; }
                            else if (tName.Contains("Demir")) { btnColor = "btn-outline-dark"; }
                            else if (tName.Contains("Kalıp")) { btnColor = "btn-outline-warning text-dark"; }
                            else if (tName.Contains("İskele")) { btnColor = "btn-outline-info text-dark"; }
                            else if (tName.Contains("Şap")) { btnColor = "btn-outline-secondary"; }

                            <button type="button" class="btn btn-sm @btnColor rounded-pill px-3 py-1 fw-bold shadow-2xs"
                                    onclick="requestTradePackageQuote('@tName', @tCount, '@string.Join(", ", grp.Select(x => x.Title.Replace("'", "")))')">
                                @tName <span class="badge bg-dark bg-opacity-75 text-white rounded-pill ms-1">@tCount Kalem</span>
                            </button>
                        }
                    </div>
                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                        <i class="fas fa-shield-alt text-success me-1"></i> Toptan Sözleşme Koruması
                    </span>
                </div>

                <!-- İŞ BRANŞLARINA GÖRE GRUPLANMIŞ MECLİS TABLOSU -->
                <div class="table-responsive rounded-3 border bg-white shadow-xs">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-muted small">
                                <th style="width: 50px;" class="text-center">#</th>
                                <th style="min-width: 250px;">Statik İmalat / Ölçüm Kalemi</th>
                                <th style="min-width: 300px;">Mühendislik Açıklaması & Kuralı</th>
                                <th style="min-width: 140px;">Veri Kaynağı</th>
                                <th style="min-width: 160px;">İlgili İş Branşı</th>
                                <th style="min-width: 130px;" class="text-center">Ölçü / Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grp in tradeGroups)
                            {
                                string tradeName = grp.Key;
                                int tradeCount = grp.Count();
                                string badgeColor = "bg-primary";
                                string iconClass = "fa-hard-hat";

                                if (tradeName.Contains("Beton")) { badgeColor = "bg-danger"; iconClass = "fa-truck-moving"; }
                                else if (tradeName.Contains("Demir")) { badgeColor = "bg-dark"; iconClass = "fa-weight-hanging"; }
                                else if (tradeName.Contains("Kalıp")) { badgeColor = "bg-warning text-dark"; iconClass = "fa-hammer"; }
                                else if (tradeName.Contains("İskele")) { badgeColor = "bg-info text-dark"; iconClass = "fa-layer-group"; }
                                else if (tradeName.Contains("Şap")) { badgeColor = "bg-secondary"; iconClass = "fa-brush"; }
                                else if (tradeName.Contains("Pimapen") || tradeName.Contains("Doğrama")) { badgeColor = "bg-primary"; iconClass = "fa-window-maximize"; }
                                else if (tradeName.Contains("Kapı")) { badgeColor = "bg-success"; iconClass = "fa-door-closed"; }
                                else if (tradeName.Contains("Mobilya")) { badgeColor = "bg-warning text-dark"; iconClass = "fa-couch"; }

                                <!-- BRANŞ GRUP BAŞLIĞI & TEK İHALE BUTONU -->
                                <tr class="table-light border-top border-bottom border-2">
                                    <td colspan="6" class="p-3 bg-light">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @badgeColor px-3 py-2 rounded-pill fw-bold fs-6 shadow-xs">
                                                    <i class="fas @iconClass me-1"></i> @tradeName İhale Masası
                                                </span>
                                                <span class="text-muted small fw-semibold">(@tradeCount Kalem Teknik Metraj & Şartname)</span>
                                            </div>
                                            <div>
                                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-xs"
                                                        onclick="requestTradePackageQuote('@tradeName', @tradeCount, '@string.Join(", ", grp.Select(x => x.Title.Replace("'", "")))')">
                                                    <i class="fas fa-hand-holding-usd me-1"></i> @tradeName Paketinden Toplu Teklif İste
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <!-- BRANŞIN ALTINDAKİ TEKNİK KALEMLER -->
                                @foreach (var item in grp)
                                {
                                    <tr>
                                        <td class="text-center fw-bold text-muted small">@item.Order</td>
                                        <td>
                                            <div class="fw-bold text-dark">
                                                <i class="fas fa-cube text-danger me-2 opacity-75"></i>@item.Title
                                            </div>
                                        </td>
                                        <td>
                                            <span class="small text-muted">@item.Notes</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-pill small">
                                                <i class="fas fa-drafting-compass me-1"></i> @item.Source
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @badgeColor bg-opacity-10 text-dark border px-2 py-1 rounded-pill fw-semibold small">
                                                <i class="fas @iconClass me-1"></i> @tradeName
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                                                <i class="fas fa-calculator me-1"></i> DXF Bekliyor
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🌐 KATMAN 2: ŞANTİYE ORTAK SAHASI (HAFRİYAT ÖNCESİ 8 KURULUM) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-top border-4 border-warning" id="tier1SiteSetupMasterCard">
        <div class="card-header bg-white p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 cursor-pointer"
             data-bs-toggle="collapse" data-bs-target="#collapseTier1Setup" aria-expanded="false" style="cursor: pointer;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-2 text-warning">
                    <i class="fas fa-campground fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <span>Hafriyat Öncesi 8 Ortak Saha Hazırlığı (Şantiye Kurulumu)</span>
                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning rounded-pill px-2 py-1 small">
                            <i class="fas fa-check-double me-1"></i> Parsel Geneli (8 Madde)
                        </span>
                    </h6>
                    <small class="text-muted">Tüm parsel için hafriyat başlamadan önce 1 defa kurulur; blokların (A Blok, Bitişik Bloklar vb.) altına asla tekrar girmez!</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small fw-semibold">
                    <i class="fas fa-tools text-warning me-1"></i> Harita, Çit, Yıkım, Elektrik, Su, WC, Kamp & Aydınlatma
                </span>
                <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-bold">
                    <i class="fas fa-chevron-down me-1"></i> İncele / Aç
                </button>
            </div>
        </div>
        <div id="collapseTier1Setup" class="collapse">
            <div class="card-body p-4 pt-2 border-top bg-light bg-opacity-25">
                <div class="table-responsive rounded-3 border bg-white shadow-xs">
                    <table class="table table-hover align-middle mb-0" id="tier1SetupTable">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th style="width: 55px;" class="text-center">Kod</th>
                                <th style="min-width: 220px;">Ortak İmalat / Hazırlık Kalemi</th>
                                <th style="min-width: 280px;">Tedarik Edilecek Malzeme / Hizmet</th>
                                <th style="min-width: 200px;">Nereden Alınır? (Esnaf / Tedarikçi)</th>
                                <th class="text-center" style="width: 160px;">Saha Operasyonu</th>
                            </tr>
                        </thead>
                        <tbody id="tier1SetupTableBody">
                            <tr>
                                <td colspan="5" class="text-center text-muted p-4">
                                    <div class="spinner-border spinner-border-sm text-dark me-2"></div>
                                    Ortak saha hazırlık maddeleri yükleniyor...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🏗️ 1. ADIM: HANGİ YAPIDAN BAŞLIYORUZ? (ODAKLANMA KARTLARI) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-light border-bottom p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="fas fa-cubes text-primary fs-5"></i>
                    <span>1. Adım: Hangi Yapıdan Başlıyoruz? (Yapı & Temel İzolasyonu)</span>
                </h6>
                <small class="text-muted">Projenizdeki bağımsız temeller aşağıda listelenmiştir. Nereden başlayacaksanız o yapıya tıklayarak odaklanın.</small>
            </div>
            <span class="badge bg-danger text-white rounded-pill px-3 py-2 fw-semibold small">
                <i class="fas fa-shield-alt me-1"></i> Şantiye Altın Kuralı: Yapılar Birbirine Karışamaz
            </span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3" id="structureCardsContainer">
                @if (structures != null && structures.Any())
                {
                    foreach (var s in structures)
                    {
                        bool isCurrent = (activeStructure != null && activeStructure.Id == s.Id);
                        var childBlocks = s.ChildBuildings != null && s.ChildBuildings.Any() ? s.ChildBuildings.ToList() : new List<GMK360.Core.Entities.Building>();
                        string sName = s.BlockName ?? s.Name;
                        string childNames = childBlocks.Any() ? $" ({string.Join(" & ", childBlocks.Select(c => c.BlockName ?? c.Name))})" : "";
                        int totalFloors = (s.TotalFloors ?? 0) + s.BasementFloors;
                        double bArea = s.BaseArea ?? 0;
                        int unitCount = (s.Units?.Count ?? 0) + childBlocks.Sum(c => c.Units?.Count ?? 0);

                        <div class="col-lg-4 col-md-6">
                            <div class="p-3 rounded-4 border-2 transition-card h-100 cursor-pointer structure-focus-card @(isCurrent ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "border-light bg-light bg-opacity-50")"
                                 onclick="selectFocusStructure(@s.Id, '@(sName + childNames)', this)"
                                 data-building-id="@s.Id"
                                 style="cursor: pointer; border-style: solid;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded-3 @(isCurrent ? "bg-primary text-white" : "bg-white text-secondary shadow-xs")">
                                            <i class="fas fa-building fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@sName@childNames</h6>
                                            <small class="text-muted">@(childBlocks.Any() ? "Bitişik / Bloklu Yapı" : "Tekil Taşıyıcı Kule")</small>
                                        </div>
                                    </div>
                                    <span class="badge @(isCurrent ? "bg-primary text-white" : "bg-secondary text-white") rounded-pill px-2 py-1 small">
                                        @(isCurrent ? "✓ Odaklanılan Yapı" : "Seç")
                                    </span>
                                </div>
                                <div class="row g-2 text-center mt-2 small">
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-3 border shadow-xs">
                                            <div class="text-muted small">Taban (TAKS)</div>
                                            <div class="fw-bold text-dark">@(bArea > 0 ? bArea.ToString("N0") + " m²" : "Belirtilmedi")</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-3 border shadow-xs">
                                            <div class="text-muted small">Kat Sayısı</div>
