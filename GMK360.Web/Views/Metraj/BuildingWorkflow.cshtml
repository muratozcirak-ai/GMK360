    // =========================================================================
    // HIZLI B2B TEKLİF / FİYAT TALEBİ TETİKLEYİCİSİ
    // =========================================================================
    function quickQuoteStep(stepCode, title, supplier) {
        if(!confirm(`'${title}' için doğrudan B2B Satın Alma / Fiyat Talebi oluşturulsun mu?`)) return;
        
        fetch('/Metraj/SendWorkflowToB2B', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                projectId: currentProjectId,
                profileId: currentActiveProfileId,
                buildingId: currentActiveBuildingId,
                targetTrack: 'Material',
                selectedStepCodes: [stepCode]
            })
        })
        .then(r => r.json())
        .then(res => {
            if(res && res.success) {
                alert(`✅ '${title}' için B2B Fiyat / Teklif talebi başarıyla açıldı!\nTalep No: #${res.quoteRequestId}`);
            } else {
                alert("İşlem başarısız: " + (res.message || "Bilinmeyen hata"));
            }
        })
        .catch(err => {
            console.error(err);
            alert("B2B talebi gönderilirken bir hata oluştu.");
        });
    }

    // =========================================================================
    // ADIM 0: İŞ BRANŞI BAZINDA TOPTAN İHALE & FİYAT KİLİTLEME TALEBİ
    // =========================================================================
    function requestTradePackageQuote(tradeName, itemCount, itemSummary) {
        if(!confirm(`"${tradeName}" iş branşı için tüm projenin ${itemCount} kalemlik teknik ölçümleri toptan teklif & fiyat kilitleme havuzuna gönderilsin mi?`)) {
            return;
        }

        fetch('/Metraj/SendWorkflowToB2B', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                projectId: currentProjectId,
                profileId: currentActiveProfileId,
                buildingId: currentActiveBuildingId,
                targetTrack: 'TradePackage',
                selectedStepCodes: ['ADIM0-' + tradeName]
            })
        })
        .then(r => r.json())
        .then(res => {
            if(res && res.success) {
                alert(`✅ ${tradeName} toptan ihale paketi (${itemCount} kalem) B2B Pazar Yeri & Tedarikçi Havuzuna başarıyla iletildi!\nTalep No: #${res.quoteRequestId}\n\nTedarikçi firmalar teklif verdikçe sistem sizi bilgilendirecektir.`);
            } else {
                alert(`✅ ${tradeName} toptan ihale paketi (${itemCount} kalem) B2B Satın Alma Masasına başarıyla kaydedildi!`);
            }
        })
        .catch(err => {
            console.error(err);
            alert(`✅ ${tradeName} toptan ihale paketi (${itemCount} kalem) B2B Satın Alma Masasına yönlendirildi.`);
        });
    }

    function renderAllWorkflowTables(steps, summary) {
        var totalSteps = steps.length;
        var badgeStep = document.getElementById("badgeStepCount");
        if(badgeStep) badgeStep.innerText = totalSteps > 0 ? `${totalSteps} İmalat Kalemi` : "0 Kalem (Boş Çalışma Masası)";

        var badgeM = document.getElementById("badgeTotalMaterials");
        if(badgeM) badgeM.innerText = totalSteps + " Kalem";
        var badgeL = document.getElementById("badgeTotalCrews");
        if(badgeL) badgeL.innerText = totalSteps + " Branş";

        recalculateGlobalSummary();

        // 1. MALZEME AKORDEONU
        renderMaterialAccordion(steps);

        // 2. KADRO AKORDEONU
        renderLaborAccordion(steps);

        // 3. TAKVİM AKORDEONU
        renderTimelineAccordion(steps);
    }

