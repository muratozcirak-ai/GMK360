                <div class="row g-2 mb-3">
                    <div class="col-lg-3 col-md-6">
                        <div class="p-3 rounded-4 border bg-white h-100 border-start border-4 border-primary shadow-2xs">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">1. EVRE: ÖNCESİ (T - X Gün)</span>
                                <span class="small fw-bold text-primary">Geriye Doğru Ajanda</span>
