                        </div>
                        <!-- 3. KALİTE KONTROL & KÜRLENME -->
                        <div class="col-lg-3 col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-light bg-opacity-25">
                                <div class="fw-bold text-success mb-2 small d-flex align-items-center gap-1 border-bottom pb-2">
                                    <i class="fas fa-vial text-success fs-6"></i> 3. Kalite Kontrol & Kürlenme
                                </div>
                                <div class="substeps-category-list">
                                    ${renderSubStepsCategory(s.stepCode, subSteps, 'QualityAndCuring')}
                                </div>
