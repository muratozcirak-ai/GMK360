    function confirmSubProjectCreation() {
        var parentId = document.getElementById("modalChoiceParentId").value;
        var amenityId = document.getElementById("modalChoiceAmenityId").value;
        var amenityName = document.getElementById("modalChoiceAmenityName").value;
        var modeRadio = document.querySelector('input[name="wizardSubExecutionMode"]:checked');
