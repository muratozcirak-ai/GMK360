                                                            @foreach (var opt in qOptions)
                                                            {
                                                                var prof = opt.Profession != null ? opt.Profession.Name : (q.Profession != null ? q.Profession.Name : "Belirtilmedi");
                                                                bool isSelected = existingProfile != null && existingProfile.Details != null && existingProfile.Details.Any(d => d.SelectedItem == opt.OptionText);
                                                                if (isSelected) { activeProf = prof; }
                                                                if (isSelected)
                                                                {
                                                                    <option value="@opt.Id" data-prof="@prof" selected>@opt.OptionText</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@opt.Id" data-prof="@prof">@opt.OptionText</option>
                                                                }
                                                            }
                                                            <option value="custom_other" class="fw-bold text-primary" selected="@(isCustomSelected ? "selected" : null)">✍️ Listede Olmayan Özel Malzeme / Kalem Belirt...</option>
                                                        </select>
                                                        <div id="custom_box_@q.Id" class="mt-2 @(isCustomSelected ? "" : "d-none")">
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-primary bg-opacity-10 text-primary fw-bold small"><i class="fas fa-pen me-1"></i> Özel Malzeme / Not:</span>
                                                                <input type="text" class="form-control border-primary dynamic-custom-single" id="custom_input_@q.Id" value="@existingCustomVal" placeholder="Aradığınız özel malzeme, marka veya imalatı yazınız..." oninput="triggerAutoSave()">
                                                            </div>
                                                        </div>
                                                        <div class="mt-2" id="badge_single_@q.Id">
                                                            @if (!string.IsNullOrEmpty(activeProf))
                                                            {
                                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-bold mt-2">
                                                                    <i class="fas fa-hard-hat me-1"></i> İlgili İş Branşı: <strong>@activeProf</strong>
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center py-5 text-muted">
                                            <i class="fas fa-clipboard-list fa-3x mb-3 text-secondary opacity-50"></i>
                                            <p>Bu adıma ait henüz soru bulunamadı.</p>
                                        </div>
                                    }

                                    @if (s.StepOrder == 9)
                                    {
                                        var amenities = project?.Amenities?.Where(a => !a.IsDeleted)?.ToList() ?? new List<GMK360.Core.Entities.Construction.ProjectAmenity>();
                                        <div class="card border border-2 border-primary border-opacity-25 rounded-4 shadow-sm mt-4 bg-light bg-opacity-50">
                                            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">
                                                        <i class="fas fa-tree text-success me-2"></i>Bina Özeti Dış Saha & Sosyal Donatı Alanları
                                                    </h6>
                                                    <small class="text-muted">Projenin Alan Yönetimi'nde tanımlanan açık/kapalı sosyal alanları ve imalat kararları</small>
                                                </div>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-1 fw-bold">
                                                    <i class="fas fa-map-marker-alt me-1"></i> @amenities.Count Kayıtlı Alan
                                                </span>
                                            </div>
                                            <div class="card-body p-3">
                                                @if (amenities.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-hover align-middle mb-0 bg-white rounded-3 shadow-xs">
                                                            <thead class="table-light">
                                                                <tr class="small text-muted text-uppercase">
                                                                    <th style="width: 30%;">Alan Tanımı</th>
                                                                    <th style="width: 15%;">Büyüklük</th>
                                                                    <th style="width: 40%;">Uygulama / Keşif Yöntemi</th>
                                                                    <th style="width: 15%;" class="text-end">İşlem</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var am in amenities)
                                                                {
                                                                    string amIcon = (am.Name ?? "").ToLower() switch
                                                                    {
                                                                        var n when n.Contains("park") || n.Contains("çocuk") => "fas fa-child text-warning",
                                                                        var n when n.Contains("yeşil") || n.Contains("çim") || n.Contains("peyzaj") => "fas fa-leaf text-success",
                                                                        var n when n.Contains("kamelya") || n.Contains("çardak") => "fas fa-umbrella-beach text-info",
                                                                        var n when n.Contains("otopark") => "fas fa-car text-primary",
                                                                        var n when n.Contains("havuz") => "fas fa-swimming-pool text-info",
                                                                        _ => "fas fa-vector-square text-secondary"
                                                                    };
                                                                    var matchedDetail = existingProfile?.Details?.FirstOrDefault(d => d.SelectedItem.StartsWith(am.Name + " (") || d.SelectedItem.StartsWith(am.Name + ":"));
                                                                    string currentChoice = "";
                                                                    if (matchedDetail != null)
                                                                    {
                                                                        var parts = matchedDetail.SelectedItem.Split(':');
                                                                        if (parts.Length > 1) currentChoice = parts[1].Trim();
                                                                    }
                                                                    <tr>
                                                                        <td>
                                                                            <div class="d-flex align-items-center">
                                                                                <div class="rounded-3 bg-light p-2 me-2 border d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                                                                    <i class="@amIcon fs-5"></i>
                                                                                </div>
                                                                                <div>
                                                                                    <div class="fw-bold text-dark">@am.Name</div>
                                                                                    <small class="text-muted">@(string.IsNullOrEmpty(am.Description) ? am.Type ?? "Sosyal Donatı" : am.Description)</small>
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                        <td>
                                                                            <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1 fw-bold fs-6">
                                                                                @(am.SquareMeters.HasValue ? $"{am.SquareMeters.Value:N0} m²" : "Belirtilmedi")
                                                                            </span>
                                                                        </td>
                                                                        <td>
                                                                            <select class="form-select form-select-sm border-1 dynamic-single amenity-select" 
                                                                                    id="amenity_@am.Id" 
                                                                                    data-phase="Adım 9: Dış Saha ve Sosyal Donatılar" 
                                                                                    data-amenity-id="@am.Id" 
                                                                                    data-amenity-name="@am.Name"
                                                                                    data-amenity-m2="@(am.SquareMeters.HasValue ? $"{am.SquareMeters.Value:N0} m²" : "")"
                                                                                    onchange="triggerAutoSave()">
                                                                                <!option value="Firma İçi Proje / Etüt Aç" @(currentChoice.Contains("Proje") || string.IsNullOrEmpty(currentChoice) ? "selected" : "")>📐 Firma İçi Proje / Etüt Aç (Özel Keşif)</!option>
                                                                                <!option value="Anahtar Teslim Taşerona İhale Et" @(currentChoice.Contains("Taşeron") ? "selected" : "")>🤝 Anahtar Teslim Taşerona İhale Et</!option>
                                                                                <!option value="Müteahhit Yapmayacak (Site Yönetimine Ait)" @(currentChoice.Contains("Müteahhit Yapmayacak") ? "selected" : "")>❌ Müteahhit Yapmayacak (Site Yönetimine Bırakılacak)</!option>
                                                                            </select>
                                                                        </td>
                                                                        <td class="text-end">
                                                                            <div class="d-flex justify-content-end gap-1">
                                                                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="createSubProject(@projectId, @am.Id, '@am.Name')" title="Bu alana ait alt imalat projesi aç">
                                                                                    <i class="fas fa-folder-plus me-1"></i> Alt Proje Aç
                                                                                </button>
                                                                                <a href="/Construction/ProjectSummary/@projectId#nav-amenities" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Alanı İncele">
                                                                                    <i class="fas fa-external-link-alt"></i>
                                                                                </a>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info border-0 rounded-3 mb-0 d-flex align-items-center justify-content-between p-3">
                                                        <div>
                                                            <i class="fas fa-info-circle me-2 fs-5"></i>
                                                            <strong>Bu projeye ait kayıtlı dış sosyal alan bulunmuyor.</strong>
                                                            <div class="small mt-1 text-muted">Çocuk parkı, otopark, kamelya, yeşil alan gibi sosyal donatılar eklemek için Bina Özeti > Alan Yönetimi sekmesini kullanabilirsiniz.</div>
                                                        </div>
                                                        <a href="/Construction/ProjectSummary/@projectId" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                                            <i class="fas fa-plus me-1"></i> Alan Ekle
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- 🚩 SİSTEME SIZMA (CHECK-POINT) MODALI -->
<div class="modal fade" id="checkPointModal" tabindex="-1" aria-labelledby="checkPointModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="fas fa-crosshairs fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="checkPointModalLabel">Şantiyeniz Şu An Hangi Aşamada?</h5>
                        <p class="text-muted small mb-0"><strong>GMK360 Akıllı Sızma:</strong> Sahada halihazırda başlamış/devam eden şantiyeler için doğrudan ilgili aşamaya atlayabilirsiniz. Sıfırdan temiz arsa için <strong>"0'dan Başla"</strong> seçeneğini kullanınız.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <!-- Kart 0: Sıfırdan Başla (Tüm Adımlar Açık) -->
                    <div class="col-12">
                        <div class="card border-2 border-primary rounded-4 p-3 check-card bg-primary bg-opacity-10 shadow-sm" onclick="applyCheckPoint(0, 'Tüm Adımlar (Sıfırdan)')">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white p-3 rounded-3 fs-3 shadow-sm">
                                    <i class="fas fa-layer-group"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-primary mb-0 fs-6"><i class="fas fa-play-circle me-1"></i> 0'dan Başla (Temiz Arsa - Tüm Aşamalar Açık)</h6>
                                        <span class="badge bg-primary text-white rounded-pill px-3 py-1">Adım 0 - 9 (Eksiksiz Liste)</span>
                                    </div>
                                    <p class="text-dark small mb-0">Hiçbir adımı atlamadan; zemin, ihata, geçici şantiye elektriği & suyu ve tüm imalatları sırayla tek tek inceleyip doldur.</p>
                                </div>
                                <span class="btn btn-primary rounded-pill px-4 py-2 fw-bold text-white shadow-xs text-nowrap">
                                    Tüm Listeyi Aç <i class="fas fa-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 1: Sıfır Şantiye & Ruhsat -->
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-4 p-3 check-card" onclick="applyCheckPoint(0, 'Ruhsat & Sıfır Şantiye')">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-info bg-opacity-10 text-info p-3 rounded-3 fs-4">
                                    <i class="fas fa-drafting-compass"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-dark mb-0">Ruhsat & Sıfır Şantiye</h6>
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill small">Adım 0-1</span>
                                    </div>
                                    <p class="text-muted small mb-2">Statik projeler, arsa analizi, ihata teli, şantiye elektriği & suyu hazırlıkları.</p>
                                    <span class="btn btn-sm btn-outline-info rounded-pill px-3 fw-semibold">Buradan Başla <i class="fas fa-arrow-right ms-1"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 2: Temel & Kaba İnşaat -->
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-4 p-3 check-card" onclick="applyCheckPoint(2, 'Temel & Kaba İnşaat')">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 fs-4">
                                    <i class="fas fa-cubes"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-dark mb-0">Temel & Kaba İnşaat</h6>
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill small">Adım 2-3</span>
                                    </div>
                                    <p class="text-muted small mb-2">Kot 0 temel yalıtımı, perde beton, kaba yapı iskeleti, dış ve iç duvar imalatları.</p>
                                    <span class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold text-dark">Buradan Başla <i class="fas fa-arrow-right ms-1"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 3: İnce İşler & Yaşam Alanı -->
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-4 p-3 check-card border-primary bg-primary bg-opacity-10" onclick="applyCheckPoint(4, 'İnce İşler & Yaşam Alanı')">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-primary text-white p-3 rounded-3 fs-4 shadow-sm">
                                    <i class="fas fa-paint-roller"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-primary mb-0">İnce İşler & Yaşam Alanı</h6>
                                        <span class="badge bg-primary text-white rounded-pill small">Adım 4-7</span>
                                    </div>
                                    <p class="text-muted small mb-2">Lamine parke, seramik, alçı & boya, asma tavan, kapı/pencere doğramaları ve tesisat.</p>
                                    <span class="btn btn-sm btn-primary rounded-pill px-3 fw-bold text-white shadow-xs">Buradan Başla <i class="fas fa-arrow-right ms-1"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Kart 4: Peyzaj & Teslimat -->
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-4 p-3 check-card" onclick="applyCheckPoint(8, 'Peyzaj & Teslimat')">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 fs-4">
                                    <i class="fas fa-tree"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold text-dark mb-0">Peyzaj & Teslimat</h6>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill small">Adım 8-9</span>
                                    </div>
                                    <p class="text-muted small mb-2">Ortak alanlar, asansör, çevre düzenleme, peyzaj ve geçici kabul hazırlıkları.</p>
                                    <span class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">Buradan Başla <i class="fas fa-arrow-right ms-1"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-between">
                <span class="text-muted small"><i class="fas fa-info-circle me-1"></i> Önceki adımlar istediğiniz an incelenebilir ve düzenlenebilir.</span>
                <button type="button" class="btn btn-link text-muted text-decoration-none fw-semibold btn-sm" onclick="applyCheckPoint(0, 'Tüm Adımlar')">
                    Tüm Adımları Kendim Görmek İstiyorum &rarr;
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .check-card {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        border: 2px solid #e9ecef !important;
    }
    .check-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        border-color: #6f42c1 !important;
    }
    .step-passed {
        opacity: 0.8 !important;
        background-color: #f8f9fa !important;
    }
</style>

<script>
    var currentProjectId = @(projectId ?? 0);
    var currentProfileId = @(existingProfile != null ? existingProfile.Id : 0);

    function cloneCurrentProfile() {
        var nameInput = document.getElementById("configName");
        var oldName = nameInput.value.trim() || "Profil";
        var newName = oldName + " (Yeni Alternatif)";
        nameInput.value = newName;
        currentProfileId = 0; // 0 yaparak yeni profil oluşturmasını sağlıyoruz
        
        if (window.history && window.history.replaceState) {
            var newUrl = '/Metraj/DnaWizard/' + currentProjectId;
            window.history.replaceState({ path: newUrl }, '', newUrl);
        }
        var statusText = document.getElementById("profileStatusText");
        if (statusText) statusText.innerHTML = '<span class="text-success fw-bold"><i class="fas fa-copy me-1"></i>Yeni Alternatif Olarak Kaydedilecek</span>';
        
        var badge = document.getElementById("autosaveBadge");
        if (badge) {
            badge.className = "badge bg-info bg-opacity-10 text-info border border-info px-3 py-2 rounded-pill shadow-xs";
            badge.innerHTML = `<i class="fas fa-spinner fa-spin me-1 text-info"></i> Yeni Kopya Oluşturuluyor...`;
        }
        triggerAutoSave();
    }
    var currentStartStep = @(initialStartStep.HasValue ? initialStartStep.Value : -1);
    var autosaveTimer = null;

    function openCheckPointModal() {
        var modalEl = document.getElementById("checkPointModal");
        if (modalEl) {
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function applyCheckPoint(stepOrder, stageTitle, skipSave) {
        currentStartStep = stepOrder;

        // 1. Üst bardaki aşama etiketini güncelle
        var labelEl = document.getElementById("checkPointStageLabel");
        if (labelEl) {
            labelEl.innerText = "Aşama: " + (stageTitle || ("Adım " + stepOrder));
        }

        // 2. Sol menüdeki adımları güncelle (Önceki adımlara 'Geçmiş Aşama' rozeti ver)
        var tabLinks = document.querySelectorAll('#stepTabsList a.list-group-item');
        tabLinks.forEach(function(link) {
            var stepAttr = link.getAttribute('data-step') || (link.getAttribute('href') ? link.getAttribute('href').replace('#pill_step', '') : null);
            var order = parseInt(stepAttr);
            if (isNaN(order)) return;

            var existingBadge = link.querySelector('.checkpoint-badge');
            if (existingBadge) existingBadge.remove();

            if (stepOrder > 0 && order < stepOrder) {
                link.classList.add('step-passed');
                var span = document.createElement('span');
                span.className = 'badge bg-success bg-opacity-10 text-success border border-success rounded-pill float-end small me-1 checkpoint-badge';
                span.innerHTML = '<i class="fas fa-check me-1"></i>Geçmiş';
                link.appendChild(span);
            } else {
                link.classList.remove('step-passed');
            }
        });

        // 3. İlgili sekmeye odaklan
        switchStepTab(stepOrder);

        // 4. Modalı kapat
        var modalEl = document.getElementById("checkPointModal");
        if (modalEl && window.bootstrap && bootstrap.Modal) {
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }

        // 5. Otomatik kaydı tetikle
        if (!skipSave) {
            triggerAutoSave();
        }
    }

    function switchStepTab(order, elem) {
        order = parseInt(order);
        if (isNaN(order)) order = 0;

        var tabLink = elem || document.getElementById('tab_step' + order) || document.querySelector('#stepTabsList a[data-step="' + order + '"]');
        if (tabLink && window.bootstrap && bootstrap.Tab) {
            var tabInstance = bootstrap.Tab.getOrCreateInstance(tabLink);
            tabInstance.show();
        } else {
            // Standart Fallback (Bootstrap JS henüz yüklenmemişse)
            document.querySelectorAll('#stepTabsList .list-group-item').forEach(function(item) {
                item.classList.remove('active');
            });
            if (tabLink) tabLink.classList.add('active');

            document.querySelectorAll('#wizardStepsTabContent > .tab-pane').forEach(function(pane) {
                pane.classList.remove('show', 'active');
            });
            var targetPane = document.getElementById('pill_step' + order);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
            }
        }
        updateTabBadges();
    }

    function updateTabBadges() {
        document.querySelectorAll('#stepTabsList .list-group-item').forEach(function(item) {
            var b = item.querySelector('.step-count-badge');
            if (!b) return;
            var isDanger = b.classList.contains('text-danger') || b.classList.contains('bg-danger');
            if (item.classList.contains('active')) {
                b.className = isDanger 
                    ? 'badge bg-white text-danger rounded-pill float-end fw-bold shadow-xs step-count-badge' 
                    : 'badge bg-white text-primary rounded-pill float-end fw-bold shadow-xs step-count-badge';
            } else {
                b.className = isDanger 
                    ? 'badge bg-danger rounded-pill float-end step-count-badge' 
                    : 'badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill float-end step-count-badge';
            }
        });
    }

    function onNameInput() {
        var input = document.getElementById("configName");
        var name = input.value.trim();
        var badge = document.getElementById("autosaveBadge");
        var statusText = document.getElementById("profileStatusText");

        if (!name) {
            input.classList.remove("is-invalid");
            clearTimeout(autosaveTimer);
            if (badge) {
                badge.className = "badge bg-light text-muted border px-3 py-2 rounded-pill shadow-xs";
                badge.innerHTML = `<i class="fas fa-cloud me-1 text-primary"></i> Otomatik Kayıt Hazır`;
            }
            return;
        }

        clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(function() {
            fetch(`/Metraj/CheckProfileName?projectId=${currentProjectId}&name=${encodeURIComponent(name)}&profileId=${currentProfileId}`)
            .then(res => res.json())
            .then(chk => {
                if (chk && chk.exists) {
                    input.classList.add("is-invalid");
                    if (badge) {
                        badge.className = "badge bg-danger text-white border px-3 py-2 rounded-pill shadow-xs";
                        badge.innerHTML = `<i class="fas fa-exclamation-triangle me-1"></i> Bu isim zaten kayıtlı!`;
                    }
                    if (statusText) {
                        statusText.innerHTML = `<span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i>Aynı isimde profil var</span>`;
                    }
                } else {
                    input.classList.remove("is-invalid");
                    triggerAutoSave();
                }
            })
            .catch(() => triggerAutoSave());
        }, 600);
    }

    function onNumberInput(questionId) {
        updateSmartCalculation();
        applyConditionalVisibility();
        clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(triggerAutoSave, 600);
    }

    function updateSmartCalculation() {
        var inpTotal = document.querySelector("input[data-qorder='3']");
        var inpDepot = document.querySelector("input[data-qorder='5']");
        var badge = document.getElementById("smartCalculationBadge");
        if (!inpTotal || !inpDepot || !badge) return;

        var total = parseFloat(inpTotal.value) || 0;
        var existing = parseFloat(inpDepot.value) || 0;

        if (total > 0 && inpDepot.value && inpDepot.value.trim() !== "") {
            var diff = total - existing;
            if (diff < 0) diff = 0;
            badge.classList.remove("d-none");
            document.getElementById("calcDiffText").innerHTML = `<i class="fas fa-calculator me-2"></i>Temin Edilecek Net İhtiyaç: <strong>${diff.toLocaleString('tr-TR')} Metre</strong>`;
            document.getElementById("calcDetailText").innerText = `Toplam İhata: ${total.toLocaleString('tr-TR')} m | Depoda Mevcut: ${existing.toLocaleString('tr-TR')} m`;
        } else {
            badge.classList.add("d-none");
        }
    }

    function hideQuestionCard(card, questionId) {
        if (!card) return;
        if (!card.classList.contains("d-none")) {
            card.classList.add("d-none");
            var singleSel = document.getElementById("single_" + questionId);
            if (singleSel && singleSel.value) {
                singleSel.value = "";
                var badge = document.getElementById("badge_single_" + questionId);
                if (badge) badge.innerHTML = "";
            }
        }
    }

    function showQuestionCard(card) {
        if (!card) return;
        if (card.classList.contains("d-none")) {
            card.classList.remove("d-none");
        }
    }

    function applyConditionalVisibility() {
        // --- 1. YIKIM VE MOLOZ BERTARAFI (Adım 1 - Soru 9 & 10) ---
        var selYikim = document.getElementById("single_3028");
        var cardMoloz = document.getElementById("card_q_3029");
        if (selYikim && cardMoloz) {
            var selectedText = selYikim.options[selYikim.selectedIndex]?.text || "";
            if (selectedText.includes("Boş Arsa") || selectedText === "" || selectedText.includes("Gerekmez")) {
                hideQuestionCard(cardMoloz, 3029);
            } else {
                showQuestionCard(cardMoloz);
            }
        }

        // --- 2. ŞANTİYE GEÇİCİ ELEKTRİK & JENERATÖR TEMİNİ (Adım 1 - Soru 11 & 12) ---
        var selElektrik = document.getElementById("single_3030");
        var cardJenerator = document.getElementById("card_q_3031");
        if (selElektrik && cardJenerator) {
            var selectedText = selElektrik.options[selElektrik.selectedIndex]?.text || "";
            if (selectedText.includes("Şebeke Şantiye Aboneliği") && !selectedText.includes("Hibrit") && !selectedText.includes("Jeneratör")) {
                hideQuestionCard(cardJenerator, 3031);
            } else if (selectedText.includes("Jeneratör") || selectedText.includes("Hibrit")) {
                showQuestionCard(cardJenerator);
            } else {
                hideQuestionCard(cardJenerator, 3031);
            }
        }

        // --- 3. İHATA ÇİTİ VE EKSİK MALZEME TEMİNİ (Adım 1 - Soru 4, 5, 6) ---
        var selCit = document.getElementById("single_2023");
        var cardDepot = document.getElementById("card_q_2024");
        var cardEksik = document.getElementById("card_q_2025");
        var inpTotal = document.querySelector("input[data-qorder='3']");
        var inpDepot = document.getElementById("num_2024");

        if (selCit) {
            var citText = selCit.options[selCit.selectedIndex]?.text || "";
            if (citText.includes("Kapatılmayacak") || citText === "") {
                if (cardDepot) hideQuestionCard(cardDepot, 2024);
                if (cardEksik) hideQuestionCard(cardEksik, 2025);
            } else {
                if (cardDepot) showQuestionCard(cardDepot);
                if (cardEksik) {
                    var total = parseFloat(inpTotal?.value) || 0;
                    var depot = parseFloat(inpDepot?.value) || 0;
                    if (total > 0 && depot >= total && inpDepot?.value && inpDepot?.value.trim() !== "") {
                        hideQuestionCard(cardEksik, 2025);
                    } else {
                        showQuestionCard(cardEksik);
                    }
                }
            }
        }

        // --- 4. GİRİŞ KAPISI VE KAPI TEMİN YÖNTEMİ (Adım 1 - Soru 7 & 8) ---
        var selKapi = document.getElementById("single_2026");
        var cardKapiTemin = document.getElementById("card_q_3027");
        if (selKapi && cardKapiTemin) {
            var kapiText = selKapi.options[selKapi.selectedIndex]?.text || "";
            if (kapiText.includes("Yapılmayacak") || kapiText.includes("Açık") || kapiText === "") {
                hideQuestionCard(cardKapiTemin, 3027);
            } else {
                showQuestionCard(cardKapiTemin);
            }
        }

        // --- 5. KOT 0 ÇEVRE DRENAJI VE TAHLİYE (Adım 2 - Soru 7 & 8) ---
        var selDrenaj = document.getElementById("single_3045");
        var cardDrenajTahliye = document.getElementById("card_q_3046");
        var cardPompaTemin = document.getElementById("card_q_11043");
        var isDrenajActive = false;

        if (selDrenaj && cardDrenajTahliye) {
            var drenajText = selDrenaj.options[selDrenaj.selectedIndex]?.text || "";
            if (drenajText.includes("Yapılmayacak") || drenajText.includes("Doğal Tahliye") || drenajText === "") {
                hideQuestionCard(cardDrenajTahliye, 3046);
            } else {
                showQuestionCard(cardDrenajTahliye);
                isDrenajActive = true;
            }
        }

        // --- 6. DALGIÇ POMPA TEMİN VE MÜLKİYETİ (Adım 2 - Soru 9) ---
        var selTahliye = document.getElementById("single_3046");
        if (cardPompaTemin) {
            if (!isDrenajActive) {
                hideQuestionCard(cardPompaTemin, 11043);
            } else if (selTahliye) {
                var tahliyeText = selTahliye.options[selTahliye.selectedIndex]?.text || "";
                if (tahliyeText.includes("Pompa") || tahliyeText.includes("Terfi") || tahliyeText.includes("Kot Kurtarmıyor")) {
                    showQuestionCard(cardPompaTemin);
                } else {
                    hideQuestionCard(cardPompaTemin, 11043);
                }
            }
        }
    }

