    function renderAllWizardWorkflowTables(steps, summary) {
        if(summary) {
            var elDays = document.getElementById("wizWfTotalDays");
            if(elDays) elDays.innerText = "~" + summary.totalDurationDays + " İş Günü";
            var elMan = document.getElementById("wizWfTotalManDays");
            if(elMan) elMan.innerText = "~" + summary.totalManDays + " Adam-Gün";
            var elCrew = document.getElementById("wizWfMaxCrew");
            if(elCrew) elCrew.innerText = summary.maxCrew + " Kişi";
            var elComp = document.getElementById("wizWfEstCompletion");
            if(elComp) elComp.innerText = summary.estimatedCompletion || "...";
        }

        // 1. Malzeme Tablosu
        var matTbody = document.getElementById("wizMaterialTableTbody");
        if(matTbody) {
            matTbody.innerHTML = steps.map(s => `
                <tr>
                    <td class="text-center px-3">
                        <input type="checkbox" class="form-check-input wiz-material-step-check" value="${s.stepCode}" checked onchange="updateWizardMaterialCounter()">
                    </td>
                    <td class="text-center">
                        <span class="badge bg-dark text-warning font-monospace px-2 py-1 fs-6">${s.stepCode}</span>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${s.phaseName}</div>
                        <div class="small text-muted">${s.stageCategory}</div>
                    </td>
                    <td>
                        <div class="fw-bold text-primary">${s.materialTitle}</div>
                        <div class="small text-muted">${s.materialDescription}</div>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-3 py-2 rounded-pill fs-6 fw-bold">
                            ${Number(s.materialQuantity).toLocaleString()} ${s.materialUnit}
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border px-2 py-1 small">
                            <i class="fas fa-truck text-secondary me-1"></i>${s.supplierCategory}
                        </span>
                    </td>
                    <td>
                        <span class="small text-muted font-monospace">${s.materialFormula}</span>
                    </td>
                </tr>
            `).join("");
            updateWizardMaterialCounter();
        }

        // 2. İş Gücü Tablosu
        var laborTbody = document.getElementById("wizLaborTableTbody");
        if(laborTbody) {
            laborTbody.innerHTML = steps.map(s => `
                <tr>
                    <td class="text-center px-3">
                        <input type="checkbox" class="form-check-input wiz-labor-step-check" value="${s.stepCode}" checked onchange="updateWizardLaborCounter()">
                    </td>
                    <td class="text-center">
                        <span class="badge bg-dark text-warning font-monospace px-2 py-1 fs-6">${s.stepCode}</span>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${s.phaseName}</div>
                        <div class="small text-muted">${s.stageCategory}</div>
                    </td>
                    <td>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-bold small">
                            <i class="fas fa-hard-hat me-1"></i> ${s.professionName}
                        </span>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${s.crewComposition}</div>
                        <div class="small text-muted">Ekip: <span class="badge bg-secondary">${s.crewSize} Kişi</span></div>
                    </td>
                    <td class="text-center">
                        <div class="fw-bold text-dark">${s.durationDays} İş Günü</div>
                        <span class="badge bg-light text-dark border small">${s.totalManDays} Adam-Gün</span>
                    </td>
                    <td>
                        <div class="small text-dark"><strong>Ekipman:</strong> ${s.equipmentNeeded}</div>
                        <div class="small text-muted mt-1"><i class="fas fa-link me-1"></i>Önkoşul: ${s.predecessors}</div>
                    </td>
                    <td>
                        <div class="small text-danger fw-semibold">
                            <i class="fas fa-exclamation-triangle me-1"></i>${s.criticalDependency}
                        </div>
                    </td>
                </tr>
            `).join("");
            updateWizardLaborCounter();
        }

        // 3. Takvim Çizelgesi
        var timeTbody = document.getElementById("wizTimelineTableTbody");
        if(timeTbody) {
            timeTbody.innerHTML = steps.map(s => `
                <tr>
                    <td class="text-center">
                        <span class="badge bg-dark text-warning font-monospace px-2 py-1 fs-6">${s.stepCode}</span>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">${s.phaseName}</div>
                        <div class="small text-muted"><i class="fas fa-tag me-1"></i>${s.stageCategory}</div>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fw-bold fs-6">
                            <i class="far fa-calendar-alt me-1"></i> ${s.plannedDateRange}
                        </span>
                    </td>
                    <td class="text-center fw-bold">${s.durationDays} Gün</td>
                    <td>
                        <div class="fw-bold text-dark small"><i class="fas fa-hard-hat text-primary me-1"></i>${s.professionName}</div>
                        <div class="small text-muted">${s.crewComposition}</div>
                    </td>
                    <td>
                        <div class="p-2 rounded bg-light border small">
                            <div class="text-danger fw-bold"><i class="fas fa-bell me-1"></i>T-${s.durationDays >= 5 ? 3 : 2} Ön Kontrol</div>
                            <div class="text-muted mt-1">${s.materialTitle} tedariği & ${s.professionName} ekibi teyidi</div>
                        </div>
                    </td>
                </tr>
            `).join("");
        }
    }

    function toggleAllWizardMaterials(checked) {
        document.querySelectorAll(".wiz-material-step-check").forEach(cb => cb.checked = checked);
        var master = document.getElementById("wizMasterMaterialCheck");
        if(master) master.checked = checked;
        updateWizardMaterialCounter();
    }

    function updateWizardMaterialCounter() {
        var count = document.querySelectorAll(".wiz-material-step-check:checked").length;
        var span = document.getElementById("wizSelectedMaterialCount");
        if(span) span.innerText = count;
        var btn = document.getElementById("btnWizSendMaterialsB2B");
        if(btn) btn.disabled = (count === 0);
    }

    function toggleAllWizardLabor(checked) {
        document.querySelectorAll(".wiz-labor-step-check").forEach(cb => cb.checked = checked);
        var master = document.getElementById("wizMasterLaborCheck");
        if(master) master.checked = checked;
        updateWizardLaborCounter();
    }

    function updateWizardLaborCounter() {
        var count = document.querySelectorAll(".wiz-labor-step-check:checked").length;
        var span = document.getElementById("wizSelectedLaborCount");
        if(span) span.innerText = count;
        var btn = document.getElementById("btnWizSendLaborB2B");
        if(btn) btn.disabled = (count === 0);
    }

    function sendWizardWorkflowTrack(track) {
        var selector = track === "Labor" ? ".wiz-labor-step-check:checked" : ".wiz-material-step-check:checked";
        var selectedCodes = Array.from(document.querySelectorAll(selector)).map(cb => cb.value);

        if(selectedCodes.length === 0) {
            alert("Lütfen en az bir aşama seçiniz.");
            return;
        }

        var btnId = track === "Labor" ? "btnWizSendLaborB2B" : "btnWizSendMaterialsB2B";
        var btn = document.getElementById(btnId);
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> İhale Paketi Oluşturuluyor...`;

        fetch("/Metraj/SendWorkflowToB2B", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                ProjectId: currentProjectId,
                ProfileId: currentProfileId,
                TargetTrack: track,
                SelectedStepCodes: selectedCodes
            })
        })
        .then(res => res.json())
        .then(data => {
            if(data && data.success) {
                alert("🎉 " + data.message + "\n\nŞimdi B2B İhale & Teklifler sayfasına yönlendiriliyorsunuz.");
                window.location.href = "/B2BPurchasing/Index";
            } else {
                alert("Hata: " + (data ? data.message : "İşlem yapılamadı."));
                btn.disabled = false;
                btn.innerHTML = track === "Labor" 
                    ? `<i class="fas fa-users-cog me-2"></i> Seçilen Ekipler İçin Taşeron / Usta Çağrısı Aç`
                    : `<i class="fas fa-shopping-cart me-2"></i> Seçilen Malzemeler İçin B2B Satın Alma İhalesi Başlat`;
            }
        })
        .catch(err => {
            console.error(err);
            alert("Sunucuya bağlanırken bir hata oluştu.");
            btn.disabled = false;
        });
    }

    function triggerWizardWorkflowToAgenda() {
        var startDateVal = document.getElementById("wizardStartDateInput")?.value || "";
        if(!startDateVal) {
            alert("Lütfen bir başlangıç tarihi seçiniz.");
            return;
        }

        var selectedCodes = Array.from(document.querySelectorAll(".wiz-material-step-check:checked")).map(cb => cb.value);
        if(selectedCodes.length === 0) {
            selectedCodes = ["X01", "X02", "X03", "X04", "X05", "X06", "X07", "X08", "X09"];
        }

        var btn = document.getElementById("btnWizTriggerAgenda");
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Ajandaya İşleniyor...`;

        fetch("/Metraj/TriggerWorkflowAgenda", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                ProjectId: currentProjectId,
                ProfileId: currentProfileId,
                StartDate: startDateVal,
                SelectedStepCodes: selectedCodes
            })
        })
        .then(res => res.json())
        .then(data => {
            if(data && data.success) {
                alert("🚀 " + data.message + "\n\nŞimdi Şantiye Ajandanıza yönlendiriliyorsunuz.");
                window.location.href = "/Metraj/SiteAgenda/" + currentProjectId + "?baseDate=" + startDateVal + (currentProfileId ? "&profileId=" + currentProfileId : "");
            } else {
                alert("Hata: " + (data ? data.message : "Ajandaya işlenemedi."));
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-rocket me-2"></i> Bu Otonom Takvimi Şantiye Ajandama İşle`;
            }
        })
        .catch(err => {
            console.error(err);
            alert("Sunucuya bağlanırken bir hata oluştu.");
            btn.disabled = false;
        });
    }
</script>

