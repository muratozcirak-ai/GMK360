@model dynamic
@{
    ViewData["Title"] = "DNA Profil Sihirbazı";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var projectId = ViewData["ProjectId"];
    var projectName = ViewData["ProjectName"] ?? "Proje";
    var step0 = ViewBag.Step0 as GMK360.Core.Entities.Construction.Workflows.DnaTemplateStep;
    var step1 = ViewBag.Step1 as GMK360.Core.Entities.Construction.Workflows.DnaTemplateStep;
    var allSteps = ViewBag.AllSteps as List<GMK360.Core.Entities.Construction.Workflows.DnaTemplateStep>;
    var existingProfile = ViewBag.ExistingProfile as GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile;
    var initialStartStep = ViewBag.StartStep as int?;
    var project = ViewBag.Project as GMK360.Core.Entities.Construction.ConstructionProject;
    var parametricTakeoff = ViewBag.ParametricTakeoff as List<GMK360.Web.Controllers.MetrajController.ParametricTakeoffItemDto>;

    var blocks = project?.Blocks?.Where(b => !b.IsExistingBuilding).ToList() ?? new List<GMK360.Core.Entities.Building>();
    var rootBlocks = blocks.Where(b => b.ParentBuildingId == null).ToList();
    double totalLand = project?.TotalLandArea ?? 0;
    double baseArea = rootBlocks.Sum(b => b.BaseArea ?? 0);
    if (baseArea <= 0 && blocks.Any()) baseArea = blocks.Sum(b => b.BaseArea ?? 0);
    if (baseArea <= 0) baseArea = project?.EskiBinaOturumAlani ?? (totalLand > 0 ? totalLand * 0.40 : 500);

    double taksRate = totalLand > 0 ? (baseArea / totalLand) * 100 : 0;
    int maxFloors = blocks.Any() ? blocks.Max(b => (b.TotalFloors ?? 0) + b.BasementFloors) : (project?.TotalFloors ?? 5);
    int maxBasement = blocks.Any() ? blocks.Max(b => b.BasementFloors) : 2;
    int totalApartments = blocks.Sum(b => b.TotalApartments);
    if (totalApartments <= 0) totalApartments = project?.TargetTotalApartments ?? 0;
    int totalShops = blocks.Sum(b => b.TotalShops);
    if (totalShops <= 0) totalShops = project?.TargetTotalShops ?? 0;

    var existingDetails = existingProfile?.Details?.ToList() ?? new List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaDetail>();
    var zeminItem = existingDetails.FirstOrDefault(d => d.SelectedItem.Contains("Zemin") || d.SelectedItem.Contains("Kaya") || d.SelectedItem.Contains("Kum"))?.SelectedItem ?? "Yumuşak / Kumlu Zemin";
    var ihataItem = existingDetails.FirstOrDefault(d => d.SelectedItem.Contains("Sac") || d.SelectedItem.Contains("Tel Örgü") || d.SelectedItem.Contains("Pano"))?.SelectedItem ?? "Trapez Sac Kaplama";
    var ihataLen = existingDetails.FirstOrDefault(d => d.SelectedItem.Contains("Çevre Sınırı Toplam") || (d.SelectedItem.Contains("İhata") && d.SelectedItem.Contains(":")) )?.SelectedItem ?? $"~{Math.Round(4 * Math.Sqrt(totalLand > 0 ? totalLand : 3600), 0)} mt";
    var elektrikItem = existingDetails.FirstOrDefault(d => d.SelectedItem.Contains("Elektrik") || d.SelectedItem.Contains("Abonelik") || d.SelectedItem.Contains("Jeneratör"))?.SelectedItem ?? "Şantiye Aboneliği + TMŞ Pano";
    var suItem = existingDetails.FirstOrDefault(d => d.SelectedItem.Contains("Su") || d.SelectedItem.Contains("Depo") || d.SelectedItem.Contains("Hidrofor"))?.SelectedItem ?? "15T Su Deposu + 3 HP Hidrofor";
    var workflowSteps = ViewBag.WorkflowSteps as List<GMK360.Web.Controllers.MetrajController.WorkflowStepItemDto>;
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">

    <!-- ÜST BİLGİ VE AKSİYON ÇUBUĞU -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border">
        <div class="d-flex align-items-center gap-3">
            <a href="/Metraj/ProjectDNA/@projectId" class="btn btn-outline-secondary rounded-pill px-3 fw-bold btn-sm">
                <i class="fas fa-arrow-left me-1"></i> DNA Yönetimine Dön
            </a>
            <div>
                <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="fas fa-dna text-primary"></i>
                    <span>DNA Profil Sihirbazı</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill fs-6 fw-semibold">
                        <i class="fas fa-city me-1"></i> @projectName
                    </span>
                </h4>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0 flex-wrap">
            <a href="/Metraj/DnaWizard/@projectId" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm fw-semibold shadow-xs" title="Sıfırdan Yeni Profil Oluştur">
                <i class="fas fa-plus-circle text-primary me-1"></i> + Yeni Profil
            </a>
            <button type="button" class="btn btn-warning rounded-pill px-3 py-2 btn-sm fw-bold shadow-xs text-dark" onclick="openParametricModalInWizard()" title="İş Akışı, Tedarik & Usta Planı (X01-X09)">
                <i class="fas fa-network-wired me-1 text-dark"></i> İş Akışı & İhale Planı (X01-X09)
            </button>
            <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-2 btn-sm fw-semibold shadow-xs" onclick="openCheckPointModal()" title="Şantiye Aşaması Değiştir">
                <i class="fas fa-crosshairs me-1 text-primary"></i> <span id="checkPointStageLabel">Şantiye Aşaması: Tüm Adımlar</span> <i class="fas fa-sliders-h ms-1 text-muted small"></i>
            </button>
            <a href="/Metraj/SiteAgenda/@projectId?profileId=@(existingProfile != null ? existingProfile.Id : 0)" 
               id="btnGoSiteAgenda" 
               class="btn btn-outline-dark rounded-pill px-3 py-2 btn-sm fw-semibold shadow-xs" 
               title="Otonom Şantiye Ajandası">
                <i class="fas fa-calendar-alt text-primary me-1"></i> Otonom Ajanda
            </a>
            <span id="autosaveBadge" class="badge bg-light text-muted border px-3 py-2 rounded-pill shadow-xs">
                <i class="fas fa-cloud me-1 text-primary"></i> Otomatik Kayıt Hazır
            </span>
            <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" onclick="finishProfile()" style="background-color: #6f42c1; border-color: #6f42c1;">
                <i class="fas fa-check-circle me-2"></i> DNA Profilini Tamamla ve Kaydet
            </button>
        </div>
    </div>

    <!-- PROJE YAPI ÖZETİ & ÇEVRESEL SAHA REFERANSI (KOKPİT ŞERİDİ - COLLAPSIBLE) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border py-2 px-3">
                    <i class="fas fa-building text-primary me-1"></i>
                    <strong>Yapı Künyesi:</strong> @(totalLand > 0 ? totalLand.ToString("N0") + " m² Arsa" : "")@(baseArea > 0 ? " | " + baseArea.ToString("N0") + " m² Taban" : "") | @maxFloors Kat | @(totalApartments) Daire
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-bold rounded-pill px-3 shadow-xs" onclick="openParametricModalInWizard()">
                    <i class="fas fa-calculator me-1"></i> Keşif (@(parametricTakeoff?.Count ?? 0) Kalem)
                </button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 text-secondary fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#wizardCockpitCollapse" aria-expanded="false" aria-controls="wizardCockpitCollapse">
                    <i class="fas fa-sliders-h text-primary me-1"></i> Detaylar <i class="fas fa-chevron-down ms-1"></i>
                </button>
            </div>
        </div>

        <div class="collapse border-top" id="wizardCockpitCollapse">
            <div class="card-body p-3 px-4 bg-light bg-opacity-50">
                <div class="row align-items-center g-3">
                    <div class="col-lg-7 border-end">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-building text-primary me-2 fs-5"></i>
                            <strong class="text-dark">Mimari Yapı Özeti:</strong>
                            <span class="ms-2 text-muted small">DXF çizimi beklenmeden bu boyutlara göre ihale ve malzeme metrajları hesaplanır.</span>
                        </div>
                        <div class="row g-2 small">
                            <div class="col-sm-3 col-6">
                                <span class="text-muted d-block">Toplam Arsa:</span>
                                <strong class="text-dark fs-6">@(totalLand > 0 ? totalLand.ToString("N0") + " m²" : "Belirtilmedi")</strong>
                            </div>
                            <div class="col-sm-3 col-6">
                                <span class="text-muted d-block">Taban TAKS:</span>
                                <strong class="text-dark fs-6">@(baseArea > 0 ? baseArea.ToString("N0") + " m²" : "0 m²")</strong> <small class="text-muted">(%@taksRate.ToString("N1"))</small>
                            </div>
                            <div class="col-sm-3 col-6">
                                <span class="text-muted d-block">Maksimum Kat:</span>
                                <strong class="text-dark fs-6">@maxFloors Kat</strong> <small class="text-muted">(@maxBasement Bodrum)</small>
                            </div>
                            <div class="col-sm-3 col-6">
                                <span class="text-muted d-block">Bağımsız Bölüm:</span>
                                <strong class="text-dark fs-6">@(totalApartments) Daire, @(totalShops) Dükkan</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="small fw-bold text-warning mb-1"><i class="fas fa-map-marked-alt me-1"></i>Saha & Çevresel Koşullar (Adım 1):</div>
                                <div class="small text-muted">
                                    <span><i class="fas fa-mountain me-1"></i>@zeminItem</span> | 
                                    <span><i class="fas fa-border-all me-1"></i>@ihataLen</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 shadow-xs" onclick="openParametricModalInWizard()">
                                <i class="fas fa-calculator me-1"></i> Keşfi Gör (@(parametricTakeoff?.Count ?? 0))
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PROFİL ADI GİRİŞ KARTI (AUTOSAVE TETİKLEYİCİSİ) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 border-start border-5 border-primary">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <label class="form-label fw-bold text-dark fs-5 mb-1">
                        <i class="fas fa-tag text-primary me-2"></i>DNA Profilinin Adı
                    </label>
                    <p class="text-muted small mb-2">Profil adını yazdığınızda taslağınız arka planda otomatik oluşturulacak ve yaptığınız tüm seçimler kaydedilecektir.</p>
                    <input type="text" class="form-control form-control-lg border-2 fw-bold" id="configName" 
                           placeholder="Örn: A Blok - Standart İhale Reçetesi veya Alternatif 2" 
                           value="@(existingProfile != null ? existingProfile.Name : "")"
                           onblur="triggerAutoSave()" oninput="onNameInput()">
                    @if (existingProfile != null)
                    {
                        <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill small">
                                <i class="fas fa-edit me-1"></i> Düzenlenen Profil: <strong>@existingProfile.Name</strong> (#@existingProfile.Id)
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-xs fw-semibold" onclick="cloneCurrentProfile()" title="Bu profildeki tüm seçimleri koruyarak yeni bir profil alternatifi olarak kaydeder">
                                <i class="fas fa-copy me-1"></i> Bu Profili Yeni Alternatif Olarak Çoğalt (Klonla)
                            </button>
                            <a href="/Metraj/DnaWizard/@projectId" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-xs fw-semibold">
                                <i class="fas fa-plus me-1"></i> Sıfırdan Yeni Profil Başlat
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1 rounded-pill small">
                                <i class="fas fa-magic me-1"></i> Yeni Boş Profil Oluşturuluyor
                            </span>
                            <span class="text-muted small">Profil adını yazdığınız anda bu projeye yeni bir DNA profili olarak eklenecektir.</span>
                        </div>
                    }
                </div>
                <div class="col-lg-4 mt-3 mt-lg-0 text-lg-end">
                    <div class="p-3 bg-light rounded-3 border d-inline-block text-start">
                        <div class="small text-muted fw-semibold">Taslak Durumu:</div>
                        <div class="fw-bold text-dark fs-6" id="profileStatusText">
                            @(existingProfile != null ? existingProfile.Status : "Yeni Profil (Henüz Kaydedilmedi)")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ADIMLAR VE İÇERİK SEKMELERİ -->
    <div class="row">
        <!-- SOL MENÜ: ADIMLAR LİSTESİ -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 20px;">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-list-ol text-primary me-2"></i>İnşaat Faz Adımları</h6>
                </div>
                <div class="list-group list-group-flush p-2" id="stepTabsList" role="tablist">
                    <a href="#pill_step0" id="tab_step0" data-bs-toggle="list" data-bs-target="#pill_step0" data-step="0" role="tab" aria-controls="pill_step0" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 active fw-bold py-3" onclick="switchStepTab(0, this)">
                        <i class="fas fa-lock text-danger me-2"></i> Adım 0: Statik & Taşıyıcılar
                        <span class="badge bg-white text-danger rounded-pill float-end fw-bold shadow-xs step-count-badge">20 Kalem</span>
                    </a>
                    <a href="#pill_step1" id="tab_step1" data-bs-toggle="list" data-bs-target="#pill_step1" data-step="1" role="tab" aria-controls="pill_step1" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 fw-bold py-3" onclick="switchStepTab(1, this)">
                        <i class="fas fa-map-marked-alt text-primary me-2"></i> @(step1?.StepName ?? "Adım 1: Saha Analizi")
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill float-end step-count-badge">@((step1?.Questions != null) ? step1.Questions.Count : 0) Soru</span>
                    </a>
                    @if (allSteps != null)
                    {
                        foreach (var s in allSteps.Where(x => x.StepOrder > 1).OrderBy(x => x.StepOrder))
                        {
                            string iconClass = s.StepOrder switch
                            {
                                2 => "fas fa-water text-info",
                                3 => "fas fa-cubes text-warning",
                                4 => "fas fa-couch text-success",
                                5 => "fas fa-home text-danger",
                                6 => "fas fa-door-open text-primary",
                                7 => "fas fa-bolt text-warning",
                                8 => "fas fa-walking text-info",
                                9 => "fas fa-gem text-secondary",
                                _ => "fas fa-layer-group text-primary"
                            };
                            <a href="#pill_step@(s.StepOrder)" id="tab_step@(s.StepOrder)" data-bs-toggle="list" data-bs-target="#pill_step@(s.StepOrder)" data-step="@(s.StepOrder)" role="tab" aria-controls="pill_step@(s.StepOrder)" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 fw-bold py-3" onclick="switchStepTab(@(s.StepOrder), this)">
                                <i class="@iconClass me-2"></i> @s.StepName
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill float-end step-count-badge">@((s.Questions != null) ? s.Questions.Count : 0) Soru</span>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ ALAN: ADIM İÇERİKLERİ -->
        <div class="col-lg-9">
            <div class="tab-content" id="wizardStepsTabContent">

                <!-- TAB 0: ADIM 0 (MECBURİ STATİK VE TAŞIYICILAR - 20 KALEM TABLO) -->
                <div class="tab-pane fade show active" id="pill_step0" role="tabpanel" aria-labelledby="tab_step0">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-white border-0 p-4 pb-0">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">
                                        <i class="fas fa-lock text-danger me-2"></i>Adım 0: Mecburi Statik ve Taşıyıcılar (Sabit Alan)
                                    </h5>
                                    <p class="text-muted small mb-0">Statik projeden (DXF) sistem tarafından mecburi olarak okunacak olan yapı bileşenleri ve ilgili iş branşları.</p>
                                </div>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill fw-bold">
                                    <i class="fas fa-ban me-1"></i> Değiştirilemez / DXF Sabiti
                                </span>
                            </div>

                            <!-- BİLGİLENDİRME KUTUSU -->
                            <div class="alert alert-danger bg-opacity-10 border-0 text-danger d-flex align-items-center mt-3 rounded-3 p-3">
                                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                                <div class="small">
                                    <strong>Şantiye Pazar Yeri & İhale Entegrasyonu:</strong> Bu 20 kalem için kullanıcıdan seçim istenmez; ölçüler doğrudan DXF mimari/statik katmanlarından ve akslarından hesaplanır. Her bir kalemin karşısındaki <strong>İş Branşı</strong>, projenin taşeron ve usta pazarında hangi meslek gruplarıyla ihaleye çıkacağını belirler.
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4 pt-2">
                            <div class="table-responsive rounded-3 border">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="text-muted small">
                                            <th style="width: 50px;" class="text-center">#</th>
                                            <th style="min-width: 250px;">Statik İmalat / Ölçüm Kalemi</th>
                                            <th style="min-width: 280px;">Mühendislik Açıklaması & Kuralı</th>
                                            <th style="min-width: 140px;">Veri Kaynağı</th>
                                            <th style="min-width: 160px;">İlgili İş Branşı (Pazar Yeri)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (step0 != null && step0.Questions != null && step0.Questions.Any())
                                        {
                                            foreach (var q in step0.Questions.OrderBy(x => x.QuestionOrder))
                                            {
                                                var profName = q.Profession != null ? q.Profession.Name : "Belirtilmedi";
                                                <tr>
                                                    <td class="text-center fw-bold text-muted small">@q.QuestionOrder</td>
                                                    <td>
                                                        <div class="fw-bold text-dark">
                                                            <i class="fas fa-cube text-primary me-2 opacity-50"></i>@q.Title
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="small text-muted">
                                                            @(string.IsNullOrWhiteSpace(q.Notes) ? "Statik projeden aks ve kesit bazında otomatik hesaplanır." : q.Notes)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-pill small">
                                                            <i class="fas fa-drafting-compass me-1"></i> DXF / Statik
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-bold small">
                                                            <i class="fas fa-hard-hat me-1"></i> @profName
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">Statik tanımlama soruları bulunamadı.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 1: ADIM 1 (KOT 0 ZEMİN, TEMEL VE İZOLASYON - SEÇİMLİ ALAN) -->
                <div class="tab-pane fade" id="pill_step1" role="tabpanel" aria-labelledby="tab_step1">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-header bg-white border-0 p-4 pb-0">
                            <h5 class="fw-bold text-dark mb-1">
                                <i class="fas fa-layer-group text-primary me-2"></i>@(step1?.StepName ?? "Adım 1: Saha Analizi")
                            </h5>
                            <p class="text-muted small mb-0">Zemin etüdü raporu, saha ve arazi koşulları analizlerini belirleyin.</p>
                        </div>

                        <div class="card-body p-4">
                            @if (step1 != null && step1.Questions != null)
                            {
                                foreach (var q in step1.Questions.OrderBy(x => x.QuestionOrder))
                                {
                                    <div class="card border mb-3 rounded-3 shadow-xs question-card" id="card_q_@q.Id" data-qid="@q.Id" data-qorder="@q.QuestionOrder">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label fw-bold text-dark fs-6 mb-0">
                                                    <i class="fas fa-question-circle text-primary me-2"></i>@q.Title
                                                </label>
                                                <span class="badge bg-light text-muted border small">
                                                    @(q.OptionSource != null && q.OptionSource.Contains("DXF") ? "Manuel / Haritacı & DXF" : (q.OptionSource != null && q.OptionSource.Contains("Sayısal") ? "Sayısal Giriş (Metre)" : (q.IsMultipleChoice ? "Çoklu Ekleme" : "Tekli Seçim")))
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(q.Notes))
                                            {
                                                <div class="small text-muted mb-2"><i class="fas fa-info-circle me-1 text-primary"></i> @q.Notes</div>
                                            }

                                            @if (q.OptionSource != null && q.OptionSource.Contains("DXF"))
                                            {
                                                <!-- HARİTACI APLİKASYON / DXF ÇEVRE POLİGONU (MANUEL GİRİŞ VEYA OTOMATİK DXF) -->
                                                double calcPerimeter = totalLand > 0 ? Math.Round(4 * Math.Sqrt(totalLand), 0) : 240;
                                                string existingDxfVal = "";
                                                if (existingProfile != null && existingProfile.Details != null)
                                                {
                                                    var d = existingProfile.Details.FirstOrDefault(x => x.SelectedItem.StartsWith(q.Title + ":"));
                                                    if (d != null)
                                                    {
                                                        var parts = d.SelectedItem.Split(':');
                                                        if (parts.Length > 1)
