                if(data && data.success && data.steps) {
                    cachedWizardWorkflowSteps = data.steps;
                    renderAllWizardWorkflowTables(data.steps, data.summary);
                }
            })
            .catch(err => console.error(err));

        var modal = new bootstrap.Modal(document.getElementById('wizardParametricModal'));
        modal.show();
