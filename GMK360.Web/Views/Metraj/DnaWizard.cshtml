                                                <td>
                                                    <div class="fw-bold text-dark">@s.PhaseName</div>
                                                    <div class="small text-muted"><i class="fas fa-tag me-1"></i>@s.StageCategory</div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fw-bold fs-6">
                                                        <i class="far fa-calendar-alt me-1"></i> @s.PlannedDateRange
                                                    </span>
                                                </td>
                                                <td class="text-center fw-bold">@s.DurationDays Gün</td>
                                                <td>
                                                    <div class="fw-bold text-dark small"><i class="fas fa-hard-hat text-primary me-1"></i>@s.ProfessionName</div>
                                                    <div class="small text-muted">@s.CrewComposition</div>
                                                </td>
                                                <td>
                                                    <div class="p-2 rounded bg-light border small">
                                                        <div class="text-danger fw-bold"><i class="fas fa-bell me-1"></i>T-@(s.DurationDays >= 5 ? 3 : 2) Ön Kontrol</div>
                                                        <div class="text-muted mt-1">@s.MaterialTitle tedariği & @s.ProfessionName ekibi teyidi</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-4 border">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Tek Tıkla Otonom Şantiye Ajandası Kurulumu</h6>
                                <small class="text-muted">Bu aşamaları ve T- hazırlık kontrollerini takviminize işler.</small>
                            </div>
                            <div>
                                <button type="button" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm" id="btnWizTriggerAgenda" onclick="triggerWizardWorkflowToAgenda()">
                                    <i class="fas fa-rocket me-2"></i> Bu Otonom Takvimi Şantiye Ajandama İşle
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                <small class="text-muted">GMK360 Otonom Şantiye & İhale Motoru</small>
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- ALT PROJE OLUŞTURMA & METRAJ MODELİ SEÇİM MODALI -->
<div class="modal fade" id="subProjectChoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-folder-plus me-2"></i>Alt İmalat Projesi Aç
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <input type="hidden" id="modalChoiceParentId" />
                <input type="hidden" id="modalChoiceAmenityId" />
                <input type="hidden" id="modalChoiceAmenityName" />

                <div class="mb-3">
                    <span class="text-muted small text-uppercase fw-bold">Seçilen Donatı / Alan:</span>
                    <h5 class="fw-bold text-dark mb-1" id="modalChoiceAmenityDisplay"></h5>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">İmalat & Metraj Modeli Seçimi:</label>
                    
                    <label class="card border p-3 rounded-3 mb-2 shadow-xs" style="cursor: pointer;">
                        <div class="d-flex align-items-start gap-2">
                            <input type="radio" name="wizardSubExecutionMode" value="DocumentProcurement" class="form-check-input mt-1" checked />
                            <div>
                                <div class="fw-bold text-dark"><i class="fas fa-file-contract text-secondary me-1"></i>Teklif & Dökümantasyon (RFQ) Paketi</div>
                                <small class="text-muted d-block mt-1">AutoCAD / DXF çizimi olmayan hazır donatı alımları ve taşeron ihaleleri içindir (Şartname, teklif toplama, sözleşme takibi).</small>
                            </div>
                        </div>
                    </label>

                    <label class="card border p-3 rounded-3 shadow-xs" style="cursor: pointer;">
                        <div class="d-flex align-items-start gap-2">
                            <input type="radio" name="wizardSubExecutionMode" value="DxfEngineering" class="form-check-input mt-1" />
                            <div>
                                <div class="fw-bold text-primary"><i class="fas fa-drafting-compass text-primary me-1"></i>Mühendislik & Metraj Projesi (DXF)</div>
                                <small class="text-muted d-block mt-1">Kendi AutoCAD/DXF çizimi bulunan; statik karkası, duvar ve mahal metrajları bağımsız hesaplanacak yapılar içindir.</small>
                            </div>
                        </div>
                    </label>
                </div>
            </div>
            <div class="modal-footer bg-white border-0 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-xs" onclick="confirmSubProjectCreation()">
                    <i class="fas fa-check-circle me-1"></i> Alt Projeyi Aç
                </button>
            </div>
        </div>
    </div>
</div>
