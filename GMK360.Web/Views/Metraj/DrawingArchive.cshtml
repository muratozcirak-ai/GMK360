@model GMK360.Web.Models.DrawingArchiveViewModel
@{
    ViewData["Title"] = "Kanat 1: Dijital Çizim Arşivi & İlk Kabul";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var projectId = Model.Project.Id;
    var primaryBlockId = Model.Blocks.FirstOrDefault(b => b.ParentBuildingId == null)?.Id ?? Model.Blocks.FirstOrDefault()?.Id ?? 0;
}

<div class="container-fluid px-0">
    <!-- ÜST BAŞLIK VE GEÇİŞ BUTONLARI -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary text-white px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">
                    <i class="bi bi-shield-check me-1"></i>KANAT 1 : İLK KABUL MASASI
                </span>
                <span class="badge bg-light text-muted border px-2 py-1 rounded-pill" style="font-size:0.75rem;">
                    Proje #@projectId : @Model.Project.Name
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-folder2-open text-primary me-2"></i>Dijital Çizim Arşivi & Çizim İlk Kabul
            </h2>
            <p class="text-muted small mb-0">
                Mimar ve mühendislerden gelen belediye ruhsat onaylı CAD / DXF / DWG / PDF setleri. Kat planlarını bloklara bağlayın, teknik şartname kontrolünü yapın.
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-md-0">
            <a href="/Metraj/ProjectDNA/@projectId" class="btn btn-outline-success rounded-pill px-3 shadow-sm fw-bold">
                <i class="fas fa-dna me-1 text-success"></i> Kanat 2: Proje DNA (Hesaplama) &rarr;
            </a>
            @if (primaryBlockId > 0)
            {
                <a href="/ConstructionProject/ManageBlock/@primaryBlockId" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                    <i class="bi bi-layers me-1 text-primary"></i> Yapı Yönetimi (Katlar) &rarr;
                </a>
            }
            <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#uploadDrawingModal">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Yeni Çizim / Pafta Yükle
            </button>
        </div>
    </div>

    <!-- MİMAR CAD / DXF ŞARTNAMESİ BANNER -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">
                            <i class="bi bi-star-fill me-1"></i>STANDART ŞARTNAME
                        </span>
                        <span class="text-white-50 small">AutoCAD (DWG/DXF) & PDF Proje Kabul Kuralları</span>
                    </div>
                    <h4 class="fw-bold mb-1">Mimar ve Mühendisler için CAD/DXF Teslim Şartnamesi</h4>
                    <p class="text-white-50 mb-0 small" style="line-height: 1.5;">
                        GMK360 hesaplama ve ihale motorunun mimari projeleri sorunsuz işletmesi için: <strong>1)</strong> Her katın WBLOCK ile tekil DXF çıkarılması, <strong>2)</strong> Zorunlu Mahal isimlerinin yazılması, <strong>3)</strong> Standart kapı/pencere çizimi esastır. Taşeron ve tedarikçilere kusursuz metraj ve şablon PDF'ler buradan üretilir.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-3 py-2 shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#sartnameModal">
                        <i class="bi bi-file-earmark-richtext-fill me-1"></i> Şartnameyi İncele & Yazdır
                    </button>
                    <button type="button" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm" onclick="copySartname()">
                        <i class="bi bi-whatsapp me-1"></i> Mimara İlet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ÖZET GÖSTERGELER (KPI CARDS) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-4 bg-primary bg-opacity-10 text-primary p-3 me-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Toplam Kat</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalFloorsCount Kat</h4>
                        <small class="text-muted">@Model.Blocks.Count Blok/Kule</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-4 bg-success bg-opacity-10 text-success p-3 me-3">
                            <i class="bi bi-file-earmark-check-fill fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Mimari Planlar</div>
                            <h4 class="fw-bold mb-0 text-success">@Model.FloorsWithPlanCount / @Model.TotalFloorsCount</h4>
                            <small class="text-muted">Kat Planı Yüklü</small>
                        </div>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PlanCompletionPercentage%;" aria-valuenow="@Model.PlanCompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-4 bg-warning bg-opacity-10 text-warning p-3 me-3">
                        <i class="bi bi-cone-striped fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Statik Paftalar</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.StructuralDrawings.Count Pafta</h4>
                        <small class="text-muted">Kalıp & Donatı Detayı</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-4 bg-info bg-opacity-10 text-info p-3 me-3">
                        <i class="bi bi-lightning-charge-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Mekanik & Elektrik</div>
                        <h4 class="fw-bold mb-0 text-dark">@(Model.MechanicalDrawings.Count + Model.ElectricalDrawings.Count) Pafta</h4>
                        <small class="text-muted">Tesisat & Projeler</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DİSİPLİN SEKMELERİ (TABS) -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom p-3">
            <ul class="nav nav-pills card-header-pills" id="drawingTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill fw-bold px-4" id="mimari-tab" data-bs-toggle="pill" data-bs-target="#mimari-pane" type="button" role="tab">
                        <i class="bi bi-house-door-fill me-2"></i>🏛️ Mimari Kat Planları & Matris
                        <span class="badge bg-primary ms-2">@Model.FloorsWithPlanCount / @Model.TotalFloorsCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill fw-bold px-4" id="statik-tab" data-bs-toggle="pill" data-bs-target="#statik-pane" type="button" role="tab">
                        <i class="bi bi-shield-shaded me-2"></i>🏗️ Statik Projeler
                        <span class="badge bg-secondary ms-2">@Model.StructuralDrawings.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill fw-bold px-4" id="mekanik-tab" data-bs-toggle="pill" data-bs-target="#mekanik-pane" type="button" role="tab">
                        <i class="bi bi-tools me-2"></i>🔧 Mekanik Tesisat
                        <span class="badge bg-secondary ms-2">@Model.MechanicalDrawings.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill fw-bold px-4" id="elektrik-tab" data-bs-toggle="pill" data-bs-target="#elektrik-pane" type="button" role="tab">
                        <i class="bi bi-lightning-fill me-2"></i>⚡ Elektrik & Zayıf Akım
                        <span class="badge bg-secondary ms-2">@Model.ElectricalDrawings.Count</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="drawingTabsContent">
                
                <!-- SEKME 1: MİMARİ KAT PLANLARI & MATRİS -->
                <div class="tab-pane fade show active" id="mimari-pane" role="tabpanel">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Akıllı Kat Planı Matrisi</h5>
                            <p class="text-muted small mb-0">Her katın mimari planı ilgili kata doğrudan bağlanır. Yapı Yönetimi ile %100 senkronizedir.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i>@Model.FloorsWithPlanCount Kat Tamam
                            </span>
                            @if (Model.FloorsMissingPlanCount > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.FloorsMissingPlanCount Kat Eksik
                                </span>
                            }
                        </div>
                    </div>

                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 18%;">Blok / Kule</th>
                                    <th style="width: 18%;">Kat Seviyesi & Adı</th>
                                    <th style="width: 16%;">Daire Sayısı & m²</th>
                                    <th style="width: 28%;">Kat Planı (CAD / DXF / PDF)</th>
                                    <th style="width: 20%;" class="text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.FloorMatrix != null && Model.FloorMatrix.Any())
                                {
                                    foreach (var item in Model.FloorMatrix)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi @(item.IsChildBuilding ? "bi-building" : "bi-houses") text-primary me-2 fs-5"></i>
                                                    <div>
                                                        <div class="fw-bold text-dark">@item.BlockName</div>
                                                        <small class="text-muted">@(item.IsChildBuilding ? "Bağlı Kule" : "Ana Blok / Baza")</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1 fw-bold">
                                                    @item.FloorName
                                                </span>
                                                <span class="text-muted small ms-1">(Kot/Seviye: @item.FloorLevel)</span>
                                            </td>
                                            <td>
                                                @if (item.UnitCount > 0)
                                                {
                                                    <div class="fw-bold text-dark">@item.UnitCount Daire / Birim</div>
                                                    <small class="text-muted">Net: @item.TotalNetM2.ToString("N0") m² | Brüt: @item.TotalGrossM2.ToString("N0") m²</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>Birim Tanımlanmamış</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.HasPlan)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success me-2 px-2 py-1 rounded-pill">
                                                            <i class="bi bi-file-earmark-check me-1"></i>Plan Mevcut
                                                        </span>
                                                        <a href="@item.PlanUrl" target="_blank" class="text-decoration-none fw-bold text-truncate" style="max-width: 180px;" title="@item.PlanFileName">
                                                            <i class="bi bi-file-earmark-arrow-down me-1"></i>@(string.IsNullOrEmpty(item.PlanFileName) ? "Planı İndir" : item.PlanFileName)
                                                        </a>
                                                    </div>
                                                    @if (item.PlanUploadDate.HasValue)
                                                    {
                                                        <small class="text-muted d-block mt-1">Yükleme: @item.PlanUploadDate.Value.ToString("dd.MM.yyyy HH:mm")</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                                        <i class="bi bi-exclamation-circle me-1"></i>Plan Bekleniyor
                                                    </span>
                                                    <small class="text-muted d-block mt-1">Mimar şartnamesine uygun DXF/PDF yükleyin.</small>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-1">
                                                    @if (item.HasPlan)
                                                    {
                                                        <a href="@item.PlanUrl" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-2" title="Görüntüle / İndir">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    }
                                                    <button type="button" class="btn btn-sm @(item.HasPlan ? "btn-outline-primary" : "btn-primary") rounded-pill px-2" 
                                                            onclick="openUploadModalForFloor(@item.BuildingId, @item.FloorLevel, '@item.BlockName', '@item.FloorName')" 
                                                            title="@(item.HasPlan ? "Planı Güncelle" : "Plan Yükle")">
                                                        <i class="bi bi-upload me-1"></i>@(item.HasPlan ? "Revize Et" : "Yükle")
                                                    </button>
                                                    <a href="/ConstructionProject/ManageBlock/@(item.ParentBuildingId ?? item.BuildingId)" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Yapı Yönetiminde Aç">
                                                        <i class="bi bi-arrow-right-short"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-2"></i>Henüz bu projede kayıtlı blok veya kat bulunmuyor.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- MİMARİ GENEL ÇİZİMLER (VAZİYET, KESİT, GÖRÜNÜŞ) -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-collection-fill text-primary me-2"></i>Mimari Genel Paftalar (Vaziyet, Kesit, Görünüş, Detay)</h6>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openUploadModalForDiscipline('Mimari')">
                                <i class="bi bi-plus-lg me-1"></i>Mimari Pafta Ekle
                            </button>
                        </div>

                        @if (Model.ArchitecturalDrawings != null && Model.ArchitecturalDrawings.Any())
                        {
                            <div class="table-responsive rounded-3 border">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Pafta Başlığı</th>
                                            <th>Dosya Adı</th>
                                            <th>Format</th>
                                            <th>Tarih</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in Model.ArchitecturalDrawings)
                                        {
                                            <tr>
                                                <td class="fw-bold">@doc.Title</td>
                                                <td><small class="text-muted">@doc.FileName</small></td>
                                                <td><span class="badge bg-light text-dark border">@doc.FileExtension?.ToUpperInvariant()</span></td>
                                                <td><small class="text-muted">@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                                <td class="text-end">
                                                    <a href="@doc.DocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                        <i class="bi bi-download"></i> İndir
                                                    </a>
                                                    <form asp-action="DeleteDrawing" method="post" class="d-inline" onsubmit="return confirm('Bu çizimi arşivden silmek istediğinize emin misiniz?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@doc.Id" />
                                                        <input type="hidden" name="projectId" value="@projectId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border rounded-3 p-3 text-muted small">
                                <i class="bi bi-info-circle me-1"></i>Henüz genel mimari pafta eklenmemiş. Yukarıdaki "Mimari Pafta Ekle" butonu ile vaziyet planı veya kesit paftalarını arşivleyebilirsiniz.
                            </div>
                        }
                    </div>
                </div>

                <!-- SEKME 2: STATİK PROJELER -->
                <div class="tab-pane fade" id="statik-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-cone-striped text-warning me-2"></i>Statik & Taşıyıcı Sistem Paftaları</h5>
                            <p class="text-muted small mb-0">Temel aplikasyon, kat kalıp planları, kolon düşey açılımları ve donatı detayları.</p>
                        </div>
                        <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm" onclick="openUploadModalForDiscipline('Statik')">
                            <i class="bi bi-plus-lg me-1"></i>Statik Pafta Yükle
                        </button>
                    </div>

                    @if (Model.StructuralDrawings != null && Model.StructuralDrawings.Any())
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Pafta Başlığı</th>
                                        <th>Dosya Adı</th>
                                        <th>Format</th>
                                        <th>Tarih</th>
                                        <th class="text-end">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.StructuralDrawings)
                                    {
                                        <tr>
                                            <td class="fw-bold">@doc.Title</td>
                                            <td><small class="text-muted">@doc.FileName</small></td>
                                            <td><span class="badge bg-light text-dark border">@doc.FileExtension?.ToUpperInvariant()</span></td>
                                            <td><small class="text-muted">@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                            <td class="text-end">
                                                <a href="@doc.DocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                    <i class="bi bi-download"></i> İndir
                                                </a>
                                                <form asp-action="DeleteDrawing" method="post" class="d-inline" onsubmit="return confirm('Bu çizimi silmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@doc.Id" />
                                                    <input type="hidden" name="projectId" value="@projectId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 border rounded-4 bg-light">
                            <i class="bi bi-cone-striped text-warning fs-1"></i>
                            <h5 class="fw-bold mt-2">Henüz Statik Pafta Yüklenmedi</h5>
                            <p class="text-muted small mb-3">Statik proje mühendisinden gelen kalıp ve donatı paftalarını buraya yükleyerek arşivi tamamlayın.</p>
                            <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm" onclick="openUploadModalForDiscipline('Statik')">
                                <i class="bi bi-upload me-1"></i>Statik Pafta Yükle
                            </button>
                        </div>
                    }
                </div>

                <!-- SEKME 3: MEKANİK TESİSAT -->
                <div class="tab-pane fade" id="mekanik-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-tools text-info me-2"></i>Mekanik & Tesisat Paftaları</h5>
                            <p class="text-muted small mb-0">Sıhhi tesisat (temiz/pis su), ısıtma, havalandırma, yangın sprinkler ve doğalgaz paftaları.</p>
                        </div>
                        <button type="button" class="btn btn-info text-white fw-bold rounded-pill px-3 shadow-sm" onclick="openUploadModalForDiscipline('Mekanik')">
                            <i class="bi bi-plus-lg me-1"></i>Mekanik Pafta Yükle
                        </button>
                    </div>

                    @if (Model.MechanicalDrawings != null && Model.MechanicalDrawings.Any())
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Pafta Başlığı</th>
                                        <th>Dosya Adı</th>
                                        <th>Format</th>
                                        <th>Tarih</th>
                                        <th class="text-end">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.MechanicalDrawings)
                                    {
                                        <tr>
                                            <td class="fw-bold">@doc.Title</td>
                                            <td><small class="text-muted">@doc.FileName</small></td>
                                            <td><span class="badge bg-light text-dark border">@doc.FileExtension?.ToUpperInvariant()</span></td>
                                            <td><small class="text-muted">@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                            <td class="text-end">
                                                <a href="@doc.DocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                    <i class="bi bi-download"></i> İndir
                                                </a>
                                                <form asp-action="DeleteDrawing" method="post" class="d-inline" onsubmit="return confirm('Bu çizimi silmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@doc.Id" />
                                                    <input type="hidden" name="projectId" value="@projectId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 border rounded-4 bg-light">
                            <i class="bi bi-tools text-info fs-1"></i>
                            <h5 class="fw-bold mt-2">Henüz Mekanik Pafta Yüklenmedi</h5>
                            <p class="text-muted small mb-3">Mekanik tesisat mühendisinden gelen sıhhi tesisat, kalorifer ve yangın paftalarını arşivleyin.</p>
                            <button type="button" class="btn btn-info text-white fw-bold rounded-pill px-4 shadow-sm" onclick="openUploadModalForDiscipline('Mekanik')">
                                <i class="bi bi-upload me-1"></i>Mekanik Pafta Yükle
                            </button>
                        </div>
                    }
                </div>

                <!-- SEKME 4: ELEKTRİK & ZAYIF AKIM -->
                <div class="tab-pane fade" id="elektrik-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-lightning-fill text-danger me-2"></i>Elektrik & Zayıf Akım Paftaları</h5>
                            <p class="text-muted small mb-0">Aydınlatma & priz, kuvvetli akım, yangın ihbar, interkom, topraklama ve paratoner paftaları.</p>
                        </div>
                        <button type="button" class="btn btn-danger fw-bold rounded-pill px-3 shadow-sm" onclick="openUploadModalForDiscipline('Elektrik')">
                            <i class="bi bi-plus-lg me-1"></i>Elektrik Pafta Yükle
                        </button>
                    </div>

                    @if (Model.ElectricalDrawings != null && Model.ElectricalDrawings.Any())
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Pafta Başlığı</th>
                                        <th>Dosya Adı</th>
                                        <th>Format</th>
                                        <th>Tarih</th>
                                        <th class="text-end">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.ElectricalDrawings)
                                    {
                                        <tr>
                                            <td class="fw-bold">@doc.Title</td>
                                            <td><small class="text-muted">@doc.FileName</small></td>
                                            <td><span class="badge bg-light text-dark border">@doc.FileExtension?.ToUpperInvariant()</span></td>
                                            <td><small class="text-muted">@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                            <td class="text-end">
                                                <a href="@doc.DocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                    <i class="bi bi-download"></i> İndir
                                                </a>
                                                <form asp-action="DeleteDrawing" method="post" class="d-inline" onsubmit="return confirm('Bu çizimi silmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@doc.Id" />
                                                    <input type="hidden" name="projectId" value="@projectId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 border rounded-4 bg-light">
                            <i class="bi bi-lightning-charge-fill text-danger fs-1"></i>
                            <h5 class="fw-bold mt-2">Henüz Elektrik Paftası Yüklenmedi</h5>
                            <p class="text-muted small mb-3">Elektrik mühendisinden gelen aydınlatma, kuvvetli akım ve zayıf akım paftalarını arşivleyin.</p>
                            <button type="button" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm" onclick="openUploadModalForDiscipline('Elektrik')">
                                <i class="bi bi-upload me-1"></i>Elektrik Pafta Yükle
                            </button>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: ÇİZİM / PAFTA YÜKLEME MODALI -->
<!-- ========================================== -->
<div class="modal fade" id="uploadDrawingModal" tabindex="-1" aria-labelledby="uploadDrawingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0 py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="uploadDrawingModalLabel">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>Dijital Çizim & Pafta İlk Kabul
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="UploadDrawing" asp-controller="Metraj" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@projectId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Proje Disiplini</label>
                        <select class="form-select" name="category" id="uploadDisciplineSelect" onchange="onDisciplineChanged()">
                            <option value="Mimari">🏛️ Mimari Proje & Kat Planı</option>
                            <option value="Statik">🏗️ Statik & Taşıyıcı Sistem</option>
                            <option value="Mekanik">🔧 Mekanik & Tesisat</option>
                            <option value="Elektrik">⚡ Elektrik & Zayıf Akım</option>
                        </select>
                    </div>

                    <div id="floorBindingSection" class="border rounded-3 p-3 bg-light mb-3">
                        <div class="fw-bold small text-primary mb-2">
                            <i class="bi bi-layers-fill me-1"></i>Mimari Kat Planı Bağlantısı (Opsiyonel)
                        </div>
                        <div class="row g-2">
                            <div class="col-7">
                                <label class="form-label small text-muted">Blok / Kule</label>
                                <select class="form-select form-select-sm" name="buildingId" id="uploadBuildingId">
                                    <option value="">-- Blok Seçiniz --</option>
                                    @foreach (var b in Model.Blocks)
                                    {
                                        <option value="@b.Id">@b.BlockName (@(b.ParentBuildingId == null ? "Ana Baza" : "Kule"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-5">
                                <label class="form-label small text-muted">Kat Seviyesi</label>
                                <input type="number" class="form-control form-control-sm" name="floorLevel" id="uploadFloorLevel" placeholder="Örn: 1" />
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2" style="font-size:0.75rem;">
                            Blok ve kat seçerseniz bu plan otomatik olarak Yapı Yönetimi'ndeki kata da bağlanır.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Pafta Başlığı / Tanımı</label>
                        <input type="text" class="form-control" name="title" id="uploadTitleInput" placeholder="Örn: D Blok 1. Normal Kat Planı" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Revizyon / Durum</label>
                        <input type="text" class="form-control" name="revision" placeholder="Örn: Rev.0 (Ruhsat Onaylı)" value="Rev.0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Çizim Dosyası</label>
                        <input type="file" class="form-control form-control-lg" name="file" accept=".dxf,.dwg,.pdf,.zip,.rar,.png,.jpg,.jpeg" required />
                        <small class="text-muted d-block mt-1">Desteklenen: .dxf, .dwg, .pdf, .zip, .png, .jpg (Maks. 100MB)</small>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Arşive Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: MİMAR CAD / DXF TESLİM ŞARTNAMESİ -->
<!-- ========================================== -->
<div class="modal fade" id="sartnameModal" tabindex="-1" aria-labelledby="sartnameModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-dark text-white border-0 py-3 rounded-top-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">GMK360 ŞARTNAME</span>
                    <h5 class="modal-title fw-bold mb-0" id="sartnameModalLabel">
                        <i class="bi bi-file-earmark-ruled-fill me-2 text-warning"></i>Mimari CAD / DXF Çizim Teslim Şartnamesi
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4" id="sartnamePrintableArea">
                <div class="alert alert-info border-0 rounded-3 p-3 mb-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill fs-5 text-primary mt-1"></i>
                        <div>
                            <strong>Mimari Ofisler ve Tasarımcılar için Bilgilendirme:</strong>
                            <p class="mb-0 small">Bu standartlar belediye onaylı mimari projenizin doğrudan ERP ihale motoruna aktarılmasını sağlar. Mimarların çizim alışkanlıklarını değiştirmeden sadece 10 saniyelik <code>WBLOCK</code> ve metin layer kurallarına uyması yeterlidir.</p>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 p-3">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-1-circle-fill me-1"></i> Kat Bazında Tekil Çizim (WBLOCK Kuralı)</h6>
                            <p class="small text-muted mb-2">Tüm katların yan yana durduğu paftalar yerine, her kat ayrı bir DXF/DWG olarak kaydedilmelidir.</p>
                            <div class="bg-light p-2 rounded small font-monospace">
                                AutoCAD İpucu (10 Saniye):<br/>
                                1. Komut satırına <code>WBLOCK</code> yazın.<br/>
                                2. Katı seçin (Select Objects).<br/>
                                3. Dosya adını girip DXF olarak kaydedin.<br/>
                                Örn: <code>A_Blok_Zemin_Kat.dxf</code>, <code>A_Blok_1_Normal_Kat.dxf</code>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 p-3">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-2-circle-fill me-1"></i> Zorunlu Oda / Mahal İsimlendirmeleri</h6>
                            <p class="small text-muted mb-2">Her bağımsız bölümün içindeki alanlar tekil Türkçe büyük harf metin (TEXT / MTEXT) olarak yazılmalıdır:</p>
                            <div class="row g-1 small">
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>SALON</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>MUTFAK</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>YATAK ODASI</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>EBEVEYN BANYO</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>GENEL BANYO / WC</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>ANTRE / KORİDOR</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>BALKON 1</code></span></div>
                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>GİYİNME ODASI</code></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 p-3">
                            <h6 class="fw-bold text-warning mb-2"><i class="bi bi-3-circle-fill me-1"></i> Standart Kapı ve Pencere Ölçüleri</h6>
                            <p class="small text-muted mb-2">Tedarikçi ve taşeron masasında net sipariş adetleri için standart kasalar:</p>
                            <ul class="small text-muted mb-0 ps-3">
                                <li><strong>Daire Dış Giriş Kapısı:</strong> 100 &times; 210 cm Çelik Kapı</li>
                                <li><strong>Oda ve Mutfak Kapıları:</strong> 90 &times; 210 cm İç Oda Kapısı</li>
                                <li><strong>Banyo ve WC Kapıları:</strong> 75 &times; 210 cm Islak Hacim Kapısı</li>
                                <li><strong>Yangın Merdiveni Kapısı:</strong> 90 &times; 210 cm Panik Barlı Yangın Kapısı</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 p-3">
                            <h6 class="fw-bold text-danger mb-2"><i class="bi bi-4-circle-fill me-1"></i> Merdiven & Ortak Alan Ayrımı</h6>
                            <p class="small text-muted mb-2">Taşeron ihalesi için basamak, rıht ve sahanlık ayrımı:</p>
                            <ul class="small text-muted mb-0 ps-3">
                                <li>Merdiven basamakları <code>MERDIVEN_BASAMAK</code> layerında polyline olmalı.</li>
                                <li>Korkuluk ve küpeşte çizgisi net belirtilmeli (Metretül hesaplanır).</li>
                                <li>Asansör kovası ve şaft boşlukları net kapatılmalı.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold mb-2">Örnek AutoCAD Layer Tablosu</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered bg-white mb-0 small">
                            <thead class="table-light">
                                <tr><th>Layer Adı</th><th>Eleman</th><th>Tip</th><th>Açıklama</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><code>DUVAR_DIS</code></td><td>Dış Cephe Duvarları</td><td>Polyline / Line</td><td>20'lik veya 25'lik bims/tuğla duvarlar</td></tr>
                                <tr><td><code>DUVAR_IC</code></td><td>İç Bölme Duvarları</td><td>Polyline / Line</td><td>10'luk veya 15'lik ara bölme duvarlar</td></tr>
                                <tr><td><code>KAPI</code></td><td>Tüm Kapı Blokları</td><td>Block / Arc</td><td>Genişlik ve açılış yönü içeren kapılar</td></tr>
                                <tr><td><code>PENCERE</code></td><td>Pencereler ve Fransız Balkonlar</td><td>Polyline / Line</td><td>Genişlik ve parapet yüksekliği</td></tr>
                                <tr><td><code>MAHAL_ISIM</code></td><td>Oda / Alan İsimleri</td><td>Text / MText</td><td>SALON, MUTFAK, BANYO metinleri</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="printSartname()">
                    <i class="bi bi-printer me-1"></i> PDF Olarak Yazdır
                </button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" onclick="copySartname()">
                    <i class="bi bi-clipboard-check me-1"></i> WhatsApp / Metin Kopyala
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openUploadModalForFloor(buildingId, floorLevel, blockName, floorName) {
        document.getElementById('uploadDisciplineSelect').value = 'Mimari';
        document.getElementById('uploadBuildingId').value = buildingId;
        document.getElementById('uploadFloorLevel').value = floorLevel;
        document.getElementById('uploadTitleInput').value = blockName + ' - ' + floorName + ' Kat Planı';
        document.getElementById('floorBindingSection').style.display = 'block';

        var modal = new bootstrap.Modal(document.getElementById('uploadDrawingModal'));
        modal.show();
    }

    function openUploadModalForDiscipline(discipline) {
        document.getElementById('uploadDisciplineSelect').value = discipline;
        document.getElementById('uploadBuildingId').value = '';
        document.getElementById('uploadFloorLevel').value = '';
        document.getElementById('uploadTitleInput').value = discipline + ' Proje Paftası';
        onDisciplineChanged();

        var modal = new bootstrap.Modal(document.getElementById('uploadDrawingModal'));
        modal.show();
    }

    function onDisciplineChanged() {
        var disc = document.getElementById('uploadDisciplineSelect').value;
        var floorSection = document.getElementById('floorBindingSection');
        if (disc === 'Mimari') {
            floorSection.style.display = 'block';
        } else {
            floorSection.style.display = 'none';
        }
    }

    function printSartname() {
        var printContents = document.getElementById('sartnamePrintableArea').innerHTML;
        var originalContents = document.body.innerHTML;
        var printWindow = window.open('', '', 'height=800,width=900');
        printWindow.document.write('<html><head><title>GMK360 CAD/DXF Çizim Teslim Şartnamesi</title>');
        printWindow.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">');
        printWindow.document.write('</head><body class="p-4">');
        printWindow.document.write('<h3 class="fw-bold mb-3">GMK360 - MİMARİ CAD / DXF PROJE TESLİM ŞARTNAMESİ</h3>');
        printWindow.document.write(printContents);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        setTimeout(function() {
            printWindow.print();
            printWindow.close();
        }, 500);
    }

    function copySartname() {
        var text = "GMK360 PROJE ÇİZİM TESLİM ŞARTNAMESİ\\n\\n" +
                   "Sayın Mimar / Mühendisimiz,\\n" +
                   "Projemizin GMK360 Dijital Arşivine ve Metraj-İhale sistemine kabul edilebilmesi için çizimlerin aşağıdaki kurallara uygun teslim edilmesi rica olunur:\\n\\n" +
                   "1. KAT BAZINDA ÇIKTI (WBLOCK): Tüm katlar tek dosyada değil, her kat tekil DXF olarak (WBLOCK ile) kaydedilmelidir (Örn: A_Blok_Zemin_Kat.dxf).\\n" +
                   "2. ODA İSİMLERİ: Her mahalin içine büyük harfle tekil metin olarak ismi yazılmalıdır (SALON, MUTFAK, YATAK ODASI, EBEVEYN BANYO, GENEL BANYO, ANTRE, BALKON vb.).\\n" +
                   "3. STANDART KAPILAR: Giriş 100x210, Odalar 90x210, Banyo 75x210, Yangın 90x210 panik barlı.\\n" +
                   "4. LAYER DİSİPLİNİ: DUVAR_DIS, DUVAR_IC, KAPI, PENCERE, MAHAL_ISIM standart katmanları kullanılmalıdır.\\n\\n" +
                   "Desteğiniz için teşekkür eder, iyi çalışmalar dileriz.\\nGMK360 Proje Yönetim Merkezi";
        navigator.clipboard.writeText(text).then(function() {
            alert("Mimar Teslim Şartnamesi panoya kopyalandı! WhatsApp veya e-posta ile mimarınıza doğrudan iletebilirsiniz.");
        });
    }
</script>
