@model GMK360.Web.Models.DrawingArchiveViewModel

@{

    ViewData["Title"] = "Kanat 1: Dijital Çizim Arşivi & İlk Kabul";

    Layout = "~/Views/Shared/_ProjectLayout.cshtml";

    var projectId = Model.Project.Id;

    var primaryBlockId = Model.Blocks.FirstOrDefault(b => b.ParentBuildingId == null)?.Id ?? Model.Blocks.FirstOrDefault()?.Id ?? 0;

}

<div class="container-fluid px-0">

    <!-- ÜST BAŞLIK VE GEÇİŞ BUTONLARI -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <span class="badge bg-primary text-white px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">

                    <i class="bi bi-shield-check me-1"></i>KANAT 1 : İLK KABUL MASASI

                </span>

                <span class="badge bg-light text-muted border px-2 py-1 rounded-pill" style="font-size:0.75rem;">

                    Proje #@projectId : @Model.Project.Name

                </span>

            </div>

            <h2 class="fw-bold text-dark mb-0">

                <i class="bi bi-folder2-open text-primary me-2"></i>Dijital Çizim Arşivi & Çizim İlk Kabul

            </h2>

            <p class="text-muted small mb-0">

                Mimar ve mühendislerden gelen belediye ruhsat onaylı CAD / DXF / DWG / PDF setleri. Kat planlarını bloklara bağlayın, teknik şartname kontrolünü yapın.

            </p>

        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-md-0">

            <a href="/Metraj/ProjectDNA/@projectId" class="btn btn-outline-success rounded-pill px-3 shadow-sm fw-bold">

                <i class="fas fa-dna me-1 text-success"></i> Kanat 2: Proje DNA (Hesaplama) &rarr;

            </a>

            @if (primaryBlockId > 0)

            {

                <a href="/ConstructionProject/ManageBlock/@primaryBlockId" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">

                    <i class="bi bi-layers me-1 text-primary"></i> Yapı Yönetimi (Katlar) &rarr;

                </a>

            }

            <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#uploadDrawingModal">

                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Yeni Çizim / Pafta Yükle

            </button>

        </div>

    </div>

    @{
        var allDrawings = Model.AllDrawings ?? new List<GMK360.Core.Entities.DocumentArchive>();
        var pendingDrawings = allDrawings
            .Where(d => (d.FileExtension?.ToLowerInvariant() == ".dwg" || d.FileExtension?.ToLowerInvariant() == ".dxf")
                     && d.Status != "Okundu")
            .OrderByDescending(d => d.UploadDate)
            .ToList();

        var readDrawings = Model.ReadDrawings ?? Model.AllDrawings
            .Where(d => d.Status == "Okundu")
            .OrderByDescending(d => d.UploadDate)
            .ToList();

        var cadAnalyses = Model.CadAnalysisResults ?? new List<GMK360.Web.Models.CadAnalysisSummaryDto>();
        bool hasReadAny = Model.HasReadDrawings || readDrawings.Any();
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div class="fw-semibold" style="font-size: 0.88rem;">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div class="fw-semibold" style="font-size: 0.88rem;">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <!-- ADAY PROJEDEN GELEN ÖN DNA (STATİK YÜK & MİMARİ KABULLER) ÖZET ŞERİDİ -->
    <div class="card border-0 shadow-sm rounded-4 mb-3 border-start border-4 border-info" style="background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);">
        <div class="card-body p-2.5 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-info text-dark fw-bold rounded-pill px-2.5 py-1" style="font-size: 0.73rem;">
                    <i class="fas fa-dna me-1"></i>ADAY PROJE ÖN DNA KARARLARI
                </span>
                <span class="badge bg-white text-dark border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    <b>Dış Duvar:</b> @(string.IsNullOrWhiteSpace(Model.Project.OuterWallType) ? "Ytong / Gazbeton" : Model.Project.OuterWallType.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    <b>Cephe Yalıtımı:</b> @(string.IsNullOrWhiteSpace(Model.Project.FacadeInsulation) ? "Dıştan Mantolama" : Model.Project.FacadeInsulation.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    <b>Çatı:</b> @(string.IsNullOrWhiteSpace(Model.Project.RoofMaterial) ? "Düz Teras Çatı" : Model.Project.RoofMaterial.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    <b>İç Bölme:</b> @(string.IsNullOrWhiteSpace(Model.Project.InnerWallType) ? "Ytong / Gazbeton" : Model.Project.InnerWallType.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    <b>Isıtma/Tesisat:</b> @(string.IsNullOrWhiteSpace(Model.Project.PlumbingType) ? "Yerden Isıtma" : Model.Project.PlumbingType.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                    <b>Temel Yalıtımı:</b> @(string.IsNullOrWhiteSpace(Model.Project.FoundationInsulation) ? "Membran + XPS" : Model.Project.FoundationInsulation.Replace("_", " "))
                </span>
            </div>
            <a href="/ConstructionProject/Proposal/@projectId" class="btn btn-sm btn-outline-info text-dark fw-bold rounded-pill px-2.5 py-0.5" style="font-size: 0.73rem;">
                <i class="bi bi-pencil-square me-1"></i>Ön DNA'yı Güncelle
            </a>
        </div>
    </div>

    <!-- HIZLI GÖRÜNÜM & AKORDEON KONTROL BARI -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 bg-white border rounded-4 px-3 py-2 mb-3 shadow-2xs">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-dark text-white rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                <i class="bi bi-sliders me-1"></i>Sayfa Bölümleri (Aç / Kapat):
            </span>
            <button type="button" class="btn btn-xs btn-outline-warning text-dark border rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.74rem;" onclick="togglePendingDrawings();">
                <i class="bi bi-1-circle-fill text-warning me-1"></i>1. DWG Yükle &amp; Oku (@allDrawings.Count)
            </button>
            @if (cadAnalyses.Any())
            {
                <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.74rem;" onclick="toggleCadReportSection();">
                    <i class="bi bi-2-circle-fill text-success me-1"></i>2. CAD Raporları (@cadAnalyses.Count Pafta)
                </button>
            }
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.74rem;" onclick="toggleMatrixCard();">
                <i class="bi bi-3-circle-fill text-primary me-1"></i>3. Malzeme Matrisi
            </button>
            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.74rem;" onclick="toggleCollapseElement('eskilerCollapse', 'eskilerChevron', 'eskilerChevronText');">
                <i class="bi bi-4-circle-fill text-secondary me-1"></i>4. Kat Planı &amp; Blok Arşivi
            </button>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-xs btn-light border rounded-pill px-2.5 py-1 text-muted fw-semibold" style="font-size: 0.72rem;" onclick="collapseAllPageSections(false);">
                <i class="bi bi-arrows-expand me-1"></i>Tümünü Aç
            </button>
            <button type="button" class="btn btn-xs btn-light border rounded-pill px-2.5 py-1 text-muted fw-semibold" style="font-size: 0.72rem;" onclick="collapseAllPageSections(true);">
                <i class="bi bi-arrows-collapse me-1"></i>Tümünü Daralt
            </button>
        </div>
    </div>

    <!-- ================================================================================= -->
    <!-- 1. ADIM: DWG / DXF YÜKLEME, OKUMA BEKLEYENLER VE SIFIRLAMA MASASI -->
    <!-- ================================================================================= -->
    <div class="card border rounded-4 shadow-sm mb-3" style="border-top: 4px solid #f59e0b !important;">
        <div class="card-header bg-white py-2.5 px-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="cursor: pointer;" onclick="if (!event.target.closest('button, input, select, a, form')) togglePendingDrawings();">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                    <i class="bi bi-1-circle-fill me-1"></i>1. ADIM: DWG / DXF MASASI
                </span>
                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.92rem;">Çizim Yükle &amp; Okuma Motorunu Çalıştır</h6>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">
                    @pendingDrawings.Count Okuma Bekliyor
                </span>
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">
                    @readDrawings.Count Okundu
                </span>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Çoklu DWG / DXF Yükleme Formu -->
                <form asp-action="UploadBatchDrawings" asp-controller="Metraj" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-1 m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@projectId" />
                    <select name="discipline" class="form-select form-select-sm py-1 px-2 rounded-pill border-secondary-subtle fw-semibold" style="width: 110px; font-size: 0.74rem;" title="Yüklenecek çizimlerin disiplini">
                        <option value="Mimari">📐 Mimari</option>
                        <option value="Statik">🏗️ Statik</option>
                        <option value="Mekanik">🔧 Mekanik</option>
                        <option value="Elektrik">⚡ Elektrik</option>
                    </select>
                    <div class="input-group input-group-sm" style="max-width: 240px;">
                        <input type="file" class="form-control form-control-sm py-1" name="drawingFiles" multiple accept=".dwg,.dxf,.pdf" required style="font-size: 0.74rem;" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1" style="font-size: 0.76rem; white-space: nowrap;">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>1. Masaya Al (Yükle)</span>
                    </button>
                </form>

                <!-- Hızlı Test İçin Gerçek Örnek DXF Üretici -->
                <form asp-action="CreateSampleDxfDrawing" asp-controller="Metraj" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@projectId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.74rem; white-space: nowrap;" title="Yanınızda DWG/DXF yoksa test amaçlı gerçek katman ve oda verileri içeren örnek bir DXF dosyası üretir">
                        <i class="bi bi-magic text-primary"></i>
                        <span>Örnek DXF Ekle</span>
                    </button>
                </form>

                @if (pendingDrawings.Any())
                {
                    <!-- Seçilenleri / Tümünü Okut Formu -->
                    <form asp-action="ReadBatchDwgDrawings" asp-controller="Metraj" method="post" id="batchReadDwgForm" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@projectId" />
                        <div id="batchSelectedInputsContainer"></div>
                        <button type="button" onclick="submitBatchReadDwg();" class="btn btn-success btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.76rem; white-space: nowrap;">
                            <i class="bi bi-cpu-fill"></i>
                            <span>2. Seçilenleri / Tümünü Okut (@pendingDrawings.Count)</span>
                        </button>
                    </form>
                }

                @if (allDrawings.Any())
                {
                    <!-- Okuma Verilerini Sıfırla -->
                    <form asp-action="ResetProjectDwgReads" asp-controller="Metraj" method="post" class="m-0" onsubmit="return confirm('Okuma verileri ve malzeme matrisi sıfırlanacak, çizimler tekrar Okuma Bekliyor durumuna alınacak. Onaylıyor musunuz?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@projectId" />
                        <input type="hidden" name="deleteFiles" value="false" />
                        <button type="submit" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.74rem; white-space: nowrap;" title="Dosyaları silmeden sadece okuma verilerini ve malzeme tablosunu sıfırlar">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>🧹 Okumayı Sıfırla</span>
                        </button>
                    </form>

                    <!-- Tüm Dosyaları ve Okumayı Temizle -->
                    <form asp-action="ResetProjectDwgReads" asp-controller="Metraj" method="post" class="m-0" onsubmit="return confirm('Yüklenen tüm çizim dosyaları ve okuma verileri tamamen silinecek. Onaylıyor musunuz?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@projectId" />
                        <input type="hidden" name="deleteFiles" value="true" />
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.74rem; white-space: nowrap;" title="Yüklenen tüm çizimleri ve okuma verilerini tamamen temizler">
                            <i class="bi bi-trash3"></i>
                            <span>🗑️ Tümünü Temizle</span>
                        </button>
                    </form>
                }

                <button class="btn btn-xs btn-light border rounded-pill px-2.5 py-1 text-secondary fw-semibold d-inline-flex align-items-center gap-1" type="button" onclick="togglePendingDrawings();" style="font-size: 0.74rem;">
                    <i class="bi bi-chevron-up text-primary" id="pendingChevron"></i>
                    <span id="pendingToggleText">Kapat</span>
                </button>
            </div>
        </div>

        <div class="card-body p-0 collapse show" id="pendingDrawingsContent" style="display: block;">
            @if (pendingDrawings.Any() || readDrawings.Any())
            {
                <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.80rem;">
                        <thead class="table-light text-muted sticky-top" style="z-index: 2;">
                            <tr>
                                <th style="width: 36px;" class="text-center">
                                    <input type="checkbox" class="form-check-input" id="checkAllDwg" checked onchange="document.querySelectorAll('.dwg-select-chk').forEach(c => c.checked = this.checked);" />
                                </th>
                                <th>DWG / DXF Çizim Dosyası</th>
                                <th style="width: 110px;">Disiplin</th>
                                <th style="width: 80px;">Format</th>
                                <th style="width: 125px;">Yükleme Tarihi</th>
                                <th style="width: 160px;">Okuma Durumu</th>
                                <th style="width: 210px;" class="text-end pe-3">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in pendingDrawings.Concat(readDrawings))
                            {
                                var isDwg = doc.FileExtension?.ToLowerInvariant() == ".dwg";
                                var isRead = doc.Status == "Okundu";
                                <tr class="@(isRead ? "table-success bg-opacity-10" : "")">
                                    <td class="text-center">
                                        @if (!isRead)
                                        {
                                            <input type="checkbox" class="form-check-input dwg-select-chk" value="@doc.Id" checked />
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-1.5 rounded-2 text-white fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 28px; font-size: 0.68rem; background-color: @(isDwg ? "#0d6efd" : "#6f42c1");">
                                                @(isDwg ? "DWG" : "DXF")
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block" style="line-height: 1.15;">@doc.Title</span>
                                                <small class="text-muted" style="font-size: 0.68rem;">@doc.FileName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">
                                            @(string.IsNullOrWhiteSpace(doc.Category) ? "Mimari" : doc.Category)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border" style="font-size: 0.68rem;">@doc.FileExtension?.ToUpperInvariant()</span>
                                    </td>
                                    <td>
                                        <small class="text-muted" style="font-size: 0.72rem;">@doc.UploadDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (isRead)
                                        {
                                            <span class="badge bg-success text-white px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">
                                                <i class="bi bi-check2-circle me-1"></i>Okundu &amp; İşlendi
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">
                                                <i class="bi bi-clock me-1"></i>Okuma Bekliyor
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end gap-1">
                                            <form asp-action="ReadDwgDrawing" asp-controller="Metraj" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="projectId" value="@projectId" />
                                                <button type="submit" class="btn btn-xs @(isRead ? "btn-outline-success" : "btn-success") rounded-pill px-2.5 py-0.5 fw-bold shadow-xs d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                                    <i class="bi bi-lightning-charge-fill"></i>
                                                    <span>@(isRead ? "Tekrar Oku" : "⚡ DWG Oku")</span>
                                                </button>
                                            </form>
                                            <a href="@doc.DocumentUrl" download class="btn btn-xs btn-light border rounded-pill px-2 py-0.5 text-muted" title="Dosyayı İndir">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <form asp-action="DeleteDrawing" asp-controller="Metraj" method="post" class="d-inline" onsubmit="return confirm('Bu çizim dosyasını silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="projectId" value="@projectId" />
                                                <button type="submit" class="btn btn-xs btn-light border rounded-pill px-2 py-0.5 text-danger" title="Sil">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3 text-center text-muted bg-light bg-opacity-50">
                    <i class="bi bi-cloud-arrow-up fs-3 text-primary d-block mb-1"></i>
                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.88rem;">Henüz Bu Projeye Yüklenmiş Bir DWG veya DXF Çizimi Yok</h6>
                    <p class="small text-muted mb-0" style="font-size: 0.78rem;">
                        Sağ üstteki <strong>"Dosyaları Seç &rarr; 1. Masaya Al (Yükle)"</strong> kutusundan bilgisayarınızdaki <code>.dwg</code> veya <code>.dxf</code> projelerini yükleyin (veya hızlı deneme için <strong>"Örnek DXF Ekle"</strong> butonuna basın), ardından <strong>"⚡ DWG Oku"</strong> diyerek metrajı çıkartın.
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- ================================================================================= -->
    <!-- 2. ADIM: OKUNAN DWG / DXF MÜHENDİSLİK ANALİZ RAPORU (KOMPAKT AKORDEON YAPI) -->
    <!-- ================================================================================= -->
    @if (cadAnalyses.Any())
    {
        var totalCadLayers = cadAnalyses.Sum(c => c.LayerCount);
        var totalCadEntities = cadAnalyses.Sum(c => c.TotalEntities);
        var maxFloorM2 = cadAnalyses.Max(c => c.DetectedFloorAreaM2);
        var totalRoomsCount = cadAnalyses.Sum(c => c.DetectedRooms.Count);

        <div class="card border rounded-4 shadow-sm mb-3" style="border-top: 4px solid #198754 !important; background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);">
            <div class="card-header bg-transparent py-2.5 px-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="cursor: pointer;" onclick="if (!event.target.closest('button')) toggleCadReportSection();">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-success text-white px-2.5 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                        <i class="bi bi-2-circle-fill me-1"></i>2. ADIM: CANLI CAD OKUMA RAPORU
                    </span>
                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.92rem;">Pafta Röntgeni (@cadAnalyses.Count Pafta)</h6>
                    <span class="badge bg-white text-dark border rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">
                        <strong>@totalCadLayers</strong> Katman
                    </span>
                    <span class="badge bg-white text-dark border rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">
                        <strong>@totalCadEntities.ToString("N0")</strong> CAD Varlığı
                    </span>
                    <span class="badge bg-white text-danger border rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">
                        <strong>@maxFloorM2.ToString("N1") m²</strong> Kat Alanı
                    </span>
                </div>
                <div class="d-flex align-items-center gap-1.5">
                    <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;" onclick="toggleAllCadItems(true);" title="Tüm paftaların 3 kutulu detay röntgenini açar">
                        <i class="bi bi-arrows-expand me-1"></i>Tüm Paftaları Aç
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;" onclick="toggleAllCadItems(false);" title="Tüm paftaları tek satıra daraltır">
                        <i class="bi bi-arrows-collapse me-1"></i>Daralt
                    </button>
                    <button type="button" class="btn btn-xs btn-light border rounded-pill px-2.5 py-1 text-secondary fw-semibold d-inline-flex align-items-center gap-1" onclick="toggleCadReportSection();" style="font-size: 0.74rem;">
                        <i class="bi bi-chevron-up text-primary" id="cadReportSectionChevron"></i>
                        <span id="cadReportSectionText">Kapat</span>
                    </button>
                </div>
            </div>

            <div class="card-body p-2.5 collapse show" id="cadReportSectionContent" style="display: block;">
                @{ int cadIdx = 0; }
                @foreach (var cad in cadAnalyses)
                {
                    var isFirstCad = (cadIdx == 0);
                    var cadCollapseId = $"cadItemCollapse_{cad.DocumentId}_{cadIdx}";
                    var cadChevronId = $"cadItemChevron_{cad.DocumentId}_{cadIdx}";
                    cadIdx++;

                    <div class="bg-white border rounded-3 mb-2 shadow-2xs overflow-hidden">
                        <!-- TEK SATIRLIK AKORDEON PAFTA BAŞLIĞI (TIKLAYINCA DETAY AÇILIR/KAPANIR) -->
                        <div class="px-3 py-2 d-flex justify-content-between align-items-center flex-wrap gap-2 bg-light bg-opacity-50" style="cursor: pointer;" onclick="toggleCadItemDetail('@cadCollapseId', '@cadChevronId');">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <i class="bi @(isFirstCad ? "bi-chevron-down text-success" : "bi-chevron-right text-muted")" id="@cadChevronId"></i>
                                <span class="badge bg-primary text-white rounded-pill px-2 py-0.5" style="font-size: 0.70rem;">@cad.Discipline</span>
                                <strong class="text-dark" style="font-size: 0.84rem;">@cad.Title</strong>
                                <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.68rem;">@cad.CadVersion</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap" style="font-size: 0.74rem;">
                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-2 py-0.5">
                                    @cad.LayerCount Katman | @cad.TotalEntities.ToString("N0") Varlık
                                </span>
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-2 py-0.5">
                                    @cad.DoorCount Kapı | @cad.WindowCount Pencere | @cad.ColumnCount Kolon
                                </span>
                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-2 py-0.5">
                                    @cad.DetectedFloorAreaM2.ToString("N1") m² (@cad.DetectedRooms.Count Etiket)
                                </span>
                                <span class="text-primary fw-semibold small ms-1" style="font-size: 0.72rem;">Detay <i class="bi bi-sliders2"></i></span>
                            </div>
                        </div>

                        <!-- PAFTA DETAY KUTULARI (SADECE İLK PAFTA AÇIK, DİĞERLERİ TIKLAYINCA AÇILIR) -->
                        <div id="@cadCollapseId" class="cad-item-detail-pane p-2.5 border-top" style="display: @(isFirstCad ? "block" : "none");">
                            <!-- 3 Kutu: Katmanlar, Mahaller, Bloklar -->
                            <div class="row g-2" style="font-size: 0.75rem;">
                                <div class="col-md-4">
                                    <div class="p-2 rounded-3 border bg-body-tertiary h-100">
                                        <div class="fw-bold text-dark mb-0.5"><i class="bi bi-layers text-primary me-1"></i>1. AutoCAD Çizim Katmanları (Layers):</div>
                                        <small class="text-muted d-block mb-1" style="font-size: 0.67rem;">Mimarın/mühendisin çizimi ayırdığı katman adları ve parantez içinde o katmandaki çizgi/eleman sayısı:</small>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var lyr in cad.TopLayers)
                                            {
                                                <span class="badge bg-white text-dark border font-monospace" style="font-size: 0.67rem;">@lyr</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-2 rounded-3 border bg-body-tertiary h-100">
                                        <div class="fw-bold text-dark mb-0.5"><i class="bi bi-bounding-box text-success me-1"></i>2. Paftadan Okunan Mahaller, Odalar &amp; m²'ler:</div>
                                        <small class="text-muted d-block mb-1" style="font-size: 0.67rem;">Çizimin içinden okunan gerçek oda isimleri, m² büyüklükleri, kat başlıkları ve taşıyıcı poz etiketleri:</small>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var rm in cad.DetectedRooms)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle" style="font-size: 0.67rem;">@rm</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-2 rounded-3 border bg-body-tertiary h-100">
                                        <div class="fw-bold text-dark mb-0.5"><i class="bi bi-box-seam text-warning-emphasis me-1"></i>3. Sayılan Hazır Semboller (Bloklar) &amp; Notlar:</div>
                                        <small class="text-muted d-block mb-1" style="font-size: 0.67rem;">Projede kullanılan hazır AutoCAD şablonlarının (kapı, pencere, kolon, sigorta, klozet vb.) adetleri:</small>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var blk in cad.DetectedBlocks)
                                            {
                                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace" style="font-size: 0.67rem;">@blk</span>
                                            }
                                            @foreach (var st in cad.DetectedStructuralNotes)
                                            {
                                                <span class="badge bg-info-subtle text-dark border border-info-subtle" style="font-size: 0.67rem;">@st</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- 3. ŞANTİYE MALZEME TEDARİK & SATIN ALMA MATRİSİ (FAZ-0 İKİZ MANTIĞI) -->
    <!-- ======================================================== -->
    @{
        var bomItems = Model.MasterBomItems ?? new List<GMK360.Web.Models.MasterBomItemDto>();
        var totalBomCount = bomItems.Count;
        var packageGroups = bomItems
            .GroupBy(i => new { i.PackageKey, i.PackageName, i.PackageOrder, i.PackageIcon, i.SupplierBranch })
            .OrderBy(g => g.Key.PackageOrder)
            .ToList();

        var materialAgreements = ViewBag.MaterialAgreements as Dictionary<string, GMK360.Web.Controllers.MetrajController.MaterialAgreementRecordDto>
                                 ?? new Dictionary<string, GMK360.Web.Controllers.MetrajController.MaterialAgreementRecordDto>();
        var projectQuotes = ViewBag.ProjectQuotes as List<GMK360.Core.Entities.B2B.B2BQuoteRequest>
                            ?? new List<GMK360.Core.Entities.B2B.B2BQuoteRequest>();
        var staffList = ViewBag.StaffList as List<string> ?? new List<string>
        {
            "Satınalma Departmanı", "Şantiye Şefi", "Proje Müdürü", "Muhasebe & Finans", "Depo & Lojistik Sorumlusu"
        };

        decimal serverGrandTotal = 0;
        int serverCompletedOrPricedCount = 0;
    }

    <div class="card border rounded-4 shadow-sm mb-3" id="masterBomCard" style="border-top: 4px solid #0d6efd !important;">
        <!-- ÜST BAŞLIK (TEK DİV KONTROLÜ) -->
        <div class="card-header bg-white py-2.5 px-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="cursor: pointer; user-select: none;" onclick="if (!event.target.closest('button, input, a, .input-group')) toggleMatrixCard();" title="Tabloyu Açmak veya Kapatmak İçin Başlığa Tıklayın">
            <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-3 bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.74rem;">
                            <i class="bi bi-3-circle-fill me-1"></i>3. ADIM
                        </span>
                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.96rem;">Şantiye Malzeme Tedarik &amp; Satın Alma Matrisi</h6>
                        @if (hasReadAny)
                        {
                            <span class="badge bg-success text-white rounded-pill px-2.5 py-0.5" style="font-size: 0.70rem;">
                                <i class="bi bi-check2-circle me-1"></i>@packageGroups.Count Toptancı Branşı | @totalBomCount Kalem
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2.5 py-0.5" style="font-size: 0.70rem;">
                                <i class="bi bi-hourglass me-1"></i>DWG / DXF Okuması Bekleniyor (Boş)
                            </span>
                        }
                    </div>
                    <small class="text-muted" style="font-size: 0.72rem;">
                        Üst satırdan <strong>Toptancı Paketi</strong> olarak toplu teklif/anlaşma yapabilir veya satıra tıklayıp açılan <strong>Birim Kalemleri</strong> (artan/spot malzeme, daire yedek fayansı vb.) tek tek yönetebilirsiniz.
                    </small>
                </div>
            </div>

            <!-- ÜST AKSİYON: TÜM BRANŞLARI AÇ/DARALT, EXCEL (VER), STOK KARTLARI LİNKİ VE ARAMA KUTUSU -->
            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                @if (bomItems.Any())
                {
                    <form asp-action="BatchRequestMaterialQuotes" asp-controller="Metraj" method="post" class="m-0 d-inline" onsubmit="return confirm('20 Toptancı Branşındaki tüm malzeme paketleri toplu olarak Satın Alma & Teklif Masasına aktarılacak. Onaylıyor musunuz?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@projectId" />
                        <button type="submit" class="btn btn-xs btn-warning text-dark rounded-pill px-2.5 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1" style="font-size: 0.73rem;" title="Tüm toptancı branş paketlerini tek tıkla Satın Alma & Teklif Masasına aktarır">
                            <i class="bi bi-send-check-fill"></i>
                            <span>Tüm Paketleri Satın Almaya Aktar</span>
                        </button>
                    </form>
                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;" onclick="toggleAllMatrixBranches(true);" title="20 tedarikçi branşının tamamını açar">
                        <i class="bi bi-arrows-expand me-1"></i>Tüm Branşları Aç
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;" onclick="toggleAllMatrixBranches(false);" title="Tüm tedarikçi branşlarını tek satır başlık haline daraltır">
                        <i class="bi bi-arrows-collapse me-1"></i>Branşları Daralt
                    </button>
                }
                <a href="/Inventory/Index/@projectId" class="btn btn-outline-dark btn-sm rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.74rem;" title="Açılan stok kartlarını ve şantiye deposunu görüntüle">
                    <i class="bi bi-box-seam text-primary"></i>
                    <span>Şantiye Deposu &amp; Stok</span>
                </a>
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1" onclick="exportMaterialMatrixToExcel();" style="font-size: 0.76rem;" title="Malzeme Tedarik Matrisini Excel dosyası olarak indirir">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    <span>Excel'e Ver</span>
                </button>

                <div class="input-group input-group-sm" style="max-width: 195px;">
                    <span class="input-group-text bg-white py-0.5 px-2"><i class="bi bi-search text-muted small"></i></span>
                    <input type="text" class="form-control form-control-sm py-0.5" id="matrixSearchInput" placeholder="Malzeme veya firma ara..." oninput="searchMatrix(this.value);" style="font-size: 0.76rem;" />
                </div>
                <button type="button" class="btn btn-light border btn-sm rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1 text-secondary fw-semibold" id="matrixHeaderToggleBtn" onclick="toggleMatrixCard();" title="Tabloyu Aç / Kapat" style="font-size: 0.74rem;">
                    <i class="bi @(hasReadAny ? "bi-chevron-up text-primary" : "bi-chevron-down text-secondary")" id="matrixHeaderChevron"></i>
                    <span id="matrixHeaderChevronText">@(hasReadAny ? "Kapat" : "Aç")</span>
                </button>
            </div>
        </div>

        <div id="masterBomContent" class="collapse show" style="display: block;">
            <!-- FAZ-0 İKİZ TABLO DÜZENİ: MALZEME/GRUP | KİMDEN ALINIR/KAYNAK | MİKTAR | TAKİPÇİ (ATANAN) | MALİYET (₺) | DURUM | İŞLEM -->
            <div class="table-responsive" style="max-height: 620px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="materialMatrixTable" style="font-size: 0.81rem;">
                    <thead class="table-light text-muted border-bottom sticky-top" style="font-size: 0.71rem; letter-spacing: 0.3px; background-color: #f8fafc; z-index: 5;">
                        <tr>
                            <th class="ps-3" style="min-width: 250px;">MALZEME / TEDARİK GRUBU</th>
                            <th style="min-width: 195px;">KİMDEN ALINIR / KAYNAK</th>
                            <th style="width: 130px;" class="text-end">MİKTAR &amp; BİRİM</th>
                            <th style="width: 145px;">TAKİPÇİ (ATANAN)</th>
                            <th style="width: 155px;" class="text-end">MALİYET (₺)</th>
                            <th style="width: 140px;" class="text-center">DURUM</th>
                            <th class="text-end pe-3" style="width: 215px;">İŞLEM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (bomItems.Any())
                        {
                            int rowCounter = 1;
                            int branchIdx = 0;
                            foreach (var grp in packageGroups)
                            {
                                var grpItems = grp.ToList();
                                var branchName = grp.Key.SupplierBranch ?? grp.Key.PackageName;
                                var branchKey = grp.Key.PackageKey;
                                var branchIcon = grp.Key.PackageIcon;
                                var isBranchOpen = (branchIdx < 2); // İlk 2 ana branş (Demirci & Hazır Betoncu) açık, diğerleri tıklayınca açılır!
                                branchIdx++;

                                materialAgreements.TryGetValue(branchKey, out var branchAgr);
                                var branchQuoteId = branchAgr?.QuoteRequestId;
                                var branchQuote = branchQuoteId.HasValue
                                    ? projectQuotes.FirstOrDefault(q => q.Id == branchQuoteId.Value)
                                    : projectQuotes.FirstOrDefault(q => q.Title != null && q.Title.Contains(branchName));

                                // Alt kalemlerin toplam tutarını ve durumlarını hesapla
                                decimal childrenSumTotal = 0;
                                int completedChildren = 0;
                                int researchingChildren = 0;
                                foreach (var ci in grpItems)
                                {
                                    if (materialAgreements.TryGetValue($"item_{ci.Id}", out var cAgr))
                                    {
                                        childrenSumTotal += cAgr.TotalAmount;
                                        if (cAgr.Status == "Tamamlandı" || cAgr.Status == "Kısmi / Spot Alındı") completedChildren++;
                                        else if (cAgr.Status == "Fiyat Araştırılıyor") researchingChildren++;
                                    }
                                }

                                decimal branchDisplayTotal = (branchAgr != null && branchAgr.TotalAmount > 0)
                                    ? branchAgr.TotalAmount
                                    : childrenSumTotal;

                                string branchStatus = branchAgr?.Status ?? "Bekliyor";
                                if (branchStatus == "Bekliyor")
                                {
                                    if (completedChildren == grpItems.Count && grpItems.Count > 0) branchStatus = "Tamamlandı";
                                    else if (completedChildren > 0) branchStatus = "Kısmi / Spot Alındı";
                                    else if (researchingChildren > 0 || branchQuote != null) branchStatus = "Fiyat Araştırılıyor";
                                }

                                string branchFollower = branchAgr?.AssignedUser ?? (branchQuote != null ? "Satınalma Departmanı" : "Yok");
                                string branchSource = !string.IsNullOrWhiteSpace(branchAgr?.SupplierCompany)
                                    ? branchAgr!.SupplierCompany
                                    : $"{branchName} Toptancısı / Bayi";

                                // Branş özet miktar metni (Örn: 635 Ton + 5 Kalem)
                                var mainUnitGrp = grpItems.GroupBy(x => x.Unit).OrderByDescending(g => g.Count()).FirstOrDefault();
                                string branchQtySummary = mainUnitGrp != null && grpItems.Count == 1
                                    ? $"{mainUnitGrp.Sum(x => x.Quantity):N0} {mainUnitGrp.Key}"
                                    : $"{grpItems.Count} Kalem Paket";

                                <!-- ================================================================================= -->
                                <!-- ÜST SATIR (TOPTANCI / ANA BRANŞ SATIRI - TIKLAYINCA BİRİM DETAYLAR AÇILIR/KAPANIR) -->
                                <!-- ================================================================================= -->
                                <tr class="branch-header-row" data-branch="@branchKey" style="background-color: #f8fafc; border-top: 2px solid #e2e8f0; cursor: pointer;" onclick="if (!event.target.closest('button, a, form, input')) toggleBranchRows('@branchKey');">
                                    <td class="ps-3 py-2.5">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @(isBranchOpen ? "bi-chevron-down text-primary" : "bi-chevron-right text-muted") branch-chevron-icon" id="branch_chev_@branchKey"></i>
                                            <div class="rounded-2 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                                <i class="bi @branchIcon"></i>
                                            </div>
                                            <div>
                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                    <strong class="text-dark" style="font-size: 0.85rem;">@branchName (Toptancı Paketi)</strong>
                                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.66rem;">
                                                        @grpItems.Count Kalem
                                                    </span>
                                                </div>
                                                <small class="text-muted d-block" style="font-size: 0.68rem;">
                                                    <i class="bi bi-hand-index-thumb me-1"></i>Birim birim kalemleri açmak/kapatmak için satıra tıklayın
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-2.5">
                                        <div class="d-flex align-items-center gap-1.5 text-secondary" style="font-size: 0.78rem;">
                                            <i class="bi bi-building text-primary"></i>
                                            <span class="@(!string.IsNullOrWhiteSpace(branchAgr?.SupplierCompany) ? "fw-bold text-dark" : "")">@branchSource</span>
                                        </div>
                                        @if (branchAgr?.StockCardOpened == true)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill mt-0.5" style="font-size: 0.63rem;">
                                                <i class="bi bi-box-seam me-1"></i>Stok Kartları Açıldı
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end py-2.5">
                                        <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill fw-bold" style="font-size: 0.73rem;">
                                            @branchQtySummary
                                        </span>
                                    </td>
                                    <td class="py-2.5">
                                        @if (string.IsNullOrWhiteSpace(branchFollower) || branchFollower == "Yok")
                                        {
                                            <span class="text-danger fw-semibold" style="font-size: 0.77rem;">
                                                <i class="bi bi-person-x me-1"></i>Yok
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-primary fw-semibold" style="font-size: 0.76rem;">
                                                <i class="bi bi-person-check-fill me-1"></i>@branchFollower
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end py-2.5">
                                        @if (branchDisplayTotal > 0)
                                        {
                                            <div class="fw-bolder text-dark font-monospace" style="font-size: 0.86rem;">
                                                @branchDisplayTotal.ToString("N2") ₺
                                            </div>
                                            @if (branchAgr?.PaymentTransferred == true)
                                            {
                                                <small class="text-success fw-semibold d-block" style="font-size: 0.65rem;">
                                                    <i class="bi bi-check2-all me-0.5"></i>@branchAgr.PaymentTermsSummary
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-primary d-block" style="font-size: 0.65rem;">
                                                    <i class="bi bi-calculator me-0.5"></i>Toptan / Paket Toplamı
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small" style="font-size: 0.74rem;">Fiyat Bekleniyor</span>
                                        }
                                    </td>
                                    <td class="text-center py-2.5">
                                        @if (branchStatus == "Tamamlandı")
                                        {
                                            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #dcfce7; color: #166534; font-size: 0.71rem;">
                                                <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı
                                            </span>
                                        }
                                        else if (branchStatus == "Kısmi / Spot Alındı")
                                        {
                                            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #e0e7ff; color: #3730a3; font-size: 0.71rem;">
                                                <i class="bi bi-pie-chart-fill me-1"></i>Kısmi Bağlandı (@completedChildren/@grpItems.Count)
                                            </span>
                                        }
                                        else if (branchStatus == "Fiyat Araştırılıyor")
                                        {
                                            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #dbeafe; color: #1e40af; font-size: 0.71rem;">
                                                <i class="bi bi-hourglass-split me-1"></i>Fiyat Araştırılıyor @(branchQuote != null ? $"({branchQuote.Invites?.Count ?? 0} Davet)" : "")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-1 fw-bold" style="background-color: #fef08a; color: #854d0e; font-size: 0.72rem;">
                                                Bekliyor
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3 py-2.5">
                                        <div class="d-flex justify-content-end align-items-center gap-1.5">
                                            @if (branchQuote != null)
                                            {
                                                <a href="/B2BPurchasing/Details/@branchQuote.Id" class="btn btn-sm rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1 shadow-2xs" style="background-color: #facc15; color: #1e293b; font-size: 0.72rem;" title="Bu branş için açılan ihale ve teklif dosyasına git">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                    <span>İhaleye Git</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <form asp-action="RequestMaterialQuote" asp-controller="Metraj" method="post" class="m-0 d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="projectId" value="@projectId" />
                                                    <input type="hidden" name="targetKey" value="@branchKey" />
                                                    <input type="hidden" name="branchKey" value="@branchKey" />
                                                    <input type="hidden" name="branchName" value="@branchName" />
                                                    <button type="submit" class="btn btn-sm rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1 shadow-2xs" style="background-color: #facc15; color: #1e293b; font-size: 0.72rem;" title="Bu toptancı grubundaki tüm kalemler için toplu fiyat araştırması / ihale başlat">
                                                        <i class="bi bi-search"></i>
                                                        <span>Araştır / Teklif</span>
                                                    </button>
                                                </form>
                                            }

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1"
                                                    style="font-size: 0.72rem;"
                                                    onclick="openManageMaterialModal({
                                                        targetKey: '@branchKey',
                                                        branchKey: '@branchKey',
                                                        branchName: '@Html.Raw(branchName.Replace("'", "\\'"))',
                                                        itemId: '',
                                                        targetTitle: '@Html.Raw((branchName + " (Toplu Toptancı Paketi)").Replace("'", "\\'"))',
                                                        status: '@branchStatus',
                                                        assignedUser: '@Html.Raw(branchFollower.Replace("'", "\\'"))',
                                                        supplierCompany: '@Html.Raw((branchAgr?.SupplierCompany ?? "").Replace("'", "\\'"))',
                                                        supplierContact: '@Html.Raw((branchAgr?.SupplierContact ?? "").Replace("'", "\\'"))',
                                                        supplierPhone: '@Html.Raw((branchAgr?.SupplierPhone ?? "").Replace("'", "\\'"))',
                                                        qty: 1,
                                                        unit: 'Paket (@grpItems.Count Kalem)',
                                                        unitPrice: @(branchDisplayTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                                                        totalAmount: @(branchDisplayTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                                                        spareQty: 0,
                                                        spareNote: ''
                                                    });">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Yönet</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- ================================================================================= -->
                                <!-- ALT SATIRLAR (BİRİM BİRİM KALEMLER - TEKİL FİYAT, SPOT ALIM & STOK KARTI YÖNETİMİ) -->
                                <!-- ================================================================================= -->
                                foreach (var item in grpItems)
                                {
                                    string itemKey = $"item_{item.Id}";
                                    materialAgreements.TryGetValue(itemKey, out var itemAgr);

                                    var itemQuoteId = itemAgr?.QuoteRequestId;
                                    var itemQuote = itemQuoteId.HasValue
                                        ? projectQuotes.FirstOrDefault(q => q.Id == itemQuoteId.Value)
                                        : null;

                                    string itemStatus = itemAgr?.Status ?? (branchStatus == "Tamamlandı" ? "Tamamlandı" : (branchStatus == "Fiyat Araştırılıyor" ? "Fiyat Araştırılıyor" : "Bekliyor"));
                                    string itemFollower = !string.IsNullOrWhiteSpace(itemAgr?.AssignedUser) && itemAgr.AssignedUser != "Yok"
                                        ? itemAgr.AssignedUser
                                        : branchFollower;
                                    string itemSupplier = !string.IsNullOrWhiteSpace(itemAgr?.SupplierCompany)
                                        ? itemAgr!.SupplierCompany
                                        : (!string.IsNullOrWhiteSpace(branchAgr?.SupplierCompany) ? branchAgr!.SupplierCompany : $"{branchName} / Spot Kaynak");

                                    decimal itemUnitPrice = itemAgr?.UnitPrice ?? 0;
                                    decimal itemTotal = itemAgr?.TotalAmount ?? 0;
                                    decimal itemAgreedQty = (itemAgr != null && itemAgr.AgreedQuantity > 0) ? itemAgr.AgreedQuantity : item.Quantity;

                                    if (itemTotal > 0 || itemStatus == "Tamamlandı" || itemStatus == "Kısmi / Spot Alındı")
                                    {
                                        serverGrandTotal += itemTotal;
                                        serverCompletedOrPricedCount++;
                                    }

                                    <tr class="material-matrix-row @(itemStatus == "Tamamlandı" ? "table-success bg-opacity-10" : (itemStatus == "Kısmi / Spot Alındı" ? "table-info bg-opacity-10" : ""))"
                                        id="mat_row_@item.Id"
                                        data-item-id="@item.Id"
                                        data-row-index="@rowCounter"
                                        data-branch="@branchKey"
                                        data-branch-name="@branchName"
                                        data-title="@item.Title"
                                        data-qty="@itemAgreedQty"
                                        data-unit="@item.Unit"
                                        data-unit-price="@itemUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-total="@itemTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-supplier="@itemSupplier"
                                        data-status="@itemStatus"
                                        data-search="@(branchName.ToLower()) @(item.Title.ToLower()) @(itemSupplier.ToLower())"
                                        style="display: @(isBranchOpen ? "table-row" : "none");">
                                        <td class="ps-4 py-2">
                                            <div class="d-flex align-items-start gap-2">
                                                <span class="text-muted font-monospace small mt-0.5" style="font-size: 0.72rem;">↳ @(rowCounter++).</span>
                                                <div>
                                                    <span class="fw-bold text-dark d-block" style="font-size: 0.81rem;">@item.Title</span>
                                                    <div class="d-flex align-items-center gap-1 flex-wrap mt-0.5">
                                                        <span class="text-muted" style="font-size: 0.67rem;">@branchName</span>
                                                        @if (itemAgr?.StockCardOpened == true || branchAgr?.StockCardOpened == true)
                                                        {
                                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-1.5 py-0" style="font-size: 0.62rem;">
                                                                <i class="bi bi-box-seam me-0.5"></i>Stok Kartı Açık
                                                            </span>
                                                        }
                                                        @if (itemAgr != null && itemAgr.SpareReserveQty > 0)
                                                        {
                                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-1.5 py-0" style="font-size: 0.62rem;" title="@itemAgr.SpareReserveNote">
                                                                <i class="bi bi-house-heart-fill text-danger me-0.5"></i>+@itemAgr.SpareReserveQty.ToString("N0") @item.Unit Daire Yedeği
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-2">
                                            <div class="d-flex align-items-center gap-1.5" style="font-size: 0.77rem;">
                                                <i class="bi bi-shop text-secondary"></i>
                                                <span class="@(!string.IsNullOrWhiteSpace(itemAgr?.SupplierCompany) ? "fw-bold text-dark" : "text-secondary")">@itemSupplier</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(itemAgr?.SpareReserveNote))
                                            {
                                                <small class="text-muted d-block" style="font-size: 0.65rem;">
                                                    <i class="bi bi-bookmark-star text-warning me-0.5"></i>@itemAgr.SpareReserveNote
                                                </small>
                                            }
                                        </td>
                                        <td class="text-end py-2">
                                            <span class="item-qty-val font-monospace fw-bold text-dark" style="font-size: 0.86rem;">@itemAgreedQty.ToString("N0")</span>
                                            <span class="badge bg-light text-dark border px-1.5 py-0.5 rounded-pill ms-1" style="font-size: 0.68rem;">@item.Unit</span>
                                        </td>
                                        <td class="py-2">
                                            @if (string.IsNullOrWhiteSpace(itemFollower) || itemFollower == "Yok")
                                            {
                                                <span class="text-danger fw-semibold" style="font-size: 0.75rem;">
                                                    <i class="bi bi-person-x me-1"></i>Yok
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-primary fw-semibold" style="font-size: 0.75rem;">
                                                    <i class="bi bi-person-check me-1"></i>@itemFollower
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end py-2">
                                            @if (itemTotal > 0)
                                            {
                                                <div class="fw-bold text-dark font-monospace item-total-display" id="total_display_@item.Id" style="font-size: 0.82rem;">
                                                    @itemTotal.ToString("N2") ₺
                                                </div>
                                                <small class="text-muted font-monospace d-block" style="font-size: 0.65rem;">
                                                    Birim: @itemUnitPrice.ToString("N2") ₺/@item.Unit
                                                </small>
                                                @if (itemAgr?.PaymentTransferred == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill" style="font-size: 0.60rem;">
                                                        <i class="bi bi-credit-card me-0.5"></i>@itemAgr.PaymentTermsSummary
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small item-total-display" id="total_display_@item.Id" style="font-size: 0.74rem;">—</span>
                                                <small class="text-muted d-block" style="font-size: 0.64rem;">GMK360 Metraj Havuzu</small>
                                            }
                                            <input type="hidden" class="unit-price-input" data-item-id="@item.Id" data-qty="@itemAgreedQty" value="@(itemUnitPrice > 0 ? itemUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                            <input type="hidden" class="agreed-supplier-input" data-item-id="@item.Id" value="@(itemAgr?.SupplierCompany ?? "")" />
                                        </td>
                                        <td class="text-center py-2">
                                            @if (itemStatus == "Tamamlandı")
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #dcfce7; color: #166534; font-size: 0.70rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı
                                                </span>
                                            }
                                            else if (itemStatus == "Kısmi / Spot Alındı")
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #e0e7ff; color: #3730a3; font-size: 0.70rem;">
                                                    <i class="bi bi-lightning-fill me-1"></i>Spot / Başka Şantiye
                                                </span>
                                            }
                                            else if (itemStatus == "Fiyat Araştırılıyor")
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #dbeafe; color: #1e40af; font-size: 0.70rem;">
                                                    <i class="bi bi-search me-1"></i>Araştırılıyor
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background-color: #fef08a; color: #854d0e; font-size: 0.70rem;">
                                                    Bekliyor
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-3 py-2">
                                            <div class="d-flex justify-content-end align-items-center gap-1.5">
                                                @if (itemQuote != null)
                                                {
                                                    <a href="/B2BPurchasing/Details/@itemQuote.Id" class="btn btn-xs rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1" style="background-color: #facc15; color: #1e293b; font-size: 0.70rem;" title="Bu kalem için açılan ihale sayfasına git">
                                                        <i class="bi bi-box-arrow-up-right"></i>
                                                        <span>İhaleye Git</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <form asp-action="RequestMaterialQuote" asp-controller="Metraj" method="post" class="m-0 d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="projectId" value="@projectId" />
                                                        <input type="hidden" name="targetKey" value="@itemKey" />
                                                        <input type="hidden" name="branchKey" value="@branchKey" />
                                                        <input type="hidden" name="branchName" value="@branchName" />
                                                        <input type="hidden" name="itemId" value="@item.Id" />
                                                        <input type="hidden" name="itemTitle" value="@item.Title" />
                                                        <input type="hidden" name="quantity" value="@itemAgreedQty.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                        <input type="hidden" name="unit" value="@item.Unit" />
                                                        <button type="submit" class="btn btn-xs rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1" style="background-color: #facc15; color: #1e293b; font-size: 0.70rem;" title="Sadece bu kalem için ayrı teklif iste / ihale dosyası aç">
                                                            <i class="bi bi-search"></i>
                                                            <span>Araştır / Teklif</span>
                                                        </button>
                                                    </form>
                                                }

                                                <button type="button"
                                                        class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1"
                                                        style="font-size: 0.70rem;"
                                                        onclick="openManageMaterialModal({
                                                            targetKey: '@itemKey',
                                                            branchKey: '@branchKey',
                                                            branchName: '@Html.Raw(branchName.Replace("'", "\\'"))',
                                                            itemId: '@item.Id',
                                                            targetTitle: '@Html.Raw(item.Title.Replace("'", "\\'"))',
                                                            status: '@itemStatus',
                                                            assignedUser: '@Html.Raw(itemFollower.Replace("'", "\\'"))',
                                                            supplierCompany: '@Html.Raw((itemAgr?.SupplierCompany ?? branchAgr?.SupplierCompany ?? "").Replace("'", "\\'"))',
                                                            supplierContact: '@Html.Raw((itemAgr?.SupplierContact ?? branchAgr?.SupplierContact ?? "").Replace("'", "\\'"))',
                                                            supplierPhone: '@Html.Raw((itemAgr?.SupplierPhone ?? branchAgr?.SupplierPhone ?? "").Replace("'", "\\'"))',
                                                            qty: @(itemAgreedQty.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                                                            unit: '@Html.Raw(item.Unit.Replace("'", "\\'"))',
                                                            unitPrice: @(itemUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                                                            totalAmount: @(itemTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                                                            spareQty: @((itemAgr?.SpareReserveQty ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),
                                                            spareNote: '@Html.Raw((itemAgr?.SpareReserveNote ?? "").Replace("'", "\\'"))'
                                                        });">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Yönet</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted bg-light bg-opacity-50">
                                    <i class="bi bi-file-earmark-ruled fs-2 d-block mb-1 text-primary"></i>
                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.88rem;">Henüz Okunmuş DWG / DXF Çizimi Yok — Malzeme Matrisi Boş Bekliyor</h6>
                                    <p class="small text-muted mb-0" style="font-size: 0.76rem;">
                                        Yukarıdaki <strong>"1. ADIM: DWG / DXF MASASI"</strong> bölümünden projenizin <code>.dwg</code> veya <code>.dxf</code> dosyalarını yükleyip <strong>"⚡ DWG Oku"</strong> butonuna bastığınızda 20 tedarikçi branşındaki tüm metrajlar otomatik hesaplanacaktır.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- FOOTER: GENEL TOPLAM VE ÖZET BİLGİ -->
            <div class="card-footer bg-white py-2 px-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small" style="font-size: 0.74rem;">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        <strong>Faz-0 Ortak Düzeni:</strong> İster üstten <strong>Toptancı Paketi</strong> olarak toplu anlaşın, ister alt satırdan <strong>Birim Kalem</strong> seçip stok kartı açarak <strong>Finans &amp; Cari</strong> ödeme listesine aktarın.
                    </span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <small class="text-muted d-block" style="font-size: 0.66rem;">BAĞLANAN / FİYATLANDIRILAN</small>
                        <span class="fw-bold text-dark" id="pricedCountDisplay" style="font-size: 0.78rem;">@serverCompletedOrPricedCount / @totalBomCount Kalem</span>
                    </div>
                    <div class="text-end border-start ps-3">
                        <small class="text-muted d-block" style="font-size: 0.66rem;">TOPLAM ANLAŞILAN MALZEME MALİYETİ</small>
                        <span class="fs-5 fw-bolder text-primary font-monospace" id="matrixGrandTotalDisplay">₺@serverGrandTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================================= -->
    <!-- FAZ-0 İKİZİ: MALZEME ANLAŞMA, PERSONEL ATAMA, STOK KARTI & ÖDEME AKTARIM MODALI -->
    <!-- ================================================================================= -->
    <div class="modal fade" id="manageMaterialModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <form asp-action="SaveMaterialAgreement" asp-controller="Metraj" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@projectId" />
                    <input type="hidden" name="targetKey" id="mm_targetKey" />
                    <input type="hidden" name="branchKey" id="mm_branchKey" />
                    <input type="hidden" name="branchName" id="mm_branchName" />
                    <input type="hidden" name="itemId" id="mm_itemId" />
                    <input type="hidden" name="targetTitle" id="mm_targetTitle" />

                    <div class="modal-header text-white py-3 px-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e40af 100%);">
                        <div>
                            <span class="badge bg-warning text-dark rounded-pill px-2.5 py-0.5 fw-bold mb-1" id="mm_badgeType" style="font-size: 0.68rem;">
                                TEDARİK &amp; SATIN ALMA YÖNETİMİ
                            </span>
                            <h5 class="modal-title fw-bold mb-0" id="mm_modalTitle" style="font-size: 1.02rem;">Malzeme / Paket Yönetimi</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>

                    <div class="modal-body p-4" style="font-size: 0.82rem;">
                        <!-- 1. SÜREÇ DURUMU VE TEK SORUMLU (TAKİPÇİ) ATAMASI -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark mb-1">
                                    <i class="bi bi-flag-fill text-primary me-1"></i>1. Tedarik / Anlaşma Durumu
                                </label>
                                <select name="status" id="mm_status" class="form-select form-select-sm fw-semibold">
                                    <option value="Bekliyor">⏳ Bekliyor (Henüz Başlanmadı)</option>
                                    <option value="Fiyat Araştırılıyor">🔍 Fiyat Araştırılıyor / Teklif Toplanıyor</option>
                                    <option value="Kısmi / Spot Alındı">⚡ Kısmi / Spot Alındı (Başka Şantiye / Parti Malı)</option>
                                    <option value="Tamamlandı">✅ Tamamlandı (Anlaşıldı &amp; Sipariş Bağlandı)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark mb-1">
                                    <i class="bi bi-person-badge-fill text-primary me-1"></i>2. Takipçi / Tek Sorumlu Ata
                                </label>
                                <select name="assignedUser" id="mm_assignedUser" class="form-select form-select-sm fw-semibold">
                                    <option value="Yok">👤 Yok (Atanmadı)</option>
                                    @foreach (var st in staffList)
                                    {
                                        <option value="@st">👤 @st</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- 2. ANLAŞILAN FİRMA / TEDARİKÇİ VEYA BAŞKA ŞANTİYE KAYNAĞI -->
                        <div class="p-3 rounded-3 border bg-light bg-opacity-50 mb-3">
                            <div class="fw-bold text-dark mb-2">
                                <i class="bi bi-building-check text-primary me-1"></i>3. Anlaşılan Toptancı Firma veya Alım Kaynağı
                                <small class="text-muted fw-normal ms-1">(Toptancı, bayi veya başka bir şantiyeden artan malzeme kaynağı)</small>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <label class="form-label small text-muted mb-0.5">Firma / Tedarikçi / Şantiye Adı</label>
                                    <input type="text" name="supplierCompany" id="mm_supplierCompany" class="form-control form-control-sm" placeholder="Örn: Özdemir Haddehane A.Ş. veya Yan Şantiye" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-0.5">Yetkili Kişi</label>
                                    <input type="text" name="supplierContact" id="mm_supplierContact" class="form-control form-control-sm" placeholder="Örn: Ahmet Bey" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small text-muted mb-0.5">Telefon</label>
                                    <input type="text" name="supplierPhone" id="mm_supplierPhone" class="form-control form-control-sm" placeholder="05XX XXX XX XX" />
                                </div>
                            </div>
                        </div>

                        <!-- 3. MİKTAR, BİRİM FİYAT VE TOPLAM ANLAŞMA TUTARI -->
                        <div class="p-3 rounded-3 border bg-white mb-3">
                            <div class="fw-bold text-dark mb-2">
                                <i class="bi bi-calculator-fill text-success me-1"></i>4. Sipariş Miktarı &amp; Anlaşma Rakamı (₺)
                                <small class="text-muted fw-normal ms-1">(Birim fiyat girerseniz toplam otomatik hesaplanır; toptancı paketinde doğrudan toplam rakamı da yazabilirsiniz)</small>
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small text-muted mb-0.5">Anlaşılan Miktar</label>
                                    <input type="number" step="0.01" min="0" name="agreedQuantity" id="mm_qty" class="form-control form-control-sm font-monospace fw-bold" oninput="recalcModalTotal();" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small text-muted mb-0.5">Birim</label>
                                    <input type="text" name="unit" id="mm_unit" class="form-control form-control-sm bg-light" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small text-muted mb-0.5">Birim Fiyat (₺)</label>
                                    <input type="number" step="0.01" min="0" name="unitPrice" id="mm_unitPrice" class="form-control form-control-sm font-monospace" placeholder="0.00" oninput="recalcModalTotal();" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-success fw-bold mb-0.5">Toplam Anlaşma Tutarı (₺)</label>
                                    <input type="number" step="0.01" min="0" name="totalAmount" id="mm_totalAmount" class="form-control form-control-sm font-monospace fw-bolder border-success text-success" placeholder="0.00" />
                                </div>
                            </div>
                        </div>

                        <!-- 4. OTOMATİK STOK KARTI & ELDE KALAN / DAİRE YEDEK STOĞU (FAYANS VB.) -->
                        <div class="p-3 rounded-3 border mb-3" style="background-color: #f0fdf4; border-color: #bbf7d0 !important;">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="createStockCard" id="mm_createStockCard" value="true" checked />
                                <label class="form-check-label fw-bold text-dark" for="mm_createStockCard">
                                    <i class="bi bi-box-seam-fill text-success me-1"></i>5. Bu Kalem(ler) İçin Otomatik Stok Kartı Aç &amp; Şantiye Deposuna İşle
                                </label>
                            </div>
                            <small class="text-muted d-block mb-2" style="font-size: 0.73rem;">
                                İşaretlendiğinde <strong>Demirbaş &amp; Depo</strong> modülünde şantiye depo stoğu açılır. Ayrıca fayans, seramik gibi malzemelerde <strong>elde kalan / daire sahiplerine bırakılacak yedek stoğu</strong> aşağıdan ayırabilirsiniz:
                            </small>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small text-dark fw-semibold mb-0.5">🏠 Daire Yedek / Artan Stok Miktarı</label>
                                    <input type="number" step="0.01" min="0" name="spareReserveQty" id="mm_spareQty" class="form-control form-control-sm" placeholder="Örn: 45 (Opsiyonel)" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small text-dark fw-semibold mb-0.5">Yedek / Artan Malzeme Takip Notu</label>
                                    <input type="text" name="spareReserveNote" id="mm_spareNote" class="form-control form-control-sm" placeholder="Örn: Her daireye ilerideki tadilatlar için 3 m² yedek fayans ayrılacak" />
                                </div>
                            </div>
                        </div>

                        <!-- 5. FİNANS & CARİ (ÖDEME LİSTESİ) VE KARA DEFTER AKTARIMI -->
                        <div class="p-3 rounded-3 border" style="background-color: #eff6ff; border-color: #bfdbfe !important;">
                            <div class="fw-bold text-dark mb-2">
                                <i class="bi bi-credit-card-2-front-fill text-primary me-1"></i>6. Ödeme Listesine (Finans &amp; Cari) ve Kara Deftere Aktar
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-7">
                                    <label class="form-label small text-muted mb-0.5">Ödeme &amp; Cari İşlem Şekli</label>
                                    <select name="paymentType" id="mm_paymentType" class="form-select form-select-sm fw-semibold" onchange="document.getElementById('mm_dueDateBox').style.display = (this.value === 'Vadeli' ? 'block' : 'none');">
                                        <option value="Vadeli">📅 Vadeli Alım — Ödeme Listesine (Finans &amp; Cari) ve Kara Deftere Aktar</option>
                                        <option value="Pesin">💵 Peşin Ödendi — Kasa/Banka Çıkışı Yap ve Cariyi Kapat</option>
                                        <option value="SadeceKayit">📝 Şimdilik Sadece Tabloda Kaydet (Finans &amp; Ödeme Listesine Aktarma)</option>
                                    </select>
                                </div>
                                <div class="col-md-5" id="mm_dueDateBox">
                                    <label class="form-label small text-muted mb-0.5">Ödeme Vade Tarihi</label>
                                    <input type="date" name="dueDate" id="mm_dueDate" class="form-control form-control-sm" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light py-2.5 px-4 d-flex justify-content-between">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i>Anlaşmayı Kaydet, Stok Aç &amp; Ödeme Listesine Aktar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 4. ESKİLER / ARŞİVLENMİŞ GÖRÜNÜM (AÇILIR / KAPANIR DİV) -->

    <!-- ======================================================== -->

    <div class="card border rounded-4 shadow-sm mb-4">

        <div class="card-header bg-light py-3 px-3 d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#eskilerCollapse" aria-expanded="false">

            <div class="d-flex align-items-center gap-2">

                <i class="bi bi-archive-fill text-secondary fs-5"></i>

                <div>

                    <span class="fw-bold text-dark">Eskiler (Tüm Çizim Arşivi & 84 Kat Matrisi)</span>

                    <small class="text-muted d-block" style="font-size: 0.72rem;">Daha önce eklenen şartname panosu, özet göstergeler, disiplin sekmeleri ve kat matrisini incelemek için tıklayın (Varsayılan Kapalı)</small>

                </div>

            </div>

            <div class="d-flex align-items-center gap-2">

                <span class="badge bg-white text-muted border">Geçmiş Tasarım</span>

                <i class="bi bi-chevron-down text-muted"></i>

            </div>

        </div>

        <div class="collapse" id="eskilerCollapse">

            <div class="card-body p-3 bg-light bg-opacity-25">

    <!-- MİMAR CAD / DXF ŞARTNAMESİ BANNER -->

    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <div class="d-flex align-items-center gap-2 mb-2">

                        <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">

                            <i class="bi bi-star-fill me-1"></i>STANDART ŞARTNAME

                        </span>

                        <span class="text-white-50 small">AutoCAD (DWG/DXF) & PDF Proje Kabul Kuralları</span>

                    </div>

                    <h4 class="fw-bold mb-1">Mimar ve Mühendisler için CAD/DXF Teslim Şartnamesi</h4>

                    <p class="text-white-50 mb-0 small" style="line-height: 1.5;">

                        GMK360 hesaplama ve ihale motorunun mimari projeleri sorunsuz işletmesi için: <strong>1)</strong> Her katın WBLOCK ile tekil DXF çıkarılması, <strong>2)</strong> Zorunlu Mahal isimlerinin yazılması, <strong>3)</strong> Standart kapı/pencere çizimi esastır. Taşeron ve tedarikçilere kusursuz metraj ve şablon PDF'ler buradan üretilir.

                    </p>

                </div>

                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                    <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-3 py-2 shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#sartnameModal">

                        <i class="bi bi-file-earmark-richtext-fill me-1"></i> Şartnameyi İncele & Yazdır

                    </button>

                    <button type="button" class="btn btn-outline-light rounded-pill px-3 py-2 shadow-sm" onclick="copySartname()">

                        <i class="bi bi-whatsapp me-1"></i> Mimara İlet

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ÖZET GÖSTERGELER (KPI CARDS) -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-3 d-flex align-items-center">

                    <div class="rounded-4 bg-primary bg-opacity-10 text-primary p-3 me-3">

                        <i class="bi bi-building fs-3"></i>

                    </div>

                    <div>

                        <div class="text-muted small fw-bold text-uppercase">Toplam Kat</div>

                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalFloorsCount Kat</h4>

                        <small class="text-muted">@Model.Blocks.Count Blok/Kule</small>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-3">

                    <div class="d-flex align-items-center mb-2">

                        <div class="rounded-4 bg-success bg-opacity-10 text-success p-3 me-3">

                            <i class="bi bi-file-earmark-check-fill fs-3"></i>

                        </div>

                        <div>

                            <div class="text-muted small fw-bold text-uppercase">Mimari Planlar</div>

                            <h4 class="fw-bold mb-0 text-success">@Model.FloorsWithPlanCount / @Model.TotalFloorsCount</h4>

                            <small class="text-muted">Kat Planı Yüklü</small>

                        </div>

                    </div>

                    <div class="progress" style="height: 6px;">

                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PlanCompletionPercentage%;" aria-valuenow="@Model.PlanCompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-3 d-flex align-items-center">

                    <div class="rounded-4 bg-warning bg-opacity-10 text-warning p-3 me-3">

                        <i class="bi bi-cone-striped fs-3"></i>

                    </div>

                    <div>

                        <div class="text-muted small fw-bold text-uppercase">Statik Paftalar</div>

                        <h4 class="fw-bold mb-0 text-dark">@Model.StructuralDrawings.Count Pafta</h4>

                        <small class="text-muted">Kalıp & Donatı Detayı</small>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-3 d-flex align-items-center">

                    <div class="rounded-4 bg-info bg-opacity-10 text-info p-3 me-3">

                        <i class="bi bi-lightning-charge-fill fs-3"></i>

                    </div>

                    <div>

                        <div class="text-muted small fw-bold text-uppercase">Mekanik & Elektrik</div>

                        <h4 class="fw-bold mb-0 text-dark">@(Model.MechanicalDrawings.Count + Model.ElectricalDrawings.Count) Pafta</h4>

                        <small class="text-muted">Tesisat & Projeler</small>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- DİSİPLİN SEKMELERİ (TABS) -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-bottom p-3">

            <ul class="nav nav-pills card-header-pills" id="drawingTabs" role="tablist">

                <li class="nav-item" role="presentation">

                    <button class="nav-link active rounded-pill fw-bold px-4" id="mimari-tab" data-bs-toggle="pill" data-bs-target="#mimari-pane" type="button" role="tab">

                        <i class="bi bi-house-door-fill me-2"></i>ğŸ›ï¸ Mimari Kat Planları & Matris

                        <span class="badge bg-primary ms-2">@Model.FloorsWithPlanCount / @Model.TotalFloorsCount</span>

                    </button>

                </li>

                <li class="nav-item" role="presentation">

                    <button class="nav-link rounded-pill fw-bold px-4" id="statik-tab" data-bs-toggle="pill" data-bs-target="#statik-pane" type="button" role="tab">

                        <i class="bi bi-shield-shaded me-2"></i>ğŸ—ï¸ Statik Projeler

                        <span class="badge bg-secondary ms-2">@Model.StructuralDrawings.Count</span>

                    </button>

                </li>

                <li class="nav-item" role="presentation">

                    <button class="nav-link rounded-pill fw-bold px-4" id="mekanik-tab" data-bs-toggle="pill" data-bs-target="#mekanik-pane" type="button" role="tab">

                        <i class="bi bi-tools me-2"></i>Mekanik Tesisat

                        <span class="badge bg-secondary ms-2">@Model.MechanicalDrawings.Count</span>

                    </button>

                </li>

                <li class="nav-item" role="presentation">

                    <button class="nav-link rounded-pill fw-bold px-4" id="elektrik-tab" data-bs-toggle="pill" data-bs-target="#elektrik-pane" type="button" role="tab">

                        <i class="bi bi-lightning-fill me-2"></i>Elektrik & Zayıf Akım

                        <span class="badge bg-secondary ms-2">@Model.ElectricalDrawings.Count</span>

                    </button>

                </li>

            </ul>

        </div>

        <div class="card-body p-4">

            <div class="tab-content" id="drawingTabsContent">

                

                <!-- SEKME 1: MİMARİ KAT PLANLARI & CAD/DWG ARŞİVİ -->

                <div class="tab-pane fade show active" id="mimari-pane" role="tabpanel">

                    

                    <!-- 1. HIZLI DWG / DXF / ÇİZİM YÜKLEME KARTI -->

                    <div class="card border-0 bg-light rounded-4 p-3 mb-4 shadow-2xs">

                        <form asp-action="UploadDrawing" asp-controller="Metraj" method="post" enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="projectId" value="@projectId" />

                            <div class="row g-2 align-items-end">

                                <div class="col-md-3">

                                    <label class="form-label small fw-bold text-dark mb-1">

                                        <i class="bi bi-file-earmark-code text-primary me-1"></i>Çizim Dosyası (.dwg, .dxf, .pdf)

                                    </label>

                                    <input type="file" class="form-control form-control-sm bg-white" name="file" accept=".dwg,.dxf,.pdf" required />

                                </div>

                                <div class="col-md-3">

                                    <label class="form-label small fw-bold text-dark mb-1">Pafta / Çizim Tanımı</label>

                                    <input type="text" class="form-control form-control-sm bg-white" name="title" placeholder="Örn: 1. Tip Kat Mimari Planı" required />

                                </div>

                                <div class="col-md-2">

                                    <label class="form-label small fw-bold text-dark mb-1">Çizim Türü</label>

                                    <select class="form-select form-select-sm bg-white" name="category">

                                        <option value="Mimari">ğŸ›ï¸ Mimari Tip Kat</option>

                                        <option value="Mimari Vaziyet">ğŸ§­ Vaziyet / Kesit</option>

                                        <option value="Statik">ğŸ—ï¸ Statik Proje</option>

                                        <option value="Mekanik">Mekanik Tesisat</option>

                                        <option value="Elektrik">âš¡ Elektrik / Zayıf Akım</option>

                                    </select>

                                </div>

                                <div class="col-md-2">

                                    <label class="form-label small fw-bold text-dark mb-1">Hedef Blok (Opsiyonel)</label>

                                    <select class="form-select form-select-sm bg-white" name="buildingId">

                                        <option value="">-- Tüm Bloklar --</option>

                                        @foreach (var b in Model.Blocks)

                                        {

                                            <option value="@b.Id">@b.BlockName</option>

                                        }

                                    </select>

                                </div>

                                <div class="col-md-2">

                                    <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill fw-bold shadow-xs py-1.5">

                                        <i class="bi bi-cloud-arrow-up-fill me-1"></i>Çizimi Arşive Al

                                    </button>

                                </div>

                            </div>

                        </form>

                    </div>

                    <!-- 2. MİMARİ ÇİZİMLER & DWG ARŞİV DEPOSU LİSTESİ -->

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <div>

                            <h5 class="fw-bold mb-0 text-dark">

                                <i class="bi bi-collection-fill text-primary me-2"></i>Mimari & CAD Çizim Arşivi

                            </h5>

                            <small class="text-muted">Projenin ruhsat ve uygulama aşamasındaki DWG/DXF/PDF paftaları.</small>

                        </div>

                        <span class="badge bg-primary px-3 py-1.5 rounded-pill">@(Model.ArchitecturalDrawings?.Count ?? 0) Pafta Kayıtlı</span>

                    </div>

                    @if (Model.ArchitecturalDrawings != null && Model.ArchitecturalDrawings.Any())

                    {

                        <div class="table-responsive rounded-3 border bg-white mb-4 shadow-2xs">

                            <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">

                                <thead class="table-light text-muted">

                                    <tr>

                                        <th>Pafta / Çizim Başlığı</th>

                                        <th>Format</th>

                                        <th>Kategori / Disiplin</th>

                                        <th>Yükleme Tarihi</th>

                                        <th class="text-end" style="min-width: 220px;">İşlemler</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var doc in Model.ArchitecturalDrawings)

                                    {

                                        var isDwg = doc.FileExtension?.ToLowerInvariant() == ".dwg";

                                        var isDxf = doc.FileExtension?.ToLowerInvariant() == ".dxf";

                                        var isPdf = doc.FileExtension?.ToLowerInvariant() == ".pdf";

                                        <tr>

                                            <td>

                                                <div class="d-flex align-items-center gap-2">

                                                    @if (isDwg)

                                                    {

                                                        <span class="badge bg-primary text-white px-2 py-1 fw-bold" style="font-size: 0.70rem;">DWG</span>

                                                    }

                                                    else if (isDxf)

                                                    {

                                                        <span class="badge text-white px-2 py-1 fw-bold" style="font-size: 0.70rem; background-color: #6f42c1;">DXF</span>

                                                    }

                                                    else if (isPdf)

                                                    {

                                                        <span class="badge bg-danger text-white px-2 py-1 fw-bold" style="font-size: 0.70rem;">PDF</span>

                                                    }

                                                    else

                                                    {

                                                        <span class="badge bg-secondary text-white px-2 py-1 fw-bold" style="font-size: 0.70rem;">CAD</span>

                                                    }

                                                    <div>

                                                        <span class="fw-bold text-dark d-block">@doc.Title</span>

                                                        <small class="text-muted" style="font-size: 0.70rem;">@doc.FileName</small>

                                                    </div>

                                                </div>

                                            </td>

                                            <td>

                                                <span class="badge bg-light text-dark border">@doc.FileExtension?.ToUpperInvariant()</span>

                                            </td>

                                            <td>

                                                <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.72rem;">@doc.Category</span>

                                            </td>

                                            <td>

                                                <small class="text-muted">@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</small>

                                            </td>

                                            <td class="text-end">

                                                <div class="d-flex justify-content-end gap-1">

                                                    <a href="@doc.DocumentUrl" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1" style="font-size: 0.72rem;" title="İndir">

                                                        <i class="bi bi-download me-1"></i>İndir

                                                    </a>

                                                    @if (isDwg || isDxf)

                                                    {

                                                        <a href="/Metraj/DxfTakeoff/@projectId" class="btn btn-xs btn-success rounded-pill px-2.5 py-1 fw-bold shadow-xs" style="font-size: 0.72rem;" title="DWG Mahal ve Metraj Okuma">

                                                            <i class="bi bi-lightning-charge-fill me-1"></i>DWG Oku

                                                        </a>

                                                    }

                                                    <form asp-action="DeleteDrawing" method="post" class="d-inline" onsubmit="return confirm('Bu çizimi silmek istediğinize emin misiniz?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="id" value="@doc.Id" />

                                                        <input type="hidden" name="projectId" value="@projectId" />

                                                        <button type="submit" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-1" style="font-size: 0.72rem;" title="Sil">

                                                            <i class="bi bi-trash"></i>

                                                        </button>

                                                    </form>

                                                </div>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    }

                    else

                    {

                        <div class="alert alert-light border rounded-4 p-4 text-center mb-4">

                            <i class="bi bi-file-earmark-code fs-2 text-primary d-block mb-2"></i>

                            <h6 class="fw-bold text-dark mb-1">Henüz Mimari / DWG Çizimi Yüklenmedi</h6>

                            <p class="text-muted small mb-0">Yukarıdaki yükleme alanından mimari kat planı veya ruhsat projesi DWG dosyasını seçerek arşive ekleyebilirsiniz.</p>

                        </div>

                    }

                    <!-- 3. DETAYLI KAT PLANI MATRİSİ (AÇILIR / KAPANIR ÇEKMECE - VARSAYILAN KAPALI) -->

                    <div class="card border rounded-4 shadow-sm mt-3">

                        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#floorMatrixCollapse" aria-expanded="false">

                            <div class="d-flex align-items-center gap-2">

                                <i class="bi bi-grid-3x3-gap-fill text-primary fs-5"></i>

                                <div>

                                    <span class="fw-bold text-dark">Detaylı Kat Planı Matrisi (@Model.TotalFloorsCount Kat & Blok Bağlantıları)</span>

                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Yapı Yönetimi ile senkronize kat planı bağlantı tablosunu incelemek için tıklayın (Açılır Çekmece)</small>

                                </div>

                            </div>

                            <div class="d-flex align-items-center gap-2">

                                <span class="badge bg-success-subtle text-success border">@Model.FloorsWithPlanCount Kat Planı Bağlı</span>

                                <span class="badge bg-light text-muted border">@Model.TotalFloorsCount Kat Toplam</span>

                                <i class="bi bi-chevron-down text-muted"></i>

                            </div>

                        </div>

                        <div class="collapse" id="floorMatrixCollapse">

                            <div class="card-body p-3">

                                <div class="table-responsive rounded-3 border">

                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">

                                        <thead class="table-light">

                                            <tr>

                                                <th style="width: 18%;">Blok / Kule</th>

