<!-- MODAL: MİMAR CAD / DXF TESLİM ŞARTNAMESİ -->

<!-- ========================================== -->

<div class="modal fade" id="sartnameModal" tabindex="-1" aria-labelledby="sartnameModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content rounded-4 border-0 shadow-lg">

            <div class="modal-header bg-dark text-white border-0 py-3 rounded-top-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">GMK360 ŞARTNAME</span>

                    <h5 class="modal-title fw-bold mb-0" id="sartnameModalLabel">

                        <i class="bi bi-file-earmark-ruled-fill me-2 text-warning"></i>Mimari CAD / DXF Çizim Teslim Şartnamesi

                    </h5>

                </div>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>

            </div>

            <div class="modal-body p-4" id="sartnamePrintableArea">

                <div class="alert alert-info border-0 rounded-3 p-3 mb-4">

                    <div class="d-flex align-items-start gap-2">

                        <i class="bi bi-info-circle-fill fs-5 text-primary mt-1"></i>

                        <div>

                            <strong>Mimari Ofisler ve Tasarımcılar için Bilgilendirme:</strong>

                            <p class="mb-0 small">Bu standartlar belediye onaylı mimari projenizin doğrudan ERP ihale motoruna aktarılmasını sağlar. Mimarların çizim alışkanlıklarını değiştirmeden sadece 10 saniyelik <code>WBLOCK</code> ve metin layer kurallarına uyması yeterlidir.</p>

                        </div>

                    </div>

                </div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="card h-100 border rounded-3 p-3">

                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-1-circle-fill me-1"></i> Kat Bazında Tekil Çizim (WBLOCK Kuralı)</h6>

                            <p class="small text-muted mb-2">Tüm katların yan yana durduğu paftalar yerine, her kat ayrı bir DXF/DWG olarak kaydedilmelidir.</p>

                            <div class="bg-light p-2 rounded small font-monospace">

                                AutoCAD İpucu (10 Saniye):<br/>

                                1. Komut satırına <code>WBLOCK</code> yazın.<br/>

                                2. Katı seçin (Select Objects).<br/>

                                3. Dosya adını girip DXF olarak kaydedin.<br/>

                                Örn: <code>A_Blok_Zemin_Kat.dxf</code>, <code>A_Blok_1_Normal_Kat.dxf</code>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="card h-100 border rounded-3 p-3">

                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-2-circle-fill me-1"></i> Zorunlu Oda / Mahal İsimlendirmeleri</h6>

                            <p class="small text-muted mb-2">Her bağımsız bölümün içindeki alanlar tekil Türkçe büyük harf metin (TEXT / MTEXT) olarak yazılmalıdır:</p>

                            <div class="row g-1 small">

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>SALON</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>MUTFAK</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>YATAK ODASI</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>EBEVEYN BANYO</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>GENEL BANYO / WC</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>ANTRE / KORİDOR</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>BALKON 1</code></span></div>

                                <div class="col-6"><span class="badge bg-light text-dark border w-100 text-start"><code>GİYİNME ODASI</code></span></div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="card h-100 border rounded-3 p-3">

                            <h6 class="fw-bold text-warning mb-2"><i class="bi bi-3-circle-fill me-1"></i> Standart Kapı ve Pencere Ölçüleri</h6>

                            <p class="small text-muted mb-2">Tedarikçi ve taşeron masasında net sipariş adetleri için standart kasalar:</p>

                            <ul class="small text-muted mb-0 ps-3">

                                <li><strong>Daire Dış Giriş Kapısı:</strong> 100 &times; 210 cm Çelik Kapı</li>

                                <li><strong>Oda ve Mutfak Kapıları:</strong> 90 &times; 210 cm İç Oda Kapısı</li>

                                <li><strong>Banyo ve WC Kapıları:</strong> 75 &times; 210 cm Islak Hacim Kapısı</li>

                                <li><strong>Yangın Merdiveni Kapısı:</strong> 90 &times; 210 cm Panik Barlı Yangın Kapısı</li>

                            </ul>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="card h-100 border rounded-3 p-3">

                            <h6 class="fw-bold text-danger mb-2"><i class="bi bi-4-circle-fill me-1"></i> Merdiven & Ortak Alan Ayrımı</h6>

                            <p class="small text-muted mb-2">Taşeron ihalesi için basamak, rıht ve sahanlık ayrımı:</p>

                            <ul class="small text-muted mb-0 ps-3">

                                <li>Merdiven basamakları <code>MERDIVEN_BASAMAK</code> layerında polyline olmalı.</li>

                                <li>Korkuluk ve küpeşte çizgisi net belirtilmeli (Metretül hesaplanır).</li>

                                <li>Asansör kovası ve şaft boşlukları net kapatılmalı.</li>

                            </ul>

                        </div>

                    </div>

                </div>

                <div class="mt-4 p-3 bg-light rounded-3 border">

                    <h6 class="fw-bold mb-2">Örnek AutoCAD Layer Tablosu</h6>

                    <div class="table-responsive">

                        <table class="table table-sm table-bordered bg-white mb-0 small">

                            <thead class="table-light">

                                <tr><th>Layer Adı</th><th>Eleman</th><th>Tip</th><th>Açıklama</th></tr>

                            </thead>

                            <tbody>

                                <tr><td><code>DUVAR_DIS</code></td><td>Dış Cephe Duvarları</td><td>Polyline / Line</td><td>20'lik veya 25'lik bims/tuğla duvarlar</td></tr>

                                <tr><td><code>DUVAR_IC</code></td><td>İç Bölme Duvarları</td><td>Polyline / Line</td><td>10'luk veya 15'lik ara bölme duvarlar</td></tr>

                                <tr><td><code>KAPI</code></td><td>Tüm Kapı Blokları</td><td>Block / Arc</td><td>Genişlik ve açılış yönü içeren kapılar</td></tr>

                                <tr><td><code>PENCERE</code></td><td>Pencereler ve Fransız Balkonlar</td><td>Polyline / Line</td><td>Genişlik ve parapet yüksekliği</td></tr>

                                <tr><td><code>MAHAL_ISIM</code></td><td>Oda / Alan İsimleri</td><td>Text / MText</td><td>SALON, MUTFAK, BANYO metinleri</td></tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">

                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>

                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="printSartname()">

                    <i class="bi bi-printer me-1"></i> PDF Olarak Yazdır

                </button>

                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" onclick="copySartname()">

                    <i class="bi bi-clipboard-check me-1"></i> WhatsApp / Metin Kopyala

                </button>

            </div>

        </div>

    </div>

</div>

<script>

    function openUploadModalForFloor(buildingId, floorLevel, blockName, floorName) {

        document.getElementById('uploadDisciplineSelect').value = 'Mimari';

        document.getElementById('uploadBuildingId').value = buildingId;

        document.getElementById('uploadFloorLevel').value = floorLevel;

        document.getElementById('uploadTitleInput').value = blockName + ' - ' + floorName + ' Kat Planı';

        document.getElementById('floorBindingSection').style.display = 'block';

        var modal = new bootstrap.Modal(document.getElementById('uploadDrawingModal'));

        modal.show();

    }

    function openUploadModalForDiscipline(discipline) {

        document.getElementById('uploadDisciplineSelect').value = discipline;

        document.getElementById('uploadBuildingId').value = '';

        document.getElementById('uploadFloorLevel').value = '';

        document.getElementById('uploadTitleInput').value = discipline + ' Proje Paftası';

        onDisciplineChanged();

        var modal = new bootstrap.Modal(document.getElementById('uploadDrawingModal'));

        modal.show();

    }

    function onDisciplineChanged() {

        var disc = document.getElementById('uploadDisciplineSelect').value;

        var floorSection = document.getElementById('floorBindingSection');

        if (disc === 'Mimari') {

            floorSection.style.display = 'block';

        } else {

            floorSection.style.display = 'none';

        }

    }

    function printSartname() {

        var printContents = document.getElementById('sartnamePrintableArea').innerHTML;

        var originalContents = document.body.innerHTML;

        var printWindow = window.open('', '', 'height=800,width=900');

        printWindow.document.write('<html><head><title>GMK360 CAD/DXF Çizim Teslim Şartnamesi</title>');

        printWindow.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">');

        printWindow.document.write('</head><body class="p-4">');

        printWindow.document.write('<h3 class="fw-bold mb-3">GMK360 - MİMARİ CAD / DXF PROJE TESLİM ŞARTNAMESİ</h3>');

        printWindow.document.write(printContents);

        printWindow.document.write('</body></html>');

        printWindow.document.close();

        printWindow.focus();

        setTimeout(function() {

            printWindow.print();

            printWindow.close();

        }, 500);

    }

    function copySartname() {

        var text = "GMK360 PROJE ÇİZİM TESLİM ŞARTNAMESİ\\n\\n" +

                   "Sayın Mimar / Mühendisimiz,\\n" +

                   "Projemizin GMK360 Dijital Arşivine ve Metraj-İhale sistemine kabul edilebilmesi için çizimlerin aşağıdaki kurallara uygun teslim edilmesi rica olunur:\\n\\n" +

                   "1. KAT BAZINDA ÇIKTI (WBLOCK): Tüm katlar tek dosyada değil, her kat tekil DXF olarak (WBLOCK ile) kaydedilmelidir (Örn: A_Blok_Zemin_Kat.dxf).\\n" +

                   "2. ODA İSİMLERİ: Her mahalin içine büyük harfle tekil metin olarak ismi yazılmalıdır (SALON, MUTFAK, YATAK ODASI, EBEVEYN BANYO, GENEL BANYO, ANTRE, BALKON vb.).\\n" +

                   "3. STANDART KAPILAR: Giriş 100x210, Odalar 90x210, Banyo 75x210, Yangın 90x210 panik barlı.\\n" +

                   "4. LAYER DİSİPLİNİ: DUVAR_DIS, DUVAR_IC, KAPI, PENCERE, MAHAL_ISIM standart katmanları kullanılmalıdır.\\n\\n" +

                   "Desteğiniz için teşekkür eder, iyi çalışmalar dileriz.\\nGMK360 Proje Yönetim Merkezi";

        navigator.clipboard.writeText(text).then(function() {

            alert("Mimar Teslim Şartnamesi panoya kopyalandı! WhatsApp veya e-posta ile mimarınıza doğrudan iletebilirsiniz.");

        });

    }

</script>

<script>

    // ========================================================

    // ŞANTİYE MALZEME TEDARİK & SATIN ALMA MATRİSİ SCRİPTLERİ

    // ========================================================

    const projectId = '@Model.Project.Id';

    const storageKey = 'gmk360_material_matrix_proj_' + projectId;

        function togglePendingDrawings() {
        var content = document.getElementById('pendingDrawingsContent');
        if (!content) return;
        var bsCollapse = bootstrap.Collapse.getOrCreateInstance(content);
        bsCollapse.toggle();
    }

    function toggleMatrixCard() {
        var content = document.getElementById('masterBomContent');
        var chevron = document.getElementById('matrixHeaderChevron');
        var chevronText = document.getElementById('matrixHeaderChevronText');
        if (!content) return;
        var bsCollapse = bootstrap.Collapse.getOrCreateInstance(content);
        bsCollapse.toggle();
        setTimeout(function() {
            if (content.classList.contains('show')) {
                if (chevron) chevron.className = 'bi bi-chevron-up text-primary';
                if (chevronText) chevronText.innerText = 'Kapat';
            } else {
                if (chevron) chevron.className = 'bi bi-chevron-down text-secondary';
                if (chevronText) chevronText.innerText = 'Aç';
            }
        }, 350);
    }

        }, 350);

    }

    function onPriceChanged(input) {

        var row = input.closest('tr');

        var qty = parseFloat(input.getAttribute('data-qty')) || 0;

        var val = parseFloat(input.value) || 0;

        var itemId = input.getAttribute('data-item-id');

        var totalEl = document.getElementById('total_display_' + itemId);

        if (input.value && val > 0) {

            var total = qty * val;

            if (totalEl) totalEl.innerText = formatMoney(total) + ' ₺';

        } else {

            if (totalEl) totalEl.innerText = '—';

        }

        recalculateGrandTotals();

        markChangesDirty();

    }

    function onSpotCheckboxChanged(chk) {

        var row = chk.closest('tr');

        if (chk.checked) {

            row.classList.add('table-warning', 'bg-opacity-25');

        } else {

            row.classList.remove('table-warning', 'bg-opacity-25');

        }

        markChangesDirty();

    }

    function recalculateGrandTotals() {

        var rows = document.querySelectorAll('.material-matrix-row');

        var grandTotal = 0;

        var pricedCount = 0;

        rows.forEach(function(r) {

            var priceInput = r.querySelector('.unit-price-input');

            var qty = parseFloat(r.getAttribute('data-qty')) || 0;

            if (priceInput && priceInput.value) {

                var price = parseFloat(priceInput.value) || 0;

                if (price > 0) {

                    grandTotal += (qty * price);

                    pricedCount++;

                }

            }

        });

        var grandEl = document.getElementById('matrixGrandTotalDisplay');

        if (grandEl) grandEl.innerText = formatMoney(grandTotal) + ' ₺';

        var countEl = document.getElementById('pricedCountDisplay');

        if (countEl) countEl.innerText = pricedCount + ' / ' + rows.length + ' Kalem';

    }

    function formatMoney(amount) {

        return amount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    }

    function markChangesDirty() {

        saveToLocalStorage(false);

    }

    function saveMaterialMatrixPrices() {

        saveToLocalStorage(true);

    }

    function saveToLocalStorage(showToast) {

        var data = {};

        var rows = document.querySelectorAll('.material-matrix-row');

        rows.forEach(function(r) {

            var itemId = r.getAttribute('data-item-id');

            var priceInput = r.querySelector('.unit-price-input');

            var spotChk = r.querySelector('.spot-checkbox');

            var supplierInput = r.querySelector('.agreed-supplier-input');

            data[itemId] = {

                price: priceInput ? priceInput.value : '',

                spot: spotChk ? spotChk.checked : false,

                supplier: supplierInput ? supplierInput.value : ''

            };

        });

        localStorage.setItem(storageKey, JSON.stringify(data));

        if (showToast) {

            if (typeof Swal !== 'undefined') {

                Swal.fire({

                    title: 'Kaydedildi',

                    text: 'Tüm birim fiyatlar, spot işaretlemeleri ve anlaşılan firmalar başarıyla kaydedildi.',

                    icon: 'success',

                    timer: 2000,

                    showConfirmButton: false

                });

            } else {

                alert('Tüm birim fiyatlar, spot işaretlemeleri ve anlaşılan firmalar kaydedildi.');

            }

        }

    }

    function loadFromLocalStorage() {

        var raw = localStorage.getItem(storageKey);

        if (!raw) return;

        try {

            var data = JSON.parse(raw);

            var rows = document.querySelectorAll('.material-matrix-row');

            rows.forEach(function(r) {

                var itemId = r.getAttribute('data-item-id');

                var entry = data[itemId];

                if (entry) {

                    var priceInput = r.querySelector('.unit-price-input');

                    var spotChk = r.querySelector('.spot-checkbox');

                    var supplierInput = r.querySelector('.agreed-supplier-input');

                    if (priceInput && entry.price !== undefined && entry.price !== '') {

                        priceInput.value = entry.price;

                        var qty = parseFloat(r.getAttribute('data-qty')) || 0;

                        var val = parseFloat(entry.price) || 0;

                        var totalEl = document.getElementById('total_display_' + itemId);

                        if (val > 0 && totalEl) {

                            totalEl.innerText = formatMoney(qty * val) + ' ₺';

                        }

                    }

                    if (spotChk && entry.spot) {

                        spotChk.checked = true;

                        r.classList.add('table-warning', 'bg-opacity-25');

                    }

                    if (supplierInput && entry.supplier) {

                        supplierInput.value = entry.supplier;

                    }

                }

            });

            recalculateGrandTotals();

        } catch (e) {

            console.error('Failed to parse localStorage data', e);

        }

    }

    function searchMatrix(keyword) {

        var val = (keyword || '').toLowerCase().trim();

        var rows = document.querySelectorAll('.material-matrix-row');

        var headers = document.querySelectorAll('.branch-header-row');

        if (!val) {

            rows.forEach(r => r.style.display = '');

            headers.forEach(h => h.style.display = '');

            return;

        }

        var visibleBranches = new Set();

        rows.forEach(r => {

            var searchStr = r.getAttribute('data-search') || '';

            var supplierVal = (r.querySelector('.agreed-supplier-input')?.value || '').toLowerCase();

            if (searchStr.includes(val) || supplierVal.includes(val)) {

                r.style.display = '';

                visibleBranches.add(r.getAttribute('data-branch'));

            } else {

                r.style.display = 'none';

            }

        });

        headers.forEach(h => {

            h.style.display = visibleBranches.has(h.getAttribute('data-branch')) ? '' : 'none';

        });

    }

    function researchMaterial(itemId, title, branchName) {

        if (typeof Swal !== 'undefined') {

            Swal.fire({

                title: 'Malzeme Tedarikçi Araştırması',

                html: `<strong>${title}</strong> malzemesi için <strong>${branchName}</strong> tedarikçi havuzunda araştırma başlatılıyor.`,

                icon: 'info',

                confirmButtonText: 'Tedarikçi Havuzunda Aç'

            });

        } else {

            alert(`🔍 ${title} için ${branchName} havuzunda araştırma başlatıldı.`);

        }

    }

    function quickResearchBranch(branchName) {

        if (typeof Swal !== 'undefined') {

            Swal.fire({

                title: branchName,

                text: `${branchName} kategorisindeki kayıtlı tedarikçiler listeleniyor.`,

                icon: 'info',

                confirmButtonText: 'Tamam'

            });

        }

    }

    // EXCEL'E AKTAR (9 KOLON BİREBİR ŞABLON)

    function exportMaterialMatrixToExcel() {

        var rows = document.querySelectorAll('.material-matrix-row');

        if (!rows || rows.length === 0) {

            alert('Dışa aktarılacak malzeme kalemi bulunamadı.');

            return;

        }

        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">';

        html += '<head><meta charset="utf-8"><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Malzeme Tedarik Matrisi</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head>';

        html += '<body>';

        html += '<h2 style="font-family: Arial; color: #1e3a8a;">GMK360 - Şantİye Malzeme Tedarİk & Satın Alma Matrİsİ</h2>';

        html += '<p style="font-family: Arial; font-size: 11px; color: #555;">Proje: Yaşar Bey Apartmanı | Liste: A (Ham Proje Malzemeleri) | Tarih: ' + new Date().toLocaleDateString('tr-TR') + '</p>';

        html += '<table border="1" cellpadding="5" cellspacing="0" style="font-family: Arial; font-size: 11px; border-collapse: collapse;">';

        

        // 9 Kolon Başlığı

        html += '<tr style="background-color: #1e3a8a; color: #ffffff; font-weight: bold; text-align: center;">';

        html += '<th>A: Sıra No / Araştır</th>';

        html += '<th>B: Tedarikçi Türü</th>';

        html += '<th>C: Ürün Adı</th>';

        html += '<th>D: Miktar</th>';

        html += '<th>E: Birim</th>';

        html += '<th style="background-color: #047857; color: #ffffff;">F: Birim Fiyat (₺)</th>';

        html += '<th style="background-color: #047857; color: #ffffff;">G: Toplam (₺)</th>';

        html += '<th style="background-color: #b45309; color: #ffffff;">H: Ayrı Araştır (Spot)</th>';

        html += '<th style="background-color: #1e40af; color: #ffffff;">I: Anlaşılan Yer</th>';

        html += '</tr>';

        var globalIndex = 1;

        var grandTotal = 0;

        rows.forEach(function(r) {

            var branch = r.getAttribute('data-branch-name') || '';

            var title = r.getAttribute('data-title') || '';

            var qty = r.getAttribute('data-qty') || '0';

            var unit = r.getAttribute('data-unit') || '';

            var priceInput = r.querySelector('.unit-price-input');

            var priceVal = priceInput ? priceInput.value : '';

            var spotChk = r.querySelector('.spot-checkbox');

            var isSpot = spotChk && spotChk.checked;

            var supplierInput = r.querySelector('.agreed-supplier-input');

            var supplierVal = supplierInput ? supplierInput.value : '';

            var numPrice = parseFloat(priceVal) || 0;

            var numQty = parseFloat(qty) || 0;

            var numTotal = numPrice * numQty;

            grandTotal += numTotal;

            var rowBg = isSpot ? 'background-color: #fef3c7;' : '';

            html += `<tr style="${rowBg}">`;

            html += `<td align="center">${globalIndex++}</td>`;

            html += `<td><b>${branch}</b></td>`;

            html += `<td>${title}</td>`;

            html += `<td align="right">${numQty.toLocaleString('tr-TR')}</td>`;

            html += `<td align="center">${unit}</td>`;

            html += `<td align="right">${numPrice > 0 ? numPrice.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''}</td>`;

            html += `<td align="right">${numTotal > 0 ? numTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''}</td>`;

            html += `<td align="center">${isSpot ? 'EVET (Spot)' : 'Hayır'}</td>`;

            html += `<td>${supplierVal}</td>`;

            html += '</tr>';

        });

        // Genel Toplam Satırı

        html += '<tr style="background-color: #f1f5f9; font-weight: bold;">';

        html += '<td colspan="6" align="right">TOPLAM MALZEME MALİYETİ:</td>';

        html += `<td align="right" style="color: #047857;">${grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺</td>`;

        html += '<td colspan="2"></td>';

        html += '</tr>';

        html += '</table>';

        html += '</body></html>';

        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8' });

        var link = document.createElement('a');

        link.href = URL.createObjectURL(blob);

        link.download = "GMK360_Santiye_Malzeme_Tedarik_Matrisi.xls";

        document.body.appendChild(link);

        link.click();

        document.body.removeChild(link);

    }

    // Sayfa Yüklendiğinde Kayıtlı Verileri Yükle

    document.addEventListener('DOMContentLoaded', function() {

        loadFromLocalStorage();

    });

</script>

