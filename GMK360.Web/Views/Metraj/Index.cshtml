@{
    ViewData["Title"] = "Yapay Zeka Metraj Çıkarımı";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var projectId = ViewData["ProjectId"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-cpu text-primary me-2"></i>DXF Otomatik Metraj Modülü</h3>
        <p class="text-muted small mb-0">Mimari çizimi yükleyin, sistem blokları ve malzemeleri otomatik saysın.</p>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-5 text-center">
        <i class="bi bi-cloud-arrow-up text-primary" style="font-size: 4rem;"></i>
        <h4 class="fw-bold mt-3">DXF Dosyanızı Yükleyin</h4>
        <p class="text-muted mb-4">AutoCAD veya diğer çizim programlarından kaydettiğiniz .dxf uzantılı projeyi seçin.</p>
        
        <form asp-action="ParseDxf" asp-controller="Metraj" method="post" enctype="multipart/form-data" class="d-inline-block text-start" style="max-width: 400px; width: 100%;">
            <input type="hidden" name="projectId" value="@projectId" />
            <div class="mb-3">
                <input class="form-control form-control-lg" type="file" name="file" accept=".dxf" required>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold">
                <i class="bi bi-magic me-2"></i> Metrajı Başlat
            </button>
        </form>
    </div>
</div>
