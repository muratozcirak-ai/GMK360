@{
    ViewData["Title"] = "DNA Profili Yönetimi";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var projectId = ViewData["ProjectId"];
    var savedProfiles = ViewBag.SavedProfiles as List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaProfile>;
    var project = ViewBag.Project as GMK360.Core.Entities.Construction.ConstructionProject;
    var parametricTakeoff = ViewBag.ParametricTakeoff as List<GMK360.Web.Controllers.MetrajController.ParametricTakeoffItemDto>;

    var blocks = project?.Blocks?.Where(b => !b.IsExistingBuilding).ToList() ?? new List<GMK360.Core.Entities.Building>();
    var rootBlocks = blocks.Where(b => b.ParentBuildingId == null).ToList();
    double totalLand = project?.TotalLandArea ?? 0;
    double baseArea = rootBlocks.Sum(b => b.BaseArea ?? 0);
    if (baseArea <= 0 && blocks.Any()) baseArea = blocks.Sum(b => b.BaseArea ?? 0);
    if (baseArea <= 0) baseArea = project?.EskiBinaOturumAlani ?? (totalLand > 0 ? totalLand * 0.40 : 500);

    double taksRate = totalLand > 0 ? (baseArea / totalLand) * 100 : 0;
    int maxFloors = blocks.Any() ? blocks.Max(b => (b.TotalFloors ?? 0) + b.BasementFloors) : (project?.TotalFloors ?? 5);
    int maxBasement = blocks.Any() ? blocks.Max(b => b.BasementFloors) : 2;
    int totalApartments = blocks.Sum(b => b.TotalApartments);
    if (totalApartments <= 0) totalApartments = project?.TargetTotalApartments ?? 0;
    int totalShops = blocks.Sum(b => b.TotalShops);
    if (totalShops <= 0) totalShops = project?.TargetTotalShops ?? 0;

    var latestProf = savedProfiles?.FirstOrDefault();
    var latestDetails = latestProf?.Details?.ToList() ?? new List<GMK360.Core.Entities.Construction.Workflows.ProjectDnaDetail>();

    var zeminItem = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Zemin") || d.SelectedItem.Contains("Kaya") || d.SelectedItem.Contains("Kum"))?.SelectedItem ?? "Yumuşak / Kumlu Zemin";
    var ihataItem = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Sac") || d.SelectedItem.Contains("Tel Örgü") || d.SelectedItem.Contains("Pano"))?.SelectedItem ?? "Trapez Sac Kaplama";
    var ihataLen = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Çevre Sınırı Toplam") || (d.SelectedItem.Contains("İhata") && d.SelectedItem.Contains(":")) )?.SelectedItem ?? $"~{Math.Round(4 * Math.Sqrt(totalLand > 0 ? totalLand : 3600), 0)} mt";
    var molozItem = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Yıkım") || d.SelectedItem.Contains("Moloz") || d.SelectedItem.Contains("Enkaz"))?.SelectedItem ?? (project?.EskiKatSayisi > 0 ? "Eski Yapı Yıkımı & Moloz Var" : "Temiz Arsa");
    var kapiItem = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Kapı"))?.SelectedItem ?? "Sürgülü Sac Kapı (Raylı 6m)";
    var elektrikItem = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Elektrik") || d.SelectedItem.Contains("Abonelik") || d.SelectedItem.Contains("Jeneratör"))?.SelectedItem ?? "Şantiye Aboneliği + TMŞ Pano";
    var suItem = latestDetails.FirstOrDefault(d => d.SelectedItem.Contains("Su") || d.SelectedItem.Contains("Depo") || d.SelectedItem.Contains("Hidrofor"))?.SelectedItem ?? "15T Su Deposu + 3 HP Hidrofor";
    var structures = ViewBag.Structures as List<GMK360.Core.Entities.Building> ?? rootBlocks;
    var activeStructure = ViewBag.ActiveStructure as GMK360.Core.Entities.Building ?? structures?.FirstOrDefault();
    var workflowSteps = ViewBag.WorkflowSteps as List<GMK360.Web.Controllers.MetrajController.WorkflowStepItemDto>;
}

<div class="container-fluid py-4">
    <!-- ÜST BAŞLIK VE AKSİYONLAR -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success text-white px-2 py-1 rounded-pill fw-bold" style="font-size:0.75rem;">
                    <i class="bi bi-cpu-fill me-1"></i>KANAT 2 : HESAPLAMA & İHALE MOTORU
                </span>
                <span class="badge bg-light text-muted border px-2 py-1 rounded-pill" style="font-size:0.75rem;">
                    Proje #@projectId : @(project?.Name ?? "Proje")
                </span>
            </div>
            <h3 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="fas fa-dna text-success"></i>
                <span>Proje DNA Profili (Hesaplama & İhale Masası)</span>
            </h3>
            <p class="text-muted small mt-1 mb-0">Tek gerçek kaynak: GMK360 Veritabanı. Kat ve daire metrajları üzerinde malzeme & işçilik senaryolarını hesaplayın, toptan tedarikçi ve taşeron ihalelerini başlatın.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="/Metraj/DrawingArchive?projectId=@projectId" class="btn btn-outline-primary rounded-pill px-3 shadow-sm fw-bold">
                <i class="bi bi-folder2-open me-1 text-primary"></i> Kanat 1: Çizim Arşivi & Kabul &rarr;
            </a>
            <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="openNewProfileModal()">
                <i class="fas fa-plus me-1"></i> Yeni Senaryo / Profil
            </button>
        </div>
    </div>


    <!-- ADAY PROJEDEN GELEN ÖN DNA (MÜHENDİSLİK STATİK YÜK & ŞARTNAME) ÖZET ŞERİDİ -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-info" style="background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);">
        <div class="card-body p-2.5 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-info text-dark fw-bold rounded-pill px-2.5 py-1" style="font-size: 0.74rem;">
                    <i class="fas fa-dna me-1"></i>ÖN DNA (STATİK & ŞARTNAME KABULLERİ)
                </span>
                <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.76rem;">
                    <b>Dış Duvar:</b> @(string.IsNullOrWhiteSpace(project?.OuterWallType) ? "Ytong / Gazbeton" : project.OuterWallType.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.76rem;">
                    <b>Cephe Yalıtımı:</b> @(string.IsNullOrWhiteSpace(project?.FacadeInsulation) ? "Dıştan Mantolama" : project.FacadeInsulation.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.76rem;">
                    <b>Çatı:</b> @(string.IsNullOrWhiteSpace(project?.RoofMaterial) ? "Düz Teras Çatı" : project.RoofMaterial.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.76rem;">
                    <b>İç Bölme:</b> @(string.IsNullOrWhiteSpace(project?.InnerWallType) ? "Ytong / Gazbeton" : project.InnerWallType.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.76rem;">
                    <b>Isıtma/Tesisat:</b> @(string.IsNullOrWhiteSpace(project?.PlumbingType) ? "Yerden Isıtma" : project.PlumbingType.Replace("_", " "))
                </span>
                <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.76rem;">
                    <b>Temel Yalıtımı:</b> @(string.IsNullOrWhiteSpace(project?.FoundationInsulation) ? "Membran + XPS" : project.FoundationInsulation.Replace("_", " "))
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Metraj/BuildingWorkflow/@projectId" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 py-1" style="font-size: 0.74rem;">
                    <i class="fas fa-network-wired me-1"></i>5. Ekip & Malzeme Planlama Masası &rarr;
                </a>
                <a href="/ConstructionProject/Proposal/@projectId" class="btn btn-sm btn-outline-info text-dark fw-bold rounded-pill px-2.5 py-1" style="font-size: 0.74rem;">
                    <i class="bi bi-pencil-square me-1"></i>Ön DNA'yı Düzenle
                </a>
            </div>
        </div>
    </div>

    <!-- 4 KATMANLI DNA OKUMA & 3 YAPILIŞ MODELİ (KİM SATAR / KİM YAPAR / BAĞIMSIZ PAKETLER) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 border-top border-4 border-success bg-white">
        <div class="card-header bg-white border-bottom p-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-layer-group text-success"></i>
                    <span>4 Katmanlı DNA Okuma & 3 Yapılış Modeli (Kim Satar / Kim Yapar?)</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill small px-3 py-1">Canlı Mimari Motor</span>
                </h5>
                <small class="text-muted">DWG'den okunan ham malzemeler, bina teknik demirbaşları, hak sahibi seçimli daire içi kalemler ve bağımsız anahtar teslim paketlerin temin & uygulama modeli</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addIndependentPackageModal">
                    <i class="fas fa-plus-circle me-1"></i> + Bağımsız Paket Ekle (Kamelya / Asansör / Garaj Kapısı)
                </button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 text-secondary fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dnaFourLayerCollapse" aria-expanded="true">
                    <i class="fas fa-chevron-up"></i>
                </button>
            </div>
        </div>
        <div class="collapse show" id="dnaFourLayerCollapse">
            <div class="card-body p-3 px-4">
                <!-- 4 OKUMA KATMANI KARTLARI -->
                <div class="row g-3 mb-3">
                    <div class="col-lg-3 col-md-6">
                        <div class="border rounded-4 p-3 h-100 bg-primary bg-opacity-10 border-primary border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 small fw-bold">1. OKUMA: DWG KABA & TOPTAN</span>
                                <i class="fas fa-cubes text-primary fs-5"></i>
                            </div>
                            <div class="fw-bold text-dark small mb-1">Ham & Dökme Ana Malzemeler</div>
                            <p class="text-muted mb-2" style="font-size: 0.75rem;">DWG'den hacim/aks olarak okunur: <b>Beton (C30/37), Demir (Q8-Q26), Ytong/Tuğla, Membran, XPS</b>. Zevke göre değişmez, toptan birim fiyat bağlanır.</p>
                            <a href="/Metraj/DrawingArchive?projectId=@projectId" class="btn btn-xs btn-primary rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                <i class="bi bi-table me-1"></i>Malzeme Matrisinde Gör (@maxFloors Kat)
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="border rounded-4 p-3 h-100 bg-info bg-opacity-10 border-info border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-info text-dark rounded-pill px-2.5 py-1 small fw-bold">2. OKUMA: TEKNİK DEMİRBAŞ</span>
                                <i class="fas fa-fire-extinguisher text-info fs-5"></i>
                            </div>
                            <div class="fw-bold text-dark small mb-1">Kat & Sistem Demirbaşları</div>
                            <p class="text-muted mb-2" style="font-size: 0.75rem;">Projeden kat/adet okunur: <b>Yangın Hidrantları, Yangın Dolapları, Hidrofor, Kombi, Kolektör, Ana Pano</b>. Bina bitince <b>Bina Yönetimi & Dijital Evim</b>'e miras kalır.</p>
                            <span class="badge bg-white text-dark border rounded-pill px-2 py-1" style="font-size: 0.71rem;">
                                <i class="bi bi-shield-check text-success me-1"></i>@maxFloors Kat &bull; @totalApartments Daire Demirbaşı
                            </span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="border rounded-4 p-3 h-100 bg-warning bg-opacity-10 border-warning border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 small fw-bold">3. OKUMA: DAİRE İÇİ SEÇİMLİ</span>
                                <i class="fas fa-paint-roller text-warning fs-5"></i>
                            </div>
                            <div class="fw-bold text-dark small mb-1">Hak Sahibi & Müşteri Seçimli Perakende</div>
                            <p class="text-muted mb-2" style="font-size: 0.75rem;">Daire planlarından oda oda okunur: <b>Fayans Rengi, Boya Kodu, İç Kapı Modeli, Parke</b>. Toptan fiyatı müteahhit bağlar, rengi Hak Sahibi seçer.</p>
                            <a href="/ConstructionProject/Details/@projectId" class="btn btn-xs btn-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                <i class="bi bi-door-open me-1"></i>Daire & Hak Sahibi Seçimleri
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="border rounded-4 p-3 h-100 bg-success bg-opacity-10 border-success border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-success text-white rounded-pill px-2.5 py-1 small fw-bold">4. OKUMA: BAĞIMSIZ PAKETLER</span>
                                <i class="fas fa- elevator text-success fs-5"></i>
                            </div>
                            <div class="fw-bold text-dark small mb-1">Projede Olmayan / Anahtar Teslim</div>
                            <p class="text-muted mb-2" style="font-size: 0.75rem;">Aşırı çizim detayı gerektirmeyen dış/bağımsız paketler: <b>Asansör, Kamelya, Çocuk Parkı, Otomatik Garaj Kapısı</b>. Paket ihale (RFQ) ile alınır.</p>
                            <button type="button" class="btn btn-xs btn-success rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;" data-bs-toggle="modal" data-bs-target="#addIndependentPackageModal">
                                <i class="fas fa-plus me-1"></i>Paket Ekle / Yönet
                            </button>
                        </div>
                    </div>
                </div>

                <!-- KİM SATAR / KİM YAPAR (3 YAPILIŞ MODELİ & VİNÇ TETİKLEYİCİSİ MATRİSİ) -->
                <div class="table-responsive border rounded-3">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.80rem;">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-3">DNA İş Grubu / Paket</th>
                                <th>Okuma Katmanı</th>
                                <th>Yapılış Modeli (Kim Satar / Kim Yapar?)</th>
                                <th>Satın Alma & Saha Etkisi (Çift Alım Koruması)</th>
                                <th>Vinç / Ekipman Tetikleyicisi</th>
                            </tr>
                        </thead>
                        <tbody id="dnaExecutionModelBody">
                            <tr>
                                <td class="ps-3 fw-bold text-dark"><i class="fas fa-layer-group text-primary me-1"></i>Betonarme (Beton + Demir + Kalıp)</td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary border border-primary">1. Toptan Kaba</span></td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold border-primary" onchange="updateExecutionModelRow(this)">
                                        <option value="AYRI" selected>📦 Malzeme Ayrı (Biz) + 👷 İşçilik Ayrı (Ekip)</option>
                                        <option value="BERABER">🤝 Malzeme + Uygulama Beraber (Taşeron)</option>
                                        <option value="ANAHTAR">🔑 Anahtar Teslim Paket</option>
                                    </select>
                                </td>
                                <td class="exec-effect-cell text-muted">Beton santralden, demir tüccardan alınır; Kalıpçı, Demirci ve Beton Serim ekibi ayrı puantaj/hakedişle çalışır.</td>
                                <td><span class="badge bg-warning text-dark"><i class="fas fa-truck-loading me-1"></i>Zemine Kadar Vinçsiz &bull; 1. Kat+ Vinç Mecburi!</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-bold text-dark"><i class="fas fa-shield-virus text-info me-1"></i>Temel & Perde Su İzolasyonu</td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary border border-primary">1. Toptan Kaba</span></td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold border-primary" onchange="updateExecutionModelRow(this)">
                                        <option value="AYRI" selected>📦 Malzeme Ayrı (Biz) + 👷 İşçilik Ayrı (Ekip)</option>
                                        <option value="BERABER">🤝 Malzeme + Uygulama Beraber (Taşeron)</option>
                                    </select>
                                </td>
                                <td class="exec-effect-cell text-muted">Membran/XPS tedarikçiden alınır, uygulaması izolasyon ustasına m² işçilikle yaptırılır.</td>
                                <td><span class="badge bg-light text-secondary border">El Aletleri & Şaloma</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-bold text-dark"><i class="fas fa-home text-danger me-1"></i>Çatı Sistemi (@(string.IsNullOrWhiteSpace(project?.RoofMaterial) ? "Braas / Kiremit Çatı" : project.RoofMaterial.Replace("_", " ")))</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success border border-success">2. Paket / Sistem</span></td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold border-success" onchange="updateExecutionModelRow(this)">
                                        <option value="AYRI">📦 Malzeme Ayrı (Biz) + 👷 İşçilik Ayrı (Ekip)</option>
                                        <option value="BERABER" selected>🤝 Malzeme + Uygulama Beraber (Örn: Braas Çatı)</option>
                                        <option value="ANAHTAR">🔑 Anahtar Teslim Paket</option>
                                    </select>
                                </td>
                                <td class="exec-effect-cell text-success fw-semibold"><i class="fas fa-check-circle me-1"></i>Kiremit/kereste tek tek satın alma listesinden çekildi; malzeme + işçilik aynı çatı ekibi tarafından yapılır.</td>
                                <td><span class="badge bg-warning text-dark"><i class="fas fa-arrow-up me-1"></i>Çatı Kotunda Mobil Vinç / Gırgır</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-bold text-dark"><i class="fas fa-fire-extinguisher text-danger me-1"></i>Yangın Hidrantları, Kombi & Klima</td>
                                <td><span class="badge bg-info bg-opacity-10 text-info border border-info">2. Teknik Demirbaş</span></td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold border-dark" onchange="updateExecutionModelRow(this)">
                                        <option value="AYRI">📦 Cihaz Ayrı + Montaj Ustası Ayrı</option>
                                        <option value="BERABER">🤝 Malzemeli Mekanik Taşeron</option>
                                        <option value="ANAHTAR" selected>🔑 Anahtar Teslim Cihaz + Montaj + Devreye Alma</option>
                                    </select>
                                </td>
                                <td class="exec-effect-cell text-primary fw-semibold"><i class="fas fa-key me-1"></i>Yetkili servis/firma cihazı getirir, kurar ve garantisini başlatır; Bina Yönetimi & Dijital Evim'e aktarılır.</td>
                                <td><span class="badge bg-light text-dark border">Kat İçi Lojistik (T-1 Düz İşçi)</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-bold text-dark"><i class="fas fa-border-all text-warning me-1"></i>Daire İçi Fayans, Boya & İç Kapılar</td>
                                <td><span class="badge bg-warning bg-opacity-10 text-dark border border-warning">3. Daire Seçimli</span></td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold border-primary" onchange="updateExecutionModelRow(this)">
                                        <option value="AYRI" selected>📦 Malzeme Ayrı (Hak Sahibi Rengi) + 👷 Usta Ayrı</option>
                                        <option value="BERABER">🤝 Malzeme + Uygulama Beraber</option>
                                    </select>
                                </td>
                                <td class="exec-effect-cell text-muted">Hak sahibi rengini seçer; <b>T-1 günde düz işçi fayans ve yapıştırıcıyı kata dağıtır</b>, T=0'da usta koduyla iş başlar.</td>
                                <td><span class="badge bg-info bg-opacity-10 text-dark border border-info">T-1 Düz İşçi Kata Dağıtım + Gırgır Vinç</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-bold text-dark"><i class="fas fa-archway text-success me-1"></i>Asansör, Kamelya, Çocuk Parkı & Otomatik Garaj Kapısı</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success border border-success">4. Bağımsız Paket</span></td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold border-dark" onchange="updateExecutionModelRow(this)">
                                        <option value="ANAHTAR" selected>🔑 Anahtar Teslim Paket (Malzeme + Montaj + Ruhsat)</option>
                                        <option value="BERABER">🤝 Malzeme + Uygulama Beraber</option>
                                    </select>
                                </td>
                                <td class="exec-effect-cell text-primary fw-semibold"><i class="fas fa-key me-1"></i>DWG detay metrajı aranmaz; doğrudan uzman firmasından Anahtar Teslim RFQ teklifi toplanır.</td>
                                <td><span class="badge bg-light text-dark border">Firma Kendi Ekipmanıyla Gelir</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: DNA'YA BAĞIMSIZ PAKET EKLE (KAMELYA, ASANSÖR, ÇOCUK PARKI, OTOMATİK GARAJ KAPISI) -->
    <div class="modal fade" id="addIndependentPackageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-success text-white border-0 rounded-top-4">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>DNA'ya Bağımsız Paket / Donatı Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Mimari çizimde (DWG) ince detayı olmayan ancak şantiye bütçesi ve iş akışına dahil edilecek bağımsız paketleri buradan ekleyin.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Hazır Bağımsız Paket Şablonu</label>
                        <select class="form-select" id="indPkgPreset" onchange="document.getElementById('indPkgTitle').value = this.value;">
                            <option value="Otomatik Garaj Kapısı & Plaka Tanıma Sistemi">🚗 Otomatik Garaj Kapısı & Bariyer Sistemi</option>
                            <option value="Asansör Paketi (10 Kişilik Tam Otomatik + CE Tescil)">🛗 Asansör Paketi (Kabin + Ray + Motor + Tescil)</option>
                            <option value="Ahşap Kamelya & Pergola Oturma Alanı">🏕️ Ahşap Kamelya & Pergola Oturma Alanı</option>
                            <option value="Çocuk Oyun Parkı & Kauçuk Zemin Paketi">🛝 Çocuk Oyun Parkı & Kauçuk Zemin Paketi</option>
                            <option value="Yangın Hidrantı, Yangın Dolabı & Pompa Grubu">🚒 Yangın Hidrantı, Yangın Dolabı & Pompa Grubu</option>
                            <option value="Merkezi Uydu, Kamera & Diafon Zayıf Akım Paketi">📹 Kamera, Diafon & Zayıf Akım Paketi</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Paket / İmalat Adı</label>
                        <input type="text" id="indPkgTitle" class="form-control" value="Otomatik Garaj Kapısı & Plaka Tanıma Sistemi" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">Yapılış Modeli</label>
                            <select id="indPkgModel" class="form-select">
                                <option value="ANAHTAR" selected>🔑 Anahtar Teslim (Malzeme + Montaj)</option>
                                <option value="BERABER">🤝 Malzemeli Taşeron (Örn: Braas Çatı)</option>
                                <option value="AYRI">📦 Malzeme Bizden + İşçilik Ayrı</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Miktar / Ölçü</label>
                            <input type="text" id="indPkgQty" class="form-control" value="1 Paket (Anahtar Teslim)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" onclick="addIndependentPackageRow()">
                        <i class="fas fa-check me-1"></i> DNA Matrisine & İş Akışına Ekle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- PROFIL LISTESI (MIMARI) -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 border-top border-4 border-primary">
        <div class="card-header bg-white border-bottom p-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-list-ul text-primary"></i>
                    <span>Üretilen Mimari DNA Profilleri</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill fs-6 px-3">
                        @(savedProfiles?.Count ?? 0) Profil
                    </span>
                </h5>
                <p class="text-muted small mb-0 mt-1">Farklı statik ve mimari kombinasyonlar (DNA'lar) oluşturarak bütçe alternatifleri yaratın.</p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a href="/Metraj/DnaWizard/@projectId" target="_blank" class="btn text-white fw-bold shadow-sm rounded-pill px-3" style="background-color: #6f42c1; border-color: #6f42c1;">
                    <i class="fas fa-magic me-1"></i> + Profil Sihirbazı
                </a>
                <button class="btn btn-primary fw-bold shadow-sm rounded-pill px-3">
                    <i class="fas fa-file-import me-1"></i> Mimari DXF'i Oku ve Dağıt
                </button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 text-secondary fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dnaProfilesCollapse" aria-expanded="true" aria-controls="dnaProfilesCollapse" title="Daralt / Genişlet">
                    <i class="fas fa-sliders-h text-primary me-1"></i> Tablo <i class="fas fa-chevron-up ms-1"></i>
                </button>
            </div>
        </div>
        <div class="collapse show" id="dnaProfilesCollapse">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="configTable" style="table-layout: fixed; width: 100%;">
                    <colgroup>
                        <col style="width: 50px;">
                        <col style="width: 20%;">
                        <col style="width: 40%;">
                        <col style="width: 10%;">
                        <col style="width: 30%;">
                    </colgroup>
                    <thead class="bg-light text-secondary small">
                        <tr>
                            <th class="px-4 py-3" style="width: 50px;">
                                <div class="form-check">
                                    @{
                                        var approvedProfilesCount = savedProfiles?.Count(x => x.Status == "Tamamlandı") ?? 0;
                                    }
                                    <input class="form-check-input" type="checkbox" id="selectAll" @(approvedProfilesCount > 0 ? "checked" : "disabled") onchange="toggleAllConfigs(this)" title="@(approvedProfilesCount > 0 ? "Tüm onaylı profilleri seç" : "Henüz onaylı profil yok")">
                                </div>
                            </th>
                            <th class="py-3">Profil Adı</th>
                            <th class="py-3">Mimari & Statik Kararlar</th>
                            <th class="py-3 text-center">Durum</th>
                            <th class="py-3 text-end px-4">Profile Ait İş Akışı, Plan & İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="configListBody">
                        @if (savedProfiles != null && savedProfiles.Any())
                        {
                            foreach (var p in savedProfiles)
                            {
                                var isCompleted = (p.Status == "Tamamlandı");
                                <tr>
                                    <td class="px-4">
                                        <div class="form-check">
                                            @if (isCompleted)
                                            {
                                                <input class="form-check-input config-item-cb" type="checkbox" value="@p.Id" checked onchange="updateSelectedCount()">
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" disabled title="B2B teklifine göndermek için önce profili sihirbazda onaylayıp tamamlayınız.">
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                                                <i class="fas fa-dna fs-6"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark fs-6">@p.Name</div>
                                                <div class="small text-muted">
                                                    <i class="far fa-calendar-alt me-1"></i> @p.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill small fw-semibold">
                                                <i class="fas fa-layer-group me-1"></i> 20 Kalem Statik
                                            </span>
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info px-3 py-1 rounded-pill small fw-semibold">
                                                <i class="fas fa-sliders-h me-1"></i> @(p.Details?.Count ?? 0) Karar
                                            </span>
                                        </div>
                                        @if (p.Details != null && p.Details.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var d in p.Details.Take(4))
                                                {
                                                    <span class="badge bg-light text-dark border px-2 py-1 small fw-normal" title="@d.SelectedItem">
                                                        <i class="fas fa-check text-success me-1"></i>@d.SelectedItem
                                                    </span>
                                                }
                                                @if (p.Details.Count > 4)
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 small" title="Tüm kararlar için Düzenle'ye tıklayın">
                                                        +@(p.Details.Count - 4) detay daha
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!isCompleted)
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-3 py-2 rounded-pill fw-bold" title="Bu profil henüz tamamlanmadı, taslak aşamasındadır.">
                                                <i class="fas fa-pencil-ruler me-1 text-warning"></i> Taslak
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fw-bold">
                                                <i class="fas fa-check-circle me-1"></i> @p.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="d-inline-flex align-items-center gap-1 flex-wrap justify-content-end">
                                            @if (!isCompleted)
                                            {
                                                <!-- Taslak profil için SADECE Tamamlama ve Silme aksiyonları -->
                                                <a href="/Metraj/DnaWizard/@projectId?profileId=@p.Id" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary rounded-pill px-4 py-2 fw-bold shadow-xs text-nowrap" title="Reçeteyi tamamlamak ve onaylamak için sihirbaza gidin">
                                                    <i class="fas fa-magic me-1"></i> Profili Tamamla (Sihirbaz)
                                                </a>
                                                <button type="button" onclick="deleteProfile(@p.Id)" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-2" title="Taslağı Sil">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <!-- Onaylı profil için İş Akışı & Tedarik Masası linki (YENİ SEKMEDE) -->
                                                <a href="/Metraj/BuildingWorkflow/@projectId?profileId=@p.Id" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success rounded-pill px-3 py-2 fw-bold shadow-sm text-nowrap" title="Bu reçeteye göre yapı bazlı iş akışını, malzeme alım sıralamasını ve kadro puantaj planını aç">
                                                    <i class="fas fa-external-link-alt me-1"></i> Şantiye İş Akışı & Tedarik Masası &rarr;
                                                </a>
                                                <a href="/Metraj/SiteAgenda/@projectId?profileId=@p.Id" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary rounded-pill px-3 py-2 fw-bold text-nowrap" style="background-color: #6f42c1; border-color: #6f42c1;" title="Bu profile ait şantiye takvimini ajandaya işle">
                                                    <i class="fas fa-calendar-check me-1"></i> Otonom Ajanda
                                                </a>
                                                <a href="/Metraj/DnaWizard/@projectId?profileId=@p.Id" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-bold text-nowrap" title="Sihirbazda Reçeteyi İncele / Düzenle">
                                                    <i class="fas fa-pen me-1"></i> Düzenle
                                                </a>
                                                <button type="button" onclick="deleteProfile(@p.Id)" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-2" title="Sil">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            @if (savedProfiles == null || !savedProfiles.Any())
            {
                <div id="emptyState" class="text-center p-5">
                    <i class="fas fa-fingerprint fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="fw-bold text-dark">Henüz DNA Profili Üretilmedi</h5>
                    <p class="text-muted small">Sağ üstteki "Profil Üret" butonunu kullanarak ilk reçetenizi oluşturun.</p>
                </div>
            }
        </div>
            <div class="card-footer bg-light border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="text-muted small">
                    <i class="fas fa-info-circle me-1 text-primary"></i> 
                    Onaylanan profillerinizi şantiyedeki bağımsız yapılara (A Blok, Ortak Baza vb.) uygulamak ve malzeme/kadro planı çıkarmak için <strong>Şantiye Masası</strong>'na geçebilirsiniz.
                </div>
                @{
                    var completedCount = savedProfiles?.Count(x => x.Status == "Tamamlandı") ?? 0;
                    var firstCompletedId = savedProfiles?.FirstOrDefault(x => x.Status == "Tamamlandı")?.Id;
                }
                <div class="d-flex align-items-center gap-2">
                    <a href="/Metraj/BuildingWorkflow/@projectId@(firstCompletedId.HasValue ? $"?profileId={firstCompletedId}" : "")" 
                       target="_blank" rel="noopener noreferrer"
                       class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm">
                        <i class="fas fa-external-link-alt me-2"></i> Şantiye İş Akışı & Yapı Masası'na Git &rarr;
                    </a>
                    <button class="btn btn-success fw-bold px-4 rounded-pill shadow-sm" id="btnB2bMimari" @(completedCount > 0 ? "" : "disabled")>
                        <i class="fas fa-paper-plane me-2"></i> Seçili (<span id="selectedCount">@completedCount</span>) Profille B2B Teklifi İste
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MOTOR: DAİRE TİPLERİ VE MAHAL LİSTESİ (CRM ŞABLONLARI) -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 border-top border-4 border-danger">
        <div class="card-header bg-white border-bottom p-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-vector-square text-danger"></i>
                    <span>Daire Tipi ve Mahal Listesi (Tip Plan) Motoru</span>
                </h5>
                <p class="text-muted small mb-0 mt-1">Mimari DXF'ten daire tiplerini (Örn: 3+1 A Tipi) ve oda ölçülerini okuyarak CRM'de kullanılacak şablonları oluşturur.</p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-danger fw-bold text-white shadow-sm rounded-pill px-3">
                    <i class="fas fa-ruler-combined me-1"></i> Daire Tiplerini DXF'ten Oku
                </button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 text-secondary fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#crmCollapse" aria-expanded="false" aria-controls="crmCollapse" title="Daralt / Genişlet">
                    <i class="fas fa-sliders-h text-danger me-1"></i> Tablo <i class="fas fa-chevron-down ms-1"></i>
                </button>
            </div>
        </div>
        <div class="collapse" id="crmCollapse">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary small">
                            <tr>
                                <th class="px-4 py-3">Daire Tipi (Model)</th>
                                <th class="py-3 text-center">Toplam Hacim</th>
                                <th class="py-3 text-center">Oda / Mahal Sayısı</th>
                                <th class="py-3">Örnek Odalar (Özet)</th>
                                <th class="py-3 text-end px-4">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Örnek Görünüm (Boş State) -->
                            <tr>
                                <td colspan="5" class="text-center p-5">
                                    <i class="fas fa-border-all fa-3x text-muted mb-3 opacity-25"></i>
                                    <h6 class="fw-bold text-dark">Henüz Mimari DXF'ten Tip Planlar Okutulmadı</h6>
                                    <p class="text-muted small mb-0">Binadaki daire modellerini ve iç ölçülerini (Salon, Yatak Odası m2) çıkarmak için DXF'i okutun.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light border-top p-3 text-start">
                <span class="text-muted small">
                    <i class="fas fa-info-circle text-primary me-1"></i> <strong>Bilgi:</strong> Burada oluşturulan "Daire Tipleri", Satış/CRM sayfasında listelenen birebir dairelerin (Daire 1, Daire 2) üzerine şablon olarak giydirilecektir. B2B bütçesi çıkarmaz, CRM için metraj oluşturur.
                </span>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🚀 ŞANTİYE İCRA & BAŞLATMA MASASI (PROJENİN TÜM DNA'SI BURADA HARMANLANIR) -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-lg rounded-4 mb-5 text-white overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #0d6efd 100%);">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold fs-6 shadow-sm">
                            <i class="fas fa-check-double me-1"></i> Tüm DNA Hazır (Mimari + Tesisat + Daire Tipleri)
                        </span>
                        <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 rounded-pill small">
                            <i class="fas fa-shield-alt me-1"></i> İzole Yapı / Blok Kontrolü
                        </span>
                    </div>
                    <h3 class="fw-bold text-white mb-2">Şantiye İş Akışı, Malzeme Tedarik & Kadro Masası</h3>
                    <p class="text-white-50 mb-0 fs-6">
                        Statik kararlar, mekanik/elektrik ihtiyaçlar ve daire mahalleri tamamlandı. Şimdi projenin sahadaki hangi yapısından (<strong>A Blok</strong>, <strong>B&C Blok</strong> veya <strong>Ortak Baza</strong>) başlayacağınızı belirleyin; malzeme sipariş planını, usta kadrolarını ve şantiye takvimini izole olarak yönetin.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end text-center">
                    <a href="/Metraj/BuildingWorkflow/@projectId" target="_blank" rel="noopener noreferrer" class="btn btn-warning text-dark btn-lg fw-bold px-4 py-3 rounded-pill shadow-lg text-nowrap d-inline-flex align-items-center gap-2">
                        <i class="fas fa-external-link-alt"></i>
                        <span>Şantiye Masasını Yeni Sekmede Aç &rarr;</span>
                    </a>
                    <div class="small text-white-50 mt-2">
                        <i class="far fa-window-restore me-1"></i> Sayfanız kaybolmaz, yan sekmede rahatça çalışırsınız.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DINAMIK SABLON MODALI -->
<div class="modal fade" id="dynamicTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-info text-white border-0 p-4 sticky-top">
                <h5 class="modal-title fw-bold"><i class="fas fa-table me-2"></i>Dinamik DNA Şablonu (Soru & Seçenek Listesi)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light sticky-top shadow-sm">
                            <tr>
                                <th class="text-center" style="width: 50px;">Adım</th>
                                <th>Adım Adı</th>
                                <th>Soru (Başlık)</th>
                                <th>Seçenekler & İş Branşları (Ustalar)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(ViewBag.AllSteps != null) {
                                foreach(var step in (IEnumerable<GMK360.Core.Entities.Construction.Workflows.DnaTemplateStep>)ViewBag.AllSteps) {
                                    if(!step.Questions.Any()) {
                                        <tr>
                                            <td class="text-center fw-bold">@step.StepOrder</td>
                                            <td class="fw-bold text-primary">@step.StepName</td>
                                            <td class="text-muted fst-italic" colspan="2">Henüz soru eklenmedi.</td>
                                        </tr>
                                    } else {
                                        bool isFirstQ = true;
                                        foreach(var q in step.Questions) {
                                            <tr>
                                                @if(isFirstQ) {
                                                    <td class="text-center fw-bold" rowspan="@step.Questions.Count">@step.StepOrder</td>
                                                    <td class="fw-bold text-primary" rowspan="@step.Questions.Count">@step.StepName</td>
                                                }
                                                <td class="fw-medium">
                                                    @q.Title
                                                    @if(q.IsMultipleChoice) { <span class="badge bg-warning text-dark ms-1">Çoklu Seçim</span> }
                                                </td>
                                                <td>
                                                    @if(q.Options.Any()) {
                                                        <ul class="list-unstyled mb-0 small">
                                                            @foreach(var opt in q.Options) {
                                                                var profName = opt.Profession != null ? opt.Profession.Name : (q.Profession != null ? q.Profession.Name : "-Belirtilmedi-");
                                                                <li class="mb-1"><i class="fas fa-check text-success me-1"></i> @opt.OptionText <span class="badge bg-secondary ms-1">Usta: @profName</span></li>
                                                            }
                                                        </ul>
                                                    } else {
                                                        <span class="text-muted fst-italic">DXF'ten okunacak veya sabit.</span>
                                                    }
                                                </td>
                                            </tr>
                                            isFirstQ = false;
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- DXF / CAD ÇİZİM VE KAT PLANI TESLİM ŞARTNAMESİ MODALI -->
<div class="modal fade" id="sartnameModal" tabindex="-1" aria-labelledby="sartnameModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- HEADER -->
            <div class="modal-header bg-primary text-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-20 p-2 rounded-3">
                        <i class="fas fa-drafting-compass fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="sartnameModalLabel">
                            Mimari Kat Planı & DXF/CAD Çizim Teslim Şartnamesi
                        </h5>
                        <small class="text-white-50">GMK-CAD-SPEC-2026-V1 &bull; Proje: <strong>@(project?.Name ?? "Şantiye Projesi")</strong></small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-bold shadow-xs" onclick="printSartname()">
                        <i class="fas fa-print me-1 text-primary"></i> Yazdır / PDF
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold" onclick="copySartname()">
                        <i class="fas fa-copy me-1"></i> Kopyala
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
            </div>

            <!-- BODY -->
            <div class="modal-body p-4" id="sartnamePrintArea" style="background-color: #fbfbfb;">
                <div class="alert alert-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3 p-3 mb-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="fas fa-info-circle text-primary fs-5 mt-1"></i>
                        <div class="small">
                            <strong>Müteahhit ve Şantiye Mühendisleri İçin Kılavuz:</strong> Bu şartnameyi projenizin mimari müellifine veya dışarıdan hizmet aldığınız mimarlık ofisine teslim ediniz. Mimarlar, AutoCAD içinde <code>WBLOCK</code> komutuyla kat planlarını tek tıkla ve saniyeler içinde bu formata uygun olarak dışa aktarabilirler.
                        </div>
                    </div>
                </div>

                <!-- MADDE 1 -->
                <div class="card border-0 shadow-xs rounded-3 mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle px-2">1</span>
                            <span>Temel Kural: Kat Bazında Dışa Aktarım (WBLOCK Kuralı)</span>
                        </h6>
                        <p class="small text-muted mb-2">
                            Tüm bina katlarını tek bir devasa DWG dosyasında üst üste teslim etmeyiniz. GMK360 sistemi projeyi kat kat ve blok blok işler. Her bloğun her katı bağımsız bir dosya olarak teslim edilmelidir.
                        </p>
                        <div class="bg-light p-2 rounded-2 border small font-monospace">
                            <strong>Dosya İsimlendirme Standardı:</strong><br/>
                            &bull; <code>E_Blok_1_Normal_Kat.dxf</code> (veya Tip Kat ise: <code>E_Blok_Tip_Kat.dxf</code>)<br/>
                            &bull; <code>D_Blok_Zemin_Kat.dxf</code><br/>
                            &bull; <code>Ortak_Baza_Bodrum_1.dxf</code>
                        </div>
                    </div>
                </div>

                <!-- MADDE 2 -->
                <div class="card border-0 shadow-xs rounded-3 mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle px-2">2</span>
                            <span>Mahal ve Oda İsimlendirme Kuralları (MTEXT / TEXT)</span>
                        </h6>
                        <div class="alert alert-warning py-2 px-3 small border-0 rounded-2 mb-2 d-flex align-items-center gap-2">
                            <i class="fas fa-exclamation-triangle text-warning fs-5"></i>
                            <div><strong>DİKKAT: Oda İsimleri Kesinlikle Yazılmalıdır!</strong> Mimarlar bazen duvarları çizip içine isim yazmayı unutmaktadır. İsimsiz kapalı alanlar sistemde mahal olarak eşleşmez. Her odanın merkezine mutlaka oda adı ve m² alanı yazılmalıdır.</div>
                        </div>
                        <p class="small text-muted mb-2">
                            <strong>Kat Tipleri Ayrımı:</strong> Bodrum katlar (otopark/sığınak), zemin kat (dükkan/lobi), normal tip katlar (daireler) ve çatı katı ayrı bağımsız DXF olarak verilmelidir.
                        </p>
                        <p class="small text-muted mb-2">
                            Her odanın merkezinde standart Türkçe bağımsız bir metin bulunmalı ve altına m² alanı yazılmalıdır:
                        </p>
                        <div class="row g-2 small">
                            <div class="col-md-4">
                                <div class="p-2 border rounded bg-light">
                                    <strong class="text-primary d-block">Yaşam Alanları:</strong>
                                    <code>SALON</code>, <code>YATAK ODASI 1</code>, <code>YATAK ODASI 2</code>, <code>MUTFAK</code>, <code>GİYİNME ODASI</code>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded bg-light">
                                    <strong class="text-primary d-block">Islak Hacimler:</strong>
                                    <code>BANYO</code>, <code>EBEVEYN BANYO</code>, <code>ALATURKA WC</code>, <code>ÇAMAŞIR ODASI</code>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded bg-light">
                                    <strong class="text-primary d-block">Ortak & Açık Alanlar:</strong>
                                    <code>KAT HOLÜ</code>, <code>MERDİVEN EVİ</code>, <code>YANGIN HOLÜ</code>, <code>BALKON 1</code>, <code>BALKON 2</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MADDE 3 -->
                <div class="card border-0 shadow-xs rounded-3 mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle px-2">3</span>
                            <span>Kapı ve Doğrama Standartları (Standart vs. Özel İmalat)</span>
                        </h6>
                        <p class="small text-muted mb-2">
                            Sistem fabrikasyon seri üretim kapılar ile atölye imalatı özel kapıları otomatik ayrıştırır:
                        </p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Kapı Tipi</th>
                                        <th>Standart Ölçü (En × Boy)</th>
                                        <th>Etiket / Blok Adı</th>
                                        <th>Kullanım Alanı</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-bold">Daire Çelik Kapısı</td>
                                        <td>100 × 210 cm</td>
                                        <td><span class="badge bg-dark">D0</span> veya <code>CELIK_KAPI</code></td>
                                        <td>Daire Ana Giriş</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">İç Oda Kapısı</td>
                                        <td>90 × 210 cm</td>
                                        <td><span class="badge bg-primary">D1</span> veya <code>KAPI_90</code></td>
                                        <td>Salon, Yatak Odası, Mutfak</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Islak Hacim Kapısı</td>
                                        <td>75 × 210 cm / 80 × 210 cm</td>
                                        <td><span class="badge bg-info text-dark">D2</span> veya <code>KAPI_75</code></td>
                                        <td>Banyo, Ebeveyn Banyo, WC</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Yangın Güvenlik Kapısı</td>
                                        <td>100 × 210 cm</td>
                                        <td><span class="badge bg-danger">DY</span> veya <code>YANGIN_KAPISI</code></td>
                                        <td>Panik Barlı, 60-90 dk Dayanımlı</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-warning-emphasis">Özel İmalat Kapı</td>
                                        <td>Standart Dışı Ölçü</td>
                                        <td><span class="badge bg-warning text-dark">DOZEL</span> veya <code>DOZEL_110x230</code></td>
                                        <td>Atölye İmalatı (Siparişe Özel)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- MADDE 4 & 5 -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-xs rounded-3 h-100">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-circle px-2">4</span>
                                    <span>Merdiven ve Kat Ortak Alanları</span>
                                </h6>
                                <ul class="small text-muted ps-3 mb-0">
                                    <li class="mb-1"><strong>Merdiven Basamakları:</strong> Basamak çizgileri tek tek çizilmeli (16-18 rıht). Çıkış yönü oku gösterilmelidir.</li>
                                    <li class="mb-1"><strong>Tırabzan / Küpeşte:</strong> Merdiven iniş hattı açıkça belli olmalıdır.</li>
                                    <li><strong>Kat Holü & Yangın Dolabı:</strong> Yangın dolabı ve şaft kapakları blok veya metin olarak gösterilmelidir.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-xs rounded-3 h-100">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-circle px-2">5</span>
                                    <span>Tavsiye Edilen Katmanlar (Layers)</span>
                                </h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless small mb-0">
                                        <tbody>
                                            <tr><td><code>MIM_DUVAR</code></td><td class="text-muted">Duvar Çizgileri</td></tr>
                                            <tr><td><code>MIM_KAPI</code></td><td class="text-muted">Kapı Kanat & Yayları</td></tr>
                                            <tr><td><code>MIM_PENCERE</code></td><td class="text-muted">Doğrama & Denizlikler</td></tr>
                                            <tr><td><code>MIM_MAHAL</code></td><td class="text-muted">Oda İsimleri ve Alanlar</td></tr>
                                            <tr><td><code>MIM_MERDIVEN</code></td><td class="text-muted">Basamak Çizgileri</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MADDE 6: MİMARA AUTOCAD İPUCU -->
                <div class="card border-0 shadow-xs rounded-3 bg-light border">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="fas fa-magic text-success"></i>
                            <span>Mimar İçin 10 Saniyede AutoCAD'den Çıkarma Kılavuzu:</span>
                        </h6>
                        <ol class="small text-muted ps-3 mb-0 mt-2">
                            <li class="mb-1">AutoCAD'de ilgili kat planının etrafını <strong>seçim kutusu (window)</strong> içine alın.</li>
                            <li class="mb-1">Komut satırına <code>WBLOCK</code> yazıp <strong>Enter</strong> tuşuna basın.</li>
                            <li class="mb-1">Dosya formatı olarak <strong>AutoCAD 2018 DXF</strong> (veya DWG), dosya adı olarak <code>E_Blok_1_Kat.dxf</code> yazıp <strong>OK</strong> butonuna tıklayın.</li>
                            <li><em>İpucu:</em> Kaydetmeden önce <code>PURGE</code> komutunu çalıştırmanız dosya boyutunu %80 küçültecektir.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                    <i class="fas fa-shield-alt text-success me-1"></i> Bu şartname GMK360 B2B Satın Alma ve Taşeron Şartnameleriyle %100 uyumludur.
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-bold" onclick="copySartname()">
                        <i class="fas fa-copy me-1"></i> Şartname Metnini Kopyala
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" onclick="printSartname()">
                        <i class="fas fa-print me-1"></i> Yazdır / PDF Olarak Kaydet
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function deleteProfile(id) {
        if(confirm("Profili silmek istediğinize emin misiniz?")) {
            fetch("/Metraj/DeleteDnaProfile/" + id, { method: "POST" })
            .then(res => { if(res.ok) window.location.reload(); });
        }
    }

    function toggleAllConfigs(masterCb) {
        document.querySelectorAll(".config-item-cb").forEach(cb => cb.checked = masterCb.checked);
        updateSelectedCount();
    }

    function updateSelectedCount() {
        var count = document.querySelectorAll(".config-item-cb:checked").length;
        var countSpan = document.getElementById("selectedCount");
        if(countSpan) countSpan.innerText = count;
        var btn = document.getElementById("btnB2bMimari");
        if(btn) btn.disabled = (count === 0);
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateSelectedCount();
    });

    function printSartname() {
        var printContents = document.getElementById("sartnamePrintArea").innerHTML;
        var printWindow = window.open('', '', 'height=800,width=900');
        printWindow.document.write('<html><head><title>GMK360 Mimari CAD/DXF Teslim Şartnamesi</title>');
        printWindow.document.write('<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">');
        printWindow.document.write('<style>body{padding:25px; font-family:sans-serif;} table{width:100%; border-collapse:collapse; margin-bottom:1rem;} th,td{border:1px solid #dee2e6; padding:6px 10px; font-size:12px;} th{background:#f8f9fa;}</style>');
        printWindow.document.write('</head><body>');
        printWindow.document.write('<div style="border-bottom:2px solid #0d6efd; padding-bottom:10px; margin-bottom:15px;">');
        printWindow.document.write('<h3 style="margin:0; color:#0d6efd; font-size:20px;">GMK360 MİMARİ KAT PLANI VE CAD/DXF TESLİM ŞARTNAMESİ</h3>');
        printWindow.document.write('<small style="color:#555;">Proje: @(project?.Name ?? "Şantiye Projesi") | Doküman No: GMK-CAD-SPEC-2026-V1</small></div>');
        printWindow.document.write(printContents);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        setTimeout(function() { printWindow.print(); printWindow.close(); }, 500);
    }

    function updateExecutionModelRow(sel) {
        var row = sel.closest('tr');
        var effectCell = row ? row.querySelector('.exec-effect-cell') : null;
        if (!effectCell) return;
        if (sel.value === 'AYRI') {
            sel.className = 'form-select form-select-sm fw-bold border-primary';
            effectCell.className = 'exec-effect-cell text-muted';
            effectCell.innerHTML = '📦 Malzeme satın alma listesine düşer; işçilik ayrı usta puantajı veya m² işçilik hakedişi ile takip edilir.';
        } else if (sel.value === 'BERABER') {
            sel.className = 'form-select form-select-sm fw-bold border-success';
            effectCell.className = 'exec-effect-cell text-success fw-semibold';
            effectCell.innerHTML = '<i class="fas fa-check-circle me-1"></i>Alt ham malzemeler satın alma listesinden otomatik çekildi (mükerrer alım önlendi); Malzeme + Uygulama tek taşeron sözleşmesi oldu.';
        } else {
            sel.className = 'form-select form-select-sm fw-bold border-dark';
            effectCell.className = 'exec-effect-cell text-primary fw-semibold';
            effectCell.innerHTML = '<i class="fas fa-key me-1"></i>Anahtar Teslim Paket (RFQ): Cihaz + montaj + devreye alma uzman firmaya ihale edilir, Bina Yönetimi & Dijital Evim\'e miras kalır.';
        }
    }

    function addIndependentPackageRow() {
        var title = document.getElementById('indPkgTitle').value.trim();
        var model = document.getElementById('indPkgModel').value;
        var qty = document.getElementById('indPkgQty').value.trim();
        if (!title) return;
        var tbody = document.getElementById('dnaExecutionModelBody');
        if (tbody) {
            var tr = document.createElement('tr');
            tr.className = 'table-success';
            tr.innerHTML = `
                <td class="ps-3 fw-bold text-dark"><i class="fas fa-plus-circle text-success me-1"></i>${title} <span class="badge bg-white text-dark border ms-1">${qty}</span></td>
                <td><span class="badge bg-success text-white">4. Bağımsız Paket</span></td>
                <td>
                    <select class="form-select form-select-sm fw-bold border-dark" onchange="updateExecutionModelRow(this)">
                        <option value="ANAHTAR" ${model === 'ANAHTAR' ? 'selected' : ''}>🔑 Anahtar Teslim Paket</option>
                        <option value="BERABER" ${model === 'BERABER' ? 'selected' : ''}>🤝 Malzeme + Uygulama Beraber</option>
                        <option value="AYRI" ${model === 'AYRI' ? 'selected' : ''}>📦 Malzeme Ayrı + Usta Ayrı</option>
                    </select>
                </td>
                <td class="exec-effect-cell text-primary fw-semibold"><i class="fas fa-key me-1"></i>DNA profiline bağımsız paket olarak eklendi; Satın Alma (RFQ) ve İş Akışına bağlandı.</td>
                <td><span class="badge bg-light text-dark border">Uzman Firma / Montaj Ekibi</span></td>
            `;
            tbody.appendChild(tr);
        }
        var modalEl = document.getElementById('addIndependentPackageModal');
        var modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
    }

    function copySartname() {
        var text = `GMK360 MİMARİ KAT PLANI VE CAD/DXF TESLİM ŞARTNAMESİ (GMK-CAD-SPEC-2026-V1)\nProje: @(project?.Name ?? "Şantiye Projesi")\n\n`
            + `1. TEMEL KURAL: KAT BAZINDA DIŞA AKTARIM (WBLOCK KURALI)\n`
            + `Tüm binayı tek bir dosyada vermeyiniz. Her katı bağımsız DXF olarak kaydediniz.\n`
            + `Örn: E_Blok_1_Normal_Kat.dxf, D_Blok_Zemin_Kat.dxf\n\n`
            + `2. MAHAL İSİMLENDİRME KURALLARI (MTEXT/TEXT)\n`
            + `Her odanın merkezinde standart metin bulunmalı ve m² alanı yazılmalıdır: SALON, YATAK ODASI 1, YATAK ODASI 2, MUTFAK, BANYO, EBEVEYN BANYO, KAT HOLÜ, MERDİVEN EVİ.\n\n`
            + `3. KAPI VE DOĞRAMA STANDARTLARI\n`
            + `- Çelik Kapı: 100x210 cm (D0)\n`
            + `- Oda Kapısı: 90x210 cm (D1)\n`
            + `- Banyo/WC Kapısı: 75x210 cm (D2)\n`
            + `- Yangın Kapısı: 100x210 cm Panik Barlı (DY)\n`
            + `- Özel İmalat: Standart dışı ölçü net belirtilmelidir.\n\n`
            + `4. MERDİVEN VE ORTAK ALANLAR\n`
            + `Basamak çizgileri tek tek çizilmeli (16-18 rıht), çıkış yönü oku gösterilmelidir. Kat holü ve şaftlar net olmalıdır.\n\n`
            + `5. MİMAR İÇİN AUTOCAD ÇIKARMA YOLU:\n`
            + `Katı seçin -> WBLOCK yazıp Enter'a basın -> AutoCAD 2018 DXF olarak kaydedin.\n`;

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(function() {
                alert("✅ Şartname panoya kopyalandı! Mimara WhatsApp veya E-Posta ile gönderebilirsiniz.");
            }).catch(function() {
                prompt("Şartname metnini kopyalayın:", text);
            });
        } else {
            prompt("Şartname metnini kopyalayın:", text);
        }
    }
</script>

