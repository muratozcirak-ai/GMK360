@model IEnumerable<GMK360.Core.Entities.Property>
@{
    ViewData["Title"] = "Mülk Finans ve Vergi Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Mülk Portföyüm ve Finans</h2>
            <p class="text-muted">Sahip olduğunuz veya yönettiğiniz mülklerin vergi, aidat ve abonelik giderlerini buradan takip edin.</p>
        </div>
        <a href="/Property/Create" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-lg me-2"></i> Yeni Mülk Ekle</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border shadow-sm rounded-4 text-center py-5">
            <i class="bi bi-house-x fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold">Henüz Sistemde Mülkünüz Yok</h5>
            <p class="text-muted">Giderlerini takip etmek istediğiniz mülkleri sisteme ekleyerek başlayabilirsiniz.</p>
            <a href="/Property/Create" class="btn btn-outline-primary">İlk Mülkünü Ekle</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var property in Model)
            {
                var unpaidTotal = property.Payments.Where(p => !p.IsPaid).Sum(p => p.Amount);
                var paidTotal = property.Payments.Where(p => p.IsPaid).Sum(p => p.Amount);
                var upcomingDues = property.Payments.Where(p => !p.IsPaid && p.DueDate >= DateTime.Now).OrderBy(p => p.DueDate).FirstOrDefault();
                
                string iconClass = property.Type?.Name?.ToLower() switch
                {
                    "iş yeri" => "bi-shop text-warning",
                    "arsa" => "bi-tree text-success",
                    _ => "bi-building text-primary"
                };

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-circle p-3 me-3">
                                        <i class="bi @iconClass fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0 text-truncate" style="max-width: 180px;">@property.Title</h5>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@(property.Type?.Name ?? "Belirtilmemiş")</span>
                                    </div>
                                </div>
                                <a href="/Financial/Ledger/@property.Id" class="btn btn-sm btn-outline-dark rounded-circle" title="Defteri Aç"><i class="bi bi-arrow-right"></i></a>
                            </div>

                            <hr class="text-muted opacity-25">

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Ödenen Toplam</small>
                                    <span class="fw-bold text-success">@paidTotal.ToString("N2") ₺</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Bekleyen Gider</small>
                                    <span class="fw-bold text-danger">@unpaidTotal.ToString("N2") ₺</span>
                                </div>
                            </div>
                            
                            @if (upcomingDues != null)
                            {
                                <div class="alert alert-warning mb-0 py-2 px-3 border-0 rounded-3">
                                    <small class="d-flex align-items-center fw-bold">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        Yaklaşan: @upcomingDues.LiabilityType?.Name (@upcomingDues.DueDate.ToString("dd.MM.yyyy"))
                                    </small>
                                </div>
                            }
                            else if (unpaidTotal == 0)
                            {
                                <div class="alert alert-success mb-0 py-2 px-3 border-0 rounded-3">
                                    <small class="d-flex align-items-center fw-bold">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        Tüm ödemeler tamam!
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
