@model GMK360.Core.Entities.Property
@{
    ViewData["Title"] = Model.Title + " - Finansal Defter";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var liabilityTypes = ViewBag.LiabilityTypes as List<GMK360.Core.Entities.LiabilityType> ?? new List<GMK360.Core.Entities.LiabilityType>();
    
    // Mülk tipine göre Liability Type filtreleme mantığı (Örn: Arsaya Aidat gösterme)
    string propTypeName = Model.Type?.Name?.ToLower() ?? "";
    bool isLand = propTypeName.Contains("arsa") || propTypeName.Contains("tarla");
    bool isShop = propTypeName.Contains("iş") || propTypeName.Contains("dükkan");
    
    var filteredLiabilities = liabilityTypes.Where(l => {
        if (isLand && (l.Name.Contains("Aidat") || l.Name.Contains("DASK"))) return false; // Arsanın DASK'ı/Aidatı olmaz
        if (!isShop && l.Name.Contains("Tabela")) return false; // Sadece işyerinin tabela vergisi olur
        return true;
    }).ToList();
}

<div class="container mt-5">
    <!-- Üst Bilgi Başlığı -->
    <div class="d-flex align-items-center mb-4">
        <a href="/Financial/Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h3 class="fw-bold mb-0">@Model.Title <span class="badge bg-primary fs-6 ms-2">Finans Defteri</span></h3>
            <p class="text-muted mb-0">@Model.Type?.Name | @Model.GrossArea m² | Toplam: @Model.Payments.Count İşlem Kaydı</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 border-0 shadow-sm">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- Özet İstatistikleri -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white">
                <div class="card-body p-4">
                    <h6 class="text-white-50">Ödenmiş Toplam Gider</h6>
                    <h2 class="fw-bold mb-4">@Model.Payments.Where(p => p.IsPaid).Sum(p => p.Amount).ToString("N2") ₺</h2>
                    
                    <h6 class="text-white-50">Bekleyen (Ödenmemiş)</h6>
                    <h3 class="fw-bold text-warning mb-0">@Model.Payments.Where(p => !p.IsPaid).Sum(p => p.Amount).ToString("N2") ₺</h3>
                </div>
            </div>

            <!-- Hızlı Ekleme Formu -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle-dotted me-2 text-primary"></i> Yeni Gider Ekle</h5>
                    <form asp-action="AddExpense" method="post">
                        <input type="hidden" name="propertyId" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Gider/Vergi Türü</label>
                            <select name="liabilityTypeId" class="form-select bg-light border-0" required>
                                <option value="">Seçiniz...</option>
                                @foreach (var lt in filteredLiabilities)
                                {
                                    <option value="@lt.Id">@lt.Name (@lt.Category)</option>
                                }
                            </select>
                            @if(isLand){ <small class="text-muted d-block mt-1">Arsa tipine uygun kalemler filtrelenmiştir.</small> }
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Tutar (₺)</label>
                            <input type="number" step="0.01" name="amount" class="form-control bg-light border-0" required />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold">Son Ödeme (Vade)</label>
                                <input type="date" name="dueDate" class="form-control bg-light border-0" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Dönem (Opsiyonel)</label>
                                <input type="text" name="period" class="form-control bg-light border-0" placeholder="Örn: 2026/1" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Açıklama / Fatura No</label>
                            <input type="text" name="description" class="form-control bg-light border-0" />
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" name="isPaid" id="isPaidCheck" value="true">
                            <label class="form-check-label" for="isPaidCheck">Bu tutar ödendi mi?</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill">Kaydet</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Defter Listesi -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Geçmiş İşlemler ve Vadeler</h5>
                    
                    @if (!Model.Payments.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-journal-x fs-1 mb-3 d-block"></i>
                            <p>Henüz bu mülke ait finansal bir kayıt bulunmuyor.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr class="text-muted small">
                                        <th>Vade/Tarih</th>
                                        <th>Gider Türü</th>
                                        <th>Dönem</th>
                                        <th>Tutar</th>
                                        <th>Durum</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.Payments.OrderBy(p => p.IsPaid).ThenBy(p => p.DueDate))
                                    {
                                        <tr>
                                            <td>
                                                <span class="d-block fw-bold @(payment.IsPaid ? "" : (payment.DueDate < DateTime.Now ? "text-danger" : "text-dark"))">
                                                    @payment.DueDate.ToString("dd.MM.yyyy")
                                                </span>
                                                @if(payment.IsPaid && payment.PaymentDate.HasValue){
                                                    <small class="text-muted">Ödendi: @payment.PaymentDate.Value.ToString("dd.MM")</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="fw-bold">@payment.LiabilityType?.Name</span><br/>
                                                <small class="text-muted">@payment.Description</small>
                                            </td>
                                            <td>@payment.Period</td>
                                            <td class="fw-bold @(payment.IsPaid ? "text-success" : "text-danger")">
                                                @payment.Amount.ToString("N2") ₺
                                            </td>
                                            <td>
                                                @if (payment.IsPaid)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3"><i class="bi bi-check-circle me-1"></i> Ödendi</span>
                                                }
                                                else
                                                {
                                                    if(payment.DueDate < DateTime.Now) {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3"><i class="bi bi-x-circle me-1"></i> Gecikmiş</span>
                                                    } else {
                                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3"><i class="bi bi-clock me-1"></i> Bekliyor</span>
                                                    }
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!payment.IsPaid)
                                                {
                                                    <form asp-action="MarkAsPaid" asp-route-id="@payment.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill" title="Ödendi İşaretle">Ödedim</button>
                                                    </form>
                                                }
                                                <form asp-action="DeleteExpense" asp-route-id="@payment.Id" method="post" class="d-inline ms-1" onsubmit="return confirm('Bu gider kaydını silmek istediğinize emin misiniz?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Sil"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
