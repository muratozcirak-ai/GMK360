@model GMK360.Core.Entities.SeoSetting
@{
    ViewData["Title"] = Model == null ? "Yeni SEO Kuralý" : "SEO Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="fw-bold text-navy mb-4">@ViewData["Title"]</h2>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <form asp-action="@(Model == null ? "Create" : "Edit")" method="post">
            @if(Model != null) { <input type="hidden" asp-for="Id" /> }
            
            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label fw-bold">Sayfa Yolu (Örn: /Contact veya /DigitalHome veya *)</label>
                    <input asp-for="PagePath" class="form-control form-control-lg bg-light border-0" required placeholder="/Ýletiþim, /Evim vs." />
                    <small class="text-muted">(*) Yýldýz koyarsanýz tüm sayfalara varsayýlan olarak uygulanýr.</small>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Sayfa Baþlýðý (Title)</label>
                    <input asp-for="Title" class="form-control form-control-lg bg-light border-0" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Açýklama (Meta Description)</label>
                    <textarea asp-for="Description" class="form-control bg-light border-0" rows="3" required></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Anahtar Kelimeler (Virgülle ayýrýn)</label>
                    <input asp-for="Keywords" class="form-control form-control-lg bg-light border-0" placeholder="emlak, daire, kiralýk" />
                </div>
                <div class="col-12 text-end mt-5">
                    <a href="/AdminSeo" class="btn btn-light rounded-pill px-4 me-2">Ýptal</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>
