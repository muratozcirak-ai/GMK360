@model IEnumerable<GMK360.Core.Entities.SeoSetting>
@{
    ViewData["Title"] = "SEO Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy mb-1"><i class="ph ph-magnifying-glass me-2 text-orange"></i>SEO Yönetimi</h2>
        <p class="text-muted">Farklý sayfalarýnýz için dinamik Baþlýk (Title), Açýklama ve Anahtar Kelimeleri yönetin.</p>
    </div>
    <a href="/AdminSeo/Create" class="btn btn-orange fw-bold rounded-pill px-4"><i class="ph ph-plus fw-bold me-1"></i> Yeni Kural Ekle</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Sayfa Yolu</th>
                    <th>Baþlýk (Title)</th>
                    <th>Açýklama (Description)</th>
                    <th class="text-end pe-4">Ýþlemler</th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Any()) {
                    <tr><td colspan="4" class="text-center py-4 text-muted">Henüz SEO ayarý eklenmedi. (Tüm sayfalar ortak ayarý kullanýr)</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4"><span class="badge bg-primary rounded-pill">@item.PagePath</span></td>
                        <td class="fw-bold">@item.Title</td>
                        <td><small class="text-muted d-inline-block text-truncate" style="max-width:300px;">@item.Description</small></td>
                        <td class="text-end pe-4">
                            <a href="/AdminSeo/Edit/@item.Id" class="btn btn-sm btn-outline-navy rounded-pill me-2">Düzenle</a>
                            <form action="/AdminSeo/Delete/@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Silmek istediðinize emin misiniz?')"><i class="ph ph-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
