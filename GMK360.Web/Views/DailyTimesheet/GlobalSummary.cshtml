@model IEnumerable<dynamic>
@{
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml"; // Admin/Boss layout
    ViewData["Title"] = "Patron Özet - Tüm Şantiyeler";
    string targetDate = ViewBag.TargetDate;
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-steps text-primary me-2"></i> Tüm Şantiyeler Puantaj Özeti</h3>
            <p class="text-muted mb-0">Patron Paneli: Hangi şantiyede kaç kişi var, bugün toplam kaç yemek çıkacak?</p>
        </div>
        <div class="col-md-4 text-md-end">
            <input type="date" class="form-control d-inline-block w-auto shadow-sm rounded-pill px-3" value="@targetDate" onchange="window.location.href='/DailyTimesheet/GlobalSummary?date=' + this.value;">
        </div>
    </div>

    <!-- GRAND TOTAL CARDS -->
    <div class="row mb-4 g-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow bg-gradient-primary text-white">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-people fs-1 opacity-75 mb-2 d-block"></i>
                    <h5 class="fw-bold text-white mb-1">Kendi Personelimiz</h5>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.GrandTotalFirm</h2>
                    <span class="small opacity-75">Tüm Şantiyeler</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow bg-light border border-secondary border-opacity-25">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-hardhat text-secondary fs-1 opacity-75 mb-2 d-block"></i>
                    <h5 class="fw-bold text-dark mb-1">Taşeron Personeli</h5>
                    <h2 class="display-5 fw-bold text-dark mb-0">@ViewBag.GrandTotalSub</h2>
                    <span class="small text-muted">Tüm Şantiyeler</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow bg-gradient-warning text-dark border border-warning">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-cup-hot fs-1 opacity-75 mb-2 d-block"></i>
                    <h5 class="fw-bold text-dark mb-1">Bugünkü Yemek Çıkarımı</h5>
                    <h2 class="display-5 fw-bold text-dark mb-0">@ViewBag.GrandTotalMeals <small class="fs-6">Porsiyon</small></h2>
                    <span class="small text-dark opacity-75">Yemek Şirketine Bildirilecek Rakam</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow bg-gradient-danger text-white border border-danger">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-clock-history fs-1 opacity-75 mb-2 d-block"></i>
                    <h5 class="fw-bold text-white mb-1">Toplam Fazla Mesai</h5>
                    <h2 class="display-5 fw-bold text-white mb-0">@ViewBag.GrandTotalOvertime <small class="fs-6">Saat</small></h2>
                    <span class="small opacity-75">Tüm Şantiyeler Toplamı</span>
                </div>
            </div>
        </div>
    </div>

    <!-- PROJECT BREAKDOWN -->
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-building me-2 text-info"></i> Şantiye Bazlı Kırılım</h5>
    
    @if(!Model.Any()) {
        <div class="alert alert-warning rounded-4 shadow-sm border-0 p-4 text-center">
            <i class="bi bi-exclamation-triangle fs-1 text-warning mb-2 d-block"></i>
            <h5 class="fw-bold text-dark">Puantaj Verisi Yok</h5>
            <p class="mb-0 text-muted">Seçili tarih (<strong>@targetDate</strong>) için henüz hiçbir şantiyeden günlük puantaj kaydedilmemiş veya sisteme girilmemiştir.</p>
        </div>
    } else {
        <div class="row g-4">
            @foreach(var proj in Model) {
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 transition-all">
                        <div class="card-header bg-white border-0 pt-4 pb-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold text-dark mb-0 text-truncate" title="@proj.ProjectName">@proj.ProjectName</h5>
                                <a href="/DailyTimesheet/Project/@proj.ProjectId?date=@targetDate" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="bi bi-box-arrow-in-right"></i> Detay
                                </a>
                            </div>
                            <hr class="text-muted opacity-25">
                        </div>
                        <div class="card-body p-4 pt-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted fw-bold"><i class="bi bi-people text-primary me-2"></i> Firma Personeli:</span>
                                <span class="badge bg-primary rounded-pill fs-6 px-3">@proj.FirmWorkers</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted fw-bold"><i class="bi bi-hardhat text-secondary me-2"></i> Taşeronlar:</span>
                                <span class="badge bg-secondary rounded-pill fs-6 px-3">@proj.Subcontractors</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-warning bg-opacity-10 rounded-3">
                                <span class="text-dark fw-bold"><i class="bi bi-cup-hot text-warning me-2"></i> Yemek (Porsiyon):</span>
                                <span class="text-dark fw-bold fs-5">@proj.TotalMeals</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 bg-danger bg-opacity-10 rounded-3">
                                <span class="text-danger fw-bold"><i class="bi bi-clock text-danger me-2"></i> Fazla Mesai:</span>
                                <span class="text-danger fw-bold fs-5">@proj.TotalOvertime Saat</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-all { transition: all 0.3s ease; }
    .transition-all:hover { transform: translateY(-5px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
</style>
