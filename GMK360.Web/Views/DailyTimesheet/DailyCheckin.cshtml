@model IEnumerable<GMK360.Core.Entities.Construction.AgencyWorker>
@{
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    ViewData["Title"] = "Şantiye Puantaj ve Yoklama";
    var phases = ViewBag.Phases as IEnumerable<string>;
    var timesheets = ViewBag.Timesheets as IEnumerable<GMK360.Core.Entities.Construction.DailyTimesheet>;
    var existingTeams = ViewBag.ExistingTeams as List<string>;
    var existingSubcontractors = ViewBag.ExistingSubcontractors as List<string>;

    // Gruplama Mantığı:
    // Taşeron ise Taşeron Adına göre, Firma Personeli ise Çavuş'a göre
    var groupedWorkers = Model.GroupBy(w => w.WorkerType == "Taşeron Personeli" 
        ? "TASERON_" + (w.SubcontractorName ?? "Bilinmeyen Taşeron")
        : "EKIP_" + (w.ForemanId.HasValue ? w.ForemanId.Value.ToString() : w.Id.ToString())
    ).ToList();
}

<div class="container-fluid py-4">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-lg-4 col-md-5">
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check text-primary me-2"></i> Günlük Puantaj</h3>
            <p class="text-muted mb-0">@ViewBag.ProjectName - Tarih: @ViewBag.TargetDate</p>
        </div>
        <div class="col-lg-4 col-md-3 text-center my-2 my-md-0">
            <!-- YEMEK BİLDİRİM KARTI -->
            <div class="bg-warning bg-opacity-10 border border-warning rounded-pill py-2 px-3 d-inline-flex align-items-center gap-2 shadow-sm">
                <span class="fw-bold text-dark"><i class="bi bi-cup-hot-fill text-warning me-1"></i> Yemek:</span>
                <span class="fw-bold fs-5 text-danger" id="foodCounter">0</span> <span class="text-muted small">Porsiyon</span>
                
                <button type="button" class="btn btn-sm btn-success rounded-pill px-2 py-1 ms-2" onclick="shareCateringWhatsApp()" title="Yemek Şirketine WhatsApp ile Bildir">
                    <i class="bi bi-whatsapp"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" onclick="openSmsModal('Catering')" title="Yemek Şirketine SMS ile Bildir">
                    <i class="bi bi-chat-text"></i>
                </button>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 text-md-end d-flex flex-wrap align-items-center justify-content-md-end gap-1">
            <button class="btn btn-success fw-bold rounded-pill px-3 shadow-sm btn-sm" onclick="sharePuantajWhatsApp()" title="Puantaj Raporunu WhatsApp ile Paylaş">
                <i class="bi bi-whatsapp me-1"></i> WhatsApp
            </button>
            <button class="btn btn-outline-primary fw-bold rounded-pill px-3 shadow-sm btn-sm" onclick="openSmsModal('General')" title="Şantiye SMS Bildirimi Gönder">
                <i class="bi bi-chat-text-fill me-1"></i> SMS
            </button>
            <button class="btn btn-outline-success fw-bold rounded-pill px-3 shadow-sm btn-sm" data-bs-toggle="modal" data-bs-target="#quickAddModal">
                <i class="bi bi-person-plus-fill me-1"></i> Eleman Ekle
            </button>
            
            <button class="btn btn-danger fw-bold shadow-sm rounded-pill px-3 btn-sm" data-bs-toggle="modal" data-bs-target="#cashRequestModal" title="Şantiye Acil Nakit/Kasa Talebi">
                <i class="bi bi-cash-stack"></i> Nakit
            </button>
            <button class="btn btn-warning text-dark fw-bold shadow-sm rounded-pill px-3 btn-sm" data-bs-toggle="modal" data-bs-target="#dailyLogModal" title="Şantiye Günlük Jurnali">
                <i class="bi bi-journal-text"></i> Jurnal
            </button>
            <input type="date" class="form-control form-control-sm d-inline-block w-auto" id="dateSelector" value="@ViewBag.TargetDate" onchange="changeDate(this.value)">
            <button class="btn btn-primary fw-bold shadow-sm rounded-pill px-3 btn-sm" onclick="savePuantaj()">
                <i class="bi bi-save me-1"></i> Kaydet
            </button>
        </div>
    </div>

    @if(!Model.Any()) {
        <div class="alert alert-info text-center shadow-sm rounded-4 py-5">
            <i class="bi bi-info-circle fs-1 text-info d-block mb-3"></i>
            <h5 class="fw-bold">Havuzda Kayıtlı Eleman Yok</h5>
            <p>Yoklama yapabilmek için sisteme çalışan/taşeron eklemelisiniz. Yukarıdaki "Yeni Eleman Ekle" butonunu kullanarak hemen ilk ekibinizi oluşturabilirsiniz.</p>
        </div>
    } else {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4">Ekip / Personel Adı</th>
                                <th>Meslek</th>
                                <th class="text-center">Sabah</th>
                                <th class="text-center">Öğle</th>
                                <th class="text-center">Mesai (Saat)</th>
                                <th>Görev (Faz)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in groupedWorkers)
                            {
                                bool isSubcontractorGroup = group.Key.StartsWith("TASERON_");
                                string groupDisplayName = "";
                                string groupIdForJs = group.Key.Replace(" ", "_");

                                if(isSubcontractorGroup) {
                                    groupDisplayName = "TAŞERON FİRMA: " + group.Key.Replace("TASERON_", "");
                                } else {
                                    var leaderIdStr = group.Key.Replace("EKIP_", "");
                                    if(int.TryParse(leaderIdStr, out int leaderId)) {
                                        var leader = Model.FirstOrDefault(w => w.Id == leaderId);
                                        groupDisplayName = leader?.TeamName ?? leader?.FullName + " Ekibi";
                                    } else {
                                        groupDisplayName = "Bağımsız Çalışanlar";
                                    }
                                }
                                
                                <tr class="table-light border-bottom">
                                    <td colspan="6" class="ps-4 py-3">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h6 class="fw-bold mb-0 text-dark">
                                                @if(isSubcontractorGroup) {
                                                    <i class="bi bi-building text-warning me-2"></i>
                                                } else {
                                                    <i class="bi bi-people-fill text-info me-2"></i>
                                                }
                                                @groupDisplayName (@group.Count() Kişi)
                                            </h6>
                                            <div>
                                                <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="selectAllInTeam('@groupIdForJs', true)">Tümünü Seç</button>
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 ms-1" onclick="selectAllInTeam('@groupIdForJs', false)">Temizle</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                @foreach(var worker in group)
                                {
                                    var ts = timesheets?.FirstOrDefault(t => t.AgencyWorkerId == worker.Id);
                                    bool isMorning = ts?.IsMorningPresent ?? false;
                                    bool isAfternoon = ts?.IsAfternoonPresent ?? false;
                                    decimal overtime = ts?.OvertimeHours ?? 0;
                                    string selectedPhase = ts?.PhaseName ?? "";

                                    <tr class="team-member-@groupIdForJs worker-row" 
                                        data-worker-id="@worker.Id"
                                        data-worker-name="@worker.FullName"
                                        data-worker-team="@(isSubcontractorGroup ? (worker.SubcontractorName ?? "Taşeron") : (worker.TeamName ?? "Firma Ekibi"))"
                                        data-worker-type="@worker.WorkerType"
                                        data-worker-phone="@worker.PhoneNumber">
                                        <td class="ps-5">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar @(isSubcontractorGroup ? "bg-warning" : "bg-primary") text-white rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                                    @worker.FirstName.Substring(0,1)@worker.LastName.Substring(0,1)
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@worker.FullName</h6>
                                                    <small class="text-muted">
                                                        @worker.IdentityNumber
                                                        @if(!string.IsNullOrEmpty(worker.PhoneNumber) && worker.PhoneNumber != "Bilinmiyor")
                                                        {
                                                            <span class="ms-2 text-primary fw-semibold"><i class="bi bi-telephone"></i> @worker.PhoneNumber</span>
                                                        }
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(isSubcontractorGroup ? "bg-warning text-dark" : "bg-secondary")">@worker.Profession</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input fs-4 chk-morning attendance-chk" type="checkbox" @(isMorning ? "checked" : "") onchange="updateFoodCounter()">
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input fs-4 chk-afternoon attendance-chk" type="checkbox" @(isAfternoon ? "checked" : "") onchange="updateFoodCounter()">
                                            </div>
                                        </td>
                                        <td class="text-center" style="width: 150px;">
                                            <input type="number" class="form-control form-control-sm text-center input-overtime" min="0" step="0.5" value="@overtime" placeholder="0">
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm select-phase">
                                                <option value="">-- Faz Seçin --</option>
                                                @if(phases != null)
                                                {
                                                    foreach(var phase in phases)
                                                    {
                                                        if(!string.IsNullOrEmpty(phase))
                                                        {
                                                            if(phase == selectedPhase) {
                                                                <option value="@phase" selected>@phase</option>
                                                            } else {
                                                                <option value="@phase">@phase</option>
                                                            }
                                                        }
                                                    }
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>


<!-- KASA TALEBİ MODAL -->
<div class="modal fade" id="cashRequestModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger border-2 rounded-4 shadow-lg">
            <div class="modal-header bg-danger bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-cash-coin me-2"></i> Şantiye Acil Kasa/Avans Talebi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/SiteOperations/RequestCash" method="post">
                <div class="modal-body">
                    <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
                    <div class="alert alert-warning small">
                        <i class="bi bi-info-circle-fill me-1"></i> Bu talep anında merkez onaya düşecektir. Unutulma riski yoktur.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Talep Edilen Tutar (TL)</label>
                        <input type="number" name="amount" class="form-control form-control-lg text-danger fw-bold" required placeholder="Örn: 15000" min="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Gerekçe / Nerelere Harcanacak?</label>
                        <textarea name="reason" class="form-control" required rows="3" placeholder="Örn: Acil çivi, taşeron yemeği, hırdavat..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">Talebi Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ŞANTİYE JURNALİ MODAL -->
<div class="modal fade" id="dailyLogModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-warning border-2 rounded-4 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-journal-check text-warning me-2"></i> Şantiye Seyir Defteri (Jurnal)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/SiteOperations/SaveLog" method="post">
                <div class="modal-body bg-light">
                    <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
                    <p class="text-muted small mb-4">Şantiye şefi olarak günün özetini, yaşanan gecikmeleri ve ustaların hatalarını buraya not edin. Bu rapor doğrudan patrona ulaşır ve sorumluluğunuzu korur.</p>
                    
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold text-primary">1. Bugün Ne Yapıldı? (Genel İlerleme)</label>
                            <textarea name="progress" class="form-control border-primary" rows="2" placeholder="Örn: 3. Kat kalıpları %80 çakıldı..."></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold text-danger">2. Engeller, Sorunlar ve Gecikmeler</label>
                            <textarea name="obstacles" class="form-control border-danger bg-white" rows="3" placeholder="Örn: Ahmet Usta malzemeyi geç söylediği için iş 3 saat durdu."></textarea>
                            <small class="text-danger">Usta manipülasyonlarına karşı kendinizi koruyun.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-info">3. Acil Malzeme İhtiyacı</label>
                            <textarea name="needs" class="form-control border-info" rows="2" placeholder="Örn: Yarın sabah 10 torba çimento şart."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">4. Hava Durumu</label>
                            <input type="text" name="weather" class="form-control" placeholder="Örn: Yağmurlu, iş yavaşladı." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-5 w-100">Jurnali Kaydet ve Merkeze İlet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hızlı Eleman Ekle Modal -->
<div class="modal fade" id="quickAddModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus text-primary me-2"></i> Yeni Çalışan/Taşeron Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/DailyTimesheet/QuickAddWorker" method="post">
                <div class="modal-body">
                    <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
                    
                    <div class="row g-3">
                        <div class="col-12 mb-2">
                            <label class="form-label fw-bold">Çalışan Tipi</label>
                            <select class="form-select" name="workerType" id="workerTypeSelect" onchange="toggleWorkerTypeFields()">
                                <option value="Firma Personeli">Kendi Personelimiz</option>
                                <option value="Taşeron Personeli">Taşeron Personeli</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Adı</label>
                            <input type="text" name="firstName" class="form-control" required placeholder="Örn: Ahmet" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Soyadı</label>
                            <input type="text" name="lastName" class="form-control" required placeholder="Örn: Yılmaz" />
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">TC Kimlik No (İSG İçin)</label>
                            <input type="text" name="identityNumber" class="form-control" placeholder="Zorunlu Değil" />
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Meslek / Uzmanlık</label>
                            <input type="text" name="profession" class="form-control" placeholder="Örn: Kalıpçı Ustası" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Telefon Numarası</label>
                            <input type="tel" name="phoneNumber" class="form-control" placeholder="Örn: 0532 123 45 67" />
                        </div>

                        <!-- Kendi Personelimiz ise Ekip (Çavuş) -->
                        <div class="col-12" id="teamNameField">
                            <label class="form-label fw-bold">Bağlı Olduğu Ekip / Çavuş</label>
                            <input class="form-control" name="teamName" list="teamOptions" placeholder="Yeni ekip adı veya listeden seçin...">
                            <datalist id="teamOptions">
                                @if(existingTeams != null) {
                                    foreach(var t in existingTeams) {
                                        <option value="@t">@t</option>
                                    }
                                }
                            </datalist>
                        </div>

                        <!-- Taşeron ise Taşeron Firma Adı -->
                        <div class="col-12" id="subcontractorNameField" style="display: none;">
                            <label class="form-label fw-bold">Taşeron Firma Adı</label>
                            <input class="form-control" name="subcontractorName" list="subcontractorOptions" placeholder="Firma Adı (Örn: Gül İnşaat Hafriyat)">
                            <datalist id="subcontractorOptions">
                                @if(existingSubcontractors != null) {
                                    foreach(var t in existingSubcontractors) {
                                        <option value="@t">@t</option>
                                    }
                                }
                            </datalist>
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label fw-bold text-danger"><i class="bi bi-cash me-1"></i> Günlük Yevmiye / Hakediş (TL)</label>
                            <input type="number" name="dailyWage" class="form-control fw-bold text-danger bg-danger bg-opacity-10" required placeholder="0" value="0" min="0" step="50" />
                            <small class="text-muted">Taşeron işçisi için 0 bırakabilirsiniz. Rakamlar şef ekranında gizlidir.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4"><i class="bi bi-save me-1"></i> Kaydet ve Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SMS GÖNDERİM MODAL -->
<div class="modal fade" id="smsModal" tabindex="-1" aria-labelledby="smsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-chat-text-fill fs-3"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="smsModalLabel">Şantiye SMS Bildirim Merkezi</h5>
                        <p class="text-muted small mb-0">Catering firmasına, ustalara veya şirket merkezine SMS gönderin.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Şablon Seçici Butonlar -->
                <div class="d-flex gap-1 mb-3 bg-light p-1 rounded-3">
                    <button type="button" class="btn btn-sm btn-white flex-fill fw-bold shadow-xs active sms-type-btn" id="btnSmsTabCatering" onclick="selectSmsTemplate('Catering', this)">
                        🍲 Catering
                    </button>
                    <button type="button" class="btn btn-sm flex-fill fw-semibold sms-type-btn" id="btnSmsTabAbsentee" onclick="selectSmsTemplate('Absentee', this)">
                        ❌ Gelmeyenler
                    </button>
                    <button type="button" class="btn btn-sm flex-fill fw-semibold sms-type-btn" id="btnSmsTabSummary" onclick="selectSmsTemplate('Summary', this)">
                        📊 Puantaj
                    </button>
                    <button type="button" class="btn btn-sm flex-fill fw-semibold sms-type-btn" id="btnSmsTabCustom" onclick="selectSmsTemplate('Custom', this)">
                        ✍️ Özel
                    </button>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-dark small">Alıcı Telefon Numarası</label>
                    <input type="tel" class="form-control rounded-3 border-2" id="smsTargetPhone" placeholder="05XXXXXXXXX" />
                    <div class="form-text small text-muted">Telefon numarasını başında 0 olacak şekilde giriniz (Örn: 05321234567).</div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-bold text-dark small mb-0">SMS Mesaj Metni</label>
                        <span class="small text-muted" id="smsCharCount">0 Karakter (1 SMS)</span>
                    </div>
                    <textarea class="form-control rounded-3 border-2" id="smsMessageBody" rows="4" oninput="updateSmsCharCount()"></textarea>
                </div>

                <div class="alert alert-info py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <span>Sistem entegre NetGsm SMS geçidi üzerinden mesajı iletir. Test modunda SMS log konsoluna yazılır.</span>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="btnSubmitSms" onclick="sendSmsNotification()">
                    <i class="bi bi-send-fill me-1"></i> SMS Gönder
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeDate(dateStr) {
            window.location.href = `/DailyTimesheet/Project/@ViewBag.ProjectId?date=${dateStr}`;
        }

        function toggleWorkerTypeFields() {
            var type = document.getElementById('workerTypeSelect').value;
            if(type === 'Taşeron Personeli') {
                document.getElementById('teamNameField').style.display = 'none';
                document.getElementById('subcontractorNameField').style.display = 'block';
            } else {
                document.getElementById('teamNameField').style.display = 'block';
                document.getElementById('subcontractorNameField').style.display = 'none';
            }
        }

        function selectAllInTeam(teamId, state) {
            document.querySelectorAll(`.team-member-${teamId}`).forEach(row => {
                let morningChk = row.querySelector('.chk-morning');
                let afternoonChk = row.querySelector('.chk-afternoon');
                morningChk.checked = state;
                afternoonChk.checked = state;
            });
            updateFoodCounter();
        }

        function updateFoodCounter() {
            // Her çalışan için, Sabah VEYA Öğle işaretliyse 1 yemek sayılır.
            let count = 0;
            document.querySelectorAll('.worker-row').forEach(row => {
                let m = row.querySelector('.chk-morning').checked;
                let a = row.querySelector('.chk-afternoon').checked;
                if(m || a) {
                    count++;
                }
            });
            document.getElementById('foodCounter').innerText = count;
        }

        // Sayfa ilk yüklendiğinde yemek sayısını hesapla
        document.addEventListener('DOMContentLoaded', function() {
            updateFoodCounter();
        });

        function savePuantaj() {
            let records = [];
            document.querySelectorAll('.worker-row').forEach(row => {
                records.push({
                    WorkerId: parseInt(row.getAttribute('data-worker-id')),
                    IsMorning: row.querySelector('.chk-morning').checked,
                    IsAfternoon: row.querySelector('.chk-afternoon').checked,
                    Overtime: parseFloat(row.querySelector('.input-overtime').value) || 0,
                    Phase: row.querySelector('.select-phase').value
                });
            });

            if(records.length === 0) {
                alert('Kaydedilecek kimse yok. Önce eleman ekleyin.');
                return;
            }

            let payload = {
                ProjectId: @ViewBag.ProjectId,
                Date: document.getElementById('dateSelector').value,
                Records: records
            };

            fetch('/DailyTimesheet/SaveDaily', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    alert('Yoklama başarıyla kaydedildi! İaşe ve yevmiyeler güncellendi.');
                } else {
                    alert('Hata oluştu.');
                }
            })
            .catch(err => alert('Bir hata oluştu.'));
        }

        var projectName = "@Html.Raw(ViewBag.ProjectName ?? "Proje")";
        var targetDateStr = "@ViewBag.TargetDate";
        var currentProjectId = @ViewBag.ProjectId;
        var currentSmsType = 'Catering';

        function shareCateringWhatsApp() {
            var count = document.getElementById('foodCounter').innerText.trim() || '0';
            var msg = `🍲 *GMK360 ŞANTİYE YEMEK / İAŞE SİPARİŞİ*\n` +
                      `📍 *Proje:* ${projectName}\n` +
                      `📅 *Tarih:* ${targetDateStr}\n` +
                      `🍽️ *Talep Edilen Yemek:* ${count} Porsiyon\n\n` +
                      `Lütfen öğle servisini saat 12:00'ye kadar şantiye yemekhanesine ulaştırınız.\n` +
                      `Teşekkürler. - Şantiye Şefliği`;

            var url = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
            window.open(url, '_blank');
        }

        function sharePuantajWhatsApp() {
            var foodCount = document.getElementById('foodCounter').innerText.trim() || '0';
            var rows = document.querySelectorAll('.worker-row');
            
            var totalCount = rows.length;
            var presentCount = 0;
            var firmCount = 0;
            var subCount = 0;
            var totalOvertime = 0;
            var absentees = [];
            var teamStats = {};

            rows.forEach(function(r) {
                var m = r.querySelector('.chk-morning') ? r.querySelector('.chk-morning').checked : false;
                var a = r.querySelector('.chk-afternoon') ? r.querySelector('.chk-afternoon').checked : false;
                var ot = parseFloat(r.querySelector('.input-overtime')?.value) || 0;
                var name = r.getAttribute('data-worker-name') || 'Çalışan';
                var team = r.getAttribute('data-worker-team') || 'Genel Ekip';
                var type = r.getAttribute('data-worker-type') || 'Firma Personeli';

                if (m || a) {
                    presentCount++;
                    if (type === 'Taşeron Personeli') subCount++; else firmCount++;
                    totalOvertime += ot;
                    teamStats[team] = (teamStats[team] || 0) + 1;
                } else {
                    absentees.push(name);
                }
            });

            var msg = `🏗️ *GMK360 GÜNLÜK ŞANTİYE PUANTAJ RAPORU*\n` +
                      `📍 *Proje:* ${projectName}\n` +
                      `📅 *Tarih:* ${targetDateStr}\n\n` +
                      `🍲 *Bugünkü İaşe / Yemek:* ${foodCount} Porsiyon\n` +
                      `👥 *Sahadaki Mevcut:* ${presentCount} Kişi (${firmCount} Kendi Personelimiz, ${subCount} Taşeron)\n\n` +
                      `📊 *EKİP DAĞILIMI:*\n`;

            for (var t in teamStats) {
                msg += `• ${t}: ${teamStats[t]} Kişi\n`;
            }

            if (totalOvertime > 0) {
                msg += `\n⏰ *Toplam Fazla Mesai:* ${totalOvertime} Saat\n`;
            }

            if (absentees.length > 0) {
                msg += `\n❌ *Bugün Gelmeyenler (${absentees.length} Kişi):*\n`;
                var displayAbs = absentees.slice(0, 10).join(', ');
                msg += displayAbs;
                if (absentees.length > 10) msg += ` ve ${absentees.length - 10} kişi daha.`;
                msg += `\n`;
            }

            msg += `\nGMK360 Şantiye Yönetim Sistemi ile otomatik oluşturuldu.`;
            var url = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
            window.open(url, '_blank');
        }

        function openSmsModal(initialType) {
            currentSmsType = initialType || 'Catering';
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('smsModal'));
            modal.show();

            var btnId = 'btnSmsTab' + (currentSmsType === 'General' ? 'Summary' : currentSmsType);
            var btn = document.getElementById(btnId) || document.getElementById('btnSmsTabCatering');
            selectSmsTemplate(currentSmsType === 'General' ? 'Summary' : currentSmsType, btn);
        }

        function selectSmsTemplate(type, btn) {
            currentSmsType = type;
            document.querySelectorAll('.sms-type-btn').forEach(function(b) {
                b.classList.remove('active', 'btn-white', 'shadow-xs', 'fw-bold');
                b.classList.add('fw-semibold');
            });
            if (btn) {
                btn.classList.add('active', 'btn-white', 'shadow-xs', 'fw-bold');
                btn.classList.remove('fw-semibold');
            }

            var foodCount = document.getElementById('foodCounter').innerText.trim() || '0';
            var rows = document.querySelectorAll('.worker-row');
            var presentCount = 0;
            var overtimeTotal = 0;
            var absentees = [];

            rows.forEach(function(r) {
                var m = r.querySelector('.chk-morning')?.checked;
                var a = r.querySelector('.chk-afternoon')?.checked;
                var ot = parseFloat(r.querySelector('.input-overtime')?.value) || 0;
                var name = r.getAttribute('data-worker-name') || '';
                if (m || a) {
                    presentCount++;
                    overtimeTotal += ot;
                } else if (name) {
                    absentees.push(name);
                }
            });

            var body = '';
            if (type === 'Catering') {
                body = `[GMK360] ${projectName} santiyemiz icin ${targetDateStr} tarihinde toplam ${foodCount} porsiyon yemek hazirlanmasini rica ederiz.`;
            } else if (type === 'Absentee') {
                var absList = absentees.slice(0, 5).join(', ');
                body = `[GMK360] ${projectName} santiyemizde bugun (${targetDateStr}) yoklamada eksik personeller tespit edilmistir: ${absList || 'Yok'}.`;
            } else if (type === 'Summary') {
                body = `[GMK360] ${projectName} - ${targetDateStr}: Sahada ${presentCount} personel mevcut, ${foodCount} iase porsiyonu, ${overtimeTotal} sa mesai kaydedildi.`;
            } else if (type === 'Custom') {
                body = `[GMK360] ${projectName} Santiyesi: `;
            }

            document.getElementById('smsMessageBody').value = body;
            updateSmsCharCount();
        }

        function updateSmsCharCount() {
            var text = document.getElementById('smsMessageBody').value;
            var count = text.length;
            var smsParts = Math.ceil(count / 155) || 1;
            document.getElementById('smsCharCount').innerText = `${count} Karakter (${smsParts} SMS)`;
        }

        function sendSmsNotification() {
            var phone = document.getElementById('smsTargetPhone').value.trim();
            var text = document.getElementById('smsMessageBody').value.trim();
            var btn = document.getElementById('btnSubmitSms');

            if (!phone) {
                alert('Lütfen alıcı telefon numarasını giriniz.');
                return;
            }
            if (!text) {
                alert('Lütfen SMS metnini giriniz.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="bi bi-hourglass-split me-1"></i> Gönderiliyor...`;

            fetch('/DailyTimesheet/SendSmsNotification', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    ProjectId: currentProjectId,
                    PhoneNumber: phone,
                    MessageText: text,
                    NotificationType: currentSmsType
                })
            })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = `<i class="bi bi-send-fill me-1"></i> SMS Gönder`;

                if (data && data.success) {
                    alert(`SMS Bildirimi Başarılı!\n${data.message}`);
                    var modal = bootstrap.Modal.getInstance(document.getElementById('smsModal'));
                    if (modal) modal.hide();
                } else {
                    alert(`SMS gönderilemedi: ${data?.message || 'Bilinmeyen hata'}`);
                }
            })
            .catch(err => {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = `<i class="bi bi-send-fill me-1"></i> SMS Gönder`;
                alert('Sunucu ile iletişim kurulamadı.');
            });
        }
    </script>
}
