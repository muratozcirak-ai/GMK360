@{
    ViewData["Title"] = "Tedarikçi Pazar Yeri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO SECTION -->
<div class="bg-navy py-4 position-relative overflow-hidden" style="min-height: 250px; display: flex; align-items: center;">
    <div style="position: absolute; top: -50%; left: -20%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(255,193,7,0.15) 0%, rgba(0,0,0,0) 70%); border-radius: 50%;"></div>
    
    <div class="container position-relative z-1 py-4 mt-2">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill mb-3 fw-bold tracking-wide">B2B TİCARET & PAZAR YERİ</span>
                <h1 class="display-4 fw-bolder text-white mb-4" style="line-height: 1.1;">Siz Müşteri Aramayın, Bırakın <span class="text-warning">Ustalar ve Müşteriler</span> Sizi Bulsun.</h1>
                <p class="lead text-white-50 mb-4 pe-lg-5">
                    Dışarıda müşteri peşinde koşmayın. İnşaat malzemesinden hırdavata tüm ürünlerinizi GMK360'a ekleyin. Ekosistemdeki binlerce mülk sahibi, usta ve dev şantiyelerin malzeme talepleri doğrudan ekranınıza düşsün! Üstelik perakende ve toptan siparişlerinizi yöneteceğiniz açık hesap altyapısı da bizden.
                </p>
                <div class="d-flex gap-3">
                    <button class="btn btn-warning btn-lg px-5 rounded-pill fw-bold shadow-lg hover-lift text-dark">Mağazanızı Hemen Açın</button>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <i class="bi bi-box-seam-fill text-white-50" style="font-size: 10rem; opacity: 0.5;"></i>
            </div>
        </div>
    </div>
</div>

<div class="bg-warning py-3 shadow-sm">
    <div class="container text-center">
        <h6 class="text-navy fw-bold mb-0"><i class="bi bi-robot me-2"></i> Ürün Yükleme Ameleliğine Son! Yapay Zeka destekli "Kendi Kendini Dolduran Akıllı Vitrin" devrimi.</h6>
    </div>
</div>

<div class="container py-4 my-4">

    <!-- 1. AI Vitrin (The Game Changer) -->
    <div class="row align-items-center mb-4 pb-4 border-bottom">
        <div class="col-lg-6 mb-3 mb-lg-0 pe-lg-5">
            <h6 class="text-danger fw-bold text-uppercase mb-2">E-Ticarette Devrim</h6>
            <h2 class="fw-bold text-navy mb-4">Veri Girişi Yok! Kendi Kendini Dolduran "Akıllı Vitrin"</h2>
            <p class="text-muted lead fs-6 mb-4">
                Binlerce ürününüzü sisteme tek tek (resim, açıklama, fiyat) yüklemekle ve kura göre sürekli fiyat güncellemekle uğraşmayın.
            </p>
            <p class="text-muted small">
                Ekosistemdeki şantiye ve ustalardan gelen serbest taleplere (Örn: "10 Kilo Tavan Boyası") verdiğiniz teklifleri <strong>Yapay Zekamız (AI)</strong> arka planda okur. Sizin "Dyo Boya" sattığınızı öğrenir ve bu ürünü otomatik olarak dijital mağaza portföyünüze ekler. Siz sadece gelen işlere teklif verin, vitrininiz kendi kendine dolsun. Fiyat karmaşasına ve müşteriyle "ama sitede böyle yazıyordu" tartışmasına son.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-light rounded-5 p-4 shadow-sm border text-center">
                <h5 class="fw-bold text-navy mb-4 border-bottom pb-3"><i class="bi bi-cpu-fill text-danger me-2"></i> AI Öğrenme Algoritması</h5>
                
                <div class="card border-0 shadow-sm text-start mb-3 border-start border-4 border-warning">
                    <div class="card-body p-3">
                        <div class="text-muted small mb-1">Şantiyeden Gelen Talep:</div>
                        <div class="fw-bold text-dark small mb-2">"20 Adet ECA Banyo Bataryası lazım"</div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-navy text-white">Verdiğiniz Teklif: 45.000 ₺</span>
                        </div>
                    </div>
                </div>

                <div class="text-center mb-3">
                    <i class="bi bi-arrow-down-circle-fill text-success fs-3"></i>
                </div>

                <div class="card border border-success shadow-sm text-start bg-success bg-opacity-10">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-success small"><i class="bi bi-magic me-2"></i>Yapay Zeka Keşfi</div>
                            <div class="text-muted" style="font-size: 0.75rem;">ECA Marka ürünler otomatik olarak vitrininize (satış portföyünüze) eklendi.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. ERP Entegrasyonu -->
    <div class="row align-items-center mb-4 pb-4 border-bottom flex-lg-row-reverse">
        <div class="col-lg-6 mb-3 mb-lg-0 ps-lg-5">
            <h6 class="text-primary fw-bold text-uppercase mb-2">Ekosistemin Büyüklüğü</h6>
            <h2 class="fw-bold text-navy mb-4">ERP ve Şantiye Modülleriyle Tam Entegre (Hazır Müşteri)</h2>
            <p class="text-muted lead fs-6 mb-4">
                GMK360'ta tedarikçiler müşteri beklemez. Şantiye ERP'sini kullanan müteahhitler veya Bina Yönetimi kullanan tesisler sizin doğal müşterinizdir.
            </p>
            <p class="text-muted small">
                İnşaat modülümüzü kullanan bir müteahhit kaba inşaat metrajını çıkardığında veya bir tesis yöneticisi arıza kaydı açıp usta çağırdığında, sistem ihtiyaç duyulan malzemeyi <strong>doğrudan sizin vitrininizden çeker</strong> ve "Teklif İste" talebine dönüştürür. Ekosistemin gücüyle B2B satış hacminizi otomatikleştirin.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-dark rounded-5 p-4 shadow-lg text-white">
                <h6 class="text-white-50 text-center mb-4"><i class="bi bi-diagram-2-fill text-info me-2"></i> Kapalı Döngü Sipariş Ağı</h6>
                
                <div class="d-flex justify-content-between align-items-center mb-3 px-3">
                    <div class="text-center">
                        <i class="bi bi-buildings text-secondary fs-1 mb-2"></i>
                        <div class="small text-white-50">Şantiye / Tesis</div>
                    </div>
                    <div>
                        <i class="bi bi-arrow-right text-info fs-3"></i>
                    </div>
                    <div class="text-center">
                        <i class="bi bi-card-checklist text-primary fs-1 mb-2"></i>
                        <div class="small fw-bold text-info">Otomatik Talep</div>
                    </div>
                    <div>
                        <i class="bi bi-arrow-right text-warning fs-3"></i>
                    </div>
                    <div class="text-center">
                        <i class="bi bi-shop text-warning fs-1 mb-2"></i>
                        <div class="small fw-bold text-warning">Sizin Mağazanız</div>
                    </div>
                </div>
                
                <div class="text-center mt-3">
                    <span class="badge bg-light bg-opacity-10 text-white px-3 py-2">Dışarıdan reklam bütçesine gerek kalmadan hazır alıcı ağı.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Çift Katmanlı Fiyatlama ve Dijital İhale -->
    <div class="row align-items-center mb-4 pb-4 border-bottom">
        <div class="col-lg-6 mb-3 mb-lg-0 pe-lg-5">
            <h6 class="text-success fw-bold text-uppercase mb-2">Finans & B2B Ticaret</h6>
            <h2 class="fw-bold text-navy mb-4">Dinamik Fiyatlama, Açık Hesap ve <br>SMS'li Cari Takibi</h2>
            <p class="text-muted lead fs-6 mb-4">
                Sektörel ticari dengelerinizi bozmayın. Alıcıya göre dinamik fiyat sunun ve açık hesaplarınızı (veresiyeyi) dijital defterinizde hatasız takip edin.
            </p>
            <ul class="list-unstyled text-muted small mb-0">
                <li class="mb-3 d-flex"><i class="bi bi-tags-fill text-success me-3 fs-5 mt-1"></i> <div><strong>Toptana Ayrı, Perakendeye Ayrı:</strong> Mülk sahiplerine perakende satarken; sistemdeki yetkili müteahhitlere otomatik olarak "Pro İskontolu" B2B fiyatlarınızı gösterin.</div></li>
                <li class="mb-3 d-flex"><i class="bi bi-megaphone-fill text-success me-3 fs-5 mt-1"></i> <div><strong>Dev Projelerin Tedarikçisi Olun:</strong> İnşaat firmaları büyük alımlarda standart sepet kullanmaz. "Teklif İste (RFP)" tahtasına düşen dev hacimli taleplere özel teklif verin.</div></li>
                <li class="mb-0 d-flex"><i class="bi bi-journal-text text-success me-3 fs-5 mt-1"></i> <div><strong>SMS'li Cari ve Açık Hesap Takibi:</strong> Müşterilerinize verdiğiniz "açık hesap" (veresiye) malları dijital defterinize işleyin. Bakiye güncellendiğinde veya tahsilat yaklaştığında müşterinize otomatik SMS gitsin, kimseyle borç kavgasına girmeyin.</div></li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="bg-light rounded-5 p-4 border text-center shadow-sm">
                <h5 class="fw-bold text-navy mb-4 border-bottom pb-3"><i class="bi bi-percent text-success me-2"></i> Dinamik İskonto & Teklif Paneli</h5>
                
                <div class="card border-0 shadow-sm text-start mb-3 border-start border-4 border-info">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark small">Bireysel Müşteri (Ev Sahibi)</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Yüzey Temizleyici (5 Kg)</div>
                        </div>
                        <span class="badge bg-navy text-white px-3 py-2">₺ 140,00</span>
                    </div>
                </div>

                <div class="card border border-success shadow-sm text-start bg-success bg-opacity-10">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-success small"><i class="bi bi-building-check me-1"></i> Pro Şantiye / AVM (B2B Müşteri)</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Yüzey Temizleyici (5 Kg) - %25 İskonto</div>
                        </div>
                        <span class="badge bg-success px-3 py-2">₺ 105,00</span>
                    </div>
                </div>
                
                <div class="text-center mt-3">
                    <div class="badge bg-dark bg-opacity-10 text-navy px-3 py-2 rounded-pill small">
                        Sistem alıcının yetki sınıfını otomatik tanır ve doğru fiyatı gösterir.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Final CTA -->
<div class="bg-navy py-5 text-center text-white border-top border-secondary border-opacity-25">
    <div class="container">
        <h2 class="fw-bold mb-4">Sadece Bir E-Ticaret Sitesi Değil, Ticaret Ağınız</h2>
        <p class="lead text-white-50 mb-4 max-w-700 mx-auto">Ürün yükleme ameleliğini yapay zekaya bırakın, dev projelerin malzemesini %100 tahsilat garantisiyle siz verin.</p>
        <button class="btn btn-warning btn-lg px-5 rounded-pill fw-bold shadow-lg hover-lift text-dark">Hemen Tedarikçi Olun</button>
    </div>
</div>
