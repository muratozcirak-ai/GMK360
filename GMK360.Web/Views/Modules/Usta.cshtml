@{
    ViewData["Title"] = "Usta, Tadilat & Hizmet Ağı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO SECTION -->
<div class="bg-navy py-4 position-relative overflow-hidden" style="min-height: 250px; display: flex; align-items: center;">
    <div style="position: absolute; top: -50%; right: -20%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(13,110,253,0.15) 0%, rgba(0,0,0,0) 70%); border-radius: 50%;"></div>
    
    <div class="container position-relative z-1 py-4 mt-2">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 fw-bold tracking-wide">TÜRKİYE'NİN EN BÜYÜK HİZMET AĞI</span>
                <h1 class="display-4 fw-bolder text-white mb-4" style="line-height: 1.1;">Müşteri Aramayın, Bırakın <span class="text-primary">İş Fırsatları</span> Sizi Bulsun.</h1>
                <p class="lead text-white-50 mb-4 pe-lg-5">
                    Usta veya müşteri aramakla vakit kaybetmeyin. Ekosistemdeki binlerce mülk sahibi, şantiye ve site yöneticisinin açtığı iş ilanları doğrudan cebinize düşsün. Üstelik aldığınız işleri, ekiplerinizi ve kârınızı yöneteceğiniz "Taşeron ERP'si" de platformun hediyesi!
                </p>
                <div class="d-flex gap-3">
                    <button class="btn btn-primary btn-lg px-5 rounded-pill fw-bold shadow-lg hover-lift">Hizmet Ağına Katılın</button>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <i class="bi bi-tools text-white-50" style="font-size: 10rem; opacity: 0.5;"></i>
            </div>
        </div>
    </div>
</div>

<div class="bg-primary py-3 shadow-sm">
    <div class="container text-center">
        <h6 class="text-white fw-bold mb-0"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Ekosistem Avantajı: Mülk sahiplerinden ve bina yöneticilerinden gelen ek iş fırsatları doğrudan ekranınıza düşer!</h6>
    </div>
</div>

<div class="container py-4 my-4">

    <!-- 1. Yormayan Malzeme Defteri & Dijital Şantiye Defteri -->
    <div class="row align-items-center mb-4 pb-4 border-bottom">
        <div class="col-lg-6 mb-3 mb-lg-0 pe-lg-5">
            <h6 class="text-primary fw-bold text-uppercase mb-2">Basit, Hızlı, İşlevsel</h6>
            <h2 class="fw-bold text-navy mb-4">Karmaşa Yok: Yormayan Malzeme ve Maliyet Defteri</h2>
            <p class="text-muted lead fs-6 mb-4">
                "Stok Kodu Gir", "KDV Oranı Seç" diyen karmaşık muhasebe ekranlarını unutun. 
            </p>
            <p class="text-muted small mb-4">
                Malzemeyi ister tanıdık nalburdan alın, ister platformdaki Tedarikçi Pazar Yeri'nden sipariş edin. "Neyi, kimden, kaça aldım? Peşin mi, veresiye mi?" bilgisini basit bir liste halinde işleyin. Tedarikçi Pazar Yeri'mizden aldığınızda ise yapay zeka o masrafı otomatik olarak projenizin giderine yazar. Hesap makinesi kullanmadan günün sonunda işten ne kadar kâr ettiğinizi görün.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-light rounded-5 p-4 shadow-sm border text-center">
                <h5 class="fw-bold text-navy mb-3 border-bottom pb-3"><i class="bi bi-journal-check text-primary me-2"></i> Açık Hesap & Maliyet Kokpiti</h5>
                
                <div class="d-flex justify-content-between mb-3 text-start">
                    <div>
                        <div class="text-muted" style="font-size: 0.75rem;">Moda Projesi Anlaşılan Tutar:</div>
                        <div class="fw-bold text-dark">₺ 250.000</div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted" style="font-size: 0.75rem;">Net Kâr (Tahmini):</div>
                        <div class="fw-bolder text-success fs-5">₺ 62.400</div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm text-start mb-2 border-start border-4 border-danger">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark small">Toptancı Ahmet (Nalbur)</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Gider: 20 Torba Alçı, Boya Seti</div>
                        </div>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Açık Hesap (Borç)</span>
                    </div>
                </div>

                <div class="card border-0 shadow-sm text-start border-start border-4 border-success">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark small">GMK360 Pazar Yeri</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Gider: 5 Adet ECA Batarya</div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Otomatik İşlendi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Puantaj ve Yevmiye (Vardiya) -->
    <div class="row align-items-center mb-4 pb-4 border-bottom flex-lg-row-reverse">
        <div class="col-lg-6 mb-3 mb-lg-0 ps-lg-5">
            <h6 class="text-orange fw-bold text-uppercase mb-2">Taşeron Ekip Yönetimi</h6>
            <h2 class="fw-bold text-navy mb-4">Pratik Yevmiye ve Puantaj Takibi</h2>
            <p class="text-muted lead fs-6 mb-4">
                Ekipleriniz farklı şantiyelere mi dağıldı? Sahada kimse başıboş kalmasın.
            </p>
            <p class="text-muted small">
                Kim bugün işe geldi, kime kaç para yevmiye yazıldı, kimin ne kadar avans borcu var? Günlük puantajları ve taşeron hakedişlerini ajanda köşelerinde değil, cep telefonunuzdaki çok basit bir mobil arayüzle saniyeler içinde işaretleyin. İster taşeron bir boya firması olun, ister dev şantiyelere 50 kişilik elektrik ekibi sokun; personel giderleriniz %100 kontrol altında.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-dark rounded-5 p-4 shadow-lg text-white text-center">
                <h5 class="fw-bold text-white mb-4 border-bottom border-secondary pb-3"><i class="bi bi-people-fill text-orange me-2"></i> Ekip Puantaj Cetveli (Bugün)</h5>
                
                <div class="bg-white bg-opacity-10 rounded p-3 text-start mb-2 d-flex justify-content-between align-items-center border-start border-3 border-success">
                    <div>
                        <span class="fw-bold small d-block">Ali Yılmaz (Seramik Ustası)</span>
                        <span class="text-white-50" style="font-size:0.7rem;">Konum: Ataşehir Şantiye | Yevmiye: 2.500 ₺</span>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input class="form-check-input bg-success border-success" type="checkbox" checked disabled>
                    </div>
                </div>

                <div class="bg-white bg-opacity-10 rounded p-3 text-start mb-2 d-flex justify-content-between align-items-center border-start border-3 border-warning">
                    <div>
                        <span class="fw-bold small d-block">Mehmet Can (Elektrik)</span>
                        <span class="text-white-50" style="font-size:0.7rem;">Konum: Moda Projesi | Avans Aldı: 1.000 ₺</span>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input class="form-check-input bg-success border-success" type="checkbox" checked disabled>
                    </div>
                </div>
                
                <div class="bg-white bg-opacity-10 rounded p-3 text-start d-flex justify-content-between align-items-center border-start border-3 border-danger">
                    <div>
                        <span class="fw-bold small d-block">Veli Demir (Kaba İnşaat)</span>
                        <span class="text-danger" style="font-size:0.7rem;">Mazeretli (Gelmedi)</span>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input class="form-check-input bg-dark border-secondary" type="checkbox" disabled>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Güvenilir Ustalar Rehberi & Havuç Fırsatlar -->
    <div class="row align-items-center mb-2">
        <div class="col-lg-6 mb-3 mb-lg-0 pe-lg-5">
            <h6 class="text-success fw-bold text-uppercase mb-2">Network & Gelir Büyütme</h6>
            <h2 class="fw-bold text-navy mb-4">Kendi "Özel Usta Rehberiniz" ve Sistemden Gelen Hazır İşler</h2>
            <p class="text-muted lead fs-6 mb-4">
                Piyasada iyi usta bulmak zordur, bulduğunuzu kaybetmeyin.
            </p>
            <ul class="list-unstyled text-muted small mb-0">
                <li class="mb-3 d-flex"><i class="bi bi-person-hearts text-success me-3 fs-5 mt-1"></i> <div><strong>Kendi Kapalı Ağınız:</strong> Çalıştığınız ve güvendiğiniz alt taşeron ve ustaları kendi 'Özel Usta Rehberinize' ekleyin. Yeni bir götürü iş aldığınızda anında işe atayın.</div></li>
                <li class="mb-0 d-flex"><i class="bi bi-gift-fill text-success me-3 fs-5 mt-1"></i> <div><strong>Havuç Fırsatlar (Ek İş):</strong> Siz kendi ekibinizi yönetirken, GMK360'ı kullanan mülk sahiplerinden ve AVM/Bina yöneticilerinden gelen onarım ve tadilat talepleri, bölgenize göre doğrudan ekranınıza 'Ek İş Fırsatı' olarak düşsün.</div></li>
            </ul>
        </div>
        <div class="col-lg-6 text-center">
            <div class="bg-light rounded-5 p-4 border shadow-sm">
                <div class="alert alert-success border-success border-opacity-50 text-start shadow-sm mb-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-bell-fill fs-3 text-success me-3"></i>
                        <div>
                            <div class="fw-bold text-dark">Yeni Bir İş Talebi Var!</div>
                            <div class="text-muted" style="font-size: 0.8rem;">Moda AVM Yönetimi: "Ana Tesisat Su Kaçağı Tamiri"</div>
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button class="btn btn-success btn-sm fw-bold px-4 rounded-pill">Teklif Ver</button>
                    </div>
                </div>
                
                <h6 class="fw-bold text-navy mb-3 text-start"><i class="bi bi-star-fill text-warning me-2"></i> Favori Usta Rehberim</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill"><i class="bi bi-wrench text-secondary me-1"></i> Tesisatçı Ali</span>
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill"><i class="bi bi-brush text-secondary me-1"></i> Boyacı Kemal Usta</span>
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill"><i class="bi bi-lightning text-secondary me-1"></i> Elektrikçi Hasan</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Final CTA -->
<div class="bg-navy py-5 text-center text-white border-top border-secondary border-opacity-25">
    <div class="container">
        <h2 class="fw-bold mb-4">Taşeron Şirketinizi Cep Telefonunuzdan Yönetin</h2>
        <p class="lead text-white-50 mb-4 max-w-700 mx-auto">Gelir gider hesabınızı, puantajınızı ve açık hesaplarınızı bakkal defteri sadeliğinde dijitalleştirin.</p>
        <button class="btn btn-primary btn-lg px-5 rounded-pill fw-bold shadow-lg hover-lift">Hemen Ücretsiz Kayıt Olun</button>
    </div>
</div>
