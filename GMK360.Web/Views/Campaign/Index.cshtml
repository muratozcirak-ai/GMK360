@{
    ViewData["Title"] = "Referans & Kazanç Ağı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var networkList = ViewBag.NetworkList as IEnumerable<dynamic>;
}

<div class="container py-5">
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h1 class="fw-bold mb-2">Referans & Kazanç Ağım</h1>
            <p class="text-muted">Arkadaşlarınızı davet edin, platformu bedavaya kullanın ve aidatlarınızı ödeyin!</p>
        </div>
        <div class="col-md-4 text-end">
             <a href="/Wallet" class="btn btn-outline-primary rounded-pill px-4">
                 <i class="ph ph-wallet me-2"></i> Cüzdanıma Git
             </a>
        </div>
    </div>

    <div class="row mb-5">
        <!-- İstatistik Kartları -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white h-100" style="border-radius: 16px; background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
                <div class="card-body p-5 position-relative overflow-hidden">
                    <i class="ph ph-users-three position-absolute text-white opacity-25" style="font-size: 10rem; right: -20px; top: -20px;"></i>
                    <h5 class="text-uppercase mb-3" style="letter-spacing: 1px; color: rgba(255,255,255,0.9);">Kazanılan Toplam Net Gelir</h5>
                    <h1 class="display-3 fw-bold mb-0">@(((decimal)ViewBag.TotalBonus).ToString("C2"))</h1>
                    <p class="mt-3 mb-0" style="color: rgba(255,255,255,0.8);">Davet ettiğiniz @ViewBag.ReferredCount kişiden elde edilen stopaj/vergi sonrası net tutardır.</p>
                </div>
            </div>
        </div>

        <!-- Davet Kodu Kartı -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-body p-5">
                    <h5 class="fw-bold mb-4">Davet Kodunuz</h5>
                    <p class="text-muted mb-4">Bu kodu arkadaşlarınızla paylaşın veya direkt aşağıdaki linki gönderin. Arkadaşınız bu kodla üye olup ilk harcamasını yaptığında (abonelik, ilan, vb.) %20 anında cüzdanınıza yansısın.</p>
                    
                    <div class="bg-light p-4 rounded-3 text-center mb-4 border border-2 border-dashed border-primary">
                        <h2 class="fw-bold text-primary mb-0" id="referralCode" style="letter-spacing: 4px;">@ViewBag.ReferralCode</h2>
                    </div>

                    <div class="d-flex gap-3">
                        <button class="btn btn-primary flex-fill" onclick="copyInviteLink()">
                            <i class="ph ph-copy me-2"></i> Davet Linkini Kopyala
                        </button>
                        <a href="https://api.whatsapp.com/send?text=Sana harika bir dijital ev yönetimi platformu buldum. Hemen şu linkten üye ol: https://localhost:7058/Account/Register?ReferralCode=@ViewBag.ReferralCode" target="_blank" class="btn btn-success flex-fill">
                            <i class="ph ph-whatsapp-logo me-2"></i> WhatsApp'tan Gönder
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Davet Edilenler Listesi -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
            <h4 class="fw-bold mb-0">Davet Ağınız (@ViewBag.ReferredCount Kişi)</h4>
        </div>
        <div class="card-body p-4">
            @if (networkList == null || !networkList.Any())
            {
                <div class="text-center py-5">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="ph ph-user-plus fs-1 text-muted"></i>
                    </div>
                    <h5 class="fw-bold">Henüz kimseyi davet etmediniz</h5>
                    <p class="text-muted">Ağınızı büyütmeye hemen başlayın. Cüzdanınızı hediyelerle doldurun.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-muted small text-uppercase">Kullanıcı (Gizli)</th>
                                <th class="text-muted small text-uppercase">Katılım Tarihi</th>
                                <th class="text-muted small text-uppercase text-end">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in networkList)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="ph ph-user fs-5"></i>
                                            </div>
                                            <span class="fw-semibold">@item.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-muted">@item.Date.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Ağınıza Katıldı</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function copyInviteLink() {
        var link = window.location.origin + "/Account/Register?ReferralCode=@ViewBag.ReferralCode";
        navigator.clipboard.writeText(link).then(function() {
            alert("Davet linkiniz panoya kopyalandı!\n\n" + link);
        }, function(err) {
            console.error('Kopyalama başarısız: ', err);
        });
    }
</script>
