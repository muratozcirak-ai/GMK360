@{
    Layout = "_Layout";
    var projectId = ViewContext.RouteData.Values["id"]?.ToString();
    if(string.IsNullOrEmpty(projectId)) 
    {
        projectId = Context.Request.Query["projectId"].ToString();
    }
}

<div class="container-fluid px-4 px-xl-5 mt-4">
    <div class="row">
        <!-- PROJE ÖZEL SOL MENÜ -->
        <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-building-check me-2"></i> Proje Yönetimi
                </div>
                
                <div class="p-3 bg-light border-bottom text-center">
                    <a href="/ConstructionProject/Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Tüm Þantiyelere Dön
                    </a>
                </div>

                <div class="list-group list-group-flush">
                    
                    <a href="/ConstructionProject/Details/@projectId" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Proje Panosu
                    </a>
                    
                    <!-- PROJE ÝÞÇÝ VE TAÞERONLARI -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        TEDARÝK, TAÞERON & ÝÞÇÝLER
                    </div>
                    
                    <a href="/SubcontractorContract/ProjectContracts/@projectId" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "ProjectContracts" ? "active" : "")">
                        <i class="bi bi-file-earmark-text me-2"></i> Taþeron & Malzeme Baðlantýlarý (Sözleþmeler)
                    </a>
                    
                    <a href="/PhaseWorkerDemands/ProjectWorkers/@projectId" class="list-group-item list-group-item-action">
                        <i class="bi bi-people-fill me-2"></i> Proje Ýþçi Listesi
                    </a>
                    
                    <a href="/DailyTimesheets/ProjectTimesheet/@projectId" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-check-fill me-2"></i> Proje Puantajý
                    </a>

                    <!-- PROJE MÝMARÝ VE ONAYLAR -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        YAPIM AÞAMALARI
                    </div>
                    
                    <a href="/ConstructionProject/Phases/@projectId" class="list-group-item list-group-item-action">
                        <i class="bi bi-layers-fill me-2"></i> Proje Fazlarý (Aþamalar)
                    </a>
                    
                    <a href="/DocumentArchive/Index?context=construction&projectId=@projectId" class="list-group-item list-group-item-action">
                        <i class="bi bi-folder-fill me-2"></i> Proje Evraklarý & Planlar
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana Ýçerik -->
        <div class="col-xl-10 col-lg-9 col-md-8">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

