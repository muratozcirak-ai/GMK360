    <!-- ŞANTİYE KONUM MODALI -->



    <div class="modal fade" id="santiyeLocationModal" tabindex="-1" aria-labelledby="santiyeLocationModalLabel" aria-hidden="true">



        <div class="modal-dialog modal-dialog-centered">



            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">



                <div class="modal-header bg-danger text-white border-0 py-3">



                    <h5 class="modal-title fw-bold" id="santiyeLocationModalLabel">



                        <i class="bi bi-geo-alt-fill me-2"></i> Şantiye Konumu & Lojistik Paylaşımı



                    </h5>



                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>



                </div>



                <div class="modal-body p-4 text-center">



                    <div class="mb-3">



                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fs-6 fw-bold">



                            <i class="bi bi-building me-1"></i> <span id="locModalProjectName">Şantiye</span>



                        </span>



                    </div>



                    <p class="text-muted mb-2 small" id="locModalAddress">Adres yükleniyor...</p>



                    <p class="text-secondary small mb-4">Tedarikçi kamyonları, beton mikserleri veya misafirler için canlı yol tarifi linki:</p>



                    <div class="input-group mb-3">



                        <input type="text" id="locModalUrlInput" class="form-control bg-light" readonly value="">



                        <button class="btn btn-outline-secondary" type="button" onclick="copyLocationUrl()">



                            <i class="bi bi-clipboard me-1"></i> Kopyala



                        </button>



                    </div>



                    <div id="copyFeedback" class="text-success small fw-bold mb-3" style="display:none;">



                        <i class="bi bi-check2-circle me-1"></i> Link panoya kopyalandı!



                    </div>



                    <div class="d-grid gap-2">



                        <a id="locModalWhatsappBtn" href="#" target="_blank" class="btn btn-success fw-bold py-2 rounded-pill">



                            <i class="bi bi-whatsapp me-2"></i> WhatsApp İle Paylaş



                        </a>



                        <a id="locModalMapsBtn" href="#" target="_blank" class="btn btn-outline-danger fw-bold py-2 rounded-pill">



                            <i class="bi bi-map-fill me-2"></i> Google Haritalar'da Aç



                        </a>



                    </div>



                </div>



            </div>



        </div>



    </div>



    <script>



        function openSantiyeLocationModal(projectId) {



            if (!projectId || projectId === 0) return;



            fetch('/ConstructionProject/GetLocationJson/' + projectId)



                .then(res => res.json())



                .then(data => {



                    document.getElementById('locModalProjectName').textContent = data.name || 'Şantiye';



                    document.getElementById('locModalAddress').textContent = data.address || 'Adres bilgisi girilmemiş';



                    var mapsUrl = data.mapsUrl || ('https://www.google.com/maps?q=' + (data.latitude || '') + ',' + (data.longitude || ''));



                    document.getElementById('locModalUrlInput').value = mapsUrl;



                    document.getElementById('locModalMapsBtn').href = mapsUrl;



                    var waText = encodeURIComponent('Merhaba, ' + (data.name || 'Şantiye') + ' projemizin konumu ve yol tarifi: ' + mapsUrl + ' (Adres: ' + (data.address || '') + ')');



                    document.getElementById('locModalWhatsappBtn').href = 'https://api.whatsapp.com/send?text=' + waText;



                    var modal = new bootstrap.Modal(document.getElementById('santiyeLocationModal'));



                    modal.show();



                })



                .catch(err => {



                    window.open('/ConstructionProject/Map/' + projectId, '_blank');



                });



        }



        function copyLocationUrl() {



            var input = document.getElementById('locModalUrlInput');



            if (input && input.value) {



                navigator.clipboard.writeText(input.value).then(function() {



                    var feedback = document.getElementById('copyFeedback');



                    if (feedback) {



                        feedback.style.display = 'inline-block';



                        setTimeout(function() { feedback.style.display = 'none'; }, 2000);



                    }



                });



            }



        }



    </script>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>



    @await RenderSectionAsync("Scripts", required: false)





    <script>

        // Evrensel Collapse Hafıza Motoru (Universal Collapse Memory)

        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll('.collapse').forEach(function(el) {

                var id = el.id;

                if (!id) return;

                var savedState = localStorage.getItem('gmk_col_' + id);

                if (savedState === 'open') {

                    el.classList.add('show');

                    var trg = document.querySelector('[data-bs-target="#' + id + '"], [href="#' + id + '"]');

                    if (trg) {

                        trg.setAttribute('aria-expanded', 'true');

                        var txt = trg.querySelector('#text' + id.charAt(0).toUpperCase() + id.slice(1) + 'Toggle') || trg.querySelector('[id$="Toggle"]');

                        if (txt && txt.innerText === 'Genişlet') txt.innerText = 'Daralt';

                        var ico = trg.querySelector('.bi-chevron-down');

                        if (ico) { ico.classList.remove('bi-chevron-down'); ico.classList.add('bi-chevron-up'); }

                    }

                } else if (savedState === 'closed') {

                    el.classList.remove('show');

                    var trg = document.querySelector('[data-bs-target="#' + id + '"], [href="#' + id + '"]');

                    if (trg) {

                        trg.setAttribute('aria-expanded', 'false');

                        var txt = trg.querySelector('#text' + id.charAt(0).toUpperCase() + id.slice(1) + 'Toggle') || trg.querySelector('[id$="Toggle"]');

                        if (txt && txt.innerText === 'Daralt') txt.innerText = 'Genişlet';

                        var ico = trg.querySelector('.bi-chevron-up');

                        if (ico) { ico.classList.remove('bi-chevron-up'); ico.classList.add('bi-chevron-down'); }

                    }

                }

                el.addEventListener('shown.bs.collapse', function() {

                    localStorage.setItem('gmk_col_' + id, 'open');

                });

                el.addEventListener('hidden.bs.collapse', function() {

                    localStorage.setItem('gmk_col_' + id, 'closed');

                });

            });

        });

    </script>

    @await Html.PartialAsync("_VisualUserGuideModalPartial")
    <partial name="_PwaScriptsPartial" />
