@using Microsoft.AspNetCore.Identity
@using GMK360.Core.Entities.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Şantiye Modu</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <style>
        body { background-color: #f8f9fa; }
        .hover-orange:hover { color: #FF6B00 !important; }
        .text-orange { color: #FF6B00; }
        .bg-orange { background-color: #FF6B00; }
        .text-navy { color: #1e3a8a; }
        .bg-navy { background-color: #1e3a8a; }
    </style>
    @await RenderSectionAsync("SEO", required: false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    
    <!-- TOP BAR (SADECE PROJE ADI VE LOGO) -->
    <header class="fixed-top bg-white border-bottom shadow-sm">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center py-3">
            
            <!-- SOL: LOGO VE PROJE ADI -->
            <div class="d-flex align-items-center">
                <a asp-controller="ConstructionProject" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2">
                    <i class="ph-fill ph-infinity text-orange" style="font-size: 2.2rem;"></i>
                    <span class="fs-3 fw-bold text-navy" style="letter-spacing:-1px;">GMK<span class="text-orange">360</span></span>
                </a>
                
                @if(ViewData["ProjectName"] != null)
                {
                    <span class="fs-3 text-muted mx-3">|</span>
                    <i class="bi bi-building-check fs-4 text-primary me-2"></i>
                    <span class="fw-bold fs-4 text-uppercase text-dark" style="letter-spacing: 0px;">@ViewData["ProjectName"] ŞANTİYESİ</span>
                }
            </div>
            
            <!-- SAĞ: PROFİL MENÜSÜ -->
            <div class="d-flex gap-3 align-items-center">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-navy px-4 rounded-pill dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="ph-fill ph-user-circle fs-5"></i>
                            <span class="d-none d-md-inline">Hesabım</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 200px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold">@( (await UserManager.GetUserAsync(User))?.DisplayName ?? User.Identity.Name )</div>
                            </li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="ph ph-gear me-2 text-muted"></i>Sistem Yönetimi</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="CustomerDashboard" asp-action="Index"><i class="ph ph-squares-four me-2 text-muted"></i>Çalışma Alanı</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="ph ph-user me-2 text-muted"></i>Profil & Ayarlar</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item text-danger"><i class="ph ph-sign-out me-2"></i>Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
            
        </div>
    </header>

    <!-- ANA İÇERİK (SİDEBAR + CONTENT) -->
    <main class="flex-grow-1" style="margin-top: 80px;">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm m-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm m-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

        <div class="container-fluid px-4 mt-4">
            <div class="row">
                
                <!-- BAĞLAMSAL SOL MENÜ -->
                <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100 rounded-4">
                        <div class="list-group list-group-flush" style="font-size: 0.95rem;">
                            
                            <!-- KAÇIŞ BUTONU -->
                            <div class="px-3 mb-3 mt-3">
                                <a href="/ConstructionProject/Index" class="btn btn-outline-danger w-100 rounded-pill fw-bold shadow-sm d-flex justify-content-center align-items-center">
                                    <i class="bi bi-arrow-left-circle-fill me-2 fs-5"></i> Tüm Projelere Dön
                                </a>
                            </div>

                            <hr class="text-muted mx-3 my-1">

                            <a href="/ConstructionProject/Details/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active fw-bold" : "")">
                                <i class="bi bi-bar-chart-fill me-2 fs-5 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "text-white" : "text-primary")"></i> Şantiye Panosu
                            </a>
                            
                            <a href="/ProjectFinance/Index/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProjectFinance" ? "active fw-bold" : "")">
                                <i class="bi bi-wallet2 me-2 fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProjectFinance" ? "text-white" : "text-success")"></i> Maliyet ve Finans
                            </a>
                            <a href="/PhaseZero/Index/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PhaseZero" ? "active fw-bold bg-danger text-white border-danger" : "text-danger fw-bold")">
                                <i class="bi bi-file-earmark-lock-fill me-2 fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PhaseZero" ? "text-white" : "text-danger")"></i> Faz 0: Resmi Evrak
                            </a>
                            
                            <a href="/ConstructionProject/Emergencies/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 position-relative @(ViewContext.RouteData.Values["Action"]?.ToString() == "Emergencies" ? "active fw-bold bg-warning text-dark border-warning" : "text-dark")">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Emergencies" ? "text-dark" : "text-warning")"></i> Acil Durum / Bildirimler
                                <span class="position-absolute top-50 end-0 translate-middle-y me-3 badge bg-danger rounded-pill shadow-sm" style="animation: pulse 1.5s infinite;">2 Yeni</span>
                            </a>
                            
                            <hr class="text-muted mx-3 my-1">
                            <div class="px-3 mb-1 mt-2 text-muted small fw-bold text-uppercase">ERP Operasyon Merkezi</div>

                            <a href="/Metraj/DrawingArchive?projectId=@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "DrawingArchive" ? "active fw-bold bg-primary text-white border-primary" : "")">
                                <i class="bi bi-folder2-open me-2 fs-5 text-primary"></i> Kanat 1: Çizim Arşivi & Kabul
                            </a>

                            <a href="/Metraj/ProjectDNA/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "ProjectDNA" ? "active fw-bold" : "")">
                                <i class="fas fa-dna me-2 fs-5 text-success"></i> Kanat 2: Proje DNA (Hesaplama)
                            </a>

                            <a href="/Metraj/BuildingWorkflow/@ViewData["ProjectId"]" target="_blank" rel="noopener noreferrer" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "BuildingWorkflow" ? "active fw-bold text-white bg-primary border-primary" : "")">
                                <i class="fas fa-network-wired me-2 fs-5 text-warning"></i> Şantiye İş Akışı & Tedarik Masası
                                <i class="fas fa-external-link-alt small ms-auto opacity-75"></i>
                            </a>

                            <a href="/PhaseTwo/OperationBoard/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "OperationBoard" ? "active fw-bold" : "")">
                                <i class="fas fa-calendar-alt me-2 fs-5 text-warning"></i> Operasyon Planı (Takvim)
                            </a>
                            <a href="/SiteDiary" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SiteDiary" ? "active fw-bold" : "")">
                                <i class="fas fa-memory me-2 fs-5 text-primary"></i> Yönetim Hafızası (Günlük)
                            </a>
                            <a href="/LaborMobilization" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LaborMobilization" ? "active fw-bold" : "")">
                                <i class="fas fa-campground me-2 fs-5 text-danger"></i> İş Gücü & Mobilizasyon
                            </a>

                            <a href="/PhaseTwo/IsgChecklist/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "IsgChecklist" ? "active fw-bold" : "")">
                                <i class="fas fa-hard-hat me-2 fs-5 text-danger"></i> İSG Günlük Kontrol
                            </a>
                            
                            <a href="/ConstructionProject/Equipment/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Equipment" ? "active fw-bold" : "")">
                                <i class="fas fa-truck-monster me-2 fs-5 text-info"></i> Makine Parkı & Kiralık Vinç
                            </a>
                            
                            <a href="/DailyTimesheets/ProjectTimesheet/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "ProjectTimesheet" ? "active fw-bold" : "text-muted")">
                                <i class="bi bi-people-fill me-2 fs-5 @(ViewContext.RouteData.Values["Action"]?.ToString() == "ProjectTimesheet" ? "text-white" : "text-secondary")"></i> Şantiye Puantajı
                            </a>
                            
                            <a href="/Inventory/Index/@ViewData["ProjectId"]" class="list-group-item list-group-item-action py-3 text-muted" title="Yakında">
                                <i class="bi bi-boxes me-2 fs-5 text-secondary"></i> Şantiye Deposu
                            </a>

                            <a href="/ConstructionProject/Details/@ViewData["ProjectId"]#collapseFaz0" class="list-group-item list-group-item-action py-3">
                                <i class="bi bi-folder-fill me-2 fs-5 text-warning"></i> Evrak Yönetimi
                            </a>
                            
                            <!-- ŞANTİYE KONUMU & LOJİSTİK BUTONU -->
                            <a href="javascript:void(0)" onclick="openSantiyeLocationModal(@(ViewData["ProjectId"] ?? 0))" class="list-group-item list-group-item-action py-3 text-danger fw-bold bg-danger bg-opacity-10 border-start border-4 border-danger" title="Lojistik, Yol Tarifi ve Tedarikçiye Konum Paylaş">
                                <i class="bi bi-geo-alt-fill me-2 fs-5 text-danger"></i> 📍 Şantiye Konumu & Lojistik
                            </a>
                            
                            <div class="list-group-item bg-light fw-bold mt-4 text-uppercase text-center text-muted" style="font-size: 0.75rem;">
                                SADECE BU PROJEYİ GÖRÜYORSUNUZ
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SAYFA İÇERİĞİ -->
                <div class="col-xl-10 col-lg-9 col-md-8">
                    @RenderBody()
                </div>
                
            </div>
        </div>
    </main>
    
    <!-- ŞANTİYE KONUMU & LOJİSTİK MODAL -->
    <div class="modal fade" id="santiyeLocationModal" tabindex="-1" aria-labelledby="santiyeLocationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-danger text-white rounded-top-4 py-3">
                    <h5 class="modal-title fw-bold" id="santiyeLocationModalLabel">
                        <i class="bi bi-geo-alt-fill me-2"></i> Şantiye Konumu & Lojistik
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-2">
                            <i class="bi bi-geo-alt-fill fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1" id="locModalProjectName">Şantiye</h5>
                        <p class="text-muted small mb-0" id="locModalAddress">Adres yükleniyor...</p>
                    </div>

                    <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-bold">Konum Bağlantısı:</span>
                            <span id="copyFeedback" class="badge bg-success" style="display:none;">Kopyalandı!</span>
                        </div>
                        <div class="input-group">
                            <input type="text" id="locModalUrlInput" class="form-control form-control-sm bg-white" readonly />
                            <button class="btn btn-sm btn-outline-secondary" type="button" onclick="copyLocationUrl()">
                                <i class="bi bi-clipboard me-1"></i> Kopyala
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a id="locModalMapsBtn" href="#" target="_blank" class="btn btn-danger py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center">
                            <i class="bi bi-map-fill me-2 fs-5"></i> Google Haritalar'da Aç / Yol Tarifi
                        </a>
                        <a id="locModalWhatsappBtn" href="#" target="_blank" class="btn btn-success py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center">
                            <i class="bi bi-whatsapp me-2 fs-5"></i> Tedarikçiye / Ustaya WhatsApp ile Gönder
                        </a>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light py-2 rounded-bottom-4 justify-content-end">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openSantiyeLocationModal(projectId) {
            if (!projectId || projectId === 0) return;
            
            fetch('/ConstructionProject/GetLocationJson/' + projectId)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('locModalProjectName').textContent = data.name || 'Şantiye';
                    document.getElementById('locModalAddress').textContent = data.address || 'Adres bilgisi girilmemiş';
                    
                    var mapsUrl = data.mapsUrl || ('https://www.google.com/maps?q=' + (data.latitude || '') + ',' + (data.longitude || ''));
                    document.getElementById('locModalUrlInput').value = mapsUrl;
                    document.getElementById('locModalMapsBtn').href = mapsUrl;
                    
                    var waText = encodeURIComponent('Merhaba, ' + (data.name || 'Şantiye') + ' projemizin konumu ve yol tarifi: ' + mapsUrl + ' (Adres: ' + (data.address || '') + ')');
                    document.getElementById('locModalWhatsappBtn').href = 'https://api.whatsapp.com/send?text=' + waText;
                    
                    var modal = new bootstrap.Modal(document.getElementById('santiyeLocationModal'));
                    modal.show();
                })
                .catch(err => {
                    window.open('/ConstructionProject/Map/' + projectId, '_blank');
                });
        }

        function copyLocationUrl() {
            var input = document.getElementById('locModalUrlInput');
            if (input && input.value) {
                navigator.clipboard.writeText(input.value).then(function() {
                    var feedback = document.getElementById('copyFeedback');
                    if (feedback) {
                        feedback.style.display = 'inline-block';
                        setTimeout(function() { feedback.style.display = 'none'; }, 2000);
                    }
                });
            }
        }
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
