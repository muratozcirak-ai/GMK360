@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using GMK360.Core.Entities.Identity
@using GMK360.Core.Entities.Construction
@using GMK360.Web.Helpers
@inject UserManager<ApplicationUser> UserManager
@inject GMK360.Data.Contexts.ApplicationDbContext DbContext

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentConsultant = currentUser != null ? await DbContext.AgencyConsultants.AsNoTracking().FirstOrDefaultAsync(c => c.UserId == currentUser.Id && c.IsActive) : null;
    bool isRealBoss = currentConsultant == null || currentConsultant.Role == GMK360.Core.Entities.AgencyRole.Owner || currentConsultant.Role == GMK360.Core.Entities.AgencyRole.Manager || User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var previewCookie = isRealBoss ? Context.Request.Cookies["gmk360_role_preview"] : null;
    var effectivePerms = StaffPermissionHelper.GetEffectivePermissions(currentConsultant?.Role, currentUser?.ActiveModules, previewCookie);
    bool isPreviewActive = !string.IsNullOrWhiteSpace(previewCookie) && !previewCookie.Equals("owner", StringComparison.OrdinalIgnoreCase);
    string currentUrl = Context.Request.Path + Context.Request.QueryString;

    object? rawPid = ViewData["ProjectId"] ?? ViewContext.RouteData.Values["id"] ?? Context.Request.Query["projectId"].FirstOrDefault();
    int parsedPid = 0;
    if (rawPid != null) int.TryParse(rawPid.ToString(), out parsedPid);

    var pStatus = ViewData["ProjectStatus"] as ProjectStatus?;
    if (parsedPid > 0 && (!pStatus.HasValue || ViewData["ProjectName"] == null))
    {
        var dbProj = DbContext.ConstructionProjects.AsNoTracking()
            .Where(x => x.Id == parsedPid)
            .Select(x => new { x.Status, x.Name })
            .FirstOrDefault();
        if (dbProj != null)
        {
            if (!pStatus.HasValue) pStatus = dbProj.Status;
            if (ViewData["ProjectName"] == null) ViewData["ProjectName"] = dbProj.Name;
            if (ViewData["ProjectId"] == null) ViewData["ProjectId"] = parsedPid;
        }
    }

    bool isFormenOnlyMode = !effectivePerms.Contains(StaffPermissionHelper.PermFinance) && !effectivePerms.Contains(StaffPermissionHelper.PermDna) && !effectivePerms.Contains(StaffPermissionHelper.PermCandidate);
    bool isAdayMode = !isFormenOnlyMode && pStatus.HasValue && (pStatus.Value == ProjectStatus.On_Gorusme_Talep || pStatus.Value == ProjectStatus.Projelendirme_Teklif);
    bool isAnlasmaMode = !isFormenOnlyMode && pStatus.HasValue && pStatus.Value == ProjectStatus.Anlasma_Yapildi;
    bool isSatisMode = !isFormenOnlyMode && pStatus.HasValue && (pStatus.Value == ProjectStatus.Satista_Topraktan || pStatus.Value == ProjectStatus.Tamamlandi_Teslim);
    bool isAktifSantiyeMode = !isAdayMode && !isAnlasmaMode && !isSatisMode;

    string stageBadgeText = isAdayMode ? "1. EVRE: ADAY / TEKLİF"
        : isAnlasmaMode ? "2. EVRE: ANLAŞMA YAPILDI (PLANLAMA)"
        : isSatisMode ? (pStatus == ProjectStatus.Satista_Topraktan ? "4. EVRE: SATIŞTA (TOPRAKTAN)" : "4. EVRE: BİTEN / TESLİM")
        : "3. EVRE: AKTİF ŞANTİYE";

    string stageBadgeClass = isAdayMode ? "bg-warning text-dark border border-warning"
        : isAnlasmaMode ? "text-white"
        : isSatisMode ? "bg-success text-white"
        : "bg-primary text-white";

    string stageBadgeStyle = isAnlasmaMode ? "background-color: #6f42c1;" : "";
}



<!DOCTYPE html>



<html lang="tr">



<head>



    <meta charset="utf-8" />



    <meta name="viewport" content="width=device-width, initial-scale=1.0" />



    <partial name="_PwaHeadPartial" />
    <title>@ViewData["Title"] - Şantiye Modu</title>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">



    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">



    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />



    <script src="https://unpkg.com/@@phosphor-icons/web"></script>



    <style>



        body { background-color: #f8f9fa; }



        .hover-orange:hover { color: #FF6B00 !important; }



        .text-orange { color: #FF6B00; }



        .bg-orange { background-color: #FF6B00; }



        .text-navy { color: #1e3a8a; }



        .bg-navy { background-color: #1e3a8a; }



    </style>



    @await RenderSectionAsync("SEO", required: false)



    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />



</head>



<body class="d-flex flex-column min-vh-100 bg-light">



    <!-- TOP BAR (KOMPAKT & LAPTOP DOSTU) -->

    <header class="fixed-top bg-white border-bottom shadow-xs" style="z-index: 1030;">

        <div class="container-fluid px-2 px-md-3 d-flex justify-content-between align-items-center py-1">

            <!-- SOL: LOGO VE PROJE ADI -->

            <div class="d-flex align-items-center">

                <a asp-controller="ConstructionProject" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-1">

                    <i class="ph-fill ph-infinity text-orange" style="font-size: 1.4rem;"></i>

                    <span class="fs-6 fw-bold text-navy" style="letter-spacing:-0.5px;">GMK<span class="text-orange">360</span></span>

                </a>

                

                @if(ViewData["ProjectName"] != null)
                {
                    <span class="text-muted mx-2">|</span>
                    <i class="@(isAdayMode ? "bi bi-search text-warning" : isAnlasmaMode ? "bi bi-handshake" : isSatisMode ? "bi bi-cash-coin text-success" : "bi bi-building-check text-primary") fs-6 me-1" style="@(isAnlasmaMode ? "color: #6f42c1;" : "")"></i>
                    <span class="fw-bold text-truncate text-uppercase text-dark d-flex align-items-center gap-1" style="font-size: 0.85rem; max-width: 620px;">
                        <span class="text-truncate">@ViewData["ProjectName"]</span>
                        @if (parsedPid > 0)
                        {
                            <div class="dropdown d-inline-block ms-1">
                                <button class="badge @stageBadgeClass px-2.5 py-1 rounded-pill dropdown-toggle border-0 shadow-xs" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.70rem; cursor: pointer; @stageBadgeStyle" title="Proje Evresini / Masasını Değiştir">
                                    @stageBadgeText
                                </button>
                                <ul class="dropdown-menu shadow border-0 mt-1" style="border-radius: 12px; font-size: 0.80rem; min-width: 260px;">
                                    <li class="px-3 py-1.5 border-bottom text-muted fw-bold small">PROJE EVRESİNİ DEĞİŞTİR</li>
                                    <li>
                                        <form asp-controller="ConstructionProject" asp-action="ChangeProjectStatus" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@parsedPid" />
                                            <input type="hidden" name="newStatus" value="Projelendirme_Teklif" />
                                            <button type="submit" class="dropdown-item py-1.5 @(isAdayMode ? "fw-bold bg-warning bg-opacity-10" : "")">
                                                <i class="bi bi-search text-warning me-2"></i>1. Aday Proje (Etüd & Teklif)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="ConstructionProject" asp-action="ChangeProjectStatus" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@parsedPid" />
                                            <input type="hidden" name="newStatus" value="Anlasma_Yapildi" />
                                            <button type="submit" class="dropdown-item py-1.5 @(isAnlasmaMode ? "fw-bold bg-primary bg-opacity-10" : "")">
                                                <i class="bi bi-diagram-3-fill me-2" style="color: #6f42c1;"></i>2. Anlaşma Yapıldı (DNA & Planlama)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="ConstructionProject" asp-action="ChangeProjectStatus" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@parsedPid" />
                                            <input type="hidden" name="newStatus" value="Aktif_Santiye" />
                                            <button type="submit" class="dropdown-item py-1.5 @(isAktifSantiyeMode ? "fw-bold bg-primary bg-opacity-10" : "")">
                                                <i class="bi bi-cone-striped text-primary me-2"></i>3. Aktif Şantiye (Saha Operasyon)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="ConstructionProject" asp-action="ChangeProjectStatus" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@parsedPid" />
                                            <input type="hidden" name="newStatus" value="Satista_Topraktan" />
                                            <button type="submit" class="dropdown-item py-1.5 @(pStatus == ProjectStatus.Satista_Topraktan ? "fw-bold bg-success bg-opacity-10" : "")">
                                                <i class="bi bi-cash-coin text-success me-2"></i>4. Satışa Çıkanlar (Topraktan / Pazarlama)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="ConstructionProject" asp-action="ChangeProjectStatus" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@parsedPid" />
                                            <input type="hidden" name="newStatus" value="Tamamlandi_Teslim" />
                                            <button type="submit" class="dropdown-item py-1.5 @(pStatus == ProjectStatus.Tamamlandi_Teslim ? "fw-bold bg-success bg-opacity-10" : "")">
                                                <i class="bi bi-check-circle-fill text-success me-2"></i>5. Biten / Teslim Dönemi
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <span class="badge @stageBadgeClass ms-1 px-2 py-0 rounded-pill" style="font-size: 0.68rem; @stageBadgeStyle">@stageBadgeText</span>
                        }
                    </span>
                }

            </div>

            

            <!-- SAĞ: PROFİL MENÜSÜ -->
            <div class="d-flex gap-2 align-items-center">
                <!-- KALICI GÖRSEL KULLANIM KILAVUZU & REHBER BUTONU -->
                <button type="button" class="btn btn-primary px-2.5 py-1 rounded-pill d-flex align-items-center gap-1 btn-sm shadow-xs fw-bold" data-bs-toggle="modal" data-bs-target="#gmkVisualGuideModal" style="font-size: 0.75rem; background: linear-gradient(135deg, #1e3a8a, #0284c7); border: none;" title="Görselli Adım Adım Sistem Kullanım Kılavuzu">
                    <i class="bi bi-journal-richtext text-warning"></i>
                    <span class="d-none d-sm-inline">Görsel Kılavuz</span>
                </button>
                @if (isRealBoss)
                {
                    <div class="dropdown">
                        <button class="btn @(isPreviewActive ? "btn-warning text-dark fw-bold border-warning" : "btn-light border text-dark fw-semibold") px-2.5 py-1 rounded-pill dropdown-toggle d-flex align-items-center gap-1 btn-sm shadow-xs" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.75rem;" title="Patron Rol & Gölge Ön İzleme Simülatörü">
                            <i class="bi bi-eye-fill @(isPreviewActive ? "text-danger" : "text-primary")"></i>
                            <span class="d-none d-md-inline">
                                @(previewCookie == "engineer" ? "2. Rol: Teknik Ofis" : previewCookie == "formen" ? "3. Rol: Formen (Sıfır ₺)" : "Rol & Gölge Testi")
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius: 12px; min-width: 310px; font-size: 0.80rem;">
                            <li class="px-3 py-1.5 border-bottom bg-light rounded-top-3 text-muted fw-bold small">
                                👁️ ŞİRKET İÇİ 3 ROL ÖN İZLEME (CANLI FİLTRE)
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5 @(!isPreviewActive ? "fw-bold bg-primary bg-opacity-10" : "")" href="/AgencyStaff/SwitchRolePreview?mode=owner&returnUrl=@Uri.EscapeDataString(currentUrl)">
                                    👑 1. Rol: Patron / Sağ Kol (Tam Yetki)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5 @(previewCookie == "engineer" ? "fw-bold bg-primary bg-opacity-10" : "")" href="/AgencyStaff/SwitchRolePreview?mode=engineer&returnUrl=@Uri.EscapeDataString(currentUrl)">
                                    📐 2. Rol: Teknik Ofis / Mühendis (Kasa & Satış Gizli)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5 @(previewCookie == "formen" ? "fw-bold bg-warning bg-opacity-25" : "")" href="/AgencyStaff/SwitchRolePreview?mode=formen&returnUrl=@Uri.EscapeDataString(currentUrl)">
                                    👷 3. Rol: Saha Sorumlusu / Formen (Sıfır Finans)
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li class="px-3 py-1 text-muted fw-bold small">
                                👻 4. ROL: GÖLGE & DIŞ İŞ ORTAĞI ANA SAYFALARI
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5" href="/Tedarikci/Index" target="_blank">
                                    <i class="bi bi-shop text-warning me-2"></i>Tedarikçi / Beton Santrali (Açık Hesap & Rehber)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5" href="/Taseron/Index" target="_blank">
                                    <i class="bi bi-bricks text-primary me-2"></i>Taşeron & Ekip Başı (Puantaj & Hakediş Masası)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5" href="/PartnerPortal/Index" target="_blank">
                                    <i class="bi bi-wallet2 text-success me-2"></i>Gölge Cari Hesap & Sözleşme Portalı
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5" href="/MobileTask/Index" target="_blank">
                                    <i class="bi bi-phone-fill text-danger me-2"></i>Formen / Usta Mobil Görev PWA
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-1.5 fw-bold text-primary" href="/AgencyStaff/Index">
                                    <i class="bi bi-sliders me-2"></i>Personel "Sen Bunu Gör" Yetkilerini Yönet ➔
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                @if (User.Identity.IsAuthenticated)

                {

                    <div class="dropdown">

                        <button class="btn btn-outline-navy px-3 py-1 rounded-pill dropdown-toggle d-flex align-items-center gap-1 btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.78rem;">

                            <i class="ph-fill ph-user-circle fs-6"></i>

                            <span class="d-none d-md-inline">Hesabım</span>

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 200px;">

                            <li class="px-3 py-2 border-bottom mb-1">

                                <div class="fw-bold">@( (await UserManager.GetUserAsync(User))?.DisplayName ?? User.Identity.Name )</div>

                            </li>

                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))

                            {

                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="ph ph-gear me-2 text-muted"></i>Sistem Yönetimi</a></li>

                            }

                            else

                            {

                                <li><a class="dropdown-item" asp-controller="CustomerDashboard" asp-action="Index"><i class="ph ph-squares-four me-2 text-muted"></i>Çalışma Alanı</a></li>

                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="ph ph-user me-2 text-muted"></i>Profil & Ayarlar</a></li>

                            }

                            <li><hr class="dropdown-divider"></li>

                            <li>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">

                                    <button type="submit" class="dropdown-item text-danger"><i class="ph ph-sign-out me-2"></i>Çıkış Yap</button>

                                </form>

                            </li>

                        </ul>

                    </div>

                }

            </div>

        </div>

    </header>



    <!-- ANA İÇERİK (SİDEBAR + CONTENT) -->
    <main class="flex-grow-1" style="margin-top: 48px;">
        @if (isPreviewActive)
        {
            <div class="bg-warning text-dark py-1 px-3 border-bottom border-dark border-opacity-25 d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-xs" style="font-size: 0.78rem;">
                <div>
                    <i class="bi bi-eye-fill text-danger me-1"></i>
                    <strong>ROL ÖN İZLEME AKTİF:</strong> Şu an bu projeyi
                    <span class="badge bg-dark text-white rounded-pill px-2 py-0.5">
                        @(previewCookie == "engineer" ? "📐 2. Rol: Teknik Ofis / Mühendis (Hazırlık & DNA - Ana Kasa Gizli)" : "👷 3. Rol: Saha Sorumlusu / Formen (Sadece 3. Evre Şantiye & PWA - Sıfır Finans)")
                    </span>
                    gözüyle inceliyorsunuz.
                </div>
                <a href="/AgencyStaff/SwitchRolePreview?mode=owner&returnUrl=@Uri.EscapeDataString(currentUrl)" class="btn btn-dark btn-sm rounded-pill py-0 px-3 fw-bold" style="font-size: 0.72rem;">
                    👑 Patron (Tam Yetki) Görünümüne Dön
                </a>
            </div>
        }



            @if (TempData["SuccessMessage"] != null)



            {



                <div class="alert alert-success alert-dismissible fade show shadow-sm m-3" role="alert">



                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]



                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>



                </div>



            }



            @if (TempData["ErrorMessage"] != null)



            {



                <div class="alert alert-danger alert-dismissible fade show shadow-sm m-3" role="alert">



                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]



                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>



                </div>



            }



        <div class="container-fluid px-2 px-md-3 mt-2">



            <div class="row">



                <!-- BAĞLAMSAL SOL MENÜ -->



                <div class="col-xl-2 col-lg-2 col-md-3 mb-2">



                    <div class="card shadow-sm border-0 rounded-3">



                        <div class="list-group list-group-flush" style="font-size: 0.82rem;">
                            @{
                                var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                                var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                                var pId = ViewData["ProjectId"] ?? parsedPid;
                                bool isEngPageOpen = currentController == "PhaseZero" || currentAction == "DrawingArchive" || currentAction == "ProjectDNA" || currentAction == "DnaWizard" || currentAction == "Analysis" || currentAction == "Feasibility" || currentAction == "Proposal";
                            }

                            @if (isAdayMode)
                            {
                                <!-- ========================================================= -->
                                <!-- 1. EVRE: ADAY PROJE MASASI (MEVCUT YAPI - %100 KORUNDU)   -->
                                <!-- ========================================================= -->
                                <div class="p-2 d-flex flex-column gap-1">
                                    <!-- 1. Görüşmeler ve Toplantılar (Merkeze bağlı) -->
                                    <a href="/ConstructionProject/Meetings/@pId" 
                                       class="btn w-100 rounded-pill fw-bold shadow-xs d-flex justify-content-between align-items-center py-1.5 px-3 text-start @(currentAction == "Meetings" || currentAction == "MeetingRoom" ? "btn-warning text-dark border-warning" : "btn-light border text-dark")"
                                       style="font-size: 0.80rem; @(currentAction == "Meetings" || currentAction == "MeetingRoom" ? "background: #ffc107;" : "")">
                                        <span class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-people-fill me-2 fs-6 text-warning"></i>
                                            <span class="text-truncate">Görüşmeler & Toplantılar</span>
                                        </span>
                                        <i class="bi bi-chevron-right small text-muted opacity-50"></i>
                                    </a>

                                    <!-- 2. Künye -->
                                    <a href="/ConstructionProject/Workspace/@pId" 
                                       class="btn w-100 rounded-pill fw-bold shadow-xs d-flex justify-content-between align-items-center py-1.5 px-3 text-start @(currentAction == "Workspace" ? "btn-primary text-white" : "btn-light border text-dark")"
                                       style="font-size: 0.80rem; @(currentAction == "Workspace" ? "background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);" : "")">
                                        <span class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-card-heading me-2 fs-6 @(currentAction == "Workspace" ? "text-white" : "text-primary")"></i>
                                            <span class="text-truncate">Proje Künyesi</span>
                                        </span>
                                        <i class="bi bi-chevron-right small @(currentAction == "Workspace" ? "text-white opacity-75" : "text-muted opacity-50")"></i>
                                    </a>

                                    <!-- 3. Hızlı Ön Etüd -->
                                    <a href="/ConstructionProject/Feasibility/@pId" 
                                       class="btn w-100 rounded-pill fw-bold shadow-xs d-flex justify-content-between align-items-center py-1.5 px-3 text-start @(currentAction == "Feasibility" ? "btn-warning text-dark border-warning" : "btn-light border text-dark")"
                                       style="font-size: 0.80rem; @(currentAction == "Feasibility" ? "background: #ffc107;" : "")">
                                        <span class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-rulers me-2 fs-6 text-warning"></i>
                                            <span class="text-truncate">Hızlı Ön Etüd</span>
                                        </span>
                                        <i class="bi bi-chevron-right small text-muted opacity-50"></i>
                                    </a>

                                    <!-- 4. Detaylı İnceleme -->
                                    <a href="/ConstructionProject/Analysis/@pId" 
                                       class="btn w-100 rounded-pill fw-bold shadow-xs d-flex justify-content-between align-items-center py-1.5 px-3 text-start @(currentAction == "Analysis" ? "btn-primary text-white" : "btn-light border text-dark")"
                                       style="font-size: 0.80rem; @(currentAction == "Analysis" ? "background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);" : "")">
                                        <span class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-clipboard2-data me-2 fs-6 @(currentAction == "Analysis" ? "text-white" : "text-success")"></i>
                                            <span class="text-truncate">Detaylı İnceleme</span>
                                        </span>
                                        <i class="bi bi-chevron-right small @(currentAction == "Analysis" ? "text-white opacity-75" : "text-muted opacity-50")"></i>
                                    </a>

                                    <!-- 5. Teklif Hazırlama -->
                                    <a href="/ConstructionProject/Proposal/@pId" 
                                       class="btn w-100 rounded-pill fw-bold shadow-xs d-flex justify-content-between align-items-center py-1.5 px-3 text-start @(currentAction == "Proposal" ? "btn-primary text-white" : "btn-light border text-dark")"
                                       style="font-size: 0.80rem; @(currentAction == "Proposal" ? "background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);" : "")">
                                        <span class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-file-earmark-spreadsheet me-2 fs-6 @(currentAction == "Proposal" ? "text-white" : "text-info")"></i>
                                            <span class="text-truncate">Teklif Hazırlama</span>
                                        </span>
                                        <i class="bi bi-chevron-right small @(currentAction == "Proposal" ? "text-white opacity-75" : "text-muted opacity-50")"></i>
                                    </a>

