@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- ESNAF & TEDARİKÇİ ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white fw-bold">
                    <i class="bi bi-shop me-2"></i> Esnaf & Tedarikçi
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/Supplier" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Supplier" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Esnaf Özeti
                    </a>
                    
                    <a href="/Supplier/Katalog" class="list-group-item list-group-item-action">
                        <i class="bi bi-tags me-2"></i> Malzeme & Ürün Kataloğu
                    </a>

                    <a href="/Dashboard/Cuzdanim?context=supplier" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cuzdanim" ? "active" : "")">
                        <i class="bi bi-wallet2 me-2"></i> Dijital Cüzdanım
                    </a>

                    <!-- SATIŞ VE CRM -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        SİPARİŞ & TALEPLER (AİDİYETLİ)
                    </div>
                    <a href="/Crm/Talepler?context=supplier" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-left-text me-2"></i> Malzeme Talepleri (CRM)
                    </a>
                    <a href="/Crm/Ajanda?context=supplier" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-event me-2"></i> Teslimat Takvimi
                    </a>
                    
                    <!-- FİNANS -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        FİNANS & FATURA
                    </div>
                    <a href="/Dashboard/FinansCari?context=supplier" class="list-group-item list-group-item-action">
                        <i class="bi bi-calculator me-2"></i> Cari Hesap Özeti
                    </a>
                    <a href="/Dashboard/FaturaBilgilerim?context=supplier" class="list-group-item list-group-item-action">
                        <i class="bi bi-receipt me-2"></i> Fatura Bilgilerim
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
