@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- OTEL & GÜNLÜK KİRALAMA ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white fw-bold">
                    <i class="bi bi-calendar-range me-2"></i> Otel & Günlük Kiralama
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/CommercialRenter" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "CommercialRenter" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Yönetim Özeti
                    </a>
                    
                    <a href="/DailyRentalAgenda/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DailyRentalAgenda" ? "active" : "")">
                        <i class="bi bi-calendar-week me-2"></i> Rezervasyon Ajandası
                    </a>

                    <a href="/Crm/Rehber?context=hotel" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-lines-fill me-2"></i> Misafir Kayıtları (KBS)
                    </a>
                    
                    <a href="/Dashboard/FinansCari?context=hotel" class="list-group-item list-group-item-action">
                        <i class="bi bi-cash-stack me-2"></i> Ödeme ve Finans
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
