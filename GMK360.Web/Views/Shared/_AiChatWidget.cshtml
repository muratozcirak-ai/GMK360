<!-- AI Messenger Chat Widget -->
<div id="aiChatWidgetContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
    <!-- Chat Icon Button -->
    <button id="aiChatBtn" class="btn btn-primary rounded-circle shadow-lg" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border: 3px solid white;" onclick="toggleAiChat()">
        <i class="ph ph-robot fs-2 text-white"></i>
    </button>

    <!-- Chat Box -->
    <div id="aiChatBox" class="card shadow-lg border-0 d-none" style="width: 350px; height: 500px; position: absolute; bottom: 80px; right: 0; border-radius: 1rem; overflow: hidden; display: flex; flex-direction: column;">
        
        <!-- Header -->
        <div class="bg-primary text-white p-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="ph ph-robot fs-4 me-2"></i>
                <h6 class="mb-0 fw-bold">GMK360 Asistan</h6>
            </div>
            <button class="btn-close btn-close-white" onclick="toggleAiChat()"></button>
        </div>

        <!-- Messages Area -->
        <div id="aiChatMessages" class="p-3 bg-light flex-grow-1" style="overflow-y: auto;">
            <div class="d-flex mb-3">
                <div class="bg-white p-3 rounded-3 shadow-sm" style="max-width: 85%; font-size: 0.9rem;">
                    Merhaba! Ben GMK360 Akıllı Asistanı. Size nasıl yardımcı olabilirim?
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="p-2 bg-white border-top border-light d-flex flex-wrap gap-1">
            <button class="btn btn-sm btn-outline-primary rounded-pill mb-1" onclick="sendAiMessage('Bu bölge için kira değerlemesi yap')"><i class="ph ph-trend-up me-1"></i> Kira Değerlemesi</button>
            <button class="btn btn-sm btn-outline-primary rounded-pill mb-1" onclick="sendAiMessage('Gayrimenkul vergi hesaplaması hakkında bilgi ver')"><i class="ph ph-calculator me-1"></i> Vergi Hesapla</button>
            <button class="btn btn-sm btn-outline-primary rounded-pill mb-1" onclick="sendAiMessage('Tahliye taahhütnamesi nasıl hazırlanır?')"><i class="ph ph-scales me-1"></i> Hukuk</button>
        </div>

        <!-- Input Area -->
        <div class="p-2 bg-white border-top">
            <div class="input-group">
                <input type="text" id="aiChatInput" class="form-control border-0 bg-light rounded-start-pill ps-3" placeholder="Soru sorun..." onkeypress="if(event.key === 'Enter') sendAiMessage()">
                <button class="btn btn-primary rounded-end-pill px-3" onclick="sendAiMessage()"><i class="ph ph-paper-plane-tilt"></i></button>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAiChat() {
        var box = document.getElementById('aiChatBox');
        if(box.classList.contains('d-none')) {
            box.classList.remove('d-none');
            document.getElementById('aiChatInput').focus();
        } else {
            box.classList.add('d-none');
        }
    }

    function sendAiMessage(msg = null) {
        var input = document.getElementById('aiChatInput');
        var text = msg || input.value.trim();
        if(!text) return;
        
        var msgs = document.getElementById('aiChatMessages');
        // User Message
        msgs.innerHTML += <div class="d-flex mb-3 justify-content-end">
            <div class="bg-primary text-white p-2 rounded-3 shadow-sm" style="max-width: 85%; font-size: 0.9rem;">
                 + text + 
            </div>
        </div>;
        
        input.value = '';
        msgs.scrollTop = msgs.scrollHeight;

        // Loading
        var loadingId = 'loading_' + Date.now();
        msgs.innerHTML += <div id="+loadingId+" class="d-flex mb-3">
            <div class="bg-white p-2 rounded-3 shadow-sm text-muted" style="max-width: 85%; font-size: 0.9rem;">
                <i class="ph ph-spinner ph-spin me-2"></i> Düşünüyor...
            </div>
        </div>;
        msgs.scrollTop = msgs.scrollHeight;

        // Simüle edilmiş cevap (Gerçek AI servisine bağlanacak)
        setTimeout(() => {
            document.getElementById(loadingId).remove();
            msgs.innerHTML += <div class="d-flex mb-3">
                <div class="bg-white p-3 rounded-3 shadow-sm" style="max-width: 85%; font-size: 0.9rem;">
                    Şu anda sistemin test aşamasındayız. Bu soruya (<strong> + text + </strong>) yakında gerçek asistan cevap verecektir.
                </div>
            </div>;
            msgs.scrollTop = msgs.scrollHeight;
        }, 1500);
    }
</script>
