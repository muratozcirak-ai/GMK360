@* GMK360 Canlı KMK Mevzuat & Yönetim Danışmanı Widget *@
@{
    bool isAuthWidget = User?.Identity?.IsAuthenticated == true;
    string widgetBottom = isAuthWidget ? "66px" : "20px";
}
<div id="aiChatWidgetContainer" style="position: fixed; bottom: @widgetBottom; right: 18px; z-index: 1056;">
    <button id="aiChatBtn"
            type="button"
            class="btn btn-primary rounded-pill shadow-lg px-3 py-2 d-flex align-items-center gap-2"
            style="border: 2px solid rgba(255,255,255,0.85);"
            onclick="toggleAiChat()"
            title="GMK360 Yapay Zeka Mevzuat Danışmanı">
        <i class="bi bi-stars text-warning fs-5"></i>
        <span class="fw-bold small">AI Mevzuat Danışmanı</span>
    </button>

    <div id="aiChatBox" class="card shadow-lg border-0 d-none" style="width: 375px; max-width: calc(100vw - 28px); height: 530px; max-height: 78vh; position: absolute; bottom: 52px; right: 0; border-radius: 1rem; overflow: hidden; display: flex; flex-direction: column;">
        <div class="bg-dark text-white p-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-robot text-warning fs-4"></i>
                <div>
                    <h6 class="mb-0 fw-bold small">GMK360 KMK &amp; Yönetim Danışmanı</h6>
                    <small class="text-white-50" style="font-size: .7rem;">Merkezi KMK El Kitabı Destekli AI</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white btn-sm" onclick="toggleAiChat()" aria-label="Kapat"></button>
        </div>

        <div id="aiChatMessages" class="p-3 bg-light flex-grow-1" style="overflow-y: auto;">
            <div class="d-flex mb-3">
                <div class="bg-white p-3 rounded-3 shadow-sm border" style="max-width: 90%; font-size: 0.85rem;">
                    <strong>Merhaba!</strong> Ben GMK360 Mevzuat Danışmanıyım. 634 sayılı KMK, karar defteri usulleri, blok giderleri (Md. 69), aidat icrası veya toplantı çoğunlukları hakkında sorunuzu sorabilir; örnek karar/ihtar taslağı isteyebilirsiniz.
                </div>
            </div>
        </div>

        <div class="p-2 bg-white border-top d-flex flex-wrap gap-1">
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1" style="font-size:.72rem;" onclick="sendAiMessage('Karar defterine çıktı yapıştırmak geçerli mi?')">📄 Karar Defteri Çıktı</button>
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1" style="font-size:.72rem;" onclick="sendAiMessage('A Blok çatısı akıyor, kim öder? Karar taslağı yaz.')">🏠 Blok Çatı (Md. 69)</button>
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1" style="font-size:.72rem;" onclick="sendAiMessage('Aidat ödemeyen komşuya ne yapılır ve KVKK sınırı nedir?')">⚖️ Aidat &amp; KVKK</button>
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1" style="font-size:.72rem;" onclick="sendAiMessage('Genel kurul çağrısı ve vekalet sınırı nedir?')">🗳️ Toplantı &amp; Vekalet</button>
        </div>

        <div class="p-2 bg-white border-top">
            <div class="input-group input-group-sm">
                <input type="text" id="aiChatInput" class="form-control border bg-light rounded-start-pill ps-3" placeholder="KMK sorunuzu yazın..." onkeypress="if(event.key === 'Enter'){ event.preventDefault(); sendAiMessage(); }">
                <button type="button" class="btn btn-primary rounded-end-pill px-3 fw-bold" onclick="sendAiMessage()">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAiChat() {
        var box = document.getElementById('aiChatBox');
        if (!box) return;
        if (box.classList.contains('d-none')) {
            box.classList.remove('d-none');
            var inp = document.getElementById('aiChatInput');
            if (inp) inp.focus();
        } else {
            box.classList.add('d-none');
        }
    }

    function escapeAiHtml(str) {
        return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function copyAiDraftText(btn, draftId) {
        var el = document.getElementById(draftId);
        if (!el) return;
        navigator.clipboard.writeText(el.innerText).then(function () {
            btn.innerText = 'Kopyalandı ✓';
            setTimeout(function () { btn.innerText = 'Taslağı Kopyala'; }, 1800);
        });
    }

    async function sendAiMessage(msg) {
        var input = document.getElementById('aiChatInput');
        var text = (msg || (input ? input.value : '')).trim();
        if (!text) return;

        var msgs = document.getElementById('aiChatMessages');
        var userBubble = document.createElement('div');
        userBubble.className = 'd-flex mb-2 justify-content-end';
        userBubble.innerHTML = '<div class="bg-primary text-white p-2 px-3 rounded-3 shadow-sm" style="max-width:85%;font-size:.84rem;">' + escapeAiHtml(text) + '</div>';
        msgs.appendChild(userBubble);

        if (input && !msg) input.value = '';
        msgs.scrollTop = msgs.scrollHeight;

        var loadingId = 'aiLoad_' + Date.now();
        var loadBubble = document.createElement('div');
        loadBubble.id = loadingId;
        loadBubble.className = 'd-flex mb-2';
        loadBubble.innerHTML = '<div class="bg-white p-2 px-3 rounded-3 shadow-sm border text-muted" style="font-size:.82rem;"><span class="spinner-border spinner-border-sm me-2 text-primary"></span>Mevzuat taranıyor...</div>';
        msgs.appendChild(loadBubble);
        msgs.scrollTop = msgs.scrollHeight;

        try {
            var activeSlug = new URLSearchParams(window.location.search).get('slug') || '';
            var resp = await fetch('/AiAssistant/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question: text, activeSlug: activeSlug })
            });
            var data = await resp.json();
            var loader = document.getElementById(loadingId);
            if (loader) loader.remove();

            var ansBubble = document.createElement('div');
            ansBubble.className = 'd-flex mb-3';
            if (!resp.ok || data.error) {
                ansBubble.innerHTML = '<div class="bg-danger-subtle text-danger p-2 px-3 rounded-3 small border border-danger-subtle">' + escapeAiHtml(data.error || 'Yanıt alınamadı.') + '</div>';
            } else {
                var draftHtml = '';
                if (data.draftText) {
                    var did = 'aiDraft_' + Date.now();
                    draftHtml = '<div class="mt-2 p-2 bg-light border rounded-2" style="font-size:.78rem;">'
                        + '<div class="d-flex justify-content-between align-items-center mb-1"><strong class="text-success">Hazır Taslak Metni:</strong>'
                        + '<button type="button" class="btn btn-xs btn-outline-success py-0 px-2" style="font-size:.7rem;" onclick="copyAiDraftText(this,\'' + did + '\')">Taslağı Kopyala</button></div>'
                        + '<div id="' + did + '" class="text-dark" style="white-space:pre-line;">' + escapeAiHtml(data.draftText) + '</div></div>';
                }
                var linkHtml = data.recommendedUrl
                    ? '<div class="mt-2"><a href="' + escapeAiHtml(data.recommendedUrl) + '" class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none px-2 py-1">📘 İlgili Rehber: ' + escapeAiHtml(data.recommendedTitle || 'Aç') + ' &rarr;</a></div>'
                    : '';
                ansBubble.innerHTML = '<div class="bg-white p-3 rounded-3 shadow-sm border" style="max-width:92%;font-size:.83rem;">'
                    + '<div class="text-dark lh-base">' + escapeAiHtml(data.answer).replace(/\n/g, '<br/>') + '</div>'
                    + draftHtml
                    + linkHtml
                    + '<div class="text-muted mt-2 pt-1 border-top" style="font-size:.69rem;">' + escapeAiHtml(data.legalDisclaimer) + '</div>'
                    + '</div>';
            }
            msgs.appendChild(ansBubble);
            msgs.scrollTop = msgs.scrollHeight;
        } catch (err) {
            var loader2 = document.getElementById(loadingId);
            if (loader2) loader2.remove();
            var errBubble = document.createElement('div');
            errBubble.className = 'd-flex mb-2';
            errBubble.innerHTML = '<div class="bg-danger-subtle text-danger p-2 px-3 rounded-3 small">Bağlantı hatası oluştu, lütfen tekrar deneyin.</div>';
            msgs.appendChild(errBubble);
        }
    }
</script>
