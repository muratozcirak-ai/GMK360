@{
    Layout = "_Layout";
    var curAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var curCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<div class="container-fluid px-3 px-xl-4 mt-3">
    <div class="row">
        <!-- 4. ROL: GÖLGE & DIŞ İŞ ORTAĞI (TAŞERON / TEDARİKÇİ / BETON SANTRALİ / USTA) SOL MENÜ -->
        <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white fw-bold py-2.5 px-3">
                    <i class="bi bi-incognito text-warning me-2"></i> 4. Rol: İş Ortağı Portalı
                </div>
                <div class="list-group list-group-flush" style="font-size: 0.86rem;">
                    <a href="/PartnerPortal/Index" class="list-group-item list-group-item-action py-2.5 @(curCtrl == "PartnerPortal" && curAction == "Index" ? "active fw-bold" : "")">
                        <i class="bi bi-speedometer2 me-2 text-primary"></i> Açık Hesap & Durum Özeti
                    </a>

                    <a href="/PartnerPortal/Ledger" class="list-group-item list-group-item-action py-2.5 @(curAction == "Ledger" ? "active fw-bold" : "")">
                        <i class="bi bi-wallet2 me-2 text-success"></i> Cari Ekstrem (Alacak/Borç)
                    </a>

                    <a href="/PartnerPortal/Contracts" class="list-group-item list-group-item-action py-2.5 @(curAction == "Contracts" ? "active fw-bold" : "")">
                        <i class="bi bi-file-earmark-text me-2 text-info"></i> Sözleşmeler & Hakediş
                    </a>

                    <a href="/PartnerPortal/Timesheets" class="list-group-item list-group-item-action py-2.5 @(curAction == "Timesheets" ? "active fw-bold" : "")">
                        <i class="bi bi-calendar2-check me-2 text-warning"></i> Günlük Kör Puantaj Bildir
                    </a>

                    <a href="/PartnerPortal/Workers" class="list-group-item list-group-item-action py-2.5 @(curAction == "Workers" ? "active fw-bold" : "")">
                        <i class="bi bi-people-fill me-2 text-secondary"></i> Kendi Ekibim / Ustalarım
                    </a>

                    <div class="bg-light px-3 py-1.5 text-muted fw-bold small border-top border-bottom" style="font-size: 0.72rem;">
                        SARI REHBER & SAHA MASALARI
                    </div>

                    <a href="/Tedarikci/Index" class="list-group-item list-group-item-action py-2">
                        <i class="bi bi-shop me-2 text-warning"></i> Tedarikçi & Sarı Rehber Vitrini
                    </a>

                    <a href="/Taseron/Index" class="list-group-item list-group-item-action py-2">
                        <i class="bi bi-bricks me-2 text-primary"></i> Taşeron & Puantaj Kokpiti
                    </a>

                    <a href="/MobileTask/Index" class="list-group-item list-group-item-action py-2 text-danger fw-bold">
                        <i class="bi bi-phone-fill me-2 text-danger"></i> Usta / Formen Görev PWA
                    </a>
                </div>
            </div>

            <div class="alert alert-info mt-3 small shadow-xs border-0 rounded-3">
                <i class="bi bi-shield-check me-1"></i> <b>Sarı Rehber & Açık Hesap:</b> Şantiyelerimizle olan tüm açık hesap, irsaliye, hakediş ve puantaj mutabakatlarınızı buradan canlı takip edebilirsiniz.
            </div>
        </div>

        <!-- İÇERİK ALANI -->
        <div class="col-xl-10 col-lg-9 col-md-8">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
