@{
    Layout = "_Layout";
}

<div class="container-fluid px-4 px-xl-5 mt-4">
    <div class="row">
        <!-- TAŞERON / TEDARİKÇİ (B2B) SOL MENÜ -->
        <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-briefcase-fill me-2"></i> B2B Portal (İş Ortağı)
                </div>
                <div class="list-group list-group-flush" style="font-size: 0.95rem;">
                    
                    <a href="/PartnerPortal/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Durum Özeti
                    </a>
                    
                    <a href="/PartnerPortal/Ledger" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Ledger" ? "active" : "")">
                        <i class="bi bi-wallet2 me-2"></i> Cari Ekstrem (Alacak/Verecek)
                    </a>

                    <a href="/PartnerPortal/Contracts" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contracts" ? "active" : "")">
                        <i class="bi bi-file-earmark-text me-2"></i> Sözleşmeler ve Hakediş
                    </a>

                </div>
            </div>
            
            <div class="alert alert-info mt-3 small shadow-sm border-0">
                <i class="bi bi-info-circle me-1"></i> Bu ekranlar üzerinden firmamızla olan tüm finansal ve sözleşmesel durumunuzu anlık ve şeffaf olarak takip edebilirsiniz.
            </div>
        </div>

        <!-- İÇERİK ALANI -->
        <div class="col-xl-10 col-lg-9 col-md-8">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
