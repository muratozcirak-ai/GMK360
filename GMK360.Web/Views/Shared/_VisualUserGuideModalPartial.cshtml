        function resolveCurrentPageKey() {
            var p = (window.location.pathname || '').toLowerCase();
            if (p === '/dashboard/construction' || p === '/dashboard' || p === '/dashboard/index') return 'dashboard';
            if (p.indexOf('/agencystaff') === 0) return 'agencystaff';
            if (p.indexOf('/companygarage') === 0) return 'companygarage';
            if (p.indexOf('/inventory') === 0) return 'inventory';
            if (p.indexOf('/dashboard/siteyonetimi') === 0 || p.indexOf('/dashboard/themesettings') === 0) return 'siteyonetimi';
            if (p.indexOf('/agenda') === 0) return 'agenda';
            if (p.indexOf('/constructionproject') === 0) return 'constructionproject';
            if (p.indexOf('/finance') === 0) return 'finance';
            if (p.indexOf('/b2bpurchasing') === 0 || p.indexOf('/subcontractorcontract') === 0) return 'b2bpurchasing';
            if (p.indexOf('/documentarchive') === 0) return 'documentarchive';
            if (p.indexOf('/property') === 0) return 'property';
            return null;
        }

        window.openGmkContextualPageGuide = function (forceOpen) {
            var key = resolveCurrentPageKey();
            if (!key || !pageGuides[key]) {
                var gModal = document.getElementById('gmkVisualGuideModal');
                if (gModal) bootstrap.Modal.getOrCreateInstance(gModal).show();
                return;
            }

            var storageKey = 'gmk_hide_ctx_guide_' + key;
            if (!forceOpen && localStorage.getItem(storageKey) === '1') return;

            var info = pageGuides[key];
            document.getElementById('ctxGuideBadge').textContent = info.badge;
            document.getElementById('ctxGuideTitle').textContent = info.title;
            document.getElementById('ctxGuideSummary').textContent = info.summary;

            var cardsHtml = '';
            info.cards.forEach(function (c) {
                cardsHtml += '<div class="col-md-4"><div class="p-3 rounded-3 bg-white border h-100 shadow-xs">' +
                    '<div class="fw-bold text-dark small mb-1"><i class="bi ' + c.icon + ' me-1"></i>' + c.title + '</div>' +
                    '<div class="text-muted" style="font-size: 0.78rem;">' + c.desc + '</div>' +
                    '</div></div>';
            });
            document.getElementById('ctxGuideCards').innerHTML = cardsHtml;
            document.getElementById('ctxGuideTipBox').innerHTML = info.tip;

            var chk = document.getElementById('chkHideCtxPageGuide');
            if (chk) {
                chk.checked = (localStorage.getItem(storageKey) === '1');
                chk.setAttribute('data-page-key', key);
            }

            var modalEl = document.getElementById('gmkContextualPageGuideModal');
            if (modalEl) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        };

        window.toggleGmkCtxGuideAutoOpen = function (checked) {
            var chk = document.getElementById('chkHideCtxPageGuide');
            var key = chk ? chk.getAttribute('data-page-key') : resolveCurrentPageKey();
            if (!key) return;
            try {
                if (checked) localStorage.setItem('gmk_hide_ctx_guide_' + key, '1');
                else localStorage.removeItem('gmk_hide_ctx_guide_' + key);
            } catch (e) { }
        };

        document.addEventListener('DOMContentLoaded', function () {
            var key = resolveCurrentPageKey();
            if (key && pageGuides[key]) {
                // Proje detay / künye alt sayfalarında değil, ana menü başlığına ilk girildiğinde otomatik aç
                var pathParts = (window.location.pathname || '').split('/').filter(Boolean);
                var isMenuLanding = pathParts.length <= 2 || (pathParts[1] && pathParts[1].toLowerCase() === 'index');
                if (isMenuLanding && localStorage.getItem('gmk_hide_ctx_guide_' + key) !== '1') {
                    setTimeout(function () {
                        window.openGmkContextualPageGuide(false);
                    }, 400);
                }
            }
        });
    })();
