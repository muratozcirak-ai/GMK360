<script>
    function selectGmkGuideStep(stepNum, btnEl) {
        document.querySelectorAll('.gmk-guide-step-pane').forEach(function (el) {
            el.classList.add('d-none');
        });
        var target = document.getElementById('gmkGuidePane' + stepNum);
        if (target) target.classList.remove('d-none');

        document.querySelectorAll('.gmk-guide-step-btn').forEach(function (b) {
            b.classList.remove('active');
            b.style.background = '#1e293b';
            b.style.borderColor = '#334155';
        });
        if (btnEl) {
            btnEl.classList.add('active');
            btnEl.style.background = '#1e3a8a';
            btnEl.style.borderColor = '#38bdf8';
        }
    }

    function filterGmkGuideRole(roleKey, tabBtn) {
        var firstVisibleBtn = null;
        var firstVisibleIdx = 1;
        var idx = 1;
        document.querySelectorAll('.gmk-guide-step-btn').forEach(function (btn) {
            var roles = (btn.getAttribute('data-roles') || 'all').split(' ');
            if (roleKey === 'all' || roles.indexOf(roleKey) !== -1) {
                btn.classList.remove('d-none');
                if (!firstVisibleBtn) {
                    firstVisibleBtn = btn;
                    firstVisibleIdx = idx;
                }
            } else {
                btn.classList.add('d-none');
            }
            idx++;
        });
        if (firstVisibleBtn) {
            selectGmkGuideStep(firstVisibleIdx, firstVisibleBtn);
        }
    }

    // =========================================================================
    // GMK360 AKILLI ÇOKLU EKRAN (YENİ PENCERE & YENİ SEKME) MOTORU
    // =========================================================================
    window.getGmkOpenMode = function () {
        return localStorage.getItem('gmk360_open_mode') || 'smart';
    };

    window.setGmkOpenMode = function (mode) {
        localStorage.setItem('gmk360_open_mode', mode);
        updateGmkMultiScreenBadge();
    };

    window.openGmkPopupWindow = function (url, winName) {
        var name = winName || ('gmk_win_' + Math.floor(Math.random() * 10000));
        var w = Math.min(1480, window.screen.availWidth - 60);
        var h = Math.min(920, window.screen.availHeight - 60);
        var left = Math.max(20, Math.floor((window.screen.availWidth - w) / 2));
        var top = Math.max(20, Math.floor((window.screen.availHeight - h) / 2));
        var win = window.open(url, name, 'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top + ',resizable=yes,scrollbars=yes,location=yes,status=yes');
        if (!win) {
            window.open(url, '_blank');
        } else {
            win.focus();
        }
    };

    window.openGmkProjectWindow = function (url, projectId) {
        var mode = window.getGmkOpenMode();
        if (mode === 'same') {
            window.location.href = url;
            return;
        }
        if (mode === 'tab') {
            window.open(url, '_blank');
            return;
        }
        // 'smart' (varsayılan) veya 'window' modunda: Projeler ayrı pencerede açılır!
        window.openGmkPopupWindow(url, 'gmk_project_win_' + (projectId || 'main'));
    };

    function isProjectWorkspacePath(path) {
        if (!path) return false;
        var p = path.toLowerCase();
        return p.indexOf('/constructionproject/details') === 0 ||
               p.indexOf('/constructionproject/workspace') === 0 ||
               p.indexOf('/constructionproject/feasibility') === 0 ||
               p.indexOf('/constructionproject/proposal') === 0 ||
               p.indexOf('/metraj/') === 0 ||
               p.indexOf('/phasezero/') === 0 ||
               p.indexOf('/phaseone/') === 0 ||
               p.indexOf('/phasetwo/') === 0 ||
               p.indexOf('/phasethree/') === 0 ||
               p.indexOf('/phasefour/') === 0 ||
               p.indexOf('/phasefive/') === 0 ||
               p.indexOf('/phasesix/') === 0 ||
               p.indexOf('/phaseseven/') === 0 ||
               p.indexOf('/phaseeight/') === 0;
    }

    function isCompanyOrCrossModulePath(path) {
        if (!path) return false;
        var p = path.toLowerCase();
        return p.indexOf('/b2bpurchasing') === 0 ||
               p.indexOf('/finance') === 0 ||
               p.indexOf('/sitediary') === 0 ||
               p.indexOf('/agencystaff') === 0 ||
               p.indexOf('/companygarage') === 0 ||
               p.indexOf('/inventory') === 0 ||
               p.indexOf('/constructionphases/compareoffers') === 0 ||
               p.indexOf('/dashboard/siteyonetimi') === 0 ||
               p.indexOf('/dashboard/themesettings') === 0 ||
               p.indexOf('/agencystore') === 0 ||
               p.indexOf('/partnerportal') === 0 ||
               p.indexOf('/tedarikci') === 0 ||
               p.indexOf('/taseron') === 0 ||
               p.indexOf('/mobiletask') === 0;
    }

    function updateGmkMultiScreenBadge() {
        var mode = window.getGmkOpenMode();
        var lbl = document.getElementById('gmkMultiScreenModeLabel');
        if (lbl) {
            lbl.innerText = mode === 'smart' ? 'Akıllı Pencere/Sekme'
                          : mode === 'window' ? 'Hep Yeni Pencere'
                          : mode === 'tab' ? 'Hep Yeni Sekme'
                          : 'Aynı Sekme';
        }
        document.querySelectorAll('[data-gmk-open-mode]').forEach(function (item) {
            if (item.getAttribute('data-gmk-open-mode') === mode) {
                item.classList.add('fw-bold', 'bg-primary', 'bg-opacity-10');
            } else {
                item.classList.remove('fw-bold', 'bg-primary', 'bg-opacity-10');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // 1. Üst Bara "Çoklu Ekran (Yeni Sekme / Pencere)" Seçici Ekle
        var guideBtn = document.querySelector('[data-bs-target="#gmkVisualGuideModal"]');
        if (guideBtn && guideBtn.parentElement && !document.getElementById('gmkMultiScreenDropdown')) {
            var wrap = document.createElement('div');
            wrap.className = 'dropdown d-inline-block';
            wrap.id = 'gmkMultiScreenDropdown';
            wrap.innerHTML =
                '<button class="btn btn-light border text-dark px-2.5 py-1 rounded-pill dropdown-toggle d-flex align-items-center gap-1 btn-sm shadow-xs fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.74rem;" title="Sayfa ve Proje Açılış Tercihi (Yan Yana Karşılaştırma Modu)">' +
                    '<i class="bi bi-window-stack text-primary"></i>' +
                    '<span class="d-none d-lg-inline" id="gmkMultiScreenModeLabel">Akıllı Pencere/Sekme</span>' +
                '</button>' +
                '<ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius: 12px; min-width: 315px; font-size: 0.79rem;">' +
                    '<li class="px-3 py-1.5 border-bottom bg-light rounded-top-3 text-muted fw-bold small">' +
                        '🪟 ÇOKLU EKRAN & YAN YANA İNCELEME MODU' +
                    '</li>' +
                    '<li><a class="dropdown-item py-1.5" href="javascript:void(0)" data-gmk-open-mode="smart" onclick="setGmkOpenMode(\'smart\')">' +
                        '✨ <strong>Akıllı Mod (Varsayılan):</strong> Proje = Yeni Pencere, Modül = Yeni Sekme' +
                    '</a></li>' +
                    '<li><a class="dropdown-item py-1.5" href="javascript:void(0)" data-gmk-open-mode="tab" onclick="setGmkOpenMode(\'tab\')">' +
                        '➕ <strong>Karşılaştırma (Yeni Sekme):</strong> Tıklanan Her Yeri Yeni Sekmede Aç' +
                    '</a></li>' +
                    '<li><a class="dropdown-item py-1.5" href="javascript:void(0)" data-gmk-open-mode="window" onclick="setGmkOpenMode(\'window\')">' +
                        '🪟 <strong>Yan Yana 2 Ekran (Yeni Pencere):</strong> Tıklanan Yeri Ayrı Pencerede Aç' +
                    '</a></li>' +
                    '<li><a class="dropdown-item py-1.5" href="javascript:void(0)" data-gmk-open-mode="same" onclick="setGmkOpenMode(\'same\')">' +
                        '🔄 <strong>Klasik Mod:</strong> Aynı Sekmede Aç' +
                    '</a></li>' +
                '</ul>';
            guideBtn.parentElement.insertBefore(wrap, guideBtn.nextSibling);
            updateGmkMultiScreenBadge();
        }

        // 2. Sol Menüdeki Her Linkin Yanına Hızlı "↗ Yeni Sekme" ve "🪟 Yeni Pencere" İkonu Ekle
        if (false) document.querySelectorAll('.list-group-item-action[href]').forEach(function (link) {
            var href = link.getAttribute('href');
            if (!href || href === '#' || href.indexOf('javascript:') === 0 || link.querySelector('.gmk-quick-win-icons')) return;

            var iconGroup = document.createElement('span');
            iconGroup.className = 'gmk-quick-win-icons ms-auto ps-2 d-inline-flex align-items-center gap-1 opacity-75';
            iconGroup.innerHTML =
                '<span role="button" class="badge bg-light text-dark border px-1.5 py-0.5 rounded" style="font-size:0.65rem;" title="Yeni Sekmede Aç" onclick="event.preventDefault(); event.stopPropagation(); window.open(\'' + href.replace(/'/g, "\\'") + '\', \'_blank\');">' +
                    '<i class="bi bi-box-arrow-up-right"></i>' +
                '</span>' +
                '<span role="button" class="badge bg-light text-primary border px-1.5 py-0.5 rounded" style="font-size:0.65rem;" title="Yan Yana Ayrı Pencerede Aç" onclick="event.preventDefault(); event.stopPropagation(); window.openGmkPopupWindow(\'' + href.replace(/'/g, "\\'") + '\');">' +
                    '<i class="bi bi-window-stack"></i>' +
                '</span>';
            link.appendChild(iconGroup);
        });

        // 3. Akıllı Tıklama Yakalayıcı (Proje Açılışı -> Yeni Pencere, Çapraz Modül -> Yeni Sekme)
        document.addEventListener('click', function (e) {
            var anchor = e.target.closest('a[href]');
            if (!anchor) return;
            var rawHref = anchor.getAttribute('href');
            if (!rawHref || rawHref === '#' || rawHref.indexOf('javascript:') === 0 || rawHref.indexOf('#') === 0) return;
            if (anchor.hasAttribute('data-bs-toggle') || anchor.getAttribute('target') === '_blank') return;
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;

            var mode = window.getGmkOpenMode();
            if (mode === 'same') return;

            var urlObj;
            try {
                urlObj = new URL(anchor.href, window.location.origin);
            } catch (err) {
                return;
            }
            if (urlObj.origin !== window.location.origin) return;

            // Dil/Rol ön izleme gibi state değiştiren aksiyonlar aynı sekmede kalsın
            if (urlObj.pathname.toLowerCase().indexOf('/switchrolepreview') !== -1) return;

            if (mode === 'tab') {
                e.preventDefault();
                window.open(anchor.href, '_blank');
                return;
            }
            if (mode === 'window') {
                e.preventDefault();
                window.openGmkPopupWindow(anchor.href);
                return;
            }

            // SMART MODE:
            var curInProject = isProjectWorkspacePath(window.location.pathname);
            var targetInProject = isProjectWorkspacePath(urlObj.pathname);
            var targetIsCrossModule = isCompanyOrCrossModulePath(urlObj.pathname);

            // Şirket ekranından bir Projeye giriliyorsa -> YENİ PENCEREDE AÇ!
            if (!curInProject && targetInProject) {
                e.preventDefault();
                window.openGmkProjectWindow(anchor.href, urlObj.pathname);
                return;
            }

            // Proje içindeyken Şirket / Satınalma / Finans / Defter gibi çapraz modüle basılıyorsa -> YENİ SEKMEDE AÇ!
            if (curInProject && targetIsCrossModule) {
                e.preventDefault();
                window.open(anchor.href, '_blank');
                return;
            }
        });
    });
</script>

<!-- TÜM MENÜ BAŞLIKLARI İÇİN BAĞLAMSAL SAYFA TANITIM & KULLANIM REHBERİ MODALI -->
<div class="modal fade" id="gmkContextualPageGuideModal" tabindex="-1" aria-hidden="true">
