                <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning text-dark small" id="ctxGuideTipBox"></div>
            </div>
            <div class="modal-footer bg-white border-top py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="chkHideCtxPageGuide" onchange="window.toggleGmkCtxGuideAutoOpen(this.checked)">
                    <label class="form-check-label small fw-bold text-secondary" for="chkHideCtxPageGuide" style="cursor:pointer;">
                        Bu sayfanın tanıtımını bir daha otomatik açma <span class="text-muted fw-normal">(Üstteki "💡 Bu Sayfa Ne İşe Yarar?" butonundan her zaman açabilirsiniz)</span>
                    </label>
                </div>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                    <i class="bi bi-check2-circle me-1"></i>Anladım, Ekranı Kullanmaya Başla
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var pageGuides = {
            'dashboard': {
                badge: '1. MENÜ • ÖZETİM & PROFİLİM',
                title: '🪪 Özetim & Profilim Ekranı Ne İşe Yarar?',
