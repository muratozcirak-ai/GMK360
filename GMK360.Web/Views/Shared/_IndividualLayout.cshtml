@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- EV ARAYAN ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light text-danger fw-bold border-bottom">
                    <i class="bi bi-search-heart me-2"></i> Bireysel / Ev Arayan
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/Individual" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Individual" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Özeti Gör
                    </a>
                    
                    <a href="/Dashboard/Favorilerim" class="list-group-item list-group-item-action">
                        <i class="bi bi-heart-fill text-danger me-2"></i> Favori İlanlarım
                    </a>

                    <a href="/Dashboard/KayitliAramalar" class="list-group-item list-group-item-action">
                        <i class="bi bi-bell-fill text-warning me-2"></i> Kayıtlı Aramalarım
                    </a>

                    <!-- CRM & İLETİŞİM -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        AJANDA & TALEPLER (AİDİYETLİ)
                    </div>
                    <a href="/Crm/Ajanda?context=seeker" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-check me-2"></i> Emlak (Ev Görme) Randevularım
                    </a>
                    
                    <a href="/Crm/Talepler?context=seeker" class="list-group-item list-group-item-action">
                        <i class="bi bi-house-add me-2"></i> Emlakçıya Ev Bulma Talepleri
                    </a>

                    <a href="/Crm/Talepler?context=seeker_service" class="list-group-item list-group-item-action">
                        <i class="bi bi-tools me-2"></i> Usta / Tadilat Teklif Taleplerim
                    </a>
                    
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        İLETİŞİM
                    </div>
                                        <a href="javascript:void(0)" onclick="toggleAiChat()" class="list-group-item list-group-item-action text-primary fw-bold">
                        <i class="ph-fill ph-robot me-2 fs-5 align-middle"></i> Yapay Zeka Asistan�
                    </a>
                    <a href="/Dashboard/Mesajlar" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-dots me-2"></i> Mesajlarım
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)


