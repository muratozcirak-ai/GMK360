@inject Microsoft.AspNetCore.Identity.UserManager<GMK360.Core.Entities.Identity.ApplicationUser> UserManager
@inject GMK360.Web.Services.ISeoService SeoService
@{
    var path = Context.Request.Path.Value;
    var seo = await SeoService.GetSeoForPathAsync(path);
    string title = seo?.Title ?? ViewData["Title"]?.ToString() ?? "Ya?am ve Hizmet Ekosistemi";
    string desc = seo?.Description ?? "GMK360, T?rkiye'nin yeni nesil ak?ll? emlak, bina y?netimi ve hizmet ekosistemidir.";
    string keywords = seo?.Keywords ?? "emlak platformu, ak?ll? de?erleme, bina y?netimi";
    string ogImage = seo?.OgImage ?? "https://gmk360.com/images/og-image.jpg";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Dynamic SEO & Open Graph Tags -->
    <meta name="description" content="@desc">
    <meta name="keywords" content="@keywords">
    <meta property="og:title" content="@title - GMK360">
    <meta property="og:description" content="@desc">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://gmk360.com@path">
    <meta property="og:image" content="@ogImage">
    <meta name="twitter:card" content="summary_large_image">

    <!-- PWA Manifest & Theme Color -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#1e3a8a">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <title>@title - GMK360</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        .text-navy { color: #1e3a8a !important; }
        .text-orange { color: #f97316 !important; }
        .bg-navy { background-color: #1e3a8a !important; }
        .bg-orange { background-color: #f97316 !important; }
        .btn-orange { background-color: #f97316; color: white; border: none; font-weight: 600; }
        .btn-orange:hover { background-color: #ea580c; color: white; }
        .btn-outline-navy { color: #1e3a8a; border-color: #1e3a8a; font-weight: 600; }
        .btn-outline-navy:hover { background-color: #1e3a8a; color: white; }
    </style>
    @await RenderSectionAsync("SEO", required: false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    @if (User.Identity.IsAuthenticated && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")))
    {
        <div class="bg-dark text-white py-1 px-3 d-flex flex-wrap align-items-center justify-content-between border-bottom" style="background: linear-gradient(90deg, #111827 0%, #1f2937 100%); font-size: 0.82rem; position: sticky; top: 0; z-index: 100000;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-danger rounded-pill px-2 py-1 fw-bold">⚡ SÜPER KULLANICI</span>
                <span class="text-white-50 d-none d-lg-inline">Tüm Modüllere Tek Tıkla Geçiş:</span>
            </div>
            <div class="d-flex flex-wrap gap-1 my-1">
                <a href="/ConstructionProject" class="badge bg-warning text-dark text-decoration-none px-2 py-1">🏗️ İnşaat</a>
                <a href="/Usta" class="badge bg-primary text-white text-decoration-none px-2 py-1">🛠️ Usta PWA</a>
                <a href="/Taseron" class="badge bg-info text-dark text-decoration-none px-2 py-1">👷 Taşeron</a>
                <a href="/Tedarikci" class="badge bg-secondary text-white text-decoration-none px-2 py-1">🧱 Nalbur</a>
                <a href="/Kurumsal" class="badge bg-dark text-light border text-decoration-none px-2 py-1">🏢 Sanayi Hub</a>
                <a href="/Realtor" class="badge bg-success text-white text-decoration-none px-2 py-1">🏠 Emlakçı CRM</a>
                <a href="/Realtor/BrokerHub" class="badge bg-primary bg-opacity-75 text-white text-decoration-none px-2 py-1">🏢 Remax</a>
                <a href="/Projeler" class="badge bg-info text-white text-decoration-none px-2 py-1">📜 Lansman</a>
                <a href="/Emlak/Ara" class="badge bg-light text-dark text-decoration-none px-2 py-1">⚖️ Kıyaslama</a>
                <a href="/DigitalHome" class="badge bg-success bg-opacity-75 text-white text-decoration-none px-2 py-1">🧾 Dairem & Fatura</a>
                <a href="/Landlord/Dashboard" class="badge bg-warning bg-opacity-75 text-dark text-decoration-none px-2 py-1">🏘️ Ev Sahibi</a>
                <a href="/BuildingManager" class="badge bg-danger bg-opacity-75 text-white text-decoration-none px-2 py-1">🏢 Bina Yönetimi</a>
                <a href="/DailyRental/Index" class="badge text-white text-decoration-none px-2 py-1" style="background-color:#8b5cf6;">🛏️ Günlük Kiralık</a>
                <a href="/Agenda/Index" class="badge bg-warning text-dark text-decoration-none px-2 py-1">📒 Kara Defter</a>
            </div>
        </div>
    }
    <header class="fixed-top bg-white border-bottom shadow-sm">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2">
                <i class="ph-fill ph-infinity text-orange" style="font-size: 2.2rem;"></i>
                <span class="fs-3 fw-bold text-navy" style="letter-spacing:-1px;">GMK<span class="text-orange">360</span></span>
            </a>
            
            <nav class="d-none d-md-flex gap-3 fw-medium text-secondary">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark hover-orange fw-bold">Ana Sayfa</a>
                <a href="/Emlak/Ara" class="text-decoration-none text-dark hover-orange fw-bold"><i class="ph-bold ph-columns text-primary me-1"></i>Emlak Kıyasla</a>
                <a href="/Projeler" class="text-decoration-none text-dark hover-orange fw-bold"><i class="ph-bold ph-compass text-info me-1"></i>Yeni Projeler</a>
                <a href="/Usta" class="text-decoration-none text-dark hover-orange fw-bold"><i class="bi bi-tools text-warning me-1"></i>Usta & Tadilat</a>
                <a href="/Realtor" class="text-decoration-none text-dark hover-orange fw-bold"><i class="ph-bold ph-buildings text-success me-1"></i>Emlakçı Masası</a>
            </nav>

            <div class="d-flex gap-3 align-items-center">
                <!-- Tarih ve Saat -->
                <div class="d-none d-lg-flex align-items-center text-muted fw-bold border-end pe-3 me-1" style="font-size: 0.9rem;">
                    <i class="bi bi-calendar3 me-2 text-orange"></i>
                    <span id="navLiveDate"></span>
                    <i class="bi bi-clock ms-3 me-2 text-primary"></i>
                    <span id="navLiveTime"></span>
                </div>
                
