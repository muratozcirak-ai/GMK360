    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
          <!-- PWA Service Worker iptal kodu -->
      <script>
          if ('serviceWorker' in navigator) {
              navigator.serviceWorker.getRegistrations().then(function(registrations) {
                  for(let registration of registrations) {
                      // Service Worker aktif (Network-First stratejisi ile önbellek kilitlenmesi yapmaz)
                  }
                  navigator.serviceWorker.register('/sw.js');
                  }
              });
          }
      </script>
    
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_AiChatWidget" />
<script>
        function updateNavClock() {
            const now = new Date();
            const dateStr = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
            const timeStr = now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
            
            const dateEl = document.getElementById('navLiveDate');
            const timeEl = document.getElementById('navLiveTime');
            if(dateEl) dateEl.innerText = dateStr;
            if(timeEl) timeEl.innerText = timeStr;
        }
        setInterval(updateNavClock, 1000);
        updateNavClock();
    </script>
    <!-- PRO KAMPANYA DETAY MODALI (ZARİF BİLGİLENDİRME, POPUP YOK) -->
    <div class="modal fade" id="proCampaignModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <span class="badge bg-primary rounded-pill px-3 py-1 me-2 fw-bold">PRO Üye Kampanyası</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <h5 class="fw-bold text-navy mb-2">SolarPlus Yenilenebilir Enerji Sistemleri</h5>
                    <p class="text-muted small mb-3">Çatı Tipi Güneş Enerjisi (GES) ve Isı Pompası Entegrasyonunda Bu Aya Özel Ücretsiz Mühendislik Keşfi.</p>
                    <div class="p-3 bg-light rounded-3 small mb-3">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Kapsam:</span>
                            <strong class="text-dark">Müstakil Villa, Apartman & Şantiye</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Avantaj:</span>
                            <strong class="text-success">%15 Peşin Erken Rezervasyon İndirimi</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted">Doğrulama:</span>
                            <span class="badge bg-success">GMK360 Akredite PRO Firma</span>
                        </div>
                    </div>
                    <a href="/Kurumsal" class="btn btn-primary rounded-pill w-100 fw-bold">
                        Firma Profilini Gör & Teklif İste
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>












