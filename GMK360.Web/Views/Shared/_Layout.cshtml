                            <i class="ph-fill ph-user-circle fs-5"></i>
                            <span class="d-none d-md-inline">Hesabım</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 200px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold">@( (await UserManager.GetUserAsync(User))?.DisplayName ?? User.Identity.Name )</div>
                            </li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="ph ph-gear me-2 text-muted"></i>Sistem Yönetimi</a></li>
                            }
                            else
                            {
                                @if (User.IsInRole("InsaatFirmasi") || User.IsInRole("Corporate"))
                                {
                                    <li><a class="dropdown-item" href="/Dashboard/Construction"><i class="ph ph-buildings me-2 text-primary"></i>Şirket Panosu (ERP)</a></li>
                                }
                                <li><a class="dropdown-item" href="/BuildingManager/Index"><i class="bi bi-building-gear me-2 text-success"></i>Bina & Site Yönetimi</a></li>
                                <li><a class="dropdown-item" href="/Landlord/Dashboard"><i class="bi bi-person-workspace me-2 text-primary"></i>Ultra Pro Mülk Sahibi Kokpiti</a></li>
                                <li><a class="dropdown-item" href="/Usta"><i class="bi bi-tools me-2 text-warning"></i>Usta Mobil Masası (PWA)</a></li>
                                <li><a class="dropdown-item" href="/Taseron"><i class="bi bi-cone-striped me-2 text-primary"></i>Taşeron & Puantaj Masası</a></li>
                                <li><a class="dropdown-item" href="/Tedarikci"><i class="bi bi-shop me-2 text-warning"></i>Nalbur & Tedarikçi Masası</a></li>
                                <li><a class="dropdown-item" href="/Kurumsal"><i class="bi bi-buildings-fill me-2 text-dark"></i>Kurumsal B2B & Sanayi Hub'ı</a></li>
                                <li><a class="dropdown-item" asp-controller="CustomerDashboard" asp-action="Index"><i class="ph ph-squares-four me-2 text-muted"></i>Çalışma Alanı (Hub)</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="ph ph-user me-2 text-muted"></i>Profil & Ayarlar</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item text-danger"><i class="ph ph-sign-out me-2"></i>Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn text-secondary fw-bold px-3">Giriş Yap</a>
                    <a asp-controller="Account" asp-action="QuickRegister" class="btn btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" style="background-color: #f59e0b; border: none;">
                        <i class="bi bi-lightning-charge-fill"></i> Hızlı Kayıt
                    </a>
                }
            </div>
        </div>

        <!-- AKILLI SEZONLUK TAVSİYE & PRO KAMPANYA ŞERİDİ (SIFIR DIŞ REKLAM) -->
        <div class="py-1 px-3 border-top border-secondary border-opacity-25 d-none d-md-block" style="background: linear-gradient(90deg, #0d1b2a 0%, #1b263b 100%); font-size: 0.82rem;">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold px-2 py-0" style="font-size: 0.72rem;">💡 Akıllı Hatırlatıcı</span>
                    <span class="text-white-50">
                        @(DateTime.UtcNow.Month >= 10 || DateTime.UtcNow.Month <= 3 
                            ? "Kış kapıda: Kombi ve petek temizliği yaptırarak doğalgaz faturanızda %25 tasarruf sağlayabilirsiniz." 
                            : "Bahar dönemi: Balkon su yalıtımı ve klima filtre kontrollerinizi yaptırmayı unutmayın.")
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-0" style="font-size: 0.72rem;">⭐ PRO Vitrin</span>
                    <a href="#" class="text-warning text-decoration-none fw-bold" data-bs-toggle="modal" data-bs-target="#proCampaignModal">
                        Güneş Enerjisi Sistemlerinde Erken Keşif Fırsatı →
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="flex-grow-1" style="margin-top: 104px;">
        @RenderBody()
    </main>

            <footer class="bg-navy text-white mt-auto py-5 border-top border-secondary border-opacity-25">
        <div class="container-fluid px-4 px-lg-5">
            <div class="row gy-5">
                
                <!-- 1. Kurumsal Kimlik & Güven -->
