@inject Microsoft.AspNetCore.Identity.UserManager<GMK360.Core.Entities.Identity.ApplicationUser> UserManager
@inject GMK360.Web.Services.ISeoService SeoService
@{
    var path = Context.Request.Path.Value;
    var seo = await SeoService.GetSeoForPathAsync(path);
    string title = seo?.Title ?? ViewData["Title"]?.ToString() ?? "Ya�am ve Hizmet Ekosistemi";
    string desc = seo?.Description ?? "GMK360, T�rkiye'nin yeni nesil ak�ll� emlak, bina y�netimi ve hizmet ekosistemidir.";
    string keywords = seo?.Keywords ?? "emlak platformu, ak�ll� de�erleme, bina y�netimi";
    string ogImage = seo?.OgImage ?? "https://gmk360.com/images/og-image.jpg";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Dynamic SEO & Open Graph Tags -->
    <meta name="description" content="@desc">
    <meta name="keywords" content="@keywords">
    <meta property="og:title" content="@title - GMK360">
    <meta property="og:description" content="@desc">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://gmk360.com@path">
    <meta property="og:image" content="@ogImage">
    <meta name="twitter:card" content="summary_large_image">

    <!-- PWA Manifest & Theme Color -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#1e3a8a">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <title>@title - GMK360</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        .text-navy { color: #1e3a8a !important; }
        .text-orange { color: #f97316 !important; }
        .bg-navy { background-color: #1e3a8a !important; }
        .bg-orange { background-color: #f97316 !important; }
        .btn-orange { background-color: #f97316; color: white; border: none; font-weight: 600; }
        .btn-orange:hover { background-color: #ea580c; color: white; }
        .btn-outline-navy { color: #1e3a8a; border-color: #1e3a8a; font-weight: 600; }
        .btn-outline-navy:hover { background-color: #1e3a8a; color: white; }
    </style>
    @await RenderSectionAsync("SEO", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header class="fixed-top bg-white border-bottom shadow-sm">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2">
                <i class="ph-fill ph-infinity text-orange" style="font-size: 2.2rem;"></i>
                <span class="fs-3 fw-bold text-navy" style="letter-spacing:-1px;">GMK<span class="text-orange">360</span></span>
            </a>
            
            <nav class="d-none d-md-flex gap-4 fw-medium text-secondary">
                
                <a href="#" class="text-decoration-none text-dark hover-orange">Bina Yönetimi</a>
                <a asp-controller="DigitalHome" asp-action="Index" class="text-decoration-none text-dark hover-orange">Dijital Evim</a>
                <a asp-controller="AiAssistant" asp-action="Index" class="text-decoration-none text-primary hover-orange fw-bold"><i class="ph-fill ph-robot align-middle me-1"></i>Yapay Zeka Asistanı�</a>`r`n                <a asp-controller="TaxAssistant" asp-action="Simulator" class="text-decoration-none text-primary hover-orange fw-bold">Beyanname Asistanıı</a>
                <a href="#" class="text-decoration-none text-dark hover-orange">Hizmetler</a>
            </nav>

            <div class="d-flex gap-3 align-items-center">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-navy px-4 rounded-pill dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="ph-fill ph-user-circle fs-5"></i>
                            <span class="d-none d-md-inline">Hesabım</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 200px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold">@( (await UserManager.GetUserAsync(User))?.DisplayName ?? User.Identity.Name )</div>
                            </li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="ph ph-gear me-2 text-muted"></i>Sistem Yönetimi</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="CustomerDashboard" asp-action="Index"><i class="ph ph-squares-four me-2 text-muted"></i>Çalışma Alanı</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="ph ph-user me-2 text-muted"></i>Profil & Ayarlar</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item text-danger"><i class="ph ph-sign-out me-2"></i>Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn text-secondary fw-medium">Giriş Yap</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-orange px-4 rounded-pill">Ücretsiz Başla</a>
                }
            </div>
        </div>
    </header>

    <main role="main" class="flex-grow-1" style="margin-top: 76px;">
        @RenderBody()
    </main>

    <footer class="bg-navy text-white mt-auto py-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <span class="fs-4 fw-bold text-white mb-3 d-block">GMK<span class="text-orange">360</span></span>
                    <p class="text-white-50">Yaşam ve İş Alanınızın İhtiyaç Duyduğu Her Şey Tek Platformda.</p>
                </div>
                <div class="col-md-2">
                    <h6 class="text-uppercase fw-bold text-orange mb-3">Çözümler</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-white-50">
                        <li>Bina Yönetimi</li>
                        <li>Dijital Evim</li>
                        <li><a asp-controller="Contact" asp-action="Index" class="text-white-50 text-decoration-none">�leti�im</a></li>
                        <li>Hizmet Ekosistemi</li>
                    </ul>
                </div>
                <div class="col-md-3 offset-md-3 text-md-end">
                    <a href="/Admin/Index" class="text-white-50 text-decoration-none small"><i class="ph ph-lock me-1"></i>Sistem Yöneticisi Girişi</a>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50 small">
                &copy; @DateTime.Now.Year GMK360 Süper Uygulama. Tüm hakları saklıdır.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('ServiceWorker registration successful with scope: ', registration.scope);
                    })
                    .catch(error => {
                        console.log('ServiceWorker registration failed: ', error);
                    });
            });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_AiChatWidget" />
</body>
</html>









