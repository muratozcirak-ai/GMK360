@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- Sol Menü (Sidebar) -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-speedometer2 me-2"></i> Yönetim Paneli
                </div>
                <div class="list-group list-group-flush">
                    <!-- ORTAK MENÜLER (Herkes) -->
                    <a href="/Dashboard/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-house-door me-2"></i> Özet (Dashboard)
                    </a>
                    <a href="/Identity/Account/Manage" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-circle me-2"></i> Profilimi Düzenle
                    </a>
                    <a href="/Dashboard/Mesajlar" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Mesajlar" ? "active" : "")">
                        <i class="bi bi-envelope me-2"></i> Mesajlarım
                    </a>

                    <!-- SADECE ALICI -->
                    @if (User.IsInRole("Alici"))
                    {
                        <a href="/Dashboard/Favorilerim" class="list-group-item list-group-item-action">
                            <i class="bi bi-heart me-2"></i> Favori İlanlarım
                        </a>
                    }

                    <!-- EMLAKÇI VE DANIŞMAN MENÜLERİ -->
                    @if (User.IsInRole("Emlakci") || User.IsInRole("Danisman") || User.IsInRole("Admin"))
                    {
                        <a href="/Dashboard/Portfoyum" class="list-group-item list-group-item-action">
                            <i class="bi bi-briefcase me-2"></i> Portföyüm / İlan Yönetimi
                        </a>
                        @if (User.IsInRole("Emlakci") || User.IsInRole("Admin"))
                        {
                            <a href="/Dashboard/Ekibim" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Ekibim" ? "active" : "")">
                                <i class="bi bi-people me-2"></i> Danışman Yönetimi (Ekibim)
                            </a>
                        }
                        <a href="/Dashboard/MusteriDegerlendirmeleri" class="list-group-item list-group-item-action">
                            <i class="bi bi-star me-2"></i> Müşteri Değerlendirmeleri
                        </a>
                        <a href="/Dashboard/Cuzdanim" class="list-group-item list-group-item-action">
                            <i class="bi bi-wallet2 me-2"></i> Dijital Cüzdanım
                        </a>
                        <a href="/Dashboard/Referansim" class="list-group-item list-group-item-action">
                            <i class="bi bi-share me-2"></i> Referans Kodum
                        </a>
                    }

                    <!-- USTA VE ESNAF MENÜLERİ -->
                    @if (User.IsInRole("ServiceProvider") || User.IsInRole("Admin"))
                    {
                        <a href="/Dashboard/UstaProfilim" class="list-group-item list-group-item-action">
                            <i class="bi bi-tools me-2"></i> Hizmet Profilim
                        </a>
                        <a href="/Dashboard/UstaReferans" class="list-group-item list-group-item-action">
                            <i class="bi bi-link-45deg me-2"></i> Referans ve Bağlantı
                        </a>
                        <a href="/Dashboard/PaketYonetimi" class="list-group-item list-group-item-action">
                            <i class="bi bi-box-seam me-2"></i> Paket & Görünürlük
                        </a>
                        <!-- Usta da cüzdan kullanabilir (bakiye görebilir) -->
                        <a href="/Dashboard/Cuzdanim" class="list-group-item list-group-item-action">
                            <i class="bi bi-wallet2 me-2"></i> Dijital Cüzdanım
                        </a>
                    }

                    <!-- MÜŞTERİ YÖNETİMİ & CRM -->
                    @if (User.IsInRole("Emlakci") || User.IsInRole("Danisman") || User.IsInRole("Admin"))
                    {
                        <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                            MÜŞTERİ YÖNETİMİ (CRM)
                        </div>
                        <a href="/Crm/Rehber" class="list-group-item list-group-item-action">
                            <i class="bi bi-journal-richtext me-2"></i> Müşterilerim (Rehber)
                        </a>
                        <a href="/Crm/Ajanda" class="list-group-item list-group-item-action">
                            <i class="bi bi-calendar-event me-2"></i> Ajandam (Randevular)
                        </a>
                        <a href="/Crm/Talepler" class="list-group-item list-group-item-action">
                            <i class="bi bi-chat-left-text me-2"></i> Müşteri Talepleri
                        </a>
                        <a href="/Crm/KiralamaTakip" class="list-group-item list-group-item-action">
                            <i class="bi bi-building me-2"></i> Kiralama ve Ödeme Takip
                        </a>
                    }

                    <!-- GÜNLÜK KİRALAMA & KBS -->
                    @if (User.IsInRole("Emlakci") || User.IsInRole("Danisman") || User.IsInRole("Admin"))
                    {
                        <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                            GÜNLÜK KİRALAMA
                        </div>
                        <a href="/DailyRentalAgenda/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DailyRentalAgenda" ? "active" : "")">
                            <i class="bi bi-calendar-range me-2"></i> Ajanda ve KBS
                        </a>
                    }

                    <!-- FİNANS VE MUHASEBE (Kurumsal, Emlakçı, Usta, İnşaat Firması) -->
                    @if (User.IsInRole("Emlakci") || User.IsInRole("ServiceProvider") || User.IsInRole("InsaatFirmasi") || User.IsInRole("Admin"))
                    {
                        <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                            FİNANS VE MUHASEBE
                        </div>
                        <a href="/Dashboard/FinansCari" class="list-group-item list-group-item-action">
                            <i class="bi bi-calculator me-2"></i> Cari Hesap Özeti
                        </a>
                        <a href="/Dashboard/FaturaBilgilerim" class="list-group-item list-group-item-action">
                            <i class="bi bi-receipt me-2"></i> Fatura Bilgilerim
                        </a>
                        <a href="/Dashboard/Faturalarim" class="list-group-item list-group-item-action">
                            <i class="bi bi-file-earmark-pdf me-2"></i> Faturalarım (E-Fatura)
                        </a>
                        <a href="/Commission/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Commission" ? "active" : "")">
                            <i class="bi bi-cash-coin me-2"></i> Bekleyen Komisyon Ödemeleri
                        </a>
                    }

                    <!-- İNŞAAT FİRMASI -->
                    @if (User.IsInRole("InsaatFirmasi") || User.IsInRole("Admin"))
                    {
                        <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                            İNŞAAT PROJELERİ & SİTE CMS
                        </div>
                        <a href="/Dashboard/Projelerim" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Projelerim" ? "active" : "")">
                            <i class="bi bi-cone-striped me-2"></i> Projelerim ve Kat Planları
                        </a>
                        <a href="/Dashboard/SiteYonetimi" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "SiteYonetimi" ? "active" : "")">
                            <i class="bi bi-layout-text-window me-2"></i> Web Sitesi Tasarımı (CMS)
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
