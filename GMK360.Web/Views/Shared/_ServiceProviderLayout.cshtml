@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- USTA & HİZMET ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white fw-bold">
                    <i class="bi bi-tools me-2"></i> Usta & Hizmet Paneli
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/ServiceProvider" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "ServiceProvider" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Hizmet Özeti
                    </a>
                    
                    <a href="/Dashboard/UstaProfilim" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "UstaProfilim" ? "active" : "")">
                        <i class="bi bi-person-badge me-2"></i> Hizmet Profilim
                    </a>

                    <a href="/Dashboard/PaketYonetimi" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "PaketYonetimi" ? "active" : "")">
                        <i class="bi bi-box-seam me-2"></i> Paket & Görünürlük
                    </a>
                    
                    <a href="/Dashboard/UstaReferans" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "UstaReferans" ? "active" : "")">
                        <i class="bi bi-link-45deg me-2"></i> Referanslar ve Ağım
                    </a>

                    <a href="/Dashboard/Cuzdanim?context=service" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cuzdanim" ? "active" : "")">
                        <i class="bi bi-wallet2 me-2"></i> Dijital Cüzdanım
                    </a>

                    <!-- HİZMET CRM & TALEPLER -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        İŞ TALEPLERİ (AİDİYETLİ)
                    </div>
                    <a href="/Crm/Talepler?context=service" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-left-text me-2"></i> Gelen İş Talepleri
                    </a>
                    <a href="/Crm/Teklifler?context=service" class="list-group-item list-group-item-action">
                        <i class="bi bi-file-earmark-check me-2"></i> Verdiğim Teklifler
                    </a>
                    <a href="/Crm/Ajanda?context=service" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-event me-2"></i> Keşif ve İş Ajandası
                    </a>
                    
                    <!-- FİNANS -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        FİNANS & FATURA
                    </div>
                    <a href="/Dashboard/FinansCari?context=service" class="list-group-item list-group-item-action">
                        <i class="bi bi-calculator me-2"></i> Cari Hesap Özeti
                    </a>
                    <a href="/Dashboard/FaturaBilgilerim?context=service" class="list-group-item list-group-item-action">
                        <i class="bi bi-receipt me-2"></i> Fatura Bilgilerim
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
