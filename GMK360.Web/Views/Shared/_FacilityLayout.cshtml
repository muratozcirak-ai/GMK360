@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- BİNA & SİTE YÖNETİMİ ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white fw-bold">
                    <i class="bi bi-building me-2"></i> Bina & Site Yönetimi
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/BuildingManager/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "BuildingManager" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Yönetim Özeti
                    </a>
                    
                    <a href="/BuildingManager/Sakinler" class="list-group-item list-group-item-action">
                        <i class="bi bi-people me-2"></i> Sakinler & Daireler
                    </a>

                    <a href="/BuildingManager/Aidatlar" class="list-group-item list-group-item-action">
                        <i class="bi bi-cash-stack me-2"></i> Aidat Takibi
                    </a>

                    <a href="/BuildingManager/Giderler" class="list-group-item list-group-item-action">
                        <i class="bi bi-graph-down-arrow me-2"></i> Gider ve Fatura Takibi
                    </a>

                    <!-- YÖNETİM CRM & ARŞİV -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        YÖNETİM ARŞİVİ (AİDİYETLİ)
                    </div>
                    <a href="/Crm/Talepler?context=facility" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-left-text me-2"></i> Sakin Talepleri / Şikayetler
                    </a>
                    <a href="/DocumentArchive/Index?context=facility" class="list-group-item list-group-item-action">
                        <i class="bi bi-folder-fill me-2"></i> Karar Defteri & Belgeler
                    </a>
                    <a href="/Crm/Ajanda?context=facility" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-event me-2"></i> Toplantı Takvimi
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
