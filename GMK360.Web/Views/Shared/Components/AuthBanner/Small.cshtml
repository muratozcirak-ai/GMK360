@model IEnumerable<GMK360.Core.Entities.Marketing.AuthScreenBanner>

@if (Model != null && Model.Any())
{
    var count = Model.Count();
    
    <div id="homeBannerCarousel" class="carousel slide h-100 w-100" data-bs-ride="carousel" data-bs-interval="3000" style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);">
        @if (count > 1)
        {
            <div class="carousel-indicators" style="bottom: 0.5rem; margin-bottom: 0;">
                @for (int i = 0; i < count; i++)
                {
                    <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                }
            </div>
        }

        <div class="carousel-inner h-100 w-100">
            @foreach (var banner in Model.Select((item, index) => new { Item = item, Index = index }))
            {
                <div class="carousel-item h-100 w-100 @(banner.Index == 0 ? "active" : "")" style="background: url('@banner.Item.ImageUrl') center/cover no-repeat; position: relative;">
                    <div class="auth-image-overlay" style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.6) 100%);"></div>
                    
                    <div class="d-flex flex-column justify-content-center h-100" style="position: relative; z-index: 2; padding: 2rem; color: white;">
                        <div class="mt-auto mb-auto text-center">
                            <i class="ph ph-sparkle text-warning" style="font-size: 2rem; margin-bottom: 0.5rem;"></i>
                            <h3 style="font-size: 1.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.5rem; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">@Html.Raw(banner.Item.Title.Replace("\n", " "))</h3>
                            <p style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 1.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-shadow: 0 1px 2px rgba(0,0,0,0.5);">@banner.Item.Subtitle</p>
                            
                            @if (!string.IsNullOrEmpty(banner.Item.ActionText) && !string.IsNullOrEmpty(banner.Item.ActionUrl))
                            {
                                <a href="@banner.Item.ActionUrl" class="btn btn-warning" style="border-radius: 8px; font-weight: 700; padding: 8px 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.2);">
                                    @banner.Item.ActionText <i class="ph ph-arrow-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        
        @if (count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev" style="width: 10%;">
                <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 1.5rem; height: 1.5rem;"></span>
                <span class="visually-hidden">Önceki</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next" style="width: 10%;">
                <span class="carousel-control-next-icon" aria-hidden="true" style="width: 1.5rem; height: 1.5rem;"></span>
                <span class="visually-hidden">Sonraki</span>
            </button>
        }
    </div>
}
