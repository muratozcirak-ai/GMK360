@model IEnumerable<GMK360.Core.Entities.Marketing.AuthScreenBanner>

@if (Model != null && Model.Any())
{
    var count = Model.Count();
    
    <div id="authBannerCarousel" class="carousel slide h-100 w-100" data-bs-ride="carousel">
        @if (count > 1)
        {
            <div class="carousel-indicators" style="bottom: 2rem;">
                @for (int i = 0; i < count; i++)
                {
                    <button type="button" data-bs-target="#authBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                }
            </div>
        }

        <div class="carousel-inner h-100 w-100">
            @foreach (var banner in Model.Select((item, index) => new { Item = item, Index = index }))
            {
                <div class="carousel-item h-100 w-100 @(banner.Index == 0 ? "active" : "")" style="background: url('@banner.Item.ImageUrl') center/cover no-repeat; position: absolute; inset: 0;">
                    <div class="auth-image-overlay" style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(15, 23, 42, 0.4) 100%);"></div>
                    
                    <div class="auth-brand-content d-flex flex-column justify-content-center h-100" style="position: relative; z-index: 2; padding: 3rem; color: white;">
                        <a href="/" class="auth-logo mb-auto" style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.5rem; font-weight: 800; color: white; text-decoration: none;">
                            <i class="ph ph-buildings" style="color: var(--primary); font-size: 2rem;"></i>
                            <span>GMK360</span>
                        </a>

                        <div class="mt-auto mb-auto">
                            <h1 class="auth-hero-title" style="font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1.5rem;">@Html.Raw(banner.Item.Title.Replace("\n", "<br/>"))</h1>
                            <p class="auth-hero-text" style="font-size: 1.1rem; opacity: 0.9; margin-bottom: 2rem; max-width: 500px;">@banner.Item.Subtitle</p>
                            
                            @if (!string.IsNullOrEmpty(banner.Item.ActionText) && !string.IsNullOrEmpty(banner.Item.ActionUrl))
                            {
                                <a href="@banner.Item.ActionUrl" class="btn btn-primary btn-lg" style="border-radius: 12px; font-weight: 600; padding: 12px 30px;">
                                    @banner.Item.ActionText
                                </a>
                            }
                        </div>

                        <div class="auth-stats mt-auto" style="display: flex; gap: 3rem; margin-top: auto;">
                            <div class="stat-item">
                                <span class="stat-number d-block" style="font-size: 1.8rem; font-weight: 800;">10K+</span>
                                <span class="stat-label" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8;">Aktif Ýlan</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number d-block" style="font-size: 1.8rem; font-weight: 800;">5K+</span>
                                <span class="stat-label" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8;">Mutlu Müþteri</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- Varsayýlan Sabit Tasarým (Veritabaný Boþsa) -->
    <div style="background: url('/images/auth_bg.jpg') center/cover no-repeat; position: absolute; inset: 0;">
        <div class="auth-image-overlay" style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(15, 23, 42, 0.4) 100%);"></div>
        <div class="auth-brand-content d-flex flex-column justify-content-center h-100" style="position: relative; z-index: 2; padding: 3rem; color: white;">
            <a href="/" class="auth-logo mb-auto" style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.5rem; font-weight: 800; color: white; text-decoration: none;">
                <i class="ph ph-buildings" style="color: var(--primary); font-size: 2rem;"></i>
                <span>GMK360</span>
            </a>
            <div class="mt-auto mb-auto">
                <h1 class="auth-hero-title" style="font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1.5rem;">Sektörün <br/> Zirvesine Çýkýn.</h1>
                <p class="auth-hero-text" style="font-size: 1.1rem; opacity: 0.9; margin-bottom: 2rem; max-width: 500px;">Yeni nesil emlak platformuna katýlarak ilanlarýnýzý milyonlara ulaþtýrýn.</p>
            </div>
        </div>
    </div>
}
