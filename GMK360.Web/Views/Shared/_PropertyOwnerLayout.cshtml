@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- BİREYSEL SATICI ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light text-primary fw-bold border-bottom">
                    <i class="bi bi-house-add me-2"></i> Bireysel Satıcı & Ev Sahibi
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/PropertyOwner" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "PropertyOwner" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> İlan Özeti
                    </a>
                    
                    <a href="/Dashboard/Portfoyum" class="list-group-item list-group-item-action">
                        <i class="bi bi-houses me-2"></i> Sahibinden İlanlarım
                    </a>

                    <a href="/Crm/Talepler?context=owner" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-left-text me-2"></i> Gelen Mesajlar / Teklifler
                    </a>

                    <a href="/Crm/Talepler?context=owner_service" class="list-group-item list-group-item-action">
                        <i class="bi bi-tools me-2"></i> Usta / Hizmet Taleplerim
                    </a>
                    
                    <a href="/Crm/KiralamaTakip?context=owner" class="list-group-item list-group-item-action">
                        <i class="bi bi-cash-stack me-2"></i> Kira Geliri Takibi
                    </a>

                    <a href="/DocumentArchive/Index?context=owner" class="list-group-item list-group-item-action">
                        <i class="bi bi-folder-fill me-2"></i> Kira Sözleşmeleri (Arşiv)
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
