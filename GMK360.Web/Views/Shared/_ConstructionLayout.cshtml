@using Microsoft.AspNetCore.Identity

@using GMK360.Core.Entities.Identity

@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager

@inject GMK360.Data.Contexts.ApplicationDbContext DbContext

@{

    var currentUser = await UserManager.GetUserAsync(User);

    var currentConsultant = currentUser != null ? await DbContext.AgencyConsultants.Include(c => c.Agency).FirstOrDefaultAsync(c => c.UserId == currentUser.Id && c.IsActive) : null;

    var currentAgency = currentConsultant?.Agency ?? (ViewBag.Agency as GMK360.Core.Entities.Agency);

    var currentCompanyName = currentAgency?.CompanyName ?? "Şantiye & İnşaat ERP";

    var hasLogo = !string.IsNullOrEmpty(currentAgency?.LogoUrl) && !currentAgency.LogoUrl.Contains("default-logo");

}

<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - İnşaat ERP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script src="https://unpkg.com/@@phosphor-icons/web"></script>

    <style>

        body { background-color: #f8f9fa; }

        .hover-orange:hover { color: #FF6B00 !important; }

        .text-orange { color: #FF6B00; }

        .bg-orange { background-color: #FF6B00; }

        .text-navy { color: #1e3a8a; }

        .bg-navy { background-color: #1e3a8a; }

        @@keyframes pulse {

            0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }

            70% { box-shadow: 0 0 0 6px rgba(220, 53, 69, 0); }

            100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }

        }

    </style>

    @await RenderSectionAsync("SEO", required: false)

</head>

<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- TOP BAR (FİRMA ÖZEL - KOMPAKT & LAPTOP DOSTU) -->
    <header class="fixed-top bg-white border-bottom shadow-xs" style="z-index: 1030;">
        <div class="container-fluid px-2 px-md-3 d-flex justify-content-between align-items-center py-1">
            
            <!-- SOL: LOGO VE FİRMA ADI -->
            <div class="d-flex align-items-center">
                <a asp-controller="ConstructionProject" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-1">
                    <i class="ph-fill ph-infinity text-orange" style="font-size: 1.4rem;"></i>
                    <span class="fs-6 fw-bold text-navy" style="letter-spacing:-0.5px;">GMK<span class="text-orange">360</span></span>
                </a>
                
                <span class="text-muted mx-2">|</span>
                @if (hasLogo)
                {
                    <img src="@currentAgency.LogoUrl" alt="@currentCompanyName" style="height: 24px; max-width: 110px; object-fit: contain;" class="me-1 rounded border p-0.5 bg-white" />
                }
                else
                {
                    <i class="bi bi-buildings fs-6 text-primary me-1"></i>
                }
                <span class="fw-bold text-uppercase text-dark text-truncate" style="font-size: 0.85rem; max-width: 320px;">@currentCompanyName</span>
            </div>
            
            <!-- SAĞ: PROFİL & BİLGİ MENÜSÜ -->
            <div class="d-flex gap-2 align-items-center">
                
                <!-- Acil Durum / Bildirim Zili -->
                <div class="dropdown me-1">
                    <button class="btn btn-light rounded-circle shadow-xs position-relative d-flex justify-content-center align-items-center p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 30px; height: 30px;" title="Acil Durumlar & Bildirimler">
                        <i class="bi bi-bell-fill text-secondary fs-6"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="animation: pulse 1.5s infinite;">
                            <span class="visually-hidden">Yeni Bildirimler</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0" style="border-radius: 12px; min-width: 320px;">
                        <li class="bg-danger text-white px-3 py-2 fw-bold rounded-top-3 d-flex justify-content-between align-items-center">
                            <span style="font-size: 0.82rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i> Acil Şantiye Bildirimleri</span>
                            <span class="badge bg-light text-danger rounded-pill" style="font-size: 0.70rem;">2 Yeni</span>
                        </li>
                        <li class="list-group list-group-flush">
                            <a href="#" class="list-group-item list-group-item-action p-2 border-bottom border-light" style="font-size: 0.78rem;">
                                <div class="d-flex w-100 justify-content-between mb-0.5">
                                    <h6 class="mb-0 fw-bold text-danger" style="font-size: 0.80rem;"><i class="bi bi-cone-striped me-1"></i> Beton Pompası Arızası</h6>
                                    <small class="text-muted" style="font-size: 0.68rem;">10 dk önce</small>
                                </div>
                                <p class="mb-0 small text-dark" style="font-size: 0.74rem;">Beyaz Konak şantiyesinde döküm durdu.</p>
                            </a>
                            <a href="#" class="list-group-item list-group-item-action p-2" style="font-size: 0.78rem;">
                                <div class="d-flex w-100 justify-content-between mb-0.5">
                                    <h6 class="mb-0 fw-bold text-warning" style="font-size: 0.80rem;"><i class="bi bi-box-seam me-1"></i> Demir Stoğu Kritik</h6>
                                    <small class="text-muted" style="font-size: 0.68rem;">1 saat önce</small>
                                </div>
                                <p class="mb-0 small text-dark" style="font-size: 0.74rem;">Merkez Depo'da 14'lük nervürlü demir seviyesi azaldı.</p>
                            </a>
                        </li>
                        <li class="bg-light px-3 py-1.5 text-center rounded-bottom-3 border-top">
                            <a href="#" class="text-decoration-none fw-bold small text-primary" style="font-size: 0.75rem;">Tüm Acil Durumları Gör</a>
                        </li>
                    </ul>
                </div>

                <!-- Hava Durumu (Bölge Seçimli) -->
                <div class="d-none d-md-flex align-items-center bg-light rounded-pill px-2 py-0.5 border shadow-xs">
                    <i class="bi bi-cloud-sun text-primary fs-6 me-1"></i>
                    <select class="form-select form-select-sm border-0 bg-transparent text-navy fw-bold py-0 ps-0 pe-3" style="box-shadow: none; width: auto; font-size: 0.78rem;" title="Şantiye Lokasyonu Seçin">
                        <option value="ist" selected>İstanbul, Ataşehir (22°C)</option>
                        <option value="ank">Ankara, Çankaya (18°C)</option>
                        <option value="izm">İzmir, Bornova (25°C)</option>
                    </select>
                </div>

                <!-- Giriş Saati ve Kullanıcı -->
                <div class="d-none d-lg-block text-end lh-sm border-end pe-2">
                    <div class="text-navy fw-bold" style="font-size: 0.78rem;"><i class="bi bi-person-check-fill text-success me-1"></i> @(User.Identity.IsAuthenticated ? User.Identity.Name : "Mimar Sinan")</div>
                    <div class="text-muted" style="font-size: 0.68rem;"><i class="bi bi-clock-history me-1"></i> Giriş: @DateTime.Now.ToString("HH:mm") | <span id="liveClock" class="fw-bold">@DateTime.Now.ToString("HH:mm:ss")</span></div>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-navy px-3 py-1 rounded-pill dropdown-toggle d-flex align-items-center gap-1 btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.78rem;">
                            <i class="ph-fill ph-user-circle fs-6"></i>
                            <span class="d-none d-md-inline">Hesabım</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 200px;">
                            <li class="px-3 py-2 border-bottom mb-1 bg-light rounded-top-3">
                                <div class="fw-bold text-dark" style="font-size: 0.82rem;"><i class="bi bi-buildings me-1 text-primary"></i> @currentCompanyName</div>
                                <small class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-person me-1"></i> @( (await UserManager.GetUserAsync(User))?.DisplayName ?? User.Identity.Name )</small>
                            </li>
                            <li><a class="dropdown-item" href="/Dashboard/Construction" style="font-size: 0.80rem;"><i class="ph ph-chart-line-up me-2 text-primary"></i>Şirket Özeti (Dashboard)</a></li>
                            <li><a class="dropdown-item" href="/CustomerDashboard" style="font-size: 0.80rem;"><i class="ph ph-squares-four me-2 text-secondary"></i>Çalışma Alanı (Hub)</a></li>
                            <li><a class="dropdown-item" href="/Profile" style="font-size: 0.80rem;"><i class="ph ph-user me-2 text-secondary"></i>Kişisel Profil & Güvenlik</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item text-danger" style="font-size: 0.80rem;"><i class="ph ph-sign-out me-2"></i>Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
            
        </div>
    </header>

    <!-- ANA İÇERİK (SİDEBAR + CONTENT) -->
    <main class="flex-grow-1" style="margin-top: 48px;">
@{
    bool hideSidebar = ViewData["HideSidebar"] as bool? ?? false;
}


﻿

<div class="container-fluid px-2 px-md-3 mt-2">

    <div class="row">

        @if (!hideSidebar)
        {
        <!-- İNŞAAT FİRMASI ÖZEL SOL MENÜ -->

        <div class="col-xl-2 col-lg-3 col-md-4 mb-4">

            <div class="card shadow-sm border-0 position-sticky" style="top: 54px; max-height: calc(100vh - 60px); overflow-y: auto;">

                <!-- 1. YENİ ANA MENÜ (AÇILIR OLMAYAN / DÜZ 10 BAŞLIK - TEK TIK) -->

                <div class="card-header text-white py-1.5 px-3 fw-bold d-flex justify-content-between align-items-center" style="background-color: #1e3a8a;">

                    <span class="d-flex align-items-center"><i class="bi bi-grid-fill text-warning me-2 fs-5"></i> Ana Menü</span>

                    <span class="badge bg-white text-primary fw-bold px-2 py-1 rounded-pill" style="font-size: 0.75rem;">Tek Tık</span>

                </div>

                <div class="list-group list-group-flush p-2 border-bottom">

                    @{

                        var curCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";

                        var curAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

                        bool isOzetActive = curCtrl == "Dashboard" && curAct == "Construction";

                        bool isToplantiActive = curCtrl == "Agenda" && (curAct == "Meetings" || curAct == "MeetingRoom" || curAct == "Create");

                        bool isProjelerActive = curCtrl == "ConstructionProject" && (curAct == "Index" || curAct == "Details");

                        bool isFinansActive = curCtrl == "Finance" || curCtrl == "SupplierCurrentAccount" || curCtrl == "SubcontractorContract" || curCtrl == "ConstructionProjectExpenses";

                        bool isHakSahipleriActive = curCtrl == "ConstructionProject" && curAct == "Stakeholders";

                        bool isEvrakActive = curCtrl == "DocumentArchive";

                        bool isGarajActive = curCtrl == "CompanyGarage";

                        bool isCrmActive = curCtrl == "ProjectCrm";

                        bool isStratejiActive = curCtrl == "FinancialStrategy";

                        bool isPersonelActive = curCtrl == "AgencyStaff" || curCtrl == "AgencyWorkers" || curCtrl == "AgencyPhonebook";

                        bool isDemirbasActive = curCtrl == "Inventory";

                    }

                    <a href="/Dashboard/Construction" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isOzetActive ? "active shadow-sm" : "text-dark")" style="@(isOzetActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-speedometer2 @(isOzetActive ? "text-white" : "text-primary") fs-6 me-2"></i>

                        <span class="@(isOzetActive ? "fw-bold" : "fw-semibold")">Şirket Özeti</span>

                    </a>

                    <a href="/Agenda/Meetings" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-3 d-flex align-items-center @(isToplantiActive ? "active shadow-sm" : "text-dark")" style="@(isToplantiActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-people-fill @(isToplantiActive ? "text-white" : "text-warning") fs-6 me-2"></i>

                        <span class="@(isToplantiActive ? "fw-bold" : "fw-semibold")">Toplantı & Karar Masası</span>

                    </a>

                    <a href="/ConstructionProject/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-3 d-flex align-items-center @(isProjelerActive ? "active shadow-sm" : "text-dark")" style="@(isProjelerActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-buildings @(isProjelerActive ? "text-white" : "text-primary") fs-6 me-2"></i>

                        <span class="@(isProjelerActive ? "fw-bold" : "fw-semibold")">Şantiye & Projeler</span>

                    </a>

                    <a href="/Finance/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-3 d-flex align-items-center @(isFinansActive ? "active shadow-sm" : "text-dark")" style="@(isFinansActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-cash-coin @(isFinansActive ? "text-white" : "text-success") fs-6 me-2"></i>

                        <span class="@(isFinansActive ? "fw-bold" : "fw-semibold")">Finans & Cari</span>

                    </a>

                    <a href="/ConstructionProject/Stakeholders" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-3 d-flex align-items-center @(isHakSahipleriActive ? "active shadow-sm" : "text-dark")" style="@(isHakSahipleriActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-people-fill @(isHakSahipleriActive ? "text-white" : "text-success") fs-6 me-2"></i>

                        <span class="@(isHakSahipleriActive ? "fw-bold" : "fw-semibold")">Hak Sahipleri</span>

                    </a>

                    <a href="/DocumentArchive/Index?context=construction" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isEvrakActive ? "active shadow-sm" : "text-dark")" style="@(isEvrakActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-folder-fill @(isEvrakActive ? "text-white" : "text-warning") fs-6 me-2"></i>

                        <span class="@(isEvrakActive ? "fw-bold" : "fw-semibold")">Evrak & Dosya Arşivi</span>

                    </a>

                    <a href="/CompanyGarage/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isGarajActive ? "active shadow-sm" : "text-dark")" style="@(isGarajActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-truck @(isGarajActive ? "text-white" : "text-warning") fs-6 me-2"></i>

                        <span class="@(isGarajActive ? "fw-bold" : "fw-semibold")">Şirket Garajı & Araçlar</span>

                    </a>

                    <a href="/ProjectCrm/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isCrmActive ? "active shadow-sm" : "text-dark")" style="@(isCrmActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-telephone-inbound @(isCrmActive ? "text-white" : "text-warning") fs-6 me-2"></i>

                        <span class="@(isCrmActive ? "fw-bold" : "fw-semibold")">CRM & Operasyon</span>

                    </a>

                    <a href="/FinancialStrategy/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isStratejiActive ? "active shadow-sm" : "text-dark")" style="@(isStratejiActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-briefcase @(isStratejiActive ? "text-white" : "text-secondary") fs-6 me-2"></i>

                        <span class="@(isStratejiActive ? "fw-bold" : "fw-semibold")">Kurumsal & Strateji</span>

                    </a>

                    <a href="/AgencyStaff/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isPersonelActive ? "active shadow-sm" : "text-dark")" style="@(isPersonelActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-people @(isPersonelActive ? "text-white" : "text-info") fs-6 me-2"></i>

                        <span class="@(isPersonelActive ? "fw-bold" : "fw-semibold")">Personel & Ekipler</span>

                    </a>

                    <a href="/Inventory/Index" class="list-group-item list-group-item-action border-0 py-2 px-3 rounded-2 d-flex align-items-center @(isDemirbasActive ? "active shadow-sm" : "text-dark")" style="@(isDemirbasActive ? "background-color: #0d6efd; color: white;" : "")">

                        <i class="bi bi-tools @(isDemirbasActive ? "text-white" : "text-secondary") fs-6 me-2"></i>

                        <span class="@(isDemirbasActive ? "fw-bold" : "fw-semibold")">Demirbaş Yönetimi</span>

                    </a>

                </div>

                <!-- 2. MEVCUT ÇALIŞAN TÜM ESKİ MENÜ (HİÇBİR LİNK SİLİNMEDEN AYNEN KORUNUYOR) -->

                <div class="card-header bg-light text-muted fw-bold py-2 px-3 border-bottom d-flex justify-content-between align-items-center" style="font-size: 0.8rem;">

                    <span><i class="bi bi-archive me-1"></i> MEVCUT ÇALIŞAN LİNKLER</span>

                    <span class="badge bg-secondary text-white" style="font-size: 0.7rem;">Havuz</span>

                </div>

                <div class="card-body p-0">

                    <div class="accordion accordion-flush" id="sidebarAccordion">

                        <!-- 1. ŞANTİYE & PROJELER -->

                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button class="accordion-button py-3 fw-bold bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#colProjeler" aria-expanded="true">

                                    <i class="bi bi-buildings text-primary me-2"></i> ŞANTİYE & PROJELER

                                </button>

                            </h2>

                            <div id="colProjeler" class="accordion-collapse collapse show" data-bs-parent="#sidebarAccordion">

                                <div class="list-group list-group-flush" style="font-size: 0.9rem;">

                                    <a href="/DailyTimesheets/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-primary"></i> Şantiye Puantaj</a>

                                    <a href="/Inventory/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-primary"></i> Merkez Depo (Demirbaş)</a>

                                    <a href="/CompanyGarage/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-primary"></i> Şirket Garajı & Araçlar</a>

                                    <a href="/ConstructionPhases/Active" class="list-group-item list-group-item-action border-0 ps-5 fw-bold"><i class="bi bi-arrow-right-short text-primary"></i> Aktif Fazlar (İş Akışı)</a>

                                </div>

                            </div>

                        </div>

                        <!-- YIKIM, HAFRİYAT & HURDA KOKPİTİ -->

                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button class="accordion-button collapsed py-3 fw-bold bg-light text-danger" type="button" data-bs-toggle="collapse" data-bs-target="#colYikim">

                                    <i class="bi bi-hammer text-danger me-2"></i> YIKIM & HAFRİYAT

                                </button>

                            </h2>

                            <div id="colYikim" class="accordion-collapse collapse" data-bs-parent="#sidebarAccordion">

                                <div class="list-group list-group-flush" style="font-size: 0.9rem;">

                                    <a href="/DemolitionSalvage/Index" class="list-group-item list-group-item-action border-0 ps-5 fw-bold text-danger"><i class="bi bi-recycle text-danger"></i> Söküm & Hurda Envanteri</a>

                                    <a href="/CompanyGarage/AllTasks" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-truck text-danger"></i> Kamyon & Döküm Seferleri</a>

                                    <a href="/CompanyGarage/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-gear-wide-connected text-danger"></i> Makine Parkı & Ekskavatör</a>

                                    <a href="/SubcontractorContract/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-file-earmark-ruled text-danger"></i> Yıkım & Hurda Sözleşmeleri</a>

                                </div>

                            </div>

                        </div>

                        <!-- 2. PERSONEL & EKİPLER -->

                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button class="accordion-button collapsed py-3 fw-bold bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#colPersonel">

                                    <i class="bi bi-people text-info me-2"></i> PERSONEL & EKİPLER

                                </button>

                            </h2>

                            <div id="colPersonel" class="accordion-collapse collapse" data-bs-parent="#sidebarAccordion">

                                <div class="list-group list-group-flush" style="font-size: 0.9rem;">

                                    <a href="/AgencyStaff/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-info"></i> Beyaz Yaka (Merkez)</a>

                                    <a href="/AgencyWorkers/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-info"></i> Mavi Yaka (Şantiye)</a>

                                    <a href="/AgencyPhonebook/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-info"></i> Firma & Usta Rehberi</a>

                                </div>

                            </div>

                        </div>

                        <!-- 4. CRM & OPERASYON -->

                        <div class="accordion-item border-0 border-bottom">

                            <h2 class="accordion-header">

                                <button class="accordion-button collapsed py-3 fw-bold bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#colCrm">

                                    <i class="bi bi-telephone-inbound text-warning me-2"></i> CRM & OPERASYON

                                </button>

                            </h2>

                            <div id="colCrm" class="accordion-collapse collapse" data-bs-parent="#sidebarAccordion">

                                <div class="list-group list-group-flush" style="font-size: 0.9rem;">

                                    <a href="/ProjectCrm/SalesPool" class="list-group-item list-group-item-action border-0 ps-5 fw-bold text-dark bg-warning bg-opacity-10"><i class="bi bi-building-check text-warning"></i> Satış & Kiralama Havuzu</a>

                                    <a href="/ProjectCrm/Index" class="list-group-item list-group-item-action border-0 ps-5"><i class="bi bi-arrow-right-short text-warning"></i> Potansiyel Alıcı & CRM</a>

                                    <a href="/Agenda/Index" class="list-group-item list-group-item-action border-0 ps-5 fw-bold"><i class="bi bi-journal-bookmark-fill text-warning"></i> Şantiye Ajandası (Kara Defter)</a>

                                </div>

                            </div>

                        </div>

