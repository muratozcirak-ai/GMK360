@{
    Layout = "_Layout";
}

<div class="container-fluid px-4 px-xl-5 mt-4">
    <div class="row">
        <!-- İNŞAAT FİRMASI ÖZEL SOL MENÜ -->
        <div class="col-xl-2 col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-cone-striped me-2"></i> Şantiye & İnşaat ERP
                </div>
                <div class="list-group list-group-flush" style="font-size: 0.9rem;">
                    
                    <div class="list-group-item bg-light fw-bold mt-2 text-uppercase" style="font-size: 0.8rem; color: #6c757d;">
                        YÖNETİM & MERKEZ
                    </div>
                    <a href="/Dashboard/Construction" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Construction" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Şirket Özeti
                    </a>
                    <a href="/AgencyStaff/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AgencyStaff" ? "active" : "")">
                        <i class="bi bi-person-badge me-2"></i> Şirket Kullanıcıları (Beyaz Yaka)
                    </a>
                    <a href="/AgencyPhonebook/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AgencyPhonebook" ? "active" : "")">
                        <i class="bi bi-journal-bookmark-fill me-2"></i> Firma & Usta Rehberi
                    </a>
                    <a href="/Agenda/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Agenda" ? "active" : "")">
                        <i class="bi bi-calendar-event me-2"></i> Merkez Toplantıları
                    </a>
                    <a href="/B2BPurchasing/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "B2BPurchasing" ? "active" : "")">
                        <i class="bi bi-cart3 me-2"></i> Satın Alma (B2B)
                    </a>
                    <a href="/Inventory/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" ? "active" : "")">
                        <i class="bi bi-box-seam me-2"></i> Tüm Depolar & Envanter
                    </a>

                    <div class="list-group-item bg-light fw-bold mt-2 text-uppercase" style="font-size: 0.8rem; color: #6c757d;">
                        ŞANTİYE & PROJELER
                    </div>
                    <a href="/ConstructionProject/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ConstructionProject" ? "active" : "")">
                        <i class="bi bi-buildings me-2"></i> Şantiyelerimiz (Projeler)
                    </a>
                    <a href="/DocumentArchive/Index?context=construction" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DocumentArchive" ? "active" : "")">
                        <i class="bi bi-folder-fill me-2"></i> Şantiye Belge Arşivi
                    </a>

                    <div class="list-group-item bg-light fw-bold mt-2 text-uppercase" style="font-size: 0.8rem; color: #6c757d;">
                        PUANTAJ & MESAİ
                    </div>
                    <a href="/DailyTimesheets/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DailyTimesheets" ? "active" : "")">
                        <i class="bi bi-clock-history me-2"></i> Tüm Şantiyeler Puantaj Özeti
                    </a>

                    <div class="list-group-item bg-light fw-bold mt-2 text-uppercase" style="font-size: 0.8rem; color: #6c757d;">
                        FİNANS & CARİ HESAPLAR
                    </div>
                    <a href="/SubcontractorContract/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SubcontractorContract" ? "active" : "")">
                        <i class="bi bi-file-earmark-text me-2"></i> Taşeron Sözleşmeleri (Hakediş)
                    </a>
                    <a href="/SupplierCurrentAccounts/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SupplierCurrentAccounts" ? "active" : "")">
                        <i class="bi bi-wallet2 me-2"></i> Tedarikçi Cari Hesapları
                    </a>
                    <a href="/Finance/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Finance" ? "active" : "")">
                        <i class="bi bi-cash-coin me-2"></i> Ödemeler & Tahsilatlar (Kasa/Banka)
                    </a>
                    <a href="/Dashboard/FinansCari" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "FinansCari" ? "active" : "")">
                        <i class="bi bi-graph-up me-2"></i> Şantiye Maliyeti (Cari Özet)
                    </a>
                    <a href="/Dashboard/Faturalarim" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Faturalarim" ? "active" : "")">
                        <i class="bi bi-receipt me-2"></i> E-Faturalar
                    </a>

                    <div class="list-group-item bg-light fw-bold mt-2 text-uppercase" style="font-size: 0.8rem; color: #6c757d;">
                        KURUMSAL VİTRİN
                    </div>
                    <a href="/Dashboard/SiteYonetimi" class="list-group-item list-group-item-action">
                        <i class="bi bi-layout-text-window me-2"></i> Kurumsal Web Sitem (CMS)
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-xl-10 col-lg-9 col-md-8">
            @RenderBody()
        </div>
    </div>
</div>



@section Scripts {
    @RenderSection("Scripts", required: false)
}
