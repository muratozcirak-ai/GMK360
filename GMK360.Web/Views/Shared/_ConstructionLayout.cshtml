@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- İNŞAAT FİRMASI ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-cone-striped me-2"></i> Şantiye & İnşaat ERP
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/Construction" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Construction" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Şantiye Özeti
                    </a>
                    
                    <a href="/ConstructionProject/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ConstructionProject" ? "active" : "")">
                        <i class="bi bi-buildings me-2"></i> Projelerim ve Bloklar
                    </a>
                    
                    <!-- FİNANS VE MUHASEBE -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        FİNANS & TAŞERON
                    </div>
                    <a href="/Dashboard/FinansCari" class="list-group-item list-group-item-action">
                        <i class="bi bi-calculator me-2"></i> Şantiye Maliyeti (Cari)
                    </a>
                    <a href="/Dashboard/Faturalarim" class="list-group-item list-group-item-action">
                        <i class="bi bi-receipt me-2"></i> E-Faturalar
                    </a>

                    <!-- ORTAK MODÜLLER (Aidiyetli) -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        ŞANTİYE CRM & ARŞİV
                    </div>
                    <a href="/Crm/Ajanda?context=construction" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-event me-2"></i> Toplantılar (Müşteri/Taşeron)
                    </a>
                    <a href="/DocumentArchive/Index?context=construction" class="list-group-item list-group-item-action">
                        <i class="bi bi-folder-fill me-2"></i> Şantiye Belge Arşivi
                    </a>

                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        KURUMSAL VİTRİN
                    </div>
                    <a href="/Dashboard/SiteYonetimi" class="list-group-item list-group-item-action">
                        <i class="bi bi-layout-text-window me-2"></i> Kurumsal Web Sitem (CMS)
                    </a>
                    
                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
