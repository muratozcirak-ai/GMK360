@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- EMLAK OFİSİ ÖZEL SOL MENÜ -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="bi bi-briefcase me-2"></i> Kurumsal Emlak Ofisi
                </div>
                <div class="list-group list-group-flush">
                    
                    <a href="/Dashboard/Corporate" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Corporate" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Emlak Özeti
                    </a>
                    
                    <a href="/Dashboard/Portfoyum" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Portfoyum" ? "active" : "")">
                        <i class="bi bi-houses me-2"></i> İlanlarım & Portföyüm
                    </a>

                    <a href="/Dashboard/Ekibim" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Ekibim" ? "active" : "")">
                        <i class="bi bi-people me-2"></i> Danışman Yönetimi
                    </a>

                    <a href="/Dashboard/Cuzdanim" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cuzdanim" ? "active" : "")">
                        <i class="bi bi-wallet2 me-2"></i> Dijital Cüzdanım
                    </a>

                    <!-- MÜŞTERİ YÖNETİMİ & CRM -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        EMLAK CRM (AİDİYETLİ)
                    </div>
                    <a href="/Crm/Rehber?context=realestate" class="list-group-item list-group-item-action">
                        <i class="bi bi-journal-richtext me-2"></i> Müşteri Rehberi
                    </a>
                    <a href="/Crm/Ajanda?context=realestate" class="list-group-item list-group-item-action">
                        <i class="bi bi-calendar-event me-2"></i> Randevu & Yer Gösterme
                    </a>
                    <a href="/Crm/Talepler?context=realestate" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-left-text me-2"></i> Alıcı Talepleri
                    </a>
                    <a href="/DocumentArchive/Index?context=realestate" class="list-group-item list-group-item-action">
                        <i class="bi bi-folder-fill me-2"></i> Yetki & Sözleşme Arşivi
                    </a>
                    
                    <!-- FİNANS VE MUHASEBE -->
                    <div class="list-group-item bg-light fw-bold mt-2" style="font-size: 0.85rem; color: #6c757d;">
                        FİNANS & FATURA
                    </div>
                    <a href="/Commission/Index" class="list-group-item list-group-item-action">
                        <i class="bi bi-cash-coin me-2"></i> Komisyon Ödemeleri
                    </a>
                    <a href="/Dashboard/Faturalarim" class="list-group-item list-group-item-action">
                        <i class="bi bi-receipt me-2"></i> E-Faturalar
                    </a>

                    <a href="/Dashboard/Hub" class="list-group-item list-group-item-action bg-dark text-white mt-3 text-center rounded-bottom">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i> Tüm Uygulamalar (Hub)
                    </a>
                </div>
            </div>
        </div>

        <!-- Ana İçerik -->
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@RenderSection("Scripts", required: false)
