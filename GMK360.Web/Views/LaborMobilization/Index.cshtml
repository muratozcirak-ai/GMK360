@{
    ViewData["Title"] = "Taþeron Ýhale ve Ýþ Gücü Karar Masasý";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">
                <i class="fas fa-gavel text-primary me-2"></i> Taþeron Ýhale ve Ýþ Gücü Masasý
            </h3>
            <p class="text-muted mb-0">Proje metrajlarýna göre taþeronlardan fiyat toplayýn ve þantiye kampýný planlayýn.</p>
        </div>
        <button class="btn btn-success"><i class="fas fa-save me-1"></i> Ýhale Kararýný Kaydet</button>
    </div>

    <!-- 1. ÝHALE PAKETÝ VE METRAJ GÖNDERÝMÝ -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white pt-3 pb-2">
            <h6 class="fw-bold"><i class="fas fa-clipboard-list me-2"></i> 1. Ýhale Paketi ve Ýþin Hacmi (Metraj)</h6>
        </div>
        <div class="card-body bg-light">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Ýþ Kategorisi (Branþ)</label>
                    <select class="form-select form-select-sm border-primary">
                        @foreach(var cat in ViewBag.Categories)
                        {
                            <option>@cat</option>
                        }
                        </select>
                </div>
                <div class="col-md-9">
                    <label class="form-label small fw-bold text-muted">Ustalara Gönderilecek Proje Verileri (Metraj)</label>
                    <div class="d-flex gap-3">
                        <div class="input-group input-group-sm w-25">
                            <span class="input-group-text bg-white"><i class="fas fa-building text-secondary"></i></span>
                            <input type="text" class="form-control" value="12" readonly title="Kat Sayýsý">
                            <span class="input-group-text bg-white">Kat</span>
                        </div>
                        <div class="input-group input-group-sm w-25">
                            <span class="input-group-text bg-white"><i class="fas fa-vector-square text-secondary"></i></span>
                            <input type="text" class="form-control" value="5.400" placeholder="M2 Alan">
                            <span class="input-group-text bg-white">m²</span>
                        </div>
                        <div class="input-group input-group-sm w-25">
                            <span class="input-group-text bg-white"><i class="fas fa-weight-hanging text-secondary"></i></span>
                            <input type="text" class="form-control" value="320" placeholder="Tonaj">
                            <span class="input-group-text bg-white">Ton</span>
                        </div>
                        <div class="align-self-center small text-success fw-bold">
                            <i class="fas fa-magic"></i> Ýleride DXF'ten otomatik dolacak
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-3 text-end">
                <button class="btn btn-sm btn-outline-primary"><i class="fas fa-paper-plane me-1"></i> Havuzdaki Ustalara Fiyat Sor</button>
            </div>
        </div>
    </div>

    <!-- 2. TEKLÝF KIYASLAMA MASASI -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white pt-3 pb-2">
            <h6 class="fw-bold"><i class="fas fa-balance-scale me-2"></i> 2. Gelen Teklifler ve Kýyaslama (Yap/Yaptýr)</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Taþeron / Ekip Adý</th>
                        <th>Tür</th>
                        <th>Puan</th>
                        <th>Verilen Fiyat (Anahtar Teslim / Yevmiye)</th>
                        <th>Lojistik Yükü (Kiþi)</th>
                        <th>Gerçek Maliyet Tahmini</th>
                        <th class="text-end">Karar</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Teklif 1 -->
                    <tr>
                        <td>
                            <div class="fw-bold">Kurumsal Yapý A.Þ.</div>
                            <div class="text-muted small">Dýþarýdan Taþeron</div>
                        </td>
                        <td><span class="badge bg-secondary">Götürü</span></td>
                        <td><i class="fas fa-star text-warning"></i> 4.8</td>
                        <td class="fw-bold text-dark">1.250.000 TL <span class="text-muted small fw-normal">(Her þey dahil)</span></td>
                        <td><span class="text-success small">0 Kiþi (Kendi kamplarý var)</span></td>
                        <td class="fw-bold">1.250.000 TL</td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-secondary">Seç</button></td>
                    </tr>
                    <!-- Teklif 2 (Seçilen) -->
                    <tr class="table-primary border-primary border-2">
                        <td>
                            <div class="fw-bold text-primary"><i class="fas fa-check-circle me-1"></i> Ali Usta ve Ekibi</div>
                            <div class="text-muted small">Sistem Havuzundan</div>
                        </td>
                        <td><span class="badge bg-info text-dark">Yevmiye</span></td>
                        <td><i class="fas fa-star text-warning"></i> 4.9</td>
                        <td>
                            1 Usta (3.000 TL) + 5 Ýþçi (1.500 TL) 
                            <div class="small text-muted">Tahmini 60 Gün = 630.000 TL (Çýplak)</div>
                        </td>
                        <td><span class="text-danger fw-bold small">+6 Kiþi (Kampa katýlacak)</span></td>
                        <td>
                            <div class="fw-bold text-danger">~ 945.000 TL</div>
                            <div class="small text-muted">(SGK + Kamp Amortismaný Dahil)</div>
                        </td>
                        <td class="text-end"><button class="btn btn-sm btn-primary">Seçildi</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. MOBÝLÝZASYON VE KAMP ZEKASI (Seçimden Sonra Açýlýr) -->
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-danger mb-3"><i class="fas fa-campground me-2"></i> Þantiye Kampý Analizi (Ali Usta Ekibi)</h6>
                    <p class="small text-muted">Ali Usta ekibi için kampa <strong>6 yeni personel</strong> giriþi yapýlacaktýr. Anlýk kapasite durumu:</p>
                    
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="fas fa-bed text-secondary me-2"></i> Yatak & Ranza</span>
                            <span class="badge bg-danger rounded-pill">4 Yatak Eksik!</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="fas fa-utensils text-secondary me-2"></i> Mutfak / Ýaþe</span>
                            <span class="badge bg-success rounded-pill">Kapasite Yeterli</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="fas fa-wifi text-secondary me-2"></i> Sosyal Yaþam (TV/Ýnternet)</span>
                            <span class="badge bg-warning text-dark rounded-pill">Limit Sýnýrýnda</span>
                        </li>
                    </ul>
                    <button class="btn btn-sm btn-outline-danger w-100 mt-3"><i class="fas fa-bolt me-1"></i> Lojistik & Satýnalma Görevlerini Fýrlat (T-2)</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-info mb-3"><i class="fas fa-file-signature me-2"></i> SGK ve ÝK Hazýrlýðý</h6>
                    <p class="small text-muted">Ali Usta ve 5 kiþilik ekibi þantiyeye giriþ yapmadan önce tamamlanmasý gereken yasal evraklar:</p>
                    
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item px-0"><i class="far fa-square text-secondary me-2"></i> Nüfus cüzdaný fotokopileri ve sabýka kayýtlarý toplandý mý?</li>
                        <li class="list-group-item px-0"><i class="far fa-square text-secondary me-2"></i> Ýþ Saðlýðý ve Güvenliði (ÝSG) eðitimleri verildi mi?</li>
                        <li class="list-group-item px-0"><i class="far fa-square text-secondary me-2"></i> SGK Ýþe Giriþ Bildirgeleri onaylandý mý?</li>
                    </ul>
                    <button class="btn btn-sm btn-outline-info w-100 mt-3"><i class="fas fa-users-cog me-1"></i> ÝK Departmanýna Görev Aç (T-3)</button>
                </div>
            </div>
        </div>
    </div>

</div>


