@model GMK360.Web.Models.Finance.UnifiedFinanceDashboardViewModel
@{
    ViewData["Title"] = "Patron Ekranı: Personel Maaş & Avans";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 text-danger"><i class="bi bi-wallet2"></i> Personel Maaş, Hakediş ve Gider Tablosu</h3>
        <span class="badge bg-dark fs-6">Dönem: @DateTime.Today.ToString("MMMM yyyy")</span>
    </div>

    <div class="alert alert-warning shadow-sm border-warning border-start border-4">
        <i class="bi bi-info-circle-fill me-2"></i> Bu ekran <b>yalnızca Firma Sahibi ve Finans Yetkilisi</b> tarafından görüntülenebilir. Maaş bilgileri gizlidir.
    </div>

    <!-- ÖZET KARTLARI -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-white shadow-sm border-0 border-bottom border-primary border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">Merkez (Beyaz Yaka) Net</h6>
                    <h3 class="mb-0 text-dark">@Model.TotalWhiteCollarNet.ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-white shadow-sm border-0 border-bottom border-info border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">Şantiye (Mavi Yaka) Hakediş</h6>
                    <h3 class="mb-0 text-dark">@Model.TotalBlueCollarWage.ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-white shadow-sm border-0 border-bottom border-warning border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2">Belge Bekleyen Saha Gideri (Elden)</h6>
                    <h3 class="mb-0 text-danger">@Model.TotalFieldExpenses.ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase fw-semibold mb-2">Patrona Toplam Maliyet (+SGK)</h6>
                    <h3 class="mb-0 text-white">@Model.TotalEmployerCost.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- BEYAZ YAKA -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light border-0">
                    <h5 class="mb-0"><i class="bi bi-building"></i> Merkez Personel (Beyaz Yaka)</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Görev</th>
                                <th>Net Maaş</th>
                                <th>SGK Maliyeti</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.WhiteCollars)
                            {
                                <tr>
                                    <td>@item.FullName</td>
                                    <td><span class="badge bg-secondary">@item.RoleName</span></td>
                                    <td class="fw-bold">@item.NetSalary.ToString("C2")</td>
                                    <td class="text-muted">@item.SgkCost.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MAVİ YAKA -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light border-0">
                    <h5 class="mb-0"><i class="bi bi-cone-striped"></i> Şantiye Personeli (Mavi Yaka)</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Çalışılan Gün</th>
                                <th>Bordro Hakediş</th>
                                <th>Elden Verilecek (Mesai)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BlueCollars)
                            {
                                <tr>
                                    <td>@item.FullName <br/><small class="text-muted">@item.Profession</small></td>
                                    <td>@item.DaysWorked Gün</td>
                                    <td class="fw-bold">@item.EarnedWages.ToString("C2")</td>
                                    <td class="text-danger fw-bold">@item.TotalPendingFieldExpenses.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- AVANS TALEPLERİ -->
    <div class="card shadow-sm border-0 mt-4 border-start border-primary border-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-hourglass-split"></i> Bekleyen Avans Talepleri</h5>
        </div>
        <div class="card-body p-0">
            @if(!Model.PendingAdvances.Any())
            {
                <div class="p-4 text-center text-muted">Bekleyen avans talebi bulunmuyor.</div>
            }
            else
            {
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Personel</th>
                            <th>Tarih</th>
                            <th>Açıklama</th>
                            <th>Tutar</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var advance in Model.PendingAdvances)
                        {
                            <tr>
                                <td>@advance.Worker?.FullName</td>
                                <td>@advance.RequestDate.ToShortDateString()</td>
                                <td>@advance.Description</td>
                                <td class="fw-bold text-danger">@advance.Amount.ToString("C2")</td>
                                <td>
                                    <form asp-action="ApproveAdvance" method="post">
                                        <input type="hidden" name="id" value="@advance.Id" />
                                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Öde (Kasa Çıkışı Yap)</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>