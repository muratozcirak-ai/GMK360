@{
    ViewData["Title"] = "Yönetim Kurulu & Yetkiler";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var selected = ViewBag.SelectedBuilding as GMK360.Core.Entities.Building;
    var complex = ViewBag.Complex as GMK360.Core.Entities.HousingComplex;
    var siteBlocks = ViewBag.SiteBlocks as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var managers = ViewBag.Managers as List<GMK360.Core.Entities.BuildingManager> ?? new List<GMK360.Core.Entities.BuildingManager>();
    var siteOwnerUnits = ViewBag.SiteOwnerUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var boardPlan = ViewBag.BoardPlan as GMK360.Web.Helpers.KmkBoardPlan ?? new GMK360.Web.Helpers.KmkBoardPlan();
    var recentDecisions = ViewBag.RecentGovernanceDecisions as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
    var decisionScans = ViewBag.DecisionScansByMeeting as Dictionary<int, GMK360.Core.Entities.DocumentArchive> ?? new Dictionary<int, GMK360.Core.Entities.DocumentArchive>();
    var circularDocs = ViewBag.CircularDocs as List<GMK360.Core.Entities.DocumentArchive> ?? new List<GMK360.Core.Entities.DocumentArchive>();
    bool canEdit = ViewBag.CanEditGovernance is bool ce ? ce : true;

    var activeManagers = managers.Where(m => m.IsActive).OrderBy(m => GMK360.Core.Entities.BuildingManager.GetHierarchyLevel(m.Role)).ThenBy(m => m.HierarchyOrder).ToList();
    var archivedManagers = managers.Where(m => !m.IsActive || m.IsTermExpired()).ToList();
    var expiringSoonOrExpired = activeManagers.Where(m => m.TermEndDate.HasValue && m.TermEndDate.Value.Date <= DateTime.Today.AddDays(30)).OrderBy(m => m.TermEndDate).ToList();
    var activeReserves = activeManagers.Where(m => m.Role == GMK360.Core.Entities.BuildingManagerRole.ReserveMember && !m.IsTermExpired()).OrderBy(m => m.HierarchyOrder).ToList();
    var firstReserve = activeReserves.FirstOrDefault();

    string displayFacilityName = complex != null ? complex.Name : (selected?.Name ?? "Site / Bina");
    string currentSubdomain = complex?.Subdomain ?? selected?.Subdomain ?? "";
    var decById = recentDecisions.ToDictionary(d => d.Id, d => d);
    string latestCircularUrl = circularDocs.FirstOrDefault()?.DocumentUrl ?? selected?.SignatureCircularUrl ?? "";
}

<style>
    .board-step-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        transition: box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .board-step-card:hover {
        border-color: #94a3b8;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    }
    .board-step-waiting {
        border: 1.5px dashed #94a3b8;
        background: #f8fafc;
    }
    .board-step-header {
        cursor: pointer;
    }
</style>

<div class="container-fluid py-3 px-1" style="max-width: 1120px;">
    <!-- ÜST BAŞLIK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-award-fill text-warning me-2"></i>Yönetim Kurulu &amp; Yetkiler</h2>
            <p class="text-muted small mb-0">Adım adım sıralı yönetim kadrosu: her koltuğa tıklayarak bilgilerini girin, T.C. No ile erişim tanımlayın veya yetkiyi devredin.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (buildings.Count > 1)
            {
                <form method="get" asp-action="Governance" class="d-flex align-items-center gap-2">
                    <select name="buildingId" class="form-select form-select-sm rounded-pill px-3" onchange="this.form.submit()">
                        @foreach (var b in buildings)
                        {
                            <option value="@b.Id" selected="@(selected?.Id == b.Id ? "selected" : null)">@b.Name</option>
                        }
                    </select>
                </form>
            }
            @if (selected != null)
            {
                <a href="/BuildingManager/Oylamalar?buildingId=@selected.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
                    <i class="bi bi-journal-check me-1"></i> Karar Defteri
                </a>
                <a href="/BuildingManager/Toplantilar?buildingId=@selected.Id" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Genel Kurul Çağrısı
                </a>
            }
        </div>
    </div>

    @if (!canEdit)
    {
        <div class="alert alert-info rounded-4 shadow-sm border-0 mb-3 small">
            <i class="bi bi-eye-fill me-2"></i><strong>Salt Okunur Denetçi Görünümü:</strong> Denetçi yetkisiyle yalnızca kurul yapısını, TCKN / erişim durumunu ve kararları inceleyebilirsiniz; değişiklik yapamazsınız.
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["LastActivationUrl"] != null)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-success-subtle mb-3 p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small text-dark">
                    <i class="bi bi-link-45deg me-1"></i><strong>@TempData["LastActivationLabel"]</strong> Profil Aktivasyon Bağlantısı:
                    <code class="ms-1 user-select-all">@TempData["LastActivationUrl"]</code>
                </div>
                <button type="button" class="btn btn-xs btn-success rounded-pill px-3 fw-bold"
                        onclick="navigator.clipboard.writeText('@TempData["LastActivationUrl"]'); this.innerText='Kopyalandı!';">
                    Bağlantıyı Kopyala
                </button>
            </div>
        </div>
    }

    @if (selected == null)
    {
        <div class="alert alert-info rounded-4">Yönetim kurulu tanımlamak için önce bina/site oluşturunuz.</div>
    }
    else
    {
        <!-- GÖREV SÜRESİ DOLUM / 30 GÜN UYARISI -->
        @if (expiringSoonOrExpired.Any())
        {
            var expiredList = expiringSoonOrExpired.Where(x => x.IsTermExpired()).ToList();
            <div class="alert @(expiredList.Any() ? "alert-danger border-danger" : "alert-warning border-warning") border-start border-4 rounded-4 shadow-sm mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                    <div>
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5 align-middle"></i>
                        @if (expiredList.Any())
                        {
                            <strong>Görev Süresi Doldu (Panel Erişimi &amp; İmza Kilitli):</strong>
                            <span>@expiredList.Count üyenin görev süresi doldu; yeni Genel Kurul kararı ile atama yapılana kadar sisteme girişleri ve oylama yetkileri kapalıdır.</span>
                        }
                        else
                        {
                            var soon = expiringSoonOrExpired.First();
                            int daysLeft = soon.TermEndDate.HasValue ? (int)Math.Ceiling((soon.TermEndDate.Value.Date - DateTime.Today).TotalDays) : 0;
                            <strong>Görev Süresi Hatırlatması (KMK 1 Yıl Kuralı):</strong>
                            <span>Yönetim Kurulu görev süreniz <strong>@daysLeft gün içinde</strong> (@soon.TermEndDate?.ToString("dd.MM.yyyy")) doluyor; Olağan Genel Kurul çağrısı planlanmalıdır.</span>
                        }
                    </div>
                    <a href="/BuildingManager/Toplantilar?buildingId=@selected.Id" class="btn btn-xs btn-dark rounded-pill px-3 fw-bold">Genel Kurul Aç</a>
                </div>
            </div>
        }

        <!-- ADIM 1: KMK KADRO ÖZETİ & SALT ÇOĞUNLUK HESABI -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="badge bg-primary text-white rounded-pill px-3">ADIM 1 • KMK KADRO ÖZETİ</span>
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-3">@boardPlan.TierRangeLabel</span>
                            <span class="badge bg-dark rounded-pill px-3">@boardPlan.LegalStatusLabel</span>
                            @if (boardPlan.UsesCustomPlanCounts)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border rounded-pill px-3">Yönetim Planı Özel Sayısı</span>
                            }
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@displayFacilityName — @boardPlan.Slots.Count Kişilik Yasal Kadro İskeleti</h5>
                        <p class="small text-muted mb-2">
                            Önerilen: <strong>@boardPlan.RecommendedAsilNote</strong> • Yedek: @boardPlan.RecommendedYedekNote • Denetçi: @boardPlan.RecommendedDenetciNote
                        </p>
                        <div class="d-flex flex-wrap gap-2 small">
                            <span class="badge bg-success-subtle text-success border px-3 py-2">
                                Aktif Asil (Seviye 1-3): <strong>@boardPlan.ActiveAsilCount / @boardPlan.TargetAsilCount</strong>
                            </span>
                            <span class="badge bg-primary-subtle text-primary border px-3 py-2">
                                Salt Çoğunluk Kilidi (Evet &gt; Asil/2): <strong>@(boardPlan.BoardQuorumRequired > 0 ? $"{boardPlan.BoardQuorumRequired}/{boardPlan.ActiveAsilCount} Evet" : "Asil Atayın")</strong>
                            </span>
                            <span class="badge bg-secondary-subtle text-dark border px-3 py-2">
                                Yedek (Erişim Yok): <strong>@boardPlan.ActiveReserveCount / @boardPlan.TargetYedekCount</strong>
                            </span>
                            <span class="badge bg-info-subtle text-info-emphasis border px-3 py-2">
                                Denetçi (Malik • Salt Okunur): <strong>@boardPlan.ActiveAuditorCount / @boardPlan.TargetDenetciCount</strong>
                            </span>
                        </div>
                    </div>
                    @if (canEdit)
                    {
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold" data-bs-toggle="collapse" data-bs-target="#customBoardCountBox">
                            <i class="bi bi-sliders me-1"></i> Özel Sayı Belirle
                        </button>
                    }
                </div>

                @if (canEdit)
                {
                    <div class="collapse mt-3 pt-3 border-top" id="customBoardCountBox">
                        <form asp-action="SetCustomBoardCounts" asp-controller="BuildingManager" method="post" class="row g-2 align-items-end small">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="buildingId" value="@selected.Id" />
                            <div class="col-md-3 col-6">
                                <label class="form-label fw-bold mb-1">Asil Üye (Başkan+Aza)</label>
                                <input type="number" name="asilCount" min="1" max="15" class="form-control form-control-sm" value="@boardPlan.TargetAsilCount" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label fw-bold mb-1">Yedek Üye</label>
                                <input type="number" name="yedekCount" min="0" max="15" class="form-control form-control-sm" value="@boardPlan.TargetYedekCount" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label fw-bold mb-1">Denetçi</label>
                                <input type="number" name="denetciCount" min="0" max="9" class="form-control form-control-sm" value="@boardPlan.TargetDenetciCount" />
                            </div>
                            <div class="col-md-3 col-6 d-flex gap-1">
                                <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3 fw-bold">Uygula</button>
                                <button type="submit" name="resetToAuto" value="true" class="btn btn-sm btn-outline-secondary rounded-pill px-2">Otomatik</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- ADIM 2: ALT ALTA SIRALI YÖNETİM KURULU KOLTUKLARI (TIKLA & HEMEN ALTINDA AÇ) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge bg-success text-white rounded-pill px-3 mb-1">ADIM 2 • SIRALI KADRO VE ERİŞİM YETKİLERİ</span>
                    <h5 class="fw-bold text-dark mb-0">Yönetim Kurulu Koltukları (Tıkladığınız Koltuğun Bilgisi Altında Açılır)</h5>
                </div>
                @if (canEdit)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" data-bs-toggle="collapse" data-bs-target="#extraSeatPanel">
                        <i class="bi bi-plus-circle me-1"></i> Ek Görev / Üye Ekle
                    </button>
                }
            </div>
            <div class="card-body p-3 p-md-4 bg-light bg-opacity-50">
                <div class="accordion d-flex flex-column gap-2" id="boardSeatsAccordion">
                    @foreach (var slot in boardPlan.Slots)
                    {
                        var mem = slot.AssignedMember;
                        string collapseId = $"seatCollapse_{slot.SlotOrder}";
                        bool isWaiting = mem == null;
                        bool expired = mem != null && mem.IsTermExpired();
                        bool isAuditorSeat = slot.LevelNo == 5;
                        bool isReserveSeat = slot.LevelNo == 4;

                        string holderName = mem != null
                            ? (!string.IsNullOrWhiteSpace(mem.User?.FirstName) ? $"{mem.User.FirstName} {mem.User.LastName}".Trim() : (mem.User?.DisplayName ?? mem.User?.Email ?? "Kurul Üyesi"))
                            : "Atama Bekliyor";
                        string accessBadge = mem == null
                            ? "Koltuk Boş"
                            : expired
                                ? "⛔ Erişim Kilitli (Süresi Doldu)"
                                : mem.Role == GMK360.Core.Entities.BuildingManagerRole.ReserveMember
                                    ? "🔒 Panel Erişimi Yok (Yedek)"
                                    : mem.Role == GMK360.Core.Entities.BuildingManagerRole.Auditor
                                        ? "👁️ Salt Okunur Denetçi Erişimi"
                                        : "🔓 Yönetim Paneli Erişimi Açık";
                        string accessBadgeCls = mem == null
                            ? "bg-light text-muted border"
                            : expired
                                ? "bg-danger text-white"
                                : mem.Role == GMK360.Core.Entities.BuildingManagerRole.ReserveMember
                                    ? "bg-secondary-subtle text-dark border"
                                    : mem.Role == GMK360.Core.Entities.BuildingManagerRole.Auditor
                                        ? "bg-info-subtle text-info-emphasis border"
                                        : "bg-success-subtle text-success border border-success-subtle";

                        <div class="board-step-card @(isWaiting ? "board-step-waiting" : "") overflow-hidden">
                            <!-- TIKLANABİLİR TEK SATIR BAŞLIK -->
                            <div class="board-step-header p-3 d-flex flex-wrap justify-content-between align-items-center gap-2"
                                 data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge @(slot.LevelNo == 1 ? "bg-success" : slot.LevelNo == 2 ? "bg-primary" : slot.LevelNo == 3 ? "bg-dark" : slot.LevelNo == 4 ? "bg-secondary" : "bg-info text-dark") rounded-pill px-2 py-1">
                                        @slot.SlotOrder. Seviye @slot.LevelNo
                                    </span>
                                    <div>
                                        <div class="fw-bold text-dark">
                                            @slot.SlotTitle
                                            @if (mem != null)
                                            {
                                                <span class="text-primary ms-2">— @holderName</span>
                                            }
                                        </div>
                                        <div class="small text-muted">
                                            @if (mem != null)
                                            {
                                                <span>TCKN: <strong>@mem.GetMaskedTcIdentity()</strong></span>
                                                <span class="mx-2">•</span>
                                                <span>@GMK360.Core.Entities.BuildingManager.GetSignatureLabel(mem.SignatureAuthorityType)</span>
                                                <span class="mx-2">•</span>
                                                <span>Dönem: @(mem.TermStartDate?.ToString("dd.MM.yy") ?? "-")–@(mem.TermEndDate?.ToString("dd.MM.yy") ?? "Belirsiz")</span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @(isAuditorSeat ? "KMK Md. 41: Kat maliki (tapu sahibi) seçilmelidir." :
                                                      isReserveSeat ? "Asil üyelerden biri ayrıldığında sıradan asil kadroya yükselir." :
                                                      $"Karar oylamasında oy hakkı • Önerilen Yetki: {GMK360.Core.Entities.BuildingManager.GetSignatureLabel(slot.SuggestedSignatureType)}")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge @accessBadgeCls rounded-pill px-3 py-1">@accessBadge</span>
                                    @if (mem != null && mem.IsVisibleToResidents)
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill"><i class="bi bi-eye me-1"></i>Sakinlere Açık</span>
                                    }
                                    <span class="btn btn-xs @(isWaiting ? "btn-primary fw-bold" : "btn-outline-dark fw-semibold") rounded-pill px-3">
                                        @(isWaiting ? "Kişi Ata & Bilgi Gir" : "Bilgileri Aç / Düzenle") <i class="bi bi-chevron-down ms-1"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- TAM ALTINDA AÇILAN DETAY / ATAMA PANELİ -->
                            <div id="@collapseId" class="collapse border-top bg-white" data-bs-parent="#boardSeatsAccordion">
                                <div class="p-3 p-md-4">
                                    @if (isWaiting)
                                    {
                                        @if (slot.LevelNo <= 3 && firstReserve != null && canEdit)
                                        {
                                            <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3 rounded-3 mb-3 small">
                                                <span><i class="bi bi-arrow-up-circle-fill me-1"></i>Sırada bekleyen Yedek Üye mevcut! İsterseniz hemen asil kadroya yükseltebilirsiniz.</span>
                                                <form asp-action="PromoteReserveToActive" asp-controller="BuildingManager" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@selected.Id" />
                                                    <input type="hidden" name="managerId" value="@firstReserve.Id" />
                                                    <button type="submit" class="btn btn-xs btn-success rounded-pill px-3 fw-bold">⬆️ Yedekten Asile Yükselt</button>
                                                </form>
                                            </div>
                                        }

                                        if (canEdit)
                                        {
                                            <form asp-action="AssignGovernanceMember" asp-controller="BuildingManager" method="post" class="row g-2 small">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="buildingId" value="@selected.Id" />
                                                <input type="hidden" name="returnTo" value="Governance" />
                                                <input type="hidden" name="role" value="@slot.TargetRole" />
                                                <input type="hidden" name="hierarchyOrder" value="@slot.SlotOrder" />

                                                <div class="col-12 mb-1">
                                                    <strong class="text-primary">@slot.SlotTitle — Yeni Üye Atama ve Erişim Tanımlama</strong>
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold mb-1">Üye Kaynağı (KMK Md. 34/41)</label>
                                                    <select name="isExternalAppointee" class="form-select form-select-sm" onchange="toggleSlotSourcePick(this, 'ownerPick_@slot.SlotOrder')">
                                                        <option value="false" selected>Site İçi (Tapu Sahibi / Kat Maliki)</option>
                                                        @if (!isAuditorSeat)
                                                        {
                                                            <option value="true">Dışarıdan Atama (Profesyonel / Kiracı)</option>
                                                        }
                                                    </select>
                                                    @if (isAuditorSeat)
                                                    {
                                                        <small class="text-danger">Denetçi dışarıdan atanamaz.</small>
                                                    }
                                                </div>
                                                <div class="col-md-4" id="ownerPick_@slot.SlotOrder">
                                                    <label class="form-label fw-bold mb-1">Site İçi Malikten Hızlı Seç</label>
                                                    <select class="form-select form-select-sm" onchange="fillSlotFromOwner(this, @slot.SlotOrder)">
                                                        <option value="">-- Daire / Malik Seçin --</option>
                                                        @foreach (var su in siteOwnerUnits)
                                                        {
                                                            <option value="@su.Id" data-name="@su.OwnerName" data-email="@su.OwnerEmail" data-phone="@su.OwnerPhone">
                                                                @(su.Building?.BlockName ?? su.Building?.Name) • @su.DoorNumber (@su.OwnerName)
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold mb-1">Banka &amp; Evrak İmza Yetkisi</label>
                                                    <select name="signatureAuthorityType" class="form-select form-select-sm">
                                                        <option value="0" selected="@(slot.SuggestedSignatureType == GMK360.Core.Entities.SignatureAuthorityType.None ? "selected" : null)">0 - İmza Yetkisi Yok</option>
                                                        <option value="1" selected="@(slot.SuggestedSignatureType == GMK360.Core.Entities.SignatureAuthorityType.Single ? "selected" : null)">1 - Tek Başına İmzaya Yetkili</option>
                                                        <option value="2" selected="@(slot.SuggestedSignatureType == GMK360.Core.Entities.SignatureAuthorityType.Joint ? "selected" : null)">2 - Müşterek (Çift İmza) Yetkili</option>
                                                    </select>
                                                </div>

                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Ad Soyad *</label>
                                                    <input type="text" name="fullName" id="slotName_@slot.SlotOrder" class="form-control form-control-sm" required placeholder="Örn: Ahmet Demir" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">T.C. Kimlik No (Kontrol &amp; Erişim)</label>
                                                    <input type="text" name="tcIdentityNo" maxlength="11" class="form-control form-control-sm" placeholder="11 haneli TCKN" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Cep Telefonu (05XX)</label>
                                                    <input type="text" name="phoneNumber" id="slotPhone_@slot.SlotOrder" class="form-control form-control-sm" placeholder="0532 000 00 00" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">E-Posta Adresi</label>
                                                    <input type="email" name="email" id="slotEmail_@slot.SlotOrder" class="form-control form-control-sm" placeholder="uye@ornek.com" />
                                                </div>

                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Görev Başlangıcı</label>
                                                    <input type="date" name="termStartDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Görev Bitişi (Varsayılan +1 Yıl)</label>
                                                    <input type="date" name="termEndDate" class="form-control form-control-sm" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Atandığı Karar Kaydı</label>
                                                    <select name="appointmentMeetingId" class="form-select form-select-sm">
                                                        <option value="">-- Bağlanmadı --</option>
                                                        @foreach (var d in recentDecisions)
                                                        {
                                                            <option value="@d.Id">Karar #@(d.DecisionNumber ?? d.Id.ToString("D2")) (@d.MeetingDate.ToString("dd.MM.yy"))</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Unvan Notu</label>
                                                    <input type="text" name="customRoleNote" class="form-control form-control-sm" placeholder="Örn: Blok Temsilcisi" />
                                                </div>

                                                <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top mt-2">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" name="isVisibleToResidents" value="true" id="vis_@slot.SlotOrder" checked />
                                                        <label class="form-check-label fw-semibold" for="vis_@slot.SlotOrder">Daire Sakinleri Portalında Göster</label>
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                                                        <i class="bi bi-check2-circle me-1"></i> Kaydet &amp; Yetkilendir
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="text-muted small">Bu koltuk henüz boş; yönetici yetkisiyle atama bekleniyor.</div>
                                        }
                                    }
                                    else
                                    {
                                        <!-- ATANMIŞ ÜYE YÖNETİM PANELİ -->
                                        string cleanPhoneDigits = new string((mem!.User?.PhoneNumber ?? "").Where(char.IsDigit).ToArray());
                                        string waPhone = cleanPhoneDigits.StartsWith("90") ? cleanPhoneDigits : (cleanPhoneDigits.StartsWith("0") ? "9" + cleanPhoneDigits : (cleanPhoneDigits.Length == 10 ? "90" + cleanPhoneDigits : cleanPhoneDigits));
                                        GMK360.Core.Entities.SystemMeeting? appDec = (mem.AppointmentMeetingId.HasValue && decById.TryGetValue(mem.AppointmentMeetingId.Value, out var dFound)) ? dFound : null;
                                        GMK360.Core.Entities.DocumentArchive? appScan = (mem.AppointmentMeetingId.HasValue && decisionScans.TryGetValue(mem.AppointmentMeetingId.Value, out var sFound)) ? sFound : null;

                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom small">
                                            <div>
                                                <span class="badge bg-light text-dark border me-1">@(mem.IsExternalAppointee ? "Dışarıdan Atama" : "Site İçi Malik")</span>
                                                <span class="me-2"><i class="bi bi-envelope me-1"></i>@(mem.User?.Email ?? "-")</span>
                                                <span><i class="bi bi-telephone me-1"></i>@(mem.User?.PhoneNumber ?? "-")</span>
                                                <span class="ms-2"><i class="bi bi-person-vcard me-1"></i>TCKN: <strong>@mem.GetMaskedTcIdentity()</strong></span>
                                            </div>
                                            <div class="d-flex flex-wrap gap-1">
                                                @if (!string.IsNullOrEmpty(cleanPhoneDigits))
                                                {
                                                    <a href="tel:@cleanPhoneDigits" class="btn btn-xs btn-outline-primary rounded-pill px-2"><i class="bi bi-telephone-fill me-1"></i>Ara</a>
                                                    <a href="https://wa.me/@waPhone" target="_blank" class="btn btn-xs btn-outline-success rounded-pill px-2"><i class="bi bi-whatsapp me-1"></i>WhatsApp</a>
                                                }
                                                @if (appDec != null)
                                                {
                                                    <button type="button" class="btn btn-xs btn-outline-dark rounded-pill px-3 fw-semibold"
                                                            onclick="showAppointmentDecisionModal('@System.Web.HttpUtility.JavaScriptStringEncode($"Karar #{appDec.DecisionNumber ?? appDec.Id.ToString("D2")} ({appDec.MeetingDate:dd.MM.yyyy}) — {appDec.AgendaTitle}")', '@System.Web.HttpUtility.JavaScriptStringEncode(string.Join("\n", appDec.Decisions.Select(d => d.DecisionText)))', '@(appScan?.DocumentUrl ?? "")', @appDec.Id)">
                                                        <i class="bi bi-file-earmark-text me-1"></i>Atama Kararını Gör
                                                    </button>
                                                }
                                                @if (canEdit)
                                                {
                                                    <form asp-action="ToggleManagerResidentVisibility" asp-controller="BuildingManager" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="buildingId" value="@selected.Id" />
                                                        <input type="hidden" name="managerId" value="@mem.Id" />
                                                        <button type="submit" class="btn btn-xs @(mem.IsVisibleToResidents ? "btn-outline-info text-dark" : "btn-outline-secondary") rounded-pill px-2">
                                                            <i class="bi @(mem.IsVisibleToResidents ? "bi-eye-fill" : "bi-eye-slash-fill") me-1"></i>@(mem.IsVisibleToResidents ? "Sakinlere Açık" : "Sakinlere Gizli")
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>

                                        if (canEdit)
                                        {
                                            <form asp-action="UpdateBoardMemberMeta" asp-controller="BuildingManager" method="post" class="row g-2 small mb-3">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="buildingId" value="@selected.Id" />
                                                <input type="hidden" name="managerId" value="@mem.Id" />
                                                <input type="hidden" name="hierarchyOrder" value="@slot.SlotOrder" />

                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Görev / Makam</label>
                                                    <select name="role" class="form-select form-select-sm">
                                                        <option value="HeadManager" selected="@(mem.Role == GMK360.Core.Entities.BuildingManagerRole.HeadManager ? "selected" : null)">Seviye 1 — Başkan / Yönetici</option>
                                                        <option value="ViceChair" selected="@(mem.Role == GMK360.Core.Entities.BuildingManagerRole.ViceChair ? "selected" : null)">Seviye 2 — Bşk. Yrd. / Muhasip</option>
                                                        <option value="BoardMember" selected="@(mem.Role == GMK360.Core.Entities.BuildingManagerRole.BoardMember ? "selected" : null)">Seviye 3 — Asil Üye (Aza)</option>
                                                        <option value="ReserveMember" selected="@(mem.Role == GMK360.Core.Entities.BuildingManagerRole.ReserveMember ? "selected" : null)">Seviye 4 — Yedek Üye</option>
                                                        <option value="Auditor" selected="@(mem.Role == GMK360.Core.Entities.BuildingManagerRole.Auditor ? "selected" : null)">Seviye 5 — Denetçi (Malik Şart)</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">İmza Yetkisi</label>
                                                    <select name="signatureAuthorityType" class="form-select form-select-sm">
                                                        <option value="0" selected="@(mem.SignatureAuthorityType == GMK360.Core.Entities.SignatureAuthorityType.None ? "selected" : null)">İmza Yetkisi Yok</option>
                                                        <option value="1" selected="@(mem.SignatureAuthorityType == GMK360.Core.Entities.SignatureAuthorityType.Single ? "selected" : null)">Tek Başına Yetkili</option>
                                                        <option value="2" selected="@(mem.SignatureAuthorityType == GMK360.Core.Entities.SignatureAuthorityType.Joint ? "selected" : null)">Müşterek (Çift İmza)</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">T.C. Kimlik No (Güncelle/Ekle)</label>
                                                    <input type="text" name="tcIdentityNo" maxlength="11" class="form-control form-control-sm" value="@mem.User?.TcIdentityNo" placeholder="11 haneli TCKN" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Cep Telefonu</label>
                                                    <input type="text" name="phoneNumber" class="form-control form-control-sm" value="@mem.User?.PhoneNumber" />
                                                </div>

                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Görev Başlangıcı</label>
                                                    <input type="date" name="termStartDate" class="form-control form-control-sm" value="@((mem.TermStartDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Görev Bitişi</label>
                                                    <input type="date" name="termEndDate" class="form-control form-control-sm" value="@((mem.TermEndDate ?? DateTime.Today.AddYears(1)).ToString("yyyy-MM-dd"))" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Atandığı Karar Kaydı</label>
                                                    <select name="appointmentMeetingId" class="form-select form-select-sm">
                                                        <option value="">-- Bağlanmadı --</option>
                                                        @foreach (var d in recentDecisions)
                                                        {
                                                            <option value="@d.Id" selected="@(mem.AppointmentMeetingId == d.Id ? "selected" : null)">Karar #@(d.DecisionNumber ?? d.Id.ToString("D2"))</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold mb-1">Kaynak &amp; Sakin Görünürlüğü</label>
                                                    <select name="isExternalAppointee" class="form-select form-select-sm">
                                                        <option value="false" selected="@(!mem.IsExternalAppointee ? "selected" : null)">Site İçi Malik</option>
                                                        <option value="true" selected="@(mem.IsExternalAppointee ? "selected" : null)">Dışarıdan Atama</option>
                                                    </select>
                                                </div>
                                                <input type="hidden" name="isVisibleToResidents" value="@(mem.IsVisibleToResidents ? "true" : "false")" />

                                                <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2">
                                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                                                        <i class="bi bi-save me-1"></i> Bilgileri Güncelle
                                                    </button>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @if (mem.Role == GMK360.Core.Entities.BuildingManagerRole.ReserveMember && !expired)
                                                        {
                                                            <button type="submit" formaction="@Url.Action("PromoteReserveToActive", "BuildingManager")" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                                                                ⬆️ Asile Yükselt
                                                            </button>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold"
                                                                data-bs-toggle="collapse" data-bs-target="#replaceWrap_@mem.Id">
                                                            🔄 Makama Yeni Kişi Ata (Eskiyi Kapat)
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>

                                            <!-- YENİ ATAMA YAPIP ESKİSİNİ İPTAL ETME ALANI -->
                                            <div class="collapse border rounded-3 p-3 bg-warning-subtle bg-opacity-25 mb-2" id="replaceWrap_@mem.Id">
                                                <form asp-action="AssignGovernanceMember" asp-controller="BuildingManager" method="post" class="row g-2 small">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@selected.Id" />
                                                    <input type="hidden" name="returnTo" value="Governance" />
                                                    <input type="hidden" name="role" value="@mem.Role" />
                                                    <input type="hidden" name="hierarchyOrder" value="@slot.SlotOrder" />
                                                    <input type="hidden" name="replaceManagerId" value="@mem.Id" />
                                                    <input type="hidden" name="signatureAuthorityType" value="@((int)mem.SignatureAuthorityType)" />
                                                    <div class="col-12 fw-bold text-dark">
                                                        <i class="bi bi-shield-lock me-1"></i>Yeni Kişi Ata — Eski üye (@holderName) otomatik arşivlenip girişi kesilecektir:
                                                    </div>
                                                    <div class="col-md-3">
                                                        <input type="text" name="fullName" class="form-control form-control-sm" required placeholder="Yeni Kişi Ad Soyad *" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <input type="text" name="tcIdentityNo" maxlength="11" class="form-control form-control-sm" placeholder="11 haneli TCKN" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <input type="text" name="phoneNumber" class="form-control form-control-sm" placeholder="Telefon (05XX)" />
                                                    </div>
                                                    <div class="col-md-3 d-flex gap-1">
                                                        <input type="email" name="email" class="form-control form-control-sm" placeholder="E-posta" />
                                                        <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold text-nowrap">Değiştir</button>
                                                    </div>
                                                </form>
                                            </div>

                                            <div class="d-flex justify-content-end">
                                                <form asp-action="RemoveGovernanceMember" asp-controller="BuildingManager" method="post" class="d-inline"
                                                      onsubmit="return confirm('Bu kişinin yönetim paneli erişimini iptal edip geçmiş döneme taşımak istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@selected.Id" />
                                                    <input type="hidden" name="managerId" value="@mem.Id" />
                                                    <input type="hidden" name="returnTo" value="Governance" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger rounded-pill px-3">
                                                        <i class="bi bi-slash-circle me-1"></i> Yetkiyi İptal Et &amp; Geçmiş Döneme Al
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- EK ÖZEL GÖREV / ÜYE EKLE (Sadece gerekirse açılır) -->
                @if (canEdit)
                {
                    <div class="collapse mt-3" id="extraSeatPanel">
                        <div class="card border rounded-4 p-3 bg-white">
                            <h6 class="fw-bold mb-2"><i class="bi bi-person-plus me-1 text-primary"></i> Ek Kurul Üyesi / Özel Görev Ekle</h6>
                            <form asp-action="AssignGovernanceMember" asp-controller="BuildingManager" method="post" class="row g-2 small">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="buildingId" value="@selected.Id" />
                                <input type="hidden" name="returnTo" value="Governance" />
                                <div class="col-md-4">
                                    <label class="form-label fw-bold mb-1">Görev</label>
                                    <select name="role" class="form-select form-select-sm">
                                        <option value="BoardMember">Seviye 3 — Asil Üye (Aza)</option>
                                        <option value="ViceChair">Seviye 2 — Bşk. Yrd. / Muhasip</option>
                                        <option value="ReserveMember">Seviye 4 — Yedek Üye</option>
                                        <option value="Auditor">Seviye 5 — Denetçi (Malik Şart)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold mb-1">Ad Soyad *</label>
                                    <input type="text" name="fullName" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold mb-1">T.C. Kimlik No</label>
                                    <input type="text" name="tcIdentityNo" maxlength="11" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold mb-1">Telefon</label>
                                    <input type="text" name="phoneNumber" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold mb-1">E-Posta</label>
                                    <input type="email" name="email" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill fw-bold">Ekle</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ADIM 3: BANKA & NOTER İMZA SİRKÜLERİ (TAM GENİŞLİKTE TEK KONU BLOKU) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-primary">
            <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge bg-primary text-white rounded-pill px-3 mb-1">ADIM 3 • BANKA &amp; RESMİ DAİRE BELGELERİ</span>
                    <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-lock-fill text-primary me-2"></i>Noter Onaylı İmza Sirküleri</h5>
                </div>
                @if (!string.IsNullOrWhiteSpace(latestCircularUrl))
                {
                    <a href="@latestCircularUrl" target="_blank" class="btn btn-sm btn-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-eye me-1"></i> Geçerli Sirküleri Aç
                    </a>
                }
            </div>
            <div class="card-body p-3 p-md-4">
                <p class="small text-muted mb-3">Banka hesap açılışı, SGK ve resmi kurum işlemlerinde tek tıkla erişebilmek için noter onaylı imza sirkülerini (PDF / Görsel) buraya yükleyin.</p>
                @if (canEdit)
                {
                    <form asp-action="UploadSignatureCircular" asp-controller="BuildingManager" method="post" enctype="multipart/form-data" class="row g-2 align-items-center mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="buildingId" value="@selected.Id" />
                        <div class="col-md-5">
                            <input type="text" name="docTitle" class="form-control form-control-sm" placeholder="Belge başlığı (Örn: 2026 Noter İmza Sirküleri)" />
                        </div>
                        <div class="col-md-5">
                            <input type="file" name="circularFile" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill fw-bold">Yükle</button>
                        </div>
                    </form>
                }
                @if (circularDocs.Any())
                {
                    <div class="list-group list-group-flush small border-top pt-2">
                        @foreach (var cd in circularDocs)
                        {
                            <a href="@cd.DocumentUrl" target="_blank" class="list-group-item list-group-item-action px-0 py-2 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-file-pdf text-danger me-2"></i><strong>@cd.Title</strong></span>
                                <span class="badge bg-light text-dark border">@cd.UploadDate.ToString("dd.MM.yyyy")</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ADIM 4: GEÇMİŞ DÖNEM YÖNETİMLERİ & YETKİ DEVRİ ARŞİVİ -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge bg-secondary text-white rounded-pill px-3 mb-1">ADIM 4 • DENETİM ARŞİVİ</span>
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Geçmiş Dönem Yönetimleri &amp; Yetkisi İptal Edilenler (@archivedManagers.Count)</h5>
                </div>
                @if (canEdit)
                {
                    <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-bold" data-bs-toggle="collapse" data-bs-target="#quickHeadTransferBox">
                        <i class="bi bi-arrow-left-right me-1"></i> Ana Yönetici Yetkisi Devret
                    </button>
                }
            </div>
            <div class="card-body p-3 p-md-4">
                @if (canEdit)
                {
                    <div class="collapse mb-3 p-3 rounded-3 bg-warning-subtle bg-opacity-25 border" id="quickHeadTransferBox">
                        <p class="small text-muted mb-2">
                            Ana Yönetici yetkisi belirtilen kayıtlı hesaba devredilir ve eski yöneticinin giriş yetkisi otomatik kapatılır (Karar Defteri ile seçim önerilir).
                        </p>
                        <form asp-action="TransferHeadManager" asp-controller="BuildingManager" method="post" class="d-flex flex-wrap gap-2"
                              onsubmit="return confirm('Ana Yönetici yetkisi devredilecek ve eski yöneticinin girişi kapatılacaktır. Onaylıyor musunuz?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="buildingId" value="@selected.Id" />
                            <input type="hidden" name="returnTo" value="Governance" />
                            <input type="email" name="newManagerEmail" class="form-control form-control-sm" style="max-width:340px;" required placeholder="yeni.yonetici@ornek.com" />
                            <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-4">Yetkiyi Devret</button>
                            <a href="/BuildingManager/Oylamalar?buildingId=@selected.Id&preset=AppointManager" class="btn btn-sm btn-outline-primary rounded-pill px-3">Karar Defteriyle Ata</a>
                        </form>
                    </div>
                }

                @if (archivedManagers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ad Soyad</th>
                                    <th>Görev / Makam</th>
                                    <th>TCKN</th>
                                    <th>Dönem</th>
                                    <th>Durum</th>
                                    <th>Karar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var am in archivedManagers)
                                {
                                    string amName = !string.IsNullOrWhiteSpace(am.User?.FirstName) ? $"{am.User.FirstName} {am.User.LastName}".Trim() : (am.User?.Email ?? "Eski Üye");
                                    <tr>
                                        <td class="fw-semibold">@amName</td>
                                        <td>@GMK360.Core.Entities.BuildingManager.GetRoleLabel(am.Role)</td>
                                        <td>@am.GetMaskedTcIdentity()</td>
                                        <td>@(am.TermStartDate?.ToString("dd.MM.yy") ?? am.CreatedAt.ToString("dd.MM.yy")) – @(am.TermEndDate?.ToString("dd.MM.yy") ?? "-")</td>
                                        <td>
                                            <span class="badge @(am.IsTermExpired() ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")">
                                                @(am.IsTermExpired() ? "Süresi Doldu (Erişim Kilitli)" : "Pasif / Yetki İptal Edildi")
                                            </span>
                                        </td>
                                        <td>
                                            @if (am.AppointmentMeetingId.HasValue && decById.TryGetValue(am.AppointmentMeetingId.Value, out var decRec))
                                            {
                                                <span class="badge bg-light text-dark border">#@(decRec.DecisionNumber ?? decRec.Id.ToString())</span>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="small text-muted">Henüz geçmiş döneme aktarılmış yönetim kurulu kaydı bulunmuyor.</div>
                }
            </div>
        </div>

        <!-- ADIM 5: KURUMSAL SİTE KİMLİĞİ & BLOK YAPISI (EN ALTTA AYRI BLOK) -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge bg-info text-dark rounded-pill px-3 mb-1">ADIM 5 • SİTE PORTALI &amp; YAPI BİLGİSİ</span>
                    <h5 class="fw-bold mb-0"><i class="bi bi-globe text-info me-2"></i>Kurumsal Site Adresi &amp; Blok Özeti</h5>
                </div>
                <a href="/BuildingManager/Onboarding/@selected.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">Yapı &amp; Adres Düzenle</a>
            </div>
            <div class="card-body p-3 p-md-4 row g-3 align-items-center small">
                <div class="col-md-6">
                    <form asp-action="SetSiteIdentity" asp-controller="BuildingManager" method="post" class="d-flex flex-wrap align-items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="buildingId" value="@selected.Id" />
                        <input type="hidden" name="returnTo" value="Governance" />
                        <div class="input-group input-group-sm" style="max-width:300px;">
                            <input type="text" name="subdomain" class="form-control" value="@currentSubdomain" placeholder="Örn: yesilvadi" />
                            <span class="input-group-text">.gmk360.com</span>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="isIndependentSite" value="true" id="indepSiteSw" checked="@(complex?.IsIndependentSite ?? true)" />
                            <label class="form-check-label" for="indepSiteSw">Site Portalı Aktif</label>
                        </div>
                        <button type="submit" class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-3">Kaydet</button>
                    </form>
                </div>
                <div class="col-md-6">
                    <div class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@(selected.Address ?? "Adres detayını Yapı & Adres Düzenle adımından tamamlayın")</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var blk in siteBlocks)
                        {
                            <a href="/BuildingManager/Detail/@blk.Id" class="badge bg-light text-dark border text-decoration-none py-1 px-2">
                                @(blk.BlockName ?? blk.Name) (@(blk.Units?.Count(u => !(u.Category ?? "").StartsWith("OrtakAlan")) ?? 0) Bölüm)
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Atama Kararı & Islak İmzalı Sayfa Önizleme Modalı -->
<div class="modal fade" id="appointmentDecisionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white border-0">
                <h6 class="modal-title fw-bold" id="appDecModalTitle">Atama Kararı</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="bg-light border rounded-3 p-3 small mb-3" id="appDecModalBody" style="white-space: pre-line;"></div>
                <div id="appDecScanWrap" class="d-none border rounded-3 p-3 text-center">
                    <div class="small fw-bold text-success mb-2"><i class="bi bi-patch-check-fill me-1"></i>Islak İmzalı Noter Defteri Sureti</div>
                    <a id="appDecScanLink" href="#" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-file-earmark-image me-1"></i> Tam Boyut / PDF Görüntüle
                    </a>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <a id="appDecPrintLink" href="#" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
                    <i class="bi bi-printer me-1"></i> Noter Çıktısı (A4)
                </a>
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSlotSourcePick(sel, pickWrapId) {
        const wrap = document.getElementById(pickWrapId);
        if (!wrap) return;
        wrap.classList.toggle('opacity-50', sel.value === 'true');
    }

    function fillSlotFromOwner(sel, slotOrder) {
        const opt = sel?.options?.[sel.selectedIndex];
        if (!opt || !opt.value) return;
        const n = document.getElementById('slotName_' + slotOrder);
        const e = document.getElementById('slotEmail_' + slotOrder);
        const p = document.getElementById('slotPhone_' + slotOrder);
        if (n) n.value = opt.getAttribute('data-name') || '';
        if (e) e.value = opt.getAttribute('data-email') || '';
        if (p) p.value = opt.getAttribute('data-phone') || '';
    }

    function showAppointmentDecisionModal(title, body, scanUrl, meetingId) {
        document.getElementById('appDecModalTitle').innerText = title || 'Atama Kararı';
        document.getElementById('appDecModalBody').innerText = body || 'Karar metni eklenmemiş.';
        document.getElementById('appDecPrintLink').href = '/BuildingManager/PrintDecisionSheet?meetingId=' + meetingId + '&format=a4';
        const wrap = document.getElementById('appDecScanWrap');
        if (scanUrl) {
            wrap.classList.remove('d-none');
            document.getElementById('appDecScanLink').href = scanUrl;
        } else {
            wrap.classList.add('d-none');
        }
        new bootstrap.Modal(document.getElementById('appointmentDecisionModal')).show();
    }
</script>
