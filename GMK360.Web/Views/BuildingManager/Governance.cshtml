<script>
    function prefillAssignForm(roleVal, sigTypeVal, slotOrder) {
        const roleSel = document.getElementById('assignRoleSelect');
        const sigSel = document.getElementById('assignSigSelect');
        const ordInp = document.getElementById('assignHierarchyOrderInput');
        if (roleSel) roleSel.value = roleVal;
        if (sigSel) sigSel.value = String(sigTypeVal || 0);
        if (ordInp) ordInp.value = String(slotOrder || 0);
        onAssignRoleOrSourceChanged();
        const card = document.getElementById('assignBoardCard');
        if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function onAssignRoleOrSourceChanged() {
        const role = document.getElementById('assignRoleSelect')?.value;
        const src = document.getElementById('assignSourceSelect');
        const warn = document.getElementById('auditorKmkWarning');
        const extOpt = src?.querySelector('option[value="true"]');
        if (role === 'Auditor') {
            if (src) src.value = 'false';
            if (extOpt) extOpt.disabled = true;
            warn?.classList.remove('d-none');
        } else {
            if (extOpt) extOpt.disabled = false;
            warn?.classList.add('d-none');
        }
    }

    function pickSiteOwnerForAssign(sel) {
        const opt = sel?.options?.[sel.selectedIndex];
        if (!opt || !opt.value) return;
        document.getElementById('assignFullName').value = opt.getAttribute('data-name') || '';
        document.getElementById('assignEmail').value = opt.getAttribute('data-email') || '';
        document.getElementById('assignPhone').value = opt.getAttribute('data-phone') || '';
    }

    function showAppointmentDecisionModal(title, body, scanUrl, meetingId) {
        document.getElementById('appDecModalTitle').innerText = title || 'Atama Kararı';
        document.getElementById('appDecModalBody').innerText = body || 'Karar metni eklenmemiş.';
        document.getElementById('appDecPrintLink').href = '/BuildingManager/PrintDecisionSheet?meetingId=' + meetingId + '&format=a4';
        const wrap = document.getElementById('appDecScanWrap');
        if (scanUrl) {
            wrap.classList.remove('d-none');
            document.getElementById('appDecScanLink').href = scanUrl;
        } else {
            wrap.classList.add('d-none');
        }
        new bootstrap.Modal(document.getElementById('appointmentDecisionModal')).show();
    }

    function openEditBoardMemberModal(id, name, role, sigType, startDt, endDt, meetingId, isExt, isVis, order, note) {
        document.getElementById('editMgrId').value = id;
        document.getElementById('editMgrName').innerText = name;
        document.getElementById('editMgrRole').value = role;
        document.getElementById('editMgrSig').value = String(sigType);
        document.getElementById('editMgrStart').value = startDt;
        document.getElementById('editMgrEnd').value = endDt;
        document.getElementById('editMgrMeeting').value = meetingId || '';
        document.getElementById('editMgrExternal').value = isExt ? 'true' : 'false';
        document.getElementById('editMgrVisible').checked = !!isVis;
        document.getElementById('editHierarchyOrder').value = String(order || 0);
        document.getElementById('editMgrNote').value = note || '';
        new bootstrap.Modal(document.getElementById('editBoardMemberModal')).show();
    }
</script>
