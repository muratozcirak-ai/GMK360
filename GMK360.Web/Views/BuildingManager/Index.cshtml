@model IEnumerable<GMK360.Core.Entities.Building>
@{
    ViewData["Title"] = "Yönetim Kumanda Merkezi";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";

    var buildingList = (Model ?? Enumerable.Empty<GMK360.Core.Entities.Building>()).ToList();
    var totalBuildings = buildingList.Count;
    var totalUnits = ViewBag.TotalUnits ?? 0;
    var resUnits = ViewBag.ResidentialUnits ?? 0;
    var comUnits = ViewBag.CommercialUnits ?? 0;
    var occupiedUnits = ViewBag.OccupiedUnits ?? 0;
    var totalPaid = (decimal)(ViewBag.TotalPaid ?? 0m);
    var totalUnpaid = (decimal)(ViewBag.TotalUnpaid ?? 0m);
    decimal collectionRate = (totalPaid + totalUnpaid) > 0 ? (totalPaid / (totalPaid + totalUnpaid)) * 100 : 0;

    var openFaults = ViewBag.OpenFaults as List<GMK360.Core.Entities.BuildingTaskTicket> ?? new List<GMK360.Core.Entities.BuildingTaskTicket>();
    var residentRequests = ViewBag.ResidentRequests as List<GMK360.Core.Entities.SupportTicket> ?? new List<GMK360.Core.Entities.SupportTicket>();
    var managerPlans = ViewBag.ManagerWorkPlans as List<GMK360.Core.Entities.SupportTicket> ?? new List<GMK360.Core.Entities.SupportTicket>();
    var upcomingMeetings = ViewBag.UpcomingMeetings as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
    var upcomingMaintenances = ViewBag.UpcomingMaintenances as List<GMK360.Core.Entities.SpaceFixture> ?? new List<GMK360.Core.Entities.SpaceFixture>();

    int openTodoCount = managerPlans.Count(p => p.Status != "Resolved" && p.Status != "Closed");
    var firstBuilding = buildingList.FirstOrDefault();
    string primaryTitle = firstBuilding?.HousingComplex?.Name ?? (buildingList.Count == 1 ? firstBuilding!.Name : "Bina & Site Yönetimi");
}

<div class="py-1">
    <!-- Sade Üst Başlık -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-speedometer2 text-success me-2"></i>@primaryTitle — Günlük Yönetim Masası
            </h3>
            <small class="text-muted">Açık arızalar, sakin talepleri/şikayetler, günlük iş planınız ve portföy özeti</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/BuildingManager/MevzuatRehberi" class="btn btn-outline-primary btn-sm fw-bold rounded-pill px-3 shadow-sm">
                <i class="bi bi-journal-bookmark-fill me-1"></i> Yasal Prosedürler &amp; Yönetici El Kitabı
            </a>
            <button type="button" class="btn btn-success btn-sm fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#startFacilityModal">
                <i class="bi bi-plus-lg me-1"></i> Yeni Bina / Site Ekle
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i><strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!buildingList.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white mb-4">
            <div class="mb-3">
                <i class="bi bi-buildings text-success opacity-75" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">Henüz Kayıtlı Bir Bina veya Siteniz Yok</h4>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Apartmanınızı veya sitenizi tanımlayarak aidat takibi, personel puantajı, arıza yönetimi ve noter karar defteri işlemlerine başlayabilirsiniz.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">
                <form asp-action="AddSampleBuilding" asp-controller="BuildingManager" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-lg fw-bold rounded-pill px-4 shadow-sm text-dark">
                        <i class="bi bi-magic me-2"></i> Tek Tıkla Örnek Siteyi Yükle
                    </button>
                </form>
                <button type="button" class="btn btn-success btn-lg fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#startFacilityModal">
                    <i class="bi bi-plus-circle me-2"></i> Sıfırdan Yeni Bina / Site Ekle
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- 4 Sade Özet Kart -->
        <div class="row g-3 mb-3">
            <div class="col-xl-3 col-sm-6">
                <a href="/BuildingManager/TicketManagement" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">AÇIK ARIZA / SAHA İŞİ</span>
                                <h3 class="fw-bold mb-0 @(openFaults.Any() ? "text-danger" : "text-success")">@openFaults.Count</h3>
                                <small class="text-muted" style="font-size:.74rem;">@(openFaults.Count(f => f.Priority == "Acil") > 0 ? $"{openFaults.Count(f => f.Priority == "Acil")} Acil öncelikli" : "Bekleyen saha arızaları")</small>
                            </div>
                            <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                                <i class="bi bi-wrench-adjustable fs-4"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-sm-6">
                <a href="/BuildingManager/TicketManagement" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">TALEP, ÖNERİ &amp; ŞİKAYET</span>
                                <h3 class="fw-bold mb-0 @(residentRequests.Any() ? "text-warning-emphasis" : "text-dark")">@residentRequests.Count</h3>
                                <small class="text-muted" style="font-size:.74rem;">Sakin bildirimi &amp; havale dekontu</small>
                            </div>
                            <div class="bg-warning bg-opacity-10 text-warning-emphasis rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                                <i class="bi bi-chat-left-dots fs-4"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold d-block">YÖNETİCİ İŞ PLANIM</span>
                            <h3 class="fw-bold mb-0 text-primary">@openTodoCount</h3>
                            <small class="text-muted" style="font-size:.74rem;">@upcomingMeetings.Count açık karar · @upcomingMaintenances.Count bakım</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                            <i class="bi bi-list-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <a href="/BuildingManager/Accounting" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-bold d-block">AİDAT TAHSİLATI &amp; KASA</span>
                                <h4 class="fw-bold mb-0 text-success">@totalPaid.ToString("N0") ₺</h4>
                                <small class="text-danger" style="font-size:.74rem;">@totalUnpaid.ToString("N0") ₺ bekleyen (%@collectionRate.ToString("0") tahsilat)</small>
                            </div>
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                                <i class="bi bi-cash-coin fs-4"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- ANA İŞ MASASI: SOL = ARIZALAR & TALEPLER | SAĞ = YÖNETİCİ İŞ PLANI & TAKVİM -->
        <div class="row g-3 mb-4">
            <!-- Sol Sütun (%58): Arızalar + Sakin Talepleri, Öneriler, Şikayetler -->
            <div class="col-lg-7">
                <!-- 1. Açık Arızalar / Saha Görevleri -->
                <div class="card border-0 shadow-sm rounded-4 bg-white mb-3">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-tools text-danger me-2"></i>Açık Arızalar &amp; Saha Görevleri (@openFaults.Count)
                        </h6>
                        <a href="/BuildingManager/TicketManagement" class="btn btn-xs btn-outline-danger rounded-pill px-3 fw-semibold">Tümünü Yönet &rarr;</a>
                    </div>
                    <div class="card-body p-3">
                        @if (!openFaults.Any())
                        {
                            <div class="text-center py-3 text-muted small">
                                <i class="bi bi-check-circle text-success fs-4 d-block mb-1"></i>
                                Şu anda bekleyen veya devam eden açık arıza bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var fault in openFaults)
                                {
                                    string bLabel = fault.Building?.BlockName ?? fault.Building?.Name ?? "Bina";
                                    string unitLbl = fault.BuildingUnit != null ? $" • Daire {fault.BuildingUnit.DoorNumber}" : "";
                                    <div class="list-group-item px-0 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                                <span class="badge @(fault.Priority == "Acil" ? "bg-danger" : "bg-secondary")">@fault.Priority</span>
                                                <span class="badge bg-light text-dark border">@fault.Category</span>
                                                <strong class="small text-dark">@bLabel@unitLbl</strong>
                                                <span class="badge @(fault.Status == "Atandi" ? "bg-info text-dark" : "bg-warning text-dark")">@fault.Status</span>
                                            </div>
                                            <div class="small text-dark mt-1">@fault.Description</div>
                                            <small class="text-muted" style="font-size:.73rem;">
                                                @(!string.IsNullOrWhiteSpace(fault.LocationNote) ? $"{fault.LocationNote} • " : "")
                                                @(fault.AssignedStaff != null ? $"Görevli: {fault.AssignedStaff.FullName}" : "Henüz görevli atanmadı")
                                                • @fault.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </small>
                                        </div>
                                        <a href="/BuildingManager/TicketManagement?buildingId=@fault.BuildingId" class="btn btn-xs btn-outline-primary rounded-pill px-3 text-nowrap">İncele / Ata</a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- 2. Sakin Talepleri, Öneriler, Şikayetler & Ödeme Bildirimleri -->
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-chat-square-text text-warning-emphasis me-2"></i>Sakin Talepleri, Öneri, Şikayet &amp; Ödeme Bildirimleri (@residentRequests.Count)
                        </h6>
                        <a href="/BuildingManager/TicketManagement" class="btn btn-xs btn-outline-secondary rounded-pill px-3 fw-semibold">Talep Merkezi &rarr;</a>
                    </div>
                    <div class="card-body p-3">
                        @if (!residentRequests.Any())
                        {
                            <div class="text-center py-3 text-muted small">
                                Bekleyen yeni sakin talebi, öneri veya şikayet bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var req in residentRequests)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div style="min-width:0; flex:1;">
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                                <span class="badge @(req.Category == "Complaint" ? "bg-danger-subtle text-danger border border-danger-subtle" : req.Category == "PaymentNotice" ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                                    @(req.Category == "Complaint" ? "Şikayet" : req.Category == "PaymentNotice" ? "Ödeme Bildirimi" : req.Category == "MeetingRequest" ? "Gündem Önerisi" : req.Category)
                                                </span>
                                                <strong class="small text-dark">@req.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(req.ContextInfo))
                                                {
                                                    <span class="badge bg-light text-dark border">@req.ContextInfo</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(req.Description))
                                            {
                                                <div class="small text-muted text-truncate mt-1">@req.Description</div>
                                            }
                                            <small class="text-muted" style="font-size:.72rem;">@req.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                        </div>
                                        <form asp-action="QuickResolveResidentTicket" asp-controller="BuildingManager" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ticketId" value="@req.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-success rounded-pill px-2 text-nowrap" title="Tamamlandı olarak işaretle">
                                                <i class="bi bi-check2 me-1"></i>Çözüldü
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sağ Sütun (%42): Yönetici İş Planım & Yaklaşan Takvim -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white mb-3">
                    <div class="card-header bg-white border-bottom p-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-journal-check text-primary me-2"></i>Yönetici İş Planım &amp; Hatırlatıcılar
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <form asp-action="AddManagerWorkPlan" asp-controller="BuildingManager" method="post" class="bg-light border rounded-3 p-2 mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="buildingId" value="@firstBuilding!.Id" />
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" name="title" class="form-control" required placeholder="Yeni iş ekle... (Örn: Asansör firması aranacak)" />
                                <button type="submit" class="btn btn-primary fw-bold px-3">Ekle</button>
                            </div>
                            <div class="row g-1">
                                <div class="col-7">
                                    <input type="text" name="scheduleNote" class="form-control form-control-sm" placeholder="Tarih / Saat / Not (Örn: Bugün 14:00)" />
                                </div>
                                <div class="col-5">
                                    <select name="priority" class="form-select form-select-sm">
                                        <option value="Normal">Normal Öncelik</option>
                                        <option value="High">Önemli</option>
                                        <option value="Urgent">Acil</option>
                                    </select>
                                </div>
                            </div>
                        </form>

                        @if (!managerPlans.Any())
                        {
                            <p class="small text-muted text-center py-2 mb-0">Henüz kişisel iş planı eklemediniz. Yukarıdan hızlıca hatırlatıcı ekleyebilirsiniz.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var plan in managerPlans)
                                {
                                    bool done = plan.Status == "Resolved" || plan.Status == "Closed";
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center gap-2">
                                        <div class="d-flex align-items-start gap-2">
                                            <form asp-action="ToggleManagerWorkPlan" asp-controller="BuildingManager" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="planId" value="@plan.Id" />
                                                <button type="submit" class="btn btn-xs @(done ? "btn-success" : "btn-outline-secondary") rounded-circle" style="width:24px;height:24px;padding:0;" title="@(done ? "Yeniden Aç" : "Tamamlandı İşaretle")">
                                                    <i class="bi bi-check"></i>
                                                </button>
                                            </form>
                                            <div>
                                                <div class="small fw-semibold @(done ? "text-decoration-line-through text-muted" : "text-dark")">
                                                    @if (plan.Priority == "Urgent") { <span class="badge bg-danger me-1">Acil</span> }
                                                    else if (plan.Priority == "High") { <span class="badge bg-warning text-dark me-1">Önemli</span> }
                                                    @plan.Title
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(plan.ContextInfo))
                                                {
                                                    <small class="text-muted" style="font-size:.72rem;"><i class="bi bi-clock me-1"></i>@plan.ContextInfo</small>
                                                }
                                            </div>
                                        </div>
                                        <form asp-action="ToggleManagerWorkPlan" asp-controller="BuildingManager" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="planId" value="@plan.Id" />
                                            <input type="hidden" name="targetStatus" value="Delete" />
                                            <button type="submit" class="btn btn-xs text-muted border-0 bg-transparent p-1" title="Kaldır"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Yaklaşan Toplantı & Bakım Takvimi -->
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-event text-success me-2"></i>Yaklaşan Toplantı &amp; Bakımlar</h6>
                        <a href="/BuildingManager/BakimTakvimi" class="btn btn-xs btn-outline-success rounded-pill px-2">Takvim &rarr;</a>
                    </div>
                    <div class="card-body p-3 small">
                        @if (!upcomingMeetings.Any() && !upcomingMaintenances.Any())
                        {
                            <p class="text-muted mb-0">Yaklaşan planlı toplantı veya periyodik bakım kaydı yok.</p>
                        }
                        else
                        {
                            @foreach (var mt in upcomingMeetings)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                    <span><span class="badge bg-warning text-dark me-1">Toplantı</span><a href="/BuildingManager/Oylamalar" class="text-dark text-decoration-none fw-semibold">@mt.AgendaTitle</a></span>
                                    <span class="text-muted">@mt.MeetingDate.ToString("dd.MM HH:mm")</span>
                                </div>
                            }
                            @foreach (var fx in upcomingMaintenances)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                    <span><span class="badge bg-info-subtle text-info-emphasis me-1">Bakım</span>@fx.ItemName</span>
                                    <span class="text-muted">@fx.NextMaintenanceDate?.ToString("dd.MM.yyyy")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- KOMPAKT PORTFÖY / SİTE & BLOK ÖZET ŞERİDİ -->
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-3">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-buildings text-primary me-2"></i>Yönetilen Site &amp; Yapılar (@totalBuildings Blok • @totalUnits Bölüm • @occupiedUnits Dolu)
                    </h6>
                    <small class="text-muted">Blok detayına geçmek için blok adını seçebilirsiniz (tüm bloklar sol menüde de hazırdır).</small>
                </div>
                @{
                    var complexGroups = buildingList
                        .GroupBy(b => b.HousingComplexId.HasValue ? $"C_{b.HousingComplexId}" : $"B_{b.Id}")
                        .ToList();
                }
                @foreach (var grp in complexGroups)
                {
                    var rep = grp.First();
                    var grpUnits = grp.SelectMany(b => (b.Units ?? new List<GMK360.Core.Entities.BuildingUnit>()).Concat((b.ChildBuildings ?? new List<GMK360.Core.Entities.Building>()).SelectMany(cb => cb.Units ?? new List<GMK360.Core.Entities.BuildingUnit>()))).Where(u => !(u.Category ?? "").StartsWith("OrtakAlan")).ToList();
                    var grpDebts = grpUnits.SelectMany(u => u.Debts ?? new List<GMK360.Core.Entities.UnitDebt>()).ToList();
                    decimal grpPaid = grpDebts.Where(d => d.IsPaid).Sum(d => d.Amount);
                    decimal grpUnpaid = Math.Max(0m, grpDebts.Where(d => !d.IsPaid).Sum(d => d.Amount));
                    string grpName = rep.HousingComplex?.Name ?? rep.Name;
                    <div class="border rounded-3 p-3 bg-light mb-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div>
                                <strong class="text-dark fs-6">@grpName</strong>
                                @if (grp.Count() > 1)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">@grp.Count() Blok</span>
                                }
                                <span class="badge bg-white text-dark border ms-1">@grpUnits.Count Bölüm</span>
                                <span class="small text-muted ms-2"><i class="bi bi-geo-alt text-danger me-1"></i>@(rep.StreetName ?? rep.Address), No: @(rep.BuildingNumber ?? "-")</span>
                            </div>
                            <div class="small">
                                <span class="text-success fw-bold me-2">Toplanan: @grpPaid.ToString("N0") ₺</span>
                                <span class="text-danger fw-bold">Bekleyen: @grpUnpaid.ToString("N0") ₺</span>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var blk in grp)
                            {
                                string blkLbl = !string.IsNullOrWhiteSpace(blk.BlockName) ? blk.BlockName : blk.Name;
                                int blkUnitCount = (blk.Units ?? new List<GMK360.Core.Entities.BuildingUnit>()).Count(u => !(u.Category ?? "").StartsWith("OrtakAlan"));
                                <a href="/BuildingManager/Detail/@blk.Id" class="btn btn-sm btn-white bg-white border rounded-pill px-3 fw-semibold text-dark shadow-xs">
                                    <i class="bi bi-building text-success me-1"></i>@blkLbl <span class="text-muted">(@blkUnitCount)</span> &rarr;
                                </a>
                            }
                            <a href="/BuildingManager/Onboarding/@rep.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 ms-auto" title="Yapı & Blok Sihirbazı">
                                <i class="bi bi-sliders me-1"></i>Yapı Düzenle
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Alt Yasal Mevzuat Rehberi (Katlanabilir Özet) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mt-3">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#kmkGuideCollapse" aria-expanded="false" style="cursor: pointer;">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-bank text-primary me-2"></i> 634 Sayılı Kat Mülkiyeti Kanunu (KMK) &amp; GMSİ Mevzuat Rehberi
                </h6>
                <span class="small text-muted fw-semibold">Göster / Gizle <i class="bi bi-chevron-down ms-1"></i></span>
            </div>
            <div class="collapse mt-3" id="kmkGuideCollapse">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="p-3 rounded-3 bg-light border h-100">
                            <span class="fw-bold text-primary d-block mb-1 small"><i class="bi bi-file-earmark-ruled me-1"></i> KMK Md. 37 (İşletme Projesi)</span>
                            <small class="text-muted">Tahmini yıllık bütçe hazırlanıp kat maliklerine tebliğ edilmeden aidat icrası yapılamaz.</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded-3 bg-light border h-100">
                            <span class="fw-bold text-danger d-block mb-1 small"><i class="bi bi-percent me-1"></i> KMK Md. 20/c (Gecikme Tazminatı)</span>
                            <small class="text-muted">Gününde ödenmeyen aidat ve avans borçları için aylık <strong>%5 gecikme tazminatı</strong> işletilir.</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded-3 bg-light border h-100">
                            <span class="fw-bold text-success d-block mb-1 small"><i class="bi bi-book-half me-1"></i> KMK Md. 32 (Karar Defteri)</span>
                            <small class="text-muted">Kararlar noter tasdikli deftere yazdırılıp ıslak imzayla mühürlenir.</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded-3 bg-light border h-100">
                            <span class="fw-bold text-warning-emphasis d-block mb-1 small"><i class="bi bi-calculator me-1"></i> GVK Md. 74 (Gerçek Gider)</span>
                            <small class="text-muted">Mal sahiplerinin ağır bakım faturaları yıl sonu GMSİ beyannamesinde paylarına göre düşülür.</small>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top">
                    <small class="text-muted">Karar defteri formu doldurma, örnek karar metinleri, çoğunluk tablosu ve yasal haklar için tam el kitabını açın:</small>
                    <a href="/BuildingManager/MevzuatRehberi" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-journal-bookmark-fill me-1"></i> Yönetici El Kitabı &amp; Örnek Kararları Aç &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Apartman / Site Açılış Modalı -->
<div class="modal fade" id="startFacilityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-success text-white border-0 py-3 px-4">
                <div>
                    <h5 class="modal-title fw-bold mb-0 text-white"><i class="bi bi-building-add me-2"></i>Yeni Apartman / Site Oluştur</h5>
                    <small class="text-white-50">Önce yönetim türünü ve adını seçin, ardından tekil adres ID ve blok yapısını belirleyelim.</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form action="/BuildingManager/Onboarding" method="get">
                <div class="modal-body p-4">
                    <label class="form-label fw-bold text-dark mb-2">Yönetim Türü Seçiniz *</label>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="mode" id="modeApartman" value="Apartman" checked autocomplete="off">
                            <label class="btn btn-outline-success w-100 h-100 p-3 rounded-4 text-start d-flex flex-column justify-content-between" for="modeApartman">
                                <div>
                                    <i class="bi bi-building fs-3 d-block mb-2"></i>
                                    <div class="fw-bold">Apartman</div>
                                </div>
                                <small class="opacity-75 mt-1">Tek bağımsız bina (1 ana yapı)</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="mode" id="modeSite" value="Site" autocomplete="off">
                            <label class="btn btn-outline-success w-100 h-100 p-3 rounded-4 text-start d-flex flex-column justify-content-between" for="modeSite">
                                <div>
                                    <i class="bi bi-buildings fs-3 d-block mb-2"></i>
                                    <div class="fw-bold">Site / Çoklu Blok</div>
                                </div>
                                <small class="opacity-75 mt-1">Sınırsız blok, ortak baza &amp; sosyal alanlar</small>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark" id="modalFacilityNameLabel">Apartman / Bina Adı *</label>
                        <input type="text" name="name" id="modalFacilityNameInput" class="form-control form-control-lg rounded-3" placeholder="Örn: Aydemir Apartmanı" required />
                    </div>
                    <div class="mb-2 d-none" id="modalSiteCountWrap">
                        <label class="form-label fw-bold text-primary">Sitede Kaç Bağımsız Yapı / Blok Var? *</label>
                        <input type="number" name="count" id="modalSiteCountInput" class="form-control form-control-lg rounded-3 text-center fw-bold border-primary" min="1" max="30" value="1" />
                        <small class="text-muted">Örn: A Blok + B Blok için 2 yazın (daha sonra sihirbazda her bloğun kat ve daire sayısını ayrı girebilirsiniz).</small>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light px-4 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        Oluştur ve Adres Künyesine Geç <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var lbl = document.getElementById('modalFacilityNameLabel');
            var inp = document.getElementById('modalFacilityNameInput');
            var countWrap = document.getElementById('modalSiteCountWrap');
            var countInp = document.getElementById('modalSiteCountInput');
            document.querySelectorAll('input[name="mode"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    if (this.value === 'Site') {
                        lbl.innerText = 'Site / Yerleşke Adı *';
                        inp.placeholder = 'Örn: Çamlıca Konakları Sitesi';
                        if (countWrap) countWrap.classList.remove('d-none');
                        if (countInp && parseInt(countInp.value || '1', 10) < 2) countInp.value = '2';
                    } else {
                        lbl.innerText = 'Apartman / Bina Adı *';
                        inp.placeholder = 'Örn: Aydemir Apartmanı';
                        if (countWrap) countWrap.classList.add('d-none');
                        if (countInp) countInp.value = '1';
                    }
                });
            });
        })();
    </script>
}
