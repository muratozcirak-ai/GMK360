@model IEnumerable<GMK360.Core.Entities.Building>
@{
    ViewData["Title"] = "GMK360 - Yönetici Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-2 px-md-4 bg-light min-vh-100">
    @if (Model == null || !Model.Any())
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-center mt-5" style="min-height: 50vh;">
            <i class="ph ph-buildings text-muted opacity-25" style="font-size: 8rem;"></i>
            <h2 class="fw-bold mt-4 text-dark">Henüz Bir Binanız Yok</h2>
            <p class="text-muted w-50">Sisteme henüz bir bina veya site eklemediniz. Hemen yeni bir bina ekleyerek aidat, gelir/gider, şikayet ve toplantı yönetimine başlayın.</p>
            <a href="/BuildingManager/Onboarding" class="btn btn-primary btn-lg rounded-pill px-5 mt-3 shadow-sm">
                <i class="ph ph-plus-circle me-2"></i>İlk Binanızı Ekleyin
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-1 fw-bold text-dark">🏢 Yönettiğim Binalar</h4>
                <p class="text-muted mb-0">Toplam @Model.Count() bina yönetiyorsunuz.</p>
            </div>
            <a href="/BuildingManager/Onboarding" class="btn btn-primary rounded-pill px-4">
                <i class="ph ph-plus me-1"></i> Yeni Bina Ekle
            </a>
        </div>

        <div class="row g-4">
            @foreach (var building in Model)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-primary mb-1">@building.Name</h5>
                            <p class="text-muted small"><i class="ph ph-map-pin me-1"></i> @building.Address</p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <span class="badge bg-light text-dark border">
                                    <i class="ph ph-door"></i> @(building.Units?.Count ?? 0) Daire
                                </span>
                                <a href="/BuildingManager/Detail/@building.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    Yönetim Paneli &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
