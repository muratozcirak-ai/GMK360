@* Personel Özlük Dosyası Modalları *@
@foreach (var st in allStaffForDossiers)
{
    var sDocs = (st.Documents ?? new List<GMK360.Core.Entities.BuildingStaffDocument>())
        .Where(d => !d.IsDeleted)
        .OrderByDescending(d => d.CreatedAt)
        .ToList();
    string? sAddr = !string.IsNullOrWhiteSpace(st.Address) ? st.Address : st.User?.Address;
    <div class="modal fade" id="staffDossierModal_@st.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-dark text-white border-0">
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" style="color:#ffffff !important;">
                            <i class="bi bi-folder2-open me-2 text-warning"></i>@st.FullName — @st.RoleType (Özlük Dosyası)
                        </h5>
                        <small class="text-white-50" style="color:rgba(255,255,255,0.78) !important;">
                            @(!string.IsNullOrWhiteSpace(st.JobDescription) ? $"{st.JobDescription} | " : "")İşe Giriş: @st.HireDate.ToString("dd.MM.yyyy") | TC: @(st.TcIdentityNo ?? "-") | SGK: @(st.SgkNumber ?? "-")
                        </small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border rounded-3 small mb-3">
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <span><i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>İkametgah Adresi:</strong> @(string.IsNullOrWhiteSpace(sAddr) ? "Henüz girilmedi (personel ilk girişinde / profilinden kendisi girer)" : sAddr)</span>
                            <span><i class="bi bi-telephone-fill text-success me-1"></i>@(st.PhoneNumber ?? "-")</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="small fw-bold text-muted mb-2">İşe Giriş Özlük Evrak Kontrol Listesi (4857 / 6331 Sayılı Kanun)</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in GMK360.Core.Entities.BuildingStaffDocument.StandardCatalog.Where(c => c.IsRequired))
                            {
                                bool hasIt = sDocs.Any(d => string.Equals(d.DocumentType, item.Code, StringComparison.OrdinalIgnoreCase));
                                <span class="badge rounded-pill px-3 py-2 @(hasIt ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                    @(hasIt ? "✅" : "⚠️ Eksik:") @item.Label
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-5">
                            <form class="card border rounded-4 p-3 bg-light" asp-action="UploadBuildingStaffDocument" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="buildingId" value="@Model.Id" />
                                <input type="hidden" name="buildingStaffId" value="@st.Id" />
                                <h6 class="fw-bold mb-3"><i class="bi bi-cloud-upload me-2 text-primary"></i>Yeni Özlük Belgesi Ekle</h6>

                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Belge Türü *</label>
                                    <select name="documentType" class="form-select form-select-sm" required>
                                        @foreach (var item in GMK360.Core.Entities.BuildingStaffDocument.StandardCatalog)
                                        {
                                            <option value="@item.Code">@item.Label @(item.IsRequired ? "(Zorunlu)" : "")</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Belge Başlığı (Opsiyonel)</label>
                                    <input type="text" name="title" class="form-control form-control-sm" placeholder="Boş bırakılırsa tür adı kullanılır" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Dosya Yükle (PDF / Görsel / Word)</label>
                                    <input type="file" name="documentFile" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Fiziksel Klasör / Dolap Yeri</label>
                                    <input type="text" name="physicalArchiveLocation" class="form-control form-control-sm" placeholder="Örn: Yönetim Ofisi • Personel Klasörü #1" />
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold">Düzenleme Tarihi</label>
                                        <input type="date" name="issueDate" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold">Geçerlilik Bitiş</label>
                                        <input type="date" name="expiryDate" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Not</label>
                                    <input type="text" name="notes" class="form-control form-control-sm" placeholder="Örn: Islak imzalı aslı klasörde" />
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill fw-bold w-100">
                                    <i class="bi bi-plus-circle me-1"></i> Özlük Dosyasına Kaydet
                                </button>
                            </form>
                        </div>

                        <div class="col-lg-7">
                            <h6 class="fw-bold mb-2">Kayıtlı Özlük Belgeleri (@sDocs.Count)</h6>
                            @if (!sDocs.Any())
                            {
                                <div class="text-center py-5 text-muted small border rounded-4 bg-light">
                                    Bu personel için henüz özlük belgesi yüklenmemiş. Soldaki formdan belgeleri tarayıp veya klasör yerini yazarak ekleyebilirsiniz.
                                </div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var doc in sDocs)
                                    {
                                        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <div class="fw-bold small text-dark">
                                                    @doc.Title
                                                    @if (doc.IsExpired)
                                                    {
                                                        <span class="badge bg-danger ms-1">Süresi Dolmuş</span>
                                                    }
                                                </div>
                                                <div class="small text-muted">
                                                    Tür: @GMK360.Core.Entities.BuildingStaffDocument.GetLabel(doc.DocumentType)
                                                    @if (!string.IsNullOrWhiteSpace(doc.PhysicalArchiveLocation))
                                                    {
                                                        <span> | 📁 Aslı: <b>@doc.PhysicalArchiveLocation</b></span>
                                                    }
                                                    @if (doc.ExpiryDate.HasValue)
                                                    {
                                                        <span> | Geçerlilik: @doc.ExpiryDate.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(doc.Notes))
                                                {
                                                    <div class="small text-secondary fst-italic">@doc.Notes</div>
                                                }
                                            </div>
                                            <div class="d-flex gap-1 align-items-center">
                                                @if (!string.IsNullOrWhiteSpace(doc.FileUrl))
                                                {
                                                    <a href="@doc.FileUrl" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-2">
                                                        <i class="bi bi-file-earmark-arrow-down me-1"></i>Gör / İndir
                                                    </a>
                                                }
                                                <form asp-action="DeleteBuildingStaffDocument" asp-controller="BuildingManager" method="post" onsubmit="return confirm('Bu belge özlük dosyasından kaldırılsın mı?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@Model.Id" />
                                                    <input type="hidden" name="documentId" value="@doc.Id" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger rounded-pill px-2"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Personel Geçici Şifre / İlk Giriş Davet Modal -->
<div class="modal fade" id="staffInviteModal" tabindex="-1" aria-hidden="true">
