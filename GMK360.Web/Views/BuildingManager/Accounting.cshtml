@model GMK360.Core.Entities.Building
@{
    ViewData["Title"] = "Muhasebe, Gider Türleri, Kasa & Personel";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var bankAccounts = ViewBag.BankAccounts as List<GMK360.Core.Entities.BankAccount> ?? new List<GMK360.Core.Entities.BankAccount>();
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var buildingStaffs = ViewBag.BuildingStaffs as List<GMK360.Core.Entities.BuildingStaff> ?? new List<GMK360.Core.Entities.BuildingStaff>();
    var formerBuildingStaffs = ViewBag.FormerBuildingStaffs as List<GMK360.Core.Entities.BuildingStaff> ?? new List<GMK360.Core.Entities.BuildingStaff>();
    var allStaffForDossiers = buildingStaffs.Concat(formerBuildingStaffs).ToList();
    var monthlyPayrolls = ViewBag.MonthlyPayrolls as List<GMK360.Core.Entities.BuildingStaffMonthlyPayroll> ?? new List<GMK360.Core.Entities.BuildingStaffMonthlyPayroll>();
    var expenses = ViewBag.Expenses as List<GMK360.Core.Entities.BuildingExpense> ?? new List<GMK360.Core.Entities.BuildingExpense>();
    var fixedExpenses = ViewBag.FixedExpenses as List<GMK360.Core.Entities.BuildingFixedExpense> ?? new List<GMK360.Core.Entities.BuildingFixedExpense>();
    var taskTickets = ViewBag.TaskTickets as List<GMK360.Core.Entities.BuildingTaskTicket> ?? new List<GMK360.Core.Entities.BuildingTaskTicket>();
    var commonFixtures = ViewBag.CommonFixtures as List<GMK360.Core.Entities.SpaceFixture> ?? new List<GMK360.Core.Entities.SpaceFixture>();
    var expenseGroups = ViewBag.ExpenseGroups as List<GMK360.Core.Entities.DefinitionValue> ?? new List<GMK360.Core.Entities.DefinitionValue>();
    var decisionsForExpense = ViewBag.DecisionsForExpense as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
    var budget = ViewBag.BudgetSummary as GMK360.Web.Services.BuildingMonthlyBudgetSummary ?? new GMK360.Web.Services.BuildingMonthlyBudgetSummary();
    var holidays = ViewBag.Holidays as List<GMK360.Web.Helpers.TurkishHolidayItem> ?? new List<GMK360.Web.Helpers.TurkishHolidayItem>();

    decimal totalCollectedDues = ViewBag.TotalCollectedDues is decimal tcd ? tcd : 0m;
    decimal totalPendingDues = ViewBag.TotalPendingDues is decimal tpd ? tpd : 0m;
    string activeTab = (ViewBag.ActiveTab as string ?? "giderler").ToLowerInvariant();
    string? selectedGroup = ViewBag.SelectedExpenseGroup as string;
    bool isSiteScope = ViewBag.IsSiteScope is bool iss && iss;
    int scopeBuildingCount = ViewBag.ScopeBuildingCount is int sbc ? sbc : 1;
    string siteTitleLabel = ViewBag.SiteTitleLabel as string ?? (Model.HousingComplex?.Name ?? Model.Name ?? "Site Geneli");

    var activeExpenses = expenses.Where(e => !e.IsArchived && e.ReversalOfExpenseId == null).ToList();
    decimal totalOperational = activeExpenses.Where(e => e.ExpenseType != GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure).Sum(e => e.TotalAmount);
    decimal totalCapital = activeExpenses.Where(e => e.ExpenseType == GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure).Sum(e => e.TotalAmount);
    decimal totalRecordedExpenses = totalOperational + totalCapital;
    decimal totalBankBalance = bankAccounts.Sum(a => a.CurrentBalance);
    decimal netCashSummary = totalCollectedDues - totalRecordedExpenses;

    var filteredExpenses = string.IsNullOrWhiteSpace(selectedGroup)
        ? expenses
        : expenses.Where(e => string.Equals(e.ExpenseGroup, selectedGroup, StringComparison.OrdinalIgnoreCase)).ToList();

    var filteredFixed = string.IsNullOrWhiteSpace(selectedGroup)
        ? fixedExpenses
        : fixedExpenses.Where(f => string.Equals(f.ExpenseGroup, selectedGroup, StringComparison.OrdinalIgnoreCase)).ToList();

    bool allSgkClear = monthlyPayrolls.Any() && monthlyPayrolls.All(p => p.IsSgkPaid);
    int pendingSgkCount = monthlyPayrolls.Count(p => !p.IsSgkPaid);

    string GetGroupDisplayName(string? code) =>
        expenseGroups.FirstOrDefault(g => string.Equals(g.SystemCode, code, StringComparison.OrdinalIgnoreCase))?.Name ?? (code ?? "Diğer");
}

<div class="container-fluid py-3 px-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-wallet2 text-success me-2"></i>Muhasebe, Gider Türleri &amp; Kasa</h2>
            <p class="text-muted small mb-0">
                @if (isSiteScope)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle me-1">🌐 Site Geneli (Ortak Kasa · @scopeBuildingCount Blok)</span>
                    <span>@siteTitleLabel — tüm ortak giderler, blok özel faturaları, kasa özeti ve personel puantajı</span>
                }
                else
                {
                    <span>@Model.Name — 5 dinamik gider türü (Enerji/Fatura, Temizlik/Personel, Asansör/Bakım, Demirbaş, İdari), kasa ve puantaj</span>
                }
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (buildings.Count > 1)
            {
                <form method="get" class="d-flex">
                    <input type="hidden" name="tab" value="@activeTab" />
                    <select name="buildingId" class="form-select form-select-sm fw-semibold" onchange="this.form.submit()">
                        @if (isSiteScope)
                        {
                            <option value="" selected>🌐 Site Geneli (Tüm Bloklar · @buildings.Count)</option>
                        }
                        else
                        {
                            <option value="">🌐 Site Geneli (Tüm Bloklar · @buildings.Count)</option>
                        }
                        @foreach (var b in buildings)
                        {
                            var bOptLabel = !string.IsNullOrWhiteSpace(b.BlockName) ? b.BlockName : b.Name;
                            if (!isSiteScope && b.Id == Model.Id)
                            {
                                <option value="@b.Id" selected>🏢 @bOptLabel (Tek Blok)</option>
                            }
                            else
                            {
                                <option value="@b.Id">🏢 @bOptLabel (Tek Blok)</option>
                            }
                        }
                    </select>
                </form>
            }
            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#newExpenseDirectModal">
                <i class="bi bi-receipt-cutoff me-1"></i> + Fatura / Ödeme Gir
            </button>
            <button type="button" class="btn btn-outline-dark rounded-pill px-3 fw-semibold" onclick="window.print()" title="Hesap Özeti Yazdır">
                <i class="bi bi-printer me-1"></i> Yazdır
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["StaffActivationLink"] != null)
    {
        var actLink = TempData["StaffActivationLink"]?.ToString() ?? "";
        var tempPw = TempData["StaffTempPassword"]?.ToString() ?? "";
        var invName = TempData["StaffInviteName"]?.ToString() ?? "Personel";
        var invEmail = TempData["StaffInviteEmail"]?.ToString() ?? "";
        var invPhone = TempData["StaffInvitePhone"]?.ToString() ?? "";
        var waMsg = Uri.EscapeDataString($"Merhaba {invName}, GMK360 personel hesabınız açıldı. Kurulum ve ilk giriş için: {actLink}" + (!string.IsNullOrWhiteSpace(tempPw) ? $" | Geçici Şifreniz: {tempPw}" : ""));
        <div class="alert alert-info alert-dismissible fade show rounded-4 border border-info-subtle shadow-sm mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                    <h6 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>@invName — İlk Giriş Daveti &amp; Geçici Şifre Hazır</h6>
                    <p class="small mb-2">Personel ilk giriş yaptığında kalıcı şifresini, yalnızca kendisinin bileceği 4-6 haneli PIN'ini ve adresini belirleyecektir.</p>
                    <div class="d-flex flex-wrap gap-2 align-items-center small">
                        @if (!string.IsNullOrWhiteSpace(invEmail))
                        {
                            <span class="badge bg-white text-dark border">Giriş (E-Posta): <b>@invEmail</b></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(invPhone))
                        {
                            <span class="badge bg-white text-dark border">Telefon: <b>@invPhone</b></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(tempPw))
                        {
                            <span class="badge bg-warning text-dark border">Geçici Şifre: <code id="staffTempPwCode" class="fw-bold text-dark">@tempPw</code></span>
                            <button type="button" class="btn btn-xs btn-outline-dark rounded-pill" onclick="copyTextValue('@tempPw', this)">Şifreyi Kopyala</button>
                        }
                        <button type="button" class="btn btn-xs btn-primary rounded-pill" onclick="copyTextValue('@actLink', this)">Aktivasyon Linkini Kopyala</button>
                        <a href="https://wa.me/?text=@waMsg" target="_blank" class="btn btn-xs btn-success rounded-pill"><i class="bi bi-whatsapp me-1"></i>WhatsApp ile İlet</a>
                    </div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KASA, TAHAKKUK & BÜTÇE ÖZET KARTLARI -->
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success h-100">
                <span class="text-muted small fw-bold text-uppercase">Toplanan Aidat (Gelir +)</span>
                <h3 class="fw-bold text-success mb-1">@totalCollectedDues.ToString("N2") ₺</h3>
                <small class="text-muted">Bekleyen aidat alacağı: @totalPendingDues.ToString("N2") ₺</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-danger h-100">
                <span class="text-muted small fw-bold text-uppercase">Yapılan Ödemeler (Gider -)</span>
                <h3 class="fw-bold text-danger mb-1">@totalRecordedExpenses.ToString("N2") ₺</h3>
                <small class="text-muted">İşletme: @totalOperational.ToString("N0") ₺ | Demirbaş: @totalCapital.ToString("N0") ₺</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary h-100">
                <span class="text-muted small fw-bold text-uppercase">Kasada Kalan Net Para</span>
                <h3 class="fw-bold @(netCashSummary >= 0 ? "text-primary" : "text-warning-emphasis") mb-1">@netCashSummary.ToString("N2") ₺</h3>
                <small class="text-muted">Banka hesapları toplamı: @totalBankBalance.ToString("N2") ₺</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 @(allSgkClear ? "border-success" : "border-warning") h-100">
                <span class="text-muted small fw-bold text-uppercase">Min. Aidat &amp; SGK Denetimi</span>
                <h3 class="fw-bold text-dark mb-1">@budget.EstimatedMinOperatingDuesPerUnit.ToString("N2") ₺</h3>
                @if (!monthlyPayrolls.Any())
                {
                    <small class="text-muted">@budget.ActiveUnitCount bölüm • Personel bordrosu bekliyor</small>
                }
                else if (allSgkClear)
                {
                    <small class="text-success fw-semibold"><i class="bi bi-shield-check me-1"></i>SGK Borcu Yoktur</small>
                }
                else
                {
                    <small class="text-warning-emphasis fw-semibold">@pendingSgkCount dönem SGK bekliyor</small>
                }
            </div>
        </div>
    </div>

    <!-- 5 ANA GİDER TÜRÜ HIZLI FİLTRE KARTLARI -->
    <div class="row g-2 mb-3">
        @foreach (var grp in expenseGroups)
        {
            decimal grpTotal = activeExpenses
                .Where(e => string.Equals(e.ExpenseGroup, grp.SystemCode, StringComparison.OrdinalIgnoreCase))
                .Sum(e => e.TotalAmount);
            bool isSelected = string.Equals(selectedGroup, grp.SystemCode, StringComparison.OrdinalIgnoreCase);
            <div class="col-lg col-md-4 col-6">
                <a href="@Url.Action("Accounting", new { buildingId = isSiteScope ? (int?)null : Model.Id, scope = isSiteScope ? "site" : null, tab = "faturalar", expenseGroup = isSelected ? null : grp.SystemCode })"
                   class="card text-decoration-none border-0 shadow-sm rounded-4 p-3 h-100 @(isSelected ? "bg-primary text-white" : "bg-white text-dark")"
                   title="Bu gider türüne göre faturaları filtrelemek için tıklayın">
                    <div class="small fw-bold text-truncate @(isSelected ? "text-white-50" : "text-muted")">@grp.Name</div>
                    <div class="fs-5 fw-bold mt-1">@grpTotal.ToString("N2") ₺</div>
                </a>
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(selectedGroup))
    {
        <div class="mb-3 d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-pill px-3 py-2">Aktif Filtre: @GetGroupDisplayName(selectedGroup)</span>
            <a href="@Url.Action("Accounting", new { buildingId = isSiteScope ? (int?)null : Model.Id, scope = isSiteScope ? "site" : null, tab = "faturalar" })"
               class="btn btn-sm btn-outline-secondary rounded-pill">✕ Filtreyi Temizle</a>
        </div>
    }

    <!-- 4 TEMİZ İŞ SEKMESİ -->
    <ul class="nav nav-pills gap-2 mb-3 bg-white p-2 rounded-4 shadow-sm" id="accountingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold rounded-pill px-4 @(activeTab == "faturalar" ? "active" : "")"
                    id="tabFaturalarBtn" data-bs-toggle="tab" data-bs-target="#tabFaturalar" type="button" role="tab">
                <i class="bi bi-receipt me-1"></i> 1. Ödenen Faturalar (@expenses.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold rounded-pill px-4 @(activeTab == "abonelikler" ? "active" : "")"
                    id="tabAboneliklerBtn" data-bs-toggle="tab" data-bs-target="#tabAbonelikler" type="button" role="tab">
                <i class="bi bi-calendar2-check me-1"></i> 2. Sabit Abonelikler (@fixedExpenses.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold rounded-pill px-4 @(activeTab == "personel" ? "active" : "")"
                    id="tabPersonelBtn" data-bs-toggle="tab" data-bs-target="#tabPersonel" type="button" role="tab">
                <i class="bi bi-people me-1"></i> 3. Personel &amp; Puantaj (@buildingStaffs.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold rounded-pill px-4 @(activeTab == "kasa" ? "active" : "")"
                    id="tabKasaBtn" data-bs-toggle="tab" data-bs-target="#tabKasa" type="button" role="tab">
                <i class="bi bi-bank me-1"></i> 4. Banka, Kasa &amp; Özet (@bankAccounts.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- SEKME 1: ÖDENEN FATURALAR & GİDER DEFTERİ -->
        <div class="tab-pane fade @(activeTab == "faturalar" ? "show active" : "")" id="tabFaturalar" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-text text-danger me-2"></i>Ödenen Faturalar, İş &amp; Arıza Gider Defteri</h5>
                        <small class="text-muted">Her fatura bağlı olduğu abonelik/arıza işi ve ıslak imzalı asıl klasör yeriyle saklanır (hatalı girişte Ters Kayıt açılır).</small>
                    </div>
                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#newExpenseDirectModal">
                        <i class="bi bi-plus-circle me-1"></i> + Fatura / Ödeme Gir
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Tarih</th>
                                    <th>Gider Türü</th>
                                    <th>Açıklama &amp; Bağlı İş</th>
                                    <th>Yasal Sorumlu (KMK)</th>
                                    <th>Tutar</th>
                                    <th>Belge &amp; Asıl Arşiv Yeri</th>
                                    <th class="pe-3 text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!filteredExpenses.Any())
                                {
                                    <tr><td colspan="7" class="text-center py-5 text-muted">Bu filtrede gerçekleşen fatura veya ödeme kaydı yok. Sağ üstteki <strong>+ Fatura / Ödeme Gir</strong> butonundan ekleyebilirsiniz.</td></tr>
                                }
                                else
                                {
                                    foreach (var exp in filteredExpenses)
                                    {
                                        bool isCapital = exp.ExpenseType == GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure
                                            || string.Equals(exp.PayerType, "Owner", StringComparison.OrdinalIgnoreCase);
                                        bool isReversal = exp.ReversalOfExpenseId != null || exp.TotalAmount < 0;
                                        <tr class="@(exp.IsArchived ? "table-secondary opacity-75" : "")">
                                            <td class="ps-3 small">@exp.Date.ToString("dd.MM.yyyy")</td>
                                            <td><span class="badge bg-light text-dark border">@GetGroupDisplayName(exp.ExpenseGroup)</span></td>
                                            <td>
                                                <strong>@exp.Description</strong>
                                                <div class="small mt-1 d-flex flex-wrap gap-1 align-items-center">
                                                    @if (exp.LinkedDecisionMeetingId.HasValue)
                                                    {
                                                        <a href="/BuildingManager/PrintDecisionSheet?meetingId=@exp.LinkedDecisionMeetingId.Value" target="_blank"
                                                           class="badge bg-success-subtle text-success border border-success-subtle text-decoration-none" title="Dayanak Karar Defteri Sayfasını Aç">
                                                            <i class="bi bi-journal-check me-1"></i>@(string.IsNullOrWhiteSpace(exp.LinkedSourceLabel) ? $"Karar Defteri #{exp.LinkedDecisionMeetingId}" : exp.LinkedSourceLabel)
                                                        </a>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(exp.LinkedSourceLabel))
                                                    {
                                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                            <i class="bi bi-link-45deg me-1"></i>@exp.LinkedSourceLabel
                                                        </span>
                                                    }
                                                </div>
                                                <div class="small text-muted d-flex flex-wrap align-items-center gap-1 mt-1">
                                                    @if (exp.ScopeType == GMK360.Core.Entities.ExpenseScopeType.HousingComplex)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">🌐 Site Ortak</span>
                                                    }
                                                    else if (buildings.Count > 1)
                                                    {
                                                        <span class="badge bg-light text-dark border">🏢 @(exp.Building?.BlockName ?? exp.Building?.Name ?? Model.Name)</span>
                                                    }
                                                </div>
                                                @if (isReversal) { <span class="badge bg-dark">TERS KAYIT</span> }
                                                else if (exp.IsArchived) { <span class="badge bg-secondary">İPTAL (ARŞİV)</span> }
                                            </td>
                                            <td>
                                                @if (isCapital || exp.OwnerSplitPercent >= 100m)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">🏠 Mal Sahibi (Demirbaş / Karar)</span>
                                                }
                                                else if (exp.OwnerSplitPercent.HasValue && exp.OwnerSplitPercent.Value > 0m)
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning">⚖️ %@exp.OwnerSplitPercent.Value.ToString("0.##") Malik / %@((100m - exp.OwnerSplitPercent.Value).ToString("0.##")) Kiracı</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">🔑 Kiracı / Oturan (İşletme)</span>
                                                }
                                            </td>
                                            <td><strong class="@(exp.TotalAmount < 0 ? "text-danger" : "text-dark")">@exp.TotalAmount.ToString("N2") ₺</strong></td>
                                            <td class="small">
                                                @if (!string.IsNullOrWhiteSpace(exp.InvoiceDocumentUrl))
                                                {
                                                    <a href="@exp.InvoiceDocumentUrl" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2 mb-1"><i class="bi bi-paperclip"></i> Fatura Gör</a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(exp.PhysicalArchiveLocation))
                                                {
                                                    <div class="text-muted"><i class="bi bi-folder2-open me-1 text-warning-emphasis"></i>@exp.PhysicalArchiveLocation</div>
                                                }
                                                @if (string.IsNullOrWhiteSpace(exp.InvoiceDocumentUrl) && string.IsNullOrWhiteSpace(exp.PhysicalArchiveLocation))
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="pe-3 text-end">
                                                @if (!exp.IsArchived && !isReversal && exp.BuildingId.HasValue)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                                            onclick="openGiderReversalModal(@exp.Id, @exp.BuildingId.Value, '@System.Web.HttpUtility.JavaScriptStringEncode(exp.Description)')">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Ters Kayıt
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SEKME 2: DÜZENLİ ABONELİKLER & SÖZLEŞMELER -->
        <div class="tab-pane fade @(activeTab == "abonelikler" ? "show active" : "")" id="tabAbonelikler" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar2-week text-success me-2"></i>Düzenli Abonelikler &amp; Sabit Ödeme Kurumları</h5>
                        <small class="text-muted">Elektrik, su, doğalgaz, asansör bakım veya yönetim sözleşmelerini burada tutun; fatura geldikçe tek tıkla işleyin.</small>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/BuildingManager/Aidatlar@(isSiteScope ? "" : $"?buildingId={Model.Id}")#annualBudgetWizard" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                            <i class="bi bi-calculator me-1"></i> Yıllık Bütçe &amp; Aidat Masası
                        </a>
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addFixedExpenseModal">
                            <i class="bi bi-plus-circle me-1"></i> + Sabit Abonelik Ekle
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Periyot &amp; Gün</th>
                                    <th>Gider Türü</th>
                                    <th>Kurum / Abonelik</th>
                                    <th>Sözleşme &amp; Fiziksel Arşiv</th>
                                    <th>Tutar Şekli</th>
                                    <th class="pe-3 text-end">Fatura / Ödeme</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!filteredFixed.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted small">
                                            Henüz abone veya sözleşme eklenmemiş. Sağ üstten <strong>+ Sabit Abonelik Ekle</strong> ile Enerjisa, İSKİ, Doğalgaz, Asansör Bakım veya Sigorta ekleyin.
                                        </td>
                                    </tr>
                                }
                                @foreach (var fx in filteredFixed)
                                {
                                    bool isDemirbas = fx.ExpenseScope == "Demirbas";
                                    bool isVariable = fx.MonthlyAmount <= 0m;
                                    string cycleLabel = fx.BillingCycleMonths switch
                                    {
                                        12 => "Yıllık (Yılda 1)",
                                        6 => "6 Aylık",
                                        3 => "3 Aylık",
                                        _ => "Aylık"
                                    };
                                    bool contractExpiring = fx.ContractEndDate.HasValue && fx.ContractEndDate.Value.Date <= DateTime.Today.AddDays(30);
                                    <tr>
                                        <td class="ps-3 small">
                                            <span class="badge @(fx.BillingCycleMonths == 12 ? "bg-purple text-white" : "bg-light text-dark border")" style="@(fx.BillingCycleMonths == 12 ? "background-color:#6f42c1;" : "")">@cycleLabel</span>
                                            <div class="fw-bold mt-1">@(fx.BillingCycleMonths > 1 && fx.BillingMonth.HasValue ? $"{fx.BillingMonth}. Ay • " : "")@fx.DueDayOfMonth. Gün</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@GetGroupDisplayName(fx.ExpenseGroup)</span></td>
                                        <td>
                                            <strong>@fx.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(fx.ProviderName))
                                            {
                                                <small class="d-block text-muted">@fx.ProviderName @(!string.IsNullOrWhiteSpace(fx.SubscriberNo) ? $"(No: {fx.SubscriberNo})" : "")</small>
                                            }
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @if (fx.ScopeType == GMK360.Core.Entities.ExpenseScopeType.HousingComplex)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">🌐 Site Ortak</span>
                                                }
                                                else if (buildings.Count > 1)
                                                {
                                                    <span class="badge bg-light text-dark border">🏢 @(fx.Building?.BlockName ?? fx.Building?.Name ?? Model.Name)</span>
                                                }
                                                @if (isDemirbas || fx.OwnerSplitPercent >= 100m)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">🏠 Mal Sahibi (Demirbaş)</span>
                                                }
                                                else if (fx.OwnerSplitPercent.HasValue && fx.OwnerSplitPercent.Value > 0m)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis">⚖️ %@fx.OwnerSplitPercent.Value.ToString("0.##") Malik / %@((100m - fx.OwnerSplitPercent.Value).ToString("0.##")) Kiracı</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary">🔑 Kiracı / Oturan (İşletme)</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="small">
                                            @if (!string.IsNullOrWhiteSpace(fx.ContractDocumentUrl))
                                            {
                                                <a href="@fx.ContractDocumentUrl" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2 py-0 mb-1">
                                                    <i class="bi bi-file-earmark-text me-1"></i>Sözleşme
                                                </a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(fx.PhysicalArchiveLocation))
                                            {
                                                <div class="text-muted"><i class="bi bi-folder2 me-1"></i>@fx.PhysicalArchiveLocation</div>
                                            }
                                            @if (fx.ContractEndDate.HasValue)
                                            {
                                                <div class="@(contractExpiring ? "text-danger fw-bold" : "text-muted")">
                                                    Bitiş: @fx.ContractEndDate.Value.ToString("dd.MM.yyyy")
                                                </div>
                                            }
                                            @if (string.IsNullOrWhiteSpace(fx.ContractDocumentUrl) && string.IsNullOrWhiteSpace(fx.PhysicalArchiveLocation) && !fx.ContractEndDate.HasValue)
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isVariable)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Değişken Fatura</span>
                                            }
                                            else
                                            {
                                                <strong class="text-dark">@fx.MonthlyAmount.ToString("N2") ₺</strong>
                                                <small class="d-block text-muted">@(fx.BillingCycleMonths == 12 ? "/ yıl" : (fx.BillingCycleMonths > 1 ? $"/ {fx.BillingCycleMonths} ay" : "/ ay"))</small>
                                            }
                                        </td>
                                        <td class="pe-3 text-end">
                                            <button type="button" class="btn btn-sm @(isVariable ? "btn-primary" : "btn-outline-danger") rounded-pill px-3 fw-semibold"
                                                    onclick="openInvoiceFromSubscription(@fx.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(fx.Title)', '@System.Web.HttpUtility.JavaScriptStringEncode(fx.ProviderName ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(fx.ExpenseGroup)', '@(isDemirbas ? "1" : "2")', @fx.MonthlyAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture), @((int)fx.ScopeType), @fx.BuildingId, '@System.Web.HttpUtility.JavaScriptStringEncode(fx.ExpenseItemKey ?? "Genel")')">
                                                <i class="bi bi-receipt me-1"></i> + Fatura / Ödeme İşle
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SEKME 2: PERSONEL, SGK & PUANTAJ -->
        <div class="tab-pane fade @(activeTab == "personel" ? "show active" : "")" id="tabPersonel" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill text-success me-2"></i>Bina / Site Sabit Personel Kadrosu (@buildingStaffs.Count)</h5>
                        <small class="text-muted">Net Maaş + SGK İşveren + Vergi İşletme Kasasına; Aylık Kıdem Fonu Malik Kasasına ayrılır.</small>
                    </div>
                    <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addBuildingStaffModal">
                        <i class="bi bi-person-plus me-1"></i> + Kadro Personeli Ekle
                    </button>
                </div>
                <div class="card-body p-3">
                    @if (!buildingStaffs.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            Henüz tam bordrolu kadro personeli eklenmemiş. Sağ üstten <strong>+ Kadro Personeli Ekle</strong> ile Kapıcı (Vergi İstisnalı), Güvenlik, Temizlik veya Bahçıvan ekleyebilirsiniz.
                        </div>
                    }
                    else
                    {
                        foreach (var st in buildingStaffs)
                        {
                            int usedLeaveDays = (st.Leaves ?? new List<GMK360.Core.Entities.BuildingStaffLeave>())
                                .Where(l => l.LeaveYear == DateTime.Today.Year && l.LeaveType == "YillikIzin" && !l.IsDeleted)
                                .Sum(l => l.TotalDays);
                            int remainLeave = Math.Max(0, st.AnnualLeaveEntitlementDays - usedLeaveDays);
                            decimal dailyRate = st.NetSalary > 0 ? Math.Round(st.NetSalary / 30m, 2) : 0m;
                            bool hasSelfPin = !string.IsNullOrEmpty(st.QuickPinHash) || (st.User?.IsTransactionPinSet ?? false);
                            bool mustChangePwd = st.User == null || st.User.MustChangePassword;
                            string? displayAddress = !string.IsNullOrWhiteSpace(st.Address) ? st.Address : st.User?.Address;
                            string? displayEmail = !string.IsNullOrWhiteSpace(st.Email)
                                ? st.Email
                                : (st.User?.Email != null && !st.User.Email.EndsWith("@gmk360.local", StringComparison.OrdinalIgnoreCase) ? st.User.Email : null);
                            var staffDocs = (st.Documents ?? new List<GMK360.Core.Entities.BuildingStaffDocument>())
                                .Where(d => !d.IsDeleted)
                                .OrderByDescending(d => d.CreatedAt)
                                .ToList();
                            var requiredDocItems = GMK360.Core.Entities.BuildingStaffDocument.StandardCatalog.Where(c => c.IsRequired).ToList();
                            int requiredDoneCount = requiredDocItems.Count(rc => staffDocs.Any(d => string.Equals(d.DocumentType, rc.Code, StringComparison.OrdinalIgnoreCase)));

                            string? actTokenUrl = !string.IsNullOrWhiteSpace(st.User?.ActivationToken)
                                ? Url.Action("ActivateResident", "Account", new { token = st.User.ActivationToken }, Context.Request.Scheme)
                                : null;

                            <div class="border rounded-4 p-3 mb-3 bg-light">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        @{
                                            string stScopeBadge = st.IsSiteWide && (st.HousingComplex != null || st.Building?.HousingComplex != null)
                                                ? $"🌐 {(st.HousingComplex?.Name ?? st.Building?.HousingComplex?.Name)} (Site Geneli)"
                                                : $"🏢 {(!string.IsNullOrWhiteSpace(st.Building?.BlockName) ? st.Building.BlockName : st.Building?.Name)}";
                                        }
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@stScopeBadge</span>
                                        <span class="badge bg-dark me-1">@st.RoleType</span>
                                        <strong class="fs-5 text-dark">@st.FullName</strong>
                                        @if (!string.IsNullOrWhiteSpace(st.JobDescription))
                                        {
                                            <span class="badge bg-info-subtle text-dark border border-info-subtle ms-1"><i class="bi bi-briefcase me-1"></i>@st.JobDescription</span>
                                        }
                                        @if (hasSelfPin && !mustChangePwd)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle ms-1"><i class="bi bi-shield-check me-1"></i>Şifre &amp; Gizli PIN Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1"><i class="bi bi-hourglass-split me-1"></i>İlk Giriş / PIN Bekleniyor</span>
                                            @if (!string.IsNullOrEmpty(actTokenUrl))
                                            {
                                                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill ms-1" onclick="copyTextValue('@actTokenUrl', this)">
                                                    <i class="bi bi-link-45deg me-1"></i>İlk Giriş Linkini Kopyala
                                                </button>
                                            }
                                        }
                                        <span class="badge @(requiredDoneCount >= requiredDocItems.Count ? "bg-success" : "bg-secondary") ms-1">
                                            📁 Özlük: @requiredDoneCount/@requiredDocItems.Count Zorunlu
                                        </span>
                                        <div class="small text-muted mt-1">
                                            İşe Giriş: <b>@st.HireDate.ToString("dd.MM.yyyy")</b> |
                                            SGK Sicil: <b>@(st.SgkNumber ?? "-")</b> |
                                            Tel: <b>@(st.PhoneNumber ?? "-")</b> |
                                            E-Posta: <b>@(displayEmail ?? "-")</b> |
                                            Günlük Yevmiye: <b>@dailyRate.ToString("N2") ₺</b>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-geo-alt me-1"></i>İkametgah / Adres:
                                            @if (!string.IsNullOrWhiteSpace(displayAddress))
                                            {
                                                <b class="text-dark">@displayAddress</b>
                                            }
                                            else
                                            {
                                                <span class="text-warning-emphasis">İlk girişte / profilinden personel tarafından doldurulacak</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1">
                                        <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold"
                                                data-bs-toggle="modal" data-bs-target="#staffDossierModal_@st.Id">
                                            <i class="bi bi-folder2-open me-1"></i> Özlük Dosyası (@staffDocs.Count)
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary text-dark rounded-pill px-3 fw-semibold"
                                                onclick="openEditStaffModal(this)"
                                                data-id="@st.Id"
                                                data-fullname="@st.FullName"
                                                data-roletype="@st.RoleType"
                                                data-jobdesc="@st.JobDescription"
                                                data-tc="@st.TcIdentityNo"
                                                data-sgk="@st.SgkNumber"
                                                data-sitewide="@(st.IsSiteWide ? "true" : "false")"
                                                data-phone="@st.PhoneNumber"
                                                data-email="@displayEmail"
                                                data-address="@displayAddress"
                                                data-hiredate="@st.HireDate.ToString("yyyy-MM-dd")"
                                                data-net="@st.NetSalary.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-sgkamt="@st.SgkEmployerShare.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-tax="@st.IncomeAndStampTax.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-fringe="@st.FringeBenefits.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-sev="@st.MonthlySeveranceFund.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <i class="bi bi-pencil me-1"></i> Düzenle
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info text-dark rounded-pill px-3 fw-semibold"
                                                onclick="openStaffInviteModal(@st.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(st.FullName)', '@System.Web.HttpUtility.JavaScriptStringEncode(displayEmail ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(st.PhoneNumber ?? "")')">
                                            <i class="bi bi-key me-1"></i> @(hasSelfPin && !mustChangePwd ? "Davet Yenile" : "Geçici Şifre / Davet")
                                        </button>
                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold"
                                                onclick="openPayrollModal(@st.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(st.FullName)', @dailyRate.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                            <i class="bi bi-calculator me-1"></i> Puantaj &amp; Bayram Hesapla
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold"
                                                onclick="openLeaveModal(@st.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(st.FullName)')">
                                            <i class="bi bi-calendar-range me-1"></i> İzin Planla (@remainLeave/@st.AnnualLeaveEntitlementDays gün)
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold"
                                                onclick="openRemoveStaffModal(@st.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(st.FullName)')">
                                            <i class="bi bi-person-dash me-1"></i> Çıkart
                                        </button>
                                    </div>
                                </div>
                                <div class="row g-2 small mt-1">
                                    <div class="col-md-3">
                                        <div class="bg-white p-2 rounded border">
                                            <span class="text-muted d-block">Net Maaş + Yol/Yemek</span>
                                            <strong class="text-dark">@((st.NetSalary + st.FringeBenefits).ToString("N2")) ₺</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="bg-white p-2 rounded border">
                                            <span class="text-muted d-block">SGK İşveren + Vergi</span>
                                            <strong class="text-primary">@((st.SgkEmployerShare + st.IncomeAndStampTax).ToString("N2")) ₺</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="bg-white p-2 rounded border">
                                            <span class="text-muted d-block">Aylık İşletme Maliyeti</span>
                                            <strong class="text-success">@st.TotalMonthlyOperatingCost.ToString("N2") ₺</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="bg-white p-2 rounded border border-danger-subtle">
                                            <span class="text-danger d-block">Kıdem Fonu (Malik)</span>
                                            <strong class="text-danger">@st.MonthlySeveranceFund.ToString("N2") ₺/ay</strong>
                                        </div>
                                    </div>
                                </div>
                                @if (st.Leaves != null && st.Leaves.Any(l => !l.IsDeleted))
                                {
                                    <div class="mt-2 small text-muted">
                                        <strong>İzinler:</strong>
                                        @foreach (var lv in st.Leaves.Where(l => !l.IsDeleted).OrderByDescending(l => l.StartDate).Take(3))
                                        {
                                            <span class="badge bg-white text-dark border me-1">
                                                @lv.LeaveType (@lv.StartDate:dd.MM - @lv.EndDate:dd.MM • @lv.TotalDays gün@(lv.ReplacementCost > 0 ? $" • İkame: {lv.ReplacementCost:N0}₺" : ""))
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (formerBuildingStaffs.Any())
                    {
                        <div class="mt-3 pt-2 border-top">
                            <button class="btn btn-xs btn-outline-secondary rounded-pill px-3 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#formerStaffArchiveBox">
                                <i class="bi bi-archive me-1"></i> Ayrılan / Eski Personeller &amp; Yasal Özlük Arşivi (@formerBuildingStaffs.Count)
                            </button>
                            <div class="collapse mt-2" id="formerStaffArchiveBox">
                                @foreach (var fst in formerBuildingStaffs)
                                {
                                    int fDocsCount = (fst.Documents ?? new List<GMK360.Core.Entities.BuildingStaffDocument>()).Count(d => !d.IsDeleted);
                                    <div class="border rounded-3 p-2 px-3 mb-2 bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                                        <div>
                                            <span class="badge bg-secondary me-1">Ayrıldı (@(fst.LeaveDate?.ToString("dd.MM.yyyy") ?? "-"))</span>
                                            <strong class="text-dark">@fst.FullName</strong>
                                            <span class="text-muted">(@fst.RoleType@(string.IsNullOrWhiteSpace(fst.TerminationReason) ? "" : $" • {fst.TerminationReason}"))</span>
                                        </div>
                                        <button type="button" class="btn btn-xs btn-outline-dark rounded-pill px-2" data-bs-toggle="modal" data-bs-target="#staffDossierModal_@fst.Id">
                                            <i class="bi bi-folder2-open me-1"></i> Özlük Arşivi (@fDocsCount)
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-header bg-white border-bottom p-3 fw-bold text-dark">
                    <i class="bi bi-calendar2-check text-primary me-2"></i>Aylık Puantaj, Bayram Mesaisi &amp; Maaş / SGK Ödeme Eşleşmesi
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Dönem</th>
                                    <th>Personel</th>
                                    <th>Bayram (+1 Yevmiye) &amp; Kesinti</th>
                                    <th>Personele Net / Toplam Site Yükü</th>
                                    <th>Kıdem Fonu</th>
                                    <th>Maaş &amp; SGK Durumu</th>
                                    <th class="pe-3 text-end">Öde &amp; Dağıt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!monthlyPayrolls.Any())
                                {
                                    <tr><td colspan="7" class="text-center py-4 text-muted small">Henüz puantaj oluşturulmadı. Personel kartından <strong>Puantaj &amp; Bayram Hesapla</strong> butonuna basın.</td></tr>
                                }
                                @foreach (var pr in monthlyPayrolls)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@pr.Year-@pr.Month.ToString("00")</td>
                                        <td>
                                            <div class="fw-bold text-dark">@pr.Staff?.FullName</div>
                                            <small class="text-muted">Yevmiye: @pr.DailyWageRate.ToString("N2") ₺/gün</small>
                                        </td>
                                        <td class="small">
                                            @if (pr.HolidayDaysWorked > 0)
                                            {
                                                <div class="text-success fw-semibold">+@pr.HolidayDaysWorked.ToString("0.#") gün bayram (+@pr.HolidayExtraPay.ToString("N2") ₺)</div>
                                            }
                                            @if (pr.UnpaidLeaveDays > 0)
                                            {
                                                <div class="text-danger">-@pr.UnpaidLeaveDays gün ücretsiz izin (-@pr.UnpaidLeaveDeduction.ToString("N2") ₺)</div>
                                            }
                                            @if (pr.ReplacementStaffCost > 0)
                                            {
                                                <div class="text-warning-emphasis">İkame maliyeti: +@pr.ReplacementStaffCost.ToString("N2") ₺</div>
                                            }
                                            @if (pr.HolidayDaysWorked == 0 && pr.UnpaidLeaveDays == 0 && pr.ReplacementStaffCost == 0)
                                            {
                                                <span class="text-muted">Tam normal çalışma</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@pr.NetPayableToStaff.ToString("N2") ₺ <small class="text-muted">(Net)</small></div>
                                            <small class="text-primary fw-semibold">Site Toplam: @pr.TotalSiteCostForMonth.ToString("N2") ₺</small>
                                        </td>
                                        <td class="fw-bold text-danger">@pr.MonthlySeveranceFund.ToString("N2") ₺</td>
                                        <td>
                                            <div>
                                                <span class="badge @(pr.IsSalaryPaid ? "bg-success" : "bg-warning text-dark")">
                                                    Maaş: @(pr.IsSalaryPaid ? "Ödendi" : "Bekliyor")
                                                </span>
                                            </div>
                                            <div class="mt-1">
                                                <span class="badge @(pr.IsSgkPaid ? "bg-success" : "bg-danger")">
                                                    SGK: @(pr.IsSgkPaid ? "Ödendi" : "Bekliyor")
                                                </span>
                                            </div>
                                        </td>
                                        <td class="pe-3 text-end">
                                            @if (!pr.IsSalaryPaid || !pr.IsSgkPaid || !pr.OperatingExpenseId.HasValue)
                                            {
                                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3"
                                                        onclick="openPayMonthlyPayrollModal(@pr.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(pr.Staff?.FullName ?? "")', '@pr.Year-@pr.Month.ToString("00")', @pr.TotalSiteCostForMonth.ToString(System.Globalization.CultureInfo.InvariantCulture), @pr.MonthlySeveranceFund.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                                    Öde / Carilere İşle
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-success border"><i class="bi bi-check2-all me-1"></i>Tamamlandı</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SEKME 3: BANKA, KASA, HESAP ÖZETİ & TATİL TAKVİMİ -->
        <div class="tab-pane fade @(activeTab == "kasa" ? "show active" : "")" id="tabKasa" role="tabpanel">
            <div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-spreadsheet text-success me-2"></i>Yönetim Hesap Özeti (Toplanan Aidat - Yapılan Ödemeler = Kalan Kasa)</h5>
                        <small class="text-muted">Yıl ortası ve yıl sonu genel kurul ibrası için gelir, gider ve kalan kasa özeti</small>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> Yazdır / PDF
                    </button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-success small text-uppercase mb-2">Gelirler (Daire &amp; Dükkan Aidatları)</h6>
                            <ul class="list-group list-group-flush small border rounded-3">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Tahsil Edilen Aidat Toplamı (+)</span>
                                    <strong class="text-success">@totalCollectedDues.ToString("N2") ₺</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Tahsil Edilmeyi Bekleyen Aidat Alacağı</span>
                                    <strong class="text-warning-emphasis">@totalPendingDues.ToString("N2") ₺</strong>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-danger small text-uppercase mb-2">Yapılan Ödemeler (Gider Türleri Kırılımı)</h6>
                            <ul class="list-group list-group-flush small border rounded-3">
                                @foreach (var grp in expenseGroups)
                                {
                                    decimal gSum = activeExpenses
                                        .Where(e => string.Equals(e.ExpenseGroup, grp.SystemCode, StringComparison.OrdinalIgnoreCase))
                                        .Sum(e => e.TotalAmount);
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>@grp.Name</span>
                                        <strong class="text-danger">-@gSum.ToString("N2") ₺</strong>
                                    </li>
                                }
                                <li class="list-group-item d-flex justify-content-between bg-light fw-bold">
                                    <span>Kasada Kalan Net Bakiye (Toplanan - Harcanan)</span>
                                    <span class="@(netCashSummary >= 0 ? "text-primary" : "text-danger")">@netCashSummary.ToString("N2") ₺</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-bank me-2"></i>Banka Hesapları</h5>
                            <button class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addBankModal">+ Yeni Hesap</button>
                        </div>
                        <div class="card-body">
                            @if (bankAccounts.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var account in bankAccounts)
                                    {
                                        <li class="list-group-item px-0 py-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="fw-bold text-dark">@account.BankName</div>
                                                <span class="badge bg-success fs-6">@account.CurrentBalance.ToString("N2") ₺</span>
                                            </div>
                                            <div class="text-muted small">@account.AccountName</div>
                                            <div class="font-monospace small text-primary bg-light p-2 rounded mt-2">@account.IBAN</div>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted text-center py-3 small mb-0">Henüz banka hesabı eklenmemiş.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 rounded-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3 fw-bold text-dark">
                            <i class="bi bi-calendar-event text-warning me-2"></i>@DateTime.Today.Year Resmi &amp; Dini Tatil Takvimi
                        </div>
                        <div class="card-body p-3">
                            <p class="small text-muted mb-2">Personel tatil gününde çalıştığında puantajda işaretlenen gün kadar <strong>+1 yevmiye (2x)</strong> bayram mesaisi eklenir.</p>
                            <div class="list-group list-group-flush small">
                                @foreach (var h in holidays)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="fw-bold text-dark">@h.Date.ToString("dd.MM.yyyy")</span> - @h.Name
                                        </div>
                                        <span class="badge @(h.Category == "Dini" ? "bg-warning text-dark" : "bg-info text-dark")">@h.DayWeight.ToString("0.#")g</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 1. Abonelik / Sabit Ödeme Kurumu & Sözleşme Ekle Modalı -->
<div class="modal fade" id="addFixedExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content rounded-4 border-0 shadow" asp-action="AddBuildingFixedExpense" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnAction" value="Accounting" />
            <input type="hidden" name="returnScope" value="@(isSiteScope ? "site" : "block")" />
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title fw-bold">Düzenli Abonelik / Masraf Kalemi Tanımla</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 row g-3">
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-1 align-items-center bg-light p-2 rounded-3 border">
                        <small class="fw-bold text-muted me-1">Hızlı Masraf Şablonu:</small>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyFixedPreset('Ortak Elektrik (Enerji)', 'FaturaAbonelik', 'Isletme', 'Genel', 'Esit', true, 'Enerjisa', 1)">⚡ Ortak Elektrik</button>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyFixedPreset('Ortak Su (Enerji)', 'FaturaAbonelik', 'Isletme', 'Isinma', 'Esit', true, 'İSKİ', 1)">💧 Ortak Su</button>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyFixedPreset('Merkezi Doğalgaz / Isınma', 'FaturaAbonelik', 'Isletme', 'Isinma', 'Metrekare', true, 'İGDAŞ', 1)">🔥 Doğalgaz / Isınma</button>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyFixedPreset('Temizlik & Deterjan / Sarf Malzemesi', 'BakimOnarim', 'Isletme', 'Temizlik', 'Esit', false, 'Temizlik / Tedarik', 1)">🧹 Temizlik &amp; Deterjan</button>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyFixedPreset('Asansör Periyodik Bakım Sözleşmesi', 'BakimOnarim', 'Isletme', 'Asansor', 'Esit', false, 'Asansör Firması', 1)">🛗 Asansör Bakım</button>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyFixedPreset('Mali Müşavir / Yönetim', 'YonetimIdari', 'Isletme', 'Genel', 'Esit', false, 'Mali Müşavir', 1)">📋 Mali Müşavir</button>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="applyFixedPreset('Ortak Alan Yangın & Bina Sigortası', 'YonetimIdari', 'Isletme', 'Genel', 'Esit', false, 'Sigorta Acentesi', 12)">🛡️ Ortak Alan Sigortası (Yıllık)</button>
                    </div>
                </div>
                @if (buildings.Count > 1)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kapsam (Ortak Kasa / Tek Blok) *</label>
                        <select name="scopeType" id="fxScopeType" class="form-select fw-semibold">
                            @if (isSiteScope)
                            {
                                <option value="1" selected>🌐 Site Geneli (Tüm Bloklar · Ortak Kasa)</option>
                                <option value="2">🏢 Sadece Seçili Blok</option>
                            }
                            else
                            {
                                <option value="1">🌐 Site Geneli (Tüm Bloklar · Ortak Kasa)</option>
                                <option value="2" selected>🏢 Sadece Seçili Blok</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">İlgili Blok / Ana Kayıt</label>
                        <select name="buildingId" id="fxBuildingId" class="form-select">
                            @foreach (var b in buildings)
                            {
                                var bLbl = !string.IsNullOrWhiteSpace(b.BlockName) ? b.BlockName : b.Name;
                                <option value="@b.Id" selected="@(b.Id == Model.Id ? "selected" : null)">@bLbl</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="buildingId" value="@Model.Id" />
                    <input type="hidden" name="scopeType" id="fxScopeType" value="2" />
                }
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Gider Türü *</label>
                    <select name="expenseGroup" id="fxGroup" class="form-select fw-semibold" required>
                        @foreach (var grp in expenseGroups.Where(g => g.SystemCode != "Personel" && g.SystemCode != "DemirbasYatirim"))
                        {
                            <option value="@grp.SystemCode" selected="@(grp.SystemCode == "FaturaAbonelik" ? "selected" : null)">@grp.Name</option>
                        }
                    </select>
                    <small class="text-muted d-block mt-1" style="font-size:.72rem;">Personel için "2. Personel, SGK & Puantaj", büyük tadilat için "Toplantı & Karar Masası" kullanılır.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Kalem Başlığı (Boşsa Kurum Adı Kullanılır)</label>
                    <input type="text" name="title" id="fxTitle" class="form-control" placeholder="Örn: Ortak Elektrik, GMK360 Aboneliği" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">Fatura Tutarı Şekli *</label>
                    <div class="d-flex flex-wrap gap-3 bg-light p-2 rounded-3 border">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" name="isVariableAmount" id="fxVarYes" value="true" checked onchange="toggleFixedAmountInput()">
                            <label class="form-check-label small fw-bold text-primary" for="fxVarYes">
                                Değişken Fatura (Elektrik, Su, Gaz — Fatura gelince girilir)
                            </label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" name="isVariableAmount" id="fxVarNo" value="false" onchange="toggleFixedAmountInput()">
                            <label class="form-check-label small fw-bold" for="fxVarNo">
                                Sabit Tutarlı Sözleşme / Abonelik (Aylık veya Yıllık)
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Kurum / Firma *</label>
                    <input type="text" name="providerName" id="fxProvider" class="form-control" placeholder="Enerjisa, İSKİ, Asansör Firması vb." />
                </div>
                <div class="col-md-4" id="fxAmountBox" style="display:none;">
                    <label class="form-label fw-bold small">Sözleşme Tutarı (₺)</label>
                    <input type="number" step="0.01" min="0" name="monthlyAmount" id="fxAmount" class="form-control" value="0" placeholder="Örn: 1250" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Ödeme Periyodu</label>
                    <select name="billingCycleMonths" id="fxCycle" class="form-select fw-semibold" onchange="toggleBillingCycleFields()">
                        <option value="1">Aylık (Her Ay)</option>
                        <option value="3">3 Aylık</option>
                        <option value="6">6 Aylık</option>
                        <option value="12">Yıllık (Yılda 1)</option>
                    </select>
                </div>
                <div class="col-md-4" id="fxDueDayBox">
                    <label class="form-label fw-bold small">Her Ayın Kaçı?</label>
                    <input type="number" min="1" max="31" name="dueDayOfMonth" class="form-control" value="15" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Yasal Sorumlu (Kime Yansır? - KMK)</label>
                    <select name="expenseScope" id="fxScope" class="form-select fw-semibold" onchange="toggleFxOwnerSplit()">
                        <option value="Isletme">🔑 Kiracı / Oturan (İşletme Aidatı)</option>
                        <option value="Demirbas">🏠 Sadece Mal Sahibi (Demirbaş / Yatırım)</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill w-100" data-bs-toggle="collapse" data-bs-target="#fxOptionalDetails">
                        <i class="bi bi-folder2-open me-1"></i> Sözleşme PDF, Fiziksel Klasör &amp; Ek Ayarlar (Opsiyonel)
                    </button>
                </div>
                <div class="col-12 collapse" id="fxOptionalDetails">
                    <div class="p-3 rounded-3 bg-light border row g-2">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small mb-1">Abone / Sözleşme No</label>
                            <input type="text" name="subscriberNo" class="form-control form-control-sm" placeholder="Opsiyonel" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small mb-1" id="fxContractDateLabel">Sözleşme Bitiş Tarihi</label>
                            <input type="date" name="contractEndDate" id="fxContractEndDate" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small mb-1">Malik / Kiracı Özel Paylaşım (%)</label>
                            <input type="number" step="5" min="0" max="100" name="ownerSplitPercent" id="fxOwnerSplit" class="form-control form-control-sm" placeholder="Boş=Standart KMK" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small mb-1">Sözleşme PDF / Fotoğraf</label>
                            <input type="file" name="contractFile" class="form-control form-control-sm" accept=".pdf,image/*" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small mb-1">Islak İmzalı Asıl Klasör Yeri</label>
                            <input type="text" name="physicalArchiveLocation" class="form-control form-control-sm" placeholder="Örn: Yönetim Dolabı - Mavi Klasör 2" />
                        </div>
                    </div>
                </div>
                <input type="hidden" name="expenseItemKey" id="fxItemKey" value="Genel" />
                <input type="hidden" name="distributionRule" id="fxRule" value="Esit" />
                <input type="hidden" name="shopParticipationPercent" value="100" />
                <div class="col-12" id="fxAutoBox" style="display:none;">
                    <div class="p-2 rounded-3 bg-light border">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" name="isAutoRecurring" value="true" id="autoRecSw" checked>
                            <label class="form-check-label small fw-bold" for="autoRecSw">Bütçe özetine dahil et (Yıllık kalemler aylık 1/12 pay olarak hesaplanır)</label>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="postFirstPaymentNow" value="true" id="fxPostNowSw" onchange="toggleFirstPaymentBank()">
                            <label class="form-check-label small fw-bold text-success" for="fxPostNowSw">İlk ödemeyi şimdi bina kasasına gider olarak da işle</label>
                        </div>
                        <div class="mt-2 d-none" id="fxFirstPayBankBox">
                            <select name="firstPaymentBankAccountId" class="form-select form-select-sm">
                                <option value="">Elden / Genel Bina Kasası</option>
                                @foreach (var acc in bankAccounts)
                                {
                                    <option value="@acc.Id">@acc.BankName - @acc.AccountName (@acc.CurrentBalance.ToString("N2") ₺)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100">Aboneliği / Sözleşmeyi Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. Gerçekleşen Fatura / Ödeme İşle Modalı (Hangi İşin Faturası? + Belge & Asıl Evrak Yeri) -->
<div class="modal fade" id="newExpenseDirectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content rounded-4 border-0 shadow" asp-action="AddExpense" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnAction" value="Accounting" />
            <input type="hidden" name="returnScope" value="@(isSiteScope ? "site" : "block")" />
            <input type="hidden" name="chargeToUnits" value="false" />
            <input type="hidden" name="expenseItemKey" id="neItemKey" value="Genel" />
            <input type="hidden" name="distributionRule" value="Esit" />
            <input type="hidden" name="shopParticipationPercent" value="100" />
            <input type="hidden" name="linkedFixedExpenseId" id="neLinkedFixedId" value="" />
            <input type="hidden" name="linkedTaskTicketId" id="neLinkedTaskId" value="" />
            <input type="hidden" name="linkedSourceLabel" id="neLinkedLabel" value="" />
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-receipt-cutoff me-2"></i>Ödenen Fatura / Harcama Gir</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 row g-3">
                <div class="col-12">
                    <label class="form-label fw-bold small text-dark mb-2">1. Bu fatura / ödeme hangi işle ilgili?</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="linkedSourceType" id="srcAbonelik" value="Abonelik" onchange="setInvoiceSourceType('Abonelik')">
                        <label class="btn btn-outline-primary fw-semibold btn-sm py-2" for="srcAbonelik">⚡ Düzenli Abonelik</label>

                        <input type="radio" class="btn-check" name="linkedSourceType" id="srcAriza" value="ArizaIs" onchange="setInvoiceSourceType('ArizaIs')">
                        <label class="btn btn-outline-warning text-dark fw-semibold btn-sm py-2" for="srcAriza">🔧 Arıza / Bakım İşi</label>

                        <input type="radio" class="btn-check" name="linkedSourceType" id="srcGenel" value="Genel" checked onchange="setInvoiceSourceType('Genel')">
                        <label class="btn btn-outline-secondary fw-semibold btn-sm py-2" for="srcGenel">🛒 Genel / Serbest Harcama</label>
                    </div>
                </div>

                <div class="col-12 d-none" id="neSubPickerBox">
                    <label class="form-label fw-bold small text-primary">Hangi Aboneliğin Faturası?</label>
                    <select id="neSubSelect" class="form-select" onchange="onInvoiceSubscriptionSelect()">
                        <option value="">-- Kayıtlı aboneliklerden seçin --</option>
                        @foreach (var fx in fixedExpenses)
                        {
                            var bName = fx.ScopeType == GMK360.Core.Entities.ExpenseScopeType.HousingComplex ? "Site Ortak" : (fx.Building?.BlockName ?? fx.Building?.Name ?? "");
                            <option value="@fx.Id"
                                    data-title="@fx.Title"
                                    data-provider="@(fx.ProviderName ?? "")"
                                    data-group="@fx.ExpenseGroup"
                                    data-exptype="@(fx.ExpenseScope == "Demirbas" ? "1" : "2")"
                                    data-amount="@fx.MonthlyAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-scopetype="@((int)fx.ScopeType)"
                                    data-buildingid="@fx.BuildingId"
                                    data-itemkey="@(fx.ExpenseItemKey ?? "Genel")">
                                @fx.Title @(!string.IsNullOrWhiteSpace(bName) ? $"({bName})" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 d-none" id="neTaskPickerBox">
                    <label class="form-label fw-bold small text-warning-emphasis">Hangi Arıza, Talep veya Planlı Bakım İşinin Faturası?</label>
                    <select id="neTaskSelect" class="form-select" onchange="onInvoiceTaskSelect()">
                        <option value="">-- Arıza / Bakım işi seçin --</option>
                        @if (taskTickets.Any())
                        {
                            <optgroup label="Sakin / Yönetici Arıza & Talepleri">
                                @foreach (var tk in taskTickets)
                                {
                                    var shortDesc = tk.Description.Length > 55 ? tk.Description[..55] + "..." : tk.Description;
                                    <option value="ticket:@tk.Id"
                                            data-ticketid="@tk.Id"
                                            data-buildingid="@tk.BuildingId"
                                            data-label="Arıza/İş #@tk.Id: @tk.Category (@shortDesc)">
                                        #@tk.Id • @tk.Category (@tk.Status) — @shortDesc
                                    </option>
                                }
                            </optgroup>
                        }
                        @if (commonFixtures.Any())
                        {
                            <optgroup label="Planlı Bakım / Cihaz & Demirbaşlar">
                                @foreach (var cf in commonFixtures)
                                {
                                    var cfBldId = cf.UnitSpace?.BuildingUnit?.BuildingId ?? Model.Id;
                                    <option value="fixture:@cf.Id"
                                            data-ticketid=""
                                            data-buildingid="@cfBldId"
                                            data-label="Bakım: @cf.ItemName (@(cf.SupplierName ?? cf.Category))">
                                        🛠️ @cf.ItemName (@cf.Category)
                                    </option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                @if (buildings.Count > 1)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Gider Kapsamı (Site Geneli / Blok) *</label>
                        <select name="scopeType" id="neScopeType" class="form-select fw-semibold">
                            @if (isSiteScope)
                            {
                                <option value="1" selected>🌐 Site Geneli (Ortak Kasa · Tüm Bloklar)</option>
                                <option value="2">🏢 Sadece Seçili Blok</option>
                            }
                            else
                            {
                                <option value="1">🌐 Site Geneli (Ortak Kasa · Tüm Bloklar)</option>
                                <option value="2" selected>🏢 Sadece Seçili Blok</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Blok / Kasa Kaydı</label>
                        <select name="buildingId" id="neBuildingId" class="form-select">
                            @foreach (var b in buildings)
                            {
                                var bLbl = !string.IsNullOrWhiteSpace(b.BlockName) ? b.BlockName : b.Name;
                                <option value="@b.Id" selected="@(b.Id == Model.Id ? "selected" : null)">@bLbl</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="buildingId" id="neBuildingId" value="@Model.Id" />
                    <input type="hidden" name="scopeType" id="neScopeType" value="2" />
                }
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Gider Türü *</label>
                    <select name="expenseGroup" id="neGroup" class="form-select fw-semibold" required>
                        @foreach (var grp in expenseGroups)
                        {
                            <option value="@grp.SystemCode" selected="@(grp.SystemCode == "FaturaAbonelik" ? "selected" : null)">@grp.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Ödenen Tutar (₺) *</label>
                    <input type="number" step="0.01" min="0.01" name="totalAmount" id="neAmount" class="form-control fw-bold text-danger" required placeholder="Örn: 1840.50" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">Fatura / Harcama Açıklaması *</label>
                    <input type="text" name="description" id="neDesc" class="form-control" required placeholder="Örn: Kasım 2026 Ortak Elektrik Faturası veya D Blok Asansör Tamiri" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Ödenen Banka / Kasa</label>
                    <select name="bankAccountId" class="form-select">
                        <option value="">Elden / Genel Bina Kasası</option>
                        @foreach (var acc in bankAccounts)
                        {
                            <option value="@acc.Id">@acc.BankName - @acc.AccountName (@acc.CurrentBalance.ToString("N2") ₺)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Yasal Sorumlu (KMK)</label>
                    <select name="expenseType" id="neExpType" class="form-select fw-semibold">
                        <option value="2">🔑 İşletme Gideri (Kiracı / Oturan)</option>
                        <option value="1">🏠 Demirbaş / Büyük Tadilat (Sadece Malik)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Fatura / Makbuz PDF veya Fotoğraf</label>
                    <input type="file" name="invoiceFile" class="form-control" accept=".pdf,image/*" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Asıl Kağıt Fatura / Klasör Yeri (Denetim)</label>
                    <input type="text" name="physicalArchiveLocation" id="neArchiveLoc" class="form-control" placeholder="Örn: 2026 Kasım Klasörü · Sıra 14" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small text-success"><i class="bi bi-journal-check me-1"></i>Dayanak Karar Defteri Maddesi ("Bu Karara Göre Alındı")</label>
                    <select name="linkedDecisionMeetingId" class="form-select form-select-sm fw-semibold">
                        <option value="">-- Karar Defteri Bağlantısı Yok (Rutin Fatura) --</option>
                        @foreach (var dec in decisionsForExpense)
                        {
                            <option value="@dec.Id">📒 Sayfa #@(dec.BookPageNumber ?? dec.Id) · Karar #@(dec.DecisionNumber ?? dec.Id.ToString("D2")) — @dec.AgendaTitle (@dec.MeetingDate.ToString("dd.MM.yyyy"))</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold w-100">Ödemeyi &amp; Belgeyi Kasaya İşle</button>
            </div>
        </form>
    </div>
</div>

