<script>
    let currentDailyRate = 0;

    function applyFixedPreset(title, group, scope, itemKey, rule, isVariable, provider, cycleMonths) {
        document.getElementById('fxTitle').value = title;
        document.getElementById('fxGroup').value = group;
        document.getElementById('fxScope').value = scope;
        document.getElementById('fxItemKey').value = itemKey;
        document.getElementById('fxRule').value = rule;
        document.getElementById('fxProvider').value = provider || '';
        document.getElementById('fxCycle').value = String(cycleMonths || 1);
        document.getElementById('fxVarYes').checked = !!isVariable;
        document.getElementById('fxVarNo').checked = !isVariable;
        toggleFixedAmountInput();
        toggleBillingCycleFields();
    }

    function toggleBillingCycleFields() {
        const cycle = parseInt(document.getElementById('fxCycle').value || '1', 10);
        document.getElementById('fxDueDayBox').style.display = cycle > 1 ? 'none' : '';
        const lbl = document.getElementById('fxContractDateLabel');
        const dateEl = document.getElementById('fxContractEndDate');
        if (cycle > 1) {
            lbl.innerHTML = 'Yenileme / Sözleşme Bitiş Tarihi * <small class="text-muted">(Ay &amp; gün buradan alınır)</small>';
            if (!dateEl.value) {
                const d = new Date();
                d.setMonth(d.getMonth() + cycle);
                dateEl.value = d.toISOString().split('T')[0];
            }
        } else {
            lbl.innerText = 'Sözleşme Bitiş Tarihi (Opsiyonel)';
        }
    }

    function toggleFirstPaymentBank() {
        const checked = document.getElementById('fxPostNowSw').checked;
        document.getElementById('fxFirstPayBankBox').classList.toggle('d-none', !checked);
    }

    function toggleFixedAmountInput() {
        const isVar = document.getElementById('fxVarYes').checked;
        document.getElementById('fxAmountBox').style.display = isVar ? 'none' : '';
        document.getElementById('fxAutoBox').style.display = isVar ? 'none' : '';
        if (isVar) document.getElementById('fxAmount').value = '0';
    }

    function openInvoiceFromSubscription(title, provider, group, expType, amount) {
        document.getElementById('neGroup').value = group || 'FaturaAbonelik';
        const now = new Date();
        const ym = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
        document.getElementById('neDesc').value = title + (provider && title !== provider ? ' (' + provider + ' - ' + ym + ')' : ' (' + ym + ')');
        document.getElementById('neAmount').value = amount && parseFloat(amount) > 0 ? amount : '';
        document.getElementById('neExpType').value = expType || '2';
        new bootstrap.Modal(document.getElementById('newExpenseDirectModal')).show();
    }

    function openGiderReversalModal(expenseId, buildingId, desc) {
        document.getElementById('revExpId').value = expenseId;
        document.getElementById('revBldId').value = buildingId;
        document.getElementById('revExpDesc').innerText = desc;
        new bootstrap.Modal(document.getElementById('giderReversalModal')).show();
    }

    function onStaffRolePresetChange() {
        const val = document.getElementById('staffRoleTypeSelect').value;
        const taxInput = document.getElementById('staffTaxInput');
        if (val.indexOf('Kapıcı') >= 0) {
            taxInput.value = '0';
        }
    }

    function openPayrollModal(staffId, name, dailyRate) {
        currentDailyRate = parseFloat(dailyRate || '0');
        document.getElementById('pcStaffId').value = staffId;
        document.getElementById('pcStaffName').innerText = name;
        document.getElementById('pcDailyRateText').innerText = '(1 Günlük Yevmiye: ' + currentDailyRate.toFixed(2) + ' ₺)';
        updateHolidayPreview();
        new bootstrap.Modal(document.getElementById('payrollCalcModal')).show();
    }

    function updateHolidayPreview() {
        const days = parseFloat(document.getElementById('pcHolidayDays').value || '0');
        const extra = (days * currentDailyRate).toFixed(2);
        document.getElementById('pcHolidayPreview').innerText = days > 0
            ? `Bayram Mesaisi (+1 Yevmiye = 2x): +${extra} ₺ net maaşa ilave edilecek.`
            : '';
    }

    function openLeaveModal(staffId, name) {
        document.getElementById('lvStaffId').value = staffId;
        document.getElementById('lvStaffName').innerText = name;
        new bootstrap.Modal(document.getElementById('planLeaveModal')).show();
    }

    function openPayMonthlyPayrollModal(payrollId, name, period, opAmt, sevAmt) {
        document.getElementById('pmPayrollId').value = payrollId;
        document.getElementById('pmTitle').innerText = `${name} (${period}) Bordro Ödemesi`;
        document.getElementById('pmOpAmt').innerText = Number(opAmt || 0).toFixed(2);
        document.getElementById('pmSevAmt').innerText = Number(sevAmt || 0).toFixed(2);
        new bootstrap.Modal(document.getElementById('payMonthlyPayrollModal')).show();
    }
</script>
