<script>
    let currentDailyRate = 0;

    function applyFixedPreset(title, group, scope, itemKey, rule, isVariable, provider, cycleMonths) {
        document.getElementById('fxTitle').value = title;
        document.getElementById('fxGroup').value = group;
        document.getElementById('fxScope').value = scope;
        document.getElementById('fxItemKey').value = itemKey;
        document.getElementById('fxRule').value = rule;
        document.getElementById('fxProvider').value = provider || '';
        document.getElementById('fxCycle').value = String(cycleMonths || 1);
        document.getElementById('fxVarYes').checked = !!isVariable;
        document.getElementById('fxVarNo').checked = !isVariable;
        toggleFixedAmountInput();
        toggleBillingCycleFields();
    }

    function toggleBillingCycleFields() {
        const cycle = parseInt(document.getElementById('fxCycle').value || '1', 10);
        document.getElementById('fxDueDayBox').style.display = cycle > 1 ? 'none' : '';
        const lbl = document.getElementById('fxContractDateLabel');
        const dateEl = document.getElementById('fxContractEndDate');
        if (cycle > 1) {
            lbl.innerHTML = 'Yenileme / Sözleşme Bitiş Tarihi * <small class="text-muted">(Ay &amp; gün buradan alınır)</small>';
            if (!dateEl.value) {
                const d = new Date();
                d.setMonth(d.getMonth() + cycle);
                dateEl.value = d.toISOString().split('T')[0];
            }
        } else {
            lbl.innerText = 'Sözleşme Bitiş Tarihi (Opsiyonel)';
        }
    }

    function toggleFirstPaymentBank() {
        const checked = document.getElementById('fxPostNowSw').checked;
        document.getElementById('fxFirstPayBankBox').classList.toggle('d-none', !checked);
    }

    function toggleFixedAmountInput() {
        const isVar = document.getElementById('fxVarYes').checked;
        document.getElementById('fxAmountBox').style.display = isVar ? 'none' : '';
        document.getElementById('fxAutoBox').style.display = isVar ? 'none' : '';
        if (isVar) document.getElementById('fxAmount').value = '0';
    }

    function toggleFxOwnerSplit() {
        const sc = document.getElementById('fxScope');
        const sp = document.getElementById('fxOwnerSplit');
        if (!sc || !sp) return;
        if (sc.value === 'Demirbas' && !sp.value) {
            sp.placeholder = 'Demirbaş = %100 Malik';
        } else {
            sp.placeholder = 'Boş=Standart KMK | 100=%100 Malik';
        }
    }

    function setInvoiceSourceType(src) {
        document.getElementById('neSubPickerBox').classList.toggle('d-none', src !== 'Abonelik');
        document.getElementById('neTaskPickerBox').classList.toggle('d-none', src !== 'ArizaIs');
        if (src === 'Genel') {
            document.getElementById('neLinkedFixedId').value = '';
            document.getElementById('neLinkedTaskId').value = '';
            document.getElementById('neLinkedLabel').value = '';
        }
    }

    function onInvoiceSubscriptionSelect() {
        const sel = document.getElementById('neSubSelect');
        if (!sel || !sel.value) return;
        const opt = sel.options[sel.selectedIndex];
        fillInvoiceFromValues(
            sel.value,
            opt.dataset.title,
            opt.dataset.provider,
            opt.dataset.group,
            opt.dataset.exptype,
            opt.dataset.amount,
            opt.dataset.scopetype,
            opt.dataset.buildingid,
            opt.dataset.itemkey
        );
    }

    function onInvoiceTaskSelect() {
        const sel = document.getElementById('neTaskSelect');
        if (!sel || !sel.value) return;
        const opt = sel.options[sel.selectedIndex];
        const ticketId = opt.dataset.ticketid || '';
        const label = opt.dataset.label || opt.text;
        const bldId = opt.dataset.buildingid;
        document.getElementById('neLinkedFixedId').value = '';
        document.getElementById('neLinkedTaskId').value = ticketId;
        document.getElementById('neLinkedLabel').value = label;
        document.getElementById('neGroup').value = 'BakimOnarim';
        document.getElementById('neDesc').value = label;
        const bEl = document.getElementById('neBuildingId');
        if (bEl && bldId) bEl.value = String(bldId);
        const stEl = document.getElementById('neScopeType');
        if (stEl) stEl.value = '2';
    }

    function fillInvoiceFromValues(fixedId, title, provider, group, expType, amount, scopeType, bldId, itemKey) {
        document.getElementById('neGroup').value = group || 'FaturaAbonelik';
        const now = new Date();
        const ym = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
        document.getElementById('neDesc').value = title + (provider && title !== provider ? ' (' + provider + ' - ' + ym + ')' : ' (' + ym + ')');
        document.getElementById('neAmount').value = amount && parseFloat(amount) > 0 ? amount : '';
        document.getElementById('neExpType').value = expType || '2';
        document.getElementById('neLinkedFixedId').value = fixedId || '';
        document.getElementById('neLinkedTaskId').value = '';
        document.getElementById('neLinkedLabel').value = title ? ('Abonelik: ' + title) : '';
        const stEl = document.getElementById('neScopeType');
        if (stEl && scopeType) stEl.value = String(scopeType);
        const bEl = document.getElementById('neBuildingId');
        if (bEl && bldId) bEl.value = String(bldId);
        const ikEl = document.getElementById('neItemKey');
        if (ikEl && itemKey) ikEl.value = itemKey;
    }

    function openInvoiceFromSubscription(fixedId, title, provider, group, expType, amount, scopeType, bldId, itemKey) {
        const r = document.getElementById('srcAbonelik');
        if (r) r.checked = true;
        setInvoiceSourceType('Abonelik');
        const sel = document.getElementById('neSubSelect');
        if (sel && fixedId) sel.value = String(fixedId);
        fillInvoiceFromValues(fixedId, title, provider, group, expType, amount, scopeType, bldId, itemKey);
        new bootstrap.Modal(document.getElementById('newExpenseDirectModal')).show();
    }

    function openGiderReversalModal(expenseId, buildingId, desc) {
        document.getElementById('revExpId').value = expenseId;
        document.getElementById('revBldId').value = buildingId;
        document.getElementById('revExpDesc').innerText = desc;
        new bootstrap.Modal(document.getElementById('giderReversalModal')).show();
    }

    function onStaffRolePresetChange() {
        const val = document.getElementById('staffRoleTypeSelect').value;
        const taxInput = document.getElementById('staffTaxInput');
        if (val.indexOf('Kapıcı') >= 0) {
            taxInput.value = '0';
        }
    }

    function openPayrollModal(staffId, name, dailyRate) {
        currentDailyRate = parseFloat(dailyRate || '0');
        document.getElementById('pcStaffId').value = staffId;
        document.getElementById('pcStaffName').innerText = name;
        document.getElementById('pcDailyRateText').innerText = '(1 Günlük Yevmiye: ' + currentDailyRate.toFixed(2) + ' ₺)';
        updateHolidayPreview();
        new bootstrap.Modal(document.getElementById('payrollCalcModal')).show();
    }

    function updateHolidayPreview() {
        const days = parseFloat(document.getElementById('pcHolidayDays').value || '0');
        const extra = (days * currentDailyRate).toFixed(2);
        document.getElementById('pcHolidayPreview').innerText = days > 0
            ? `Bayram Mesaisi (+1 Yevmiye = 2x): +${extra} ₺ net maaşa ilave edilecek.`
            : '';
    }

    function openLeaveModal(staffId, name) {
        document.getElementById('lvStaffId').value = staffId;
        document.getElementById('lvStaffName').innerText = name;
        new bootstrap.Modal(document.getElementById('planLeaveModal')).show();
    }

    function openPayMonthlyPayrollModal(payrollId, name, period, opAmt, sevAmt) {
        document.getElementById('pmPayrollId').value = payrollId;
        document.getElementById('pmTitle').innerText = `${name} (${period}) Bordro Ödemesi`;
        document.getElementById('pmOpAmt').innerText = Number(opAmt || 0).toFixed(2);
        document.getElementById('pmSevAmt').innerText = Number(sevAmt || 0).toFixed(2);
        new bootstrap.Modal(document.getElementById('payMonthlyPayrollModal')).show();
    }

    function openStaffInviteModal(staffId, name, email, phone) {
        document.getElementById('siStaffId').value = staffId;
        document.getElementById('siStaffName').innerText = name || 'Personel';
        document.getElementById('siEmail').value = email || '';
        document.getElementById('siPhone').value = phone || '';
        new bootstrap.Modal(document.getElementById('staffInviteModal')).show();
    }

    function toggleStaffFringe(prefix) {
        const hasFringe = document.getElementById(prefix + 'FringeChk')?.checked === true;
        const wrap = document.getElementById(prefix + 'FringeWrap');
        const hint = document.getElementById(prefix + 'FringeNoneHint');
        const inp = document.getElementById(prefix + 'FringeInput');
        if (wrap) wrap.style.display = hasFringe ? '' : 'none';
        if (hint) hint.style.display = hasFringe ? 'none' : '';
        if (!hasFringe && inp) inp.value = '0';
    }

    function calculateStaffPayrollFields(prefix) {
        const net = parseFloat(document.getElementById(prefix + 'NetSalary')?.value || '0') || 0;
        const role = document.getElementById(prefix + 'RoleSelect')?.value || '';
        const hasIncentive = document.getElementById(prefix + 'IncentiveChk')?.checked !== false;
        const isTaxExemptCaretaker = role.indexOf('Kapıcı') >= 0;

        // Konut kapıcısı GVK Md.23/6 istisnası: Vergi = 0, İşçi SGK %15 -> Brüt = Net / 0.85
        // Diğer rollerde asgari ücret (22.104,67 TL / 26.005,50 TL brüt) istisnası aşan kısım için yaklaşık %15.75 vergi farkı
        let gross = 0;
        let estTax = 0;
        if (net > 0) {
            if (isTaxExemptCaretaker || net <= 22105) {
                gross = net / 0.85;
                estTax = 0;
            } else {
                gross = 26005.50 + ((net - 22104.67) / 0.715);
                estTax = Math.max(0, (gross - 26005.50) * 0.135);
            }
        }
        const employerRate = hasIncentive ? 0.1875 : 0.2275;
        const sgkEmployer = gross * employerRate;
        const monthlySeverance = gross / 12.0;

        const sgkEl = document.getElementById(prefix + 'SgkShare');
        const taxEl = document.getElementById(prefix + 'TaxInput');
        const sevEl = document.getElementById(prefix + 'SeveranceInput');
        const noteEl = document.getElementById(prefix + 'CalcNote');
        if (sgkEl) sgkEl.value = sgkEmployer.toFixed(2);
        if (taxEl) taxEl.value = estTax.toFixed(2);
        if (sevEl) sevEl.value = monthlySeverance.toFixed(2);
        if (noteEl && net > 0) {
            noteEl.innerText = `Tahmini Brüt: ${gross.toFixed(2)} ₺ • SGK İşveren (%${(employerRate * 100).toFixed(2)}): ${sgkEmployer.toFixed(2)} ₺ • Aylık Kıdem (Brüt/12): ${monthlySeverance.toFixed(2)} ₺ (Bordroya göre elle düzenlenebilir).`;
        }
    }

    function syncAddStaffScope() {
        const sel = document.getElementById('addStaffScopeSelect');
        const bEl = document.getElementById('addStaffBuildingIdHidden');
        const swEl = document.getElementById('addStaffIsSiteWideHidden');
        if (!sel || !bEl || !swEl) return;
        const val = sel.value || '';
        const parts = val.split(':');
        if (parts.length === 2) {
            bEl.value = parts[1];
            swEl.value = parts[0] === 'SITE' ? 'true' : 'false';
        }
    }

    function openEditStaffModal(btn) {
        const d = btn.dataset;
        document.getElementById('editStaffId').value = d.id || '';
        document.getElementById('editFullName').value = d.fullname || '';
        const roleSel = document.getElementById('editRoleSelect');
        if (roleSel && d.roletype) roleSel.value = d.roletype;
        document.getElementById('editJobDesc').value = d.jobdesc || '';
        document.getElementById('editTc').value = d.tc || '';
        document.getElementById('editSgkNo').value = d.sgk || '';
        document.getElementById('editPhone').value = d.phone || '';
        document.getElementById('editEmail').value = d.email || '';
        document.getElementById('editAddress').value = d.address || '';
        const swChk = document.getElementById('editIsSiteWide');
        if (swChk) swChk.checked = d.sitewide === 'true';
        document.getElementById('editHireDate').value = d.hiredate || '';
        document.getElementById('editNetSalary').value = d.net || '0';
        document.getElementById('editSgkShare').value = d.sgkamt || '0';
        document.getElementById('editTaxInput').value = d.tax || '0';
        const fringeVal = parseFloat(d.fringe || '0') || 0;
        document.getElementById('editFringeInput').value = fringeVal;
        document.getElementById('editFringeChk').checked = fringeVal > 0;
        toggleStaffFringe('edit');
        document.getElementById('editSeveranceInput').value = d.sev || '0';
        new bootstrap.Modal(document.getElementById('editBuildingStaffModal')).show();
    }

    function openRemoveStaffModal(staffId, name) {
        document.getElementById('rmStaffId').value = staffId;
        document.getElementById('rmStaffName').innerText = name || 'Personel';
        document.getElementById('rmActionMode').value = 'terminate';
        document.getElementById('rmTerminateFields').classList.remove('d-none');
        new bootstrap.Modal(document.getElementById('removeBuildingStaffModal')).show();
    }

    function copyTextValue(val, btn) {
        if (!val || !navigator.clipboard) return;
        navigator.clipboard.writeText(val).then(() => {
            if (!btn) return;
            const prev = btn.innerText;
            btn.innerText = 'Kopyalandı!';
            setTimeout(() => { btn.innerText = prev; }, 1600);
        });
    }
</script>
