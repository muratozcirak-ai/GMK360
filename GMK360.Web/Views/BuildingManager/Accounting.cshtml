<!-- 5. Tam Bordrolu Kadro Personeli Ekle Modal -->
<div class="modal fade" id="addBuildingStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content rounded-4 border-0 shadow" asp-action="AddBuildingStaff" asp-controller="BuildingManager" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="buildingId" id="addStaffBuildingIdHidden" value="@Model.Id" />
            <input type="hidden" name="isSiteWide" id="addStaffIsSiteWideHidden" value="@((isSiteScope || buildings.Count > 1) && Model.HousingComplexId.HasValue ? "true" : "false")" />
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title fw-bold text-white">Bina / Site Kadro Personeli Ekle (Tam SGK &amp; Kıdem Kurulumu)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 row g-3">
                @if (buildings.Count > 1)
                {
                    <div class="col-12">
                        <label class="form-label small fw-bold text-primary">Görev Kapsamı (Site Geneli / Tek Blok) *</label>
                        <select id="addStaffScopeSelect" class="form-select form-select-sm fw-semibold border-primary-subtle" onchange="syncAddStaffScope()">
                            @if (Model.HousingComplexId.HasValue)
                            {
                                <option value="SITE:@Model.Id" selected="@((isSiteScope || buildings.Count > 1) ? "selected" : null)">🌐 Site Geneli (@siteTitleLabel — Tüm Bloklar)</option>
                            }
                            @foreach (var b in buildings)
                            {
                                var bLbl = !string.IsNullOrWhiteSpace(b.BlockName) ? b.BlockName : b.Name;
                                <option value="BLK:@b.Id" selected="@(!isSiteScope && !Model.HousingComplexId.HasValue && b.Id == Model.Id ? "selected" : null)">🏢 Sadece @bLbl</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Adı Soyadı *</label>
                    <input type="text" name="fullName" class="form-control" required placeholder="Örn: Ali Yılmaz" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Personel Tipi *</label>
                    <select name="roleType" id="addRoleSelect" class="form-select fw-semibold" onchange="calculateStaffPayrollFields('add')">
                        <option value="Kapıcı (Vergi İstisnalı)">Kapıcı / Konut Görevlisi (Vergi İstisnalı)</option>
                        <option value="Güvenlik">Güvenlik Görevlisi</option>
                        <option value="Temizlik">Temizlik Personeli</option>
                        <option value="Bahçıvan">Bahçıvan</option>
                        <option value="Teknik">Teknik / Tesisat Personeli</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">İşe Giriş Tarihi *</label>
                    <input type="date" name="hireDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-12">
                    <label class="form-label small fw-bold">Görev &amp; Sorumluluk Tanımı (Adının yanında görünür)</label>
                    <input type="text" name="jobDescription" class="form-control form-control-sm" placeholder="Örn: A-B Blok çöp toplama, günlük merdiven temizliği, akşam bahçe sulama" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">TC Kimlik No</label>
                    <input type="text" name="tcIdentityNo" maxlength="11" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">SGK Sicil No</label>
                    <input type="text" name="sgkNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Görevli Telefonu *</label>
                    <input type="tel" name="phoneNumber" class="form-control" required placeholder="05XX XXX XX XX" />
                </div>
                <div class="col-md-7">
                    <label class="form-label small fw-bold">Personel E-Postası (Opsiyonel)</label>
                    <input type="email" name="email" class="form-control" placeholder="Boş bırakılırsa otomatik iç adres açılır" />
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="sendActivationEmail" value="true" id="chkSendStaffMail" />
                        <label class="form-check-label small" for="chkSendStaffMail">Gerçek mailse davet gönder</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="alert alert-info bg-opacity-10 border-info-subtle rounded-3 py-2 px-3 small mb-0">
                        <i class="bi bi-shield-lock me-1"></i><strong>Gizli PIN Güvenliği:</strong> Yönetici personel adına PIN belirlemez. Kaydedince geçici şifre ve ilk giriş linki oluşur; personel ilk girişte kendi şifresini, PIN'ini ve adresini girer.
                    </div>
                </div>

                <div class="col-12 bg-light rounded-3 p-2 px-3 border d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="addIncentiveChk" checked onchange="calculateStaffPayrollFields('add')" />
                            <label class="form-check-label fw-semibold" for="addIncentiveChk">5510 SGK Teşviki (%18,75)</label>
                        </div>
                        <div class="form-check form-switch mb-0">
