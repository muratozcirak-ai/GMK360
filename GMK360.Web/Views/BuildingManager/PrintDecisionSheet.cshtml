@model GMK360.Core.Entities.SystemMeeting
@{
    Layout = null;
    var building = ViewBag.Building as GMK360.Core.Entities.Building;
    var boardRoster = ViewBag.BoardRoster as List<GMK360.Core.Entities.BuildingManager> ?? new List<GMK360.Core.Entities.BuildingManager>();
    var units = ViewBag.EligibleUnits as List<GMK360.Core.Entities.BuildingUnit>
        ?? (building?.Units ?? new List<GMK360.Core.Entities.BuildingUnit>())
            .Where(u => !(u.Category ?? "").StartsWith("OrtakAlan", StringComparison.OrdinalIgnoreCase))
            .OrderBy(u => u.FloorLevel).ThenBy(u => u.DoorNumber).ToList();
    bool isSiteDecision = Model.IsSiteWide && building?.HousingComplex != null;
    string propertyHeading = isSiteDecision
        ? $"{building!.HousingComplex!.Name} (Site Geneli — Tüm Bloklar)"
        : (building?.Name ?? "Apartman / Site Yönetimi");
    var decisions = (Model.Decisions ?? new List<GMK360.Core.Entities.SystemMeetingDecision>()).Where(d => !d.IsDeleted).ToList();
    var votesByUnit = (Model.Votes ?? new List<GMK360.Core.Entities.BuildingDecisionVote>())
        .Where(v => !v.IsDeleted)
        .GroupBy(v => v.BuildingUnitId)
        .ToDictionary(g => g.Key, g => g.First());
    var quorum = ViewBag.QuorumSummary as GMK360.Web.Helpers.KmkQuorumSummary ?? GMK360.Web.Helpers.KmkQuorumHelper.Compute(units, Model.Votes, Model.QuorumType);
    string format = (ViewBag.Format as string) == "a5" ? "a5" : "a4";
    bool isA5 = format == "a5";
    string verifyUrl = ViewBag.VerifyUrl as string ?? "";
    string addressLine = string.Join(" ", new[] {
        building?.StreetName,
        !string.IsNullOrWhiteSpace(building?.BuildingNumber) ? $"No: {building.BuildingNumber}" : null,
        building?.District?.Name,
        building?.City?.Name
    }.Where(x => !string.IsNullOrWhiteSpace(x)));
    if (string.IsNullOrWhiteSpace(addressLine)) addressLine = building?.Address ?? "Bina adresi yönetim kaydından tamamlanabilir";

    string defaultChair = boardRoster
        .Where(m => m.Role == GMK360.Core.Entities.BuildingManagerRole.HeadManager)
        .Select(m => !string.IsNullOrWhiteSpace(m.User?.FirstName) ? $"{m.User.FirstName} {m.User.LastName}".Trim() : (m.User?.DisplayName ?? m.User?.Email))
        .FirstOrDefault() ?? "-";
    string defaultAzas = string.Join(", ", boardRoster
        .Where(m => m.Role == GMK360.Core.Entities.BuildingManagerRole.BoardMember || m.Role == GMK360.Core.Entities.BuildingManagerRole.Auditor)
        .Select(m => !string.IsNullOrWhiteSpace(m.User?.FirstName) ? $"{m.User.FirstName} {m.User.LastName}".Trim() : (m.User?.DisplayName ?? m.User?.Email))
        .Where(n => !string.IsNullOrWhiteSpace(n)));
    string chairText = !string.IsNullOrWhiteSpace(Model.ChairpersonName) ? Model.ChairpersonName! : defaultChair;
    string azasText = !string.IsNullOrWhiteSpace(Model.BoardMembersSummary) ? Model.BoardMembersSummary! : (string.IsNullOrWhiteSpace(defaultAzas) ? "-" : defaultAzas);
    int displayPageNo = Model.BookPageNumber ?? Model.Id;
    string displayDecNo = Model.DecisionNumber ?? $"{Model.MeetingDate.Year}/{Model.Id:D2}";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Karar Defteri (Sayfa @displayPageNo · Karar #@displayDecNo) - @Model.AgendaTitle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        @@page {
            size: @(isA5 ? "A5 portrait" : "A4 portrait");
            margin: @(isA5 ? "6mm" : "9mm");
        }
        body {
            background-color: #f1f5f9;
            font-family: 'Times New Roman', Times, serif;
            color: #111827;
            font-size: @(isA5 ? "10px" : "12.5px");
            line-height: 1.38;
        }
        .sheet-page {
            width: @(isA5 ? "148mm" : "210mm");
            min-height: @(isA5 ? "210mm" : "297mm");
            padding: @(isA5 ? "8mm 9mm" : "12mm 14mm");
            margin: 18px auto;
            background: #ffffff;
            box-shadow: 0 4px 18px rgba(0,0,0,0.12);
            border: 1px solid #cbd5e1;
            position: relative;
            box-sizing: border-box;
        }
        .no-print-bar {
            background: #0f172a;
            color: #ffffff;
            padding: 10px 20px;
            position: sticky;
            top: 0;
            z-index: 999;
            font-family: system-ui, -apple-system, sans-serif;
        }
        .page-no-corner {
            position: absolute;
            top: @(isA5 ? "7mm" : "10mm");
            right: @(isA5 ? "9mm" : "14mm");
            border: 1.5px solid #000;
            padding: 2px 10px;
            font-weight: bold;
            font-size: @(isA5 ? "11px" : "14px");
        }
        .ledger-top-title {
            text-align: center;
            margin-bottom: 8px;
        }
        .ledger-top-title h4 {
            font-size: @(isA5 ? "12.5px" : "16px");
            font-weight: bold;
            margin: 0;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }
        .ledger-top-title small { font-size: @(isA5 ? "8.5px" : "10.5px"); color: #334155; }
        table.notary-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
            font-size: @(isA5 ? "9px" : "11.5px");
        }
        table.notary-grid th, table.notary-grid td {
            border: 1.2px solid #000;
            padding: @(isA5 ? "3px 5px" : "4px 7px");
            vertical-align: top;
        }
        table.notary-grid th {
            background: #f8fafc;
            text-align: center;
            font-weight: bold;
        }
        .meeting-roster-line {
            border: 1.2px solid #000;
            border-top: none;
            padding: @(isA5 ? "5px 7px" : "7px 10px");
            margin-top: -8px;
            margin-bottom: 8px;
            font-size: @(isA5 ? "9.5px" : "12px");
        }
        .karar-metni-band {
            border: 1.2px solid #000;
            border-bottom: 1.2px solid #000;
            background: #f8fafc;
            text-align: center;
            font-weight: bold;
            letter-spacing: 1px;
            padding: 3px;
            font-size: @(isA5 ? "10px" : "12.5px");
        }
        .karar-metni-body {
            border: 1.2px solid #000;
            border-top: none;
            padding: @(isA5 ? "6px 8px" : "8px 12px");
            margin-bottom: 8px;
            text-align: justify;
        }
        table.hazirun-table {
            width: 100%;
            border-collapse: collapse;
            font-size: @(isA5 ? "8.5px" : "10.5px");
        }
        table.hazirun-table th, table.hazirun-table td {
            border: 1px solid #000;
            padding: @(isA5 ? "2.5px 4px" : "3.5px 6px");
            vertical-align: middle;
        }
        table.hazirun-table th { background-color: #f1f5f9; text-align: center; font-weight: bold; }
        .sign-area { min-height: @(isA5 ? "18px" : "24px"); height: @(isA5 ? "18px" : "24px"); }
        .signature-box {
            margin-top: @(isA5 ? "12px" : "16px");
            display: flex;
            justify-content: space-between;
            text-align: center;
            font-size: @(isA5 ? "9.5px" : "11.5px");
        }
        .sign-col { width: 31%; }
        .sign-line { margin-top: @(isA5 ? "20px" : "28px"); border-top: 1px dashed #000; padding-top: 3px; font-weight: bold; }
        .seal-corner-note {
            margin-top: 8px;
            padding-top: 5px;
            border-top: 1px solid #cbd5e1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            font-size: @(isA5 ? "8px" : "9.5px");
            color: #475569;
        }
        @@media print {
            body { background: transparent; margin: 0; padding: 0; }
            .no-print-bar { display: none !important; }
            .sheet-page {
                box-shadow: none !important;
                border: none !important;
                margin: 0 auto !important;
                width: 100% !important;
                min-height: auto !important;
                padding: 0 !important;
                page-break-after: always;
            }
        }
    </style>
</head>
<body>
    <div class="no-print-bar d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <a href="/BuildingManager/Oylamalar?buildingId=@building?.Id" class="btn btn-sm btn-outline-light rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Karar Defteri Masası
            </a>
            <span class="fw-bold small">Resmi Noter Karar Defteri Dijital İkizi • Sayfa @displayPageNo • Karar #@displayDecNo</span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@Model.Id&format=a4" class="btn btn-sm @(!isA5 ? "btn-light text-dark fw-bold" : "btn-outline-light") rounded-pill px-3">A4 Tam</a>
            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@Model.Id&format=a5" class="btn btn-sm @(isA5 ? "btn-light text-dark fw-bold" : "btn-outline-light") rounded-pill px-3">A5 Yapıştırma</a>
            <button onclick="window.print()" class="btn btn-warning btn-sm fw-bold rounded-pill px-4">
                <i class="bi bi-printer-fill me-1"></i> Yazdır / PDF
            </button>
        </div>
    </div>

    <div class="sheet-page">
        <div class="page-no-corner">SAYFA NO: @displayPageNo</div>
        <div class="ledger-top-title">
            <h4>@propertyHeading — KARAR DEFTERİ</h4>
            <small>634 Sayılı Kat Mülkiyeti Kanunu Md. 32 Uyarınca Resmi Karar Kaydı • @addressLine</small>
        </div>

        <!-- RESMİ NOTER DEFTERİ ÜST CETVELİ -->
        <table class="notary-grid">
            <thead>
                <tr>
                    <th rowspan="2" style="width: 12%; vertical-align: middle;">Karar Sıra No</th>
                    <th colspan="3" style="width: 42%;">Karara Esas Olan Evrakın</th>
                    <th rowspan="2" style="width: 46%; vertical-align: middle;">Mevzuun Mahiyeti ve Hülâsası</th>
                </tr>
                <tr>
                    <th style="width: 12%;">Tarihi</th>
                    <th style="width: 12%;">No</th>
                    <th style="width: 18%;">Nereden Gönderildiği</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="text-align: center; font-weight: bold; font-size: 1.05em;">@displayDecNo</td>
                    <td style="text-align: center;">@(Model.SourceDocDate?.ToString("dd.MM.yyyy") ?? Model.MeetingDate.ToString("dd.MM.yyyy"))</td>
                    <td style="text-align: center;">@(Model.SourceDocNumber ?? "-")</td>
                    <td>@(Model.SourceDocSender ?? "Yönetim / Genel Kurul Gündemi")</td>
                    <td>
                        <strong>@Model.AgendaTitle</strong>
                        <div style="font-size: 0.9em; color: #334155;">
                            Kapsam: @(isSiteDecision ? "Site Geneli (Tüm Bloklar)" : $"Sadece {building?.BlockName ?? building?.Name}") • Yeter Sayı: @quorum.RuleLabel
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- TOPLANTI TARİHİ, BAŞKAN VE AZALAR -->
        <div class="meeting-roster-line">
            <div class="d-flex justify-content-between flex-wrap mb-1">
                <span><strong>Toplantı Tarihi :</strong> @Model.MeetingDate.ToString("dd / MM / yyyy") günü, saat @Model.MeetingDate.ToString("HH:mm")</span>
                <span><strong>Toplantı Yeri :</strong> @(Model.MeetingLocation ?? "Site Yönetim Odası")</span>
            </div>
            <div><strong>Başkanın Adı ve Soyadı :</strong> @chairText</div>
            <div><strong>Azaların Adı ve Soyadı :</strong> @azasText</div>
            <div style="margin-top: 3px; font-size: 0.9em; color: #334155;">
                <strong>Katılım &amp; Çoğunluk :</strong> @quorum.ParticipatedUnits / @quorum.TotalUnits Bağımsız Bölüm Katıldı •
                <strong>@quorum.ApprovedUnits Kabul</strong> / @quorum.RejectedUnits Ret (%@quorum.ApprovalUnitPercent Adet, %@quorum.ApprovalSharePercent Arsa Payı) —
                <strong>@(quorum.IsQuorumMet ? "YASAL ÇOĞUNLUK SAĞLANDI" : "OYLAMA / İMZA AŞAMASINDA")</strong>
            </div>
        </div>

        <!-- KARARIN METNİ -->
        <div class="karar-metni-band">KARARIN METNİ</div>
        <div class="karar-metni-body">
            @if (decisions.Any())
            {
                int dNo = 1;
                foreach (var d in decisions)
                {
                    <p style="margin-bottom: 4px;">
                        <strong>@(dNo++))</strong> @d.DecisionText
                    </p>
                }
            }
            else
            {
                <p style="margin-bottom: 4px;">
                    <strong>1)</strong> @Model.AgendaTitle konusu incelenmiş olup aşağıdaki katılımcıların oylarıyla kabul edilmiştir.
                </p>
            }
            @if (Model.IsExecuted && !string.IsNullOrWhiteSpace(Model.ExecutionSummary))
            {
                <p style="margin-bottom: 4px; font-style: italic; color: #166534;">
                    <strong>Uygulama Kaydı:</strong> @Model.ExecutionSummary
                </p>
            }
            <div style="margin-top: 6px;">
                <strong>Toplantı saat @(!string.IsNullOrWhiteSpace(Model.MeetingEndTime) ? Model.MeetingEndTime : Model.MeetingDate.AddHours(1).ToString("HH:mm"))'da sona erdi.</strong>
                <span style="margin-left: 12px; text-decoration: underline;">İmzalar:</span>
            </div>
        </div>

        <!-- KATILANLAR & HAZİRUN İMZA CETVELİ -->
        <table class="hazirun-table">
            <thead>
                <tr>
                    <th style="width: 5%;">No</th>
                    <th style="width: 12%;">Bölüm</th>
                    <th style="width: 24%;">Katılan Malik Adı Soyadı</th>
                    <th style="width: 14%;">Katılım Şekli</th>
                    <th style="width: 16%;">Oy / Şerh</th>
                    <th style="width: 14%;">Dijital Onay Kodu</th>
                    <th style="width: 15%;">Islak İmza</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int row = 1;
                    decimal sumLandShare = units.Sum(u => u.LandShare);
                }
                @foreach (var unit in units)
                {
                    votesByUnit.TryGetValue(unit.Id, out var vote);
                    string participationLabel = vote?.ParticipationType switch
                    {
                        "Vekil" => !string.IsNullOrWhiteSpace(vote.ProxyPersonName) ? $"Vekil ({vote.ProxyPersonName})" : "Vekil",
                        "Katilmadi" => "Katılmadı",
                        "Asil" => "Asil",
                        _ => "Asil"
                    };
                    <tr>
                        <td style="text-align: center;">@(row++)</td>
                        <td style="text-align: center; font-weight: bold;">@(isSiteDecision && unit.Building != null ? $"{unit.Building.BlockName ?? unit.Building.Name} · {unit.DoorNumber}" : unit.DoorNumber)</td>
                        <td>
                            @(unit.OwnerName ?? "Malik Girilmemiş")
                            @if (sumLandShare > 0)
                            {
                                <span style="font-size: 0.8em; color: #555;"> (Pay: @unit.LandShare.ToString("0.##"))</span>
                            }
                        </td>
                        <td style="text-align: center;">@participationLabel</td>
                        <td style="text-align: center;">
                            @if (vote != null && vote.VoteChoice == "Kabul")
                            {
                                <strong>KABUL</strong>
                            }
                            else if (vote != null && vote.VoteChoice == "Ret")
                            {
                                <strong>RET</strong>
                                @if (!string.IsNullOrWhiteSpace(vote.DissentNote))
                                {
                                    <div style="font-size: 0.8em;">(@vote.DissentNote)</div>
                                }
                            }
                            else
                            {
                                <span>[ ] Kabul [ ] Ret</span>
                            }
                        </td>
                        <td style="text-align: center; font-size: 0.85em;">
                            @if (vote != null && vote.VotedAt.HasValue && vote.VoteChoice != "Pending")
                            {
                                <span>@(vote.ApprovalTraceCode ?? "ONAY")<br />@vote.VotedAt.Value.ToLocalTime().ToString("dd.MM.yy HH:mm")</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="sign-area"></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="signature-box">
            <div class="sign-col">
                <div>Divan / Yönetim Başkanı</div>
                <div class="sign-line">@chairText</div>
            </div>
            <div class="sign-col">
                <div>Azalar (Yönetim Kurulu)</div>
                <div class="sign-line">@azasText</div>
            </div>
            <div class="sign-col">
                <div>Denetim / Noter Onayı</div>
                <div class="sign-line">İmza / Mühür</div>
            </div>
        </div>

        <div class="seal-corner-note">
            <div>
                <strong>Doğrulama &amp; Defter İkizi Bütünlüğü:</strong> Sayfa #@displayPageNo • Karar #@displayDecNo (Doğrulama Kodu: <b>@Model.VerificationToken</b>).
                @if (!string.IsNullOrWhiteSpace(building?.DecisionBookNotaryName))
                {
                    <span>Noter: @building.DecisionBookNotaryName (Yevmiye: @(building.DecisionBookJournalNo ?? "-"))</span>
                }
            </div>
            <div id="decisionQrBox" style="width: 54px; height: 54px; flex-shrink: 0;"></div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        if (window.QRCode && '@verifyUrl') {
            new QRCode(document.getElementById("decisionQrBox"), {
                text: "@Html.Raw(verifyUrl)",
                width: 54,
                height: 54,
                correctLevel: QRCode.CorrectLevel.M
            });
        }
    </script>
</body>
</html>
