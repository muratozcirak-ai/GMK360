            fetch('/api/Location/Neighborhoods/' + distId)
                .then(r => r.json())
                .then(data => fillSelect('neighborhoodSelect', data, 'Mahalle Seçiniz'));
        });

        document.getElementById('neighborhoodSelect').addEventListener('change', function () {
