        function createDefaultStructure(index) {
            var rootName = document.getElementById('nameInput').value.trim() || 'Ana Bina';
            var mode = document.getElementById('managementModeInput').value;
            return {
                LayoutPattern: 'Tekil Yapı',
                BlockName: mode === 'Apartman' ? rootName : (String.fromCharCode(65 + index) + ' Blok'),
                BaseArea: 300,
                TotalFloors: 8,
                GroundApartments: 1,
                TotalApartments: 17,
                TotalShops: 2,
                BasementFloors: 1,
                HasGroundFloor: true,
                HasRoof: false,
                RoofType: 'Düz Teras Çatı (Tabliye)',
                IndoorCommonAreas: ['Hidrofor Odası', 'Pompa Odası', 'Sığınak', 'Depolama Alanı / Ardiye'],
                OutdoorCommonAreas: ['Kamelya / Çardak', 'Bahçe & Ağaç Peyzajı'],
                CommonSpaces: [
                    { Name: 'Hidrofor Odası', SpaceGroup: 'BinaIci', FloorLevel: -1, SquareMeters: null, Description: '' },
                    { Name: 'Pompa Odası', SpaceGroup: 'BinaIci', FloorLevel: -1, SquareMeters: null, Description: '' },
                    { Name: 'Sığınak', SpaceGroup: 'BinaIci', FloorLevel: -1, SquareMeters: null, Description: '' },
                    { Name: 'Depolama Alanı / Ardiye', SpaceGroup: 'BinaIci', FloorLevel: -1, SquareMeters: null, Description: '' },
                    { Name: 'Kamelya / Çardak', SpaceGroup: 'CevreDuzenleme', FloorLevel: -99, SquareMeters: null, Description: '' },
                    { Name: 'Bahçe & Ağaç Peyzajı', SpaceGroup: 'CevreDuzenleme', FloorLevel: -99, SquareMeters: null, Description: '' }
                ],
                _spacesInitialized: true,
                Children: []
            };
        }

        function guessDefaultFloorForSpace(name, spaceGroup) {
            if (spaceGroup === 'CevreDuzenleme') return -99;
            var low = (name || '').toLowerCase();
            if (low.indexOf('çatı') >= 0 || low.indexOf('teras') >= 0) return 99;
            if (low.indexOf('bodrum') >= 0 || low.indexOf('sığınak') >= 0 || low.indexOf('pompa') >= 0 || low.indexOf('hidrofor') >= 0 || low.indexOf('depo') >= 0 || low.indexOf('ardiye') >= 0 || low.indexOf('kömür') >= 0 || low.indexOf('kazan') >= 0 || low.indexOf('jeneratör') >= 0 || low.indexOf('garaj') >= 0) return -1;
            return 0;
        }

        function buildFloorSelectHtml(cls, selectedVal, allowOutdoor) {
            var opts = [
                { val: -1, lbl: '1. Bodrum (-1)' },
                { val: -2, lbl: '2. Bodrum (-2)' },
                { val: 0, lbl: 'Zemin Kat (0)' },
                { val: 99, lbl: 'Çatı Katı' }
            ];
            if (allowOutdoor) {
                opts.push({ val: -99, lbl: 'Bahçe / Dış Alan' });
            }
            var html = '<select class="form-select form-select-sm ' + cls + '">';
            opts.forEach(function (o) {
                html += '<option value="' + o.val + '"' + (parseInt(selectedVal, 10) === o.val ? ' selected' : '') + '>' + o.lbl + '</option>';
            });
            return html + '</select>';
        }

        function ensureStructureCommonSpaces(st) {
            if (!st.CommonSpaces || !Array.isArray(st.CommonSpaces)) {
                st.CommonSpaces = [];
            }
            if (st.CommonSpaces.length === 0 && !st._spacesInitialized) {
                var list = [];
                (st.IndoorCommonAreas || []).forEach(function (n) {
                    list.push({ Name: n, SpaceGroup: 'BinaIci', FloorLevel: guessDefaultFloorForSpace(n, 'BinaIci'), SquareMeters: null, Description: '' });
                });
                (st.OutdoorCommonAreas || []).forEach(function (n) {
                    list.push({ Name: n, SpaceGroup: 'CevreDuzenleme', FloorLevel: -99, SquareMeters: null, Description: '' });
                });
                if (list.length > 0) st.CommonSpaces = list;
                st._spacesInitialized = true;
            }
            st.CommonSpaces.forEach(function (cs) {
                if (cs.FloorLevel === undefined || cs.FloorLevel === null) {
                    cs.FloorLevel = guessDefaultFloorForSpace(cs.Name, cs.SpaceGroup);
                }
                cs.SpaceGroup = (parseInt(cs.FloorLevel, 10) === -99 || cs.SpaceGroup === 'CevreDuzenleme') ? 'CevreDuzenleme' : 'BinaIci';
            });
            return st.CommonSpaces;
        }

        function computeStructurePreviewText(floors, totalApts, groundApts, shops, hasGround, hasRoof) {
            floors = Math.max(0, floors || 0);
            totalApts = Math.max(0, totalApts || 0);
            groundApts = Math.max(0, groundApts || 0);
            shops = Math.max(0, shops || 0);
            if (!hasGround) groundApts = 0;
            var actualGroundApts = Math.min(groundApts, totalApts);
            var upperApts = Math.max(0, totalApts - actualGroundApts);
            var parts = [];
            if (hasGround) {
                parts.push('Zemin Kat: ' + actualGroundApts + ' Daire + ' + shops + ' Dükkan');
            } else if (shops > 0) {
                parts.push('Cadde Katı: ' + shops + ' Dükkan');
            }
            if (floors > 0 && upperApts > 0) {
                var perFloor = Math.floor(upperApts / floors);
                var rem = upperApts % floors;
                if (rem === 0) {
                    parts.push('1-' + floors + '. Normal Katlar: Her katta ' + perFloor + ' Daire');
                } else {
                    parts.push('1-' + floors + '. Normal Katlar: Kat başı ~' + perFloor + ' Daire (üst katta ' + (rem) + ' fark — eşit ' + (perFloor + 1) + ' daire/kat için Toplam Daire: ' + (actualGroundApts + floors * (perFloor + 1)) + ')');
                }
            } else if (floors > 0) {
                parts.push(floors + ' Normal Kat (Üstte konut seçilmedi)');
            }
            parts.push(hasRoof ? 'Çatı Katı / Teras Var' : 'Çatı Katı Yok');
            return parts.join(' • ');
        }

