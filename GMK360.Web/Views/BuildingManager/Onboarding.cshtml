                RoofType: 'Düz Teras Çatı (Tabliye)'
            };
        }

        function initStep2Structures() {
            var isSite = document.getElementById('managementModeInput').value === 'Site';
            var countInput = document.getElementById('structureCountInput');
            var hintEl = document.getElementById('structureCountHint');

            if (stateStructures.length === 0) {
                if (initialStructures && initialStructures.length > 0) {
                    stateStructures = JSON.parse(JSON.stringify(initialStructures));
                } else {
                    stateStructures = [createDefaultStructure(0)];
                }
            }

            if (!isSite) {
                stateStructures = [stateStructures[0]];
                countInput.value = 1;
                countInput.readOnly = true;
                hintEl.innerText = 'Apartman modunda tek bağımsız yapı tanımlanır. Birden fazla blok için Site türünü seçin.';
            } else {
                countInput.readOnly = false;
                countInput.value = stateStructures.length;
                hintEl.innerText = 'Aynı temel/podyum veya ayrı temellerdeki sınırsız yapıyı ekleyebilirsiniz (Ortak Baza + Kuleler, Tekil, Bitişik Nizam).';
            }

            renderStructures();
        }

        document.getElementById('structureCountInput').addEventListener('change', function () {
            if (this.readOnly) return;
            var targetCount = Math.max(1, Math.min(30, parseInt(this.value || '1', 10)));
            this.value = targetCount;
            syncStateFromDom();
            while (stateStructures.length < targetCount) {
                stateStructures.push(createDefaultStructure(stateStructures.length));
            }
            if (stateStructures.length > targetCount) {
                stateStructures = stateStructures.slice(0, targetCount);
            }
            renderStructures();
        });

        function renderStructures() {
            var isSite = document.getElementById('managementModeInput').value === 'Site';
            var container = document.getElementById('structuresContainer');
            container.innerHTML = '';

            stateStructures.forEach(function (st, idx) {
                var isPodium = st.LayoutPattern === 'Ortak Baza';
                var isAdjacent = st.LayoutPattern === 'Bitişik Nizam';
                var isMulti = isPodium || isAdjacent;

                if (isMulti && (!st.Children || st.Children.length === 0)) {
                    st.Children = [createDefaultChild(0), createDefaultChild(1)];
                }

                var html = '<div class="border border-primary-subtle rounded-4 p-4 bg-white shadow-xs structure-card" data-s-idx="' + idx + '">' +
                    '<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">' +
                    '  <h6 class="fw-bold text-primary mb-0"><i class="bi bi-building me-2"></i>' + (idx + 1) + '. Bağımsız Yapı (' + st.LayoutPattern + ')</h6>' +
                    '  <span class="badge bg-primary-subtle text-primary rounded-pill">' + st.LayoutPattern + '</span>' +
                    '</div>' +
                    '<div class="row g-3 mb-3">' +
                    '  <div class="col-md-4"><label class="form-label small fw-bold">Mimari Tarz</label>' +
                    '    <select class="form-select rounded-3 s-pattern" onchange="onPatternChange(' + idx + ', this.value)">' +
                    '      <option value="Tekil Yapı"' + (st.LayoutPattern === 'Tekil Yapı' ? ' selected' : '') + '>Tekil Yapı (Standart Apartman/Blok)</option>' +
                    (isSite ? '<option value="Ortak Baza"' + (isPodium ? ' selected' : '') + '>Ortak Baza + Kuleler (Podyum &amp; Rezidans)</option>' : '') +
                    (isSite ? '<option value="Bitişik Nizam"' + (isAdjacent ? ' selected' : '') + '>Bitişik Nizam (Tevhit Bloklar)</option>' : '') +
                    '    </select></div>' +
                    '  <div class="col-md-4"><label class="form-label small fw-bold">' + (isPodium ? 'Baza / Podyum Adı' : 'Yapı / Blok Adı') + '</label>' +
                    '    <input type="text" class="form-control rounded-3 s-name" value="' + escapeAttr(st.BlockName) + '" /></div>' +
                    '  <div class="col-md-4"><label class="form-label small fw-bold">Taban Oturumu (m²)</label>' +
                    '    <input type="number" class="form-control rounded-3 s-area" value="' + (st.BaseArea || '') + '" placeholder="Örn: 450" /></div>' +
                    '</div>';

                var commonSpaces = ensureStructureCommonSpaces(st);
                var hasSpace = function (name) {
                    return commonSpaces.some(function (cs) { return (cs.Name || '').toLowerCase() === name.toLowerCase(); });
                };

                if (!isAdjacent) {
                    var previewText = computeStructurePreviewText(st.TotalFloors, st.TotalApartments, st.GroundApartments || 0, st.TotalShops, st.HasGroundFloor, st.HasRoof);
                    html += '<div class="p-3 rounded-3 bg-light border mb-3">' +
                        '<div class="small fw-bold text-primary mb-2">' + (isPodium ? '1. BÖLÜM: ORTAK BAZA & PODYUM KATLARI (Otopark, Ticari)' : 'BLOK KAT & DAİRE DETAYLARI') + '</div>' +
                        '<div class="row g-2">' +
                        '  <div class="col-md-2"><label class="form-label small fw-bold">Normal Kat (Üst)</label><input type="number" class="form-control s-floors" min="0" value="' + st.TotalFloors + '" oninput="refreshLivePreview(' + idx + ')" /></div>' +
                        '  <div class="col-md-2"><label class="form-label small fw-bold">Toplam Daire</label><input type="number" class="form-control s-apts" min="0" value="' + st.TotalApartments + '" oninput="refreshLivePreview(' + idx + ')" /></div>' +
                        '  <div class="col-md-2"><label class="form-label small fw-bold">Zeminde Daire</label><input type="number" class="form-control s-ground-apts" min="0" value="' + (st.GroundApartments || 0) + '" oninput="refreshLivePreview(' + idx + ')" title="Örn: Zemin katta 1 daire + 2 dükkan varsa buraya 1 yazın" /></div>' +
                        '  <div class="col-md-2"><label class="form-label small fw-bold">Zeminde Dükkan</label><input type="number" class="form-control s-shops" min="0" value="' + st.TotalShops + '" oninput="refreshLivePreview(' + idx + ')" /></div>' +
                        '  <div class="col-md-2"><label class="form-label small fw-bold">Bodrum Kat</label><input type="number" class="form-control s-base" min="0" value="' + st.BasementFloors + '" oninput="refreshLivePreview(' + idx + ')" /></div>' +
                        '  <div class="col-md-2"><label class="form-label small fw-bold">Çatı / Teras Tipi</label>' + buildRoofSelect('s-roof', st.RoofType, !st.HasRoof) + '</div>' +
                        '  <div class="col-12 mt-2 d-flex flex-wrap gap-4">' +
                        '    <div class="form-check form-switch"><input class="form-check-input s-ground" type="checkbox"' + (st.HasGroundFloor ? ' checked' : '') + ' onchange="refreshLivePreview(' + idx + ')" /><label class="form-check-label small fw-semibold">Zemin Kat Mevcut (Zemin Daire + Dükkanlar Zemin Katta birleşik görünür)</label></div>' +
                        '    <div class="form-check form-switch"><input class="form-check-input s-has-roof" type="checkbox"' + (st.HasRoof ? ' checked' : '') + ' onchange="onHasRoofToggle(' + idx + ', this.checked)" /><label class="form-check-label small fw-semibold">Çatı Katı / Kullanılabilir Teras Var</label></div>' +
                        '  </div>' +
                        '  <div class="col-12 mt-2"><div class="alert alert-light border border-primary-subtle py-2 px-3 mb-0 small text-dark" id="livePreview-' + idx + '"><i class="bi bi-layers text-primary me-1"></i><strong>Kat Önizlemesi:</strong> <span class="preview-txt">' + previewText + '</span></div></div>' +
                        '</div></div>';
                } else {
                    html += '<input type="hidden" class="s-floors" value="0" /><input type="hidden" class="s-apts" value="0" /><input type="hidden" class="s-ground-apts" value="0" /><input type="hidden" class="s-shops" value="0" /><input type="hidden" class="s-base" value="0" />';
                }

                // Yalın İnşaat ERP Mantığı: Sihirbazda sadece yapının fiziksel mekanları (Ad + Kat + m²) tanımlanır; demirbaş/pompa/yangın tüpü Yönetim Masasından eklenir.
                var blockIndoorSpaces = isSite
                    ? commonSpaces.filter(function (cs) { return cs.SpaceGroup !== 'CevreDuzenleme' && parseInt(cs.FloorLevel, 10) !== -99; })
                    : commonSpaces;

                var indoorChips = ['Hidrofor Odası', 'Pompa Odası', 'Sığınak', 'Depolama Alanı / Ardiye', 'Eski Kazan Dairesi (Depo)', 'Jeneratör Odası', 'Kapalı Garaj', 'Kapıcı Dairesi'];
                var outdoorChips = !isSite ? ['Kamelya / Çardak', 'Bahçe & Ağaç Peyzajı', 'Bahçe Su Kuyusu', 'Çocuk Oyun Parkı'] : [];

                html += '<div class="p-3 rounded-3 border bg-white mb-3">' +
                    '  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">' +
                    '    <span class="small fw-bold text-dark"><i class="bi bi-building-gear text-primary me-1"></i>' + (isSite ? 'Bu Bloğa Ait Bina / Bodrum İçi Ortak Hacimler' : 'Bina, Bodrum &amp; Bahçe Ortak Hacimleri') + ' (' + blockIndoorSpaces.length + ' Mekan)</span>' +
                    '    <div class="d-flex align-items-center gap-2">' +
                    '      <span class="small text-muted d-none d-md-inline">İçine pompa/demirbaş/yangın tüpü Yönetim Masasından eklenir.</span>' +
                    (blockIndoorSpaces.length > 0 ? '<button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0" style="font-size:0.74rem;" onclick="clearStructureSpaces(' + idx + ')">Listeyi Temizle</button>' : '') +
                    '    </div>' +
                    '  </div>' +
                    '  <div class="d-flex flex-wrap gap-1 mb-2">' +
                    indoorChips.map(function (c) {
                        var exists = hasSpace(c);
                        return '<button type="button" class="btn btn-xs ' + (exists ? 'btn-primary' : 'btn-outline-secondary') + ' rounded-pill px-2 py-1" style="font-size:0.74rem;" onclick="togglePresetCommonSpace(' + idx + ', \'' + escapeAttr(c) + '\', \'BinaIci\', ' + (!exists) + ')">' + (exists ? '✓ ' : '+ ') + c + '</button>';
                    }).join('') +
                    outdoorChips.map(function (c) {
                        var exists = hasSpace(c);
                        return '<button type="button" class="btn btn-xs ' + (exists ? 'btn-success' : 'btn-outline-success') + ' rounded-pill px-2 py-1" style="font-size:0.74rem;" onclick="togglePresetCommonSpace(' + idx + ', \'' + escapeAttr(c) + '\', \'CevreDuzenleme\', ' + (!exists) + ')">' + (exists ? '✓ ' : '+ ') + c + '</button>';
                    }).join('') +
                    '  </div>';

                if (blockIndoorSpaces.length > 0) {
                    html += '  <div class="table-responsive mb-2">' +
                        '    <table class="table table-sm align-middle mb-0">' +
                        '      <thead class="table-light small"><tr><th>Mekan / Birim Adı</th><th style="width:170px;">Bulunduğu Kat</th><th style="width:110px;">Alan (m²)</th><th style="width:45px;"></th></tr></thead>' +
                        '      <tbody>' +
                        commonSpaces.map(function (cs, csIdx) {
                            if (isSite && (cs.SpaceGroup === 'CevreDuzenleme' || parseInt(cs.FloorLevel, 10) === -99)) return '';
                            return '<tr class="cs-row" data-cs-idx="' + csIdx + '">' +
                                '<td><input type="text" class="form-control form-control-sm fw-semibold cs-name" value="' + escapeAttr(cs.Name) + '" /></td>' +
                                '<td>' + buildFloorSelectHtml('cs-floor', cs.FloorLevel, !isSite) + '</td>' +
                                '<td><input type="number" step="0.5" min="0" class="form-control form-control-sm cs-sqm" value="' + (cs.SquareMeters != null ? cs.SquareMeters : '') + '" placeholder="m²" /></td>' +
                                '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeCommonSpaceRow(' + idx + ', ' + csIdx + ')" title="Kaldır"><i class="bi bi-x-lg"></i></button></td>' +
                                '</tr>';
                        }).join('') +
                        '      </tbody>' +
                        '    </table>' +
                        '  </div>';
                }

                html += '  <div class="row g-2 align-items-end pt-2 border-top bg-light bg-opacity-50 p-2 rounded-3">' +
                    '    <div class="col-md-5"><label class="form-label small fw-bold mb-1">Manuel Mekan / Oda Ekle</label><input type="text" class="form-control form-control-sm" id="customSpaceName-' + idx + '" placeholder="Örn: Pompa Odası, Ardiye, Kapıcı Dairesi..." /></div>' +
                    '    <div class="col-md-3"><label class="form-label small fw-bold mb-1">Bulunduğu Kat</label>' + buildFloorSelectHtml('form-select-sm" id="customSpaceFloor-' + idx, -1, !isSite) + '</div>' +
                    '    <div class="col-md-2"><label class="form-label small fw-bold mb-1">Alan (m²)</label><input type="number" step="0.5" min="0" class="form-control form-control-sm" id="customSpaceSqm-' + idx + '" placeholder="Örn: 25" /></div>' +
                    '    <div class="col-md-2 d-grid"><button type="button" class="btn btn-sm btn-primary fw-bold" onclick="addCustomCommonSpace(' + idx + ')">+ Ekle</button></div>' +
                    '  </div>' +
                    '</div>';

                if (isMulti) {
                    html += '<div class="p-3 rounded-3 border border-success-subtle bg-success bg-opacity-10">' +
                        '<div class="d-flex justify-content-between align-items-center mb-3">' +
                        '  <span class="fw-bold text-success small">' + (isPodium ? '2. BÖLÜM: BAZA ÜZERİNDE YÜKSELEN KULELER' : 'BİTİŞİK NİZAM BLOKLAR') + '</span>' +
                        '  <div class="d-flex align-items-center gap-2"><span class="small fw-semibold">Blok / Kule Sayısı:</span>' +
                        '    <input type="number" class="form-control form-control-sm text-center fw-bold" style="width:72px;" min="1" max="15" value="' + st.Children.length + '" onchange="onChildCountChange(' + idx + ', this.value)" /></div>' +
                        '</div>';

                    st.Children.forEach(function (ch, cIdx) {
                        html += '<div class="p-3 bg-white rounded-3 border mb-2 child-card" data-c-idx="' + cIdx + '">' +
                            '<div class="row g-2">' +
                            '  <div class="col-md-2"><label class="form-label small fw-bold">Blok / Kule Adı</label><input type="text" class="form-control c-name" value="' + escapeAttr(ch.BlockName) + '" /></div>' +
                            '  <div class="col-md-2"><label class="form-label small fw-bold">Normal Kat</label><input type="number" class="form-control c-floors" min="1" value="' + ch.TotalFloors + '" /></div>' +
                            '  <div class="col-md-2"><label class="form-label small fw-bold">Daire</label><input type="number" class="form-control c-apts" min="0" value="' + ch.TotalApartments + '" /></div>' +
                            '  <div class="col-md-2"><label class="form-label small fw-bold">Dükkan</label><input type="number" class="form-control c-shops" min="0" value="' + ch.TotalShops + '" /></div>' +
                            '  <div class="col-md-1"><label class="form-label small fw-bold">Bodrum</label><input type="number" class="form-control c-base" min="0" value="' + ch.BasementFloors + '" /></div>' +
                            '  <div class="col-md-1 d-flex align-items-end pb-1"><div class="form-check"><input class="form-check-input c-ground" type="checkbox"' + (ch.HasGroundFloor ? ' checked' : '') + ' /><label class="form-check-label small">Zemin</label></div></div>' +
                            '  <div class="col-md-2"><label class="form-label small fw-bold">Çatı Tipi</label>' + buildRoofSelect('c-roof', ch.RoofType, false) + '</div>' +
                            '</div></div>';
                    });
                    html += '</div>';
                }

                html += '</div>';
                container.insertAdjacentHTML('beforeend', html);
            });

            // SİTE MODUNDA DIŞ ÇEVRE & SOSYAL ALANLAR TEK ORTAK YERDE (BLOKLARDA TEKRARLANMAZ)
            if (isSite && stateStructures.length > 0) {
                var rootSpaces = ensureStructureCommonSpaces(stateStructures[0]);
                var siteOutdoorSpaces = rootSpaces.filter(function (cs) {
                    return cs.SpaceGroup === 'CevreDuzenleme' || parseInt(cs.FloorLevel, 10) === -99;
                });
                var siteOutdoorChips = ['Kamelya / Çardak', 'Bahçe & Ağaç Peyzajı', 'Çocuk Oyun Parkı', 'Bahçe Su Kuyusu', 'Açık Misafir Otoparkı', 'Güvenlik Kulübesi', 'Havuz / Sosyal Tesis'];
                var hasSiteOutdoor = function (n) {
                    return siteOutdoorSpaces.some(function (cs) { return (cs.Name || '').toLowerCase() === n.toLowerCase(); });
                };

                var siteHtml = '<div class="card border-success border-opacity-50 rounded-4 p-4 mb-4 bg-success bg-opacity-10 shadow-sm" id="siteSharedOutdoorCard">' +
                    '  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">' +
                    '    <div>' +
                    '      <h6 class="fw-bold text-success mb-0"><i class="bi bi-tree-fill me-2"></i>Site Ortak Dış Çevre &amp; Sosyal Alanları (Tüm Bloklar İçin Tek)</h6>' +
                    '      <small class="text-muted">Blokların kendi ekranlarında tekrarlanmaz; tüm site blokları bu ortak dış alanı paylaşır.</small>' +
                    '    </div>' +
                    '    <span class="badge bg-success text-white rounded-pill px-3 py-2">' + siteOutdoorSpaces.length + ' Ortak Dış Alan</span>' +
                    '  </div>' +
                    '  <div class="d-flex flex-wrap gap-1 mb-3">' +
                    siteOutdoorChips.map(function (c) {
                        var ex = hasSiteOutdoor(c);
                        return '<button type="button" class="btn btn-xs ' + (ex ? 'btn-success' : 'btn-outline-success bg-white') + ' rounded-pill px-2 py-1" style="font-size:0.75rem;" onclick="togglePresetCommonSpace(0, \'' + escapeAttr(c) + '\', \'CevreDuzenleme\', ' + (!ex) + ')">' + (ex ? '✓ ' : '+ ') + c + '</button>';
                    }).join('') +
                    '  </div>' +
                    '  <div class="bg-white rounded-3 p-3 border">';

                if (siteOutdoorSpaces.length > 0) {
                    siteHtml += '<div class="table-responsive mb-2"><table class="table table-sm align-middle mb-0">' +
                        '<thead class="table-light small"><tr><th>Ortak Dış Alan / Donatı Adı</th><th style="width:120px;">Alan (m²)</th><th style="width:45px;"></th></tr></thead><tbody>' +
                        rootSpaces.map(function (cs, csIdx) {
                            if (cs.SpaceGroup !== 'CevreDuzenleme' && parseInt(cs.FloorLevel, 10) !== -99) return '';
                            return '<tr class="site-out-row">' +
                                '<td><input type="text" class="form-control form-control-sm fw-semibold so-name" value="' + escapeAttr(cs.Name) + '" /></td>' +
                                '<td><input type="number" step="0.5" min="0" class="form-control form-control-sm so-sqm" value="' + (cs.SquareMeters != null ? cs.SquareMeters : '') + '" placeholder="m²" /></td>' +
                                '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeCommonSpaceRow(0, ' + csIdx + ')" title="Kaldır"><i class="bi bi-x-lg"></i></button></td>' +
                                '</tr>';
                        }).join('') +
                        '</tbody></table></div>';
                }

                siteHtml += '<div class="row g-2 align-items-end pt-2 border-top">' +
                    '  <div class="col-md-7"><label class="form-label small fw-bold mb-1">Özel Site Dış Alanı Ekle</label><input type="text" class="form-control form-control-sm" id="siteCustomOutdoorName" placeholder="Örn: Kuzey Kamelya, Site Su Kuyusu..." /></div>' +
                    '  <div class="col-md-3"><label class="form-label small fw-bold mb-1">Alan (m²)</label><input type="number" step="0.5" min="0" class="form-control form-control-sm" id="siteCustomOutdoorSqm" placeholder="m²" /></div>' +
                    '  <div class="col-md-2 d-grid"><button type="button" class="btn btn-sm btn-success fw-bold" onclick="addSiteOutdoorSpace()">+ Ekle</button></div>' +
                    '</div></div></div>';

                container.insertAdjacentHTML('beforeend', siteHtml);
            }
        }

        function clearStructureSpaces(idx) {
            syncStateFromDom();
            var st = stateStructures[idx];
            if (!st) return;
            var isSite = document.getElementById('managementModeInput').value === 'Site';
            if (isSite && idx === 0) {
                st.CommonSpaces = (st.CommonSpaces || []).filter(function (cs) {
                    return cs.SpaceGroup === 'CevreDuzenleme' || parseInt(cs.FloorLevel, 10) === -99;
                });
            } else {
                st.CommonSpaces = [];
            }
            st._spacesInitialized = true;
            renderStructures();
        }

        function addSiteOutdoorSpace() {
            syncStateFromDom();
            var nameEl = document.getElementById('siteCustomOutdoorName');
            var sqmEl = document.getElementById('siteCustomOutdoorSqm');
            var name = (nameEl?.value || '').trim();
            if (!name || !stateStructures[0]) return;
            var list = ensureStructureCommonSpaces(stateStructures[0]);
            list.push({
                Name: name,
                SpaceGroup: 'CevreDuzenleme',
                FloorLevel: -99,
                SquareMeters: sqmEl && sqmEl.value !== '' ? (parseFloat(sqmEl.value) || null) : null,
                Description: ''
            });
            stateStructures[0]._spacesInitialized = true;
            renderStructures();
        }

        function buildRoofSelect(cls, selectedVal, isDisabled) {
            var opts = ['Düz Teras Çatı (Tabliye)', 'Eğimli Kiremit', 'Eğimli Saç / Sandviç', 'Podyum Terası / Peyzaj', 'Çatı Dubleksi', 'Çatı Katı Yok (Teras Yok)'];
            var html = '<select class="form-select ' + cls + '"' + (isDisabled ? ' disabled' : '') + '>';
            opts.forEach(function (o) {
                html += '<option value="' + o + '"' + (selectedVal === o ? ' selected' : '') + '>' + o + '</option>';
            });
            return html + '</select>';
        }

        function onHasRoofToggle(idx, checked) {
            syncStateFromDom();
            stateStructures[idx].HasRoof = !!checked;
            if (!checked) {
                stateStructures[idx].RoofType = 'Çatı Katı Yok (Teras Yok)';
                stateStructures[idx].CommonSpaces = (stateStructures[idx].CommonSpaces || []).filter(function (cs) {
                    return (cs.Name || '').toLowerCase().indexOf('çatı') !== 0;
                });
            } else if (stateStructures[idx].RoofType === 'Çatı Katı Yok (Teras Yok)') {
                stateStructures[idx].RoofType = 'Düz Teras Çatı (Tabliye)';
            }
            renderStructures();
        }

        function refreshLivePreview(idx) {
            var card = document.querySelector('.structure-card[data-s-idx="' + idx + '"]');
            if (!card) return;
            var floors = parseInt(card.querySelector('.s-floors')?.value || '0', 10) || 0;
            var totalApts = parseInt(card.querySelector('.s-apts')?.value || '0', 10) || 0;
            var groundApts = parseInt(card.querySelector('.s-ground-apts')?.value || '0', 10) || 0;
            var shops = parseInt(card.querySelector('.s-shops')?.value || '0', 10) || 0;
            var hasGround = !!card.querySelector('.s-ground')?.checked;
            var hasRoof = !!card.querySelector('.s-has-roof')?.checked;
            var txtEl = card.querySelector('#livePreview-' + idx + ' .preview-txt');
            if (txtEl) {
                txtEl.textContent = computeStructurePreviewText(floors, totalApts, groundApts, shops, hasGround, hasRoof);
            }
        }

        function togglePresetCommonSpace(idx, name, spaceGroup, isChecked) {
            syncStateFromDom();
            var list = ensureStructureCommonSpaces(stateStructures[idx]);
            stateStructures[idx]._spacesInitialized = true;
            var existingIdx = list.findIndex(function (x) { return (x.Name || '').toLowerCase() === name.toLowerCase(); });
            if (isChecked && existingIdx < 0) {
                list.push({ Name: name, SpaceGroup: spaceGroup, FloorLevel: guessDefaultFloorForSpace(name, spaceGroup), SquareMeters: null, Description: '' });
            } else if (!isChecked && existingIdx >= 0) {
                list.splice(existingIdx, 1);
            }
            renderStructures();
        }

        function addCustomCommonSpace(idx) {
            syncStateFromDom();
            var nameEl = document.getElementById('customSpaceName-' + idx);
            var flrEl = document.getElementById('customSpaceFloor-' + idx);
            var sqmEl = document.getElementById('customSpaceSqm-' + idx);
            var name = (nameEl?.value || '').trim();
            if (!name) {
                alert('Lütfen mekan / oda adını girin.');
                return;
            }
            var flrVal = parseInt(flrEl?.value ?? '-1', 10);
            var grpVal = flrVal === -99 ? 'CevreDuzenleme' : 'BinaIci';
            var list = ensureStructureCommonSpaces(stateStructures[idx]);
            stateStructures[idx]._spacesInitialized = true;
            list.push({
                Name: name,
                SpaceGroup: grpVal,
                FloorLevel: isNaN(flrVal) ? -1 : flrVal,
                SquareMeters: sqmEl && sqmEl.value !== '' ? (parseFloat(sqmEl.value) || null) : null,
                Description: ''
            });
            renderStructures();
        }

        function removeCommonSpaceRow(idx, csIdx) {
            syncStateFromDom();
            var list = ensureStructureCommonSpaces(stateStructures[idx]);
            stateStructures[idx]._spacesInitialized = true;
            list.splice(csIdx, 1);
            renderStructures();
        }

        function escapeAttr(str) {
            return (str || '').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        }

        function onPatternChange(idx, newPattern) {
            syncStateFromDom();
            stateStructures[idx].LayoutPattern = newPattern;
            renderStructures();
        }

        function onChildCountChange(idx, newCount) {
            syncStateFromDom();
            var target = Math.max(1, Math.min(15, parseInt(newCount || '2', 10)));
            var arr = stateStructures[idx].Children || [];
            while (arr.length < target) arr.push(createDefaultChild(arr.length));
            stateStructures[idx].Children = arr.slice(0, target);
            renderStructures();
        }

        function syncStateFromDom() {
            var isSiteMode = document.getElementById('managementModeInput')?.value === 'Site';
            document.querySelectorAll('.structure-card').forEach(function (card) {
                var idx = parseInt(card.getAttribute('data-s-idx'), 10);
                var st = stateStructures[idx];
                if (!st) return;
                st.BlockName = card.querySelector('.s-name')?.value?.trim() || 'Ana Bina';
                st.BaseArea = parseFloat(card.querySelector('.s-area')?.value || '') || null;
                st.TotalFloors = parseInt(card.querySelector('.s-floors')?.value || '0', 10) || 0;
                st.GroundApartments = parseInt(card.querySelector('.s-ground-apts')?.value || '0', 10) || 0;
                st.TotalApartments = parseInt(card.querySelector('.s-apts')?.value || '0', 10) || 0;
                st.TotalShops = parseInt(card.querySelector('.s-shops')?.value || '0', 10) || 0;
                st.BasementFloors = parseInt(card.querySelector('.s-base')?.value || '0', 10) || 0;
                var groundEl = card.querySelector('.s-ground');
                if (groundEl) st.HasGroundFloor = groundEl.checked;
                var hasRoofEl = card.querySelector('.s-has-roof');
                if (hasRoofEl) st.HasRoof = hasRoofEl.checked;
                var roofEl = card.querySelector('.s-roof');
                if (roofEl) st.RoofType = st.HasRoof ? roofEl.value : 'Çatı Katı Yok (Teras Yok)';

                var csRows = [];
                card.querySelectorAll('.cs-row').forEach(function (row) {
                    var n = (row.querySelector('.cs-name')?.value || '').trim();
                    if (!n) return;
                    var flrVal = parseInt(row.querySelector('.cs-floor')?.value ?? '-1', 10);
                    flrVal = isNaN(flrVal) ? -1 : flrVal;
                    var grp = flrVal === -99 ? 'CevreDuzenleme' : 'BinaIci';
                    var sqmRaw = row.querySelector('.cs-sqm')?.value;
                    var sqm = (sqmRaw !== undefined && sqmRaw !== null && sqmRaw !== '') ? (parseFloat(sqmRaw) || null) : null;
                    csRows.push({ Name: n, SpaceGroup: grp, FloorLevel: flrVal, SquareMeters: sqm, Description: '' });
                });

                if (isSiteMode && idx === 0) {
                    document.querySelectorAll('#siteSharedOutdoorCard .site-out-row').forEach(function (row) {
                        var n = (row.querySelector('.so-name')?.value || '').trim();
                        if (!n) return;
                        var sqmRaw = row.querySelector('.so-sqm')?.value;
                        var sqm = (sqmRaw !== undefined && sqmRaw !== null && sqmRaw !== '') ? (parseFloat(sqmRaw) || null) : null;
                        csRows.push({ Name: n, SpaceGroup: 'CevreDuzenleme', FloorLevel: -99, SquareMeters: sqm, Description: '' });
                    });
                }

                st.CommonSpaces = csRows;
                st._spacesInitialized = true;
                st.IndoorCommonAreas = csRows.filter(function (x) { return x.SpaceGroup !== 'CevreDuzenleme'; }).map(function (x) { return x.Name; });
                st.OutdoorCommonAreas = csRows.filter(function (x) { return x.SpaceGroup === 'CevreDuzenleme'; }).map(function (x) { return x.Name; });

                if (st.LayoutPattern !== 'Tekil Yapı') {
                    var children = [];
                    card.querySelectorAll('.child-card').forEach(function (cc) {
                        children.push({
                            BlockName: cc.querySelector('.c-name')?.value?.trim() || 'Blok',
                            TotalFloors: parseInt(cc.querySelector('.c-floors')?.value || '1', 10) || 1,
                            TotalApartments: parseInt(cc.querySelector('.c-apts')?.value || '0', 10) || 0,
                            TotalShops: parseInt(cc.querySelector('.c-shops')?.value || '0', 10) || 0,
                            BasementFloors: parseInt(cc.querySelector('.c-base')?.value || '0', 10) || 0,
                            HasGroundFloor: !!cc.querySelector('.c-ground')?.checked,
                            HasRoof: true,
                            RoofType: cc.querySelector('.c-roof')?.value || 'Düz Teras Çatı (Tabliye)'
                        });
                    });
                    st.Children = children;
                } else {
                    st.Children = [];
                }
            });
        }

        function goToStep3Review() {
            syncStateFromDom();
            var sumContainer = document.getElementById('summaryCardsContainer');
            sumContainer.innerHTML = '';

            var totalBlocks = 0, totalApts = 0, totalShops = 0;

            stateStructures.forEach(function (st) {
                var sBlocks = st.LayoutPattern === 'Tekil Yapı' ? 1 : (st.Children?.length || 0);
                var sApts = st.TotalApartments + (st.Children || []).reduce((a, c) => a + c.TotalApartments, 0);
                var sShops = st.TotalShops + (st.Children || []).reduce((a, c) => a + c.TotalShops, 0);
                totalBlocks += sBlocks;
                totalApts += sApts;
                totalShops += sShops;

                var childrenHtml = '';
                if (st.Children && st.Children.length > 0) {
                    childrenHtml = '<div class="d-flex flex-wrap gap-2 mt-2">';
                    if (st.LayoutPattern === 'Ortak Baza') {
                        childrenHtml += '<span class="badge bg-primary text-white px-3 py-2">Baza: ' + st.TotalFloors + ' Kat | ' + st.TotalShops + ' Dükkan</span>';
                    }
                    st.Children.forEach(function (c) {
                        childrenHtml += '<span class="badge bg-light text-dark border px-3 py-2">' + c.BlockName + ': ' + c.TotalFloors + ' Kat | ' + c.TotalApartments + ' Daire, ' + c.TotalShops + ' Dükkan</span>';
                    });
                    childrenHtml += '</div>';
                }

                sumContainer.insertAdjacentHTML('beforeend',
                    '<div class="p-3 rounded-4 border bg-white">' +
                    '  <div class="d-flex justify-content-between align-items-center">' +
                    '    <div class="fw-bold text-dark">' + st.BlockName + ' <span class="badge bg-primary-subtle text-primary ms-2">' + st.LayoutPattern + '</span></div>' +
                    '    <div class="small fw-bold text-success">' + sApts + ' Daire, ' + sShops + ' Dükkan</div>' +
                    '  </div>' + childrenHtml +
                    '</div>');
            });

            document.getElementById('sumTotalBlocks').innerText = totalBlocks + ' Blok';
            document.getElementById('sumTotalApts').innerText = totalApts + ' Daire';
            document.getElementById('sumTotalShops').innerText = totalShops + ' Dükkan';

            var isSite = document.getElementById('managementModeInput').value === 'Site';
            var totalLivingUnits = totalApts + totalShops;
            var tierName = 'Apartman Başlangıç', price = 5000, desc = 'Tekil bina (1 blok, 30 daire altı)';
            if (!isSite && totalBlocks <= 1) {
                if (totalLivingUnits >= 30) {
                    tierName = 'Geniş Apartman'; price = 7500; desc = 'Tekil bina (1 blok, 30 birim ve üstü)';
                }
            } else if (totalLivingUnits < 30) {
                tierName = 'Küçük Site / Villa Grubu'; price = 7500; desc = totalBlocks + ' bloklu, 30 birim altı (villa / butik site)';
            } else if (totalBlocks >= 3 && totalLivingUnits >= 100) {
                tierName = 'Büyük Çok Bloklu Site'; price = 15000; desc = totalBlocks + ' bloklu, ' + totalLivingUnits + ' birimli büyük yerleşke';
            } else {
                tierName = 'Orta Ölçekli Site'; price = 10000; desc = totalBlocks + ' bloklu, ' + totalLivingUnits + ' birimli site';
            }

            document.getElementById('sumPricingPrice').innerText = tierName + ' • ' + price.toLocaleString('tr-TR') + ' TL / yıl';
            document.getElementById('sumPricingDesc').innerText = desc;

            var hasDecisionDoc = !!document.querySelector('#decisionDocPreview [data-doc-id]');
            var authBox = document.getElementById('sumAuthorityBox');
            if (hasDecisionDoc) {
                authBox.className = 'p-3 rounded-4 border border-success-subtle bg-success bg-opacity-10 h-100';
                document.getElementById('sumAuthorityStatus').innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Yetki Belgesi Yüklü (Canlı Yayına Hazır)</span>';
                document.getElementById('sumAuthorityHint').innerText = 'Sakin telefon/e-posta kaydı ve dijital davet gönderimi açık olacak.';
            } else {
                authBox.className = 'p-3 rounded-4 border border-warning-subtle bg-warning bg-opacity-10 h-100';
                document.getElementById('sumAuthorityStatus').innerHTML = '<span class="text-warning-emphasis"><i class="bi bi-shield-exclamation me-1"></i>Taslak / Demo Modu (Yetki Belgesi Bekliyor)</span>';
                document.getElementById('sumAuthorityHint').innerText = 'Yapı oluşturulur; ancak KVKK gereği sakin telefonları Adım 1\'den Karar Defteri yüklenene kadar kilitli kalır.';
            }

            goToStep(3);
        }

        async function submitFacilityStep2() {
            syncStateFromDom();
            showAlert('step3ErrorAlert', '');
            if (!document.getElementById('kvkkConsentCheck').checked) {
                showAlert('step3ErrorAlert', 'Devam etmek için KMK & KVKK Yönetici Yetki Beyanı kutusunu işaretlemelisiniz.');
                return;
            }
            var btn = document.getElementById('btnFinishWizard');
            var origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Yapı Oluşturuluyor...';

            try {
                var payload = {
                    BuildingId: parseInt(document.getElementById('buildingIdInput').value || '0', 10),
                    ManagementMode: document.getElementById('managementModeInput').value,
                    KvkkAuthorityAccepted: true,
                    Structures: stateStructures
                };

                var res = await fetch('/BuildingManager/SaveFacilityStep2', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                var rawText = await res.text();
                var data = null;
                try { data = rawText ? JSON.parse(rawText) : null; } catch (_) { }

                if (!res.ok || !data || !data.success) {
                    var errMsg = (data && data.message)
                        ? data.message
                        : ('Sunucu hatası (HTTP ' + res.status + '). Lütfen tekrar deneyin.');
                    showAlert('step3ErrorAlert', errMsg);
                    return;
                }
                window.location.href = data.redirectUrl || ('/BuildingManager/Detail/' + payload.BuildingId);
            } catch (err) {
                showAlert('step3ErrorAlert', 'İstek gönderilirken bağlantı hatası oluştu: ' + (err?.message || err));
            } finally {
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        }
    </script>
}
