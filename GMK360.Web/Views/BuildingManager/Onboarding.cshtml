        function getSelectedStreetText() {
            var customInp = document.getElementById('customStreetInput');
            if (!customInp.classList.contains('d-none') && customInp.value.trim()) {
                return customInp.value.trim();
            }
            var streetSel = document.getElementById('streetSelect');
            if (streetSel.value && streetSel.selectedIndex >= 0) {
                return streetSel.options[streetSel.selectedIndex].text;
            }
            return '';
        }

        function checkDuplicateAddress() {
            var cityId = document.getElementById('citySelect').value;
            var distId = document.getElementById('districtSelect').value;
            var neighId = document.getElementById('neighborhoodSelect').value;
            var streetId = document.getElementById('streetSelect').value;
            var streetName = getSelectedStreetText();
            var bNo = document.getElementById('buildingNumberInput').value.trim();
            var bId = document.getElementById('buildingIdInput').value;

            if (!cityId || !distId || !neighId || !bNo || (!streetId && !streetName)) {
                isDuplicateBlocked = false;
                document.getElementById('duplicateAddressAlert').classList.add('d-none');
                return;
            }

            var qs = new URLSearchParams({
                cityId: cityId,
                districtId: distId,
                neighborhoodId: neighId,
                streetId: streetId || '',
                streetName: streetName,
                buildingNumber: bNo,
                excludeBuildingId: bId || ''
            });

            fetch('/BuildingManager/CheckDuplicateAddress?' + qs.toString())
                .then(r => r.json())
                .then(res => {
                    var box = document.getElementById('duplicateAddressAlert');
                    if (res.exists) {
                        isDuplicateBlocked = true;
                        document.getElementById('duplicateAddressMessage').innerText = res.message;
                        box.classList.remove('d-none');
                    } else {
                        isDuplicateBlocked = false;
                        box.classList.add('d-none');
                    }
                });
        }

        // Harita seçimi
        function openMapModal() {
            var modal = new bootstrap.Modal(document.getElementById('mapPickerModal'));
            modal.show();
            setTimeout(function () {
                var lat = parseFloat(document.getElementById('latInput').value) || 41.0082;
                var lng = parseFloat(document.getElementById('lngInput').value) || 28.9784;
                if (!mapInstance) {
                    mapInstance = L.map('wizardMap').setView([lat, lng], 15);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(mapInstance);
                    mapMarker = L.marker([lat, lng], { draggable: true }).addTo(mapInstance);
                    mapInstance.on('click', function (e) {
                        tempLat = e.latlng.lat;
                        tempLng = e.latlng.lng;
                        mapMarker.setLatLng(e.latlng);
                    });
                    mapMarker.on('dragend', function () {
                        var pos = mapMarker.getLatLng();
                        tempLat = pos.lat;
                        tempLng = pos.lng;
                    });
                } else {
                    mapInstance.invalidateSize();
                    mapInstance.setView([lat, lng], 15);
                    mapMarker.setLatLng([lat, lng]);
                }
                tempLat = lat;
                tempLng = lng;

                if (!document.getElementById('latInput').value) {
                    geocodeCurrentAddressAndFocus();
                }
            }, 300);
        }

        function setMapPin(lat, lng, zoom) {
            if (!mapInstance || !mapMarker) return;
            mapInstance.setView([lat, lng], zoom);
            mapMarker.setLatLng([lat, lng]);
            tempLat = lat;
            tempLng = lng;
        }

        function cleanGeoNeighborhood(raw) {
            if (!raw || /seçin|yükleniyor/i.test(raw)) return '';
            return raw.replace(/\([^)]*\)/g, '')
                .replace(/\bMAHALLESİ\b|\bMAHALLESI\b|\bMAH\.?\b/gi, '')
                .trim();
        }

        function cleanGeoStreet(raw) {
            if (!raw || /seçin|yükleniyor/i.test(raw)) return '';
            var base = raw.replace(/\([^)]*\)/g, '').trim();
            var hadTypeInParens = /\(([^)]+)\)/.exec(raw);
            base = base
                .replace(/\bSK\.?\b|\bSOK\.?\b|\bSOKAK\b/gi, 'Sokağı')
                .replace(/\bCD\.?\b|\bCAD\.?\b|\bCADDE\b/gi, 'Caddesi')
                .replace(/\bBLV\.?\b|\bBULVAR\b/gi, 'Bulvarı')
                .trim();
            if (base && !/(sokağı|sokak|caddesi|cadde|bulvarı|bulvar|yolu|çıkmazı|meydanı)/i.test(base)) {
                var suffix = hadTypeInParens && /cadde/i.test(hadTypeInParens[1]) ? ' Caddesi'
                    : (hadTypeInParens && /bulvar/i.test(hadTypeInParens[1]) ? ' Bulvarı' : ' Sokağı');
                base += suffix;
            }
            return base;
        }

        function geocodeCurrentAddressAndFocus() {
            var cityTxt = selectedText('citySelect');
            var distTxt = selectedText('districtSelect');
            var neighTxt = cleanGeoNeighborhood(selectedText('neighborhoodSelect'));
            var streetTxt = cleanGeoStreet(getSelectedStreetText());
            var doorNo = (document.getElementById('buildingNumberInput').value || '').trim();
            if (!cityTxt) return;

            var zoomTarget = streetTxt ? (doorNo ? 18 : 17) : (neighTxt ? 15 : 13);
            var arcLine = [
                streetTxt ? (streetTxt + (doorNo ? ' No:' + doorNo : '')) : '',
                neighTxt ? (neighTxt + ' Mahallesi') : '',
                distTxt,
                cityTxt,
                'Türkiye'
            ].filter(Boolean).join(', ');

            var tryNominatim = function (q, zoom) {
                if (!q) return;
                fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=tr&q=' + encodeURIComponent(q))
                    .then(r => r.json())
                    .then(pts => {
                        if (pts && pts.length > 0) {
                            setMapPin(parseFloat(pts[0].lat), parseFloat(pts[0].lon), zoom);
                        } else if (streetTxt && q.indexOf(streetTxt) !== -1 && neighTxt) {
                            tryNominatim([neighTxt + ' Mahallesi', distTxt, cityTxt, 'Türkiye'].filter(Boolean).join(', '), 15);
                        } else if (neighTxt && q.indexOf(neighTxt) !== -1 && distTxt) {
                            tryNominatim([distTxt, cityTxt, 'Türkiye'].filter(Boolean).join(', '), 13);
                        }
                    }).catch(function () { });
            };

            fetch('https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?f=json&maxLocations=3&countryCode=TUR&SingleLine=' + encodeURIComponent(arcLine))
                .then(r => r.json())
                .then(arc => {
                    if (arc && arc.candidates && arc.candidates.length > 0 && arc.candidates[0].score >= 75) {
                        var loc = arc.candidates[0].location;
                        setMapPin(loc.y, loc.x, zoomTarget);
                    } else {
                        var nomQuery = [streetTxt, neighTxt ? (neighTxt + ' Mahallesi') : '', distTxt, cityTxt, 'Türkiye'].filter(Boolean).join(', ');
                        tryNominatim(nomQuery, zoomTarget);
                    }
                })
                .catch(function () {
                    var nomQuery = [streetTxt, neighTxt ? (neighTxt + ' Mahallesi') : '', distTxt, cityTxt, 'Türkiye'].filter(Boolean).join(', ');
                    tryNominatim(nomQuery, zoomTarget);
                });
        }

        function selectedText(id) {
            var s = document.getElementById(id);
            return s && s.value && s.selectedIndex >= 0 ? s.options[s.selectedIndex].text : '';
        }

        function confirmMapLocation() {
