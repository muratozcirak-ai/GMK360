@model GMK360.Web.Models.FacilityWizardPageViewModel
@{
    ViewData["Title"] = "Apartman / Site Kurulum Sihirbazı";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    bool isSite = string.Equals(Model.ManagementMode, "Site", StringComparison.OrdinalIgnoreCase);
    var initialStructuresJson = System.Text.Json.JsonSerializer.Serialize(Model.InitialStructures ?? new List<GMK360.Web.Models.FacilityStep2StructureDto>());
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <style>
        .wizard-step { display: none; }
        .wizard-step.active { display: block; animation: wizardFade 0.25s ease-out; }
        @@keyframes wizardFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        .step-pill {
            width: 40px; height: 40px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; background: #e2e8f0; color: #64748b; transition: all 0.25s;
        }
        .step-pill.active { background: #15803d; color: #fff; box-shadow: 0 0 0 5px rgba(21, 128, 61, 0.18); }
        .step-pill.done { background: #16a34a; color: #fff; }
        .step-connector { flex: 1; height: 3px; background: #e2e8f0; margin: 0 12px; transition: background 0.25s; }
        .step-connector.done { background: #16a34a; }
        .photo-thumb-card { position: relative; width: 112px; height: 84px; border-radius: 10px; overflow: hidden; border: 1px solid #cbd5e1; background: #f8fafc; }
        .photo-thumb-card img { width: 100%; height: 100%; object-fit: cover; }
        .photo-thumb-remove { position: absolute; top: 4px; right: 4px; width: 22px; height: 22px; padding: 0; border-radius: 50%; font-size: 0.7rem; line-height: 1; }
    </style>
}

<div class="py-1">
    @Html.AntiForgeryToken()

    <!-- Üst Başlık & Geri Dön -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-building-gear text-success me-2"></i>
                @(Model.BuildingId > 0 ? $"{Model.Name} — Yapı & Blok Sihirbazı" : "Apartman / Site Kurulum Sihirbazı")
            </h3>
            <small class="text-muted">Tekil Merkez Adres ID, Karar Defteri yetkisi ve mimari blok düzeniyle yapınızı oluşturun.</small>
        </div>
        <a href="/BuildingManager/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Genel Merkeze Dön
        </a>
    </div>

    <!-- 3 Adımlı Stepper -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="step-pill active" id="ind-1">1</div>
                    <div class="d-none d-sm-block">
                        <div class="fw-bold small text-dark">Künye &amp; Tekil Adres ID</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Konum, görseller &amp; karar yazısı</div>
                    </div>
                </div>
                <div class="step-connector" id="conn-1"></div>
                <div class="d-flex align-items-center gap-2">
                    <div class="step-pill" id="ind-2">2</div>
                    <div class="d-none d-sm-block">
                        <div class="fw-bold small text-dark">Blok &amp; Yapı Dağılımı</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Tekil, Ortak Baza veya Bitişik</div>
                    </div>
                </div>
                <div class="step-connector" id="conn-2"></div>
                <div class="d-flex align-items-center gap-2">
                    <div class="step-pill" id="ind-3"><i class="bi bi-check-lg"></i></div>
                    <div class="d-none d-sm-block">
                        <div class="fw-bold small text-dark">Özet &amp; Oluştur</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Daireler &amp; ortak alanlar</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ADIM 1: KÜNYE, TEKİL MERKEZ ADRES ID, ÇOKLU FOTOĞRAF & KARAR DEFTERİ -->
    <div class="wizard-step active" id="step1">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <input type="hidden" id="buildingIdInput" value="@Model.BuildingId" />

                <!-- Yapı Türü & Temel Kimlik -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-dark">Yönetim Türü *</label>
                        <select id="managementModeInput" class="form-select rounded-3" @(Model.BuildingId > 0 ? "disabled" : "")>
                            @if (isSite)
                            {
                                <option value="Apartman">Apartman (Tek Bağımsız Bina)</option>
                                <option value="Site" selected>Site / Çoklu Blok (Sınırsız Yapı)</option>
                            }
                            else
                            {
                                <option value="Apartman" selected>Apartman (Tek Bağımsız Bina)</option>
                                <option value="Site">Site / Çoklu Blok (Sınırsız Yapı)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-dark" id="step1NameLabel">@(isSite ? "Site / Yerleşke Adı *" : "Apartman / Bina Adı *")</label>
                        <input type="text" id="nameInput" class="form-control rounded-3" value="@Model.Name" placeholder="Örn: Aydemir Apartmanı" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-dark">Bina Yapım Yılı / Yaşı <span class="text-muted fw-normal small">(Opsiyonel)</span></label>
                        <input type="number" id="buildingAgeInput" class="form-control rounded-3" value="@Model.BuildingAge" placeholder="Örn: 2018" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-bold text-dark">Kısa Açıklama / Yönetim Notu</label>
                        <input type="text" id="descriptionInput" class="form-control rounded-3" value="@Model.Description" placeholder="Örn: Merkezi sistem doğalgazlı, kapalı otoparklı 2 bloklu site" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-dark">Yönetim Vergi No <span class="text-muted fw-normal small">(Opsiyonel)</span></label>
                        <input type="text" id="taxNumberInput" class="form-control rounded-3" value="@Model.TaxNumber" maxlength="11" placeholder="Varsa 10 haneli VKN" />
                    </div>
                </div>

                <hr class="my-4" />

                <!-- 5'li Tekil Merkez Adres ID -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Tekil Merkez Adres ID &amp; Harita Konumu</h5>
                        <small class="text-muted"><strong>İl + İlçe + Sokak + Bina/Kapı No</strong> merkezi tekil kimliktir; aynı adrese mükerrer bina açılamaz.</small>
                    </div>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1">5'li Tekil Adres Standardı</span>
                </div>

                <div id="duplicateAddressAlert" class="alert alert-warning border-warning d-none rounded-3 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                        <div>
                            <div class="fw-bold">Merkez Adres Kaydı Zaten Mevcut (Mükerrer Engeli)</div>
                            <div class="small" id="duplicateAddressMessage"></div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">İl *</label>
                        <select id="citySelect" class="form-select rounded-3" asp-items="ViewBag.Cities" required>
                            <option value="">İl Seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">İlçe *</label>
                        <select id="districtSelect" class="form-select rounded-3" asp-items="ViewBag.Districts" required>
                            <option value="">İlçe Seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Mahalle *</label>
                        <select id="neighborhoodSelect" class="form-select rounded-3" asp-items="ViewBag.Neighborhoods" required>
                            <option value="">Mahalle Seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label fw-bold mb-1">Sokak / Cadde *</label>
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small" id="toggleCustomStreetBtn">Listede yok mu?</button>
                        </div>
                        <select id="streetSelect" class="form-select rounded-3 @(Model.BuildingId > 0 && !Model.StreetId.HasValue && !string.IsNullOrEmpty(Model.StreetName) ? "d-none" : "")" asp-items="ViewBag.Streets">
                            <option value="">Sokak Seçiniz</option>
                        </select>
                        <input type="text" id="customStreetInput" class="form-control rounded-3 mt-1 @(Model.BuildingId > 0 && !Model.StreetId.HasValue && !string.IsNullOrEmpty(Model.StreetName) ? "" : "d-none")" value="@Model.StreetName" placeholder="Sokak / Cadde adını yazın" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">Bina / Dış Kapı No *</label>
                        <input type="text" id="buildingNumberInput" class="form-control rounded-3" value="@Model.BuildingNumber" placeholder="Örn: 14/A" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Yan No / Blok Adı <span class="text-muted fw-normal small">(İsteğe Bağlı)</span></label>
                        <input type="text" id="extraAddressInput" class="form-control rounded-3" value="@Model.ExtraAddressLabel" placeholder="Örn: B Girişi" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Ada <span class="text-muted fw-normal small">(Ops.)</span></label>
                        <input type="text" id="adaInput" class="form-control rounded-3" value="@Model.Ada" placeholder="Örn: 1453" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Parsel <span class="text-muted fw-normal small">(Ops.)</span></label>
                        <input type="text" id="parselInput" class="form-control rounded-3" value="@Model.Parsel" placeholder="Örn: 12" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Toplam Arazi (m²) <span class="text-muted fw-normal small">(Opsiyonel)</span></label>
                        <input type="number" step="0.01" min="0" id="landAreaInput" class="form-control rounded-3" value="@Model.LandAreaSqm" placeholder="Örn: 1250" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">Harita Konumu (Koordinat)</label>
                        <div class="input-group">
                            <input type="text" id="latInput" class="form-control bg-light" value="@Model.Latitude" placeholder="Enlem (Örn: 40.9850)" readonly />
                            <input type="text" id="lngInput" class="form-control bg-light" value="@Model.Longitude" placeholder="Boylam (Örn: 29.0420)" readonly />
                            <button type="button" class="btn btn-outline-success fw-semibold" onclick="openMapModal()">
                                <i class="bi bi-pin-map-fill me-1"></i> Haritadan Seç
                            </button>
                            <a href="https://maps.google.com/?q=@Model.Latitude,@Model.Longitude" target="_blank" id="showOnMapBtn"
                               class="btn btn-outline-primary @(string.IsNullOrEmpty(Model.Latitude) ? "d-none" : "")">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Haritada Göster
                            </a>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Çoklu Fotoğraf & Karar Defteri Yazısı -->
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="p-3 border rounded-4 bg-light h-100">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-images text-primary me-2"></i>Bina / Site Fotoğrafları (Çoklu Yükleme)</h6>
                            <small class="text-muted d-block mb-3">Dış cephe, giriş, bahçe veya ortak alanlardan birden fazla fotoğraf seçebilirsiniz.</small>
                            <div class="input-group mb-3">
                                <input type="file" id="multiPhotoInput" class="form-control" multiple accept="image/*" />
                                <button type="button" class="btn btn-primary fw-semibold" onclick="uploadFacilityFiles('BinaGorseli')">
                                    <i class="bi bi-cloud-upload me-1"></i> Yükle
                                </button>
                            </div>
                            <div id="photoGalleryContainer" class="d-flex flex-wrap gap-2">
                                @foreach (var ph in Model.Photos)
                                {
                                    <div class="photo-thumb-card" data-doc-id="@ph.Id">
                                        <a href="@ph.DocumentUrl" target="_blank"><img src="@ph.DocumentUrl" alt="@ph.FileName" /></a>
                                        <button type="button" class="btn btn-danger photo-thumb-remove" onclick="deleteFacilityDoc(@ph.Id, this)" title="Kaldır"><i class="bi bi-x"></i></button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="p-3 border rounded-4 bg-light h-100">
                            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-journal-check text-success me-2"></i>Karar Defteri / Yönetim Yetki Yazısı</h6>
                            <small class="text-muted d-block mb-3">Yönetimin GMK360 üyeliğini onayladığına dair karar defteri fotoğrafı veya PDF belgesi.</small>
                            <div class="input-group mb-3">
                                <input type="file" id="decisionDocInput" class="form-control" accept=".pdf,image/*" />
                                <button type="button" class="btn btn-success fw-semibold" onclick="uploadFacilityFiles('KararDefteriYetki')">
                                    <i class="bi bi-file-earmark-arrow-up me-1"></i> Belge Yükle
                                </button>
                            </div>
                            <div id="decisionDocPreview">
                                @if (Model.DecisionDocument != null)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 bg-white border rounded-3" data-doc-id="@Model.DecisionDocument.Id">
                                        <a href="@Model.DecisionDocument.DocumentUrl" target="_blank" class="text-success fw-semibold text-decoration-none text-truncate">
                                            <i class="bi bi-check-circle-fill me-1"></i>@Model.DecisionDocument.FileName
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" onclick="deleteFacilityDoc(@Model.DecisionDocument.Id, this)">Sil</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Henüz karar yazısı yüklenmedi.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div id="step1ErrorAlert" class="alert alert-danger mt-3 d-none rounded-3"></div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <button type="button" id="btnSaveStep1" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm" onclick="saveStep1AndContinue()">
                        Kaydet ve Blok Tanımlarına Geç <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ADIM 2: MİMARİ BLOK / YAPI DAĞILIMI -->
    <div class="wizard-step" id="step2">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="p-3 rounded-4 border border-primary-subtle bg-primary bg-opacity-10 mb-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <label class="form-label fw-bold text-primary mb-1" id="structureCountLabel">
                                Bu Yerleşkedeki Bağımsız Yapı (Temel / Bina) Sayısı
                            </label>
                            <div class="small text-muted" id="structureCountHint"></div>
                        </div>
                        <div style="width: 140px;">
                            <input type="number" id="structureCountInput" class="form-control form-control-lg fw-bold text-center border-primary" min="1" max="30" value="1" />
                        </div>
                    </div>
                </div>

                <div id="structuresContainer" class="d-flex flex-column gap-4"></div>

                <div id="step2ErrorAlert" class="alert alert-danger mt-3 d-none rounded-3"></div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" onclick="goToStep(1)">
                        <i class="bi bi-arrow-left me-1"></i> Geri (Adres &amp; Künye)
                    </button>
                    <button type="button" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm" onclick="goToStep3Review()">
                        Özet &amp; Onaya Geç <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ADIM 3: ÖZET & ONAY -->
    <div class="wizard-step" id="step3">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-check2-circle text-success me-2"></i>Yapı Özeti ve Oluşturma Onayı</h5>
                <p class="text-muted small mb-4">Onayladığınızda tanımlı bloklar, katlar, daire/dükkan kartları ve temel ortak alan/demirbaş iskeleti otomatik oluşturulacaktır.</p>

                <div id="summaryCardsContainer" class="d-flex flex-column gap-3 mb-4"></div>

                <div class="p-3 rounded-4 bg-light border d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                    <div class="fw-semibold text-dark"><i class="bi bi-buildings text-success me-2"></i>Toplam Oluşturulacak Kapasite</div>
                    <div class="d-flex gap-3 fw-bold">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2" id="sumTotalBlocks">0 Blok</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2" id="sumTotalApts">0 Daire</span>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 px-3 py-2" id="sumTotalShops">0 Dükkan</span>
                    </div>
                </div>

                <!-- Otomatik Yıllık Abonelik Paketi & Yetki Durumu -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border border-success-subtle bg-success bg-opacity-10 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold text-success text-uppercase"><i class="bi bi-award me-1"></i>Yıllık Abonelik Paketi</span>
                                <span class="badge bg-success text-white rounded-pill">14 Gün Ücretsiz Deneme</span>
                            </div>
                            <div class="fw-bold fs-4 text-dark" id="sumPricingPrice">5.000 TL / yıl</div>
                            <div class="small text-muted" id="sumPricingDesc">Tekil bina (1 blok, 30 daire altı)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 border h-100" id="sumAuthorityBox">
                            <div class="small fw-bold text-uppercase mb-1"><i class="bi bi-journal-check me-1"></i>Karar Defteri Yetki Kilidi (KVKK)</div>
                            <div class="fw-bold" id="sumAuthorityStatus">Kontrol ediliyor...</div>
                            <div class="small text-muted mt-1" id="sumAuthorityHint"></div>
                        </div>
                    </div>
                </div>

                <!-- Zorunlu KMK & KVKK Yönetici Yetki Taahhütnamesi -->
                <div class="p-3 rounded-4 border bg-light mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="kvkkConsentCheck" />
                        <label class="form-check-label small text-dark" for="kvkkConsentCheck">
                            <strong>KMK &amp; KVKK Yönetici Yetki Beyanı:</strong> 634 sayılı Kat Mülkiyeti Kanunu ve 6698 sayılı KVKK kapsamında; bu apartman/sitenin yetkili yöneticisi olduğumu, kat malikleri kararı olmaksızın veya hukuka aykırı şekilde sakinlerin kişisel/telefon verilerini işlemeyeceğimi, girilen kayıtların veri sorumluluğunun yönetime ait olduğunu ve yetki devri/onay kayıtlarının arşivleneceğini kabul ederim.
                        </label>
                    </div>
                </div>

                <div id="step3ErrorAlert" class="alert alert-danger d-none rounded-3 mb-3"></div>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" onclick="goToStep(2)">
                        <i class="bi bi-arrow-left me-1"></i> Geri (Blok Tanımları)
                    </button>
                    <button type="button" id="btnFinishWizard" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm" onclick="submitFacilityStep2()">
                        <i class="bi bi-rocket-takeoff me-2"></i> Yapıyı ve Ortak Alanları Oluştur
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Harita Konum Seçim Modalı -->
<div class="modal fade" id="mapPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-2 px-3">
                <h6 class="modal-title fw-bold mb-0"><i class="bi bi-geo-alt me-2 text-warning"></i>Haritadan Bina Konumunu İşaretleyin</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 position-relative">
                <div id="wizardMap" style="height: 430px; width: 100%;"></div>
                <div class="p-2 bg-light border-top small text-muted text-center">
                    Haritaya tıklayarak pini binanın tam üzerine getirebilirsiniz.
                </div>
            </div>
            <div class="modal-footer bg-white py-2 justify-content-between">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" onclick="geocodeCurrentAddressAndFocus()">
                    <i class="bi bi-crosshair me-1"></i> Seçili Adrese Odakla
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" onclick="confirmMapLocation()">Konumu Onayla</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        var initialStructures = @Html.Raw(initialStructuresJson);
        var stateStructures = [];
        var isDuplicateBlocked = false;
        var mapInstance = null;
        var mapMarker = null;
        var tempLat = null;
        var tempLng = null;

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function showAlert(id, msg) {
            var el = document.getElementById(id);
            if (!el) return;
            if (msg) {
                el.innerText = msg;
                el.classList.remove('d-none');
            } else {
                el.classList.add('d-none');
            }
        }

        function goToStep(stepNum) {
            document.querySelectorAll('.wizard-step').forEach(function (s) { s.classList.remove('active'); });
            document.getElementById('step' + stepNum).classList.add('active');

            for (var i = 1; i <= 3; i++) {
                var ind = document.getElementById('ind-' + i);
                ind.classList.remove('active', 'done');
                if (i < stepNum) ind.classList.add('done');
                else if (i === stepNum) ind.classList.add('active');

                if (i < 3) {
                    var conn = document.getElementById('conn-' + i);
                    conn.classList.toggle('done', i < stepNum);
                }
            }

            if (stepNum === 2) initStep2Structures();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

