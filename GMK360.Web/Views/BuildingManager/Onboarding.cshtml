            }
            bootstrap.Modal.getInstance(document.getElementById('mapPickerModal')).hide();
        }

        // Adım 1 Kaydet
        async function saveStep1Internal() {
            showAlert('step1ErrorAlert', '');
            if (isDuplicateBlocked) {
                showAlert('step1ErrorAlert', 'Bu Tekil Merkez Adres ID ile kayıtlı bina zaten mevcut; mükerrer oluşturulamaz.');
                return false;
            }

            var fd = new FormData();
            fd.append('__RequestVerificationToken', getAntiForgeryToken());
            fd.append('BuildingId', document.getElementById('buildingIdInput').value || '0');
            fd.append('ManagementMode', document.getElementById('managementModeInput').value);
            fd.append('Name', document.getElementById('nameInput').value.trim());
            fd.append('Description', document.getElementById('descriptionInput').value.trim());
            fd.append('BuildingAge', document.getElementById('buildingAgeInput').value);
            fd.append('TaxNumber', document.getElementById('taxNumberInput').value.trim());
            fd.append('CityId', document.getElementById('citySelect').value || '0');
            fd.append('DistrictId', document.getElementById('districtSelect').value || '0');
            fd.append('NeighborhoodId', document.getElementById('neighborhoodSelect').value || '0');
            fd.append('StreetId', document.getElementById('streetSelect').value || '');
            fd.append('StreetName', getSelectedStreetText());
            fd.append('BuildingNumber', document.getElementById('buildingNumberInput').value.trim());
            fd.append('ExtraAddressLabel', document.getElementById('extraAddressInput').value.trim());
            fd.append('Ada', document.getElementById('adaInput').value.trim());
            fd.append('Parsel', document.getElementById('parselInput').value.trim());
            fd.append('LandAreaSqm', document.getElementById('landAreaInput').value.trim());
            fd.append('Latitude', document.getElementById('latInput').value.trim());
            fd.append('Longitude', document.getElementById('lngInput').value.trim());

            var res = await fetch('/BuildingManager/SaveFacilityStep1', { method: 'POST', body: fd });
            var data = await res.json();
            if (!res.ok || !data.success) {
                showAlert('step1ErrorAlert', data.message || 'Bilgiler kaydedilemedi.');
                return false;
            }

            document.getElementById('buildingIdInput').value = data.buildingId;
            document.getElementById('managementModeInput').disabled = true;
            return true;
        }

        async function saveStep1AndContinue() {
            var btn = document.getElementById('btnSaveStep1');
            btn.disabled = true;
            try {
                var ok = await saveStep1Internal();
                if (!ok) return;

                // Henuz yuklenmemis secili dosya varsa otomatik yukle
                if (document.getElementById('multiPhotoInput').files.length > 0) {
                    await uploadFacilityFiles('BinaGorseli', true);
                }
                if (document.getElementById('decisionDocInput').files.length > 0) {
                    await uploadFacilityFiles('KararDefteriYetki', true);
                }

                goToStep(2);
            } finally {
                btn.disabled = false;
            }
        }

        async function uploadFacilityFiles(category, silentIfEmpty) {
            var input = document.getElementById(category === 'KararDefteriYetki' ? 'decisionDocInput' : 'multiPhotoInput');
            if (!input.files || input.files.length === 0) {
                if (!silentIfEmpty) showAlert('step1ErrorAlert', 'Lütfen önce yüklenecek dosyayı seçin.');
                return;
            }

            var bId = parseInt(document.getElementById('buildingIdInput').value || '0', 10);
            if (bId <= 0) {
                var saved = await saveStep1Internal();
                if (!saved) return;
                bId = parseInt(document.getElementById('buildingIdInput').value || '0', 10);
            }

            var fd = new FormData();
            fd.append('__RequestVerificationToken', getAntiForgeryToken());
            fd.append('buildingId', bId);
            fd.append('category', category);
            for (var i = 0; i < input.files.length; i++) {
                fd.append('files', input.files[i]);
            }

            var res = await fetch('/BuildingManager/UploadFacilityDocument', { method: 'POST', body: fd });
            var data = await res.json();
            if (!data.success) {
                showAlert('step1ErrorAlert', data.message || 'Dosya yüklenemedi.');
                return;
            }

            input.value = '';
            (data.documents || []).forEach(function (doc) {
                if (doc.category === 'KararDefteriYetki') {
                    document.getElementById('decisionDocPreview').innerHTML =
                        '<div class="d-flex align-items-center justify-content-between p-2 bg-white border rounded-3" data-doc-id="' + doc.id + '">' +
                        '<a href="' + doc.url + '" target="_blank" class="text-success fw-semibold text-decoration-none text-truncate"><i class="bi bi-check-circle-fill me-1"></i>' + doc.fileName + '</a>' +
                        '<button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" onclick="deleteFacilityDoc(' + doc.id + ', this)">Sil</button></div>';
                } else {
                    var card = document.createElement('div');
                    card.className = 'photo-thumb-card';
                    card.setAttribute('data-doc-id', doc.id);
                    card.innerHTML = '<a href="' + doc.url + '" target="_blank"><img src="' + doc.url + '" alt="' + doc.fileName + '" /></a>' +
                        '<button type="button" class="btn btn-danger photo-thumb-remove" onclick="deleteFacilityDoc(' + doc.id + ', this)" title="Kaldır"><i class="bi bi-x"></i></button>';
                    document.getElementById('photoGalleryContainer').appendChild(card);
                }
            });
        }

        async function deleteFacilityDoc(docId, btnEl) {
            var fd = new FormData();
            fd.append('__RequestVerificationToken', getAntiForgeryToken());
            fd.append('docId', docId);
            var res = await fetch('/BuildingManager/DeleteFacilityDocument', { method: 'POST', body: fd });
            var data = await res.json();
            if (data.success && btnEl) {
                var box = btnEl.closest('[data-doc-id]');
                if (box) box.remove();
            }
        }

