@model GMK360.Core.Entities.Building
@{
    Layout = null;
    int reportYear = ViewBag.ReportYear ?? DateTime.Now.Year;
    var units = Model.Units?.Where(u => u.Category != "OrtakAlan_Blok").OrderBy(u => u.FloorLevel).ThenBy(u => u.DoorNumber).ToList() ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var expenses = Model.Expenses?.Where(e => e.PayerType == "Owner" || e.ExpenseType == GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure).ToList() ?? new List<GMK360.Core.Entities.BuildingExpense>();
    var totalCapEx = expenses.Sum(e => e.TotalAmount);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMSİ Gerçek Gider İndirim Raporu (@reportYear) - @Model.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1e293b;
            font-size: 13px;
        }

        .a4-page {
            width: 210mm;
            min-height: 297mm;
            padding: 16mm 18mm;
            margin: 20px auto;
            background: #ffffff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            box-sizing: border-box;
        }

        .no-print-bar {
            background: #0f172a;
            color: #ffffff;
            padding: 12px 20px;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .header-title {
            text-align: center;
            border-bottom: 2px solid #047857;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

        .header-title h4 {
            color: #065f46;
            font-weight: bold;
            margin: 0;
            font-size: 16px;
        }

        .header-title h5 {
            color: #1e293b;
            font-size: 13px;
            margin-top: 4px;
        }

        .tax-alert {
            background-color: #ecfdf5;
            border-left: 4px solid #10b981;
            padding: 8px 12px;
            margin-bottom: 15px;
            font-size: 11.5px;
        }

        table.tax-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11.5px;
            margin-bottom: 15px;
        }

        table.tax-table th, table.tax-table td {
            border: 1px solid #cbd5e1;
            padding: 6px 8px;
            vertical-align: middle;
        }

        table.tax-table th {
            background-color: #f1f5f9;
            font-weight: bold;
        }

        .signature-box {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            text-align: center;
        }

        @@media print {
            body { background: transparent; }
            .no-print-bar { display: none !important; }
            .a4-page {
                box-shadow: none !important;
                margin: 0 auto !important;
                width: 100% !important;
                padding: 10mm 12mm !important;
            }
        }
    </style>
</head>
<body>

    <!-- Yazdırma Kontrol Çubuğu -->
    <div class="no-print-bar d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <a href="/BuildingManager/Detail/@Model.Id" class="btn btn-sm btn-outline-light rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Yönetim Masasına Dön
            </a>
            <span class="fw-bold">
                <i class="bi bi-file-earmark-spreadsheet me-1 text-success"></i> GVK Madde 74 GMSİ Gerçek Gider İndirim Cetveli
            </span>
        </div>
        <button onclick="window.print()" class="btn btn-success btn-sm fw-bold rounded-pill px-4">
            <i class="bi bi-printer-fill me-1"></i> Maliye Raporunu Yazdır (Ctrl+P)
        </button>
    </div>

    <!-- A4 RAPOR ALANI -->
    <div class="a4-page">
        
        <div class="header-title">
            <h4>T.C. HAZİNE VE MALİYE BAKANLIĞI GELİR İDARESİ BAŞKANLIĞI</h4>
            <h5>193 SAYILI GELİR VERGİSİ KANUNU (GVK) MADDE 74 UYARINCA</h5>
            <div class="fw-bold fs-6 mt-1 text-primary">@reportYear YILI GMSİ (KİRA GELİR VERGİSİ) GERÇEK GİDER İNDİRİM TUTANAĞI</div>
        </div>

        <div class="p-3 bg-light border rounded-3 mb-3 small">
            <div class="row">
                <div class="col-7">
                    <strong>Apartman / Site Adı:</strong> @Model.Name @(Model.BlockName != null ? $"({Model.BlockName})" : "")<br />
                    <strong>Adres:</strong> @(Model.StreetName ?? Model.Address), No: @(Model.BuildingNumber ?? "-"), Kadıköy / İstanbul<br />
                    <strong>Vergi Kimlik No / TC:</strong> @(Model.TaxNumber ?? "3409128821")
                </div>
                <div class="col-5">
                    <strong>Rapor Tarihi:</strong> @DateTime.Today.ToString("dd MMMM yyyy")<br />
                    <strong>Vergilendirme Dönemi:</strong> @reportYear Takvim Yılı<br />
                    <strong>Toplam Demirbaş Gideri:</strong> <span class="text-danger fw-bold">@totalCapEx.ToString("N2") ₺</span>
                </div>
            </div>
        </div>

        <div class="tax-alert">
            <strong>Yasal Dayanak (GVK Madde 74/4 & 74/6):</strong><br />
            Kiraya verilen gayrimenkullerin idaresi, korunması, ehemmiyetini artıran çatı izolasyonu, asansör makine revizyonu, 
            ısı yalıtımı (mantolama) ve tesisat yenileme giderleri; gayrimenkul sahiplerinin Mart ayında vereceği Yıllık Gelir Vergisi Beyannamesinde 
            brüt kira hasılatından <strong>"Gerçek Gider İndirimi"</strong> olarak kuruşu kuruşuna düşülmektedir.
        </div>

        <div class="fw-bold mb-2">1. DÖNEM İÇİNDE YAPILAN DEMİRBAŞ & YENİLEME HARCAMALARI (FATURA DÖKÜMÜ)</div>
        <table class="tax-table">
            <thead>
                <tr>
                    <th style="width: 12%;">Tarih</th>
                    <th style="width: 50%;">Demirbaş & Onarım Açıklaması</th>
                    <th style="width: 20%;">Fatura / İş Kapsamı</th>
                    <th style="width: 18%; text-align: right;">Toplam Tutar</th>
                </tr>
            </thead>
            <tbody>
                @if (!expenses.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-3 text-muted">Bu yıl için kayıtlı demirbaş faturası bulunmuyor.</td>
                    </tr>
                }
                @foreach (var exp in expenses)
                {
                    <tr>
                        <td>@exp.Date.ToString("dd.MM.yyyy")</td>
                        <td class="fw-bold">@exp.Description</td>
                        <td>Ana Gayrimenkul Demirbaşı</td>
                        <td style="text-align: right; font-weight: bold; color: #dc2626;">@exp.TotalAmount.ToString("N2") ₺</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="fw-bold mb-2 mt-4">2. KAT MALİKLERİ GERÇEK GİDER İNDİRİM DAĞILIM CETVELİ</div>
        <table class="tax-table">
            <thead>
                <tr>
                    <th style="width: 6%;">No</th>
                    <th style="width: 14%;">Bölüm</th>
                    <th style="width: 32%;">Kat Maliki (Ev Sahibi)</th>
                    <th style="width: 14%;">Arsa Payı</th>
                    <th style="width: 18%; text-align: right;">Ödenen Demirbaş</th>
                    <th style="width: 16%; text-align: center;">GİB Beyan Durumu</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int uRow = 1;
                    decimal unitShare = units.Any() ? (totalCapEx / units.Count) : 0;
                }
                @foreach (var unit in units)
                {
                    <tr>
                        <td style="text-align: center;">@(uRow++)</td>
                        <td style="font-weight: bold; text-align: center;">@unit.DoorNumber</td>
                        <td>@(unit.OwnerName ?? "Malik Adı Belirtilmemiş")</td>
                        <td style="text-align: center;">1/@units.Count</td>
                        <td style="text-align: right; font-weight: bold; color: #047857;">@unitShare.ToString("N2") ₺</td>
                        <td style="text-align: center;">
                            <span class="badge bg-success" style="font-size: 10px;">İndirime Hazır</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- İMZA VE ONAY -->
        <div class="signature-box">
            <div style="width: 45%;">
                <div class="fw-bold">Düzenleyen: Apartman / Site Yöneticisi</div>
                <div style="margin-top: 35px; border-top: 1px dashed #64748b; padding-top: 4px; font-weight: bold;">
                    @(Model.ManagerUser?.FullName ?? "Site Yönetim Masası")<br />
                    <small class="text-muted">Kaşe / Islak İmza</small>
                </div>
            </div>
            <div style="width: 45%;">
                <div class="fw-bold">Onaylayan: Denetçi / Serbest Muhasebeci Mali Müşavir</div>
                <div style="margin-top: 35px; border-top: 1px dashed #64748b; padding-top: 4px; font-weight: bold;">
                    Denetim Heyeti Onayı<br />
                    <small class="text-muted">SMMM Kaşe / İmza</small>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
