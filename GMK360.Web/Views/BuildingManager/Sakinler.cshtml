@model IEnumerable<GMK360.Core.Entities.BuildingUnit>
@{
    ViewData["Title"] = "Sakinler ve Daireler";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var buildings = ViewBag.Buildings as IEnumerable<GMK360.Core.Entities.Building>;
    var selectedBuildingId = ViewBag.SelectedBuildingId as int?;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people"></i> Sakinler ve Daireler</h5>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex">
                <select name="buildingId" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                    <option value="">Tüm Binalar</option>
                    @if(buildings != null)
                    {
                        foreach(var b in buildings)
                        {
                            if(selectedBuildingId == b.Id)
                            {
                                <option value="@b.Id" selected>@b.Name</option>
                            }
                            else
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    }
                </select>
            </form>
            <button class="btn btn-sm btn-primary"><i class="bi bi-person-plus"></i> Yeni Sakin Ekle</button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Bina Adı</th>
                        <th>Daire No</th>
                        <th>Ev Sahibi</th>
                        <th>Kiracı (Sakin)</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if(!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
                    }
                    else
                    {
                        foreach (var unit in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@unit.Building.Name</span></td>
                                <td><strong>@unit.UnitNumber</strong></td>
                                <td>
                                    @unit.OwnerName <br/>
                                    <small class="text-muted">@unit.OwnerPhone</small>
                                </td>
                                <td>
                                    @if(string.IsNullOrEmpty(unit.TenantName))
                                    {
                                        <span class="text-muted fst-italic">Kiracı Yok</span>
                                    }
                                    else
                                    {
                                        @unit.TenantName <br/>
                                        <small class="text-muted">@unit.TenantPhone</small>
                                    }
                                </td>
                                <td>
                                    @if(unit.IsEmpty)
                                    {
                                        <span class="badge bg-danger">Boş Daire</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Dolu</span>
                                    }
                                </td>
                                <td>
                                    <a href="/BuildingManager/Detail/@unit.BuildingId" class="btn btn-sm btn-outline-info" title="Bina Detayı"><i class="bi bi-building"></i></a>
                                    <button class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
