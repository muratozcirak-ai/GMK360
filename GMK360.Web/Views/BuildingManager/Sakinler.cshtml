                            <option value="DAIRE">🏠 Sadece Daireler</option>
                            <option value="ALL">🏢 Tüm Bağımsız Bölümler</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Aidat Katsayısı</label>
                        <input type="number" step="0.05" min="0" max="10" name="duesMultiplier" class="form-control" value="1.00" required />
                        <small class="text-muted" style="font-size:0.7rem;">0.5=Yarı, 1=Normal, 1.5/2=Artış</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Özel Sabit Aidat (₺)</label>
                        <input type="number" step="0.01" min="0" name="fixedMonthlyDues" class="form-control" placeholder="Değişmesin" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">İndirim / Fark (+/- ₺)</label>
                        <input type="number" step="10" name="duesAdjustmentAmount" class="form-control" placeholder="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Temizlik &amp; Görevli (%)</label>
                        <input type="number" step="5" min="0" max="500" name="cleaningParticipationPercent" class="form-control" value="100" required />
                        <small class="text-muted" style="font-size:0.7rem;">Normal=100, Yoğun işyeri=150</small>
                    </div>
                    <div class="col-md-8 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isDuesExempt" value="true" id="bulkDuesExemptSw">
                            <input type="hidden" name="isDuesExempt" value="false" />
                            <label class="form-check-label small fw-bold text-danger" for="bulkDuesExemptSw">Seçili Grubu Aidattan Tam Muaf Tut (0 ₺)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isExemptFromElevator" value="true" id="bulkElevSw">
                            <input type="hidden" name="isExemptFromElevator" value="false" />
                            <label class="form-check-label small fw-bold" for="bulkElevSw">Asansör Giderinden Muaf</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isExemptFromStairwell" value="true" id="bulkStairSw">
                            <input type="hidden" name="isExemptFromStairwell" value="false" />
                            <label class="form-check-label small fw-bold" for="bulkStairSw">Merdiven Aydınlatmadan Muaf</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Yönetim Planı Notu</label>
                        <input type="text" name="duesRuleNote" class="form-control" placeholder="Örn: Yönetim Planı Md.8 - Zemin dükkan asansör muaf, temizlik %150" />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold w-100">Seçili Gruba Uygula</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Yeni Bölüm Ekle Modalı -->
    <div class="modal fade" id="addUnitQuickModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="AddUnit" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Sakinler" />
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Bağımsız Bölüm &amp; Sakin Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small">Bina</label>
                        <select name="buildingId" class="form-select" required>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id" selected="@(selectedBuildingId == b.Id ? "selected" : null)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Tür</label>
                        <select name="category" class="form-select">
                            <option value="Daire">🏠 Daire</option>
                            <option value="Dukkan">🏪 Dükkan</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Kat</label>
                        <input type="number" name="floorLevel" class="form-control" value="1" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Kapı No *</label>
                        <input type="text" name="unitNumber" class="form-control" required placeholder="18 / D3" />
                    </div>

                    <div class="col-12 border-top pt-2">
                        <div class="fw-bold small text-dark mb-1"><i class="bi bi-person-badge me-1 text-primary"></i> Ev Sahibi (Mülk Sahibi) Bilgileri</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Ev Sahibi Adı</label>
                        <input type="text" name="ownerName" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Malik Telefon (PWA)</label>
                        <input type="text" name="ownerPhone" class="form-control" placeholder="05XX XXX XX XX" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold small">Malik E-Posta (Profil Aktivasyonu İçin)</label>
                        <input type="email" name="ownerEmail" class="form-control" placeholder="malik@ornek.com" />
                    </div>

                    <div class="col-12 border-top pt-2">
                        <div class="fw-bold small text-dark mb-1"><i class="bi bi-key me-1 text-info"></i> Kiracı Bilgileri (Ev sahibi oturuyorsa boş bırakın)</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Kiracı Adı</label>
                        <input type="text" name="tenantName" class="form-control" placeholder="Örn: Mehmet Kaya" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Kiracı Telefon (PWA)</label>
                        <input type="text" name="tenantPhone" class="form-control" placeholder="05XX XXX XX XX" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold small">Kiracı E-Posta (Profil Aktivasyonu İçin)</label>
                        <input type="email" name="tenantEmail" class="form-control" placeholder="kiraci@ornek.com" />
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light border small text-muted mb-0 py-2">
                            <i class="bi bi-shield-check text-success me-1"></i> Kayıt sonrasında malik ve kiracıya otomatik <strong>profil aktivasyon davet linki</strong> oluşur; şifre ve kişisel onay PIN'ini kullanıcı kendi profilinden belirler.
                        </div>
                    </div>

                    <div class="col-md-6 border-top pt-3">
                        <label class="form-label fw-bold small">Brüt m²</label>
                        <input type="number" step="0.1" min="0" name="grossSquareMeters" class="form-control" placeholder="Örn: 110" />
                    </div>
                    <div class="col-md-6 border-top pt-3">
                        <label class="form-label fw-bold small">Arsa Payı (Malik Demirbaş)</label>
                        <input type="number" step="0.0001" min="0" name="landShare" class="form-control" placeholder="Örn: 12.5" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isEmpty" value="true" id="addEmptySw">
                            <label class="form-check-label small fw-bold" for="addEmptySw">Bölüm Şu An Tamamen Boş</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100">Bölümü ve Sakin Giriş Bilgilerini Kaydet</button>
                </div>
            </form>
        </div>
    </div>
}

<script>
    let _euOwnerToken = '';
    let _euTenantToken = '';
    let _euBuildingBaseDues = 0;

    function openEditUnitModal(unitId, buildingId, doorNo, oName, oPhone, oEmail, tName, tPhone, tEmail, isEmpty, landShare, grossSqm, mult, fixedDues, exElev, exStair, cleanPct, ruleNote, ownerToken, tenantToken, isDuesExempt, duesAdj, baseDues) {
        _euOwnerToken = ownerToken || '';
        _euTenantToken = tenantToken || '';
        _euBuildingBaseDues = parseFloat(baseDues || '0') || 0;
        document.getElementById('euUnitId').value = unitId;
        document.getElementById('euBuildingId').value = buildingId;
        document.getElementById('euTitle').innerText = 'Kapı No: ' + doorNo + ' (Mülk ID #' + unitId + ')';
        document.getElementById('euOwnerName').value = oName || '';
        document.getElementById('euOwnerPhone').value = oPhone || '';
        document.getElementById('euOwnerEmail').value = oEmail || '';
        document.getElementById('euTenantName').value = tName || '';
        document.getElementById('euTenantPhone').value = tPhone || '';
        document.getElementById('euTenantEmail').value = tEmail || '';
        document.getElementById('euLandShare').value = landShare || '0';
        document.getElementById('euGrossSqm').value = grossSqm || '0';

        const mVal = (mult !== undefined && mult !== null && mult !== '') ? parseFloat(mult) : 1;
        document.getElementById('euDuesMultiplier').value = String(mVal);
        document.getElementById('euDuesPctDiff').value = String(Math.round((mVal - 1) * 100));

        document.getElementById('euFixedDues').value = (fixedDues !== undefined && fixedDues !== null && fixedDues !== '') ? fixedDues : '';
        document.getElementById('euDuesAdj').value = (duesAdj !== undefined && duesAdj !== null && duesAdj !== '') ? duesAdj : '0';
        document.getElementById('euIsDuesExempt').checked = !!isDuesExempt;

        setCleaningControlValue(cleanPct || '100');
        document.getElementById('euExemptElev').checked = !!exElev;
        document.getElementById('euExemptStair').checked = !!exStair;
        document.getElementById('euRuleReasonPreset').value = '';
        document.getElementById('euRuleNote').value = ruleNote || '';
        document.getElementById('euIsEmpty').checked = !!isEmpty;
        updateUnitDuesPreview();

        const firstTabEl = document.getElementById('euTabResidentsBtn');
        if (firstTabEl) bootstrap.Tab.getOrCreateInstance(firstTabEl).show();
        new bootstrap.Modal(document.getElementById('editUnitContactsModal')).show();
    }

    function setCleaningControlValue(val) {
        const cleanNum = parseFloat(val || '100');
        const sel = document.getElementById('euCleanSelect');
        const inp = document.getElementById('euCleaningPct');
        inp.value = String(isNaN(cleanNum) ? 100 : cleanNum);
        const stdOpts = ['0', '50', '100', '150', '200'];
        if (stdOpts.includes(String(Math.round(cleanNum))) && Math.abs(cleanNum - Math.round(cleanNum)) < 0.01) {
            sel.value = String(Math.round(cleanNum));
            inp.classList.add('d-none');
        } else {
            sel.value = 'custom';
            inp.classList.remove('d-none');
        }
    }

    function syncCleaningInput() {
        const sel = document.getElementById('euCleanSelect');
        const inp = document.getElementById('euCleaningPct');
        if (sel.value === 'custom') {
            inp.classList.remove('d-none');
            inp.focus();
        } else {
            inp.classList.add('d-none');
            inp.value = sel.value;
        }
    }

    function syncMultFromPct() {
        const pct = parseFloat(document.getElementById('euDuesPctDiff').value || '0') || 0;
        const mult = Math.max(0, Math.min(10, 1 + (pct / 100)));
        document.getElementById('euDuesMultiplier').value = mult.toFixed(2);
        updateUnitDuesPreview();
    }

    function applyRuleReasonPreset() {
        const val = document.getElementById('euRuleReasonPreset').value;
        if (val) document.getElementById('euRuleNote').value = val;
    }

    function updateUnitDuesPreview() {
        const baseEl = document.getElementById('euPreviewBase');
        const totEl = document.getElementById('euPreviewTotal');
        if (!baseEl || !totEl) return;

        baseEl.innerText = _euBuildingBaseDues.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        const isExempt = document.getElementById('euIsDuesExempt').checked;
        const mult = parseFloat(document.getElementById('euDuesMultiplier').value || '1');
        const adj = parseFloat(document.getElementById('euDuesAdj').value || '0') || 0;
        const fixedRaw = document.getElementById('euFixedDues').value;
        const fixed = fixedRaw !== '' ? parseFloat(fixedRaw) : null;

        if (isExempt || mult <= 0 || (fixed !== null && fixed === 0)) {
            totEl.innerText = 'Hesaplanan Bölüm Aidatı: 0,00 ₺ (Tam Muaf)';
            return;
        }
        if (fixed !== null && fixed > 0) {
            const net = Math.max(0, fixed + adj);
            totEl.innerText = 'Hesaplanan (İstisna Sabit): ' + net.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            return;
        }
        if (_euBuildingBaseDues <= 0) {
            totEl.innerText = 'Aidat & Tahsilat sayfasından Sabit Baz Aidat belirleyin';
            return;
        }
        const net = Math.max(0, (_euBuildingBaseDues * mult) + adj);
        const pct = Math.round((mult - 1) * 100);
        const pctStr = pct === 0 ? 'Standart' : (pct > 0 ? `+${pct}% Fark` : `${pct}% İndirim`);
        totEl.innerText = `Hesaplanan: ${net.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺ (${pctStr})`;
    }

    function applyUnitRulePreset(mult, cleanPct, exElev, exStair, note) {
        document.getElementById('euDuesMultiplier').value = mult;
        document.getElementById('euDuesPctDiff').value = String(Math.round((mult - 1) * 100));
        setCleaningControlValue(cleanPct);
        document.getElementById('euExemptElev').checked = !!exElev;
        document.getElementById('euExemptStair').checked = !!exStair;
        document.getElementById('euRuleNote').value = note || '';
        updateUnitDuesPreview();
    }

    function copyActivationUrl(token) {
        const url = window.location.origin + '/Account/ActivateResident?token=' + encodeURIComponent(token);
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(() => alert('Aktivasyon linki panoya kopyalandı (doğrudan tarayıcı adres çubuğuna yapıştırabilirsiniz):\n\n' + url));
        } else {
            prompt('Aktivasyon linkini kopyalayın:', url);
        }
    }

    function sendWhatsAppActivation(token, phone, label) {
        const url = window.location.origin + '/Account/ActivateResident?token=' + encodeURIComponent(token);
        const text = `Merhaba ${label}, GMK360 Bina Portalı profilinizi doğrulamak, kendi şifrenizi ve onay PIN'inizi belirlemek için bağlantıya tıklayın: ${url}`;
        const digits = (phone || '').replace(/\D/g, '');
        if (digits.length >= 10) {
            const intl = digits.length === 10 ? '90' + digits : (digits.startsWith('0') ? '9' + digits : digits);
            window.open('https://wa.me/' + intl + '?text=' + encodeURIComponent(text), '_blank');
        } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => alert('WhatsApp davet mesajı panoya kopyalandı:\n\n' + text));
        } else {
            prompt('WhatsApp davet mesajı:', text);
        }
    }

    function copyResidentInviteByRole(role) {
        const title = document.getElementById('euTitle').innerText;
        const isOwner = role === 'Owner';
        const roleLabel = isOwner ? 'Malik (Ev Sahibi)' : 'Kiracı (Sakin)';
        const token = isOwner ? _euOwnerToken : _euTenantToken;
        if (token) {
            copyActivationUrl(token);
            return;
        }
        const phone = isOwner
            ? (document.getElementById('euOwnerPhone').value || '(Telefon giriniz)')
            : (document.getElementById('euTenantPhone').value || '(Telefon giriniz)');
        const loginUrl = window.location.origin + '/Account/Login';
        const text = `Merhaba, GMK360 Bina Portalı (${roleLabel}) üzerinden aidat, duyuru ve karar süreçlerinizi takip edebilirsiniz.\nBölüm: ${title}\nGiriş Adresi: ${loginUrl}\nTelefon: ${phone}\nNot: İlk girişte profilinizden kendi şifrenizi ve kişisel PIN'inizi belirleyebilirsiniz.`;
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(() => alert(roleLabel + ' giriş daveti panoya kopyalandı:\n\n' + text));
        } else {
            prompt('Aşağıdaki mesajı kopyalayın:', text);
        }
    }

    let _activeSakinFilter = 'all';
    function setSakinFilter(btn, filterKey) {
        _activeSakinFilter = filterKey || 'all';
        document.querySelectorAll('#sakinQuickFilterBar button').forEach(b => {
            const isActive = b === btn;
            b.classList.toggle('btn-dark', isActive);
            b.classList.toggle('text-white', isActive);
            if (!isActive) b.classList.remove('btn-dark');
        });
        filterSakinRows();
    }

    function filterSakinRows() {
        const q = (document.getElementById('sakinSearchInput')?.value || '').trim().toLowerCase();
        document.querySelectorAll('#sakinlerTable tbody tr.sakin-row').forEach(row => {
            let matchFilter = true;
            if (_activeSakinFilter === 'owner') matchFilter = row.dataset.hasOwner === '1';
            else if (_activeSakinFilter === 'tenant') matchFilter = row.dataset.hasTenant === '1';
            else if (_activeSakinFilter === 'board') matchFilter = row.dataset.isBoard === '1';
            else if (_activeSakinFilter === 'rule') matchFilter = row.dataset.hasRule === '1';
            else if (_activeSakinFilter === 'empty') matchFilter = row.dataset.isEmpty === '1';

            const hay = row.dataset.search || '';
            const matchSearch = !q || hay.includes(q);
            row.style.display = (matchFilter && matchSearch) ? '' : 'none';
        });
    }
</script>
