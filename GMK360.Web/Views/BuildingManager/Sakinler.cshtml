@model IEnumerable<GMK360.Core.Entities.BuildingUnit>
@{
    ViewData["Title"] = "Mal Sahibi & Kiracılar (Bağımsız Bölümler)";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    int targetWizardId = selectedBuildingId ?? buildings.FirstOrDefault()?.Id ?? 0;
    bool hasAuthorityDoc = ViewBag.HasAuthorityDoc is bool ha && ha;
    var residentProfiles = ViewBag.ResidentProfiles as Dictionary<string, GMK360.Core.Entities.Identity.ApplicationUser> ?? new Dictionary<string, GMK360.Core.Entities.Identity.ApplicationUser>();
    var governanceMembers = ViewBag.GovernanceMembers as List<GMK360.Core.Entities.BuildingManager> ?? new List<GMK360.Core.Entities.BuildingManager>();

    int aptCount = Model.Count(u => u.Category != "Dukkan" && u.Category != "Dükkan");
    int shopCount = Model.Count(u => u.Category == "Dukkan" || u.Category == "Dükkan");

    string NormPhone(string? p)
    {
        if (string.IsNullOrWhiteSpace(p)) return "";
        var d = new string(p.Where(char.IsDigit).ToArray());
        return d.Length > 10 ? d.Substring(d.Length - 10) : d;
    }

    var boardIndex = 0;
    var azaRankById = new Dictionary<int, int>();
    foreach (var gm in governanceMembers.Where(x => x.Role == GMK360.Core.Entities.BuildingManagerRole.BoardMember))
    {
        boardIndex++;
        azaRankById[gm.Id] = boardIndex;
    }
    int totalAzas = boardIndex;

    List<(string Label, string BadgeCss)> ResolveUnitRoles(GMK360.Core.Entities.BuildingUnit u)
    {
        var list = new List<(string Label, string BadgeCss)>();
        var ownerPhone = NormPhone(u.OwnerPhone);
        var tenantPhone = NormPhone(u.TenantPhone);
        var ownerMail = (u.OwnerEmail ?? "").Trim().ToLowerInvariant();
        var tenantMail = (u.TenantEmail ?? "").Trim().ToLowerInvariant();

        foreach (var gm in governanceMembers)
        {
            var gMail = (gm.User?.Email ?? "").Trim().ToLowerInvariant();
            var gPhone = NormPhone(gm.User?.PhoneNumber);
            bool matchesOwner = (!string.IsNullOrEmpty(u.OwnerUserId) && gm.UserId == u.OwnerUserId)
                || (!string.IsNullOrEmpty(ownerMail) && gMail == ownerMail)
                || (ownerPhone.Length >= 10 && gPhone == ownerPhone);
            bool matchesTenant = (!string.IsNullOrEmpty(u.TenantUserId) && gm.UserId == u.TenantUserId)
                || (!string.IsNullOrEmpty(tenantMail) && gMail == tenantMail)
                || (tenantPhone.Length >= 10 && gPhone == tenantPhone);

            if (!matchesOwner && !matchesTenant) continue;

            string targetWho = matchesOwner && !matchesTenant ? "Malik" : (!matchesOwner && matchesTenant ? "Kiracı" : "Sakin");
            if (gm.Role == GMK360.Core.Entities.BuildingManagerRole.HeadManager)
                list.Add(($"👑 Ana Yönetici ({targetWho})", "bg-primary text-white"));
            else if (gm.Role == GMK360.Core.Entities.BuildingManagerRole.Auditor)
                list.Add(($"🔍 Denetçi ({targetWho})", "bg-warning text-dark"));
            else
            {
                var rank = azaRankById.TryGetValue(gm.Id, out var r) && totalAzas > 1 ? $" #{r}" : "";
                list.Add(($"🏛️ Aza{rank} ({targetWho})", "bg-success text-white"));
            }
        }
        return list;
    }
}

<div class="container-fluid py-3 px-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-success me-2"></i>Mal Sahibi &amp; Kiracılar (@aptCount Daire, @shopCount Dükkan)</h2>
            <p class="text-muted small mb-0">Kurulumda tanımladığınız her bağımsız bölüm için buradan doğrudan malik ve kiracı bilgisi girebilirsiniz.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (targetWizardId > 0)
            {
                int emptyOwnerUnitCount = Model.Count(u => string.IsNullOrWhiteSpace(u.OwnerName));
                if (emptyOwnerUnitCount > 0)
                {
                    <form asp-action="SeedDemoResidentsForSite" asp-controller="BuildingManager" method="post" class="d-inline"
                          onsubmit="return confirm('@emptyOwnerUnitCount boş bölüm otomatik doldurulsun mu? (Mevcut kayıtlı dairelere dokunulmaz; %60 kendi oturan, %40 kiracılı ve 5 daireli 1 malik oluşturulur.)');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="buildingId" value="@targetWizardId" />
                        <input type="hidden" name="includeAllSiteBlocks" value="true" />
                        <input type="hidden" name="selectedBuildingFilter" value="@selectedBuildingId" />
                        <button type="submit" class="btn btn-warning text-dark rounded-pill px-3 fw-bold">
                            <i class="bi bi-magic me-1"></i> Boş Bölümleri Test Verisiyle Doldur (@emptyOwnerUnitCount)
                        </button>
                    </form>
                }
                <button type="button" class="btn btn-outline-primary rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#bulkDuesProfileModal">
                    <i class="bi bi-sliders me-1"></i> Toplu Katsayı &amp; Muafiyet Uygula
                </button>
                <button type="button" class="btn btn-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addUnitQuickModal">
                    <i class="bi bi-plus-circle me-1"></i> Yeni Bölüm Ekle
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            <div>@TempData["WarningMessage"]</div>
            @if (TempData["InviteFallbackLink"] != null)
            {
                var fbLink = TempData["InviteFallbackLink"]?.ToString() ?? "";
                <div class="input-group input-group-sm mt-2">
                    <input type="text" class="form-control bg-white" id="inviteFallbackUrlInput" value="@fbLink" readonly />
                    <button type="button" class="btn btn-dark fw-semibold" onclick="navigator.clipboard.writeText(document.getElementById('inviteFallbackUrlInput').value);this.innerText='Kopyalandı ✓';">Davet Linkini Kopyala</button>
                </div>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!hasAuthorityDoc && targetWizardId > 0)
    {
        <div class="alert alert-info rounded-4 border-0 shadow-sm mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="small">
                <i class="bi bi-info-circle-fill me-1"></i>
                <strong>KVKK &amp; Yetki Belgesi Notu:</strong> Sakinlerin telefon, e-posta ve PWA giriş PIN bilgilerini buradan hemen tanımlayabilirsiniz. Kurumsal arşiv için Karar Defteri yetki yazısını da eklemeniz önerilir.
            </div>
            <a href="/BuildingManager/Onboarding/@targetWizardId" class="btn btn-sm btn-outline-dark rounded-pill px-3">Yetki Belgesi Yükle &rarr;</a>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-door-open text-primary me-2"></i>Daire &amp; Dükkan Sakin Listesi (@Model.Count() Bölüm)</h5>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="input-group input-group-sm" style="width: 230px;">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" id="sakinSearchInput" class="form-control" placeholder="Daire, ad, tel, görev ara..." oninput="filterSakinRows()" />
                    </div>
                    <form method="get" class="d-flex gap-2 align-items-center">
                        @if (selectedBuildingId.HasValue && buildings.Count > 1)
                        {
                            <a href="/BuildingManager/Sakinler" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold text-nowrap">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Tüm Blokları Göster
                            </a>
                        }
                        <select name="buildingId" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Tüm Binalar / Bloklar</option>
                            @foreach (var b in buildings)
                            {
                                if (selectedBuildingId == b.Id)
                                {
                                    <option value="@b.Id" selected>@b.Name</option>
                                }
                                else
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        </select>
                    </form>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-1 align-items-center pt-1" id="sakinQuickFilterBar">
                <button type="button" class="btn btn-xs btn-dark rounded-pill px-3 fw-semibold active" data-filter="all" onclick="setSakinFilter(this, 'all')">Tümü (@Model.Count())</button>
                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-3 fw-semibold" data-filter="owner" onclick="setSakinFilter(this, 'owner')">🏠 Mülk Sahipleri</button>
                <button type="button" class="btn btn-xs btn-outline-info text-dark rounded-pill px-3 fw-semibold" data-filter="tenant" onclick="setSakinFilter(this, 'tenant')">🔑 Kiracılar</button>
                <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-3 fw-semibold" data-filter="board" onclick="setSakinFilter(this, 'board')">🏛️ Yönetici / Aza / Denetçi</button>
                <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill px-3 fw-semibold" data-filter="rule" onclick="setSakinFilter(this, 'rule')">🛡️ Muaf / Farklı Aidat</button>
                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-3 fw-semibold" data-filter="empty" onclick="setSakinFilter(this, 'empty')">⏳ Boş / Girilmemiş</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="sakinlerTable">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3">Bina</th>
                            <th>Kat / Kapı No</th>
                            <th>Tür &amp; Net Aidat Hesabı</th>
                            <th>Ev Sahibi (Malik)</th>
                            <th>Kiracı (Sabit Aidat)</th>
                            <th>Durum &amp; Kurul Görevi</th>
                            <th class="pe-3 text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Henüz bağımsız bölüm bulunmuyor.
                                    @if (targetWizardId > 0)
                                    {
                                        <div class="mt-2">
                                            <a href="/BuildingManager/Onboarding/@targetWizardId" class="btn btn-sm btn-primary rounded-pill px-4">Sihirbaza Dön ve Daireleri Oluştur</a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var unit in Model)
                            {
                                bool isShop = unit.Category == "Dukkan" || unit.Category == "Dükkan";
                                var effCalc = GMK360.Web.Services.FacilityGovernanceService.ComputeUnitEffectiveMonthlyDues(unit, unit.Building?.DefaultBaseMonthlyDues ?? 0m);
                                decimal diffPct = Math.Round((unit.DuesMultiplier - 1.00m) * 100m, 2);
                                bool isUnitExempt = unit.IsDuesExempt || unit.DuesMultiplier <= 0m || (unit.FixedMonthlyDues.HasValue && unit.FixedMonthlyDues.Value == 0m);
                                bool hasDuesRule = isUnitExempt || diffPct != 0m || unit.DuesAdjustmentAmount != 0m || (unit.FixedMonthlyDues.HasValue && unit.FixedMonthlyDues > 0) || unit.IsExemptFromElevator || unit.IsExemptFromStairwell || unit.CleaningParticipationPercent != 100m;
                                bool hasOwner = !string.IsNullOrWhiteSpace(unit.OwnerName);
                                bool hasTenantRow = !unit.IsEmpty && (!string.IsNullOrWhiteSpace(unit.TenantName) || !string.IsNullOrWhiteSpace(unit.TenantPhone) || !string.IsNullOrWhiteSpace(unit.TenantEmail));
                                var rowRoles = ResolveUnitRoles(unit);
                                bool isBoardMember = rowRoles.Any();
                                var searchBlob = $"{unit.Building?.Name} {unit.DoorNumber} {unit.OwnerName} {unit.OwnerPhone} {unit.TenantName} {unit.TenantPhone} {unit.DuesRuleNote} {string.Join(" ", rowRoles.Select(r => r.Label))}".ToLowerInvariant();
                                <tr class="sakin-row"
                                    data-has-owner="@(hasOwner ? "1" : "0")"
                                    data-has-tenant="@(hasTenantRow ? "1" : "0")"
                                    data-is-board="@(isBoardMember ? "1" : "0")"
                                    data-has-rule="@(hasDuesRule ? "1" : "0")"
                                    data-is-empty="@((unit.IsEmpty || !hasOwner) ? "1" : "0")"
                                    data-search="@searchBlob">
                                    <td class="ps-3"><span class="badge bg-light text-dark border">@(unit.Building?.BlockName ?? unit.Building?.Name)</span></td>
                                    <td>
                                        <div class="fw-bold text-dark">@(isShop ? $"Dükkan {unit.DoorNumber}" : $"Daire {unit.DoorNumber}")</div>
                                        <small class="text-muted d-block">@(unit.FloorName ?? $"{unit.FloorLevel}. Kat")</small>
                                        <span class="badge bg-light text-secondary border mt-1" style="font-size:.66rem;" title="Oran ve muafiyet kuralları kişiye değil bu mülk ID'sine bağlıdır">Mülk ID #@unit.Id</span>
                                    </td>
                                    <td>
                                        @{
                                            decimal buildingBase = unit.Building?.DefaultBaseMonthlyDues ?? 0m;
                                        }
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            @if (isShop)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Dükkan</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Daire (@(unit.RoomLayout ?? "3+1"))</span>
                                            }
                                            @if (isUnitExempt)
                                            {
                                                <span class="badge bg-dark text-white fw-bold">Net: 0 ₺ (MUAF)</span>
                                            }
                                            else if (effCalc.Amount > 0m)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold" title="@effCalc.BreakdownNote">Net Ödeyecek: @effCalc.Amount.ToString("N0") ₺/ay</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Baz Aidat Girilmedi</span>
                                            }
                                        </div>
                                        @if (buildingBase > 0m)
                                        {
                                            <div class="text-muted mt-1" style="font-size:.73rem;">
                                                Baz: <b>@buildingBase.ToString("N0") ₺</b>
                                                @if (isUnitExempt)
                                                {
                                                    <span>&rarr; <span class="text-danger fw-semibold">%100 Aidat Muafiyeti</span></span>
                                                }
                                                else if (unit.FixedMonthlyDues.HasValue && unit.FixedMonthlyDues > 0)
                                                {
                                                    <span>&rarr; <span class="text-primary fw-semibold">Sabit İstisna: @unit.FixedMonthlyDues.Value.ToString("N0") ₺</span></span>
                                                }
                                                else if (diffPct != 0m || unit.DuesAdjustmentAmount != 0m)
                                                {
                                                    <span>
                                                        @if (diffPct != 0m)
                                                        {
                                                            <span class="@(diffPct > 0m ? "text-warning-emphasis" : "text-info-emphasis") fw-semibold">@(diffPct > 0m ? $"+%{diffPct:0.##} Fark" : $"-%{Math.Abs(diffPct):0.##} Muaf/İndirim")</span>
                                                        }
                                                        @if (unit.DuesAdjustmentAmount != 0m)
                                                        {
                                                            <span class="@(unit.DuesAdjustmentAmount > 0 ? "text-warning-emphasis" : "text-info-emphasis") fw-semibold"> @(unit.DuesAdjustmentAmount > 0 ? $"+{unit.DuesAdjustmentAmount:N0} ₺ Fark" : $"{unit.DuesAdjustmentAmount:N0} ₺ İndirim")</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>&bull; Standart Tarife</span>
                                                }
                                            </div>
                                        }
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @if (unit.IsExemptFromElevator)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis">Asansör Muaf</span>
                                            }
                                            @if (unit.IsExemptFromStairwell)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis">Merdiven Muaf</span>
                                            }
                                            @if (unit.CleaningParticipationPercent != 100m)
                                            {
                                                <span class="badge @(unit.CleaningParticipationPercent > 100m ? "bg-warning-subtle text-warning-emphasis" : "bg-secondary-subtle text-dark")">Görevli/Temizlik %@unit.CleaningParticipationPercent.ToString("0.##")</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(unit.DuesRuleNote))
                                        {
                                            <small class="text-muted d-block mt-1" style="font-size:.72rem;"><i class="bi bi-tag me-1"></i>@unit.DuesRuleNote</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(unit.OwnerName))
                                        {
                                            <div class="fw-semibold text-dark">@unit.OwnerName</div>
                                            <small class="text-muted d-block">@(unit.OwnerPhone ?? "-")</small>
                                            @if (!string.IsNullOrWhiteSpace(unit.OwnerEmail))
                                            {
                                                <small class="text-primary d-block">@unit.OwnerEmail</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Henüz girilmedi</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(unit.TenantName))
                                        {
                                            <div class="fw-semibold text-info">@unit.TenantName</div>
                                            <small class="text-muted d-block">@(unit.TenantPhone ?? "-")</small>
                                            @if (!string.IsNullOrWhiteSpace(unit.TenantEmail))
                                            {
                                                <small class="text-primary d-block">@unit.TenantEmail</small>
                                            }
                                            <span class="badge bg-light text-secondary border mt-1" style="font-size:.66rem;">Aidat Mükellefi (Oy/Toplantı Yok)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Kiracı Yok</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                                            @if (unit.IsEmpty)
                                            {
                                                <span class="badge bg-secondary">Boş</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Dolu</span>
                                            }
                                            @foreach (var r in rowRoles)
                                            {
                                                <span class="badge @r.BadgeCss rounded-pill">@r.Label</span>
                                            }
                                        </div>
                                        @{
                                            bool hasOwnerPin = !string.IsNullOrWhiteSpace(unit.OwnerQuickPinHash) || !string.IsNullOrWhiteSpace(unit.ResidentQuickPinHash);
                                            bool hasTenant = !unit.IsEmpty && (!string.IsNullOrWhiteSpace(unit.TenantName) || !string.IsNullOrWhiteSpace(unit.TenantPhone) || !string.IsNullOrWhiteSpace(unit.TenantEmail));
                                            bool hasTenantPin = !string.IsNullOrWhiteSpace(unit.TenantQuickPinHash) || !string.IsNullOrWhiteSpace(unit.ResidentQuickPinHash);
                                            var ownerProfile = (!string.IsNullOrEmpty(unit.OwnerUserId) && residentProfiles.ContainsKey(unit.OwnerUserId)) ? residentProfiles[unit.OwnerUserId] : null;
                                            var tenantProfile = (!string.IsNullOrEmpty(unit.TenantUserId) && residentProfiles.ContainsKey(unit.TenantUserId)) ? residentProfiles[unit.TenantUserId] : null;
                                            string ownerToken = ownerProfile?.ActivationToken ?? "";
                                            string tenantToken = tenantProfile?.ActivationToken ?? "";
                                        }
                                        @if (ownerProfile != null && ownerProfile.IsTransactionPinSet)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle d-block mt-1">🔐 Malik Profil &amp; Kişisel PIN Hazır</span>
                                        }
                                        else if (ownerProfile != null && !string.IsNullOrEmpty(ownerToken))
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                <button type="button" class="btn btn-xs btn-outline-warning text-dark border flex-grow-1 fw-semibold" style="font-size:.72rem;"
                                                        onclick="copyActivationUrl('@ownerToken')">
                                                    🔗 Malik Linki Kopyala
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-success border fw-semibold" style="font-size:.72rem;" title="WhatsApp Daveti Kopyala / Aç"
                                                        onclick="sendWhatsAppActivation('@ownerToken', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerPhone ?? "")', 'Malik (@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerName ?? unit.DoorNumber))')">
                                                    💬
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(unit.OwnerEmail))
                                                {
                                                    <form asp-action="SendResidentActivationEmail" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="unitId" value="@unit.Id" />
                                                        <input type="hidden" name="buildingId" value="@unit.BuildingId" />
                                                        <input type="hidden" name="roleType" value="Owner" />
                                                        <input type="hidden" name="selectedBuildingFilter" value="@selectedBuildingId" />
                                                        <button type="submit" class="btn btn-xs btn-outline-primary border fw-semibold" style="font-size:.72rem;" title="E-posta İle Davet Gönder">✉️</button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                        else if (hasOwnerPin)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-block mt-1">🔑 Eski Daire PIN Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border d-block mt-1">Malik Profili Yok</span>
                                        }
                                        @if (hasTenant)
                                        {
                                            if (tenantProfile != null && tenantProfile.IsTransactionPinSet)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle d-block mt-1">🔐 Kiracı Profil &amp; Kişisel PIN Hazır</span>
                                            }
                                            else if (tenantProfile != null && !string.IsNullOrEmpty(tenantToken))
                                            {
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    <button type="button" class="btn btn-xs btn-outline-primary border flex-grow-1 fw-semibold" style="font-size:.72rem;"
                                                            onclick="copyActivationUrl('@tenantToken')">
                                                        🔗 Kiracı Linki Kopyala
                                                    </button>
                                                    <button type="button" class="btn btn-xs btn-outline-success border fw-semibold" style="font-size:.72rem;" title="WhatsApp Daveti Kopyala / Aç"
                                                            onclick="sendWhatsAppActivation('@tenantToken', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantPhone ?? "")', 'Kiracı (@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantName ?? unit.DoorNumber))')">
                                                        💬
                                                    </button>
                                                    @if (!string.IsNullOrWhiteSpace(unit.TenantEmail))
                                                    {
                                                        <form asp-action="SendResidentActivationEmail" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="unitId" value="@unit.Id" />
                                                            <input type="hidden" name="buildingId" value="@unit.BuildingId" />
                                                            <input type="hidden" name="roleType" value="Tenant" />
                                                            <input type="hidden" name="selectedBuildingFilter" value="@selectedBuildingId" />
                                                            <button type="submit" class="btn btn-xs btn-outline-primary border fw-semibold" style="font-size:.72rem;" title="E-posta İle Davet Gönder">✉️</button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                            else if (hasTenantPin)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle d-block mt-1">🔑 Eski Kiracı PIN Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-danger border d-block mt-1">Kiracı Profili Bekliyor</span>
                                            }
                                        }
                                    </td>
                                    <td class="pe-3 text-end">
                                        <div class="d-flex flex-wrap justify-content-end gap-1">
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold"
                                                    onclick="openEditUnitModal(@unit.Id, @unit.BuildingId, '@System.Web.HttpUtility.JavaScriptStringEncode(unit.DoorNumber)', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerName ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerPhone ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerEmail ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantName ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantPhone ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantEmail ?? "")', @(unit.IsEmpty ? "true" : "false"), '@unit.LandShare.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)', '@((unit.GrossSquareMeters ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))', '@unit.DuesMultiplier.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)', '@(unit.FixedMonthlyDues.HasValue ? unit.FixedMonthlyDues.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")', @(unit.IsExemptFromElevator ? "true" : "false"), @(unit.IsExemptFromStairwell ? "true" : "false"), '@unit.CleaningParticipationPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.DuesRuleNote ?? "")', '@ownerToken', '@tenantToken', @(unit.IsDuesExempt ? "true" : "false"), '@unit.DuesAdjustmentAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)', '@((unit.Building?.DefaultBaseMonthlyDues ?? 0m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))')">
                                                <i class="bi bi-pencil-square me-1"></i> Bilgi Gir / Düzenle
                                            </button>
                                            <a href="/BuildingManager/Detail/@unit.BuildingId" class="btn btn-sm btn-outline-secondary rounded-pill" title="Bina Masası">
                                                <i class="bi bi-building"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bölüm Malik & Kiracı Güncelleme Modalı (2 Sekmeli Sade Düzen) -->
<div class="modal fade" id="editUnitContactsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content rounded-4 border-0 shadow" asp-action="UpdateUnitContacts" asp-controller="BuildingManager" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="unitId" id="euUnitId" />
            <input type="hidden" name="buildingId" id="euBuildingId" />
            <input type="hidden" name="selectedBuildingFilter" value="@selectedBuildingId" />
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-vcard me-2"></i><span id="euTitle">Bölüm Bilgileri</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-pills nav-fill gap-2 mb-3 bg-light p-1 rounded-3 border" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold small py-2" id="euTabResidentsBtn" data-bs-toggle="tab" data-bs-target="#euTabResidents" type="button" role="tab">
                            <i class="bi bi-people me-1"></i> 1. Sakinler &amp; Ayrı PWA PIN
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold small py-2" id="euTabRulesBtn" data-bs-toggle="tab" data-bs-target="#euTabRules" type="button" role="tab">
                            <i class="bi bi-sliders me-1"></i> 2. Tapu &amp; Aidat Kuralları (Yönetim Planı)
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- SEKME 1: MALİK & KİRACI AYRI GİRİŞ BİLGİLERİ -->
                    <div class="tab-pane fade show active" id="euTabResidents" role="tabpanel">
                        <div class="border rounded-4 p-3 mb-3 bg-warning bg-opacity-10 border-warning-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-dark"><i class="bi bi-house-heart me-1 text-warning-emphasis"></i> Ev Sahibi (Malik) &amp; Malik PWA Girişi</span>
                                <button type="button" class="btn btn-sm btn-outline-dark rounded-pill fw-semibold" onclick="copyResidentInviteByRole('Owner')">
                                    <i class="bi bi-whatsapp me-1"></i> Malik Daveti Kopyala
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Ev Sahibi Adı Soyadı</label>
                                    <input type="text" name="ownerName" id="euOwnerName" class="form-control form-control-sm" placeholder="Örn: Ahmet Yılmaz" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Malik Telefon (PWA Girişi)</label>
                                    <input type="text" name="ownerPhone" id="euOwnerPhone" class="form-control form-control-sm" placeholder="05XX XXX XX XX" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Malik E-Posta</label>
                                    <input type="email" name="ownerEmail" id="euOwnerEmail" class="form-control form-control-sm" placeholder="malik@ornek.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Malik T.C. Kimlik No (Opsiyonel)</label>
                                    <input type="text" inputmode="numeric" maxlength="11" name="ownerTcNo" class="form-control form-control-sm" placeholder="Biliniyorsa 11 hane (Yoksa kullanıcı aktivasyonda girer)" />
                                </div>
                            </div>
                        </div>

                        <div class="border rounded-4 p-3 mb-3 bg-info bg-opacity-10 border-info-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-dark"><i class="bi bi-key me-1 text-info-emphasis"></i> Kiracı (Varsa) &amp; Profil Aktivasyonu</span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold" onclick="copyResidentInviteByRole('Tenant')">
                                    <i class="bi bi-whatsapp me-1"></i> Kiracı Daveti Kopyala
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı Adı Soyadı</label>
                                    <input type="text" name="tenantName" id="euTenantName" class="form-control form-control-sm" placeholder="Malik oturuyorsa boş bırakın" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı Telefon (PWA Girişi)</label>
                                    <input type="text" name="tenantPhone" id="euTenantPhone" class="form-control form-control-sm" placeholder="05XX XXX XX XX" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı E-Posta</label>
                                    <input type="email" name="tenantEmail" id="euTenantEmail" class="form-control form-control-sm" placeholder="kiraci@ornek.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı T.C. Kimlik No (Opsiyonel)</label>
                                    <input type="text" inputmode="numeric" maxlength="11" name="tenantTcNo" class="form-control form-control-sm" placeholder="Biliniyorsa 11 hane (Yoksa kiracı aktivasyonda girer)" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 border">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="isEmpty" value="true" id="euIsEmpty">
                                <label class="form-check-label fw-bold small" for="euIsEmpty">Bölüm Şu An Boş (Kiracı Temizlenir)</label>
                            </div>
                            <small class="text-muted">Malik ve Kiracı kendi Telefon + PIN'i ile ayrı panel görür.</small>
                        </div>
                    </div>

                    <!-- SEKME 2: BÖLÜM ID TAPU & YÖNETİM PLANI KURALLARI -->
                    <div class="tab-pane fade" id="euTabRules" role="tabpanel">
                        <div class="alert alert-light border small mb-2">
                            <i class="bi bi-building-lock me-1 text-primary"></i>
                            <strong>Mülk (Bölüm ID) Bazlı Kurallar:</strong> Bu oranlar kişiye değil doğrudan <strong>bağımsız bölüm ID'sine</strong> tanımlanır; kiracı değişse bile mülk kuralı korunur.
                        </div>
                        <div class="p-2 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="small">
                                <span class="text-muted">Sabit Baz Aidat:</span> <strong class="text-dark" id="euPreviewBase">0,00 ₺</strong>
                            </div>
                            <div class="small fw-bold text-primary" id="euPreviewTotal">
                                Hesaplanan Bölüm Aidatı: 0,00 ₺
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="applyUnitRulePreset(1.0, 100, false, false, 'Standart konut')">🏠 Standart Konut (%0)</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="applyUnitRulePreset(1.25, 100, false, false, 'Ofis kullanımı (Asansör & ortak alan yoğunluğu +%25)')">💼 Ofis Daire (+%25 · Asansör)</button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="applyUnitRulePreset(1.0, 100, true, true, 'Zemin kat dükkan (Asansör/merdiven muaf)')">🏪 Zemin Dükkan (Asansör Muaf)</button>
                            <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill" onclick="applyUnitRulePreset(1.5, 150, true, true, 'Yoğun ticari / kafe (Asansör muaf, işletme +%50)')">☕ Yoğun İşyeri (+%50 · Asansör Muaf)</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyUnitRulePreset(0.5, 50, true, true, 'Depo / düşük kullanım (-%50)')">📦 Depo (-%50 · Muaf)</button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Arsa Payı (Malik / Demirbaş)</label>
                                <input type="number" step="0.0001" name="landShare" id="euLandShare" class="form-control" placeholder="Örn: 12.5" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Brüt m²</label>
                                <input type="number" step="0.1" name="grossSquareMeters" id="euGrossSqm" class="form-control" placeholder="Örn: 110" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Baz Aidattan % Fark</label>
                                <div class="input-group">
                                    <span class="input-group-text small fw-bold">%</span>
                                    <input type="number" step="5" min="-100" max="400" id="euDuesPctDiff" class="form-control fw-bold" value="0" oninput="syncMultFromPct()" />
                                </div>
                                <small class="text-muted" style="font-size:.7rem;">Örn: Ofis için +25, indirim için -20</small>
                                <input type="hidden" name="duesMultiplier" id="euDuesMultiplier" value="1" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Sabit Tutar Farkı (+/- ₺)</label>
                                <input type="number" step="10" name="duesAdjustmentAmount" id="euDuesAdj" class="form-control" value="0" placeholder="-200 veya +200" oninput="updateUnitDuesPreview()" />
                                <small class="text-muted" style="font-size:.7rem;">% fark yerine sabit ₺ eklemek isterseniz</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">İstisna Sabit Aidat (₺)</label>
                                <input type="number" step="0.01" min="0" name="fixedMonthlyDues" id="euFixedDues" class="form-control" placeholder="Boş=Baz×%Oran (Önerilen)" oninput="updateUnitDuesPreview()" />
                                <small class="text-muted" style="font-size:.7rem;">Doldurulursa baz artıştan etkilenmez</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Bina Görevlisi &amp; Temizlik Katılımı (%)</label>
                                <select id="euCleanSelect" class="form-select" onchange="syncCleaningInput()">
                                    <option value="100">%100 — Standart Katılım</option>
                                    <option value="0">%0 — Temizlik / Görevli Muaf</option>
                                    <option value="50">%50 — Yarı Katılım (Depo/Boş)</option>
                                    <option value="150">%150 — Yoğun Ticari Kullanım</option>
                                    <option value="200">%200 — Çift Kat (Restoran/Kafe)</option>
                                    <option value="custom">Özel Oran Gir...</option>
                                </select>
                                <input type="number" step="5" min="0" max="500" name="cleaningParticipationPercent" id="euCleaningPct" class="form-control form-control-sm mt-1 d-none" value="100" />
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="isDuesExempt" value="true" id="euIsDuesExempt" onchange="updateUnitDuesPreview()">
                                    <input type="hidden" name="isDuesExempt" value="false" />
                                    <label class="form-check-label small fw-bold text-danger" for="euIsDuesExempt">Aidattan Tam Muaf (0 ₺ — Yönetici/Kapıcı)</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isExemptFromElevator" value="true" id="euExemptElev">
                                    <input type="hidden" name="isExemptFromElevator" value="false" />
                                    <label class="form-check-label small fw-semibold" for="euExemptElev">Asansör Gider Kaleminden Muaf</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isExemptFromStairwell" value="true" id="euExemptStair">
                                    <input type="hidden" name="isExemptFromStairwell" value="false" />
                                    <label class="form-check-label small fw-semibold" for="euExemptStair">Merdiven/Aydınlatmadan Muaf</label>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold small">Fark / Kullanım Sebebi (Hazır)</label>
                                <select id="euRuleReasonPreset" class="form-select" onchange="applyRuleReasonPreset()">
                                    <option value="">-- Sebep Seçin (Opsiyonel) --</option>
                                    <option value="Standart konut">Standart konut</option>
                                    <option value="Ofis kullanımı (Asansör & ortak alan yoğunluğu)">Ofis kullanımı (Asansör yoğunluğu)</option>
                                    <option value="Zemin kat dükkan (Asansör muaf)">Zemin kat dükkan (Asansör muaf)</option>
                                    <option value="Dubleks / büyük m² farkı">Dubleks / büyük m² farkı</option>
                                    <option value="Yönetici / görevli muafiyeti">Yönetici / görevli muafiyeti</option>
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label fw-bold small">Yönetim Planı Notu (Listede Görünür)</label>
                                <input type="text" name="duesRuleNote" id="euRuleNote" class="form-control" placeholder="Örn: Ofis kullanımı — Asansör yoğunluğu +%25" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@if (buildings.Any())
{
    <!-- Toplu Katsayı & Muafiyet Profili Modalı -->
    <div class="modal fade" id="bulkDuesProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="BulkApplyUnitDuesProfile" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Sakinler" />
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-sliders me-2"></i>Toplu Katsayı &amp; Muafiyet Profili Uygula</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Bina</label>
