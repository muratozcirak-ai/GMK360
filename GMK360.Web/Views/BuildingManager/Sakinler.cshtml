@model IEnumerable<GMK360.Core.Entities.BuildingUnit>
@{
    ViewData["Title"] = "Mal Sahibi & Kiracılar (Bağımsız Bölümler)";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    int targetWizardId = selectedBuildingId ?? buildings.FirstOrDefault()?.Id ?? 0;
    bool hasAuthorityDoc = ViewBag.HasAuthorityDoc is bool ha && ha;

    int aptCount = Model.Count(u => u.Category != "Dukkan" && u.Category != "Dükkan");
    int shopCount = Model.Count(u => u.Category == "Dukkan" || u.Category == "Dükkan");
}

<div class="container-fluid py-3 px-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-success me-2"></i>Mal Sahibi &amp; Kiracılar (@aptCount Daire, @shopCount Dükkan)</h2>
            <p class="text-muted small mb-0">Kurulumda tanımladığınız her bağımsız bölüm için buradan doğrudan malik ve kiracı bilgisi girebilirsiniz.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (targetWizardId > 0)
            {
                <button type="button" class="btn btn-outline-primary rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#bulkDuesProfileModal">
                    <i class="bi bi-sliders me-1"></i> Toplu Katsayı &amp; Muafiyet Uygula
                </button>
                <button type="button" class="btn btn-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addUnitQuickModal">
                    <i class="bi bi-plus-circle me-1"></i> Yeni Bölüm Ekle
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!hasAuthorityDoc && targetWizardId > 0)
    {
        <div class="alert alert-info rounded-4 border-0 shadow-sm mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="small">
                <i class="bi bi-info-circle-fill me-1"></i>
                <strong>KVKK &amp; Yetki Belgesi Notu:</strong> Sakinlerin telefon, e-posta ve PWA giriş PIN bilgilerini buradan hemen tanımlayabilirsiniz. Kurumsal arşiv için Karar Defteri yetki yazısını da eklemeniz önerilir.
            </div>
            <a href="/BuildingManager/Onboarding/@targetWizardId" class="btn btn-sm btn-outline-dark rounded-pill px-3">Yetki Belgesi Yükle &rarr;</a>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-door-open text-primary me-2"></i>Daire &amp; Dükkan Sakin Listesi (@Model.Count() Bölüm)</h5>
            <form method="get" class="d-flex gap-2">
                <select name="buildingId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Tüm Binalar</option>
                    @foreach (var b in buildings)
                    {
                        if (selectedBuildingId == b.Id)
                        {
                            <option value="@b.Id" selected>@b.Name</option>
                        }
                        else
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    }
                </select>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3">Bina</th>
                            <th>Kat / Kapı No</th>
                            <th>Tür</th>
                            <th>Ev Sahibi (Malik)</th>
                            <th>Kiracı (Sakin)</th>
                            <th>Durum</th>
                            <th class="pe-3 text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Henüz bağımsız bölüm bulunmuyor.
                                    @if (targetWizardId > 0)
                                    {
                                        <div class="mt-2">
                                            <a href="/BuildingManager/Onboarding/@targetWizardId" class="btn btn-sm btn-primary rounded-pill px-4">Sihirbaza Dön ve Daireleri Oluştur</a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var unit in Model)
                            {
                                bool isShop = unit.Category == "Dukkan" || unit.Category == "Dükkan";
                                <tr>
                                    <td class="ps-3"><span class="badge bg-light text-dark border">@unit.Building?.Name</span></td>
                                    <td>
                                        <div class="fw-bold text-dark">@(isShop ? $"Dükkan {unit.DoorNumber}" : $"Daire {unit.DoorNumber}")</div>
                                        <small class="text-muted">@(unit.FloorName ?? $"{unit.FloorLevel}. Kat")</small>
                                    </td>
                                    <td>
                                        @if (isShop)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Dükkan</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Daire (@(unit.RoomLayout ?? "3+1"))</span>
                                        }
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @if (unit.DuesMultiplier != 1.00m)
                                            {
                                                <span class="badge bg-dark-subtle text-dark">@unit.DuesMultiplier.ToString("0.##")x Katsayı</span>
                                            }
                                            @if (unit.FixedMonthlyDues.HasValue && unit.FixedMonthlyDues > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success">Aidat: @unit.FixedMonthlyDues.Value.ToString("N0") ₺</span>
                                            }
                                            @if (unit.IsExemptFromElevator)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis">Asansör Muaf</span>
                                            }
                                            @if (unit.IsExemptFromStairwell)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis">Merdiven Muaf</span>
                                            }
                                            @if (unit.CleaningParticipationPercent != 100m)
                                            {
                                                <span class="badge @(unit.CleaningParticipationPercent > 100m ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-dark")">Çöp %@unit.CleaningParticipationPercent.ToString("0.##")</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(unit.OwnerName))
                                        {
                                            <div class="fw-semibold text-dark">@unit.OwnerName</div>
                                            <small class="text-muted">@(unit.OwnerPhone ?? unit.OwnerEmail ?? "-")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Henüz girilmedi</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(unit.TenantName))
                                        {
                                            <div class="fw-semibold text-info">@unit.TenantName</div>
                                            <small class="text-muted">@(unit.TenantPhone ?? unit.TenantEmail ?? "-")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Kiracı Yok</span>
                                        }
                                    </td>
                                    <td>
                                        @if (unit.IsEmpty)
                                        {
                                            <span class="badge bg-secondary">Boş</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Dolu</span>
                                        }
                                        @{
                                            bool hasOwnerPin = !string.IsNullOrWhiteSpace(unit.OwnerQuickPinHash) || !string.IsNullOrWhiteSpace(unit.ResidentQuickPinHash);
                                            bool hasTenant = !unit.IsEmpty && (!string.IsNullOrWhiteSpace(unit.TenantName) || !string.IsNullOrWhiteSpace(unit.TenantPhone));
                                            bool hasTenantPin = !string.IsNullOrWhiteSpace(unit.TenantQuickPinHash) || !string.IsNullOrWhiteSpace(unit.ResidentQuickPinHash);
                                        }
                                        @if (hasOwnerPin)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-block mt-1">🔑 Malik PIN Hazır</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border d-block mt-1">Malik PIN Yok</span>
                                        }
                                        @if (hasTenant)
                                        {
                                            if (hasTenantPin)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle d-block mt-1">🔑 Kiracı PIN Hazır</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-danger border d-block mt-1">Kiracı PIN Yok</span>
                                            }
                                        }
                                    </td>
                                    <td class="pe-3 text-end">
                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold"
                                                onclick="openEditUnitModal(@unit.Id, @unit.BuildingId, '@System.Web.HttpUtility.JavaScriptStringEncode(unit.DoorNumber)', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerName ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerPhone ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.OwnerEmail ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantName ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantPhone ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.TenantEmail ?? "")', @(unit.IsEmpty ? "true" : "false"), '@unit.LandShare.ToString(System.Globalization.CultureInfo.InvariantCulture)', '@((unit.GrossSquareMeters ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))', '@unit.DuesMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)', '@((unit.FixedMonthlyDues ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))', @(unit.IsExemptFromElevator ? "true" : "false"), @(unit.IsExemptFromStairwell ? "true" : "false"), '@unit.CleaningParticipationPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)', '@System.Web.HttpUtility.JavaScriptStringEncode(unit.DuesRuleNote ?? "")')">
                                            <i class="bi bi-pencil-square me-1"></i> Bilgi Gir / Düzenle
                                        </button>
                                        <a href="/BuildingManager/Detail/@unit.BuildingId" class="btn btn-sm btn-outline-secondary rounded-pill" title="Bina Masası">
                                            <i class="bi bi-building"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bölüm Malik & Kiracı Güncelleme Modalı (2 Sekmeli Sade Düzen) -->
<div class="modal fade" id="editUnitContactsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content rounded-4 border-0 shadow" asp-action="UpdateUnitContacts" asp-controller="BuildingManager" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="unitId" id="euUnitId" />
            <input type="hidden" name="buildingId" id="euBuildingId" />
            <input type="hidden" name="selectedBuildingFilter" value="@selectedBuildingId" />
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-vcard me-2"></i><span id="euTitle">Bölüm Bilgileri</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-pills nav-fill gap-2 mb-3 bg-light p-1 rounded-3 border" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold small py-2" id="euTabResidentsBtn" data-bs-toggle="tab" data-bs-target="#euTabResidents" type="button" role="tab">
                            <i class="bi bi-people me-1"></i> 1. Sakinler &amp; Ayrı PWA PIN
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold small py-2" id="euTabRulesBtn" data-bs-toggle="tab" data-bs-target="#euTabRules" type="button" role="tab">
                            <i class="bi bi-sliders me-1"></i> 2. Tapu &amp; Aidat Kuralları (Yönetim Planı)
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- SEKME 1: MALİK & KİRACI AYRI GİRİŞ BİLGİLERİ -->
                    <div class="tab-pane fade show active" id="euTabResidents" role="tabpanel">
                        <div class="border rounded-4 p-3 mb-3 bg-warning bg-opacity-10 border-warning-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-dark"><i class="bi bi-house-heart me-1 text-warning-emphasis"></i> Ev Sahibi (Malik) &amp; Malik PWA Girişi</span>
                                <button type="button" class="btn btn-sm btn-outline-dark rounded-pill fw-semibold" onclick="copyResidentInviteByRole('Owner')">
                                    <i class="bi bi-whatsapp me-1"></i> Malik Daveti Kopyala
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Ev Sahibi Adı Soyadı</label>
                                    <input type="text" name="ownerName" id="euOwnerName" class="form-control form-control-sm" placeholder="Örn: Ahmet Yılmaz" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Malik Telefon (PWA Girişi)</label>
                                    <input type="text" name="ownerPhone" id="euOwnerPhone" class="form-control form-control-sm" placeholder="05XX XXX XX XX" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Malik E-Posta</label>
                                    <input type="email" name="ownerEmail" id="euOwnerEmail" class="form-control form-control-sm" placeholder="malik@ornek.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Malik PWA PIN (4-6 Hane)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" maxlength="6" name="ownerQuickPin" id="euOwnerQuickPin" class="form-control" placeholder="Değişmeyecekse boş bırakın" />
                                        <button type="button" class="btn btn-outline-secondary" onclick="generatePinForInput('euOwnerQuickPin')" title="Rastgele PIN Üret">🎲</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="border rounded-4 p-3 mb-3 bg-info bg-opacity-10 border-info-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-dark"><i class="bi bi-key me-1 text-info-emphasis"></i> Kiracı (Varsa) &amp; Kiracı PWA Girişi</span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold" onclick="copyResidentInviteByRole('Tenant')">
                                    <i class="bi bi-whatsapp me-1"></i> Kiracı Daveti Kopyala
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı Adı Soyadı</label>
                                    <input type="text" name="tenantName" id="euTenantName" class="form-control form-control-sm" placeholder="Malik oturuyorsa boş bırakın" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı Telefon (PWA Girişi)</label>
                                    <input type="text" name="tenantPhone" id="euTenantPhone" class="form-control form-control-sm" placeholder="05XX XXX XX XX" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı E-Posta</label>
                                    <input type="email" name="tenantEmail" id="euTenantEmail" class="form-control form-control-sm" placeholder="kiraci@ornek.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">Kiracı PWA PIN (4-6 Hane)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" maxlength="6" name="tenantQuickPin" id="euTenantQuickPin" class="form-control" placeholder="Değişmeyecekse boş bırakın" />
                                        <button type="button" class="btn btn-outline-secondary" onclick="generatePinForInput('euTenantQuickPin')" title="Rastgele PIN Üret">🎲</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 border">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="isEmpty" value="true" id="euIsEmpty">
                                <label class="form-check-label fw-bold small" for="euIsEmpty">Bölüm Şu An Boş (Kiracı Temizlenir)</label>
                            </div>
                            <small class="text-muted">Malik ve Kiracı kendi Telefon + PIN'i ile ayrı panel görür.</small>
                        </div>
                    </div>

                    <!-- SEKME 2: BÖLÜM TAPU & YÖNETİM PLANI KURALLARI -->
                    <div class="tab-pane fade" id="euTabRules" role="tabpanel">
                        <div class="alert alert-light border small text-muted mb-2">
                            <i class="bi bi-info-circle me-1 text-primary"></i>
                            <strong>Bölüm Kullanım Tipi &amp; Kurallar:</strong> Daire ofise döndüyse veya bu dükkan yoğun kullanılıyorsa tek tıkla profil seçin, kiracı değişse bile sabit kalır.
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="applyUnitRulePreset(1.0, 100, false, false, 'Normal konut dairesi')">🏠 Normal Daire (1.0x)</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="applyUnitRulePreset(1.5, 150, false, false, 'Ofise çevrilmiş daire (Asansör dahil, yoğun kullanım)')">💼 Ofis Daire (1.5x, Asansör Dahil)</button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="applyUnitRulePreset(1.0, 100, true, true, 'Zemin kat dükkan (Asansör/merdiven muaf)')">🏪 Zemin Dükkan (Asansör Muaf)</button>
                            <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill" onclick="applyUnitRulePreset(1.5, 150, true, true, 'Yoğun dükkan / kafe (Asansör muaf, çöp/aidat artışı)')">☕ Yoğun Dükkan (1.5x, Asansör Muaf)</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill" onclick="applyUnitRulePreset(0.5, 50, true, true, 'Depo / düşük kullanım')">📦 Depo (0.5x, Muaf)</button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Arsa Payı (Malik / Demirbaş)</label>
                                <input type="number" step="0.0001" name="landShare" id="euLandShare" class="form-control" placeholder="Örn: 12.5" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Brüt m²</label>
                                <input type="number" step="0.1" name="grossSquareMeters" id="euGrossSqm" class="form-control" placeholder="Örn: 110" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Aidat Katsayısı</label>
                                <input type="number" step="0.05" min="0" max="10" name="duesMultiplier" id="euDuesMultiplier" class="form-control" value="1" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Sabit Aylık Aidat (₺)</label>
                                <input type="number" step="0.01" min="0" name="fixedMonthlyDues" id="euFixedDues" class="form-control" placeholder="Opsiyonel" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Çöp/Temizlik (%)</label>
                                <input type="number" step="5" min="0" max="500" name="cleaningParticipationPercent" id="euCleaningPct" class="form-control" value="100" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isExemptFromElevator" value="true" id="euExemptElev">
                                    <input type="hidden" name="isExemptFromElevator" value="false" />
                                    <label class="form-check-label small fw-semibold" for="euExemptElev">Asansör Giderinden Muaf</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isExemptFromStairwell" value="true" id="euExemptStair">
                                    <input type="hidden" name="isExemptFromStairwell" value="false" />
                                    <label class="form-check-label small fw-semibold" for="euExemptStair">Merdiven/Aydınlatmadan Muaf</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Yönetim Planı Notu</label>
                                <input type="text" name="duesRuleNote" id="euRuleNote" class="form-control" placeholder="Örn: Dış girişli dükkan, asansör muaf, çöp %150" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@if (buildings.Any())
{
    <!-- Toplu Katsayı & Muafiyet Profili Modalı -->
    <div class="modal fade" id="bulkDuesProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="BulkApplyUnitDuesProfile" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Sakinler" />
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-sliders me-2"></i>Toplu Katsayı &amp; Muafiyet Profili Uygula</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Bina</label>
                        <select name="buildingId" class="form-select" required>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id" selected="@(selectedBuildingId == b.Id ? "selected" : null)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Hedef Bölüm Grubu</label>
                        <select name="targetCategory" class="form-select fw-bold">
                            <option value="DUKKAN">🏪 Sadece Dükkanlar</option>
                            <option value="DAIRE">🏠 Sadece Daireler</option>
                            <option value="ALL">🏢 Tüm Bağımsız Bölümler</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Aidat Katsayısı</label>
                        <input type="number" step="0.05" min="0" max="10" name="duesMultiplier" class="form-control" value="1.00" required />
                        <small class="text-muted" style="font-size:0.7rem;">0.5=Yarı, 1=Normal, 1.5/2=Artış</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Sabit Aidat (₺ - Ops.)</label>
                        <input type="number" step="0.01" min="0" name="fixedMonthlyDues" class="form-control" placeholder="Değişmesin" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Çöp/Temizlik (%)</label>
                        <input type="number" step="5" min="0" max="500" name="cleaningParticipationPercent" class="form-control" value="100" required />
                        <small class="text-muted" style="font-size:0.7rem;">Yoğun dükkan: 150-200</small>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isExemptFromElevator" value="true" id="bulkElevSw">
                            <input type="hidden" name="isExemptFromElevator" value="false" />
                            <label class="form-check-label small fw-bold" for="bulkElevSw">Asansör Giderinden Muaf</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isExemptFromStairwell" value="true" id="bulkStairSw">
                            <input type="hidden" name="isExemptFromStairwell" value="false" />
                            <label class="form-check-label small fw-bold" for="bulkStairSw">Merdiven Aydınlatmadan Muaf</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Yönetim Planı Notu</label>
                        <input type="text" name="duesRuleNote" class="form-control" placeholder="Örn: Yönetim Planı Md.8 - Zemin dükkan asansör muaf, çöp %150" />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold w-100">Seçili Gruba Uygula</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Yeni Bölüm Ekle Modalı -->
    <div class="modal fade" id="addUnitQuickModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="AddUnit" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Sakinler" />
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Bağımsız Bölüm &amp; Sakin Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small">Bina</label>
                        <select name="buildingId" class="form-select" required>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id" selected="@(selectedBuildingId == b.Id ? "selected" : null)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Tür</label>
                        <select name="category" class="form-select">
                            <option value="Daire">🏠 Daire</option>
                            <option value="Dukkan">🏪 Dükkan</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Kat</label>
                        <input type="number" name="floorLevel" class="form-control" value="1" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Kapı No *</label>
                        <input type="text" name="unitNumber" class="form-control" required placeholder="18 / D3" />
                    </div>

                    <div class="col-12 border-top pt-2">
                        <div class="fw-bold small text-dark mb-1"><i class="bi bi-person-badge me-1 text-primary"></i> Ev Sahibi (Mülk Sahibi) Bilgileri</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Ev Sahibi Adı</label>
                        <input type="text" name="ownerName" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Malik Telefon (PWA)</label>
                        <input type="text" name="ownerPhone" class="form-control" placeholder="05XX XXX XX XX" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Malik E-Posta</label>
                        <input type="email" name="ownerEmail" class="form-control" placeholder="malik@ornek.com" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Malik PWA PIN</label>
                        <div class="input-group">
                            <input type="text" maxlength="6" name="ownerQuickPin" id="addOwnerPin" class="form-control" placeholder="4-6 hane" />
                            <button type="button" class="btn btn-outline-secondary" onclick="generatePinForInput('addOwnerPin')" title="Rastgele PIN Üret">🎲</button>
                        </div>
                    </div>

                    <div class="col-12 border-top pt-2">
                        <div class="fw-bold small text-dark mb-1"><i class="bi bi-key me-1 text-info"></i> Kiracı Bilgileri (Ev sahibi oturuyorsa boş bırakın)</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Kiracı Adı</label>
                        <input type="text" name="tenantName" class="form-control" placeholder="Örn: Mehmet Kaya" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Kiracı Telefon (PWA)</label>
                        <input type="text" name="tenantPhone" class="form-control" placeholder="05XX XXX XX XX" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Kiracı E-Posta</label>
                        <input type="email" name="tenantEmail" class="form-control" placeholder="kiraci@ornek.com" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Kiracı PWA PIN</label>
                        <div class="input-group">
                            <input type="text" maxlength="6" name="tenantQuickPin" id="addTenantPin" class="form-control" placeholder="4-6 hane" />
                            <button type="button" class="btn btn-outline-secondary" onclick="generatePinForInput('addTenantPin')" title="Rastgele PIN Üret">🎲</button>
                        </div>
                    </div>

                    <div class="col-md-6 border-top pt-3">
                        <label class="form-label fw-bold small">Brüt m²</label>
                        <input type="number" step="0.1" min="0" name="grossSquareMeters" class="form-control" placeholder="Örn: 110" />
                    </div>
                    <div class="col-md-6 border-top pt-3">
                        <label class="form-label fw-bold small">Arsa Payı (Malik Demirbaş)</label>
                        <input type="number" step="0.0001" min="0" name="landShare" class="form-control" placeholder="Örn: 12.5" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isEmpty" value="true" id="addEmptySw">
                            <label class="form-check-label small fw-bold" for="addEmptySw">Bölüm Şu An Tamamen Boş</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100">Bölümü ve Sakin Giriş Bilgilerini Kaydet</button>
                </div>
            </form>
        </div>
    </div>
}

<script>
    function openEditUnitModal(unitId, buildingId, doorNo, oName, oPhone, oEmail, tName, tPhone, tEmail, isEmpty, landShare, grossSqm, mult, fixedDues, exElev, exStair, cleanPct, ruleNote) {
        document.getElementById('euUnitId').value = unitId;
        document.getElementById('euBuildingId').value = buildingId;
        document.getElementById('euTitle').innerText = 'Kapı No: ' + doorNo + ' - Sakinler & Kurallar';
        document.getElementById('euOwnerName').value = oName || '';
        document.getElementById('euOwnerPhone').value = oPhone || '';
        document.getElementById('euOwnerEmail').value = oEmail || '';
        document.getElementById('euTenantName').value = tName || '';
        document.getElementById('euTenantPhone').value = tPhone || '';
        document.getElementById('euTenantEmail').value = tEmail || '';
        document.getElementById('euLandShare').value = landShare || '0';
        document.getElementById('euGrossSqm').value = grossSqm || '0';
        document.getElementById('euDuesMultiplier').value = mult || '1';
        document.getElementById('euFixedDues').value = (fixedDues && parseFloat(fixedDues) > 0) ? fixedDues : '';
        document.getElementById('euCleaningPct').value = cleanPct || '100';
        document.getElementById('euExemptElev').checked = !!exElev;
        document.getElementById('euExemptStair').checked = !!exStair;
        document.getElementById('euRuleNote').value = ruleNote || '';
        document.getElementById('euOwnerQuickPin').value = '';
        document.getElementById('euTenantQuickPin').value = '';
        document.getElementById('euIsEmpty').checked = !!isEmpty;
        const firstTabEl = document.getElementById('euTabResidentsBtn');
        if (firstTabEl) bootstrap.Tab.getOrCreateInstance(firstTabEl).show();
        new bootstrap.Modal(document.getElementById('editUnitContactsModal')).show();
    }

    function applyUnitRulePreset(mult, cleanPct, exElev, exStair, note) {
        document.getElementById('euDuesMultiplier').value = mult;
        document.getElementById('euCleaningPct').value = cleanPct;
        document.getElementById('euExemptElev').checked = !!exElev;
        document.getElementById('euExemptStair').checked = !!exStair;
        document.getElementById('euRuleNote').value = note || '';
    }

    function generatePinForInput(inputId) {
        const pin = Math.floor(1000 + Math.random() * 9000).toString();
        document.getElementById(inputId).value = pin;
    }

    function copyResidentInviteByRole(role) {
        const title = document.getElementById('euTitle').innerText;
        const isOwner = role === 'Owner';
        const roleLabel = isOwner ? 'Malik (Ev Sahibi)' : 'Kiracı (Sakin)';
        const phone = isOwner
            ? (document.getElementById('euOwnerPhone').value || '(Malik telefonu giriniz)')
            : (document.getElementById('euTenantPhone').value || '(Kiracı telefonu giriniz)');
        const pin = isOwner
            ? (document.getElementById('euOwnerQuickPin').value || '(Malik PIN)')
            : (document.getElementById('euTenantQuickPin').value || '(Kiracı PIN)');
        const loginUrl = window.location.origin + '/Account/Login';
        const text = `Merhaba, GMK360 Bina Portalı (${roleLabel}) üzerinden aidat, duyuru ve taleplerinizi takip edebilirsiniz.\nBölüm: ${title}\nGiriş Adresi: ${loginUrl}\nTelefon: ${phone}\nHızlı PWA PIN: ${pin}`;
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(() => alert(roleLabel + ' giriş daveti panoya kopyalandı:\n\n' + text));
        } else {
            prompt('Aşağıdaki mesajı kopyalayın:', text);
        }
    }
</script>
