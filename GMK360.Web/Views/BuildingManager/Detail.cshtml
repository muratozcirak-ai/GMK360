                            <option value="-99">Bahçe &amp; Çevre Alanı (Dış Mekan)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Birim Kategorisi <span class="text-danger">*</span></label>
                        <select name="category" id="floorUnitCatSelect" class="form-select">
                            <option value="OrtakAlan_Tesis" selected>Teknik / Tesis Birimi (Pompa, Hidrofor, Sığınak)</option>
                            <option value="OrtakAlan_Depo">Depolama Alanı / Ardiye / Kömürlük</option>
                            <option value="Daire">Mesken / Daire (veya Kapıcı Dairesi)</option>
                            <option value="Dukkan">Dükkan / Ticari Bölüm</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Alan (m²)</label>
                        <input type="number" step="0.5" min="0" name="squareMeters" class="form-control" placeholder="Örn: 28" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Birim Adı / Kapı No <span class="text-danger">*</span></label>
                        <input type="text" name="unitName" class="form-control fw-bold" list="techUnitSuggestions" required placeholder="Örn: Pompa Odası, Hidrofor Odası, Depolama Alanı..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kullanım Notu / Tip</label>
                        <input type="text" name="roomLayout" class="form-control" placeholder="Örn: Bodrum batı kanat tesisat odası" />
                    </div>
                    <div class="col-12 border-top pt-3 mt-2">
                        <div class="small fw-bold text-primary mb-2"><i class="bi bi-wrench-adjustable me-1"></i>Bu Birime İlk Demirbaş / Pompa / Ekipman Ekle (İsteğe Bağlı)</div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input type="text" name="firstFixtureName" class="form-control form-control-sm" list="techFixtureSuggestions" placeholder="Demirbaş: Örn. Hidrofor Pompası" />
                            </div>
                            <div class="col-md-3">
                                <input type="text" name="firstFixtureBrand" class="form-control form-control-sm" placeholder="Marka/Model (Örn: Wilo 2x2.2kW)" />
                            </div>
                            <div class="col-md-3">
                                <input type="text" name="technicalServiceName" class="form-control form-control-sm" placeholder="Bakım Servisi / Telefon" />
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="nextMaintenanceDate" class="form-control form-control-sm" title="Sonraki Bakım Tarihi" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4">
                        <i class="bi bi-check2-circle me-1"></i> Birimi Kata Aç
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 12. BİRİM İÇİNE DEMİRBAŞ / YANGIN / SARF ZİMMETLEME MODALI -->
