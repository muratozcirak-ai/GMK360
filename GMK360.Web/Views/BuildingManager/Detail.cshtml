                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateFloorFixture" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <input type="hidden" name="fixtureId" id="editFixtureId" value="0" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Sınıf / Takip Türü</label>
                        <select name="category" id="editFixtureCategory" class="form-select fw-semibold">
                            <option value="Demirbaş">⚙️ Demirbaş / Makine</option>
                            <option value="Yangın / Güvenlik">🧯 Yangın / Güvenlik</option>
                            <option value="Sarf / Tüketim">📦 Sarf / Tüketim</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-bold small">Ürün / Ekipman Adı <span class="text-danger">*</span></label>
                        <input type="text" name="itemName" id="editFixtureName" class="form-control fw-bold" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Marka</label>
                        <input type="text" name="brand" id="editFixtureBrand" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Model / Güç</label>
                        <input type="text" name="model" id="editFixtureModel" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Miktar</label>
                        <input type="number" step="0.5" min="0.5" name="quantity" id="editFixtureQty" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Birim</label>
                        <input type="text" name="unitMeasure" id="editFixtureUnit" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Yetkili Teknik Servis &amp; Tel</label>
                        <input type="text" name="serviceName" id="editFixtureService" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Tedarikçi Firma</label>
                        <input type="text" name="supplierName" id="editFixtureSupplier" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Garanti Bitiş Tarihi</label>
                        <input type="date" name="warrantyExpiryDate" id="editFixtureWarranty" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kontrol / Dolum / Bitiş Tarihi</label>
                        <input type="date" name="nextMaintenanceDate" id="editFixtureMaint" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Ek Evrak / Garanti / Rapor Yükle</label>
                        <input type="file" name="documentFile" class="form-control" accept=".pdf,image/*" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Konum / Seri No &amp; Bakım Notu</label>
                        <textarea name="notes" id="editFixtureNotes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-dark fw-bold rounded-pill px-4">
                        <i class="bi bi-save me-1"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 14. YENİ TEKNİK FİRMAYA DEVİR (TOPLU SERVİS GÜNCELLEME) MODALI -->
<div class="modal fade" id="bulkSwitchServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-arrow-repeat me-2"></i>Yeni Teknik Firmaya Devret</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="BulkSwitchTechnicalService" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <div class="alert alert-info small mb-0">
                            Yeni bir bakım firması ile anlaştığınızda tüm demirbaşların veya yalnızca seçtiğiniz grubun yetkili servis bilgisini tek tıkla güncelleyebilirsiniz.
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Hangi Ekipman Grubu Devredilsin?</label>
                        <select name="categoryFilter" class="form-select">
                            <option value="ALL">Tüm Demirbaş, Yangın &amp; Tesisat Kalemleri</option>
                            <option value="Demirbaş">Yalnızca Demirbaş &amp; Mekanik (Pompa, Hidrofor, Kazan)</option>
                            <option value="Yangın / Güvenlik">Yalnızca Yangın &amp; Güvenlik</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Yeni Teknik Firma Adı &amp; 7/24 Telefonu <span class="text-danger">*</span></label>
                        <input type="text" name="newServiceName" class="form-control fw-bold" required placeholder="Örn: Akdeniz Teknik Bakım A.Ş. - 0532 000 00 00" />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill w-100">
                        <i class="bi bi-check2-all me-1"></i> Yetkili Teknik Servisi Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 15. ÇOKLU KAT / ORTAK BİRİM ÜRETİCİ MODALI (İNŞAAT ERP MANTIĞI) -->
<div class="modal fade" id="bulkFloorUnitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-warning text-dark border-0 py-3">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-lightning-charge-fill me-2"></i>Çoklu Kat &amp; Ortak Birim Üretici</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="BulkPopulateFloorUnits" asp-controller="BuildingManager" method="post" onsubmit="return prepareBulkFloorSubmit()">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <input type="hidden" name="targetFloorsCsv" id="bulkTargetFloorsCsv" value="" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Birim / Mahal Türü</label>
                        <select name="category" class="form-select">
                            <option value="OrtakAlan_Tesis" selected>Teknik / Tesis Birimi (Pompa, Yangın İst., Sığınak)</option>
                            <option value="OrtakAlan_Depo">Depolama Alanı / Ardiye / Kömürlük</option>
                            <option value="Daire">Konut (Daire)</option>
                            <option value="Dukkan">Dükkan / Ticari</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Birim Adı <span class="text-danger">*</span></label>
                        <input type="text" name="unitName" class="form-control fw-bold" list="techUnitSuggestions" required placeholder="Örn: Kat Yangın İstasyonu, Kat Ardiyesi" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Alan (m²)</label>
                        <input type="number" step="0.5" min="0" name="squareMeters" class="form-control" placeholder="15" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small">Kat Başı Adet</label>
                        <input type="number" min="1" max="10" name="countPerFloor" class="form-control" value="1" />
                    </div>

                    <div class="col-12 border-top pt-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="fw-bold small text-dark">Hedef Katları Seçin:</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" style="font-size:0.75rem;" onclick="selectBulkFloors('ALL')">Tümünü Seç</button>
                                <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-2 py-0" style="font-size:0.75rem;" onclick="selectBulkFloors('NORMAL')">Normal Katlar</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" style="font-size:0.75rem;" onclick="selectBulkFloors('BASE')">Zemin &amp; Bodrum</button>
                                <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0" style="font-size:0.75rem;" onclick="selectBulkFloors('CLEAR')">Temizle</button>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border">
                            @foreach (var fl in distinctFloors)
                            {
                                var flLabel = fl == -99 ? "Bahçe & Çevre" : (fl == 99 ? "Çatı / Teras" : (fl == 0 ? "Zemin Kat" : (fl < 0 ? $"{Math.Abs(fl)}. Bodrum" : $"{fl}. Kat")));
                                var flType = fl > 0 && fl < 99 ? "NORMAL" : (fl <= 0 && fl != -99 ? "BASE" : "OTHER");
                                <label class="badge bg-white text-dark border px-3 py-2 fw-normal d-inline-flex align-items-center gap-2" style="cursor:pointer;">
                                    <input type="checkbox" class="form-check-input m-0 bulk-floor-chk" value="@fl" data-fltype="@flType" /> @flLabel
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">
                        <i class="bi bi-lightning-charge me-1"></i> Seçili Katlara Üret ve Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    var periodsByUnit = residencyPeriods
        .GroupBy(rp => rp.BuildingUnitId)
        .ToDictionary(g => g.Key, g => g.Select(x => new {
            role = x.RoleType == "Owner" ? "Malik" : "Kiracı",
            name = x.FullName,
            status = x.Status,
            start = x.StartDate.ToString("dd.MM.yyyy"),
            end = x.EndDate?.ToString("dd.MM.yyyy")
        }).ToList());
}

<script>
    const unitResidencyMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(periodsByUnit));
    let activeModalUnitId = 0;
    let activeModalDoorNo = '';

    function openUnitModal(id, doorNo, layout, owner, ownerPhone, tenant, tenantPhone, unpaidDebt, isEmpty) {
        activeModalUnitId = id;
        activeModalDoorNo = doorNo || ('Bölüm #' + id);

        document.getElementById('modalUnitTitle').innerHTML = '<i class="bi bi-door-closed me-2"></i> ' + doorNo + ' Detayı';
        document.getElementById('modalRoomLayout').innerText = layout || 'Standart';
        document.getElementById('modalOwnerName').innerText = owner || 'Belirtilmedi';
        document.getElementById('modalOwnerPhone').innerText = ownerPhone || '-';

        var debtEl = document.getElementById('modalDebtStatus');
        if (unpaidDebt > 0) {
            debtEl.innerText = Number(unpaidDebt).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺ Borçlu';
            debtEl.className = 'fw-bold text-danger mb-0';
        } else {
            debtEl.innerText = 'Borcu Yok';
            debtEl.className = 'fw-bold text-success mb-0';
        }

        var tenantBox = document.getElementById('modalTenantBox');
        if (isEmpty) {
            tenantBox.style.display = 'none';
        } else if (tenant && tenant !== '-' && tenant !== '') {
            tenantBox.style.display = 'block';
            document.getElementById('modalTenantName').innerText = tenant;
            document.getElementById('modalTenantPhone').innerText = tenantPhone || '-';
        } else {
            tenantBox.style.display = 'block';
            document.getElementById('modalTenantName').innerText = 'Ev Sahibi Kendisi Oturuyor';
            document.getElementById('modalTenantPhone').innerText = '-';
        }

        const histEl = document.getElementById('modalResidencyHistory');
        const list = unitResidencyMap[id] || unitResidencyMap[String(id)] || [];
        if (list.length === 0) {
            histEl.innerHTML = '<span>Bu bölüm için henüz devir/arşiv geçmişi oluşmadı; mevcut sakin aktif dönem sayılır.</span>';
        } else {
            histEl.innerHTML = list.map(p => {
                const badge = p.status === 'ACTIVE'
                    ? '<span class="badge bg-success me-1">AKTİF</span>'
                    : '<span class="badge bg-secondary me-1">ARŞİV</span>';
                const dates = p.end ? `${p.start} - ${p.end}` : `${p.start} - Günümüz`;
                return `<div class="mb-1">${badge}<strong>${p.role}:</strong> ${p.name} <span class="text-muted">(${dates})</span></div>`;
            }).join('');
        }

        var myModal = new bootstrap.Modal(document.getElementById('unitDetailModal'));
        myModal.show();
    }

    function openResidencyTransferFromUnit() {
        const detailEl = document.getElementById('unitDetailModal');
        const detailInst = bootstrap.Modal.getInstance(detailEl);
        if (detailInst) detailInst.hide();

        document.getElementById('transferUnitId').value = activeModalUnitId;
        document.getElementById('transferUnitTitle').innerText = activeModalDoorNo;
        updateProrationPreview();
        new bootstrap.Modal(document.getElementById('residencyTransferModal')).show();
    }

    function openReversalModal(expenseId, desc, amountText) {
        document.getElementById('reversalExpenseId').value = expenseId;
        document.getElementById('reversalExpenseSummary').innerText = `${desc} (${amountText} ₺)`;
        new bootstrap.Modal(document.getElementById('reversalModal')).show();
    }

    function updateProrationPreview() {
        const amt = parseFloat(document.getElementById('prorationAmountInput').value || '0');
        const dateVal = document.getElementById('transferDateInput').value;
        const out = document.getElementById('prorationPreviewText');
        if (!amt || amt <= 0 || !dateVal) {
            out.innerText = '';
            return;
        }
        const dt = new Date(dateVal + 'T00:00:00');
        const daysInMonth = new Date(dt.getFullYear(), dt.getMonth() + 1, 0).getDate();
        const leavingDays = dt.getDate();
        const enteringDays = Math.max(1, daysInMonth - leavingDays + 1);
        const leavingAmt = ((amt / daysInMonth) * leavingDays).toFixed(2);
        const enteringAmt = ((amt / daysInMonth) * enteringDays).toFixed(2);
        out.innerText = `Kıstelyevm (${daysInMonth} gün): Çıkan sakin ${leavingDays} gün (${leavingAmt} ₺) • Yeni sakin ${enteringDays} gün (${enteringAmt} ₺)`;
    }

    function openFloorUnitModal(floorLevel, floorLabel) {
        const sel = document.getElementById('floorUnitFloorSelect');
        if (sel) {
            const valStr = String(floorLevel);
            if (!Array.from(sel.options).some(o => o.value === valStr)) {
                const opt = document.createElement('option');
                opt.value = valStr;
                opt.text = floorLabel;
                sel.appendChild(opt);
            }
            sel.value = valStr;
        }
        const badge = document.getElementById('floorUnitModalBadge');
        if (badge) badge.innerText = floorLabel;
        new bootstrap.Modal(document.getElementById('addFloorUnitModal')).show();
    }

    function openFloorFixtureModal(unitId, unitTitle) {
        document.getElementById('fixtureTargetUnitId').value = unitId;
        document.getElementById('fixtureTargetUnitTitle').innerText = unitTitle;
        new bootstrap.Modal(document.getElementById('addFloorFixtureModal')).show();
    }

    function openEditFixtureModal(id, name, cat, brand, model, qty, unit, supplier, service, warranty, maint, notes) {
        document.getElementById('editFixtureId').value = id;
        document.getElementById('editFixtureName').value = name || '';
        const catSel = document.getElementById('editFixtureCategory');
        if (catSel) {
            const catLow = (cat || '').toLowerCase();
            catSel.value = catLow.indexOf('yang') >= 0 ? 'Yangın / Güvenlik' : (catLow.indexOf('sarf') >= 0 ? 'Sarf / Tüketim' : 'Demirbaş');
        }
        document.getElementById('editFixtureBrand').value = brand || '';
        document.getElementById('editFixtureModel').value = model || '';
        document.getElementById('editFixtureQty').value = qty || '1';
        document.getElementById('editFixtureUnit').value = unit || 'Adet';
        document.getElementById('editFixtureSupplier').value = supplier || '';
        document.getElementById('editFixtureService').value = service || '';
        document.getElementById('editFixtureWarranty').value = warranty || '';
        document.getElementById('editFixtureMaint').value = maint || '';
        document.getElementById('editFixtureNotes').value = notes || '';
        new bootstrap.Modal(document.getElementById('editFloorFixtureModal')).show();
    }

    let currentInvFilter = 'ALL';
    function filterInventory(catKey, btn) {
        currentInvFilter = catKey;
        document.querySelectorAll('#invFilterBtns button').forEach(b => b.classList.remove('active', 'btn-dark'));
        if (btn) btn.classList.add('active');
        applyInventoryFilters();
    }

    function applyInventoryFilters() {
        const q = (document.getElementById('invSearchInput')?.value || '').trim().toLowerCase();
        document.querySelectorAll('#treeInventoryTable .inv-row').forEach(row => {
            const cat = row.getAttribute('data-cat') || '';
            const isAlert = row.getAttribute('data-alert') === 'true';
            const blob = row.getAttribute('data-search') || '';
            const matchFilter = currentInvFilter === 'ALL'
                || (currentInvFilter === 'ALERT' && isAlert)
                || (currentInvFilter === cat);
            const matchSearch = !q || blob.indexOf(q) >= 0;
            row.style.display = (matchFilter && matchSearch) ? '' : 'none';
        });
    }

    function openOutdoorSpaceModal() {
        const fl = document.getElementById('commonModalFloor');
        const grp = document.getElementById('commonModalGroup');
        if (fl) fl.value = '-99';
        if (grp) grp.value = 'CevreDuzenleme';
        new bootstrap.Modal(document.getElementById('addCommonSpaceModal')).show();
    }

    function selectBulkFloors(mode) {
        document.querySelectorAll('.bulk-floor-chk').forEach(chk => {
            const t = chk.getAttribute('data-fltype') || '';
            if (mode === 'ALL') chk.checked = true;
            else if (mode === 'CLEAR') chk.checked = false;
            else if (mode === 'NORMAL') chk.checked = (t === 'NORMAL');
            else if (mode === 'BASE') chk.checked = (t === 'BASE');
        });
    }

    function prepareBulkFloorSubmit() {
        const vals = Array.from(document.querySelectorAll('.bulk-floor-chk:checked')).map(c => c.value);
        if (vals.length === 0) {
            alert('Lütfen en az bir hedef kat seçiniz.');
            return false;
        }
        document.getElementById('bulkTargetFloorsCsv').value = vals.join(',');
        return true;
    }

    async function previewDetailExpense() {
        const box = document.getElementById('detExpPreviewBox');
        const amount = parseFloat(document.getElementById('detExpAmount').value || '0');
        if (!amount || amount <= 0) {
            box.className = 'mt-2 alert alert-warning small mb-0';
            box.innerText = 'Önizleme için lütfen 0\'dan büyük bir tutar girin.';
            return;
        }
        box.className = 'mt-2 p-2 bg-white border rounded-3 small';
        box.innerHTML = '<div class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Hesaplanıyor...</div>';

        const fd = new FormData();
        const tokenEl = document.querySelector('#detailAddExpenseForm input[name="__RequestVerificationToken"]');
        if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);
        fd.append('buildingId', '@Model.Id');
        fd.append('totalAmount', amount.toString());
        fd.append('expenseType', document.getElementById('detExpType').value);
        fd.append('distributionRule', document.getElementById('detExpRule').value);
        fd.append('expenseItemKey', document.getElementById('detExpItemKey').value);
        fd.append('scopeType', document.getElementById('detExpScope').value);
        fd.append('shopParticipationPercent', document.getElementById('detExpShopPct').value || '100');
        const splitVal = document.getElementById('detExpOwnerSplit').value;
        if (splitVal !== '') fd.append('ownerSplitPercent', splitVal);

        const resp = await fetch('/BuildingManager/PreviewExpenseDistribution', { method: 'POST', body: fd });
        const res = await resp.json();
        if (!res.success) {
            box.className = 'mt-2 alert alert-danger small mb-0';
            box.innerText = res.message || 'Hesaplanamadı.';
            return;
        }
        let rows = (res.items || []).map(x => `
            <tr class="${x.isExempt ? 'table-secondary text-muted' : ''}">
                <td><strong>${x.doorNumber}</strong> <small class="text-muted">(${x.roomLayout})</small></td>
                <td><small>${x.statusNote}</small></td>
                <td class="text-end">${x.ownerAmount.toFixed(2)} ₺</td>
                <td class="text-end">${x.tenantAmount.toFixed(2)} ₺</td>
                <td class="text-end fw-bold">${x.totalShareAmount.toFixed(2)} ₺</td>
            </tr>`).join('');
        box.innerHTML = `
            <div class="d-flex justify-content-between mb-1 fw-bold text-primary">
                <span>${res.scopeLabel} • Kural: ${res.distributionRule}</span>
                <span>Katılımcı: ${res.participatingUnitCount} | Muaf: ${res.exemptUnitCount}</span>
            </div>
            <div style="max-height:210px; overflow-y:auto;">
                <table class="table table-sm table-bordered mb-0" style="font-size:0.78rem;">
                    <thead class="table-light"><tr><th>Bölüm</th><th>Kural / Muafiyet</th><th class="text-end">Malik</th><th class="text-end">Kiracı</th><th class="text-end">Toplam</th></tr></thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
    }
</script>
