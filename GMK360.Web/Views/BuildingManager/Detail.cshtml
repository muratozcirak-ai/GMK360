<!-- 2. YENİ GİDER / FATURA EKLE MODALI -->
<div class="modal fade" id="newExpenseModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-receipt me-2"></i> Gider / Fatura Girişi &amp; KMK Dağıtım Motoru</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="detailAddExpenseForm" asp-action="AddExpense" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold small">Fatura / Gider Açıklaması <span class="text-danger">*</span></label>
                        <input type="text" name="description" id="detExpDesc" class="form-control" required placeholder="Örn: Asansör Motor Revizyonu, Çöp &amp; Temizlik veya Kasım Elektriği" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Toplam Tutar (TL) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" name="totalAmount" id="detExpAmount" class="form-control fw-bold text-danger" required placeholder="Örn: 12500" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Masraf Kalemi (Muafiyet Anahtarı)</label>
                        <select name="expenseItemKey" id="detExpItemKey" class="form-select">
                            <option value="Genel">Genel Bina Gideri</option>
                            <option value="Personel">👷 Kapıcı / Güvenlik / Personel (KMK Eşit)</option>
                            <option value="Asansor">🛗 Asansör Bakım &amp; Elektrik (Muaf Birimler Hariç)</option>
                            <option value="Merdiven">💡 Merdiven Aydınlatma / Temizlik</option>
                            <option value="CopTemizlik">🧹 Çöp &amp; Çevre Temizliği (Birim % / Artışlı)</option>
                            <option value="Isinma">🔥 Merkezi Isınma / Yakıt / Ortak Su</option>
                            <option value="Demirbas">🏗️ Çatı / Dış Cephe / Ana Demirbaş</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Dağıtım Kuralı</label>
                        <select name="distributionRule" id="detExpRule" class="form-select fw-semibold">
                            <option value="Esit">⚖️ Eşit Bölüşüm (Aktif Bölüm Başı)</option>
                            <option value="ArsaPayi">📜 Arsa Payı Oranlı (Tapu Payı)</option>
                            <option value="Metrekare">📐 Brüt m² Oranlı (Yakıt / Bakım)</option>
                            <option value="Katsayi">✖️ Birim Katsayısı Bazlı (1+1 / Dubleks / Dükkan)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kapsam</label>
                        <select name="scopeType" id="detExpScope" class="form-select">
                            <option value="2">🏢 Sadece Bu Blok</option>
                            <option value="1">🏘️ Tüm Site (Ortak Gider)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Dükkan Katılımı (%)</label>
                        <input type="number" step="5" min="0" max="500" name="shopParticipationPercent" id="detExpShopPct" class="form-control" value="100" />
                        <small class="text-muted" style="font-size:0.7rem;">0=Muaf, 50=İndirim, 100=Normal, 150+=Artış</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kiracı / Malik Yönlendirme</label>
                        <select name="expenseType" id="detExpType" class="form-select fw-bold">
                            <option value="2">💡 İşletme (Kiracıya, yoksa Malike)</option>
                            <option value="1">🔨 Demirbaş (Kiracı Muaf → Malik %100)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Özel Malik Payı % (Opsiyonel Karma Bölüşüm)</label>
                        <input type="number" step="5" min="0" max="100" name="ownerSplitPercent" id="detExpOwnerSplit" class="form-control" placeholder="Boş=Standart | Örn: 50 (%50 Malik / %50 Kiracı)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Fatura / Belge (GMSİ Arşivi - PDF/Görsel)</label>
                        <input type="file" name="invoiceFile" class="form-control" accept=".pdf,image/*" />
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 border">
                            <small class="text-muted"><i class="bi bi-shield-check me-1 text-success"></i> Fiziksel silme kapalıdır; kuruş farkları otomatik dengelenir.</small>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3" onclick="previewDetailExpense()">
                                <i class="bi bi-calculator me-1"></i> Önizle (Kime Kaç ₺?)
                            </button>
                        </div>
                        <div id="detExpPreviewBox" class="mt-2 d-none"></div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-check-circle me-1"></i> Faturayı İşle ve Bölümlere Borçlandır
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. YENİ DAİRE / DÜKKAN EKLE MODALI -->
<div class="modal fade" id="addUnitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> Bağımsız Bölüm Tanımla</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddUnit" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small">Bölüm Türü</label>
                        <select name="category" class="form-select">
                            <option value="Daire">🏠 Konut (Daire)</option>
                            <option value="Dukkan">🏪 Zemin Dükkan / Mağaza</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small">Kat</label>
                        <input type="number" name="floorLevel" class="form-control" value="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kapı / Daire No <span class="text-danger">*</span></label>
                        <input type="text" name="unitNumber" class="form-control" required placeholder="Örn: 11 veya D3" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Ev Sahibi Adı</label>
                        <input type="text" name="ownerName" class="form-control" placeholder="Örn: Kemal Bey" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Ev Sahibi Telefonu</label>
                        <input type="text" name="ownerPhone" class="form-control" placeholder="0532 000 00 00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Ev Sahibi E-Posta</label>
                        <input type="email" name="ownerEmail" class="form-control" placeholder="malik@ornek.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kiracı Adı (Varsa)</label>
                        <input type="text" name="tenantName" class="form-control" placeholder="Örn: Selin Hanım" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kiracı Telefonu</label>
                        <input type="text" name="tenantPhone" class="form-control" placeholder="0542 000 00 00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Kiracı E-Posta</label>
                        <input type="email" name="tenantEmail" class="form-control" placeholder="kiraci@ornek.com" />
                    </div>
                    <div class="col-md-8 d-flex align-items-center">
                        <small class="text-muted"><i class="bi bi-shield-lock text-success me-1"></i> Kayıt sonrasında malik ve kiracıya özel <strong>profil aktivasyon linki</strong> oluşur; şifre ve kişisel PIN'i kendi profillerinden belirlerler.</small>
                    </div>
                    <div class="col-md-4 d-flex align-items-end pb-1">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isEmpty" value="true" id="emptySwitch">
                            <label class="form-check-label fw-bold small" for="emptySwitch">Daire Şu An Boş</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-save me-1"></i> Bağımsız Bölümü Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- 4. YENİ GENEL KURUL TOPLANTISI & KARAR EKLE MODALI -->
<div class="modal fade" id="newMeetingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-book-half me-2"></i> Yeni Genel Kurul Kararı Ekle (KMK Md. 32)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateMeeting" asp-controller="BuildingManager" method="post">
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Toplantı Gündemi / Başlığı <span class="text-danger">*</span></label>
                        <input type="text" name="agendaTitle" class="form-control" required placeholder="Örn: 2026/02 Çatı İzolasyonu ve İhale Kararı" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Toplantı Tarihi <span class="text-danger">*</span></label>
                        <input type="date" name="meetingDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Alınan Karar Metni <span class="text-danger">*</span></label>
                        <textarea name="decisionText" class="form-control" rows="4" required placeholder="Örn: Çatı su izolasyonu işi için en uygun teklifi veren Kardelen Çatı firmasına 36.000 TL bedelle ihale edilmesine, daire başına 3.000 TL toplanmasına karar verildi."></textarea>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info border-0 rounded-3 small mb-0">
                            <i class="bi bi-info-circle me-1"></i> Bu karar kaydedildiğinde tek tıkla <strong>Noter Karar Defteri A4 Islak İmza Şablonu</strong> üretilecektir.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-warning fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-save me-1"></i> Kararı Kaydet ve Hazirun Cetveli Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 5. ORTAK ALANA ZİMMETLİ DEMİRBAŞ EKLE MODALI -->
