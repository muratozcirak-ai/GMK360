@model GMK360.Core.Entities.Building
@{
    ViewData["Title"] = Model.Name + " - Yönetim Masası & Yapı Ekosistemi";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";

    var units = Model.Units?.OrderBy(u => u.FloorLevel).ThenBy(u => u.DoorNumber).ToList() ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var debts = units.SelectMany(u => u.Debts ?? new List<GMK360.Core.Entities.UnitDebt>()).ToList();
    var expenses = Model.Expenses?.OrderByDescending(e => e.Date).ToList() ?? new List<GMK360.Core.Entities.BuildingExpense>();

    var totalPaid = debts.Where(d => d.IsPaid).Sum(d => d.Amount);
    var totalUnpaid = debts.Where(d => !d.IsPaid).Sum(d => d.Amount);
    var totalDebts = totalPaid + totalUnpaid;
    decimal collectionRate = totalDebts > 0 ? (totalPaid / totalDebts) * 100 : 0;

    var occupiedCount = units.Count(u => !u.IsEmpty);
    var emptyCount = units.Count(u => u.IsEmpty);
    var shopCount = units.Count(u => u.Category == "Dukkan");
    var resCount = units.Count(u => u.Category != "Dukkan");

    // Kat Hiyerarşisi (En Üst Kattan Aşağıya)
    var distinctFloors = units.Where(u => u.Category != "Dukkan").Select(u => u.FloorLevel).Distinct().OrderByDescending(f => f).ToList();
    if (!distinctFloors.Any()) { distinctFloors = new List<int> { 5, 4, 3, 2, 1 }; }

    var meetings = ViewBag.Meetings as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
    var commonSpaces = ViewBag.CommonSpaces as List<GMK360.Core.Entities.UnitSpace> ?? new List<GMK360.Core.Entities.UnitSpace>();
}

<div class="container-fluid py-3 px-1">
    <!-- Üst Başlık & Aksiyonlar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/BuildingManager/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">
                    <i class="bi bi-arrow-left me-1"></i> Binalara Dön
                </a>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-shield-check me-1"></i> KMK 634 Sayılı Kanuna Uyumlu
                </span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-cash-stack me-1"></i> İkili Cari (Demirbaş & İşletme)
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-building text-primary me-2"></i> @Model.Name
                @if (!string.IsNullOrEmpty(Model.BlockName))
                {
                    <span class="text-secondary fw-normal fs-4">(@Model.BlockName)</span>
                }
            </h2>
            <p class="text-muted small mb-0 mt-1">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @(Model.StreetName ?? Model.Address), No: @(Model.BuildingNumber ?? "-") | @(Model.TotalFloors ?? 5) Katlı Yapı
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-danger fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
                <i class="bi bi-receipt me-1"></i> + Gider / Fatura İşle
            </button>
            <button class="btn btn-outline-success fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addUnitModal">
                <i class="bi bi-door-open me-1"></i> + Bağımsız Bölüm Ekle
            </button>
            <button class="btn btn-outline-dark fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addFixtureModal">
                <i class="bi bi-tools me-1"></i> + Tesis Demirbaşı Zimmetle
            </button>
            <button class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                <i class="bi bi-book me-1"></i> Noter Karar Defteri (Toplantı)
            </button>
        </div>
    </div>

    <!-- Başarı Bildirimi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-bold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                <div class="fw-bold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 BÜYÜK YÖNETİM METRİK KARTI -->
    <div class="row g-3 mb-4">
        <!-- 1. Toplanan Aidat & Kasa -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="text-muted small fw-bold text-uppercase">Toplanan Aidat / Fon</span>
                        <h4 class="fw-bold mb-0 text-success">@totalPaid.ToString("N0") ₺</h4>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <div class="progress flex-grow-1" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @collectionRate.ToString("0")%;"></div>
                            </div>
                            <small class="fw-bold text-muted" style="font-size:0.75rem;">%@collectionRate.ToString("0")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Geciken Alacak & Yasal Faiz -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-exclamation-triangle fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Bekleyen Alacak (Gecikmiş)</span>
                        <h4 class="fw-bold mb-0 text-danger">@totalUnpaid.ToString("N0") ₺</h4>
                        <small class="text-danger fw-semibold" style="font-size: 0.72rem;">
                            <i class="bi bi-clock-history me-1"></i>KMK Md.20/c: Aylık %5 Yasal Faiz
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Bağımsız Bölümler & Doluluk -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-door-open fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Bölümler & Doluluk</span>
                        <h4 class="fw-bold mb-0 text-primary">@units.Count <span class="fs-6 text-muted fw-normal">Bölüm</span></h4>
                        <small class="text-muted" style="font-size: 0.75rem;">
                            <span class="text-success fw-bold">@occupiedCount Dolu</span>, <span class="text-secondary">@emptyCount Boş</span> 
                            (@resCount Daire, @shopCount Dükkan)
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Toplam Giderler & Aktif İhaleler -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-25 text-dark rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-tools fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Toplam Gider / Bakım</span>
                        <h4 class="fw-bold mb-0 text-dark">@expenses.Sum(e => e.TotalAmount).ToString("N0") ₺</h4>
                        <small class="text-muted" style="font-size: 0.75rem;">@expenses.Count Kayıtlı Fatura</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- YÖNETİŞİM, TEKİL MERKEZ ID, KVKK YETKİ KİLİDİ VE PAKET ÇUBUĞU -->
    @{
        var pricingTier = ViewBag.PricingTier as GMK360.Web.Helpers.FacilityPricingResult;
        bool hasAuthDoc = ViewBag.HasDecisionAuthority is bool bAuth && bAuth;
        var govMembers = ViewBag.GovernanceMembers as List<GMK360.Core.Entities.BuildingManager> ?? new List<GMK360.Core.Entities.BuildingManager>();
        int rootBuildingId = ViewBag.RootBuildingId is int rId ? rId : Model.Id;
    }
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-dark text-white rounded-pill px-3 py-2">
                    <i class="bi bi-fingerprint me-1 text-warning"></i> Tekil Merkez ID: #@rootBuildingId
                </span>
                @if (pricingTier != null)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                        <i class="bi bi-tag-fill me-1"></i> @pricingTier.TierName: @pricingTier.AnnualPrice.ToString("N0") ₺/yıl (14 Gün Deneme)
                    </span>
                }
                @if (hasAuthDoc)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                        <i class="bi bi-patch-check-fill me-1"></i> Karar Defteri Yetkisi Onaylı
                    </span>
                }
                else
                {
                    <a href="/BuildingManager/Onboarding/@rootBuildingId" class="badge bg-warning-subtle text-warning-emphasis border border-warning rounded-pill px-3 py-2 text-decoration-none" title="KVKK gereği sakin telefonu eklemek için belge yükleyin">
                        <i class="bi bi-shield-exclamation me-1"></i> Taslak Modu: Karar Yetki Yazısı Yükle &rarr;
                    </a>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @foreach (var gm in govMembers)
                {
                    var roleLabel = gm.Role == GMK360.Core.Entities.BuildingManagerRole.HeadManager ? "Yönetici" : (gm.Role == GMK360.Core.Entities.BuildingManagerRole.BoardMember ? "Aza" : "Denetçi");
                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                        <i class="bi bi-person-badge me-1 text-success"></i>@roleLabel: @(gm.User != null ? $"{gm.User.FirstName} {gm.User.LastName}" : gm.UserId)
                    </span>
                }
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#governanceModal">
                    <i class="bi bi-people-fill me-1"></i> Kurul / Aza &amp; Devir
                </button>
                <a href="/BuildingManager/Onboarding/@rootBuildingId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-magic me-1"></i> Yapı Sihirbazı
                </a>
            </div>
        </div>
    </div>

    <!-- 2 ANA OMURGA SEKMESİ (TABS) -->
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm border" id="mainPillTab" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link active rounded-pill py-3 fw-bold fs-6 w-100" id="tab-structure-pill" data-bs-toggle="pill" data-bs-target="#tab-structure" type="button" role="tab">
                <i class="bi bi-building-fill-up me-2 text-primary"></i> 1. YAPI, KATLAR & TESİS EKOSİSTEMİ (Fiziksel Canlı Kesit)
            </button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link rounded-pill py-3 fw-bold fs-6 w-100" id="tab-summary-pill" data-bs-toggle="pill" data-bs-target="#tab-summary" type="button" role="tab">
                <i class="bi bi-pie-chart-fill me-2 text-success"></i> 2. YÖNETİM & FİNANS ÖZETİ (Kararlar, Aidat & Faturalar)
            </button>
        </li>
    </ul>

    <!-- SEKME İÇERİKLERİ -->
    <div class="tab-content" id="mainPillTabContent">

        <!-- ========================================================================= -->
        <!-- SEKME 1: YAPI, KATLAR & TESİS EKOSİSTEMİ (FİZİKSEL HİYERARŞİ) -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade show active" id="tab-structure" role="tabpanel">
            
            <!-- Bilgilendirme Çubuğu -->
            <div class="alert alert-info border-0 rounded-4 shadow-sm d-flex align-items-center mb-4">
                <i class="bi bi-compass fs-3 text-info me-3"></i>
                <div class="small">
                    <strong>Fiziksel Yapı & Gezinti Sırası:</strong> Çatı Terasından başlar, normal katları ve bağımsız bölümleri içerir, zemin cadde dükkanlarına iner ve bodrumdaki sığınak/jeneratör tesislerine ulaşır.
                    <span class="badge bg-dark ms-2">🔒 Mahremiyet Kuralı:</span> Daire içi kombi/klima ve demirbaş zimmetleri sadece mülk sahibinin özel alanıdır.
                </div>
            </div>

            <!-- 1. A) ÇATI KATI & TERAS (EN ÜST) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-top border-4 border-warning">
                <div class="card-header bg-warning bg-opacity-10 border-0 p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold me-2">
                            <i class="bi bi-triangle-half me-1"></i> EN ÜST NOKTA
                        </span>
                        <h5 class="fw-bold text-dark mb-0">🏠 Çatı Katı, Teras & Asansör Kulesi</h5>
                    </div>
                    <span class="badge bg-light text-dark border">Ortak Alan / Demirbaş Kapsamında</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-arrow-up-circle-fill text-primary me-1"></i> Asansör Makine Dairesi</h6>
                                    <span class="badge bg-success">Yeşil Etiketli</span>
                                </div>
                                <p class="small text-muted mb-2">Kone 630 Kg Halatlı Çift Hızlı Asansör Motoru</p>
                                <div class="small">
                                    <span class="text-muted">Yetkili Servis:</span> <b>Kone Yetkili Servis (0216 444 0 566)</b><br/>
                                    <span class="text-muted">Son Muayene:</span> <b class="text-success">Eylül 2026 (Geçerli)</b>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-shield-shaded text-danger me-1"></i> Çatı Su İzolasyonu</h6>
                                    <span class="badge bg-primary">Yenilendi</span>
                                </div>
                                <p class="small text-muted mb-2">Çift Kat Kiremit Altı Mebran İzolasyon & Yağmur Olukları</p>
                                <div class="small">
                                    <span class="text-muted">Onarım Tarihi:</span> <b>Ekim 2026</b><br/>
                                    <span class="text-muted">Maliyet / Fatura:</span> <b class="text-danger">36.000 TL (Malik Demirbaşı)</b>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-broadcast-pin text-info me-1"></i> Merkezi Anten & Güneş Paneli</h6>
                                    <span class="badge bg-secondary">Aktif</span>
                                </div>
                                <p class="small text-muted mb-2">Ortak Uydu Santrali (Türksat / Hotbird) & Paratoner Sistemi</p>
                                <div class="small">
                                    <span class="text-muted">Paratoner Topraklama:</span> <b class="text-success">Ölçüm Yapıldı (Uygun)</b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 1. B) NORMAL KATLAR & BAĞIMSIZ BÖLÜMLER (DİKEY KESİT) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-layers-half text-primary me-2"></i> Konut Katları & Daire Dağılım Matrisi</h5>
                        <small class="text-muted">Daireye tıklayarak ev sahibi, kiracı, arsa payı ve aidat borç durumunu görebilirsiniz.</small>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-bold">
                        @resCount Daire Mevcut
                    </span>
                </div>
                <div class="card-body p-4 bg-light bg-opacity-50">
                    
                    @foreach (var floor in distinctFloors)
                    {
                        var floorUnits = units.Where(u => u.FloorLevel == floor && u.Category != "Dukkan").ToList();
                        
                        <div class="row align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                            <!-- Sol: Kat Etiketi -->
                            <div class="col-md-2 col-sm-3 mb-2 mb-sm-0">
                                <div class="bg-white border rounded-4 p-2 text-center shadow-sm">
                                    <span class="fw-bold text-dark fs-5 d-block">@(floor). KAT</span>
                                    <small class="text-muted" style="font-size:0.75rem;">@floorUnits.Count Daire</small>
                                </div>
                            </div>

                            <!-- Sağ: Daire Kutucukları Grid'i -->
                            <div class="col-md-10 col-sm-9">
                                <div class="row g-2">
                                    @if (!floorUnits.Any())
                                    {
                                        <div class="col-12">
                                            <div class="p-2 border rounded-3 text-center bg-white small text-muted fst-italic">
                                                Bu katta henüz tanımlı daire yok.
                                            </div>
                                        </div>
                                    }
                                    @foreach (var unit in floorUnits)
                                    {
                                        var unitDebts = unit.Debts?.ToList() ?? new List<GMK360.Core.Entities.UnitDebt>();
                                        var unitUnpaid = unitDebts.Where(d => !d.IsPaid).Sum(d => d.Amount);
                                        var isOwnerLiving = string.IsNullOrEmpty(unit.TenantName) && !unit.IsEmpty;

                                        <div class="col-lg-6 col-md-12">
                                            <div class="card border rounded-4 p-3 bg-white shadow-sm hover-shadow transition-all cursor-pointer" onclick="openUnitModal(@unit.Id, '@unit.DoorNumber', '@unit.RoomLayout', '@(unit.OwnerName ?? "-")', '@(unit.OwnerPhone ?? "-")', '@(unit.TenantName ?? "-")', '@(unit.TenantPhone ?? "-")', @unitUnpaid, @(unit.IsEmpty ? "true" : "false"))">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <span class="badge bg-dark rounded-pill px-2 py-1 mb-1 font-monospace">@unit.DoorNumber</span>
                                                        <span class="badge bg-light text-dark border ms-1">@(unit.RoomLayout ?? "3+1")</span>
                                                    </div>
                                                    <div>
                                                        @if (unit.IsEmpty)
                                                        {
                                                            <span class="badge bg-secondary rounded-pill">⚪ Boş Daire</span>
                                                        }
                                                        else if (!string.IsNullOrEmpty(unit.TenantName))
                                                        {
                                                            <span class="badge bg-info text-dark rounded-pill">🟢 Kiracıda</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-primary rounded-pill">🔵 Ev Sahibi</span>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="small mb-2">
                                                    <div class="d-flex justify-content-between">
                                                        <span class="text-muted"><i class="bi bi-person-fill text-secondary me-1"></i> Ev Sahibi:</span>
                                                        <span class="fw-bold text-dark text-truncate" style="max-width: 180px;">@(unit.OwnerName ?? "Belirtilmedi")</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(unit.TenantName))
                                                    {
                                                        <div class="d-flex justify-content-between mt-1">
                                                            <span class="text-muted"><i class="bi bi-person-check text-info me-1"></i> Kiracı:</span>
                                                            <span class="fw-bold text-info text-truncate" style="max-width: 180px;">@unit.TenantName</span>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                                                    <span class="text-muted" style="font-size:0.75rem;">
                                                        <i class="bi bi-arrows-fullscreen me-1"></i>@(unit.GrossSquareMeters ?? 110) m²
                                                    </span>
                                                    @if (unitUnpaid > 0)
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold">
                                                            <i class="bi bi-exclamation-circle me-1"></i>@unitUnpaid.ToString("N0") ₺ Borçlu
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold">
                                                            <i class="bi bi-check2 me-1"></i>Borcu Yok
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 1. C) ZEMİN KAT CADDE DÜKKANLARI (TİCARİ BÖLÜMLER) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white border-top border-4 border-success">
                <div class="card-header bg-success bg-opacity-10 border-0 p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold me-2">
                            <i class="bi bi-shop me-1"></i> CADDE GİRİŞİ
                        </span>
                        <h5 class="fw-bold text-dark mb-0">🏪 Zemin Kat Cadde Dükkanları & Mağazalar</h5>
                    </div>
                    <span class="badge bg-dark">Asansör Muafiyet Matrisi Aktif</span>
                </div>
                <div class="card-body p-4">
                    @{
                        var shops = units.Where(u => u.Category == "Dukkan").ToList();
                    }
                    @if (!shops.Any())
                    {
                        <div class="text-center py-3 text-muted fst-italic">
                            Binada henüz zemin dükkan tanımlanmamış. Yukarıdaki "+ Bağımsız Bölüm Ekle" butonundan dükkan ekleyebilirsiniz.
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var shop in shops)
                            {
                                var sDebts = shop.Debts?.ToList() ?? new List<GMK360.Core.Entities.UnitDebt>();
                                var sUnpaid = sDebts.Where(d => !d.IsPaid).Sum(d => d.Amount);

                                <div class="col-md-6">
                                    <div class="p-3 border rounded-4 bg-light h-100 shadow-sm">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-success fs-6 font-monospace">@shop.DoorNumber</span>
                                            <span class="badge bg-dark">@shop.RoomLayout</span>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">@(shop.TenantName ?? shop.OwnerName)</h5>
                                        <p class="text-muted small mb-2"><i class="bi bi-person me-1"></i> Malik: <b>@shop.OwnerName</b> (@shop.OwnerPhone)</p>
                                        
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success small">
                                                <i class="bi bi-check-circle me-1"></i> Asansör Elektriğinden Muaf
                                            </span>
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary small">
                                                <i class="bi bi-building me-1"></i> Çatı/Demirbaşa Dahil
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                            <span class="small text-muted">Brüt Alan: <b>@(shop.GrossSquareMeters ?? 150) m²</b></span>
                                            @if (sUnpaid > 0)
                                            {
                                                <span class="badge bg-danger fs-6">@sUnpaid.ToString("N0") ₺ Borç</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success fs-6">Borcu Yok</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 1. D) BODRUM KATI & YERALTI TESİSLERİ (EN ALT) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white border-top border-4 border-dark">
                <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-bold me-2">
                            <i class="bi bi-arrow-down-circle me-1"></i> YERALTI TESİSLERİ
                        </span>
                        <h5 class="fw-bold text-white mb-0">🚨 Bodrum Kat, Sığınak, Jeneratör & Tesis Odaları</h5>
                    </div>
                    <span class="badge bg-secondary">Zimmet & Muayene Takip Sistemi</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Sığınak -->
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-shield-fill-check text-danger me-1"></i> Sığınak & Depo</h6>
                                    <span class="badge bg-success">Zorunlu Alan</span>
                                </div>
                                <p class="small text-muted mb-2">Kapasite: 50 Kişi | Acil Çıkış Kapısı Mevcut</p>
                                <div class="small">
                                    <span class="text-muted">Acil Su Deposu:</span> <b>5 Ton (Dolu)</b><br/>
                                    <span class="text-muted">Havalandırma:</span> <b class="text-success">Filtreleri Temiz</b>
                                </div>
                            </div>
                        </div>

                        <!-- Jeneratör -->
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Jeneratör Odası</h6>
                                    <span class="badge bg-warning text-dark">Aksa 110 kVA</span>
                                </div>
                                <p class="small text-muted mb-2">Otomatik Transfer Panolu Dizel Jeneratör</p>
                                <div class="small">
                                    <span class="text-muted">Yetkili Servis:</span> <b>Aksa Kadıköy (0216 555 12 12)</b><br/>
                                    <span class="text-muted">Mazot Seviyesi:</span> <b class="text-success">%85 (140 Lt)</b>
                                </div>
                            </div>
                        </div>

                        <!-- Kazan Dairesi & Hidrofor -->
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-droplet-half text-info me-1"></i> Hidrofor & Kazan</h6>
                                    <span class="badge bg-info text-dark">Alarko Çift Pompa</span>
                                </div>
                                <p class="small text-muted mb-2">Şebeke Basınç Dengeleyici & Su Arıtma</p>
                                <div class="small">
                                    <span class="text-muted">Filtre Değişimi:</span> <b>Temmuz 2026</b><br/>
                                    <span class="text-muted">Genleşme Tankı:</span> <b class="text-success">Basınç Normal (4.5 Bar)</b>
                                </div>
                            </div>
                        </div>

                        <!-- Yangın Güvenlik İstasyonu -->
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-fire text-danger me-1"></i> Yangın İstasyonu</h6>
                                    <span class="badge bg-danger">6 Adet Tüp</span>
                                </div>
                                <p class="small text-muted mb-2">Her Kat Sahanlığı + Sığınak 6 Kg KKT Tüp</p>
                                <div class="small">
                                    <span class="text-muted">Son Dolum:</span> <b>Mayıs 2026</b><br/>
                                    <span class="text-muted">Vade:</span> <b class="text-danger">Mayıs 2027 (Muayene Şart)</b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 1. E) SİTE AÇIK ALAN & SOSYAL TESİSLER (PARK, KAMELYA, OTOPARK) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-tree text-success me-2"></i> Site Açık Alan & Sosyal Donatı Yönetimi</h5>
                        <small class="text-muted">Çocuk parkı, çardaklar, açık/kapalı otopark ve bahçe ekipmanlarının zimmet dökümü</small>
                    </div>
                    <span class="badge bg-light text-dark border">Site İçi Tesisler</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-emoji-smile text-warning me-1"></i> Çocuk Oyun Parkı</h6>
                                <p class="small text-muted mb-2">Salıncak Takımı, Kaydırak & Kauçuk Zemin Kaplama</p>
                                <div class="small text-muted">
                                    <span>Güvenlik Kontrolü:</span> <b class="text-success">Tamamlandı (Ekim 2026)</b><br/>
                                    <span>Durum:</span> <b>Kusursuz / Aktif</b>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-umbrella text-success me-1"></i> Bahçe Kamelyaları & Çardak</h6>
                                <p class="small text-muted mb-2">2 Adet Ahşap Kamelya & Oturma Grupları</p>
                                <div class="small text-muted">
                                    <span>Bakım / Vernik:</span> <b>Ağustos 2026</b><br/>
                                    <span>Aydınlatma:</span> <b class="text-success">LED Solar Lambalı</b>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-tools text-primary me-1"></i> Bahçıvan & Bakım Ekipmanları</h6>
                                <p class="small text-muted mb-2">Honda Çim Biçme, 50m Bahçe Hortumu, Kar Küreği</p>
                                <div class="small text-muted">
                                    <span>Zimmetli Personel:</span> <b class="text-dark">Apartman Görevlisi Ali Usta</b><br/>
                                    <span>Teslim Tarihi:</span> <b class="text-primary">İmzalı Tutanak Mevcut</b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- SEKME 2: YÖNETİM & FİNANS ÖZETİ (GİDERLER, KARARLAR, TALEPLER) -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade" id="tab-summary" role="tabpanel">
            
            <div class="row g-4">
                <!-- Sol Kolon: Karar Defteri & Fatura Listesi -->
                <div class="col-lg-8">
                    
                    <!-- NOTER KARAR DEFTERİ BLOK -->
                    <div class="card border-warning border-opacity-50 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-warning bg-opacity-10 border-0 p-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold me-2">
                                    <i class="bi bi-book-half me-1"></i> NOTER KARAR DEFTERİ
                                </span>
                                <h5 class="fw-bold text-dark mb-0">Genel Kurul Kararları (KMK Md. 32)</h5>
                            </div>
                            <button class="btn btn-sm btn-outline-dark fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                                <i class="bi bi-plus-circle me-1"></i> + Yeni Karar Ekle
                            </button>
                        </div>
                        <div class="card-body p-4">
                            @if (!meetings.Any())
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-journal-bookmark text-muted fs-1 mb-2 d-block"></i>
                                    <h6 class="fw-bold text-dark">Henüz Kayıtlı Genel Kurul Kararı Yok</h6>
                                    <p class="text-muted small">Noter tasdikli deftere işlenecek kararları yukarıdaki butondan ekleyebilirsiniz.</p>
                                    <button class="btn btn-warning fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                                        <i class="bi bi-plus-lg me-1"></i> İlk Kararı Oluştur
                                    </button>
                                </div>
                            }
                            else
                            {
                                foreach (var m in meetings)
                                {
                                    <div class="border rounded-4 p-3 bg-light mb-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge bg-dark rounded-pill px-2 py-1 mb-1 font-monospace">Toplantı #@m.Id</span>
                                                <h5 class="fw-bold text-dark mb-0">@m.AgendaTitle</h5>
                                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> @m.MeetingDate.ToString("dd MMMM yyyy - dddd")</small>
                                            </div>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold">Oy Çokluğuyla Kabul</span>
                                        </div>

                                        @if (m.Decisions != null && m.Decisions.Any())
                                        {
                                            <div class="bg-white p-3 rounded-3 border mb-3 small">
                                                @foreach (var dec in m.Decisions)
                                                {
                                                    <div class="mb-2 text-dark">
                                                        <i class="bi bi-check2-circle text-success me-1"></i> <strong>@dec.DecisionText</strong>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id" target="_blank" class="btn btn-outline-dark btn-sm fw-bold rounded-pill px-3 shadow-sm">
                                                <i class="bi bi-printer me-1"></i> Noter Defteri Baskı Şablonunu İndir / Yazdır (A4)
                                            </a>
                                            <button class="btn btn-success btn-sm fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadScanModal" onclick="document.getElementById('scanMeetingId').value = '@m.Id'">
                                                <i class="bi bi-camera me-1"></i> İmzalı Sayfayı Arşivle
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- FATURALAR VE GİDER TABLOSU -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt text-danger me-2"></i> Son Giderler & Faturalar</h5>
                            <span class="badge bg-light text-dark border">Demirbaş vs İşletme</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th class="ps-3">Tarih</th>
                                            <th>Açıklama / Fatura</th>
                                            <th>Gider Türü</th>
                                            <th>Tutar</th>
                                            <th class="pe-3 text-end">Kapsam</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!expenses.Any())
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted fst-italic">Henüz kayıtlı fatura bulunmuyor.</td>
                                            </tr>
                                        }
                                        @foreach (var exp in expenses)
                                        {
                                            <tr>
                                                <td class="ps-3 small">@exp.Date.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="fw-bold text-dark">@exp.Description</span>
                                                </td>
                                                <td>
                                                    @if (exp.PayerType == "Owner")
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">🔨 Demirbaş (Ev Sahibi)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">💡 İşletme (Kiracı/Sakin)</span>
                                                    }
                                                </td>
                                                <td class="fw-bold text-dark">@exp.TotalAmount.ToString("N2") ₺</td>
                                                <td class="pe-3 text-end">
                                                    <span class="badge bg-light text-dark border">Bina Geneli</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Sağ Kolon: Kasa, GMSİ Vergi Özeti & Sakin Talepleri -->
                <div class="col-lg-4">
                    
                    <!-- GMSİ KİRA GELİR VERGİSİ KARTI -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-file-earmark-spreadsheet-fill text-warning fs-2 me-3"></i>
                                <div>
                                    <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 mb-1">GVK Madde 74</span>
                                    <h5 class="fw-bold text-white mb-0">GMSİ Vergi Kalkanı</h5>
                                </div>
                            </div>
                            <p class="text-white-50 small mb-3">
                                Bu binadaki ev sahiplerinin çatı, asansör ve demirbaş payları Gelir İdaresi Başkanlığı (GİB) gerçek gider formatında arşivlenmektedir.
                            </p>
                            <a href="/BuildingManager/PrintGmsiTaxReport?buildingId=@Model.Id" target="_blank" class="btn btn-warning text-dark fw-bold rounded-pill w-100 shadow-sm">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> 2026 Maliye Vergi Dosyasını Hazırla (PDF)
                            </a>
                        </div>
                    </div>

                    <!-- KASA & BANKA HESABI -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3">
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bank text-success me-2"></i> Site Banka Hesabı</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="p-3 bg-light rounded-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark">Vakıfbank - Kadıköy Şb.</span>
                                    <span class="badge bg-success fs-6">14.500,00 ₺</span>
                                </div>
                                <small class="text-muted font-monospace d-block">TR44 0001 5001 5800 7301 2289 01</small>
                            </div>
                            <small class="text-muted d-block" style="font-size:0.75rem;">
                                Aidat ödemeleri doğrudan bu IBAN'a yönlendirilir ve SMS makbuzu kesilir.
                            </small>
                        </div>
                    </div>

                    <!-- SAKİN ARcalendarIZA & ŞİKAYET TALEPLERİ -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-headset text-info me-2"></i> Sakin Talepleri & Arızalar</h6>
                            <span class="badge bg-danger rounded-pill">2 Bekleyen</span>
                        </div>
                        <div class="card-body p-3">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0 py-2 border-bottom">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold text-dark small">Daire 4 (Burak Koç):</span>
                                        <small class="text-muted">Bugün</small>
                                    </div>
                                    <small class="text-muted d-block">"3. Kat asansör dış kapı mekanizması takılıyor."</small>
                                    <span class="badge bg-warning text-dark mt-1" style="font-size:0.65rem;">İnceleniyor</span>
                                </li>
                                <li class="list-group-item px-0 py-2">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold text-dark small">Daire 7 (Zeynep Çelik):</span>
                                        <small class="text-muted">Dün</small>
                                    </div>
                                    <small class="text-muted d-block">"Bahçe otopark girişi sensörü bazen açmıyor."</small>
                                    <span class="badge bg-info text-dark mt-1" style="font-size:0.65rem;">Teknik Servise İletildi</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

<!-- ========================================================================= -->
<!-- MODALLER: DAİRE DETAY, GİDER EKLE, DAİRE EKLE -->
<!-- ========================================================================= -->

<!-- 1. DAİRE DETAY MODALI (POPUP) -->
<div class="modal fade" id="unitDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold" id="modalUnitTitle"><i class="bi bi-door-closed me-2"></i> Daire Detayı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Temel Bilgiler -->
                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3">
                    <div>
                        <span class="text-muted small d-block">Oda Planı</span>
                        <h5 class="fw-bold text-dark mb-0" id="modalRoomLayout">3+1</h5>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Aidat / Borç Durumu</span>
                        <h5 class="fw-bold" id="modalDebtStatus">0,00 ₺</h5>
                    </div>
                </div>

                <!-- Ev Sahibi -->
                <div class="mb-3 p-3 border rounded-3">
                    <span class="badge bg-secondary mb-1">MÜLK SAHİBİ (MALİK)</span>
                    <h6 class="fw-bold text-dark mb-1" id="modalOwnerName">-</h6>
                    <small class="text-muted"><i class="bi bi-telephone me-1"></i><span id="modalOwnerPhone">-</span></small>
                </div>

                <!-- Kiracı -->
                <div class="mb-3 p-3 border rounded-3" id="modalTenantBox">
                    <span class="badge bg-info text-dark mb-1">KİRACI (SAKİN)</span>
                    <h6 class="fw-bold text-dark mb-1" id="modalTenantName">-</h6>
                    <small class="text-muted"><i class="bi bi-telephone me-1"></i><span id="modalTenantPhone">-</span></small>
                </div>

                <!-- Daire İçi Özel Demirbaş Mahremiyet Uyarısı -->
                <div class="p-3 bg-warning bg-opacity-10 border border-warning rounded-3 small">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-lock-fill text-warning me-1"></i> Daire İçi Demirbaş Zimmeti (Kombi, Klima vb.):</div>
                    <span class="text-muted">
                        Daire içindeki kombi, ankastre ve sayaç zimmetleri <strong>Mülk Sahibi Özel Alanı</strong>'ndadır. 
