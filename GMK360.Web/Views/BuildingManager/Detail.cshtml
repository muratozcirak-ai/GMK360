                    <div>
                        <span class="text-muted small d-block">Oda Planı</span>
                        <h5 class="fw-bold text-dark mb-0" id="modalRoomLayout">3+1</h5>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Aidat / Borç Durumu</span>
