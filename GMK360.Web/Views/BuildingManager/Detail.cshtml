                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Marka / Model</label>
                        <input type="text" name="brand" class="form-control" placeholder="Örn: Honda HRG 466 veya Aksa 110kVA" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Adet / Miktar</label>
                        <div class="input-group">
                            <input type="number" step="1" name="quantity" class="form-control" value="1" />
                            <input type="text" name="unit" class="form-control" value="Adet" style="max-width: 80px;" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Satın Alınan Firma / Tedarikçi</label>
                        <input type="text" name="supplierName" class="form-control" placeholder="Örn: Aksa Jeneratör A.Ş." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Yetkili Teknik Servis & Telefonu</label>
                        <input type="text" name="serviceName" class="form-control" placeholder="Örn: Alarko Kadıköy Servis (0216 414 00 20)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Gelecek Periyodik Bakım / Muayene Tarihi</label>
                        <input type="date" name="nextMaintenanceDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Zimmetli Personel & Notlar</label>
                        <input type="text" name="notes" class="form-control" placeholder="Örn: Apartman Görevlisi Ali Usta'ya zimmetli." />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-dark fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-save me-1"></i> Demirbaşı Zimmetle ve Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 6. İMZALI SAYFA ARŞİVLE MODALI -->
