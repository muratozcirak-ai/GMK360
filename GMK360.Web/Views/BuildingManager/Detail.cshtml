@model GMK360.Core.Entities.Building
@{
    ViewData["Title"] = Model.Name + " - Yönetim Masası & Yapı Ekosistemi";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";

    bool isSiteSecondaryBlock = ViewBag.IsSiteSecondaryBlock is bool sb && sb;
    int? sitePrimaryId = ViewBag.SitePrimaryBuildingId as int?;
    string sitePrimaryName = ViewBag.SitePrimaryBuildingName as string ?? "Site Ana Yönetimi";

    bool IsWholeBuildingAbstractOnGround(GMK360.Core.Entities.BuildingUnit u) =>
        u.FloorLevel == 0 && (
            (u.DoorNumber ?? "").StartsWith("Çatı", StringComparison.OrdinalIgnoreCase)
            || string.Equals(u.DoorNumber, "Merdiven & Sahanlık", StringComparison.OrdinalIgnoreCase)
            || string.Equals(u.DoorNumber, "Asansör & Makine Dairesi", StringComparison.OrdinalIgnoreCase));

    var allPhysicalUnits = Model.Units?
        .Where(u => u.Category != "OrtakAlan_Blok"
                 && u.DoorNumber != "ORTAK"
                 && u.DoorNumber != "Ortak Tesisler"
                 && !IsWholeBuildingAbstractOnGround(u)
                 && (!isSiteSecondaryBlock || u.FloorLevel != -99))
        .OrderBy(u => u.FloorLevel).ThenBy(u => u.DoorNumber)
        .ToList() ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var units = allPhysicalUnits
        .Where(u => !(u.Category ?? "").StartsWith("OrtakAlan"))
        .ToList();
    var debts = units.SelectMany(u => u.Debts ?? new List<GMK360.Core.Entities.UnitDebt>()).ToList();
    var expenses = Model.Expenses?.OrderByDescending(e => e.Date).ToList() ?? new List<GMK360.Core.Entities.BuildingExpense>();
    var activeExpenses = expenses.Where(e => !e.IsArchived && e.ReversalOfExpenseId == null).ToList();

    var totalPaid = debts.Where(d => d.IsPaid).Sum(d => d.Amount);
    var totalUnpaid = Math.Max(0m, debts.Where(d => !d.IsPaid).Sum(d => d.Amount));
    var totalDebts = totalPaid + totalUnpaid;
    decimal collectionRate = totalDebts > 0 ? (totalPaid / totalDebts) * 100 : 0;

    var occupiedCount = units.Count(u => !u.IsEmpty);
    var emptyCount = units.Count(u => u.IsEmpty);
    var shopCount = units.Count(u => u.Category == "Dukkan");
    var resCount = units.Count(u => u.Category != "Dukkan");

    // Kat Hiyerarşisi (Çatı/Normal -> Zemin -> Bodrum (-1, -2) -> Yalnızca Tekil/Ana Yapıda Bahçe & Çevre (-99))
    var floorSet = allPhysicalUnits.Select(u => u.FloorLevel).ToHashSet();
    for (int b = 1; b <= Model.BasementFloors; b++) { floorSet.Add(-b); }
    if (Model.HasGroundFloor) { floorSet.Add(0); }
    if (!isSiteSecondaryBlock) { floorSet.Add(-99); }
    var distinctFloors = floorSet.OrderByDescending(f => f).ToList();
    if (!distinctFloors.Any()) { distinctFloors = new List<int> { 1, 0, -1 }; }

    var meetings = ViewBag.Meetings as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
    var commonSpaces = ViewBag.CommonSpaces as List<GMK360.Core.Entities.UnitSpace> ?? new List<GMK360.Core.Entities.UnitSpace>();
    var residencyPeriods = ViewBag.ResidencyPeriods as List<GMK360.Core.Entities.ResidencyPeriod> ?? new List<GMK360.Core.Entities.ResidencyPeriod>();
    var pendingApprovals = ViewBag.PendingApprovals as List<GMK360.Core.Entities.ApprovalRequest> ?? new List<GMK360.Core.Entities.ApprovalRequest>();
    var fixtureDocs = ViewBag.FixtureDocuments as Dictionary<int, List<GMK360.Core.Entities.DocumentArchive>> ?? new Dictionary<int, List<GMK360.Core.Entities.DocumentArchive>>();
    int activeBoardCount = ViewBag.ActiveBoardMemberCount is int bc ? bc : 0;

    // Tüm Bina Ağaç Envanteri (Kat -> Birim -> Demirbaş / Yangın / Sarf)
    var treeInventory = new List<(int FloorLevel, string FloorLabel, int UnitId, string UnitName, double? UnitSqm, GMK360.Core.Entities.SpaceFixture Fixture)>();
    var seenFixtureIds = new HashSet<int>();
    foreach (var u in (Model.Units ?? new List<GMK360.Core.Entities.BuildingUnit>()).OrderByDescending(x => x.FloorLevel).ThenBy(x => x.DoorNumber))
    {
        var flLbl = u.FloorLevel == -99 ? "Bahçe & Çevre" : (u.FloorLevel == 99 ? "Çatı / Teras" : (u.FloorLevel == 0 ? "Zemin Kat" : (u.FloorLevel < 0 ? $"{Math.Abs(u.FloorLevel)}. Bodrum" : $"{u.FloorLevel}. Kat")));
        foreach (var sp in (u.Spaces ?? new List<GMK360.Core.Entities.UnitSpace>()))
        {
            foreach (var fx in (sp.Fixtures ?? new List<GMK360.Core.Entities.SpaceFixture>()))
            {
                if (seenFixtureIds.Add(fx.Id))
                {
                    var locUnitName = (u.Category == "OrtakAlan_Blok" || u.DoorNumber == "ORTAK") ? sp.Name : u.DoorNumber;
                    treeInventory.Add((u.FloorLevel, flLbl, u.Id, locUnitName, u.GrossSquareMeters ?? sp.SquareMeters, fx));
                }
            }
        }
    }
    var demirbasCount = treeInventory.Count(x => !x.Fixture.Category.Contains("Yangın", StringComparison.OrdinalIgnoreCase) && !x.Fixture.Category.Contains("Sarf", StringComparison.OrdinalIgnoreCase));
    var yanginCount = treeInventory.Count(x => x.Fixture.Category.Contains("Yangın", StringComparison.OrdinalIgnoreCase));
    var sarfCount = treeInventory.Count(x => x.Fixture.Category.Contains("Sarf", StringComparison.OrdinalIgnoreCase));
    var alertCount = treeInventory.Count(x =>
        (x.Fixture.NextMaintenanceDate.HasValue && x.Fixture.NextMaintenanceDate.Value.Date <= DateTime.Today.AddDays(30))
        || (x.Fixture.WarrantyExpiryDate.HasValue && x.Fixture.WarrantyExpiryDate.Value.Date <= DateTime.Today.AddDays(30)));
}

<div class="container-fluid py-3 px-1">
    <!-- Üst Başlık & Aksiyonlar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/BuildingManager/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">
                    <i class="bi bi-arrow-left me-1"></i> Binalara Dön
                </a>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-shield-check me-1"></i> KMK 634 Sayılı Kanuna Uyumlu
                </span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-cash-stack me-1"></i> İkili Cari (Demirbaş & İşletme)
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-building text-primary me-2"></i> @Model.Name
                @if (!string.IsNullOrEmpty(Model.BlockName))
                {
                    <span class="text-secondary fw-normal fs-4">(@Model.BlockName)</span>
                }
            </h2>
            <p class="text-muted small mb-0 mt-1">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @(Model.StreetName ?? Model.Address), No: @(Model.BuildingNumber ?? "-") | @(Model.TotalFloors ?? 5) Katlı Yapı
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-danger fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
                <i class="bi bi-receipt me-1"></i> + Gider / Fatura İşle
            </button>
            <button class="btn btn-outline-success fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addUnitModal">
                <i class="bi bi-door-open me-1"></i> + Bağımsız Bölüm Ekle
            </button>
            <button class="btn btn-outline-dark fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addFixtureModal">
                <i class="bi bi-tools me-1"></i> + Tesis Demirbaşı Zimmetle
            </button>
            <button class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                <i class="bi bi-book me-1"></i> Noter Karar Defteri (Toplantı)
            </button>
        </div>
    </div>

    <!-- Başarı Bildirimi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-bold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                <div class="fw-bold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 shadow-sm border-0 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill fs-4 me-3 text-warning"></i>
                <div class="fw-bold">@TempData["WarningMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 BÜYÜK YÖNETİM METRİK KARTI -->
    <div class="row g-3 mb-4">
        <!-- 1. Toplanan Aidat & Kasa -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="text-muted small fw-bold text-uppercase">Toplanan Aidat / Fon</span>
                        <h4 class="fw-bold mb-0 text-success">@totalPaid.ToString("N0") ₺</h4>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <div class="progress flex-grow-1" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @collectionRate.ToString("0")%;"></div>
                            </div>
                            <small class="fw-bold text-muted" style="font-size:0.75rem;">%@collectionRate.ToString("0")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Geciken Alacak & Yasal Faiz -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-exclamation-triangle fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Bekleyen Alacak (Gecikmiş)</span>
                        <h4 class="fw-bold mb-0 text-danger">@totalUnpaid.ToString("N0") ₺</h4>
                        <small class="text-danger fw-semibold" style="font-size: 0.72rem;">
                            <i class="bi bi-clock-history me-1"></i>KMK Md.20/c: Aylık %5 Yasal Faiz
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Bağımsız Bölümler & Doluluk -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-door-open fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Bölümler & Doluluk</span>
                        <h4 class="fw-bold mb-0 text-primary">@units.Count <span class="fs-6 text-muted fw-normal">Bölüm</span></h4>
                        <small class="text-muted" style="font-size: 0.75rem;">
                            <span class="text-success fw-bold">@occupiedCount Dolu</span>, <span class="text-secondary">@emptyCount Boş</span> 
                            (@resCount Daire, @shopCount Dükkan)
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Toplam Giderler & Aktif İhaleler -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-25 text-dark rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-tools fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Net Aktif Gider / Bakım</span>
                        <h4 class="fw-bold mb-0 text-dark">@activeExpenses.Sum(e => e.TotalAmount).ToString("N0") ₺</h4>
                        <small class="text-muted" style="font-size: 0.75rem;">@activeExpenses.Count Aktif / @expenses.Count Toplam Kayıt</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- YÖNETİŞİM, TEKİL MERKEZ ID, KVKK YETKİ KİLİDİ VE PAKET ÇUBUĞU -->
    @{
        var pricingTier = ViewBag.PricingTier as GMK360.Web.Helpers.FacilityPricingResult;
        bool hasAuthDoc = ViewBag.HasDecisionAuthority is bool bAuth && bAuth;
        var govMembers = ViewBag.GovernanceMembers as List<GMK360.Core.Entities.BuildingManager> ?? new List<GMK360.Core.Entities.BuildingManager>();
        int rootBuildingId = ViewBag.RootBuildingId is int rId ? rId : Model.Id;
    }
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-dark text-white rounded-pill px-3 py-2">
                    <i class="bi bi-fingerprint me-1 text-warning"></i> Tekil Merkez ID: #@rootBuildingId
                </span>
                @if (pricingTier != null)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                        <i class="bi bi-tag-fill me-1"></i> @pricingTier.TierName: @pricingTier.AnnualPrice.ToString("N0") ₺/yıl (14 Gün Deneme)
                    </span>
                }
                @if (hasAuthDoc)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                        <i class="bi bi-patch-check-fill me-1"></i> Karar Defteri Yetkisi Onaylı
                    </span>
                }
                else
                {
                    <a href="/BuildingManager/Onboarding/@rootBuildingId" class="badge bg-warning-subtle text-warning-emphasis border border-warning rounded-pill px-3 py-2 text-decoration-none" title="KVKK gereği sakin telefonu eklemek için belge yükleyin">
                        <i class="bi bi-shield-exclamation me-1"></i> Taslak Modu: Karar Yetki Yazısı Yükle &rarr;
                    </a>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @foreach (var gm in govMembers)
                {
                    var roleLabel = gm.Role == GMK360.Core.Entities.BuildingManagerRole.HeadManager ? "Yönetici" : (gm.Role == GMK360.Core.Entities.BuildingManagerRole.BoardMember ? "Aza" : "Denetçi");
                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                        <i class="bi bi-person-badge me-1 text-success"></i>@roleLabel: @(gm.User != null ? $"{gm.User.FirstName} {gm.User.LastName}" : gm.UserId)
                    </span>
                }
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#governanceModal">
                    <i class="bi bi-people-fill me-1"></i> Kurul / Aza &amp; Devir
                </button>
                <a href="/BuildingManager/Onboarding/@rootBuildingId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-magic me-1"></i> Yapı Sihirbazı
                </a>
            </div>
        </div>
    </div>

    @if (pendingApprovals.Any())
    {
        <div class="card border-warning shadow-sm rounded-4 bg-warning bg-opacity-10 mb-4">
            <div class="card-header bg-transparent border-warning border-opacity-25 p-3 d-flex justify-content-between align-items-center">
                <div class="fw-bold text-dark">
                    <i class="bi bi-shield-lock-fill text-warning me-2"></i>2 Aza Multi-Sig Onay Kuyruğu (@pendingApprovals.Count Bekleyen Kritik İşlem)
                </div>
                <span class="badge bg-dark rounded-pill">Aktif Aza: @activeBoardCount</span>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    @foreach (var req in pendingApprovals)
                    {
                        <div class="col-md-6">
                            <div class="bg-white border rounded-3 p-3 d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <span class="badge bg-warning text-dark mb-1">@req.RequestType (@req.ApprovalCount / @req.RequiredApprovals Onay)</span>
                                    <div class="small fw-semibold text-dark">@req.Reason</div>
                                    <small class="text-muted">Talep #@req.Id • @req.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <form asp-action="DecideApprovalRequest" asp-controller="BuildingManager" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="buildingId" value="@Model.Id" />
                                        <input type="hidden" name="approve" value="true" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">Onayla</button>
                                    </form>
                                    <form asp-action="DecideApprovalRequest" asp-controller="BuildingManager" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="buildingId" value="@Model.Id" />
                                        <input type="hidden" name="approve" value="false" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">Reddet</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @{
        var siteBlocks = ViewBag.SiteBlocks as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    }
    @if (siteBlocks.Count > 1)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="small fw-bold text-dark me-1">
                        <i class="bi bi-buildings text-success me-1"></i>@(Model.HousingComplex?.Name ?? "Site Yapıları") Blokları:
                    </span>
                    @foreach (var blk in siteBlocks)
                    {
                        var blkUnitCount = blk.Units?.Count(u => !(u.Category ?? "").StartsWith("OrtakAlan")) ?? (blk.TotalApartments + blk.TotalShops);
                        var isCur = blk.Id == Model.Id;
                        <a href="/BuildingManager/Detail/@blk.Id" class="btn btn-sm @(isCur ? "btn-success fw-bold shadow-xs" : "btn-outline-success") rounded-pill px-3">
                            @(string.IsNullOrWhiteSpace(blk.BlockName) ? blk.Name : blk.BlockName)
                            <span class="badge @(isCur ? "bg-white text-success" : "bg-success-subtle text-success") rounded-pill ms-1">@blkUnitCount</span>
                        </a>
                    }
                </div>
                <a href="/BuildingManager/Onboarding/@rootBuildingId" class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Blok Ekle / Sihirbaz
                </a>
            </div>
        </div>
    }

    <!-- 3 ANA OMURGA SEKMESİ (TABS) -->
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm border" id="mainPillTab" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link active rounded-pill py-3 fw-bold fs-6 w-100" id="tab-structure-pill" data-bs-toggle="pill" data-bs-target="#tab-structure" type="button" role="tab">
                <i class="bi bi-building-fill-up me-2 text-primary"></i> 1. YAPI, KATLAR & TESİS EKOSİSTEMİ
            </button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link rounded-pill py-3 fw-bold fs-6 w-100" id="tab-summary-pill" data-bs-toggle="pill" data-bs-target="#tab-summary" type="button" role="tab">
                <i class="bi bi-pie-chart-fill me-2 text-success"></i> 2. YÖNETİM & FİNANS ÖZETİ
            </button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <button class="nav-link rounded-pill py-3 fw-bold fs-6 w-100" id="tab-inventory-pill" data-bs-toggle="pill" data-bs-target="#tab-inventory" type="button" role="tab">
                <i class="bi bi-diagram-3-fill me-2 text-warning"></i> 3. DEMİRBAŞ, YANGIN & SARF AĞACI
                <span class="badge bg-dark rounded-pill ms-1">@treeInventory.Count</span>
                @if (alertCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@alertCount Uyarı</span>
                }
            </button>
        </li>
    </ul>

    <!-- SEKME İÇERİKLERİ -->
    <div class="tab-content" id="mainPillTabContent">

        <!-- ========================================================================= -->
        <!-- SEKME 1: YAPI, KATLAR & TESİS EKOSİSTEMİ (FİZİKSEL HİYERARŞİ) -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade show active" id="tab-structure" role="tabpanel">
            
            <!-- Bilgilendirme Çubuğu -->
            <div class="alert alert-info border-0 rounded-4 shadow-sm d-flex align-items-center mb-4">
                <i class="bi bi-compass fs-3 text-info me-3"></i>
                <div class="small">
                    <strong>Fiziksel Yapı & Gezinti Sırası:</strong> Çatı Terasından başlar, normal katları ve bağımsız bölümleri içerir, zemin cadde dükkanlarına iner ve bodrumdaki sığınak/jeneratör tesislerine ulaşır.
                    <span class="badge bg-dark ms-2">🔒 Mahremiyet Kuralı:</span> Daire içi kombi/klima ve demirbaş zimmetleri sadece mülk sahibinin özel alanıdır.
                </div>
            </div>

            @{
                var indoorCommon = commonSpaces.Where(s => s.Type != "CevreDuzenleme").ToList();
                var outdoorCommon = commonSpaces.Where(s => s.Type == "CevreDuzenleme").ToList();
                double? landAreaSqm = ViewBag.LandAreaSqm as double?;
                double totalFootprintSqm = ViewBag.TotalFootprintSqm is double fp ? fp : (Model.BaseArea ?? 0);
                double totalOutdoorSqm = outdoorCommon.Sum(s => s.SquareMeters ?? 0);
                double? remainingLandSqm = landAreaSqm.HasValue ? (landAreaSqm.Value - totalFootprintSqm - totalOutdoorSqm) : (double?)null;
            }
            <!-- 1. A) DIŞ ALAN, ARAZİ OTO-KONTROLÜ & BİNA İÇİ ORTAK ALANLAR (SİHİRBAZDAN BAĞIMSIZ) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-top border-4 border-success">
                <div class="card-header bg-success bg-opacity-10 border-0 p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold me-2">
                            <i class="bi bi-tree-fill me-1"></i> ARAZİ, DIŞ ÇEVRE &amp; ORTAK ALANLAR
                        </span>
                        <h5 class="fw-bold text-dark mb-0">Kurulum Sonrası Bağımsız Alan &amp; Sosyal Donatı Yönetimi</h5>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold" onclick="openOutdoorSpaceModal()">
                            <i class="bi bi-tree me-1"></i> + Dış Alan / Kamelya Ekle
                        </button>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" onclick="openFloorUnitModal(-1, '1. BODRUM')">
                            <i class="bi bi-building-add me-1"></i> + Bina / Bodrum Birimi Ekle
                        </button>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!isSiteSecondaryBlock)
                    {
                        <!-- İNŞAAT ERP TARZI ARAZİ DAĞILIMI VE OTO-KONTROL -->
                        <div class="row g-3 align-items-center p-3 mb-4 rounded-4 border bg-light bg-opacity-75">
                            <div class="col-lg-5">
                                <form asp-action="UpdateBuildingLandArea" asp-controller="BuildingManager" method="post" class="d-flex align-items-end gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="buildingId" value="@Model.Id" />
                                    <div class="flex-grow-1">
                                        <label class="form-label small fw-bold text-dark mb-1">
                                            <i class="bi bi-bounding-box text-success me-1"></i>Tapudaki Toplam Arazi Alanı (m² - Opsiyonel)
                                        </label>
                                        <input type="number" step="0.01" min="0" name="landAreaSqm" class="form-control form-control-sm fw-bold" value="@(landAreaSqm?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")" placeholder="Örn: 3600" />
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold">Araziyi Kaydet</button>
                                </form>
                            </div>
                            <div class="col-lg-7">
                                <div class="row g-2 text-center">
                                    <div class="col-4">
                                        <div class="p-2 bg-white rounded-3 border">
                                            <span class="d-block text-muted" style="font-size:0.72rem;">Blok Taban Oturumu</span>
                                            <strong class="text-primary fs-6">@totalFootprintSqm.ToString("0.##") m²</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 bg-white rounded-3 border">
                                            <span class="d-block text-muted" style="font-size:0.72rem;">Eklenen Dış Alanlar</span>
                                            <strong class="text-success fs-6">@totalOutdoorSqm.ToString("0.##") m²</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 bg-white rounded-3 border">
                                            <span class="d-block text-muted" style="font-size:0.72rem;">Kalan Boş Alan (Net)</span>
                                            @if (remainingLandSqm.HasValue)
                                            {
                                                <strong class="@(remainingLandSqm < 0 ? "text-danger" : "text-dark") fs-6">@remainingLandSqm.Value.ToString("0.##") m²</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Arazi girilmedi</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-success mb-0"><i class="bi bi-tree-fill me-1"></i>Dış Alanlar, Bahçe, Kamelya, Kuyu &amp; Sosyal Donatılar (@outdoorCommon.Count)</h6>
                            <a href="/BuildingManager/BakimTakvimi?buildingId=@Model.Id" class="small fw-semibold text-success text-decoration-none">Budama &amp; Bakım Takvimi &rarr;</a>
                        </div>
                        @if (!outdoorCommon.Any())
                        {
                            <p class="small text-muted fst-italic mb-3">Henüz dış alan donatısı eklenmedi. Yukarıdaki <strong>"+ Dış Alan / Kamelya Ekle"</strong> ile Sihirbaza dönmeden doğrudan ekleyebilirsiniz.</p>
                        }
                        else
                        {
                            <div class="row g-3 mb-3">
                                @foreach (var space in outdoorCommon)
                                {
                                    var fixtures = space.Fixtures?.ToList() ?? new List<GMK360.Core.Entities.SpaceFixture>();
                                    <div class="col-md-4">
                                        <div class="p-3 border border-success-subtle rounded-3 bg-success bg-opacity-10 h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-2 gap-1">
                                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-tree text-success me-1"></i> @space.Name</h6>
                                                <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                    @if (space.SquareMeters.HasValue)
                                                    {
                                                        <span class="badge bg-white text-dark border">@space.SquareMeters.Value.ToString("0.##") m²</span>
                                                    }
                                                    <span class="badge bg-success text-white">Dış Alan</span>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(space.Description))
                                            {
                                                <div class="small text-secondary mb-1"><i class="bi bi-wrench-adjustable me-1"></i>@space.Description</div>
                                            }
                                            @if (fixtures.Any())
                                            {
                                                <div class="small border-top pt-2 mt-2">
                                                    @foreach (var fx in fixtures.Take(3))
                                                    {
                                                        <div class="mb-1"><span class="fw-semibold text-dark">@fx.ItemName</span></div>
                                                    }
                                                </div>
                                            }
                                            else if (string.IsNullOrWhiteSpace(space.Description))
                                            {
                                                <div class="small text-muted fst-italic">Mevsimlik Bakım &amp; Peyzaj Kapsamında</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 py-2 px-3">
                            <div class="small text-dark">
                                <i class="bi bi-tree-fill text-success me-1"></i>
                                <strong>Site Ortak Dış Çevre &amp; Sosyal Alanları:</strong> Çok bloklu site olduğu için dış çevre donatıları bloklarda tekrarlanmaz; ortak site yönetiminde tek yerde tutulur.
                            </div>
                            @if (sitePrimaryId.HasValue)
                            {
                                <a href="/BuildingManager/Detail/@sitePrimaryId" class="btn btn-xs btn-success rounded-pill px-3 fw-semibold" style="font-size:0.78rem;">@sitePrimaryName Ortak Alanına Git &rarr;</a>
                            }
                        </div>
                    }

                    @if (indoorCommon.Any())
                    {
                        <h6 class="fw-bold text-primary mb-2 pt-3 border-top"><i class="bi bi-building-gear me-1"></i>Bina / Blok İçi Ortak Teknik Alanlar (@indoorCommon.Count)</h6>
                        <div class="row g-3">
                            @foreach (var space in indoorCommon)
                            {
                                var fixtures = space.Fixtures?.ToList() ?? new List<GMK360.Core.Entities.SpaceFixture>();
                                <div class="col-md-4">
                                    <div class="p-3 border rounded-3 bg-light h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2 gap-1">
                                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-gear-wide-connected text-primary me-1"></i> @space.Name</h6>
                                            <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                @if (space.SquareMeters.HasValue)
                                                {
                                                    <span class="badge bg-white text-dark border">@space.SquareMeters.Value.ToString("0.##") m²</span>
                                                }
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Bina İçi</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(space.Description))
                                        {
                                            <div class="small text-secondary mb-1"><i class="bi bi-info-circle me-1"></i>@space.Description</div>
                                        }
                                        @if (fixtures.Any())
                                        {
                                            <div class="small border-top pt-2 mt-2">
                                                @foreach (var fx in fixtures.Take(3))
                                                {
                                                    <div class="mb-1"><span class="fw-semibold text-dark">@fx.ItemName</span> @(!string.IsNullOrWhiteSpace(fx.TechnicalServiceName) ? $"• {fx.TechnicalServiceName}" : "")</div>
                                                }
                                            </div>
                                        }
                                        else if (string.IsNullOrWhiteSpace(space.Description))
                                        {
                                            <div class="small text-muted fst-italic">Teknik / Demirbaş Kapsamında</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 1. B) NORMAL KATLAR, ZEMİN, BODRUM & TEKNİK BİRİMLER (İNŞAAT ERP UYUMLU DİKEY KESİT) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-layers-half text-primary me-2"></i> Katlar, Bodrum, Bahçe &amp; Birim Dağılım Matrisi</h5>
                        <small class="text-muted">Zemin katta daire ve dükkanlar birlikte görünür; Bodrum ve tüm katlara pompa odası, hidrofor, depo/ardiye ekleyip içine demirbaş koyabilirsiniz.</small>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-bold">
                            @resCount Daire@(shopCount > 0 ? $" • {shopCount} Dükkan" : "")
                        </span>
                        <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#bulkFloorUnitModal">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Çoklu Kat / Birim Üretici
                        </button>
                        @if (!distinctFloors.Contains(0))
                        {
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold" onclick="openFloorUnitModal(0, 'ZEMİN KAT')">
                                <i class="bi bi-plus-circle me-1"></i> Zemin Kat Ekle
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" onclick="openFloorUnitModal(-1, '1. BODRUM')">
                            <i class="bi bi-plus-circle me-1"></i> Kat / Bodrum Birimi Ekle
                        </button>
                    </div>
                    @if (siteBlocks.Count > 1)
                    {
                        <div class="w-100 pt-2 mt-1 border-top d-flex flex-wrap align-items-center gap-1">
                            <span class="small fw-bold text-muted me-1"><i class="bi bi-buildings me-1"></i>Blok Değiştir:</span>
                            @foreach (var blk in siteBlocks)
                            {
                                var blkUnitCount = blk.Units?.Count(u => !(u.Category ?? "").StartsWith("OrtakAlan")) ?? (blk.TotalApartments + blk.TotalShops);
                                var isCur = blk.Id == Model.Id;
                                <a href="/BuildingManager/Detail/@blk.Id" class="btn btn-xs @(isCur ? "btn-success text-white fw-bold" : "btn-outline-success") rounded-pill px-3 py-1" style="font-size:.78rem;">
                                    @(string.IsNullOrWhiteSpace(blk.BlockName) ? blk.Name : blk.BlockName) (@blkUnitCount)
                                </a>
                            }
                        </div>
                    }
                </div>
                <div class="card-body p-4 bg-light bg-opacity-50">
                    
                    @foreach (var floor in distinctFloors)
                    {
                        var floorUnits = allPhysicalUnits
                            .Where(u => u.FloorLevel == floor)
                            .OrderBy(u => (u.Category ?? "").StartsWith("OrtakAlan") ? 2 : (u.Category == "Dukkan" ? 1 : 0))
                            .ThenBy(u => u.DoorNumber)
                            .ToList();
                        var floorAptCount = floorUnits.Count(u => !(u.Category ?? "").StartsWith("OrtakAlan") && u.Category != "Dukkan");
                        var floorShopCount = floorUnits.Count(u => u.Category == "Dukkan");
                        var floorTechCount = floorUnits.Count(u => (u.Category ?? "").StartsWith("OrtakAlan"));
                        var floorParts = new List<string>();
                        if (floorAptCount > 0) floorParts.Add($"{floorAptCount} Daire");
                        if (floorShopCount > 0) floorParts.Add($"{floorShopCount} Dükkan");
                        if (floorTechCount > 0) floorParts.Add($"{floorTechCount} Teknik/Depo");
                        var floorSummaryLabel = floorParts.Any() ? string.Join(" + ", floorParts) : "Birim Eklenebilir";
                        var floorTitle = floor == -99
                            ? "BAHÇE & ÇEVRE"
                            : (floor == 99
                                ? "ÇATI / TERAS"
                                : (floor == 0
                                    ? "ZEMİN KAT"
                                    : (floor < 0 ? $"{Math.Abs(floor)}. BODRUM" : $"{floor}. KAT")));
                        var isBasementFloor = floor < 0 && floor != -99;
                        var isGardenFloor = floor == -99;
                        
                        <div class="row align-items-stretch mb-3 pb-3 border-bottom border-secondary border-opacity-10">
                            <!-- Sol: Kat Etiketi + Bu Kata Birim Ekle Butonu -->
                            <div class="col-md-2 col-sm-3 mb-2 mb-sm-0 d-flex">
                                <div class="bg-white border @(isBasementFloor ? "border-secondary border-2" : (isGardenFloor ? "border-success border-2" : "")) rounded-4 p-2 text-center shadow-sm w-100 d-flex flex-column justify-content-center">
                                    <span class="fw-bold @(isBasementFloor ? "text-secondary" : (isGardenFloor ? "text-success" : "text-dark")) fs-6 d-block">@floorTitle</span>
                                    <small class="text-muted fw-semibold d-block mb-2" style="font-size:0.75rem;">@floorSummaryLabel</small>
                                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-1 fw-semibold" style="font-size:0.72rem;" onclick="openFloorUnitModal(@floor, '@floorTitle')">
                                        <i class="bi bi-plus-lg me-1"></i>Birim Ekle
                                    </button>
                                </div>
                            </div>

                            <!-- Sağ: Daire, Zemin Dükkan ve Teknik / Depolama Birimleri Grid'i -->
                            <div class="col-md-10 col-sm-9">
                                <div class="row g-2">
                                    @if (!floorUnits.Any())
                                    {
                                        <div class="col-12">
                                            <div class="p-3 border border-dashed rounded-3 text-center bg-white small text-muted fst-italic">
                                                @floorTitle için henüz birim tanımlanmadı. Soldaki <strong>"+ Birim Ekle"</strong> ile Pompa Odası, Hidrofor, Depo veya Kuyu ekleyebilirsiniz.
                                            </div>
                                        </div>
                                    }
                                    @foreach (var unit in floorUnits)
                                    {
                                        var isTechUnit = (unit.Category ?? "").StartsWith("OrtakAlan");
                                        if (isTechUnit)
                                        {
                                            var isStorage = unit.Category == "OrtakAlan_Depo";
                                            var unitFixtures = (unit.Spaces ?? new List<GMK360.Core.Entities.UnitSpace>())
                                                .SelectMany(s => s.Fixtures ?? new List<GMK360.Core.Entities.SpaceFixture>())
                                                .ToList();
                                            var cardBorder = isGardenFloor ? "border-success bg-success bg-opacity-10" : (isStorage ? "border-secondary bg-light" : "border-warning bg-warning bg-opacity-10");
                                            var catBadge = isGardenFloor ? "Çevre / Bahçe Birimi" : (isStorage ? "Depo / Ardiye" : "Teknik / Tesis Birimi");

                                            <div class="col-lg-4 col-md-6">
                                                <div class="card border @cardBorder rounded-4 p-3 shadow-sm h-100">
                                                    <div class="d-flex justify-content-between align-items-start gap-1 mb-2">
                                                        <div>
                                                            <span class="fw-bold text-dark fs-6 d-block">
                                                                <i class="bi @(isGardenFloor ? "bi-tree-fill text-success" : (isStorage ? "bi-box-seam-fill text-secondary" : "bi-gear-wide-connected text-warning-emphasis")) me-1"></i>@unit.DoorNumber
                                                            </span>
                                                            @if (!string.IsNullOrWhiteSpace(unit.RoomLayout))
                                                            {
                                                                <small class="text-muted">@unit.RoomLayout</small>
                                                            }
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                            @if (unit.GrossSquareMeters.HasValue && unit.GrossSquareMeters > 0)
                                                            {
                                                                <span class="badge bg-white text-dark border">@unit.GrossSquareMeters.Value.ToString("0.##") m²</span>
                                                            }
                                                            <span class="badge bg-dark">@catBadge</span>
                                                        </div>
                                                    </div>

                                                    <div class="small bg-white bg-opacity-75 rounded-3 p-2 border mb-2">
                                                        <div class="fw-bold text-dark mb-1" style="font-size:0.75rem;">
                                                            <i class="bi bi-wrench-adjustable-circle text-primary me-1"></i>Birim Demirbaşları &amp; Ekipman (@unitFixtures.Count)
                                                        </div>
                                                        @if (!unitFixtures.Any())
                                                        {
                                                            <div class="text-muted fst-italic" style="font-size:0.75rem;">Henüz pompa / motor / demirbaş eklenmedi.</div>
                                                        }
                                                        else
                                                        {
                                                            foreach (var fx in unitFixtures)
                                                            {
                                                                <div class="d-flex justify-content-between align-items-center border-top pt-1 mt-1" style="font-size:0.78rem;">
                                                                    <span class="fw-semibold text-dark">@fx.ItemName @(!string.IsNullOrWhiteSpace(fx.StandardBrand) ? $"({fx.StandardBrand})" : "")</span>
                                                                    <span class="badge bg-primary-subtle text-primary">x@fx.Quantity</span>
                                                                </div>
                                                            }
                                                        }
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-1">
                                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 fw-bold" style="font-size:0.75rem;" onclick="openFloorFixtureModal(@unit.Id, '@unit.DoorNumber.Replace("'", "\\'")')">
                                                            <i class="bi bi-plus-circle me-1"></i>Demirbaş / Pompa Ekle
                                                        </button>
                                                        <form asp-action="DeleteFloorTechnicalUnit" asp-controller="BuildingManager" method="post" class="d-inline" onsubmit="return confirm('Bu teknik/depo birimini kaldırmak istediğinize emin misiniz?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="buildingId" value="@Model.Id" />
                                                            <input type="hidden" name="unitId" value="@unit.Id" />
                                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Birimi Kaldır"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            var unitDebts = unit.Debts?.ToList() ?? new List<GMK360.Core.Entities.UnitDebt>();
                                            var unitUnpaid = unitDebts.Where(d => !d.IsPaid).Sum(d => d.Amount);
                                            var isShop = unit.Category == "Dukkan";

                                            <div class="col-lg-4 col-md-6">
                                                <div class="card border @(isShop ? "border-success bg-success bg-opacity-10" : "bg-white") rounded-4 p-3 shadow-sm hover-shadow transition-all cursor-pointer h-100" onclick="openUnitModal(@unit.Id, '@unit.DoorNumber', '@unit.RoomLayout', '@(unit.OwnerName ?? "-")', '@(unit.OwnerPhone ?? "-")', '@(unit.TenantName ?? "-")', '@(unit.TenantPhone ?? "-")', @unitUnpaid, @(unit.IsEmpty ? "true" : "false"))">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <span class="badge @(isShop ? "bg-success" : "bg-dark") rounded-pill px-2 py-1 mb-1 font-monospace">@unit.DoorNumber</span>
                                                            <span class="badge bg-light text-dark border ms-1">@(unit.RoomLayout ?? (isShop ? "Dükkan" : "3+1"))</span>
                                                        </div>
                                                        <div>
                                                            @if (isShop)
                                                            {
                                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">🏪 Dükkan (Asansör Muaf)</span>
                                                            }
                                                            else if (unit.IsEmpty)
                                                            {
                                                                <span class="badge bg-secondary rounded-pill">⚪ Boş Daire</span>
                                                            }
                                                            else if (!string.IsNullOrEmpty(unit.TenantName))
                                                            {
                                                                <span class="badge bg-info text-dark rounded-pill">🟢 Kiracıda</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-primary rounded-pill">🔵 Ev Sahibi</span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="small mb-2">
                                                        <div class="d-flex justify-content-between">
                                                            <span class="text-muted"><i class="bi bi-person-fill text-secondary me-1"></i> Ev Sahibi:</span>
                                                            <span class="fw-bold text-dark text-truncate" style="max-width: 180px;">@(unit.OwnerName ?? "Belirtilmedi")</span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(unit.TenantName))
                                                        {
                                                            <div class="d-flex justify-content-between mt-1">
                                                                <span class="text-muted"><i class="bi bi-person-check text-info me-1"></i> Kiracı:</span>
                                                                <span class="fw-bold text-info text-truncate" style="max-width: 180px;">@unit.TenantName</span>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                                                        <span class="text-muted" style="font-size:0.75rem;">
                                                            <i class="bi bi-arrows-fullscreen me-1"></i>@(unit.GrossSquareMeters ?? 110) m²
                                                        </span>
                                                        @if (unitUnpaid > 0)
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold">
                                                                <i class="bi bi-exclamation-circle me-1"></i>@unitUnpaid.ToString("N0") ₺ Borçlu
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold">
                                                                <i class="bi bi-check2 me-1"></i>Borcu Yok
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- SEKME 2: YÖNETİM & FİNANS ÖZETİ (GİDERLER, KARARLAR, TALEPLER) -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade" id="tab-summary" role="tabpanel">
            
            <div class="row g-4">
                <!-- Sol Kolon: Karar Defteri & Fatura Listesi -->
                <div class="col-lg-8">
                    
                    <!-- NOTER KARAR DEFTERİ BLOK -->
                    <div class="card border-warning border-opacity-50 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-warning bg-opacity-10 border-0 p-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold me-2">
                                    <i class="bi bi-book-half me-1"></i> NOTER KARAR DEFTERİ
                                </span>
                                <h5 class="fw-bold text-dark mb-0">Genel Kurul Kararları (KMK Md. 32)</h5>
                            </div>
                            <button class="btn btn-sm btn-outline-dark fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                                <i class="bi bi-plus-circle me-1"></i> + Yeni Karar Ekle
                            </button>
                        </div>
                        <div class="card-body p-4">
                            @if (!meetings.Any())
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-journal-bookmark text-muted fs-1 mb-2 d-block"></i>
                                    <h6 class="fw-bold text-dark">Henüz Kayıtlı Genel Kurul Kararı Yok</h6>
                                    <p class="text-muted small">Noter tasdikli deftere işlenecek kararları yukarıdaki butondan ekleyebilirsiniz.</p>
                                    <button class="btn btn-warning fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newMeetingModal">
                                        <i class="bi bi-plus-lg me-1"></i> İlk Kararı Oluştur
                                    </button>
                                </div>
                            }
                            else
                            {
                                foreach (var m in meetings)
                                {
                                    <div class="border rounded-4 p-3 bg-light mb-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge bg-dark rounded-pill px-2 py-1 mb-1 font-monospace">Toplantı #@m.Id</span>
                                                <h5 class="fw-bold text-dark mb-0">@m.AgendaTitle</h5>
                                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> @m.MeetingDate.ToString("dd MMMM yyyy - dddd")</small>
                                            </div>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold">Oy Çokluğuyla Kabul</span>
                                        </div>

                                        @if (m.Decisions != null && m.Decisions.Any())
                                        {
                                            <div class="bg-white p-3 rounded-3 border mb-3 small">
                                                @foreach (var dec in m.Decisions)
                                                {
                                                    <div class="mb-2 text-dark">
                                                        <i class="bi bi-check2-circle text-success me-1"></i> <strong>@dec.DecisionText</strong>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id" target="_blank" class="btn btn-outline-dark btn-sm fw-bold rounded-pill px-3 shadow-sm">
                                                <i class="bi bi-printer me-1"></i> Noter Defteri Baskı Şablonunu İndir / Yazdır (A4)
                                            </a>
                                            <button class="btn btn-success btn-sm fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadScanModal" onclick="document.getElementById('scanMeetingId').value = '@m.Id'">
                                                <i class="bi bi-camera me-1"></i> İmzalı Sayfayı Arşivle
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- FATURALAR VE GİDER TABLOSU -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt text-danger me-2"></i> Son Giderler & Faturalar</h5>
                            <span class="badge bg-light text-dark border">Demirbaş vs İşletme</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th class="ps-3">Tarih</th>
                                            <th>Açıklama / Fatura</th>
                                            <th>Gider Türü</th>
                                            <th>Tutar</th>
                                            <th class="pe-3 text-end">Kapsam</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!expenses.Any())
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted fst-italic">Henüz kayıtlı fatura bulunmuyor.</td>
                                            </tr>
                                        }
                                        @foreach (var exp in expenses)
                                        {
                                            bool isFixture = exp.ExpenseType == GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure
                                                || string.Equals(exp.PayerType, "Owner", StringComparison.OrdinalIgnoreCase);
                                            bool isReversal = exp.ReversalOfExpenseId != null || exp.TotalAmount < 0;
                                            <tr class="@(exp.IsArchived ? "table-secondary opacity-75" : "")">
                                                <td class="ps-3 small">@exp.Date.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="fw-bold text-dark">@exp.Description</span>
                                                    @if (isReversal)
                                                    {
                                                        <span class="badge bg-dark ms-1">TERS KAYIT</span>
                                                    }
                                                    else if (exp.IsArchived)
                                                    {
                                                        <span class="badge bg-secondary ms-1">İPTAL EDİLDİ (ARŞİV)</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(exp.InvoiceDocumentUrl))
                                                    {
                                                        <a href="@exp.InvoiceDocumentUrl" target="_blank" class="badge bg-info-subtle text-info-emphasis border border-info-subtle text-decoration-none ms-1">
                                                            <i class="bi bi-file-earmark-text"></i> Fatura
                                                        </a>
                                                    }
                                                </td>
                                                <td>
                                                    @if (isFixture)
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">🔨 Demirbaş (Daima Malik)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">💡 İşletme (Kiracı / Malik)</span>
                                                    }
                                                </td>
                                                <td class="fw-bold @(exp.TotalAmount < 0 ? "text-danger" : "text-dark")">@exp.TotalAmount.ToString("N2") ₺</td>
                                                <td class="pe-3 text-end">
                                                    @if (!exp.IsArchived && !isReversal)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                                                onclick="openReversalModal(@exp.Id, '@System.Web.HttpUtility.JavaScriptStringEncode(exp.Description)', '@exp.TotalAmount.ToString("N2")')">
                                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Ters Kayıt / İptal
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border">Arşiv Korumalı</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Sağ Kolon: Kasa, GMSİ Vergi Özeti & Sakin Talepleri -->
                <div class="col-lg-4">
                    
                    <!-- GMSİ KİRA GELİR VERGİSİ KARTI -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-file-earmark-spreadsheet-fill text-warning fs-2 me-3"></i>
                                <div>
                                    <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 mb-1">GVK Madde 74</span>
                                    <h5 class="fw-bold text-white mb-0">GMSİ Vergi Kalkanı</h5>
                                </div>
                            </div>
                            <p class="text-white-50 small mb-3">
                                Bu binadaki ev sahiplerinin çatı, asansör ve demirbaş payları Gelir İdaresi Başkanlığı (GİB) gerçek gider formatında arşivlenmektedir.
                            </p>
                            <a href="/BuildingManager/PrintGmsiTaxReport?buildingId=@Model.Id" target="_blank" class="btn btn-warning text-dark fw-bold rounded-pill w-100 shadow-sm">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> 2026 Maliye Vergi Dosyasını Hazırla (PDF)
                            </a>
                        </div>
                    </div>

                    <!-- KASA & BANKA HESABI -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bank text-success me-2"></i> Bina Kasa &amp; Aidat Takibi</h6>
                            <a href="/BuildingManager/Aidatlar?buildingId=@Model.Id" class="btn btn-sm btn-outline-success rounded-pill px-2">Aidat Cetveli</a>
                        </div>
                        <div class="card-body p-3">
                            <div class="p-3 bg-light rounded-3 mb-2 d-flex justify-content-between align-items-center">
                                <span class="small fw-semibold text-muted">Tahsil Edilen</span>
                                <span class="badge bg-success fs-6">@totalPaid.ToString("N2") ₺</span>
                            </div>
                            <div class="p-3 bg-light rounded-3 mb-2 d-flex justify-content-between align-items-center">
                                <span class="small fw-semibold text-muted">Bekleyen Alacak</span>
                                <span class="badge bg-danger fs-6">@totalUnpaid.ToString("N2") ₺</span>
                            </div>
                            <small class="text-muted d-block" style="font-size:0.75rem;">
                                Ters kayıt ve 2 Aza onaylı değişiklikler denetim izinde saklanır.
                            </small>
                        </div>
                    </div>

                    <!-- SAKİN ARIZA & ŞİKAYET TALEPLERİ -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-headset text-info me-2"></i> Sakin Talepleri &amp; Arızalar</h6>
                            <a href="/BuildingManager/TicketManagement?buildingId=@Model.Id" class="btn btn-sm btn-outline-info rounded-pill px-2">Tümünü Aç</a>
                        </div>
                        <div class="card-body p-3">
                            <p class="small text-muted mb-2">Bina sakinlerinden gelen arıza ve teknik servis taleplerini buradan yönetebilirsiniz.</p>
                            <a href="/BuildingManager/TicketManagement?buildingId=@Model.Id" class="btn btn-sm btn-light border rounded-pill w-100 fw-semibold">
                                <i class="bi bi-wrench-adjustable me-1"></i> Arıza Masasına Git
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- SEKME 3: YAŞAYAN DEMİRBAŞ, YANGIN & SARF ENVANTERİ (AĞAÇ KONUM HARİTASI) -->
        <!-- ========================================================================= -->
        <div class="tab-pane fade" id="tab-inventory" role="tabpanel">
            <div class="alert alert-warning bg-warning bg-opacity-10 border-warning border-opacity-25 rounded-4 d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-diagram-3-fill fs-2 text-warning-emphasis me-3"></i>
                    <div class="small">
                        <strong class="text-dark fs-6 d-block">Cansız Ama Yaşayan Yapı: Ne Nerede? + Garanti + Servis + Bakım Takibi</strong>
                        Yapı mekanı (örn. <em>1. Bodrum › Hidrofor Odası</em>) ile içindeki ekipman (<em>2 adet Pompa, Yangın Tüpü, Sarf Stoğu</em>) birbirinden ayrıdır.
                        Yeni bir teknik firmayla anlaştığınızda veya acil durumda tek tıkla konumu, garantiyi ve evrakı gösterir.
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/BuildingManager/PrintEquipmentInventory/@Model.Id" target="_blank" class="btn btn-sm btn-dark rounded-pill px-3 fw-bold">
                        <i class="bi bi-printer me-1"></i> Teknik Firma Devir &amp; Acil Durum Listesi
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#bulkSwitchServiceModal">
                        <i class="bi bi-arrow-repeat me-1"></i> Yeni Teknik Firmaya Devret
                    </button>
                </div>
            </div>

            <!-- Üst 4 Sayaç Kartı -->
            <div class="row g-3 mb-4">
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-white rounded-4 border shadow-sm">
                        <span class="small text-muted fw-semibold d-block">⚙️ Demirbaş &amp; Makine</span>
                        <h3 class="fw-bold text-primary mb-0">@demirbasCount</h3>
                        <small class="text-muted">Pompa, hidrofor, kazan, motor</small>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-white rounded-4 border border-danger-subtle shadow-sm">
                        <span class="small text-muted fw-semibold d-block">🧯 Yangın &amp; Güvenlik</span>
                        <h3 class="fw-bold text-danger mb-0">@yanginCount</h3>
                        <small class="text-muted">Yangın tüpü, dolap, dedektör</small>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-white rounded-4 border border-info-subtle shadow-sm">
                        <span class="small text-muted fw-semibold d-block">📦 Sarf &amp; Tüketim</span>
                        <h3 class="fw-bold text-info mb-0">@sarfCount</h3>
                        <small class="text-muted">Tuz, filtre, kimyasal, lamba stoğu</small>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-white rounded-4 border @(alertCount > 0 ? "border-danger bg-danger bg-opacity-10" : "border-success-subtle") shadow-sm">
                        <span class="small text-muted fw-semibold d-block">⚠️ Kontrol / Bitiş Alarmı</span>
                        <h3 class="fw-bold @(alertCount > 0 ? "text-danger" : "text-success") mb-0">@alertCount</h3>
                        <small class="text-muted">30 gün içi veya tarihi geçmiş</small>
                    </div>
                </div>
            </div>

            <!-- Filtre & Arama Çubuğu -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex flex-wrap gap-1" id="invFilterBtns">
                        <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 active" onclick="filterInventory('ALL', this)">Tümü (@treeInventory.Count)</button>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterInventory('Demirbas', this)">⚙️ Demirbaş (@demirbasCount)</button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="filterInventory('Yangin', this)">🧯 Yangın (@yanginCount)</button>
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="filterInventory('Sarf', this)">📦 Sarf / Stok (@sarfCount)</button>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="filterInventory('ALERT', this)">⚠️ Bakımı / Bitişi Yaklaşan (@alertCount)</button>
                    </div>
                    <div style="min-width:250px;">
                        <input type="text" id="invSearchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Ne nerede? Ara (pompa, tüp, bodrum, servis)..." oninput="applyInventoryFilters()" />
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (!treeInventory.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-diagram-3 fs-1 d-block mb-2 text-warning"></i>
                            <div class="fw-bold text-dark">Henüz envanter / demirbaş kaydı yok.</div>
                            <p class="small mb-2">1. Sekmedeki kat matrisinden herhangi bir birimin (örn. <em>1. Bodrum › Hidrofor Odası</em>) içindeki <strong>"+ Demirbaş / Pompa Ekle"</strong> butonunu kullanın.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small" id="treeInventoryTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ağaç Konum (Kat › Birim)</th>
                                        <th>Ekipman / Yangın / Sarf</th>
                                        <th>Miktar</th>
                                        <th>Garanti Bitiş</th>
                                        <th>Teknik Servis &amp; Tedarikçi</th>
                                        <th>Kontrol / Dolum / Bitiş</th>
                                        <th>Evrak</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in treeInventory)
                                    {
                                        var fx = item.Fixture;
                                        var catLow = (fx.Category ?? "").ToLowerInvariant();
                                        var catKey = catLow.Contains("yangın") || catLow.Contains("yangin") ? "Yangin" : (catLow.Contains("sarf") ? "Sarf" : "Demirbas");
                                        var isMaintAlert = fx.NextMaintenanceDate.HasValue && fx.NextMaintenanceDate.Value.Date <= DateTime.Today.AddDays(30);
                                        var isWarAlert = fx.WarrantyExpiryDate.HasValue && fx.WarrantyExpiryDate.Value.Date <= DateTime.Today.AddDays(30);
                                        var isAlert = isMaintAlert || isWarAlert;
                                        var docs = fixtureDocs.TryGetValue(fx.Id, out var dList) ? dList : new List<GMK360.Core.Entities.DocumentArchive>();
                                        var searchBlob = $"{item.FloorLabel} {item.UnitName} {fx.ItemName} {fx.StandardBrand} {fx.StandardModel} {fx.TechnicalServiceName} {fx.SupplierName} {fx.MaintenanceNotes} {fx.Category}".ToLowerInvariant();

                                        <tr class="inv-row" data-cat="@catKey" data-alert="@(isAlert ? "true" : "false")" data-search="@searchBlob">
                                            <td>
                                                <span class="badge bg-light text-dark border fw-semibold">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.FloorLabel &rsaquo; @item.UnitName
                                                </span>
                                                @if (item.UnitSqm.HasValue && item.UnitSqm > 0)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary ms-1">@item.UnitSqm.Value.ToString("0.##") m²</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fx.MaintenanceNotes))
                                                {
                                                    <div class="text-muted mt-1" style="font-size:0.75rem;"><i class="bi bi-pin-angle me-1"></i>@fx.MaintenanceNotes</div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @(catKey == "Yangin" ? "bg-danger" : (catKey == "Sarf" ? "bg-info text-dark" : "bg-primary")) me-1">@(fx.Category ?? "Demirbaş")</span>
                                                <strong class="text-dark">@fx.ItemName</strong>
                                                @if (!string.IsNullOrWhiteSpace(fx.StandardBrand) || !string.IsNullOrWhiteSpace(fx.StandardModel))
                                                {
                                                    <div class="text-muted" style="font-size:0.76rem;">@fx.StandardBrand @fx.StandardModel</div>
                                                }
                                            </td>
                                            <td class="fw-bold">@fx.Quantity.ToString("0.##") @fx.Unit</td>
                                            <td>
                                                @if (!fx.WarrantyExpiryDate.HasValue)
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else if (fx.WarrantyExpiryDate.Value.Date < DateTime.Today)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Bitti (@fx.WarrantyExpiryDate.Value.ToString("dd.MM.yyyy"))</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-shield-check me-1"></i>@fx.WarrantyExpiryDate.Value.ToString("dd.MM.yyyy")</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(fx.TechnicalServiceName))
                                                {
                                                    <div class="fw-semibold text-dark"><i class="bi bi-tools text-primary me-1"></i>@fx.TechnicalServiceName</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Servis atanmadı</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fx.SupplierName))
                                                {
                                                    <div class="text-muted" style="font-size:0.74rem;">Tedarik: @fx.SupplierName</div>
                                                }
                                            </td>
                                            <td>
                                                @if (!fx.NextMaintenanceDate.HasValue)
                                                {
                                                    <span class="text-muted">Tarih yok</span>
                                                }
                                                else
                                                {
                                                    var daysLeft = (fx.NextMaintenanceDate.Value.Date - DateTime.Today).Days;
                                                    if (daysLeft < 0)
                                                    {
                                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Gecikti (@Math.Abs(daysLeft) gün) • @fx.NextMaintenanceDate.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                    else if (daysLeft <= 30)
                                                    {
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>@daysLeft gün kaldı • @fx.NextMaintenanceDate.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">@fx.NextMaintenanceDate.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @if (docs.Any())
                                                {
                                                    foreach (var doc in docs.Take(2))
                                                    {
                                                        <a href="@doc.DocumentUrl" target="_blank" class="badge bg-light text-primary border text-decoration-none d-inline-block mb-1" title="@doc.FileName">
                                                            <i class="bi bi-file-earmark-pdf me-1"></i>Evrak
                                                        </a>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                                        onclick="openEditFixtureModal(@fx.Id, '@Html.Raw((fx.ItemName ?? "").Replace("'", "\\'"))', '@Html.Raw((fx.Category ?? "Demirbaş").Replace("'", "\\'"))', '@Html.Raw((fx.StandardBrand ?? "").Replace("'", "\\'"))', '@Html.Raw((fx.StandardModel ?? "").Replace("'", "\\'"))', '@fx.Quantity', '@Html.Raw((fx.Unit ?? "Adet").Replace("'", "\\'"))', '@Html.Raw((fx.SupplierName ?? "").Replace("'", "\\'"))', '@Html.Raw((fx.TechnicalServiceName ?? "").Replace("'", "\\'"))', '@(fx.WarrantyExpiryDate?.ToString("yyyy-MM-dd") ?? "")', '@(fx.NextMaintenanceDate?.ToString("yyyy-MM-dd") ?? "")', '@Html.Raw((fx.MaintenanceNotes ?? "").Replace("'", "\\'").Replace("\r", "").Replace("\n", " "))')"
                                                        title="Düzenle / Servis Değiştir / Evrak Yükle">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <form asp-action="DeleteFloorFixture" asp-controller="BuildingManager" method="post" class="d-inline" onsubmit="return confirm('Bu ekipmanı/demirbaşı silmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@Model.Id" />
                                                    <input type="hidden" name="fixtureId" value="@fx.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Sil"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

