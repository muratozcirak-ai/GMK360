                    <small class="text-muted"><i class="bi bi-telephone me-1"></i><span id="modalOwnerPhone">-</span></small>
                </div>

                <!-- Kiracı -->
                <div class="mb-3 p-3 border rounded-3" id="modalTenantBox">
                    <span class="badge bg-info text-dark mb-1">KİRACI (SAKİN)</span>
                    <h6 class="fw-bold text-dark mb-1" id="modalTenantName">-</h6>
                    <small class="text-muted"><i class="bi bi-telephone me-1"></i><span id="modalTenantPhone">-</span></small>
                </div>

                <!-- Dönemsel Cari Geçmişi (ResidencyPeriods) -->
                <div class="mb-3 p-3 border rounded-3 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-dark"><i class="bi bi-clock-history text-primary me-1"></i> Dönemsel İkamet &amp; Mülkiyet Geçmişi</span>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" onclick="openResidencyTransferFromUnit()">
                            <i class="bi bi-arrow-left-right me-1"></i> Taşınma / Devir (Kıstelyevm)
                        </button>
                    </div>
                    <div id="modalResidencyHistory" class="small text-muted">Yükleniyor...</div>
                </div>

                <!-- Daire İçi Özel Demirbaş Mahremiyet Uyarısı -->
                <div class="p-3 bg-warning bg-opacity-10 border border-warning rounded-3 small">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-lock-fill text-warning me-1"></i> Daire İçi Demirbaş Zimmeti (Kombi, Klima vb.):</div>
                    <span class="text-muted">
                        Daire içindeki kombi, ankastre ve sayaç zimmetleri <strong>Mülk Sahibi Özel Alanı</strong>'ndadır. 
                        Ev sahibi kendi portalından kiracısına fotoğraflı teslim tutanağı düzenleyebilir.
                    </span>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- 2. YENİ GİDER / FATURA EKLE MODALI -->
<div class="modal fade" id="newExpenseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-receipt me-2"></i> Gider / Fatura Girişi &amp; İkili Cari Dağıtımı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddExpense" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Fatura Açıklaması <span class="text-danger">*</span></label>
                        <input type="text" name="description" class="form-control" required placeholder="Örn: Asansör Motor Revizyonu veya Kasım Elektriği" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Toplam Tutar (TL) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" name="totalAmount" class="form-control fw-bold text-danger" required placeholder="Örn: 12500" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">İkili Cari Yönlendirme <span class="text-danger">*</span></label>
                        <select name="expenseType" class="form-select fw-bold">
                            <option value="2">💡 İşletme Gideri (Kiracıya, yoksa Malike)</option>
                            <option value="1">🔨 Demirbaş Gideri (Daima Mülk Sahibine + GMSİ)</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Fatura / Belge (GMSİ Arşivi - PDF/Görsel)</label>
                        <input type="file" name="invoiceFile" class="form-control" accept=".pdf,image/*" />
                    </div>
                    <div class="col-12">
                        <small class="text-muted">
                            <i class="bi bi-shield-check me-1 text-success"></i> Fiziksel silme kapalıdır; hatalı girişlerde Ters Kayıt (Reversal) uygulanır. Demirbaş giderleri dairede kiracı olsa dahi doğrudan Mülk Sahibi carisine yazılır.
                        </small>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-check-circle me-1"></i> Faturayı İşle ve İkili Cariye Dağıt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. YENİ DAİRE / DÜKKAN EKLE MODALI -->
<div class="modal fade" id="addUnitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> Bağımsız Bölüm Tanımla</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddUnit" asp-controller="BuildingManager" method="post">
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Bölüm Türü</label>
                        <select name="category" class="form-select">
                            <option value="Daire">🏠 Konut (Daire)</option>
                            <option value="Dukkan">🏪 Zemin Dükkan / Mağaza</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kapı / Daire No <span class="text-danger">*</span></label>
                        <input type="text" name="unitNumber" class="form-control" required placeholder="Örn: Daire 11 veya Dükkan 3" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Ev Sahibi Adı</label>
                        <input type="text" name="ownerName" class="form-control" placeholder="Örn: Kemal Bey" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Ev Sahibi Telefonu</label>
                        <input type="text" name="ownerPhone" class="form-control" placeholder="0532 000 00 00" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kiracı Adı (Varsa)</label>
                        <input type="text" name="tenantName" class="form-control" placeholder="Örn: Selin Hanım" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kiracı Telefonu</label>
                        <input type="text" name="tenantPhone" class="form-control" placeholder="0542 000 00 00" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isEmpty" value="true" id="emptySwitch">
                            <label class="form-check-label fw-bold small" for="emptySwitch">Daire Boş mu?</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-save me-1"></i> Bağımsız Bölümü Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- 4. YENİ GENEL KURUL TOPLANTISI & KARAR EKLE MODALI -->
<div class="modal fade" id="newMeetingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-book-half me-2"></i> Yeni Genel Kurul Kararı Ekle (KMK Md. 32)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateMeeting" asp-controller="BuildingManager" method="post">
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Toplantı Gündemi / Başlığı <span class="text-danger">*</span></label>
                        <input type="text" name="agendaTitle" class="form-control" required placeholder="Örn: 2026/02 Çatı İzolasyonu ve İhale Kararı" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Toplantı Tarihi <span class="text-danger">*</span></label>
                        <input type="date" name="meetingDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Alınan Karar Metni <span class="text-danger">*</span></label>
                        <textarea name="decisionText" class="form-control" rows="4" required placeholder="Örn: Çatı su izolasyonu işi için en uygun teklifi veren Kardelen Çatı firmasına 36.000 TL bedelle ihale edilmesine, daire başına 3.000 TL toplanmasına karar verildi."></textarea>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info border-0 rounded-3 small mb-0">
                            <i class="bi bi-info-circle me-1"></i> Bu karar kaydedildiğinde tek tıkla <strong>Noter Karar Defteri A4 Islak İmza Şablonu</strong> üretilecektir.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-warning fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-save me-1"></i> Kararı Kaydet ve Hazirun Cetveli Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 5. ORTAK ALANA ZİMMETLİ DEMİRBAŞ EKLE MODALI -->
