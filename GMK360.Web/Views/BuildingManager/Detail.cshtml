</div>

<!-- 7. YÖNETİM KURULU / AZA ATAMA & YÖNETİCİ DEVRİ MODALI -->
<div class="modal fade" id="governanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-warning"></i>Yönetim Kurulu (Aza) &amp; Yetki Devri</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="AssignGovernanceMember" asp-controller="BuildingManager" method="post" class="mb-4 pb-3 border-bottom">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@Model.Id" />
                    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-person-plus me-1"></i>Yönetim Kurulu Azası / Denetçi Ekle</h6>
                    <p class="small text-muted mb-2">Çoklu onay güvenliği için binanızdaki kat maliki azaları veya denetçiyi ekleyin.</p>
                    <div class="row g-2">
                        <div class="col-7">
                            <input type="email" name="email" class="form-control form-control-sm" placeholder="Üye e-posta adresi" required />
                        </div>
                        <div class="col-5">
                            <select name="role" class="form-select form-select-sm">
                                <option value="2">Aza (Yönetim Kurulu)</option>
                                <option value="3">Denetçi</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 mt-2 fw-semibold">Kadroya Ekle</button>
                </form>

                <form asp-action="TransferHeadManager" asp-controller="BuildingManager" method="post" onsubmit="return confirm('Ana yöneticilik yetkisini devretmek istediğinize emin misiniz? Tüm bina verileri korunarak yeni yöneticiye geçecektir.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@Model.Id" />
                    <h6 class="fw-bold text-danger mb-2"><i class="bi bi-arrow-left-right me-1"></i>Ana Yöneticiliği Devret</h6>
                    <p class="small text-muted mb-2">Yönetici değiştiğinde bina verileri, kasa ve karar defteri silinmeden yeni yöneticiye aktarılır.</p>
                    <div class="input-group input-group-sm">
                        <input type="email" name="newManagerEmail" class="form-control" placeholder="Yeni yöneticinin GMK360 e-postası" required />
                        <button type="submit" class="btn btn-danger fw-semibold">Yetkiyi Devret</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 8. TAŞINMA / DEVİR (DÖNEMSEL CARİ İZOLASYONU & KISTELYEVM) MODALI -->
<div class="modal fade" id="residencyTransferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-arrow-left-right me-2"></i>Daire Devri / Taşınma &amp; Kıstelyevm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="TransferUnitResidency" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <input type="hidden" name="unitId" id="transferUnitId" value="0" />
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <div class="alert alert-info small py-2 mb-0">
                            <strong id="transferUnitTitle">Daire</strong> için eski dönem <code>ARCHIVED</code> yapılarak PWA yetkisi anında kesilir, yeni sakin <strong>0,00 ₺</strong> temiz cari ile başlar.
                            @if (activeBoardCount >= 2)
                            {
                                <div class="mt-1 fw-semibold text-warning-emphasis">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Eski sakinin ödenmemiş borcu varsa devir otomatik <strong>2 Aza onay kuyruğuna</strong> alınır.
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Devredilen Dönem <span class="text-danger">*</span></label>
                        <select name="roleType" class="form-select form-select-sm fw-semibold">
                            <option value="Tenant">Kiracı Değişimi (Tahliye / Yeni Kiracı)</option>
                            <option value="Owner">Mülkiyet Devri (Satış / Yeni Malik)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Taşınma / Devir Tarihi <span class="text-danger">*</span></label>
                        <input type="date" name="transferDate" id="transferDateInput" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required oninput="updateProrationPreview()" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Yeni Sakin / Malik Adı Soyadı <small class="text-muted">(Boş bırakılırsa Daire Boş işaretlenir)</small></label>
                        <input type="text" name="newFullName" class="form-control form-control-sm" placeholder="Örn: Selin Kaya" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Telefon (İsteğe Bağlı)</label>
                        <input type="text" name="newPhone" class="form-control form-control-sm" placeholder="05XX XXX XX XX" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">E-Posta (GMK360 Erişimi)</label>
                        <input type="email" name="newEmail" class="form-control form-control-sm" placeholder="sakin@ornek.com" />
                    </div>
                    <div class="col-12 border-top pt-2">
                        <label class="form-label fw-bold small">Aylık Aidat Kıstelyevm Bölüşümü (TL - Opsiyonel)</label>
                        <input type="number" step="0.01" min="0" name="monthlyDuesForProration" id="prorationAmountInput" class="form-control form-control-sm" placeholder="Örn: 1500" oninput="updateProrationPreview()" />
                        <div id="prorationPreviewText" class="small text-success mt-1"></div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-primary fw-bold rounded-pill w-100 py-2">
                        <i class="bi bi-check2-circle me-1"></i> Devri Başlat / Kıstelyevm İşle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 9. FATURA TERS KAYIT (REVERSAL) MODALI -->
<div class="modal fade" id="reversalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>Değişmez Defter: Ters Kayıt (İptal)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RequestExpenseReversal" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <input type="hidden" name="expenseId" id="reversalExpenseId" value="0" />
                <div class="modal-body p-4">
                    <div class="alert alert-warning small">
                        <strong id="reversalExpenseSummary">Fatura</strong> fiziksel olarak SİLİNMEZ. Eksi (-) tutarlı Ters Kayıt oluşturularak arşivlenir.
                        @if (activeBoardCount >= 2)
                        {
                            <div class="mt-1 fw-bold">Yönetim kurulunda 2+ Aza bulunduğu için işlem 2 Aza onay kuyruğuna düşecektir.</div>
                        }
                    </div>
                    <label class="form-label fw-bold small">Ters Kayıt / İptal Gerekçesi <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="2" required placeholder="Örn: Yanlış tutar girişi düzeltmesi"></textarea>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill w-100">Ters Kayıt Talebi Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 10. ORTAK ALAN / ARDİYE / BAHÇE KUYUSU EKLEME MODALI -->
<div class="modal fade" id="addCommonSpaceModal" tabindex="-1" aria-hidden="true">
