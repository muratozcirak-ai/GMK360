@{
    var periodsByUnit = residencyPeriods
        .GroupBy(rp => rp.BuildingUnitId)
        .ToDictionary(g => g.Key, g => g.Select(x => new {
            role = x.RoleType == "Owner" ? "Malik" : "Kiracı",
            name = x.FullName,
            status = x.Status,
            start = x.StartDate.ToString("dd.MM.yyyy"),
            end = x.EndDate?.ToString("dd.MM.yyyy")
        }).ToList());
}

<script>
    const unitResidencyMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(periodsByUnit));
    let activeModalUnitId = 0;
    let activeModalDoorNo = '';

    function openUnitModal(id, doorNo, layout, owner, ownerPhone, tenant, tenantPhone, unpaidDebt, isEmpty) {
        activeModalUnitId = id;
        activeModalDoorNo = doorNo || ('Bölüm #' + id);

        document.getElementById('modalUnitTitle').innerHTML = '<i class="bi bi-door-closed me-2"></i> ' + doorNo + ' Detayı';
        document.getElementById('modalRoomLayout').innerText = layout || 'Standart';
        document.getElementById('modalOwnerName').innerText = owner || 'Belirtilmedi';
        document.getElementById('modalOwnerPhone').innerText = ownerPhone || '-';

        var debtEl = document.getElementById('modalDebtStatus');
        if (unpaidDebt > 0) {
            debtEl.innerText = Number(unpaidDebt).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺ Borçlu';
            debtEl.className = 'fw-bold text-danger mb-0';
        } else {
            debtEl.innerText = 'Borcu Yok';
            debtEl.className = 'fw-bold text-success mb-0';
        }

        var tenantBox = document.getElementById('modalTenantBox');
        if (isEmpty) {
            tenantBox.style.display = 'none';
        } else if (tenant && tenant !== '-' && tenant !== '') {
            tenantBox.style.display = 'block';
            document.getElementById('modalTenantName').innerText = tenant;
            document.getElementById('modalTenantPhone').innerText = tenantPhone || '-';
        } else {
            tenantBox.style.display = 'block';
            document.getElementById('modalTenantName').innerText = 'Ev Sahibi Kendisi Oturuyor';
            document.getElementById('modalTenantPhone').innerText = '-';
        }

        const histEl = document.getElementById('modalResidencyHistory');
        const list = unitResidencyMap[id] || unitResidencyMap[String(id)] || [];
        if (list.length === 0) {
            histEl.innerHTML = '<span>Bu bölüm için henüz devir/arşiv geçmişi oluşmadı; mevcut sakin aktif dönem sayılır.</span>';
        } else {
            histEl.innerHTML = list.map(p => {
                const badge = p.status === 'ACTIVE'
                    ? '<span class="badge bg-success me-1">AKTİF</span>'
                    : '<span class="badge bg-secondary me-1">ARŞİV</span>';
                const dates = p.end ? `${p.start} - ${p.end}` : `${p.start} - Günümüz`;
                return `<div class="mb-1">${badge}<strong>${p.role}:</strong> ${p.name} <span class="text-muted">(${dates})</span></div>`;
            }).join('');
        }

        var myModal = new bootstrap.Modal(document.getElementById('unitDetailModal'));
        myModal.show();
    }

    function openResidencyTransferFromUnit() {
        const detailEl = document.getElementById('unitDetailModal');
        const detailInst = bootstrap.Modal.getInstance(detailEl);
        if (detailInst) detailInst.hide();

        document.getElementById('transferUnitId').value = activeModalUnitId;
        document.getElementById('transferUnitTitle').innerText = activeModalDoorNo;
        updateProrationPreview();
        new bootstrap.Modal(document.getElementById('residencyTransferModal')).show();
    }

    function openReversalModal(expenseId, desc, amountText) {
        document.getElementById('reversalExpenseId').value = expenseId;
        document.getElementById('reversalExpenseSummary').innerText = `${desc} (${amountText} ₺)`;
        new bootstrap.Modal(document.getElementById('reversalModal')).show();
    }

    function updateProrationPreview() {
        const amt = parseFloat(document.getElementById('prorationAmountInput').value || '0');
        const dateVal = document.getElementById('transferDateInput').value;
        const out = document.getElementById('prorationPreviewText');
        if (!amt || amt <= 0 || !dateVal) {
            out.innerText = '';
            return;
        }
        const dt = new Date(dateVal + 'T00:00:00');
        const daysInMonth = new Date(dt.getFullYear(), dt.getMonth() + 1, 0).getDate();
        const leavingDays = dt.getDate();
        const enteringDays = Math.max(1, daysInMonth - leavingDays + 1);
        const leavingAmt = ((amt / daysInMonth) * leavingDays).toFixed(2);
        const enteringAmt = ((amt / daysInMonth) * enteringDays).toFixed(2);
        out.innerText = `Kıstelyevm (${daysInMonth} gün): Çıkan sakin ${leavingDays} gün (${leavingAmt} ₺) • Yeni sakin ${enteringDays} gün (${enteringAmt} ₺)`;
    }

    function openFloorUnitModal(floorLevel, floorLabel) {
        const sel = document.getElementById('floorUnitFloorSelect');
        if (sel) {
            const valStr = String(floorLevel);
            if (!Array.from(sel.options).some(o => o.value === valStr)) {
                const opt = document.createElement('option');
                opt.value = valStr;
                opt.text = floorLabel;
                sel.appendChild(opt);
            }
            sel.value = valStr;
        }
        const badge = document.getElementById('floorUnitModalBadge');
        if (badge) badge.innerText = floorLabel;
        new bootstrap.Modal(document.getElementById('addFloorUnitModal')).show();
    }

    function openFloorFixtureModal(unitId, unitTitle) {
        document.getElementById('fixtureTargetUnitId').value = unitId;
        document.getElementById('fixtureTargetUnitTitle').innerText = unitTitle;
        new bootstrap.Modal(document.getElementById('addFloorFixtureModal')).show();
    }
</script>
