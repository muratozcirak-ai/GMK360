                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 7. YÖNETİM KURULU / AZA ATAMA & YÖNETİCİ DEVRİ MODALI -->
<div class="modal fade" id="governanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-warning"></i>Yönetim Kurulu (Aza) &amp; Yetki Devri</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
