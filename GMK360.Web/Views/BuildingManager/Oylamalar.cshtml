@model IEnumerable<GMK360.Core.Entities.SystemMeeting>
@{
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    ViewData["Title"] = "Karar Defteri & Oylama (Noter İkizi)";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    int? selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    var approvals = ViewBag.Approvals as List<GMK360.Core.Entities.ApprovalRequest> ?? new List<GMK360.Core.Entities.ApprovalRequest>();
    var buildingMap = ViewBag.BuildingMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var unitsByBuilding = ViewBag.UnitsByBuilding as Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>> ?? new Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>>();
    var unitsByComplex = ViewBag.UnitsByComplex as Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>> ?? new Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>>();
    var selectedBldObj = ViewBag.SelectedBuildingObj as GMK360.Core.Entities.Building;
    var firstSiteComplex = buildings.FirstOrDefault(b => b.HousingComplexId.HasValue);
    var presetCategory = Context.Request.Query["preset"].ToString();
    var presetUnitId = Context.Request.Query["unitId"].ToString();
    var presetTicketId = Context.Request.Query["ticketId"].ToString();
    var presetProposedDues = Context.Request.Query["proposedDues"].ToString();
    var allSiteUnits = ViewBag.AllSiteUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var openComplaints = ViewBag.OpenComplaints as List<GMK360.Core.Entities.SupportTicket> ?? new List<GMK360.Core.Entities.SupportTicket>();
    var boardRoster = ViewBag.BoardRoster as List<GMK360.Core.Entities.BuildingManager> ?? new List<GMK360.Core.Entities.BuildingManager>();
    var boardPlan = ViewBag.BoardPlan as GMK360.Web.Helpers.KmkBoardPlan ?? new GMK360.Web.Helpers.KmkBoardPlan();
    var scansByMeeting = ViewBag.ScansByMeeting as Dictionary<int, List<GMK360.Core.Entities.DocumentArchive>> ?? new Dictionary<int, List<GMK360.Core.Entities.DocumentArchive>>();
    string defaultChair = ViewBag.DefaultChairpersonName as string ?? "";
    string defaultAzas = ViewBag.DefaultBoardMembersSummary as string ?? "";

    var decisionList = (Model ?? Enumerable.Empty<GMK360.Core.Entities.SystemMeeting>()).ToList();
    int totalBookPages = selectedBldObj?.DecisionBookTotalPages ?? 100;
    if (totalBookPages < 1) totalBookPages = 100;
    var usedPageMap = decisionList
        .Where(x => x.BookPageNumber.HasValue)
        .GroupBy(x => x.BookPageNumber!.Value)
        .ToDictionary(g => g.Key, g => g.First());
    int nextEmptyPage = 1;
    while (usedPageMap.ContainsKey(nextEmptyPage) && nextEmptyPage <= totalBookPages) { nextEmptyPage++; }
    if (ViewBag.NextBookPage is int nbp && !usedPageMap.ContainsKey(nbp)) { nextEmptyPage = nbp; }
    bool openSheetByDefault = !decisionList.Any() || !string.IsNullOrEmpty(presetCategory);
}

<style>
    .notary-paper {
        background: #fffdf7;
        border: 2px solid #1e293b;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.08);
    }
    .notary-head-table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
    }
    .notary-head-table th, .notary-head-table td {
        border: 1.5px solid #334155;
        padding: 8px 10px;
        vertical-align: top;
    }
    .notary-head-table th {
        background: #f1f5f9;
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #1e293b;
        font-weight: 700;
    }
    .notary-ruled-area {
        background-image: repeating-linear-gradient(transparent, transparent 27px, #e2e8f0 27px, #e2e8f0 28px);
        line-height: 28px;
        background-color: #fffef9;
    }
    .participant-grid-row {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        padding: 6px 10px;
    }
</style>

<div class="container-fluid py-3 px-1">
    <!-- Sade Üst Başlık -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-journal-check text-success me-2"></i>Karar Defteri &amp; Oylama (Noter İkizi)</h2>
            <p class="text-muted small mb-0">Belge ve teklif tartışmaları ön toplantıda kalır; burada sadece resmi karar metni, kurul ve katılımcı oylaması aynı defter yaprağında tutulur.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/BuildingManager/MevzuatRehberi?slug=karar-defteri-formu-nasil-doldurulur" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold" title="Form nasıl doldurulur?">
                <i class="bi bi-book-half me-1"></i> Nasıl Doldurulur?
            </a>
            <a href="/BuildingManager/Toplantilar@(selectedBuildingId.HasValue ? $"?buildingId={selectedBuildingId}" : "")" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
                <i class="bi bi-people-fill me-1"></i> Ön Görüşme Toplantıları
            </a>
            @if (selectedBldObj != null)
            {
                <button type="button" class="btn btn-outline-dark rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#decisionBookModal">
                    <i class="bi bi-journal-text me-1"></i> Defter Künyesi
                </button>
            }
            <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" onclick="openLedgerPageForm(@nextEmptyPage)" @(buildings.Any() ? "" : "disabled")>
                <i class="bi bi-journal-plus me-1"></i> Sayfa #@nextEmptyPage Yaz / Karar Aç
            </button>
        </div>
    </div>

    <!-- Fiziksel Noter Defteri Künyesi & 1..N Sayfa Haritası -->
    @if (selectedBldObj != null)
    {
        bool closingDue = selectedBldObj.DecisionBookLastClosingDate == null || selectedBldObj.DecisionBookLastClosingDate.Value.Year < DateTime.Today.Year;
        int usedPagesCount = usedPageMap.Count;
        int remainingPages = Math.Max(0, totalBookPages - usedPagesCount);
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-3">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 mb-2 border-bottom small">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <i class="bi bi-book-half text-primary fs-5"></i>
                        <strong>@selectedBldObj.Name Resmi Noter Defteri:</strong>
                        <span>Noter: <b>@(selectedBldObj.DecisionBookNotaryName ?? "Girilmemiş")</b></span>
                        <span class="text-muted">|</span>
                        <span>Yevmiye: <b>@(selectedBldObj.DecisionBookJournalNo ?? "-")</b></span>
                        <span class="text-muted">|</span>
                        <span>Açılış: <b>@(selectedBldObj.DecisionBookOpenDate?.ToString("dd.MM.yyyy") ?? "-")</b></span>
                        <span class="text-muted">|</span>
                        <span class="badge bg-dark rounded-pill">Toplam @totalBookPages Sayfa</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Kullanılan: @usedPagesCount · Kalan: @remainingPages</span>
                        @if (closingDue)
                        {
                            <span class="badge bg-warning text-dark">Ocak sonuna kadar "Görüldü" kapanışı hatırlatması</span>
                        }
                    </div>
                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#decisionBookModal">Künyeyi Düzenle</button>
                </div>

                <!-- Sayfa Yaprağı Haritası -->
                <div class="d-flex flex-wrap align-items-center gap-1 small">
                    <span class="text-muted fw-bold me-1">Defter Sayfaları:</span>
                    @{
                        int maxChipPage = Math.Min(totalBookPages, Math.Max(12, nextEmptyPage + 6));
                    }
                    @for (int p = 1; p <= maxChipPage; p++)
                    {
                        if (usedPageMap.TryGetValue(p, out var occMeeting))
                        {
                            <a href="#decisionSheet_@occMeeting.Id" class="btn btn-xs @(occMeeting.IsConcluded ? "btn-success" : "btn-warning text-dark") rounded-pill px-2 py-0 fw-bold" title="@occMeeting.AgendaTitle">
                                @(occMeeting.IsConcluded ? "✓" : "🗳️") S.@p
                            </a>
                        }
                        else if (p == nextEmptyPage)
                        {
                            <button type="button" class="btn btn-xs btn-primary rounded-pill px-2 py-0 fw-bold" onclick="openLedgerPageForm(@p)" title="Sıradaki boş sayfayı yaz">
                                📝 S.@p (Sıradaki)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" onclick="openLedgerPageForm(@p)" title="@p. sayfayı aç">
                                S.@p
                            </button>
                        }
                    }
                    @if (totalBookPages > maxChipPage)
                    {
                        <span class="text-muted ms-1">... (@totalBookPages sayfaya kadar)</span>
                    }
                </div>
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (buildings.Count > 1)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-3 bg-white">
            <div class="card-body p-2 px-3">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-md-9">
                        <select name="buildingId" class="form-select form-select-sm">
                            <option value="">Tüm Binalarım / Yerleşke</option>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id" selected="@(selectedBuildingId == b.Id ? "selected" : null)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (approvals.Any(a => a.Status == "PENDING"))
    {
        <div class="card border-warning shadow-sm rounded-4 mb-3 bg-white">
            <div class="card-header bg-warning bg-opacity-10 border-0 p-3 fw-bold text-dark small">
                <i class="bi bi-shield-lock-fill text-warning me-2"></i>Bekleyen Aza Multi-Sig Onayları
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    @foreach (var req in approvals.Where(a => a.Status == "PENDING"))
                    {
                        <div class="col-md-6">
                            <div class="border rounded-3 p-2 px-3 bg-light d-flex justify-content-between align-items-center small">
                                <div>
                                    <span class="badge bg-warning text-dark me-1">@req.RequestType (@req.ApprovalCount/@req.RequiredApprovals)</span>
                                    <span class="fw-semibold">@req.Reason</span>
                                </div>
                                <a href="/BuildingManager/Detail/@req.BuildingId" class="btn btn-xs btn-outline-primary rounded-pill">İncele</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- BİREBİR KAĞIT NOTER KARAR DEFTERİ FORMU (SAYFA ÜZERİNDE YENİ KARAR YAZMA) -->
    @if (buildings.Any())
    {
        <div id="newDecisionSheetCard" class="mb-4 @(openSheetByDefault ? "" : "d-none")">
            <form asp-action="CreateMeeting" asp-controller="BuildingManager" method="post" class="notary-paper p-3 p-md-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnTo" value="Oylamalar" />
                <input type="hidden" name="autoExecuteOnQuorum" value="true" />
                <input type="hidden" name="quorumType" id="newDecQuorumHidden" value="Standard" />
                <input type="hidden" name="buildingId" id="newDecBuildingIdHidden" value="@(selectedBldObj?.Id ?? buildings.First().Id)" />
                <input type="hidden" name="isSiteWide" id="newDecIsSiteWideHidden" value="@(firstSiteComplex != null && buildings.Count > 1 ? "true" : "false")" />

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <span class="badge bg-dark rounded-pill px-3 py-1 me-1">YENİ DEFTER YAPRAĞI</span>
                        <span class="fw-bold text-dark">Resmi Karar Defteri Sayfası Düzenle</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="document.getElementById('newDecisionSheetCard').classList.add('d-none')">
                        <i class="bi bi-chevron-up me-1"></i> Formu Gizle
                    </button>
                </div>

                <!-- 1. ÜST NOTER ÇİZELGESİ (ÖRNEK DEFTERDEKİ TABLO) -->
                <div class="table-responsive mb-3">
                    <table class="notary-head-table">
                        <thead>
                            <tr>
                                <th style="width: 14%;">Karar Sıra &amp; Sayfa No</th>
                                <th colspan="3" style="width: 34%;">Karara Esas Olan Evrak (Varsa)</th>
                                <th style="width: 52%;">Mevzuun Mahiyeti ve Hülâsası (Konu &amp; Kapsam)</th>
                            </tr>
                            <tr>
                                <th class="bg-white text-start fw-normal">
                                    <div class="mb-1">
                                        <small class="text-muted d-block" style="font-size:.7rem;">Sayfa No *</small>
                                        <input type="number" min="1" max="@totalBookPages" name="bookPageNumber" id="newDecPageNoInput" class="form-control form-control-sm fw-bold text-center" value="@nextEmptyPage" />
                                    </div>
                                    <div>
                                        <small class="text-muted d-block" style="font-size:.7rem;">Karar No</small>
                                        <input type="text" name="decisionNumber" class="form-control form-control-sm text-center" placeholder="2026/..." />
                                    </div>
                                </th>
                                <th class="bg-white text-start fw-normal" style="width:11%;">
                                    <small class="text-muted d-block" style="font-size:.7rem;">Tarih</small>
                                    <input type="date" name="sourceDocDate" class="form-control form-control-sm" />
                                </th>
                                <th class="bg-white text-start fw-normal" style="width:11%;">
                                    <small class="text-muted d-block" style="font-size:.7rem;">No</small>
                                    <input type="text" name="sourceDocNumber" class="form-control form-control-sm" placeholder="TPL-01" />
                                </th>
                                <th class="bg-white text-start fw-normal" style="width:12%;">
                                    <small class="text-muted d-block" style="font-size:.7rem;">Nereden Geldi</small>
                                    <input type="text" name="sourceDocSender" class="form-control form-control-sm" placeholder="Kurul / Malik" />
                                </th>
                                <th class="bg-white text-start fw-normal">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <small class="text-muted d-block" style="font-size:.7rem;">Kapsam</small>
                                            <select id="newDecScopeSelect" class="form-select form-select-sm fw-semibold" onchange="syncNewDecisionScope()">
                                                @if (firstSiteComplex != null && buildings.Count > 1)
                                                {
                                                    <option value="SITE:@firstSiteComplex.Id" selected>🌐 @(firstSiteComplex.HousingComplex?.Name ?? "Site Geneli") (Tüm Bloklar)</option>
                                                }
                                                @foreach (var b in buildings)
                                                {
                                                    <option value="BLK:@b.Id" selected="@(firstSiteComplex == null && buildings.Count == 1 ? "selected" : null)">🏢 @(buildings.Count > 1 ? $"Sadece {b.BlockName ?? b.Name}" : b.Name)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted d-block" style="font-size:.7rem;">Konu Türü</small>
                                            <select name="decisionCategory" id="newDecCategorySelect" class="form-select form-select-sm fw-semibold" onchange="onDecisionCategoryChanged()">
                                                <option value="BoardDecision">🏛️ Yönetim Kurulu Kararı (Seviye 1-3 Asil PIN • Salt Çoğunluk)</option>
                                                <option value="General" selected>📝 Genel Yönetim / Kurul Kararı (KMK Md. 30)</option>
                                                <option value="DuesUpdate">💰 Aidat &amp; Bütçe Belirleme (KMK Md. 37)</option>
                                                <option value="AppointManager">🧑‍💼 Yönetici Seçimi (KMK Md. 34)</option>
                                                <option value="AppointBoardMember">🏛️ Aza / Denetçi Seçimi (KMK Md. 41)</option>
                                                <option value="CapitalProject">🛠️ Tadilat / Yatırım Onayı (KMK Md. 42)</option>
                                                <option value="UnitExemption">🛡️ Daire Muafiyeti / Özel Fark (KMK Md. 20)</option>
                                                <option value="ComplaintResolution">📣 Şikayet &amp; Talep Kararı (KMK Md. 18)</option>
                                                <option value="ManagementPlan">📜 Yönetim Planı Değişikliği (KMK Md. 28)</option>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <input type="text" name="agendaTitle" id="newDecAgendaTitle" class="form-control form-control-sm fw-bold" required placeholder="Karar Konusu / Gündem Başlığı * (Örn: 2026 Yılı Aidat ve Çatı Onarım Kararı)" />
                                        </div>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>

                <!-- Seçilen Konuya Özel Sade Detay Satırı (Varsa) -->
                <div id="panelDuesUpdate" class="row g-2 p-2 mb-3 bg-white border rounded-3 d-none">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Yeni Aylık Baz Aidat (₺) *</label>
                        <input type="number" step="0.01" min="0" name="proposedDues" id="inputProposedDues" class="form-control form-control-sm" placeholder="Örn: 1850" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Aylık Ödeme Günü</label>
                        <input type="number" min="1" max="31" name="paymentDay" class="form-control form-control-sm" value="5" />
                    </div>
                </div>

                <div id="panelPersonAppoint" class="row g-2 p-2 mb-3 bg-white border rounded-3 d-none">
                    <div class="col-md-3 d-none" id="wrapTargetRole">
                        <label class="form-label small fw-bold mb-1">Görevi</label>
                        <select name="targetRole" class="form-select form-select-sm">
                            <option value="BoardMember">Yönetim Kurulu Azası</option>
                            <option value="Auditor">Denetçi</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Seçilecek Aday Adı *</label>
                        <input type="text" name="targetName" id="inputTargetName" class="form-control form-control-sm" placeholder="Örn: Mehmet Kaya" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">E-Posta</label>
                        <input type="email" name="targetEmail" id="inputTargetEmail" class="form-control form-control-sm" placeholder="aday@ornek.com" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Telefon</label>
                        <input type="text" name="targetPhone" id="inputTargetPhone" class="form-control form-control-sm" placeholder="05XX..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Dairesi (İsteğe Bağlı)</label>
                        <select name="targetUnitId" id="appointTargetUnitSelect" class="form-select form-select-sm" disabled onchange="prefillCandidateFromUnit(this)">
                            <option value="">-- Bölüm Seçilmedi --</option>
                            @foreach (var su in allSiteUnits)
                            {
                                <option value="@su.Id" data-name="@su.OwnerName" data-email="@su.OwnerEmail" data-phone="@su.OwnerPhone">
                                    @(su.Building?.BlockName ?? su.Building?.Name) • @su.DoorNumber (@(su.OwnerName ?? "Malik Girilmedi"))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Görev Süresince Aidat Muafiyeti (KMK Md. 40)</label>
                        <select name="exemptionMode" id="appointExemptionMode" class="form-select form-select-sm" disabled>
                            <option value="None">Muafiyet Yok</option>
                            <option value="FullExempt">%100 Aidattan Muaf</option>
                            <option value="HalfExempt">%50 İndirimli</option>
                        </select>
                    </div>
                    <input type="hidden" name="additionalCandidates" value="" />
                </div>

                <div id="panelUnitExemption" class="row g-2 p-2 mb-3 bg-white border rounded-3 d-none">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">İlgili Daire / Dükkan *</label>
                        <select name="targetUnitId" id="exemptionUnitSelect" class="form-select form-select-sm" disabled>
                            <option value="">-- Bölüm Seçiniz --</option>
                            @foreach (var su in allSiteUnits)
                            {
                                <option value="@su.Id">@(su.Building?.BlockName ?? su.Building?.Name) • @su.DoorNumber (@(su.OwnerName ?? "Malik"))</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Uygulanacak Karar</label>
                        <select name="exemptionMode" id="unitExemptionModeSelect" class="form-select form-select-sm" disabled onchange="toggleCustomExemptionFields()">
                            <option value="FullExempt">Tam Aidat Muafiyeti (0 ₺)</option>
                            <option value="CustomAdjust">Özel Katsayı / Ek Fark</option>
                            <option value="ClearExemption">Muafiyeti Kaldır</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Gerekçe *</label>
                        <input type="text" name="duesNote" id="inputDuesNote" class="form-control form-control-sm" placeholder="Örn: Giriş kat muafiyeti" />
                    </div>
                    <div class="col-6 d-none" id="wrapExMultiplier">
                        <input type="number" step="0.05" min="0" name="proposedMultiplier" class="form-control form-control-sm" value="1.00" placeholder="Katsayı (1.00)" />
                    </div>
                    <div class="col-6 d-none" id="wrapExAdjustment">
                        <input type="number" step="10" name="proposedAdjustment" class="form-control form-control-sm" placeholder="Ek fark +/- ₺" />
                    </div>
                </div>

                <div id="panelComplaint" class="row g-2 p-2 mb-3 bg-white border rounded-3 d-none">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Bağlı Şikayet Kaydı</label>
                        <select name="relatedTicketId" id="complaintTicketSelect" class="form-select form-select-sm">
                            <option value="">-- Genel Şikayet --</option>
                            @foreach (var tk in openComplaints)
                            {
                                <option value="@tk.Id">#@tk.Id • @tk.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">İlgili Daire</label>
                        <select name="targetUnitId" id="complaintUnitSelect" class="form-select form-select-sm" disabled>
                            <option value="">-- Tüm Site --</option>
                            @foreach (var su in allSiteUnits)
                            {
                                <option value="@su.Id">@(su.Building?.BlockName ?? su.Building?.Name) • @su.DoorNumber</option>
                            }
                        </select>
                    </div>
                </div>

                <div id="panelCapitalProject" class="row g-2 p-2 mb-3 bg-white border rounded-3 d-none">
                    <div class="col-12">
                        <label class="form-label small fw-bold mb-1">Tahmini Yatırım / Tadilat Bütçesi (₺)</label>
                        <input type="number" step="100" min="0" name="estimatedBudget" class="form-control form-control-sm" placeholder="Örn: 85000" />
                    </div>
                </div>

                <!-- 2. ORTA BÖLÜM: KARARIN METNİ & KURUL (OTOMATİK DOLU) -->
                <div class="border border-dark rounded-3 bg-white p-3 mb-3">
                    <div class="text-center fw-bold border-bottom border-dark pb-1 mb-3" style="letter-spacing:0.08em;">KARARIN METNİ</div>

                    <div class="row g-2 mb-3 small">
                        <div class="col-md-3 col-6">
                            <label class="form-label fw-bold mb-1">Karar Tarihi</label>
                            <input type="date" name="meetingDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-2 col-6">
                            <label class="form-label fw-bold mb-1">Başlangıç</label>
                            <input type="time" name="meetingTime" class="form-control form-control-sm" value="20:00" />
                        </div>
                        <div class="col-md-2 col-6">
                            <label class="form-label fw-bold mb-1">Bitiş</label>
                            <input type="time" name="meetingEndTime" class="form-control form-control-sm" value="21:00" />
                        </div>
                        <div class="col-md-5 col-6">
                            <label class="form-label fw-bold mb-1">Toplantı / Karar Yeri</label>
                            <input type="text" name="meetingLocation" class="form-control form-control-sm" value="Site Yönetim Odası / Ortak Alan" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-bold mb-1">
                                Başkanın Adı ve Soyadı
                                <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">Kuruldan Dolu</span>
                            </label>
                            <input type="text" name="chairpersonName" class="form-control form-control-sm fw-semibold" value="@defaultChair" placeholder="Yönetici / Divan Başkanı" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-bold mb-1">
                                Azaların Adı ve Soyadı (Yönetim Kurulu)
                                <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">Kuruldan Dolu</span>
                                @if (string.IsNullOrWhiteSpace(defaultAzas))
                                {
                                    <a href="/BuildingManager/Governance" class="ms-1 text-primary text-decoration-none">(Kuruldan Seç &rarr;)</a>
                                }
                            </label>
                            <input type="text" name="boardMembersSummary" class="form-control form-control-sm fw-semibold" value="@defaultAzas" placeholder="Kurul & Yetkiler'den seçilen azalar otomatik gelir" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small mb-1">Deftere Yazılacak Karar Maddeleri (Boş bırakılırsa seçilen konuya göre otomatik üretilir)</label>
                        <textarea name="decisionText" id="oylDecisionText" class="form-control notary-ruled-area" rows="4" placeholder="1) ... &#10;2) ..."></textarea>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top small">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-dark">Defter İşlem Durumu:</span>
                            <select name="isPlannedOnly" class="form-select form-select-sm w-auto fw-semibold">
                                <option value="true" selected>🗳️ Oylamaya Aç (Sayfada Katılımcılar İşaretlesin)</option>
                                <option value="false">✅ Alınan Karar Olarak Doğrudan Kesinleştir</option>
                            </select>
                        </div>
                        <span class="text-muted" id="decCategoryHint">Kapsam ve konu kuralı otomatik uygulanır.</span>
                    </div>
                </div>

                <!-- 3. ALT BÖLÜM: SAYFA ÜZERİNDE KATILANLAR / OYLAMA LİSTESİ ÖNİZLEMESİ -->
                <div class="border rounded-3 bg-white p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="small text-dark"><i class="bi bi-people-fill text-primary me-1"></i>Sayfaya Açılacak Katılımcılar &amp; İmza / Oylama Cetveli (<span id="previewVoterCount">0</span> Kat Maliki)</strong>
                        <small class="text-muted">Sayfa açıldığında oylama ve imza sütunu doğrudan bu isimlerin yanında görünür.</small>
                    </div>
                    <div id="previewParticipantsGrid" class="row g-2 small"></div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" onclick="document.getElementById('newDecisionSheetCard').classList.add('d-none')">İptal</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Defter Sayfasını Aç &amp; Kaydet
                    </button>
                </div>
            </form>
        </div>
    }

    <!-- KAYITLI RESMİ KARAR DEFTERİ YAPRAKLARI (HER ŞEY AYNI SAYFA ÜSTÜNDE) -->
    @if (!decisionList.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 text-center text-muted small">
            <i class="bi bi-journal-bookmark fs-2 d-block mb-1"></i>
            Yukarıdaki resmi defter sayfasını doldurup kaydettiğinizde, tüm oylama ve katılımcı imza cetveli sayfa üzerinde burada yerini alacaktır.
        </div>
    }
    else
    {
        foreach (var m in decisionList)
        {
            var bName = buildingMap.ContainsKey(m.ContextId) ? buildingMap[m.ContextId] : ("Bina #" + m.ContextId);
            var bUnits = (m.IsSiteWide && m.HousingComplexId.HasValue && unitsByComplex.ContainsKey(m.HousingComplexId.Value))
                ? unitsByComplex[m.HousingComplexId.Value]
                : (unitsByBuilding.ContainsKey(m.ContextId) ? unitsByBuilding[m.ContextId] : new List<GMK360.Core.Entities.BuildingUnit>());
            var meetingBld = buildings.FirstOrDefault(b => b.Id == m.ContextId);
            string scopeDisplayName = (m.IsSiteWide && meetingBld?.HousingComplex != null)
                ? $"{meetingBld.HousingComplex.Name} (Site Geneli)"
                : bName;
            var quorum = string.Equals(m.QuorumType, "BoardMajority", StringComparison.OrdinalIgnoreCase)
                ? GMK360.Web.Helpers.KmkQuorumHelper.ComputeBoardMajority(boardRoster, m.BoardVotes)
                : GMK360.Web.Helpers.KmkQuorumHelper.Compute(bUnits, m.Votes, m.QuorumType);
            bool isBoardDecision = string.Equals(m.QuorumType, "BoardMajority", StringComparison.OrdinalIgnoreCase);
            bool isPrintableReady = m.IsConcluded || quorum.IsQuorumMet;
            var mScans = scansByMeeting.TryGetValue(m.Id, out var scList) ? scList : new List<GMK360.Core.Entities.DocumentArchive>();
            var mVotes = (m.Votes ?? new List<GMK360.Core.Entities.BuildingDecisionVote>()).Where(v => !v.IsDeleted).ToDictionary(v => v.BuildingUnitId, v => v);
            var mBoardVotes = (m.BoardVotes ?? new List<GMK360.Core.Entities.BoardDecisionVote>()).Where(v => !v.IsDeleted).GroupBy(v => v.BuildingManagerId).ToDictionary(g => g.Key, g => g.First());
            string chairToShow = !string.IsNullOrWhiteSpace(m.ChairpersonName) ? m.ChairpersonName! : (string.IsNullOrWhiteSpace(defaultChair) ? "-" : defaultChair);
            string azaToShow = !string.IsNullOrWhiteSpace(m.BoardMembersSummary) ? m.BoardMembersSummary! : (string.IsNullOrWhiteSpace(defaultAzas) ? "-" : defaultAzas);

            <div id="decisionSheet_@m.Id" class="notary-paper p-3 p-md-4 mb-4">
                <!-- Üst Araç Çubuğu -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <span class="badge bg-primary rounded-pill">Sayfa #@(m.BookPageNumber ?? m.Id)</span>
                        <span class="badge bg-dark rounded-pill">Karar #@(m.DecisionNumber ?? m.Id.ToString("D2"))</span>
                        @if (isPrintableReady)
                        {
                            <span class="badge bg-success rounded-pill">✅ Kesinleşti / Yazdırılabilir (@quorum.ApprovedUnits/@quorum.RequiredUnitCount)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark rounded-pill">⏳ Onay Bekliyor (@quorum.ApprovedUnits/@quorum.RequiredUnitCount)</span>
                        }
                        <span class="badge bg-light text-dark border rounded-pill">@scopeDisplayName</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @if (!m.IsConcluded)
                        {
                            <form asp-action="SendMeetingCallReminders" asp-controller="BuildingManager" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="meetingId" value="@m.Id" />
                                <input type="hidden" name="buildingId" value="@m.ContextId" />
                                <button type="submit" class="btn btn-xs btn-outline-primary rounded-pill px-3 fw-semibold" title="Kat maliklerine / kurula oylama çağrısı gönder">
                                    <i class="bi bi-envelope-paper me-1"></i> Çağrı Gönder
                                </button>
                            </form>
                        }
                        @if (isPrintableReady)
                        {
                            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id&format=a4" target="_blank" class="btn btn-xs btn-success rounded-pill px-3 fw-bold">
                                <i class="bi bi-printer me-1"></i> A4 Noter Çıktısı (Yazdırılabilir)
                            </a>
                            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id&format=a5" target="_blank" class="btn btn-xs btn-outline-dark rounded-pill px-3 fw-semibold">
                                <i class="bi bi-scissors me-1"></i> A5 Yapıştırma
                            </a>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill py-1 px-3 align-self-center" title="Salt çoğunluk sağlanmadan resmi çıktı kilidi açılmaz">
                                <i class="bi bi-lock-fill me-1"></i>Yazdırma Kilitli (@quorum.ApprovedUnits/@quorum.RequiredUnitCount)
                            </span>
                            <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id&format=a4" target="_blank" class="btn btn-xs btn-outline-secondary rounded-pill px-2" title="Önizleme taslağı">
                                Taslak Önizle
                            </a>
                        }
                    </div>
                </div>

                <!-- 1. Üst Resmi Noter Tablosu -->
                <div class="table-responsive mb-2">
                    <table class="notary-head-table">
                        <thead>
                            <tr>
                                <th style="width:13%;">Karar Sıra No</th>
                                <th colspan="3" style="width:33%;">Karara Esas Olan Evrakın</th>
                                <th style="width:54%;">Mevzuun Mahiyeti ve Hülâsası</th>
                            </tr>
                            <tr>
                                <th class="bg-white">@(m.DecisionNumber ?? $"#{m.Id:D2}") <span class="text-muted fw-normal d-block">Sayfa @(m.BookPageNumber ?? m.Id)</span></th>
                                <th class="bg-white fw-normal">@(m.SourceDocDate?.ToString("dd.MM.yyyy") ?? "-")</th>
                                <th class="bg-white fw-normal">@(m.SourceDocNumber ?? "-")</th>
                                <th class="bg-white fw-normal">@(m.SourceDocSender ?? "-")</th>
                                <th class="bg-white text-start">
                                    <span class="fw-bold text-dark">@m.AgendaTitle</span>
                                    <span class="badge bg-light text-dark border ms-1">@quorum.RuleLabel</span>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>

                <!-- 2. Kararın Metni & Yönetim Kurulu -->
                <div class="border border-dark rounded-3 bg-white p-3 mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom pb-2 mb-2 small">
                        <div>
                            <strong>Başkan:</strong> @chairToShow
                            <span class="mx-2 text-muted">|</span>
                            <strong>Azalar:</strong> @azaToShow
                        </div>
                        <div class="text-muted">
                            <strong>Tarih:</strong> @m.MeetingDate.ToString("dd.MM.yyyy")
                            <strong>Saat:</strong> @m.MeetingDate.ToString("HH:mm")@(!string.IsNullOrWhiteSpace(m.MeetingEndTime) ? $" – {m.MeetingEndTime}" : "")
                            @if (!string.IsNullOrWhiteSpace(m.MeetingLocation))
                            {
                                <span class="ms-2"><strong>Yer:</strong> @m.MeetingLocation</span>
                            }
                        </div>
                    </div>

                    <div class="notary-ruled-area p-2 px-3 rounded border mb-2 small">
                        @if (m.Decisions != null && m.Decisions.Any())
                        {
                            int dIdx = 1;
                            foreach (var dec in m.Decisions)
                            {
                                <div class="mb-1"><strong>@dIdx)</strong> @dec.DecisionText</div>
                                dIdx++;
                            }
                        }
                        else
                        {
                            <div class="text-muted">Karar metni oylama sonunda buraya işlenecektir.</div>
                        }
                    </div>

                    @if (!m.IsConcluded)
                    {
                        <form asp-action="ConcludeMeetingWithDecision" asp-controller="BuildingManager" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="meetingId" value="@m.Id" />
                            <input type="hidden" name="buildingId" value="@m.ContextId" />
                            <input type="hidden" name="returnTo" value="Oylamalar" />
                            <div class="input-group input-group-sm">
                                <input type="text" name="decisionText" class="form-control" required placeholder="Alınan nihai kararı deftere işleyip kapatın..." />
                                <button type="submit" class="btn @(quorum.IsQuorumMet ? "btn-success" : "btn-secondary") fw-bold px-3" @(quorum.IsQuorumMet ? "" : "disabled")
                                        title="@(quorum.IsQuorumMet ? "Kararı kesinleştir" : $"Onay Bekliyor ({quorum.ApprovedUnits}/{quorum.RequiredUnitCount}): Çoğunluk sağlanmadan kesinleştirilemez")">
                                    @(quorum.IsQuorumMet ? "Kararı Deftere İşle & Kapat" : $"⏳ Onay Bekliyor ({quorum.ApprovedUnits}/{quorum.RequiredUnitCount})")
                                </button>
                            </div>
                        </form>
                    }
                </div>

                <!-- 3. AYNI SAYFA ÜZERİNDE KATILANLAR, OYLAMA & İMZA CETVELİ -->
                <div class="border rounded-3 bg-white p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 small">
                        <div>
                            @if (isBoardDecision)
                            {
                                <strong class="text-dark"><i class="bi bi-shield-check text-primary me-1"></i>Yönetim Kurulu Asil Üye (Seviye 1-3) PIN Oylaması (@quorum.ApprovedUnits / @quorum.TotalUnits Onay):</strong>
                                <span class="ms-2 text-danger fw-bold">@quorum.RejectedUnits Ret</span>
                            }
                            else
                            {
                                <strong class="text-dark"><i class="bi bi-people-fill text-success me-1"></i>Katılanlar, Oylama &amp; İmzalar (@quorum.ParticipatedUnits / @quorum.TotalUnits Malik):</strong>
                                <span class="ms-2 text-success fw-bold">@quorum.ApprovedUnits Kabul</span> <span>/</span>
                                <span class="text-danger fw-bold">@quorum.RejectedUnits Ret</span>
                                <span class="text-muted">(Sayı: %@quorum.ApprovalUnitPercent • Arsa Payı: %@quorum.ApprovalSharePercent)</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(quorum.IsQuorumMet ? "bg-success" : "bg-warning text-dark")">
                                @(quorum.IsQuorumMet ? "✅ Yeter Sayı Sağlandı / Yazdırılabilir" : $"⏳ Onay Bekliyor ({quorum.ApprovedUnits}/{quorum.RequiredUnitCount})")
                            </span>
                            @if (m.IsExecuted && !string.IsNullOrWhiteSpace(m.ExecutionSummary))
                            {
                                <span class="badge bg-primary">⚡ Yürürlükte: @m.ExecutionSummary</span>
                            }
                            else if (!isBoardDecision && quorum.IsQuorumMet && !m.IsExecuted)
                            {
                                <form asp-action="ExecuteApprovedDecision" asp-controller="BuildingManager" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                    <input type="hidden" name="buildingId" value="@m.ContextId" />
                                    <button type="submit" class="btn btn-xs btn-success rounded-pill px-3 fw-bold">⚡ Kararı Yürürlüğe Al</button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="progress mb-3" style="height: 6px;">
                        <div class="progress-bar @(quorum.IsQuorumMet ? "bg-success" : "bg-primary")" style="width: @(Math.Min(100m, quorum.ApprovalUnitPercent).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>

                    @if (isBoardDecision)
                    {
                        <!-- YÖNETİM KURULU KARARI: SEVIYE 1-3 ASİL ÜYE PIN OYLAMASI -->
                        <div class="row g-2 small">
                            @foreach (var bm in boardRoster.OrderBy(x => GMK360.Core.Entities.BuildingManager.GetHierarchyLevel(x.Role)).ThenBy(x => x.HierarchyOrder))
                            {
                                bool canVote = bm.CanVoteBoardDecisions();
                                int lvl = GMK360.Core.Entities.BuildingManager.GetHierarchyLevel(bm.Role);
                                string bmNm = !string.IsNullOrWhiteSpace(bm.User?.FirstName) ? $"{bm.User.FirstName} {bm.User.LastName}".Trim() : (bm.User?.DisplayName ?? bm.User?.Email ?? "Kurul Üyesi");
                                mBoardVotes.TryGetValue(bm.Id, out var bmv);
                                <div class="col-lg-6">
                                    <div class="participant-grid-row">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <span class="badge bg-dark me-1">S@lvl</span>
                                                <span class="fw-bold text-dark">@bmNm</span>
                                                <span class="text-muted">(@GMK360.Core.Entities.BuildingManager.GetRoleLabel(bm.Role))</span>
                                            </div>
                                            <div>
                                                @if (!canVote)
                                                {
                                                    <span class="badge bg-light text-muted border">@(bm.IsTermExpired() ? "Süresi Doldu (Kilitli)" : "Oy Hakkı Yok")</span>
                                                }
                                                else if (bmv?.VoteChoice == "Kabul")
                                                {
                                                    <span class="badge bg-success">✅ Onaylandı (@bmv.ApprovalTraceCode)</span>
                                                }
                                                else if (bmv?.VoteChoice == "Ret")
                                                {
                                                    <span class="badge bg-danger">❌ Muhalif (@bmv.ApprovalTraceCode)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">Onay Bekliyor</span>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(bmv?.DissentNote))
                                        {
                                            <div class="text-danger mt-1" style="font-size:.74rem;"><strong>Karşı Oy Şerhi:</strong> @bmv.DissentNote</div>
                                        }
                                        @if (!m.IsConcluded && canVote)
                                        {
                                            <div class="d-flex flex-wrap gap-1 align-items-center mt-2 pt-1 border-top">
                                                <form asp-action="SubmitBoardMemberVote" asp-controller="BuildingManager" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@m.ContextId" />
                                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                                    <input type="hidden" name="buildingManagerId" value="@bm.Id" />
                                                    <input type="hidden" name="voteChoice" value="Kabul" />
                                                    <button type="submit" class="btn btn-xs btn-outline-success rounded-pill px-2 fw-bold">✓ Onayla</button>
                                                </form>
                                                <form asp-action="SubmitBoardMemberVote" asp-controller="BuildingManager" method="post" class="d-flex gap-1 flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@m.ContextId" />
                                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                                    <input type="hidden" name="buildingManagerId" value="@bm.Id" />
                                                    <input type="hidden" name="voteChoice" value="Ret" />
                                                    <input type="text" name="dissentNote" class="form-control form-control-sm py-0" value="@bmv?.DissentNote" placeholder="Karşı oy gerekçesi..." style="font-size:.74rem;" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger rounded-pill px-2 text-nowrap">✕ Ret</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {

                    <!-- 2 Sütunlu Defter Katılımcı & Oylama Listesi (Fotoğraf 2 Formatı) -->
                    <div class="row g-2 small">
                        @{ int rowNo = 1; }
                        @foreach (var u in bUnits)
                        {
                            mVotes.TryGetValue(u.Id, out var uv);
                            string bShort = buildings.Count > 1 && u.Building != null ? $"{u.Building.BlockName ?? u.Building.Name} · " : "";
                            string ownerLabel = !string.IsNullOrWhiteSpace(u.OwnerName) ? u.OwnerName : "Malik Girilmemiş";
                            <div class="col-lg-6">
                                <div class="participant-grid-row d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <span class="fw-bold text-muted me-1">@rowNo)</span>
                                        <span class="fw-bold text-dark">@ownerLabel</span>
                                        <span class="text-muted">(@bShort@u.DoorNumber)</span>
                                        @if (uv?.ParticipationType == "Vekil" && !string.IsNullOrWhiteSpace(uv.ProxyPersonName))
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border ms-1">Vekil: @uv.ProxyPersonName</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (uv?.VoteChoice == "Kabul")
                                        {
                                            <span class="badge bg-success">✅ Kabul @(!string.IsNullOrWhiteSpace(uv.ApprovalTraceCode) ? $"({uv.ApprovalTraceCode})" : "")</span>
                                        }
                                        else if (uv?.VoteChoice == "Ret")
                                        {
                                            <span class="badge bg-danger" title="@uv.DissentNote">❌ Ret</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Bekliyor</span>
                                        }

                                        @if (!m.IsConcluded)
                                        {
                                            <form asp-action="AssignUnitProxyVote" asp-controller="BuildingManager" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="buildingId" value="@m.ContextId" />
                                                <input type="hidden" name="meetingId" value="@m.Id" />
                                                <input type="hidden" name="buildingUnitId" value="@u.Id" />
                                                <input type="hidden" name="participationType" value="Asil" />
                                                <input type="hidden" name="voteChoice" value="Kabul" />
                                                <button type="submit" class="btn btn-xs btn-outline-success py-0 px-2" title="Asil Kabul İşaretle">✓</button>
                                            </form>
                                            <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2" title="Karşı Oy / Şerh Girerek Ret İşaretle"
                                                    onclick="document.getElementById('dissentBox_@(m.Id)_@(u.Id)').classList.toggle('d-none')">✕</button>
                                            <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2"
                                                    onclick="openAssignProxyModal(@m.ContextId, @m.Id, @u.Id, '@System.Web.HttpUtility.JavaScriptStringEncode($"{u.DoorNumber} ({ownerLabel})")', '@System.Web.HttpUtility.JavaScriptStringEncode(uv?.ProxyPersonName ?? u.TenantName ?? "")')">
                                                Vekil
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(uv?.DissentNote))
                                {
                                    <div class="px-2 pt-1 text-danger" style="font-size:.73rem;"><strong>Muhalefet Şerhi:</strong> @uv.DissentNote</div>
                                }
                                @if (!m.IsConcluded)
                                {
                                    <form asp-action="AssignUnitProxyVote" asp-controller="BuildingManager" method="post" id="dissentBox_@(m.Id)_@(u.Id)" class="d-none mt-1 d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="buildingId" value="@m.ContextId" />
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <input type="hidden" name="buildingUnitId" value="@u.Id" />
                                        <input type="hidden" name="participationType" value="Asil" />
                                        <input type="hidden" name="voteChoice" value="Ret" />
                                        <input type="text" name="dissentNote" class="form-control form-control-sm py-0" value="@uv?.DissentNote" placeholder="Karşı oy gerekçesi / şerh yazın (isteğe bağlı)..." style="font-size:.74rem;" />
                                        <button type="submit" class="btn btn-xs btn-danger text-nowrap px-2">Ret Kaydet</button>
                                    </form>
                                }
                            </div>
                            rowNo++;
                        }
                    </div>
                    }

                    <!-- 4. ISLAK İMZALI NOTER DEFTERİ SURETİ YÜKLE & DİJİTAL ARŞİV -->
                    <div class="mt-3 pt-2 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <strong class="text-dark"><i class="bi bi-camera-fill text-success me-1"></i>Islak İmzalı Defter Sureti:</strong>
                            @if (mScans.Any())
                            {
                                foreach (var sc in mScans)
                                {
                                    <a href="@sc.DocumentUrl" target="_blank" class="badge bg-success-subtle text-success border border-success-subtle text-decoration-none py-1 px-2">
                                        <i class="bi bi-file-earmark-check me-1"></i>@sc.FileName (@sc.UploadDate.ToString("dd.MM.yyyy"))
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Noter sayfasına yapıştırıp imzaladıktan sonra fotoğrafını/PDF'ini yükleyin.</span>
                            }
                        </div>
                        <form asp-action="UploadMeetingScan" asp-controller="BuildingManager" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="meetingId" value="@m.Id" />
                            <input type="hidden" name="returnTo" value="Oylamalar" />
                            <input type="file" name="scanFile" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" style="max-width:210px;" required />
                            <button type="submit" class="btn btn-xs btn-outline-success rounded-pill px-3 fw-bold text-nowrap">
                                <i class="bi bi-cloud-upload me-1"></i>Suret Yükle
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (buildings.Any())
{
    @* Vekil Atama / Yazılı Vekalet & Temsil Modalı *@
    <div class="modal fade" id="assignProxyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="AssignUnitProxyVote" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" id="pxBuildingId" />
                <input type="hidden" name="meetingId" id="pxMeetingId" />
                <input type="hidden" name="buildingUnitId" id="pxUnitId" />
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-badge me-2"></i>Vekil / Katılım (<span id="pxUnitLabel"></span>)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Katılım Şekli</label>
                        <select name="participationType" class="form-select">
                            <option value="Vekil" selected>Vekil (Yazılı Vekaletle Kiracı / Yakını)</option>
                            <option value="Asil">Asil (Malik Kendisi)</option>
                            <option value="Katilmadi">Katılmadı</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Vekil Adı Soyadı</label>
                        <input type="text" name="proxyPersonName" id="pxPersonName" class="form-control" placeholder="Örn: Caner Yılmaz (Kiracı)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Yazılı Vekaletname (Opsiyonel)</label>
                        <input type="file" name="proxyDocumentFile" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Oy Kararı (Opsiyonel)</label>
                        <select name="voteChoice" class="form-select">
                            <option value="">Vekil kendi ekranından oylasın</option>
                            <option value="Kabul">Kabul (Ön Onay)</option>
                            <option value="Ret">Ret</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    @if (selectedBldObj != null)
    {
        <div class="modal fade" id="decisionBookModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content rounded-4 border-0 shadow" asp-action="SaveDecisionBookMetadata" asp-controller="BuildingManager" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@selectedBldObj.Id" />
                    <div class="modal-header bg-dark text-white border-0">
                        <h5 class="modal-title fw-bold"><i class="bi bi-journal-bookmark me-2"></i>@selectedBldObj.Name — Noter Defteri Künyesi</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4 row g-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-bold">Noterlik Adı</label>
                            <input type="text" name="notaryName" class="form-control" value="@selectedBldObj.DecisionBookNotaryName" placeholder="Örn: Bostancı 4. Noterliği" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-bold">Yevmiye / Tasdik No</label>
                            <input type="text" name="journalNo" class="form-control" value="@selectedBldObj.DecisionBookJournalNo" placeholder="Örn: 2026/2650" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Açılış Tasdik Tarihi</label>
                            <input type="date" name="openDate" class="form-control" value="@(selectedBldObj.DecisionBookOpenDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Son Ocak Kapanış ("Görüldü")</label>
                            <input type="date" name="lastClosingDate" class="form-control" value="@(selectedBldObj.DecisionBookLastClosingDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Defter Sayfa Sayısı</label>
                            <input type="number" name="totalPages" class="form-control" value="@selectedBldObj.DecisionBookTotalPages" placeholder="150" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light">
                        <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold">Künyeyi Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <script>
        const allVoterUnitsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allSiteUnits.Select(u => new {
            id = u.Id,
            buildingId = u.BuildingId,
            blockName = u.Building != null ? (u.Building.BlockName ?? u.Building.Name) : "",
            door = u.DoorNumber,
            owner = !string.IsNullOrWhiteSpace(u.OwnerName) ? u.OwnerName : "Malik Girilmemiş"
        })));
        const activeBoardVotersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            boardRoster.Where(m => m.CanVoteBoardDecisions())
                .OrderBy(m => GMK360.Core.Entities.BuildingManager.GetHierarchyLevel(m.Role))
                .ThenBy(m => m.HierarchyOrder)
                .Select(m => new {
                    name = !string.IsNullOrWhiteSpace(m.User?.FirstName) ? $"{m.User.FirstName} {m.User.LastName}".Trim() : (m.User?.DisplayName ?? m.User?.Email ?? "Kurul Üyesi"),
                    roleTitle = GMK360.Core.Entities.BuildingManager.GetRoleLabel(m.Role),
                    level = GMK360.Core.Entities.BuildingManager.GetHierarchyLevel(m.Role)
                })));

        function renderPreviewParticipants() {
            const scopeVal = document.getElementById('newDecScopeSelect')?.value || '';
            const catVal = document.getElementById('newDecCategorySelect')?.value || '';
            const grid = document.getElementById('previewParticipantsGrid');
            const cntEl = document.getElementById('previewVoterCount');
            if (!grid) return;

            if (catVal === 'BoardDecision') {
                if (cntEl) cntEl.innerText = activeBoardVotersData.length + ' Kurul Asil Üyesi';
                if (activeBoardVotersData.length === 0) {
                    grid.innerHTML = '<div class="col-12 text-warning fw-semibold">Aktif ve süresi dolmamış Seviye 1-3 Kurul Üyesi bulunmuyor. Yönetim Kurulundan atama yapın.</div>';
                    return;
                }
                const needReq = Math.floor(activeBoardVotersData.length / 2) + 1;
                grid.innerHTML = activeBoardVotersData.map((b, i) =>
                    `<div class="col-md-6"><div class="participant-grid-row d-flex justify-content-between align-items-center"><span><b>S${b.level})</b> ${escapeVoterHtml(b.name)} <span class="text-muted">(${escapeVoterHtml(b.roleTitle)})</span></span><span class="badge bg-primary-subtle text-primary border">Salt Çoğunluk: ${needReq}/${activeBoardVotersData.length}</span></div></div>`
                ).join('');
                return;
            }

            let filtered = allVoterUnitsData;
            if (scopeVal.startsWith('BLK:')) {
                const bid = parseInt(scopeVal.split(':')[1] || '0', 10);
                filtered = allVoterUnitsData.filter(u => u.buildingId === bid);
            }
            if (cntEl) cntEl.innerText = filtered.length;

            if (filtered.length === 0) {
                grid.innerHTML = '<div class="col-12 text-muted">Bu kapsamda henüz kayıtlı kat maliki bulunmuyor.</div>';
                return;
            }
            const showBlock = filtered.some(x => x.buildingId !== filtered[0].buildingId);
            grid.innerHTML = filtered.map((u, i) => {
                const bPart = showBlock && u.blockName ? (u.blockName + ' · ') : '';
                return `<div class="col-md-6"><div class="participant-grid-row d-flex justify-content-between align-items-center"><span><b>${i + 1})</b> ${escapeVoterHtml(u.owner)} <span class="text-muted">(${escapeVoterHtml(bPart + u.door)})</span></span><span class="badge bg-light text-muted border">Oy / İmza Bekliyor</span></div></div>`;
            }).join('');
        }

        function escapeVoterHtml(s) {
            return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function openLedgerPageForm(pageNo) {
            const card = document.getElementById('newDecisionSheetCard');
            const pInp = document.getElementById('newDecPageNoInput');
            if (pInp && pageNo) pInp.value = pageNo;
            if (card) {
                card.classList.remove('d-none');
                card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            renderPreviewParticipants();
        }

        function syncNewDecisionScope() {
            const sel = document.getElementById('newDecScopeSelect');
            const bEl = document.getElementById('newDecBuildingIdHidden');
            const swEl = document.getElementById('newDecIsSiteWideHidden');
            if (!sel || !bEl || !swEl) return;
            const parts = (sel.value || '').split(':');
            if (parts.length === 2) {
                bEl.value = parts[1];
                swEl.value = parts[0] === 'SITE' ? 'true' : 'false';
            }
            renderPreviewParticipants();
        }

        function openAssignProxyModal(bId, mId, uId, unitLabel, suggestedProxy) {
            document.getElementById('pxBuildingId').value = bId;
            document.getElementById('pxMeetingId').value = mId;
            document.getElementById('pxUnitId').value = uId;
            document.getElementById('pxUnitLabel').innerText = unitLabel;
            document.getElementById('pxPersonName').value = suggestedProxy || '';
            new bootstrap.Modal(document.getElementById('assignProxyModal')).show();
        }

        function prefillCandidateFromUnit(sel) {
            const opt = sel?.options?.[sel.selectedIndex];
            if (!opt || !opt.value) return;
            const n = opt.getAttribute('data-name') || '';
            const e = opt.getAttribute('data-email') || '';
            const p = opt.getAttribute('data-phone') || '';
            if (n && !document.getElementById('inputTargetName').value.trim()) document.getElementById('inputTargetName').value = n;
            if (e && !document.getElementById('inputTargetEmail').value.trim()) document.getElementById('inputTargetEmail').value = e;
            if (p && !document.getElementById('inputTargetPhone').value.trim()) document.getElementById('inputTargetPhone').value = p;
        }

        function toggleCustomExemptionFields() {
            const m = document.getElementById('unitExemptionModeSelect')?.value || 'FullExempt';
            const showCustom = (m === 'CustomAdjust');
            document.getElementById('wrapExMultiplier')?.classList.toggle('d-none', !showCustom);
            document.getElementById('wrapExAdjustment')?.classList.toggle('d-none', !showCustom);
        }

        function onDecisionCategoryChanged() {
            const cat = document.getElementById('newDecCategorySelect')?.value || 'General';
            const duesPanel = document.getElementById('panelDuesUpdate');
            const personPanel = document.getElementById('panelPersonAppoint');
            const roleWrap = document.getElementById('wrapTargetRole');
            const exPanel = document.getElementById('panelUnitExemption');
            const compPanel = document.getElementById('panelComplaint');
            const capPanel = document.getElementById('panelCapitalProject');
            const quorumHidden = document.getElementById('newDecQuorumHidden');
            const titleEl = document.getElementById('newDecAgendaTitle');
            const hintEl = document.getElementById('decCategoryHint');

            const appointUnitSel = document.getElementById('appointTargetUnitSelect');
            const appointExMode = document.getElementById('appointExemptionMode');
            const exUnitSel = document.getElementById('exemptionUnitSelect');
            const exModeSel = document.getElementById('unitExemptionModeSelect');
            const compUnitSel = document.getElementById('complaintUnitSelect');

            duesPanel?.classList.add('d-none');
            personPanel?.classList.add('d-none');
            roleWrap?.classList.add('d-none');
            exPanel?.classList.add('d-none');
            compPanel?.classList.add('d-none');
            capPanel?.classList.add('d-none');

            if (appointUnitSel) appointUnitSel.disabled = true;
            if (appointExMode) appointExMode.disabled = true;
            if (exUnitSel) exUnitSel.disabled = true;
            if (exModeSel) exModeSel.disabled = true;
            if (compUnitSel) compUnitSel.disabled = true;

            const duesInput = document.getElementById('inputProposedDues');
            const nameInput = document.getElementById('inputTargetName');
            if (duesInput) duesInput.required = false;
            if (nameInput) nameInput.required = false;
            if (exUnitSel) exUnitSel.required = false;

            if (cat === 'BoardDecision') {
                if (quorumHidden) quorumHidden.value = 'BoardMajority';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Yönetim Kurulu Kararı';
                if (hintEl) hintEl.textContent = 'Yönetim Kurulu Asil Üyeleri (Seviye 1-3) PIN oylaması: Salt çoğunluk (AktifAsil/2)+1 sağlandığında yazdırılabilir.';
            } else if (cat === 'DuesUpdate') {
                duesPanel?.classList.remove('d-none');
                if (duesInput) duesInput.required = true;
                if (quorumHidden) quorumHidden.value = 'Innovation';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Aylık Baz Aidat & İşletme Bütçesi Belirlenmesi';
                if (hintEl) hintEl.textContent = 'KMK Md. 37: Çoğunluk sağlandığında yeni baz aidat otomatik yürürlüğe girer.';
            } else if (cat === 'AppointManager') {
                personPanel?.classList.remove('d-none');
                if (appointUnitSel) appointUnitSel.disabled = false;
                if (appointExMode) appointExMode.disabled = false;
                if (nameInput) nameInput.required = true;
                if (quorumHidden) quorumHidden.value = 'Innovation';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Yeni Site / Apartman Yöneticisi Seçimi Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 34: Sayı ve arsa payı çoğunluğu (>%50) ile seçilir.';
            } else if (cat === 'AppointBoardMember') {
                personPanel?.classList.remove('d-none');
                roleWrap?.classList.remove('d-none');
                if (appointUnitSel) appointUnitSel.disabled = false;
                if (appointExMode) appointExMode.disabled = false;
                if (nameInput) nameInput.required = true;
                if (quorumHidden) quorumHidden.value = 'Innovation';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Yönetim Kurulu Azası / Denetçi Seçimi Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 34/41: Kurul azası / denetçi atama kararıdır.';
            } else if (cat === 'UnitExemption') {
                exPanel?.classList.remove('d-none');
                if (exUnitSel) { exUnitSel.disabled = false; exUnitSel.required = true; }
                if (exModeSel) exModeSel.disabled = false;
                toggleCustomExemptionFields();
                if (quorumHidden) quorumHidden.value = 'Unanimous';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Bağımsız Bölüm Aidat Muafiyeti / Özel Fark Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 20: Oy birliği (%100) ile uygulanır.';
            } else if (cat === 'ComplaintResolution') {
                compPanel?.classList.remove('d-none');
                if (compUnitSel) compUnitSel.disabled = false;
                if (quorumHidden) quorumHidden.value = 'Standard';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Malik / Kiracı Talep & Şikayet Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 18/30: Salt çoğunluk ile karara bağlanır.';
            } else if (cat === 'CapitalProject') {
                capPanel?.classList.remove('d-none');
                if (quorumHidden) quorumHidden.value = 'Innovation';
                if (hintEl) hintEl.textContent = 'KMK Md. 42: Sayı ve arsa payı çoğunluğu ile kabul edilir.';
            } else if (cat === 'ManagementPlan') {
                if (quorumHidden) quorumHidden.value = 'ManagementPlan';
                if (hintEl) hintEl.textContent = 'KMK Md. 28: Kat maliklerinin 4/5 (%80) oyu aranır.';
            } else {
                if (quorumHidden) quorumHidden.value = 'Standard';
                if (hintEl) hintEl.textContent = 'KMK Md. 30: Salt çoğunluk ile karara bağlanır.';
            }
            renderPreviewParticipants();
        }

        document.addEventListener('DOMContentLoaded', function () {
            renderPreviewParticipants();

            const preset = '@System.Web.HttpUtility.JavaScriptStringEncode(presetCategory ?? "")';
            const presetUnit = '@System.Web.HttpUtility.JavaScriptStringEncode(presetUnitId ?? "")';
            const presetTicket = '@System.Web.HttpUtility.JavaScriptStringEncode(presetTicketId ?? "")';
            const presetDues = '@System.Web.HttpUtility.JavaScriptStringEncode(presetProposedDues ?? "")';
            if (preset) {
                const catSel = document.getElementById('newDecCategorySelect');
                if (catSel) {
                    catSel.value = preset;
                    onDecisionCategoryChanged();
                    if (presetDues && preset === 'DuesUpdate') {
                        const di = document.getElementById('inputProposedDues');
                        if (di) di.value = presetDues;
                    }
                    if (presetUnit) {
                        if (preset === 'UnitExemption') {
                            const s = document.getElementById('exemptionUnitSelect');
                            if (s) s.value = presetUnit;
                        } else if (preset === 'ComplaintResolution') {
                            const s = document.getElementById('complaintUnitSelect');
                            if (s) s.value = presetUnit;
                        } else if (preset === 'AppointManager' || preset === 'AppointBoardMember') {
                            const s = document.getElementById('appointTargetUnitSelect');
                            if (s) { s.value = presetUnit; prefillCandidateFromUnit(s); }
                        }
                    }
                    if (presetTicket) {
                        const tk = document.getElementById('complaintTicketSelect');
                        if (tk) tk.value = presetTicket;
                    }
                    openLedgerPageForm(@nextEmptyPage);
                }
            }
        });
    </script>
}
