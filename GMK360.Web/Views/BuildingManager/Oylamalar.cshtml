    @if (selectedBldObj != null)
    {
        <div class="modal fade" id="decisionBookModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content rounded-4 border-0 shadow" asp-action="SaveDecisionBookMetadata" asp-controller="BuildingManager" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@selectedBldObj.Id" />
                    <div class="modal-header bg-dark text-white border-0">
                        <h5 class="modal-title fw-bold"><i class="bi bi-journal-bookmark me-2"></i>@selectedBldObj.Name — Noter Defteri Künyesi</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4 row g-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-bold">Noterlik Adı</label>
                            <input type="text" name="notaryName" class="form-control" value="@selectedBldObj.DecisionBookNotaryName" placeholder="Örn: Kadıköy 12. Noterliği" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-bold">Yevmiye / Tasdik No</label>
                            <input type="text" name="journalNo" class="form-control" value="@selectedBldObj.DecisionBookJournalNo" placeholder="Örn: 2026/1458" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Açılış Tasdik Tarihi</label>
                            <input type="date" name="openDate" class="form-control" value="@(selectedBldObj.DecisionBookOpenDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Son Ocak Kapanış ("Görüldü")</label>
                            <input type="date" name="lastClosingDate" class="form-control" value="@(selectedBldObj.DecisionBookLastClosingDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Defter Sayfa Sayısı</label>
                            <input type="number" name="totalPages" class="form-control" value="@selectedBldObj.DecisionBookTotalPages" placeholder="100" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light">
                        <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold">Künyeyi Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @* Karar Sonrası Yetkili / Usta PIN Hesabı Açma Modalı *@
    <div class="modal fade" id="decisionPinModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="GrantDecisionPinAccess" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" id="dpMeetingId" />
                <input type="hidden" name="buildingId" id="dpBuildingId" />
                <div class="modal-header bg-info text-dark border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-key me-2"></i>Karar Yetkilisi / Usta PIN Hesabı Aç</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border small mb-3">
                        <strong id="dpAgendaLabel"></strong> kararı kapsamında saha takibi veya yüklenici yetkisi verilecek kişiye geçici şifre / aktivasyon daveti oluşturulur. Kişi ilk girişinde kendi kalıcı şifresini ve kişisel PIN kodunu kendisi belirleyecektir.
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Ad Soyad *</label>
                            <input type="text" name="fullName" class="form-control" required placeholder="Örn: Ahmet Yılmaz" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Yetki / Görev *</label>
                            <select name="roleTitle" class="form-select" required>
                                <option value="Yüklenici / Usta Yetkilisi">Yüklenici / Usta Yetkilisi</option>
                                <option value="Kat Maliki Karar Denetçisi">Kat Maliki Karar Denetçisi</option>
                                <option value="Teknik Kontrol / Şef">Teknik Kontrol / Şef</option>
                                <option value="Satınalma Yetkilisi">Satınalma Yetkilisi</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Telefon Numarası *</label>
                            <input type="text" name="phoneNumber" class="form-control" required placeholder="05XX XXX XX XX" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">E-Posta Adresi (Davet İçin)</label>
                            <input type="email" name="email" class="form-control" placeholder="ornek@mail.com" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-info text-dark rounded-pill px-4 fw-bold">Yetki &amp; İlk Giriş Daveti Oluştur</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function syncNewDecisionScope() {
            const sel = document.getElementById('newDecScopeSelect');
            const bEl = document.getElementById('newDecBuildingIdHidden');
            const swEl = document.getElementById('newDecIsSiteWideHidden');
            if (!sel || !bEl || !swEl) return;
            const parts = (sel.value || '').split(':');
            if (parts.length === 2) {
                bEl.value = parts[1];
                swEl.value = parts[0] === 'SITE' ? 'true' : 'false';
            }
        }

        function openAssignProxyModal(bId, mId, uId, unitLabel, suggestedProxy) {
            document.getElementById('pxBuildingId').value = bId;
            document.getElementById('pxMeetingId').value = mId;
            document.getElementById('pxUnitId').value = uId;
            document.getElementById('pxUnitLabel').innerText = unitLabel;
            document.getElementById('pxPersonName').value = suggestedProxy || '';
            new bootstrap.Modal(document.getElementById('assignProxyModal')).show();
        }

        document.getElementById('marketplaceJobModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('mpMeetingId').value = btn.getAttribute('data-meeting-id') || '';
            document.getElementById('mpBuildingId').value = btn.getAttribute('data-building-id') || '';
            document.getElementById('mpTitle').value = btn.getAttribute('data-title') || '';
        });

        document.getElementById('decisionPinModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('dpMeetingId').value = btn.getAttribute('data-meeting-id') || '';
            document.getElementById('dpBuildingId').value = btn.getAttribute('data-building-id') || '';
            document.getElementById('dpAgendaLabel').textContent = btn.getAttribute('data-title') || '';
        });

        function prefillCandidateFromUnit(sel) {
            const opt = sel?.options?.[sel.selectedIndex];
            if (!opt || !opt.value) return;
            const n = opt.getAttribute('data-name') || '';
            const e = opt.getAttribute('data-email') || '';
            const p = opt.getAttribute('data-phone') || '';
            if (n && !document.getElementById('inputTargetName').value.trim()) document.getElementById('inputTargetName').value = n;
            if (e && !document.getElementById('inputTargetEmail').value.trim()) document.getElementById('inputTargetEmail').value = e;
            if (p && !document.getElementById('inputTargetPhone').value.trim()) document.getElementById('inputTargetPhone').value = p;
        }

        function toggleCustomExemptionFields() {
            const m = document.getElementById('unitExemptionModeSelect')?.value || 'FullExempt';
            const showCustom = (m === 'CustomAdjust');
            document.getElementById('wrapExMultiplier')?.classList.toggle('d-none', !showCustom);
            document.getElementById('wrapExAdjustment')?.classList.toggle('d-none', !showCustom);
        }

        function onDecisionCategoryChanged() {
            const cat = document.getElementById('newDecCategorySelect')?.value || 'General';
            const duesPanel = document.getElementById('panelDuesUpdate');
            const personPanel = document.getElementById('panelPersonAppoint');
            const roleWrap = document.getElementById('wrapTargetRole');
            const exPanel = document.getElementById('panelUnitExemption');
            const compPanel = document.getElementById('panelComplaint');
            const capPanel = document.getElementById('panelCapitalProject');
            const quorumSel = document.getElementById('newDecQuorumSelect');
            const titleEl = document.getElementById('newDecAgendaTitle');
            const hintEl = document.getElementById('decCategoryHint');

            const appointUnitSel = document.getElementById('appointTargetUnitSelect');
            const appointExMode = document.getElementById('appointExemptionMode');
            const exUnitSel = document.getElementById('exemptionUnitSelect');
            const exModeSel = document.getElementById('unitExemptionModeSelect');
            const compUnitSel = document.getElementById('complaintUnitSelect');

            duesPanel?.classList.add('d-none');
            personPanel?.classList.add('d-none');
            roleWrap?.classList.add('d-none');
            exPanel?.classList.add('d-none');
            compPanel?.classList.add('d-none');
            capPanel?.classList.add('d-none');

            if (appointUnitSel) appointUnitSel.disabled = true;
            if (appointExMode) appointExMode.disabled = true;
            if (exUnitSel) exUnitSel.disabled = true;
            if (exModeSel) exModeSel.disabled = true;
            if (compUnitSel) compUnitSel.disabled = true;

            const duesInput = document.getElementById('inputProposedDues');
            const nameInput = document.getElementById('inputTargetName');
            if (duesInput) duesInput.required = false;
            if (nameInput) nameInput.required = false;
            if (exUnitSel) exUnitSel.required = false;

            if (cat === 'DuesUpdate') {
                duesPanel?.classList.remove('d-none');
                if (duesInput) duesInput.required = true;
                if (quorumSel) quorumSel.value = 'Innovation';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Aylık Baz Aidat & İşletme Bütçesi Belirlenmesi';
                if (hintEl) hintEl.textContent = 'KMK Md. 37: Kat malikleri çoğunluğu sağlandığı anda yeni baz aidat otomatik aktif edilir.';
            } else if (cat === 'AppointManager') {
                personPanel?.classList.remove('d-none');
                if (appointUnitSel) appointUnitSel.disabled = false;
                if (appointExMode) appointExMode.disabled = false;
                if (nameInput) nameInput.required = true;
                if (quorumSel) quorumSel.value = 'Innovation';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Yeni Site / Apartman Yöneticisi Atama Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 34/40: Salt çoğunluk (>%50 sayı+pay) sağlandığında yönetici atanır ve seçilmişse görev muafiyeti uygulanır.';
            } else if (cat === 'AppointBoardMember') {
                personPanel?.classList.remove('d-none');
                roleWrap?.classList.remove('d-none');
                if (appointUnitSel) appointUnitSel.disabled = false;
                if (appointExMode) appointExMode.disabled = false;
                if (nameInput) nameInput.required = true;
                if (quorumSel) quorumSel.value = 'Innovation';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Yönetim Kurulu Azası / Denetçi Seçimi Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 34/40/41: Çoğunluk sağlandığında aday Kurul Üyesi / Aza atanır ve seçilmişse görev muafiyeti uygulanır.';
            } else if (cat === 'UnitExemption') {
                exPanel?.classList.remove('d-none');
                if (exUnitSel) { exUnitSel.disabled = false; exUnitSel.required = true; }
                if (exModeSel) exModeSel.disabled = false;
                toggleCustomExemptionFields();
                if (quorumSel) quorumSel.value = 'Unanimous';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Bağımsız Bölüm Aidat Muafiyeti / Özel Fark Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 20: Daire/Dükkan aidat muafiyeti veya özel katsayı kararları oy birliği (%100) ile yürürlüğe alınır.';
            } else if (cat === 'ComplaintResolution') {
                compPanel?.classList.remove('d-none');
                if (compUnitSel) compUnitSel.disabled = false;
                if (quorumSel) quorumSel.value = 'Standard';
                if (titleEl && !titleEl.value.trim()) titleEl.value = 'Malik / Kiracı Şikayet & Talep Değerlendirme Kararı';
                if (hintEl) hintEl.textContent = 'KMK Md. 18/30: Malik veya kiracı şikayetleri genel kurul oylamasıyla karara bağlanır ve iş planına aktarılır.';
            } else if (cat === 'CapitalProject') {
                capPanel?.classList.remove('d-none');
                if (quorumSel) quorumSel.value = 'Innovation';
                if (hintEl) hintEl.textContent = 'KMK Md. 42: Onaylandığında bütçesiyle birlikte Yönetici İş Planına eklenir.';
            } else if (cat === 'ManagementPlan') {
                if (quorumSel) quorumSel.value = 'ManagementPlan';
                if (hintEl) hintEl.textContent = 'KMK Md. 28: Yönetim planı değişiklikleri için kat maliklerinin 4/5 (%80) oyu aranır.';
            } else {
                if (quorumSel) quorumSel.value = 'Standard';
                if (hintEl) hintEl.textContent = 'KMK Md. 30: Genel kararlar toplantı/katılım çoğunluğu ile karara bağlanır ve iş planına eklenir.';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const preset = '@System.Web.HttpUtility.JavaScriptStringEncode(presetCategory ?? "")';
            const presetUnit = '@System.Web.HttpUtility.JavaScriptStringEncode(presetUnitId ?? "")';
            const presetTicket = '@System.Web.HttpUtility.JavaScriptStringEncode(presetTicketId ?? "")';
            if (preset) {
                const catSel = document.getElementById('newDecCategorySelect');
                if (catSel) {
                    catSel.value = preset;
                    onDecisionCategoryChanged();
                    if (presetUnit) {
                        if (preset === 'UnitExemption') {
                            const s = document.getElementById('exemptionUnitSelect');
                            if (s) s.value = presetUnit;
                        } else if (preset === 'ComplaintResolution') {
                            const s = document.getElementById('complaintUnitSelect');
                            if (s) s.value = presetUnit;
                        } else if (preset === 'AppointManager' || preset === 'AppointBoardMember') {
                            const s = document.getElementById('appointTargetUnitSelect');
                            if (s) { s.value = presetUnit; prefillCandidateFromUnit(s); }
                        }
                    }
                    if (presetTicket) {
                        const tk = document.getElementById('complaintTicketSelect');
                        if (tk) tk.value = presetTicket;
                    }
                    const modalEl = document.getElementById('newDecisionModal');
                    if (modalEl && typeof bootstrap !== 'undefined') {
                        new bootstrap.Modal(modalEl).show();
                    }
                }
            }
        });
    </script>
}
