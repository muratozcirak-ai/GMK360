@model IEnumerable<GMK360.Core.Entities.SystemMeeting>
@{
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    ViewData["Title"] = "Toplantı & Karar Masası";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    int? selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    var approvals = ViewBag.Approvals as List<GMK360.Core.Entities.ApprovalRequest> ?? new List<GMK360.Core.Entities.ApprovalRequest>();
    var buildingMap = ViewBag.BuildingMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var quotesByMeeting = ViewBag.QuotesByMeeting as Dictionary<int, List<GMK360.Core.Entities.B2B.B2BQuoteRequest>> ?? new Dictionary<int, List<GMK360.Core.Entities.B2B.B2BQuoteRequest>>();
    var jobsByMeeting = ViewBag.JobsByMeeting as Dictionary<int, List<GMK360.Core.Entities.Marketplace.MarketplaceJob>> ?? new Dictionary<int, List<GMK360.Core.Entities.Marketplace.MarketplaceJob>>();
    var staffsByMeeting = ViewBag.StaffsByMeeting as Dictionary<int, List<GMK360.Core.Entities.BuildingStaff>> ?? new Dictionary<int, List<GMK360.Core.Entities.BuildingStaff>>();
    var unitsByBuilding = ViewBag.UnitsByBuilding as Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>> ?? new Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>>();
    var unitsByComplex = ViewBag.UnitsByComplex as Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>> ?? new Dictionary<int, List<GMK360.Core.Entities.BuildingUnit>>();
    var selectedBldObj = ViewBag.SelectedBuildingObj as GMK360.Core.Entities.Building;
    var firstSiteComplex = buildings.FirstOrDefault(b => b.HousingComplexId.HasValue);
    var presetCategory = Context.Request.Query["preset"].ToString();
    var presetUnitId = Context.Request.Query["unitId"].ToString();
    var presetTicketId = Context.Request.Query["ticketId"].ToString();
    var allSiteUnits = ViewBag.AllSiteUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var openComplaints = ViewBag.OpenComplaints as List<GMK360.Core.Entities.SupportTicket> ?? new List<GMK360.Core.Entities.SupportTicket>();
}

<div class="container-fluid py-3 px-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-patch-check text-success me-2"></i>Toplantı &amp; Karar Masası</h2>
            <p class="text-muted small mb-0">Uzaktan belge/görüş &amp; PIN'siz ön onay mutabakatı, KMK çoğunluk hesabı ve Noter Defteri A4/A5 çıktı akışı</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (selectedBldObj != null)
            {
                <button class="btn btn-outline-dark rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#decisionBookModal">
                    <i class="bi bi-journal-text me-1"></i> Noter Defteri Künyesi
                </button>
            }
            <button class="btn btn-success rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#newDecisionModal" @(buildings.Any() ? "" : "disabled")>
                <i class="bi bi-plus-circle me-1"></i> Yeni Toplantı / Karar Ekle
            </button>
        </div>
    </div>

    @if (selectedBldObj != null)
    {
        bool closingDue = selectedBldObj.DecisionBookLastClosingDate == null || selectedBldObj.DecisionBookLastClosingDate.Value.Year < DateTime.Today.Year;
        <div class="alert @(closingDue && DateTime.Today.Month == 1 ? "alert-warning" : "alert-light border") rounded-4 shadow-sm mb-3 py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
            <div>
                <i class="bi bi-book-half text-primary me-1"></i>
                <strong>@selectedBldObj.Name Fiziksel Noter Defteri:</strong>
                Noter: <b>@(selectedBldObj.DecisionBookNotaryName ?? "Girilmemiş")</b> |
                Yevmiye No: <b>@(selectedBldObj.DecisionBookJournalNo ?? "-")</b> |
                Açılış: <b>@(selectedBldObj.DecisionBookOpenDate?.ToString("dd.MM.yyyy") ?? "-")</b> |
                Son Ocak Kapanış ("Görüldü"): <b>@(selectedBldObj.DecisionBookLastClosingDate?.ToString("dd.MM.yyyy") ?? "Bekleniyor")</b>
                @if (closingDue)
                {
                    <span class="badge bg-warning text-dark ms-1">Ocak sonuna kadar noter "Görüldü" kapanışı hatırlatması</span>
                }
            </div>
            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#decisionBookModal">Düzenle</button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <select name="buildingId" class="form-select">
                        <option value="">Tüm Binalarım</option>
                        @foreach (var b in buildings)
                        {
                            if (selectedBuildingId == b.Id)
                            {
                                <option value="@b.Id" selected>@b.Name</option>
                            }
                            else
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-secondary w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    @if (approvals.Any())
    {
        <div class="card border-warning shadow-sm rounded-4 mb-4">
            <div class="card-header bg-warning bg-opacity-10 border-0 p-3 fw-bold text-dark">
                <i class="bi bi-shield-lock-fill text-warning me-2"></i>2 Aza Multi-Sig Onay Talepleri (@approvals.Count)
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    @foreach (var req in approvals)
                    {
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 bg-white d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @(req.Status == "PENDING" ? "bg-warning text-dark" : req.Status == "EXECUTED" ? "bg-success" : "bg-danger") mb-1">
                                        @req.RequestType • @req.Status (@req.ApprovalCount/@req.RequiredApprovals)
                                    </span>
                                    <div class="small fw-semibold">@req.Reason</div>
                                    <small class="text-muted">@req.Building?.Name • @req.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                @if (req.Status == "PENDING")
                                {
                                    <a href="/BuildingManager/Detail/@req.BuildingId" class="btn btn-sm btn-outline-primary rounded-pill">Binada İncele</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-header bg-white border-bottom p-3 fw-bold text-dark">
            <i class="bi bi-journal-bookmark text-primary me-2"></i>Genel Kurul Toplantıları &amp; Alınan Kararlar
        </div>
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-book fs-1 d-block mb-2"></i>
                    Henüz kayıtlı toplantı veya karar bulunmuyor.
                </div>
            }
            else
            {
                foreach (var m in Model)
                {
                    var bName = buildingMap.ContainsKey(m.ContextId) ? buildingMap[m.ContextId] : ("Bina #" + m.ContextId);
                    var linkedQuotes = quotesByMeeting.ContainsKey(m.Id) ? quotesByMeeting[m.Id] : new List<GMK360.Core.Entities.B2B.B2BQuoteRequest>();
                    var linkedJobs = jobsByMeeting.ContainsKey(m.Id) ? jobsByMeeting[m.Id] : new List<GMK360.Core.Entities.Marketplace.MarketplaceJob>();
                    var linkedStaffs = staffsByMeeting.ContainsKey(m.Id) ? staffsByMeeting[m.Id] : new List<GMK360.Core.Entities.BuildingStaff>();
                    var bUnits = (m.IsSiteWide && m.HousingComplexId.HasValue && unitsByComplex.ContainsKey(m.HousingComplexId.Value))
                        ? unitsByComplex[m.HousingComplexId.Value]
                        : (unitsByBuilding.ContainsKey(m.ContextId) ? unitsByBuilding[m.ContextId] : new List<GMK360.Core.Entities.BuildingUnit>());
                    var meetingBld = buildings.FirstOrDefault(b => b.Id == m.ContextId);
                    string scopeDisplayName = (m.IsSiteWide && meetingBld?.HousingComplex != null)
                        ? $"🌐 {meetingBld.HousingComplex.Name} (Site Geneli)"
                        : bName;
                    var quorum = GMK360.Web.Helpers.KmkQuorumHelper.Compute(bUnits, m.Votes, m.QuorumType);
                    var mVotes = (m.Votes ?? new List<GMK360.Core.Entities.BuildingDecisionVote>()).Where(v => !v.IsDeleted).ToDictionary(v => v.BuildingUnitId, v => v);
                    var mAttachments = (m.Attachments ?? new List<GMK360.Core.Entities.BuildingDecisionAttachment>()).Where(a => !a.IsDeleted).OrderByDescending(a => a.CreatedAt).ToList();
                    <div class="border rounded-4 p-3 @(m.IsConcluded ? "bg-light" : "bg-warning bg-opacity-10 border-warning") mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <span class="badge bg-dark rounded-pill me-1">Karar #@(m.DecisionNumber ?? m.Id.ToString("D2"))</span>
                                @if (!m.IsConcluded)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill me-1">📅 Ön Görüş &amp; Onay Aşaması</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill me-1">✅ Karara Bağlandı</span>
                                }
                                <span class="badge bg-secondary bg-opacity-25 text-dark rounded-pill me-2">@scopeDisplayName</span>
                                <span class="fw-bold text-dark fs-5">@m.AgendaTitle</span>
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-calendar3 me-1"></i>@m.MeetingDate.ToString("dd MMMM yyyy HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(m.MeetingLocation))
                                    {
                                        <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>@m.MeetingLocation</span>
                                    }
                                    <span class="ms-2 badge bg-white text-dark border">@quorum.RuleLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(m.DecisionCategory) && m.DecisionCategory != "General")
                                    {
                                        var catBadge = m.DecisionCategory switch
                                        {
                                            "DuesUpdate" => "💰 Aidat Belirleme",
                                            "AppointManager" => "🧑‍💼 Yönetici Atama",
                                            "AppointBoardMember" => "🏛️ Aza / Denetçi Seçimi",
                                            "UnitExemption" => "🛡️ Daire Muafiyet / Ek Fark",
                                            "ComplaintResolution" => "📣 Şikayet & Talep Kararı",
                                            "CapitalProject" => "🛠️ Yenilik / Yatırım",
                                            "ManagementPlan" => "📜 Yönetim Planı",
                                            _ => m.DecisionCategory
                                        };
                                        <span class="ms-1 badge bg-info text-dark">@catBadge</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id&format=a4" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                    <i class="bi bi-printer me-1"></i> A4 Noter Şablonu
                                </a>
                                <a href="/BuildingManager/PrintDecisionSheet?meetingId=@m.Id&format=a5" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                    <i class="bi bi-scissors me-1"></i> A5 Yapıştırma
                                </a>
                            </div>
                        </div>

                        <div class="bg-white rounded-3 border p-2 px-3 mb-2 small">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                <span>
                                    <strong>KMK Ön Onay Durumu:</strong>
                                    <span class="text-success fw-bold">@quorum.ApprovedUnits Kabul</span> /
                                    <span class="text-danger fw-bold">@quorum.RejectedUnits Ret</span>
                                    (@quorum.TotalUnits Kat Maliki içinde <b>%@quorum.ApprovalUnitPercent</b> • Arsa Payı: <b>%@quorum.ApprovalSharePercent</b>)
                                </span>
                                <span class="badge @(quorum.IsQuorumMet ? "bg-success" : "bg-warning text-dark")">
                                    @(quorum.IsQuorumMet ? "✅ Yasal Çoğunluk Sağlandı (İmza Çıktısı Alınabilir)" : $"⏳ Yasal Hedef: En az {quorum.RequiredUnitCount} Malik")
                                </span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(quorum.IsQuorumMet ? "bg-success" : "bg-primary")" style="width: @(Math.Min(100m, quorum.ApprovalUnitPercent).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            @if (m.IsExecuted && !string.IsNullOrWhiteSpace(m.ExecutionSummary))
                            {
                                <div class="alert alert-success py-1 px-2 mt-2 mb-0 small d-flex align-items-center gap-2">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <span><strong>Yürürlüğe Alındı:</strong> @m.ExecutionSummary</span>
                                </div>
                            }
                            else if (quorum.IsQuorumMet && !m.IsExecuted)
                            {
                                <div class="mt-2 d-flex justify-content-between align-items-center gap-2">
                                    <span class="text-success fw-semibold"><i class="bi bi-check2-all me-1"></i>Salt çoğunluk oranı yakalandı! Kararı sisteme uygulayabilirsiniz.</span>
                                    <form asp-action="ExecuteApprovedDecision" asp-controller="BuildingManager" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <input type="hidden" name="buildingId" value="@m.ContextId" />
                                        <button type="submit" class="btn btn-xs btn-success rounded-pill px-3 fw-bold">
                                            ⚡ Kararı Şimdi Yürürlüğe Al
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                        @if (m.Decisions != null && m.Decisions.Any())
                        {
                            <div class="bg-white rounded-3 border p-3 small mb-2">
                                @foreach (var dec in m.Decisions)
                                {
                                    <div class="mb-1"><i class="bi bi-check2-circle text-success me-1"></i>@dec.DecisionText</div>
                                }
                            </div>
                        }
                        @if (!m.IsConcluded)
                        {
                            <form asp-action="ConcludeMeetingWithDecision" asp-controller="BuildingManager" method="post" class="bg-white rounded-3 border p-2 mb-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="meetingId" value="@m.Id" />
                                <input type="hidden" name="buildingId" value="@m.ContextId" />
                                <input type="hidden" name="returnTo" value="Oylamalar" />
                                <div class="input-group input-group-sm">
                                    <input type="text" name="decisionText" class="form-control" required placeholder="Toplantıda alınan kararı yazıp Noter Defterine kaydedin..." />
                                    <button type="submit" class="btn btn-success fw-bold">Karara Bağla</button>
                                </div>
                            </form>
                        }

                        @* Bağlı Pazar Yeri, B2B Teklif ve PIN Yetkileri *@
                        @if (linkedJobs.Any() || linkedQuotes.Any() || linkedStaffs.Any())
                        {
                            <div class="bg-white rounded-3 border p-2 px-3 mb-2 small d-flex flex-column gap-2">
                                @foreach (var job in linkedJobs)
                                {
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="badge bg-warning text-dark rounded-pill me-1">📢 Pazar Yeri İlanı #@job.Id</span>
                                            <span class="fw-semibold">@job.Title</span>
                                            <span class="text-muted ms-2">(@(job.Bids?.Count ?? 0) teklif@(job.EstimatedBudget.HasValue ? $" • Bütçe: {job.EstimatedBudget.Value:N0} ₺" : ""))</span>
                                        </div>
                                        <a href="/Marketplace/Detail/@job.Id" class="btn btn-sm btn-outline-warning text-dark fw-bold rounded-pill px-3">
                                            İlana Git &amp; Teklifleri Gör <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                }
                                @foreach (var quote in linkedQuotes)
                                {
                                    var inviteCount = quote.Invites?.Count ?? 0;
                                    var pricedCount = quote.Invites?.Count(i => i.OfferedPrice.HasValue && i.OfferedPrice.Value > 0) ?? 0;
                                    var acceptedInvite = quote.Invites?.FirstOrDefault(i => i.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Accepted);
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="badge bg-primary rounded-pill me-1">📊 B2B Teklif Masası #@quote.Id</span>
                                            <span class="text-muted">@inviteCount firma daveti • <strong>@pricedCount fiyat geldi</strong></span>
                                            @if (acceptedInvite != null)
                                            {
                                                <span class="badge bg-success ms-1">✅ Onaylı: @(acceptedInvite.NetworkContact?.CompanyName ?? "Firma") (@(acceptedInvite.OfferedPrice?.ToString("N0") ?? "0") ₺)</span>
                                            }
                                        </div>
                                        <a href="/B2BPurchasing/Details/@quote.Id" class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3">
                                            Teklif Kıyasla &amp; Dış Link Paylaş <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                }
                                @foreach (var st in linkedStaffs)
                                {
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="badge bg-info text-dark rounded-pill me-1">🔑 PIN Yetkilisi</span>
                                            <span class="fw-semibold">@st.FullName</span>
                                            <span class="text-muted ms-1">(@st.RoleType)</span>
                                            <span class="badge bg-light text-dark border ms-1">@st.PhoneNumber</span>
                                        </div>
                                        <span class="text-success small fw-semibold">/FacilityPortal girişi aktif</span>
                                    </div>
                                }
                            </div>
                        }

                        @* Karar Sonrası Satınalma & Yetkilendirme Aksiyonları *@
                        <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                            <button type="button"
                                    class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#marketplaceJobModal"
                                    data-meeting-id="@m.Id"
                                    data-building-id="@m.ContextId"
                                    data-title="@($"{bName} — {m.AgendaTitle}")">
                                <i class="bi bi-megaphone me-1"></i> Pazar Yerinde İlan Aç
                            </button>

                            <form asp-action="OpenB2BQuoteFromMeeting" asp-controller="BuildingManager" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="meetingId" value="@m.Id" />
                                <input type="hidden" name="buildingId" value="@m.ContextId" />
                                <input type="hidden" name="title" value="@($"{bName} — {m.AgendaTitle}")" />
                                <button type="submit" class="btn btn-sm btn-primary fw-bold rounded-pill px-3">
                                    <i class="bi bi-diagram-3 me-1"></i> @(linkedQuotes.Any() ? "B2B Teklif & Kıyas Masasını Aç" : "Teklif Topla & Kıyasla (B2B / Dış Link)")
                                </button>
                            </form>

                            <button type="button"
                                    class="btn btn-sm btn-outline-info text-dark fw-bold rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#decisionPinModal"
                                    data-meeting-id="@m.Id"
                                    data-building-id="@m.ContextId"
                                    data-title="@m.AgendaTitle">
                                <i class="bi bi-key me-1"></i> Yetkili / Usta PIN Aç
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-dark fw-semibold rounded-pill px-3"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#meetingDetailPanel_@m.Id">
                                <i class="bi bi-folder2-open me-1"></i> Belgeler (@mAttachments.Count), Görüşler &amp; Vekalet (@quorum.ParticipatedUnits/@quorum.TotalUnits)
                            </button>
                        </div>

                        <div class="collapse mt-3" id="meetingDetailPanel_@m.Id">
                            <div class="bg-white rounded-3 border p-3 row g-3">
                                <div class="col-lg-5">
                                    <h6 class="fw-bold small mb-2"><i class="bi bi-paperclip text-primary me-1"></i>Belgeler, Teklifler &amp; Malik Görüşleri (@mAttachments.Count)</h6>
                                    @if (mAttachments.Any())
                                    {
                                        <div class="list-group list-group-flush border rounded-3 mb-2 small" style="max-height: 210px; overflow-y: auto;">
                                            @foreach (var att in mAttachments)
                                            {
                                                <div class="list-group-item py-2">
                                                    <div class="d-flex justify-content-between">
                                                        <strong>@att.AuthorName <span class="badge bg-light text-dark border">@att.AuthorRoleLabel</span></strong>
                                                        <span class="text-muted" style="font-size:.7rem;">@att.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(att.CommentText))
                                                    {
                                                        <div class="mt-1">@att.CommentText</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(att.FileUrl))
                                                    {
                                                        <a href="@att.FileUrl" target="_blank" class="d-inline-block mt-1 text-decoration-none fw-semibold">
                                                            <i class="bi bi-file-earmark-text me-1"></i>@(att.DocumentTitle ?? "Ekli Belgeyi Aç")
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mb-2">Henüz belge veya görüş eklenmemiş.</div>
                                    }
                                    <form asp-action="AddMeetingAttachment" asp-controller="BuildingManager" method="post" enctype="multipart/form-data" class="border rounded-3 p-2 bg-light small">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="buildingId" value="@m.ContextId" />
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <input type="text" name="commentText" class="form-control form-control-sm mb-1" placeholder="Yönetici açıklaması / özet not..." />
                                        <div class="row g-1 mb-1">
                                            <div class="col-6"><input type="text" name="documentTitle" class="form-control form-control-sm" placeholder="Belge adı (Örn: Çatı Teklifi)" /></div>
                                            <div class="col-6"><input type="file" name="attachmentFile" class="form-control form-control-sm" /></div>
                                        </div>
                                        <button type="submit" class="btn btn-xs btn-primary rounded-pill px-3 fw-semibold">Belge / Not Ekle</button>
                                    </form>
                                </div>

                                <div class="col-lg-7">
                                    <h6 class="fw-bold small mb-2"><i class="bi bi-people text-success me-1"></i>Kat Malikleri Ön Onay &amp; Vekalet Cetveli (@bUnits.Count)</h6>
                                    <div class="table-responsive" style="max-height: 290px; overflow-y: auto;">
                                        <table class="table table-sm table-bordered align-middle small mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Bölüm</th>
                                                    <th>Kat Maliki</th>
                                                    <th>Katılım</th>
                                                    <th>Ön Onay</th>
                                                    <th>Vekil İşlemi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var u in bUnits)
                                                {
                                                    mVotes.TryGetValue(u.Id, out var uv);
                                                    <tr>
                                                        <td class="fw-bold">@u.DoorNumber</td>
                                                        <td>@(u.OwnerName ?? "Malik Girilmemiş")</td>
                                                        <td>
                                                            @(uv?.ParticipationType ?? "Asil")
                                                            @if (!string.IsNullOrWhiteSpace(uv?.ProxyPersonName))
                                                            {
                                                                <span class="text-muted">(@uv.ProxyPersonName)</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(uv?.ProxyDocumentUrl))
                                                            {
                                                                <a href="@uv.ProxyDocumentUrl" target="_blank" class="ms-1"><i class="bi bi-file-earmark-check"></i></a>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (uv?.VoteChoice == "Kabul")
                                                            {
                                                                <span class="badge bg-success">Kabul</span>
                                                            }
                                                            else if (uv?.VoteChoice == "Ret")
                                                            {
                                                                <span class="badge bg-danger">Ret</span>
                                                                @if (!string.IsNullOrWhiteSpace(uv.DissentNote))
                                                                {
                                                                    <small class="text-muted d-block">@uv.DissentNote</small>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-light text-muted border">Bekliyor</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill"
                                                                    onclick="openAssignProxyModal(@m.ContextId, @m.Id, @u.Id, '@System.Web.HttpUtility.JavaScriptStringEncode($"{u.DoorNumber} ({u.OwnerName ?? "Malik"})")', '@System.Web.HttpUtility.JavaScriptStringEncode(uv?.ProxyPersonName ?? u.TenantName ?? "")')">
                                                                Vekil / Oy
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

