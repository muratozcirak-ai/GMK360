@model IEnumerable<GMK360.Core.Entities.VotingLog>
@{
    ViewData["Title"] = "Bina Yönetimi - Dijital Oylamalar";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Dijital Oylamalar ve Kararlar</h2>
        <button class="btn btn-primary rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#yeniOylamaModal">
            <i class="ph-bold ph-plus me-1"></i> Yeni Oylama Başlat
        </button>
    </div>

    @if(TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtreleme Alanı -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row gx-2 align-items-center">
                <div class="col-md-9">
                    <select name="buildingId" class="form-select rounded-3">
                        <option value="">Tüm Binalarım</option>
                        @foreach(var b in ViewBag.Buildings)
                        {
                            if(ViewBag.SelectedBuildingId != null && b.Id == ViewBag.SelectedBuildingId)
                            {
                                <option value="@b.Id" selected>@b.Name</option>
                            }
                            else
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-secondary w-100 rounded-3">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Oylamalar Tablosu -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Oylama Konusu</th>
                            <th>Daire Sakini (Telefon)</th>
                            <th>Onay Kodu (OTP)</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="ph-light ph-empty fs-1 mb-2"></i><br>
                                    Hiç oylama kaydı bulunamadı.
                                </td>
                            </tr>
                        }
                        
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@v.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <strong>@v.Title</strong>
                                    <div class="small text-muted text-truncate" style="max-width:200px;">@v.Description</div>
                                </td>
                                <td>
                                    Daire: @v.ResidentUnitNumber<br>
                                    <small class="text-muted">@v.ResidentPhoneNumber</small>
                                </td>
                                <td><span class="badge bg-secondary">@v.SentOtpCode</span></td>
                                <td>
                                    @if(v.IsApproved)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Onaylandı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">Bekliyor</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if(!v.IsApproved)
                                    {
                                        <!-- OTP Onayla Butonu (Manuel Onay için) -->
                                        <button class="btn btn-sm btn-outline-success rounded-pill" onclick="promptOtp(@v.Id)">
                                            Onayla
                                        </button>
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-check text-success fs-5" title="Blokzincir Log Hash: @v.AuditHash"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Oylama Modal -->
<div class="modal fade" id="yeniOylamaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/BuildingManager/OylamaBaslat">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Yeni Oylama Başlat</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
            <label class="form-label fw-bold">Bina Seçin</label>
            <select name="buildingId" class="form-select rounded-3" required>
                <option value="">-- Bina Seçin --</option>
                @foreach(var b in ViewBag.Buildings)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Oylama Başlığı</label>
            <input type="text" class="form-control rounded-3" name="title" required placeholder="Örn: Çatı Yalıtımı Onayı">
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Detay/Açıklama</label>
            <textarea class="form-control rounded-3" name="description" rows="3" required placeholder="Sakinlere iletilecek detaylar..."></textarea>
        </div>
        
        <div class="alert alert-info py-2 small mb-0 rounded-3">
            <i class="bi bi-info-circle me-1"></i> Bu işlem binadaki tüm dairelere otomatik SMS onayı gönderecektir.
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="btn btn-primary rounded-pill px-4">Oylamayı Başlat</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
    <script>
        function promptOtp(logId) {
            let code = prompt("Sakin tarafından size iletilen 6 haneli OTP kodunu giriniz:");
            if(code && code.length === 6) {
                alert("Sistem entegrasyonu tamamlandığında kod onaylanacaktır.");
                // Burada AJAX ile doğrulamaya gidilebilir.
            }
        }
    </script>
}
