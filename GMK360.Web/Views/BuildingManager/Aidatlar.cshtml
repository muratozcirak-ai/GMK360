@model IEnumerable<GMK360.Core.Entities.UnitDebt>
@{
    ViewData["Title"] = "Aidat ve Borç Takibi";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    var livingUnits = ViewBag.LivingUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var fixedExpenses = ViewBag.FixedExpenses as List<GMK360.Core.Entities.BuildingFixedExpense> ?? new List<GMK360.Core.Entities.BuildingFixedExpense>();
    var buildingStaffs = ViewBag.BuildingStaffs as List<GMK360.Core.Entities.BuildingStaff> ?? new List<GMK360.Core.Entities.BuildingStaff>();

    decimal MonthlyEquiv(GMK360.Core.Entities.BuildingFixedExpense fx)
        => fx.BillingCycleMonths > 1 ? Math.Round(fx.MonthlyAmount / fx.BillingCycleMonths, 2) : fx.MonthlyAmount;

    var planEnergy = fixedExpenses.FirstOrDefault(f => f.SubscriberNo == "BUDGET_ENERGY");
    var planCleaning = fixedExpenses.FirstOrDefault(f => f.SubscriberNo == "BUDGET_CLEANING");
    var planElevator = fixedExpenses.FirstOrDefault(f => f.SubscriberNo == "BUDGET_ELEVATOR");
    var planAdmin = fixedExpenses.FirstOrDefault(f => f.SubscriberNo == "BUDGET_ADMIN");
    var planCapital = fixedExpenses.FirstOrDefault(f => f.SubscriberNo == "BUDGET_CAPITAL");
    var planReserve = fixedExpenses.FirstOrDefault(f => f.SubscriberNo == "BUDGET_RESERVE");

    decimal preEnergy = planEnergy?.MonthlyAmount ?? fixedExpenses.Where(f => f.ExpenseGroup == "FaturaAbonelik" && (f.SubscriberNo == null || !f.SubscriberNo.StartsWith("BUDGET_"))).Sum(MonthlyEquiv);
    decimal preCleanStaff = planCleaning?.MonthlyAmount ?? (buildingStaffs.Sum(s => s.TotalMonthlyOperatingCost) + fixedExpenses.Where(f => f.ExpenseGroup == "BakimOnarim" && f.ExpenseItemKey != "Asansor" && (f.SubscriberNo == null || !f.SubscriberNo.StartsWith("BUDGET_"))).Sum(MonthlyEquiv));
    decimal preElevator = planElevator?.MonthlyAmount ?? fixedExpenses.Where(f => f.ExpenseItemKey == "Asansor" && (f.SubscriberNo == null || !f.SubscriberNo.StartsWith("BUDGET_"))).Sum(MonthlyEquiv);
    decimal preAdmin = planAdmin?.MonthlyAmount ?? fixedExpenses.Where(f => f.ExpenseGroup == "YonetimIdari" && (f.SubscriberNo == null || !f.SubscriberNo.StartsWith("BUDGET_"))).Sum(MonthlyEquiv);
    decimal preCapital = planCapital?.MonthlyAmount ?? (buildingStaffs.Sum(s => s.MonthlySeveranceFund) + fixedExpenses.Where(f => f.ExpenseScope == "Demirbas" && (f.SubscriberNo == null || !f.SubscriberNo.StartsWith("BUDGET_"))).Sum(MonthlyEquiv));
    decimal preOpBase = preEnergy + preCleanStaff + preElevator + preAdmin;
    decimal preReservePct = (planReserve != null && preOpBase > 0m) ? Math.Round((planReserve.MonthlyAmount / preOpBase) * 100m, 0) : 5m;

    int wizardUnitCount = livingUnits.Count;
    decimal wizardWeightSum = livingUnits.Sum(u => (u.IsDuesExempt || u.DuesMultiplier <= 0m) ? 0m : u.DuesMultiplier);
    if (wizardWeightSum <= 0m) wizardWeightSum = wizardUnitCount;

    var totalCollected = Model.Where(d => d.IsPaid).Sum(d => d.Amount);
    var totalUnpaid = Model.Where(d => !d.IsPaid).Sum(d => d.Amount);
    var ownerUnpaid = Model.Where(d => !d.IsPaid && string.Equals(d.PayerRole, "Owner", StringComparison.OrdinalIgnoreCase)).Sum(d => d.Amount);
    var tenantUnpaid = Model.Where(d => !d.IsPaid && !string.Equals(d.PayerRole, "Owner", StringComparison.OrdinalIgnoreCase)).Sum(d => d.Amount);
    int defaultBuildingId = selectedBuildingId ?? buildings.FirstOrDefault()?.Id ?? 0;
    var activeBld = buildings.FirstOrDefault(b => b.Id == defaultBuildingId) ?? buildings.FirstOrDefault();
    decimal activeBaseDues = activeBld?.DefaultBaseMonthlyDues ?? 1500m;
    int activePayDay = activeBld?.DuesPaymentDay ?? 5;
}

<div class="container-fluid py-3 px-1">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success bg-opacity-10 border-success border-start border-4 border-0 rounded-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-success fw-bold small text-uppercase">Tahsil Edilen (Ödenen)</h6>
                    <h3 class="mb-0 fw-bold text-dark">@totalCollected.ToString("N2") ₺</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger bg-opacity-10 border-danger border-start border-4 border-0 rounded-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-danger fw-bold small text-uppercase">Toplam Bekleyen Alacak</h6>
                    <h3 class="mb-0 fw-bold text-dark">@totalUnpaid.ToString("N2") ₺</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary bg-opacity-10 border-primary border-start border-4 border-0 rounded-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-primary fw-bold small text-uppercase">Kiracı / Oturan Bekleyen</h6>
                    <h3 class="mb-0 fw-bold text-dark">@tenantUnpaid.ToString("N2") ₺</h3>
                    <small class="text-muted">İşletme &amp; Aidat borçları</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning bg-opacity-10 border-warning border-start border-4 border-0 rounded-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-warning-emphasis fw-bold small text-uppercase">Mülk Sahibi (Malik) Bekleyen</h6>
                    <h3 class="mb-0 fw-bold text-dark">@ownerUnpaid.ToString("N2") ₺</h3>
                    <small class="text-muted">Demirbaş, Kıdem &amp; Malik payları</small>
                </div>
            </div>
        </div>
    </div>

    @if (activeBld != null)
    {
        var latestDuesDec = ViewBag.LatestDuesDecision as GMK360.Core.Entities.SystemMeeting;
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-body p-3">
                @if (latestDuesDec != null)
                {
                    <div class="alert alert-success py-2 px-3 small mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2 rounded-3">
                        <span>
                            <i class="bi bi-patch-check-fill me-1"></i>
                            <strong>Dayanak KMK Kararı (#@latestDuesDec.DecisionNumber):</strong>
                            @(string.IsNullOrWhiteSpace(latestDuesDec.ExecutionSummary) ? latestDuesDec.AgendaTitle : latestDuesDec.ExecutionSummary)
                        </span>
                        <a href="/BuildingManager/Oylamalar?buildingId=@activeBld.Id&preset=DuesUpdate" class="btn btn-xs btn-outline-success rounded-pill fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> Yeni Aidat Kararı Aç
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2 rounded-3">
                        <span>
                            <i class="bi bi-info-circle-fill me-1"></i>
                            <strong>KMK Hatırlatması:</strong> Sabit aidat artışı ve işletme bütçesi yasal olarak Genel Kurul karar defteri oylamasıyla kesinleşir. Karar açıp salt çoğunluk yakalandığında burası otomatik güncellenir.
                        </span>
                        <a href="/BuildingManager/Oylamalar?buildingId=@activeBld.Id&preset=DuesUpdate" class="btn btn-xs btn-warning text-dark rounded-pill fw-bold">
                            <i class="bi bi-balance-scale me-1"></i> Aidat Artış Kararı Başlat (Karar Defteri)
                        </a>
                    </div>
                }
                <form asp-action="SaveBuildingBaseDues" asp-controller="BuildingManager" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@activeBld.Id" />
                    <div class="col-md-4">
                        <div class="small fw-bold text-dark"><i class="bi bi-currency-exchange text-primary me-1"></i>Site / Bina Sabit Baz Aidatı</div>
                        <div class="text-muted" style="font-size:0.75rem;">Her daire bu baz üzerinden katsayı, +/- TL fark ve muafiyet alır.</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label small fw-bold mb-1">Baz Aylık Bedel (₺)</label>
                        <input type="number" step="0.01" min="0" name="defaultBaseMonthlyDues" id="baseDuesInput" class="form-control form-control-sm fw-bold text-primary" value="@((activeBld.DefaultBaseMonthlyDues ?? 0m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" placeholder="Örn: 1500" />
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small fw-bold mb-1">Ödeme Günü</label>
                        <input type="number" min="1" max="31" name="duesPaymentDay" class="form-control form-control-sm" value="@activePayDay" />
                    </div>
                    <div class="col-md-3 d-flex align-items-center justify-content-between gap-2">
                        <div class="form-check mb-0 small">
                            <input class="form-check-input" type="checkbox" name="applyToAllSiteBlocks" value="true" id="applyAllBlocksSw" checked />
                            <label class="form-check-label" for="applyAllBlocksSw">Tüm Bloklar</label>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">Baz Aidatı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- YILLIK BÜTÇE (KMK İŞLETME PROJESİ) & AİDAT BELİRLEME SİHİRBAZI -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden" id="annualBudgetWizard">
            <div class="card-header bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 p-3">
                <div>
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-calculator text-success me-2"></i>KMK Yıllık Bütçe (İşletme Projesi) &amp; Aidat Belirleme Masası</h6>
                    <small class="text-muted">Sisteme geçmeden önceki veya yıl sonu aylık gider kalemlerinizi girin; sistem 12 aylık yıllık bütçeyi ve önerilen baz aidatı otomatik hesaplasın.</small>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#annualBudgetBody" aria-expanded="true">
                    Göster / Gizle
                </button>
            </div>
            <div class="collapse show" id="annualBudgetBody">
                <form asp-action="SaveAnnualBudgetEstimate" asp-controller="BuildingManager" method="post" class="card-body p-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@activeBld.Id" />
                    <input type="hidden" name="recommendedBaseDues" id="wizRecBaseHidden" value="0" />
                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">⚡ Enerji (Ortak Elektrik, Su, Gaz) — Aylık ₺</label>
                                    <input type="number" step="10" min="0" name="energyMonthly" id="wizEnergy" class="form-control form-control-sm wiz-input" value="@preEnergy.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcAnnualBudget()" />
                                    <small class="text-muted" style="font-size:.7rem;">🔑 İşletme (Kiracı / Oturan)</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">🧹 Görevli Maaş+SGK &amp; Temizlik/Deterjan — Aylık ₺</label>
                                    <input type="number" step="10" min="0" name="staffAndCleaningMonthly" id="wizStaffClean" class="form-control form-control-sm wiz-input" value="@preCleanStaff.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcAnnualBudget()" />
                                    <small class="text-muted" style="font-size:.7rem;">🔑 İşletme (Kiracı / Oturan)</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">🛗 Asansör Bakım &amp; Yıllık Kontrol Payı — Aylık ₺</label>
                                    <input type="number" step="10" min="0" name="elevatorMonthly" id="wizElevator" class="form-control form-control-sm wiz-input" value="@preElevator.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcAnnualBudget()" />
                                    <small class="text-muted" style="font-size:.7rem;">🔑 İşletme (Muaf daire/dükkan hariç)</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">🛡️ Güvenlik, Bahçe, Sigorta &amp; Yönetim — Aylık ₺</label>
                                    <input type="number" step="10" min="0" name="adminAndSecurityMonthly" id="wizAdmin" class="form-control form-control-sm wiz-input" value="@preAdmin.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcAnnualBudget()" />
                                    <small class="text-muted" style="font-size:.7rem;">🔑 İşletme (Kiracı / Oturan)</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1 text-danger">🔨 Demirbaş, Tadilat &amp; Kıdem Fonu — Aylık ₺</label>
                                    <input type="number" step="10" min="0" name="capitalReserveMonthly" id="wizCapital" class="form-control form-control-sm wiz-input" value="@preCapital.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcAnnualBudget()" />
                                    <small class="text-danger" style="font-size:.7rem;">🏠 Sadece Mal Sahibi (Kat Maliki)</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">📌 Beklenmedik Gider İhtiyat Payı (%)</label>
                                    <input type="number" step="1" min="0" max="50" name="contingencyPercent" id="wizReservePct" class="form-control form-control-sm wiz-input" value="@preReservePct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcAnnualBudget()" />
                                    <small class="text-muted" style="font-size:.7rem;">KMK genelde %5–%10 ihtiyat eklenir (0 seçilebilir).</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="p-3 rounded-4 bg-light border h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-semibold text-muted">Aylık İşletme Bütçesi (Kiracı/Oturan):</span>
                                        <strong class="text-primary" id="wizMonthlyOp">0,00 ₺</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-semibold text-muted">12 Aylık Yıllık İşletme Bütçesi:</span>
                                        <strong class="text-dark" id="wizAnnualOp">0,00 ₺</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-semibold text-danger">12 Aylık Demirbaş / Kıdem (Malik):</span>
                                        <strong class="text-danger" id="wizAnnualCap">0,00 ₺</strong>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark">TOPLAM 12 AYLIK YILLIK BÜTÇE:</span>
                                        <span class="fs-5 fw-bold text-success" id="wizAnnualTotal">0,00 ₺</span>
                                    </div>
                                    <div class="p-2 rounded-3 bg-white border border-primary-subtle">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="small fw-bold text-primary">Önerilen Aylık Baz Aidat:</span>
                                            <span class="fs-5 fw-bold text-primary" id="wizRecBaseText">0,00 ₺</span>
                                        </div>
                                        <div class="text-muted" style="font-size:.72rem;">
                                            @wizardUnitCount aktif bölüm (katsayı ağırlığı: @wizardWeightSum.ToString("0.##")) • Malik başı demirbaş payı: <strong id="wizRecCapText">0,00 ₺</strong>/ay
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 d-flex flex-column gap-2">
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold flex-grow-1" onclick="copyRecommendedToBaseDues()">
                                            <i class="bi bi-arrow-up-circle me-1"></i> Önerileni Baz Aidata Aktar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill fw-bold flex-grow-1" onclick="sendBudgetRecommendationToDecision(@activeBld.Id)">
                                            <i class="bi bi-balance-scale me-1"></i> Öneriyi Karar Defterine Taşı
                                        </button>
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill fw-semibold flex-grow-1">
                                            <i class="bi bi-save me-1"></i> Yıllık Bütçe Kalemlerini Kaydet
                                        </button>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" name="applyToAllSiteBlocks" value="true" id="wizAllBlocks" checked />
                                            <label class="form-check-label" for="wizAllBlocks">Site geneli tüm bloklara uygula</label>
                                        </div>
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" name="applyCalculatedAsBaseDues" value="true" id="wizApplyBase" />
                                            <label class="form-check-label" for="wizApplyBase">Önerileni baz aidat olarak da kaydet</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-dark text-white d-flex flex-wrap justify-content-between align-items-center gap-2 p-3">
            <div>
                <h5 class="mb-0 fw-bold text-white"><i class="bi bi-cash-stack text-warning me-2"></i>Aidat / Gider Borçları &amp; Tahakkuk Defteri</h5>
                <small class="text-light opacity-75">@livingUnits.Count aktif bağımsız bölüm • @fixedExpenses.Count tanımlı sabit bütçe kalemi</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <form method="get" class="d-flex">
                    <select name="buildingId" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                        <option value="">Tüm Binalar</option>
                        @foreach (var b in buildings)
                        {
                            if (selectedBuildingId == b.Id)
                            {
                                <option value="@b.Id" selected>@b.Name</option>
                            }
                            else
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    </select>
                </form>
                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#anonymousSummaryModal">
                    <i class="bi bi-shield-lock me-1"></i> Anonim Kurul Özeti (İsimsiz)
                </button>
                <a href="/BuildingManager/Sakinler@(defaultBuildingId > 0 ? $"?buildingId={defaultBuildingId}" : "")" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="bi bi-sliders me-1"></i> Daire / Ofis / Dükkan Katsayıları
                </a>
                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#extraExpenseSplitModal" @(buildings.Any() ? "" : "disabled")>
                    <i class="bi bi-hammer me-1"></i> Ek Demirbaş / Özel Gider Bölüştür
                </button>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#batchDuesModal" @(buildings.Any() ? "" : "disabled")>
                    <i class="bi bi-plus-circle me-1"></i> Aylık Aidat Kes
                </button>
            </div>
        </div>
        <div class="bg-warning bg-opacity-10 border-bottom px-3 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
            <span class="text-dark">
                <i class="bi bi-shield-lock-fill text-danger me-1"></i>
                <strong>KVKK &amp; Yargıtay Deşifre Yasağı:</strong> Kişi/daire bazlı ödenmemiş borç listesi <u>yalnızca Yönetici, Aza ve Denetçi</u> ekranındadır. Sakin portallarında sadece kişinin kendi borcu görünür; pano/duyuruya borçlu ismi asılmaz.
            </span>
        </div>
        <div class="bg-light border-bottom px-3 py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap gap-1" id="aidatQuickFilters">
                <button type="button" class="btn btn-xs btn-dark rounded-pill px-3 fw-semibold active" onclick="setAidatFilter(this, 'all')">Tümü (@Model.Count())</button>
                <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-3 fw-semibold" onclick="setAidatFilter(this, 'unpaid')">🔴 Ödenmemiş / Geciken (@Model.Count(d => !d.IsPaid))</button>
                <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-3 fw-semibold" onclick="setAidatFilter(this, 'paid')">✅ Ödenenler (@Model.Count(d => d.IsPaid))</button>
                <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill px-3 fw-semibold" onclick="setAidatFilter(this, 'owner')">🏠 Malik Payı</button>
                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-3 fw-semibold" onclick="setAidatFilter(this, 'tenant')">🔑 Kiracı Payı</button>
            </div>
            <div class="input-group input-group-sm" style="width: 230px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" id="aidatSearchInput" class="form-control" placeholder="Kapı no, ad, açıklama ara..." oninput="filterAidatRows()" />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="aidatDebtsTable">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3">Tarih</th>
                            <th>Bina / Bölüm</th>
                            <th>Açıklama &amp; Dağıtım Kuralı</th>
                            <th>Muhatap (Cari)</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                            <th class="pe-3 text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">Henüz tahakkuk / borç kaydı bulunamadı. Yukarıdan <strong>Aylık Aidat Kes</strong> ile dönem aidatı oluşturabilirsiniz.</td></tr>
                        }
                        else
                        {
                            foreach (var debt in Model)
                            {
                                bool isOwnerRole = string.Equals(debt.PayerRole, "Owner", StringComparison.OrdinalIgnoreCase);
                                string targetPerson = isOwnerRole ? (debt.BuildingUnit?.OwnerName ?? "Malik") : (string.IsNullOrEmpty(debt.BuildingUnit?.TenantName) ? (debt.BuildingUnit?.OwnerName ?? "Sakin") : debt.BuildingUnit!.TenantName);
                                string targetPhone = isOwnerRole ? (debt.BuildingUnit?.OwnerPhone ?? "") : (!string.IsNullOrWhiteSpace(debt.BuildingUnit?.TenantPhone) ? debt.BuildingUnit!.TenantPhone : (debt.BuildingUnit?.OwnerPhone ?? ""));
                                string rowBlob = $"{debt.BuildingUnit?.Building?.Name} {debt.BuildingUnit?.DoorNumber} {debt.BuildingExpense?.Description} {targetPerson}".ToLowerInvariant();
                                <tr class="aidat-row"
                                    data-paid="@(debt.IsPaid ? "1" : "0")"
                                    data-role="@(isOwnerRole ? "owner" : "tenant")"
                                    data-search="@rowBlob">
                                    <td class="ps-3 small">@(debt.BuildingExpense?.Date.ToString("dd.MM.yyyy") ?? "-")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(debt.BuildingUnit?.Building?.Name ?? "-")</span>
                                        <div class="fw-bold text-dark mt-1">Kapı @debt.BuildingUnit?.DoorNumber <small class="text-muted fw-normal">(@(debt.BuildingUnit?.Category ?? "Daire"))</small></div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(debt.BuildingExpense?.Description ?? "-")</div>
                                        @if (debt.BuildingExpense != null)
                                        {
                                            <span class="badge bg-light text-secondary border small">@debt.BuildingExpense.DistributionRule</span>
                                            <span class="badge bg-info-subtle text-info-emphasis small ms-1">@debt.BuildingExpense.ExpenseItemKey</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isOwnerRole)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">🏠 Malik</span>
                                            <small class="d-block text-muted">@(debt.BuildingUnit?.OwnerName ?? "-")</small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">🔑 Kiracı / Oturan</span>
                                            <small class="d-block text-muted">@(debt.BuildingUnit?.TenantName ?? debt.BuildingUnit?.OwnerName ?? "-")</small>
                                        }
                                    </td>
                                    <td><strong class="text-dark">@debt.Amount.ToString("N2") ₺</strong></td>
                                    <td>
                                        @if (debt.IsPaid)
                                        {
                                            <span class="badge bg-success">Ödendi</span>
                                            <small class="d-block text-muted">@debt.PaidBy (@debt.PaymentDate?.ToString("dd.MM.yyyy"))</small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Ödenmedi</span>
                                        }
                                    </td>
                                    <td class="pe-3 text-end">
                                        @if (!debt.IsPaid)
                                        {
                                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-2 fw-semibold" title="Kişiye özel (deşifresiz) birebir ödeme hatırlatması"
                                                        onclick="sendPrivateDebtReminder('@System.Web.HttpUtility.JavaScriptStringEncode(targetPhone)', '@System.Web.HttpUtility.JavaScriptStringEncode(targetPerson)', '@System.Web.HttpUtility.JavaScriptStringEncode(debt.BuildingUnit?.DoorNumber ?? "")', '@debt.Amount.ToString("N2")', '@System.Web.HttpUtility.JavaScriptStringEncode(debt.BuildingExpense?.Description ?? "Aidat")')">
                                                    <i class="bi bi-whatsapp me-1"></i> Hatırlat
                                                </button>
                                                <form asp-action="MarkDebtAsPaid" asp-controller="BuildingManager" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="debtId" value="@debt.Id" />
                                                    <input type="hidden" name="returnAction" value="Aidatlar" />
                                                    <input type="hidden" name="paidBy" value="@targetPerson" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Tahsil Edildi İşaretle">
                                                        <i class="bi bi-check2-circle me-1"></i> Tahsil Et
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (buildings.Any())
{
