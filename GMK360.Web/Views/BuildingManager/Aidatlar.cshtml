    <script>
        const _wizUnitWeight = @wizardWeightSum.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        const _wizUnitCount = @wizardUnitCount;

        function fmtTry(v) {
            return Number(v || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        }

        function recalcAnnualBudget() {
            const eEl = document.getElementById('wizEnergy');
            if (!eEl) return;
            const energy = Math.max(0, parseFloat(eEl.value || '0') || 0);
            const staffClean = Math.max(0, parseFloat(document.getElementById('wizStaffClean').value || '0') || 0);
            const elev = Math.max(0, parseFloat(document.getElementById('wizElevator').value || '0') || 0);
            const admin = Math.max(0, parseFloat(document.getElementById('wizAdmin').value || '0') || 0);
            const cap = Math.max(0, parseFloat(document.getElementById('wizCapital').value || '0') || 0);
            const resPct = Math.max(0, Math.min(50, parseFloat(document.getElementById('wizReservePct').value || '0') || 0));

            const opSub = energy + staffClean + elev + admin;
            const monthlyOp = opSub + (opSub * resPct / 100);
            const annualOp = monthlyOp * 12;
            const annualCap = cap * 12;
            const annualTotal = annualOp + annualCap;

            const denomOp = _wizUnitWeight > 0 ? _wizUnitWeight : (_wizUnitCount > 0 ? _wizUnitCount : 1);
            const denomCap = _wizUnitCount > 0 ? _wizUnitCount : 1;
            const recBase = monthlyOp / denomOp;
            const recCap = cap / denomCap;

            document.getElementById('wizMonthlyOp').innerText = fmtTry(monthlyOp);
            document.getElementById('wizAnnualOp').innerText = fmtTry(annualOp);
            document.getElementById('wizAnnualCap').innerText = fmtTry(annualCap);
            document.getElementById('wizAnnualTotal').innerText = fmtTry(annualTotal);
            document.getElementById('wizRecBaseText').innerText = fmtTry(recBase);
            document.getElementById('wizRecCapText').innerText = fmtTry(recCap);
            document.getElementById('wizRecBaseHidden').value = recBase.toFixed(2);
        }

        function copyRecommendedToBaseDues() {
            recalcAnnualBudget();
            const rec = parseFloat(document.getElementById('wizRecBaseHidden').value || '0') || 0;
            const target = document.getElementById('baseDuesInput');
            if (!target) return;
            target.value = rec > 0 ? Math.ceil(rec) : '0';
            target.focus();
            target.classList.add('bg-warning-subtle');
            setTimeout(() => target.classList.remove('bg-warning-subtle'), 1800);
        }

        function sendBudgetRecommendationToDecision(bId) {
            recalcAnnualBudget();
            const rec = parseFloat(document.getElementById('wizRecBaseHidden').value || '0') || 0;
            const rounded = rec > 0 ? Math.ceil(rec) : '';
            window.location.href = `/BuildingManager/Oylamalar?buildingId=${bId}&preset=DuesUpdate&proposedDues=${encodeURIComponent(rounded)}`;
        }

        let _activeAidatFilter = 'all';
        function setAidatFilter(btn, key) {
            _activeAidatFilter = key || 'all';
            document.querySelectorAll('#aidatQuickFilters button').forEach(b => {
                const act = b === btn;
                b.classList.toggle('btn-dark', act);
                b.classList.toggle('text-white', act);
                if (!act) b.classList.remove('btn-dark');
            });
            filterAidatRows();
        }

        function filterAidatRows() {
            const q = (document.getElementById('aidatSearchInput')?.value || '').trim().toLowerCase();
            document.querySelectorAll('#aidatDebtsTable tbody tr.aidat-row').forEach(r => {
                let ok = true;
                if (_activeAidatFilter === 'unpaid') ok = r.dataset.paid === '0';
                else if (_activeAidatFilter === 'paid') ok = r.dataset.paid === '1';
                else if (_activeAidatFilter === 'owner') ok = r.dataset.role === 'owner';
                else if (_activeAidatFilter === 'tenant') ok = r.dataset.role === 'tenant';
                const s = r.dataset.search || '';
                r.style.display = (ok && (!q || s.includes(q))) ? '' : 'none';
            });
        }

        function sendPrivateDebtReminder(phone, name, doorNo, amount, desc) {
            const msg = `Sayın ${name}, ${doorNo} nolu bölüm için "${desc}" kaleminde ${amount} TL ödenmemiş bakiyeniz bulunmaktadır. KMK Md. 20 gereği gecikme tazminatı doğmaması için bireysel portalınızdan veya site banka hesabına ödeme yapabilirsiniz. (Bu bildirim KVKK gereği yalnızca size özel iletilmiştir.)`;
            const digits = (phone || '').replace(/\D/g, '');
            if (digits.length >= 10) {
                const intl = digits.length === 10 ? '90' + digits : (digits.startsWith('0') ? '9' + digits : digits);
                window.open('https://wa.me/' + intl + '?text=' + encodeURIComponent(msg), '_blank');
            } else if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(msg).then(() => alert('Kişiye özel ödeme hatırlatma metni panoya kopyalandı (telefon eksik olduğu için WhatsApp açılmadı):\n\n' + msg));
            } else {
                prompt('Hatırlatma metnini kopyalayın:', msg);
            }
        }

        document.addEventListener('DOMContentLoaded', recalcAnnualBudget);

        function toggleBatchDuesMode() {
            const mode = document.getElementById('bdMode').value;
            document.getElementById('fixedDuesOptions').classList.toggle('d-none', mode !== 'FixedUnitDues');
            document.getElementById('recurringBudgetOptions').classList.toggle('d-none', mode === 'FixedUnitDues');
            const box = document.getElementById('bdPreviewContainer');
            if (box) box.className = 'mt-2 d-none';
        }

        async function previewBatchDues() {
            const box = document.getElementById('bdPreviewContainer');
            box.className = 'mt-2 p-2 bg-white border rounded-3 small';
            box.innerHTML = '<div class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Önizleme hazırlanıyor...</div>';

            const fd = new FormData();
            const tokenEl = document.querySelector('#batchDuesForm input[name="__RequestVerificationToken"]');
            if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);
            const mode = document.getElementById('bdMode').value;
            fd.append('mode', mode);
            fd.append('buildingId', document.getElementById('bdBuildingId').value);
            fd.append('year', document.getElementById('bdYear').value);
            fd.append('month', document.getElementById('bdMonth').value);
            fd.append('defaultBaseDues', document.getElementById('bdBaseDues').value || '0');
            fd.append('scopeType', document.getElementById('bdScopeType').value);
            fd.append('includeStaffCosts', document.getElementById('bdIncStaff').checked ? 'true' : 'false');
            const sp = document.getElementById('bdOwnerSplit').value;
            if (sp !== '') fd.append('ownerSplitPercent', sp);

            const resp = await fetch('/BuildingManager/PreviewMonthlyDuesBatch', { method: 'POST', body: fd });
            const res = await resp.json();
            if (!res.success) {
                box.className = 'mt-2 alert alert-danger small mb-0';
                box.innerText = res.message || 'Önizleme oluşturulamadı.';
                return;
            }
            const rows = (res.items || []).map(x => `
                <tr class="${x.isExempt ? 'table-secondary text-muted' : ''}">
                    <td><strong>${x.doorNumber}</strong> <small class="text-muted">(${x.roomLayout})</small></td>
                    <td>${mode === 'RecurringBudget' ? x.participationPercent.toFixed(0) + '%' : x.duesMultiplier.toFixed(2) + 'x'}</td>
                    <td><small>${x.statusNote}</small></td>
                    <td class="text-end">${x.ownerAmount.toFixed(2)} ₺</td>
                    <td class="text-end">${x.tenantAmount.toFixed(2)} ₺</td>
                    <td class="text-end fw-bold">${x.totalShareAmount.toFixed(2)} ₺</td>
                </tr>`).join('');
            box.innerHTML = `
                <div class="d-flex justify-content-between mb-1 fw-bold text-primary">
                    <span>${res.scopeLabel} • Toplam Tahakkuk: ${res.totalAmount.toFixed(2)} ₺</span>
                    <span>${res.participatingUnitCount} Bölüm</span>
                </div>
                <div style="max-height:240px; overflow-y:auto;">
                    <table class="table table-sm table-bordered mb-0" style="font-size:0.78rem;">
                        <thead class="table-light"><tr><th>Kapı</th><th>${mode === 'RecurringBudget' ? 'Katılım' : 'Katsayı'}</th><th>Açıklama / Kalem Dağılımı</th><th class="text-end">Malik</th><th class="text-end">Kiracı</th><th class="text-end">Toplam</th></tr></thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>`;
        }
    </script>
}
