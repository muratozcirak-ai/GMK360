@model IEnumerable<GMK360.Core.Entities.SpaceFixture>
@{
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    ViewData["Title"] = "Planlı İşler & Bakım Takvimi";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var meetings = ViewBag.Meetings as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
}

<div class="container-fluid py-3 px-1">
    <div class="bg-white p-4 rounded-4 shadow-sm mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-calendar-check text-success me-2"></i>Planlı İşler &amp; Mevsimlik Bakım Takvimi</h2>
            <p class="text-muted small mb-0">Bahçe/ağaç budama sezonu, asansör muayenesi, kazan/baca temizliği ve genel kurul tarihleri</p>
        </div>
        <button class="btn btn-success rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#scheduleMaintenanceModal" @(buildings.Any() ? "" : "disabled")>
            <i class="bi bi-plus-circle me-1"></i> Planlı İş / Bakım Ekle
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Mevsimlik Bakım Sezon Rehberi -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-success">
                <div class="card-body p-3">
                    <span class="badge bg-success-subtle text-success mb-2">İlkbahar (Mart - Nisan)</span>
                    <h6 class="fw-bold text-dark">Bahçe &amp; Ağaç Budama Sezonu</h6>
                    <p class="small text-muted mb-0">Süs ağaçları gençleştirme budaması, çim havalandırma, ortak bahçe sulama hattı açılışı ve haşere önleyici ilaçlama.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-warning">
                <div class="card-body p-3">
                    <span class="badge bg-warning-subtle text-warning-emphasis mb-2">Yaz (Haziran - Ağustos)</span>
                    <h6 class="fw-bold text-dark">Çatı, Oluk &amp; Cephe Kontrolü</h6>
                    <p class="small text-muted mb-0">Teras su izolasyonu kontrolü, yağmur oluklarının temizliği, su deposu dezenfeksiyonu ve yangın tüpü dolum vadesi kontrolü.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-danger">
                <div class="card-body p-3">
                    <span class="badge bg-danger-subtle text-danger mb-2">Sonbahar (Ekim - Kasım)</span>
                    <h6 class="fw-bold text-dark">Kışa Hazırlık &amp; Kuru Dal Budaması</h6>
                    <p class="small text-muted mb-0">Yaprak dökümü sonrası ağaç şekil/kuruyan dal budaması, merkezi kazan &amp; hidrofor kış bakımı, yağmur gideri temizliği.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-primary">
                <div class="card-body p-3">
                    <span class="badge bg-primary-subtle text-primary mb-2">Yıllık Yasal Zorunluluk</span>
                    <h6 class="fw-bold text-dark">Asansör &amp; Jeneratör Muayenesi</h6>
                    <p class="small text-muted mb-0">TSE/A Tipi Muayene Kuruluşu yıllık yeşil etiket kontrolü, paratoner topraklama ölçümü ve jeneratör yük testi.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom p-3 fw-bold text-dark">
                    <i class="bi bi-tools text-warning me-2"></i>Bina Planlı İşler &amp; Bakım Listesi
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Planlanan Tarih</th>
                                    <th>Bina / Alan</th>
                                    <th>İş / Bakım Konusu</th>
                                    <th>Sorumlu Servis</th>
                                    <th class="pe-3">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted small">
                                            Henüz tarih verilmiş planlı bakım işi yok. Sağ üstteki <strong>+ Planlı İş / Bakım Ekle</strong> butonundan ekleyebilirsiniz.
                                        </td>
                                    </tr>
                                }
                                @foreach (var fx in Model)
                                {
                                    bool overdue = fx.NextMaintenanceDate.HasValue && fx.NextMaintenanceDate.Value.Date < DateTime.Today;
                                    <tr>
                                        <td class="ps-3 small fw-semibold">
                                            @(fx.NextMaintenanceDate.HasValue ? fx.NextMaintenanceDate.Value.ToString("dd.MM.yyyy") : "Tarihsiz")
                                        </td>
                                        <td class="small">
                                            <div class="fw-bold text-dark">@fx.UnitSpace?.BuildingUnit?.Building?.Name</div>
                                            <span class="text-muted">@fx.UnitSpace?.Name</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@fx.ItemName</div>
                                            @if (!string.IsNullOrWhiteSpace(fx.MaintenanceNotes))
                                            {
                                                <small class="text-muted">@fx.MaintenanceNotes</small>
                                            }
                                        </td>
                                        <td class="small">@(fx.TechnicalServiceName ?? "-")</td>
                                        <td class="pe-3">
                                            @if (overdue)
                                            {
                                                <span class="badge bg-danger">Vadesi Geldi</span>
                                            }
                                            else if (fx.NextMaintenanceDate.HasValue)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Planlandı</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Genel Demirbaş</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom p-3 fw-bold text-dark">
                    <i class="bi bi-people text-primary me-2"></i>Yaklaşan / Kayıtlı Toplantılar
                </div>
                <div class="card-body p-3">
                    @if (!meetings.Any())
                    {
                        <div class="text-muted small text-center py-3">Kayıtlı toplantı bulunmuyor.</div>
                    }
                    else
                    {
                        foreach (var m in meetings.Take(6))
                        {
                            <div class="border-bottom pb-2 mb-2">
                                <div class="fw-bold text-dark small">@m.AgendaTitle</div>
                                <small class="text-muted">@m.MeetingDate.ToString("dd.MM.yyyy")</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (buildings.Any())
{
    <div class="modal fade" id="scheduleMaintenanceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="SchedulePlannedMaintenance" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold">Planlı Bakım / Mevsimlik İş Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Bina</label>
                        <select name="buildingId" class="form-select" required>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Ortak Alan / Bölüm</label>
                        <input type="text" name="spaceName" class="form-control" value="Bahçe & Peyzaj" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kategori</label>
                        <select name="category" class="form-select">
                            <option value="Bahçe / Budama">Bahçe / Ağaç Budama</option>
                            <option value="Asansör Muayene">Asansör Periyodik Muayene</option>
                            <option value="Kazan / Tesisat">Kazan, Hidrofor &amp; Baca</option>
                            <option value="Çatı / İzolasyon">Çatı &amp; Yağmur Oluğu</option>
                            <option value="Genel Bakım">Genel Bakım</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Yapılacak Planlı İş</label>
                        <input type="text" name="itemName" class="form-control" required placeholder="Örn: Bahçe ağaçları sonbahar budaması" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Hedef Tarih</label>
                        <input type="date" name="nextMaintenanceDate" class="form-control" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Sorumlu Usta / Servis</label>
                        <input type="text" name="serviceName" class="form-control" placeholder="Örn: Yeşil Vadi Peyzaj / 0532..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Notlar</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Sezon notu veya malzeme detayı..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Takvime Kaydet</button>
                </div>
            </form>
        </div>
    </div>
}
