@model IEnumerable<GMK360.Core.Entities.BuildingExpense>
@{
    ViewData["Title"] = "Sabit Bina Giderleri, Aidat Bütçesi & Satın Almalar";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
    var buildings = ViewBag.Buildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var selectedBuildingId = ViewBag.SelectedBuildingId as int?;
    var buildingStaffs = ViewBag.BuildingStaffs as List<GMK360.Core.Entities.BuildingStaff> ?? new List<GMK360.Core.Entities.BuildingStaff>();
    var fixedExpenses = ViewBag.FixedExpenses as List<GMK360.Core.Entities.BuildingFixedExpense> ?? new List<GMK360.Core.Entities.BuildingFixedExpense>();
    var budget = ViewBag.BudgetSummary as GMK360.Web.Services.BuildingMonthlyBudgetSummary ?? new GMK360.Web.Services.BuildingMonthlyBudgetSummary();

    var activeExpenses = Model.Where(e => !e.IsArchived && e.ReversalOfExpenseId == null).ToList();
    var totalOperational = activeExpenses.Where(e => e.ExpenseType != GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure).Sum(e => e.TotalAmount);
    var totalCapital = activeExpenses.Where(e => e.ExpenseType == GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure).Sum(e => e.TotalAmount);
}

<div class="container-fluid py-3 px-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-receipt-cutoff text-danger me-2"></i>Sabit Gider Bütçesi &amp; Satın Almalar</h2>
            <p class="text-muted small mb-0">Elektrik, su, asansör, mali müşavir sabitleri, çalışan + kıdem fonu bütçesi ve Sarf / Demirbaş satın almalar</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addFixedExpenseModal" @(buildings.Any() ? "" : "disabled")>
                <i class="bi bi-calendar-plus me-1"></i> + Sabit Bina Gideri Ekle
            </button>
            <button class="btn btn-danger rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#newExpenseDirectModal" @(buildings.Any() ? "" : "disabled")>
                <i class="bi bi-plus-circle me-1"></i> + Fatura / Satın Alma İşle
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- OTOMATİK AİDAT HESABI & İKİLİ KASA ÖZETİ -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success h-100">
                <div class="text-muted small fw-bold text-uppercase">Min. Daire İşletme Aidatı / Ay</div>
                <h3 class="fw-bold text-success mb-1">@budget.EstimatedMinOperatingDuesPerUnit.ToString("N2") ₺</h3>
                <small class="text-muted">Oturan/Kiracı kasası (@budget.TotalMonthlyOperatingBudget.ToString("N0") ₺ / @budget.ActiveUnitCount bölüm)</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning h-100">
                <div class="text-muted small fw-bold text-uppercase">Aylık Kıdem &amp; Demirbaş Fonu</div>
                <h3 class="fw-bold text-warning-emphasis mb-1">@budget.TotalMonthlyCapitalBudget.ToString("N2") ₺</h3>
                <small class="text-muted">Malik kasası (Daire başı: @budget.EstimatedSeverancePerOwnerUnit.ToString("N0") ₺)</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary h-100">
                <div class="text-muted small fw-bold text-uppercase">Gerçekleşen İşletme / Sarf</div>
                <h3 class="fw-bold text-primary mb-1">@totalOperational.ToString("N2") ₺</h3>
                <small class="text-muted">Kiracı / oturan ekstresine yansıyan faturalar</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-danger h-100">
                <div class="text-muted small fw-bold text-uppercase">Gerçekleşen Demirbaş &amp; Tadilat</div>
                <h3 class="fw-bold text-danger mb-1">@totalCapital.ToString("N2") ₺</h3>
                <small class="text-muted">Mülk sahibi + GMSİ matrahına işlenen</small>
            </div>
        </div>
    </div>

    <!-- 1. AYLIK SABİT BİNA GİDERLERİ & PERSONEL ÖZETİ -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white">
        <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar2-week text-success me-2"></i>Aylık Sabit Bina Giderleri, Ödeme Günleri &amp; Dağıtım Kuralı</h5>
                <small class="text-muted">Asansör bakımı, ortak elektrik/su, mali müşavir, personel SGK &amp; kıdem fonu bütçesi</small>
            </div>
            <a href="/BuildingManager/Accounting" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                <i class="bi bi-people me-1"></i> Personel SGK &amp; Puantaj Masası &rarr;
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3">Ödeme Günü</th>
                            <th>Bina</th>
                            <th>Gider Kalemi / Kurum</th>
                            <th>Kapsam (Kasa)</th>
                            <th>Dağıtım Kuralı</th>
                            <th>Aylık Tutar</th>
                            <th class="pe-3 text-end">Tahakkuk</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!fixedExpenses.Any() && !buildingStaffs.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted small">
                                    Henüz sabit gider veya personel bütçesi tanımlanmamış. Yukarıdan <strong>+ Sabit Bina Gideri Ekle</strong> butonuna tıklayın.
                                </td>
                            </tr>
                        }
                        @foreach (var st in buildingStaffs)
                        {
                            <tr class="table-success bg-opacity-25">
                                <td class="ps-3 small fw-bold">Ayın 1-5'i</td>
                                <td><span class="badge bg-light text-dark border">@st.Building?.Name</span></td>
                                <td>
                                    <strong>@st.FullName (@st.RoleType)</strong>
                                    <small class="d-block text-muted">İşletme: @st.TotalMonthlyOperatingCost.ToString("N2") ₺ • Kıdem Fonu (Malik): @st.MonthlySeveranceFund.ToString("N2") ₺</small>
                                </td>
                                <td><span class="badge bg-primary">İşletme + Malik Kıdem</span></td>
                                <td class="small">Eşit / Bordro</td>
                                <td class="fw-bold text-success">@st.TotalMonthlyOperatingCost.ToString("N2") ₺</td>
                                <td class="pe-3 text-end">
                                    <a href="/BuildingManager/Accounting?buildingId=@st.BuildingId" class="btn btn-sm btn-outline-success rounded-pill px-3">Puantajdan Öde</a>
                                </td>
                            </tr>
                        }
                        @foreach (var fx in fixedExpenses)
                        {
                            bool isDemirbas = fx.ExpenseScope == "Demirbas";
                            <tr>
                                <td class="ps-3 small fw-bold">Her Ayın @(fx.DueDayOfMonth). Günü</td>
                                <td><span class="badge bg-light text-dark border">@fx.Building?.Name</span></td>
                                <td>
                                    <strong>@fx.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(fx.ProviderName))
                                    {
                                        <small class="d-block text-muted">@fx.ProviderName @(!string.IsNullOrWhiteSpace(fx.SubscriberNo) ? $"({fx.SubscriberNo})" : "")</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(isDemirbas ? "bg-danger" : "bg-primary")">
                                        @(isDemirbas ? "Demirbaş (Malik)" : "İşletme (Oturan)")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@fx.DistributionRule</span>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">@fx.ExpenseItemKey</span>
                                    @if (fx.ShopParticipationPercent != 100m)
                                    {
                                        <span class="badge @(fx.ShopParticipationPercent == 0m ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") ms-1">Dükkan %@fx.ShopParticipationPercent.ToString("0.##")</span>
                                    }
                                    @if (fx.OwnerSplitPercent.HasValue)
                                    {
                                        <span class="badge bg-secondary-subtle text-dark ms-1">Malik %@fx.OwnerSplitPercent.Value.ToString("0.##")</span>
                                    }
                                    @if (fx.IsAutoRecurring) { <span class="badge bg-success-subtle text-success ms-1">Oto</span> }
                                </td>
                                <td class="fw-bold">@fx.MonthlyAmount.ToString("N2") ₺</td>
                                <td class="pe-3 text-end">
                                    <form asp-action="DistributeBuildingFixedExpense" asp-controller="BuildingManager" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fixedExpenseId" value="@fx.Id" />
                                        <input type="hidden" name="buildingId" value="@fx.BuildingId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">Bu Aya Dağıt</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. SATIN ALMALAR & GERÇEKLEŞEN FATURALAR DEFTERİ -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white">
        <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-text text-danger me-2"></i>Gerçekleşen Faturalar, Satın Almalar &amp; Demirbaş Defteri</h5>
                <small class="text-muted">Fiziksel silme kapalıdır; hatalı girişlerde Ters Kayıt (Reversal) düzenlenir.</small>
            </div>
            <form method="get" class="d-flex gap-2">
                <select name="buildingId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Tüm Binalar</option>
                    @foreach (var b in buildings)
                    {
                        if (selectedBuildingId == b.Id)
                        {
                            <option value="@b.Id" selected>@b.Name</option>
                        }
                        else
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    }
                </select>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3">Tarih</th>
                            <th>Bina</th>
                            <th>Gider / Satın Alma Açıklaması</th>
                            <th>Cari Yönlendirme (KMK)</th>
                            <th>Toplam Tutar</th>
                            <th>Fatura/Belge</th>
                            <th class="pe-3 text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center py-5 text-muted">Henüz gerçekleşen fatura veya satın alma kaydı yok.</td></tr>
                        }
                        else
                        {
                            foreach (var exp in Model)
                            {
                                bool isCapital = exp.ExpenseType == GMK360.Core.Entities.BuildingExpenseType.CapitalExpenditure
                                    || string.Equals(exp.PayerType, "Owner", StringComparison.OrdinalIgnoreCase);
                                bool isReversal = exp.ReversalOfExpenseId != null || exp.TotalAmount < 0;
                                <tr class="@(exp.IsArchived ? "table-secondary opacity-75" : "")">
                                    <td class="ps-3 small">@exp.Date.ToString("dd.MM.yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@exp.Building?.Name</span></td>
                                    <td>
                                        <strong>@exp.Description</strong>
                                        @if (isReversal) { <span class="badge bg-dark ms-1">TERS KAYIT</span> }
                                        else if (exp.IsArchived) { <span class="badge bg-secondary ms-1">İPTAL (ARŞİV)</span> }
                                    </td>
                                    <td>
                                        @if (isCapital)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">🔨 Demirbaş / Tadilat (Malik)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">💡 Sabit / Sarf (Kiracı / Malik)</span>
                                        }
                                    </td>
                                    <td><strong class="@(exp.TotalAmount < 0 ? "text-danger" : "text-dark")">@exp.TotalAmount.ToString("N2") ₺</strong></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(exp.InvoiceDocumentUrl))
                                        {
                                            <a href="@exp.InvoiceDocumentUrl" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2"><i class="bi bi-paperclip"></i> Fatura</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="pe-3 text-end">
                                        @if (!exp.IsArchived && !isReversal && exp.BuildingId.HasValue)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                                    onclick="openGiderReversalModal(@exp.Id, @exp.BuildingId.Value, '@System.Web.HttpUtility.JavaScriptStringEncode(exp.Description)')">
                                                <i class="bi bi-arrow-counterclockwise"></i> Ters Kayıt
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (buildings.Any())
{
    <!-- Sabit Bina Gideri Ekle Modalı -->
    <div class="modal fade" id="addFixedExpenseModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="AddBuildingFixedExpense" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold">Aylık Sabit Bina Gideri Tanımla</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Bina</label>
                        <select name="buildingId" class="form-select" required>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Gider Başlığı *</label>
                        <input type="text" name="title" class="form-control" required placeholder="Örn: Asansör Aylık Bakım, Ortak Elektrik, Mali Müşavir" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kapsam (Hangi Kasa?)</label>
                        <select name="expenseScope" class="form-select fw-semibold">
                            <option value="Isletme">İşletme (Oturan / Kiracı Öder)</option>
                            <option value="Demirbas">Demirbaş (Ev Sahibi / Malik Öder)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Dağıtım Kuralı</label>
                        <select name="distributionRule" class="form-select">
                            <option value="Esit">Eşit (Bölüm Başı)</option>
                            <option value="ArsaPayi">Arsa Payı Oranlı</option>
                            <option value="Metrekare">Metrekare Oranlı</option>
                            <option value="Katsayi">Birim Katsayısı Bazlı</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Masraf Kalemi</label>
                        <select name="expenseItemKey" class="form-select">
                            <option value="Genel">Genel Bina Gideri</option>
                            <option value="Personel">Personel / Kapıcı / Güvenlik</option>
                            <option value="Asansor">Asansör Bakım &amp; Elektrik</option>
                            <option value="Merdiven">Merdiven Aydınlatma / Temizlik</option>
                            <option value="CopTemizlik">Çöp &amp; Çevre Temizliği</option>
                            <option value="Isinma">Isınma / Ortak Su &amp; Doğalgaz</option>
                            <option value="Demirbas">Çatı / Cephe / Demirbaş Fonu</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Dükkan Katılımı (%)</label>
                        <input type="number" step="5" min="0" max="500" name="shopParticipationPercent" class="form-control" value="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Site / Blok Kapsamı</label>
                        <select name="scopeType" class="form-select">
                            <option value="2">Sadece Bu Blok</option>
                            <option value="1">Tüm Site Geneli</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Özel Malik Payı % (Opsiyonel)</label>
                        <input type="number" step="5" min="0" max="100" name="ownerSplitPercent" class="form-control" placeholder="Boş=Standart | 100=Kiracı Muaf" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Aylık Tutar (TL) *</label>
                        <input type="number" step="0.01" name="monthlyAmount" class="form-control" required placeholder="Örn: 3500" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Ödeme Günü (Ayın Kaçı?)</label>
                        <input type="number" min="1" max="31" name="dueDayOfMonth" class="form-control" value="15" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Kurum / Firma</label>
                        <input type="text" name="providerName" class="form-control" placeholder="Enerjisa, Kone, İSKİ vb." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Abone / Sözleşme No</label>
                        <input type="text" name="subscriberNo" class="form-control" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isAutoRecurring" value="true" id="autoRecSw" checked>
                            <label class="form-check-label small fw-bold" for="autoRecSw">Her ay otomatik aidat bütçesi hesabına dahil et</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100">Sabit Bütçeye Ekle</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Gerçekleşen Fatura / Satın Alma İşle Modalı -->
    <div class="modal fade" id="newExpenseDirectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="AddExpense" asp-controller="BuildingManager" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Giderler" />
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title fw-bold">Fatura / Satın Alma &amp; Gider İşle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Bina</label>
                        <select name="buildingId" class="form-select" required>
                            @foreach (var b in buildings)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Gider / Satın Alma Açıklaması *</label>
                        <input type="text" name="description" class="form-control" required placeholder="Örn: Temizlik Malzemesi Alımı veya Çatı Aktarımı" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Tutar (TL) *</label>
                        <input type="number" step="0.01" min="0.01" name="totalAmount" class="form-control fw-bold text-danger" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Gider Grubu &amp; KMK Cari *</label>
                        <select name="expenseType" class="form-select fw-semibold">
                            <option value="2">💡 Sabit / Sarf Malzeme Alımı (Kiracı / Oturan)</option>
                            <option value="1">🔨 Demirbaş / Tadilat Satın Alma (Malik + GMSİ)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Masraf Kalemi</label>
                        <select name="expenseItemKey" class="form-select">
                            <option value="Genel">Genel Gider</option>
                            <option value="Personel">Personel / Güvenlik</option>
                            <option value="Asansor">Asansör (Muaf Hariç)</option>
                            <option value="Merdiven">Merdiven Aydınlatma / Temizlik</option>
                            <option value="CopTemizlik">Çöp &amp; Çevre Temizliği</option>
                            <option value="Isinma">Isınma / Ortak Su</option>
                            <option value="Demirbas">Demirbaş / Tadilat</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Dağıtım Kuralı</label>
                        <select name="distributionRule" class="form-select">
                            <option value="Esit">Eşit Bölüşüm</option>
                            <option value="ArsaPayi">Arsa Payı Oranlı</option>
                            <option value="Metrekare">Brüt m² Oranlı</option>
                            <option value="Katsayi">Birim Katsayısı Bazlı</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Site / Blok Kapsamı</label>
                        <select name="scopeType" class="form-select">
                            <option value="2">Bu Blok</option>
                            <option value="1">Tüm Site</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Dükkan Katılımı (%)</label>
                        <input type="number" step="5" min="0" max="500" name="shopParticipationPercent" class="form-control" value="100" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Özel Malik Payı %</label>
                        <input type="number" step="5" min="0" max="100" name="ownerSplitPercent" class="form-control" placeholder="Boş / 50 / 100" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">Fatura Belgesi (PDF / Fotoğraf)</label>
                        <input type="file" name="invoiceFile" class="form-control" accept=".pdf,image/*" />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold w-100">Kaydet &amp; Dairelere Dağıt</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Ters Kayıt Modalı -->
    <div class="modal fade" id="giderReversalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="RequestExpenseReversal" asp-controller="BuildingManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Giderler" />
                <input type="hidden" name="expenseId" id="revExpId" />
                <input type="hidden" name="buildingId" id="revBldId" />
                <div class="modal-header bg-dark text-white border-0">
                    <h5 class="modal-title fw-bold">Ters Kayıt (Fatura İptali)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-2"><strong id="revExpDesc"></strong> kaydı silinmez; ters kayıt (-) oluşturulur.</p>
                    <textarea name="reason" class="form-control" rows="2" required placeholder="İptal gerekçesi..."></textarea>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-danger rounded-pill w-100 fw-bold">Ters Kayıt Uygula</button>
                </div>
            </form>
        </div>
    </div>
}

<script>
    function openGiderReversalModal(expenseId, buildingId, desc) {
        document.getElementById('revExpId').value = expenseId;
        document.getElementById('revBldId').value = buildingId;
        document.getElementById('revExpDesc').innerText = desc;
        new bootstrap.Modal(document.getElementById('giderReversalModal')).show();
    }
</script>
