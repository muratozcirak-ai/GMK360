@{
    ViewData["Title"] = "Blog ve Haberler";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Public (Müşteri) Layout
}

<div class="container my-5">
    
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Sektörel Haberler & Makaleler</h1>
        <p class="lead text-muted">Emlak dünyasındaki son gelişmeler, ipuçları ve üyelerimize özel rehberler.</p>
    </div>

    <!-- Kategoriler -->
    <div class="d-flex justify-content-center mb-5 gap-2 flex-wrap">
        <button class="btn btn-primary rounded-pill px-4">Tümü</button>
        <button class="btn btn-outline-secondary rounded-pill px-4">Emlak Gündemi</button>
        <button class="btn btn-outline-secondary rounded-pill px-4">Yasal Mevzuat</button>
        <button class="btn btn-outline-secondary rounded-pill px-4">Dekorasyon & Tadilat</button>
        <button class="btn btn-warning rounded-pill px-4"><i class="bi bi-lock-fill"></i> Sadece Üyelere Özel</button>
    </div>

    <div class="row g-4">
        
        <!-- Örnek Makale Kartı (Public) -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-primary border-3">
                <img src="https://via.placeholder.com/400x250" class="card-img-top" alt="Blog Görseli">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">Emlak Gündemi</span>
                    <h5 class="card-title fw-bold">Konut Kredisi Faiz Oranları Düşüyor mu?</h5>
                    <p class="card-text text-muted">Merkez Bankası'nın son faiz kararı sonrası konut kredilerinde beklenen indirimler ve piyasa yansımaları...</p>
                </div>
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted"><i class="bi bi-calendar3"></i> 24 Temmuz 2026</small>
                    <a href="#" class="btn btn-sm btn-outline-primary">Devamını Oku</a>
                </div>
            </div>
        </div>

        <!-- Örnek Makale Kartı (Sadece Üye) -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-warning border-3 bg-light">
                <div class="position-relative">
                    <img src="https://via.placeholder.com/400x250" class="card-img-top opacity-50" alt="Blog Görseli">
                    <div class="position-absolute top-50 start-50 translate-middle text-center w-100">
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow"><i class="bi bi-lock-fill"></i> Üyelere Özel İçerik</span>
                    </div>
                </div>
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">Yasal Mevzuat</span>
                    <h5 class="card-title fw-bold">KBS Veri Girişinde Yapılan Kritik Hatalar</h5>
                    <p class="card-text text-muted">Günlük kiralama işletmecilerinin Emniyet bildirimlerinde sıkça düştüğü hatalar ve cezai yaptırımlar...</p>
                </div>
                <div class="card-footer bg-light border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted"><i class="bi bi-calendar3"></i> 20 Temmuz 2026</small>
                    <a href="#" class="btn btn-sm btn-warning"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
                </div>
            </div>
        </div>

    </div>

    <!-- Sosyal Medya Footer Banner -->
    <div class="bg-dark text-white rounded p-4 p-md-5 mt-5 text-center shadow">
        <h3 class="mb-3">Bizi Sosyal Medyada Takip Edin</h3>
        <p class="text-white-50 mb-4">Sektörel haberleri ve platform güncellemelerini anında öğrenmek için bizi takip etmeyi unutmayın.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="#" class="btn btn-outline-light btn-lg rounded-circle" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
            <a href="#" class="btn btn-outline-light btn-lg rounded-circle" aria-label="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
            <a href="#" class="btn btn-outline-light btn-lg rounded-circle" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
        </div>
    </div>

</div>
