@model IEnumerable<GMK360.Core.Entities.Construction.PhaseWorkerDemand>
@{
    ViewData["Title"] = "Faz İşçi Talepleri";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Faz İşçi Talepleri</h2>
        <p class="text-muted mb-0">Şantiye fazları için ileriye dönük usta ve personel talepleri</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newDemandModal">
        <i class="bi bi-megaphone-fill me-2"></i> Yeni Talep Aç
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Proje & Faz</th>
                        <th>İstenen Meslek</th>
                        <th>Kişi Sayısı</th>
                        <th>Hedef Tarih</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var demand in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@demand.ProjectPhase.Name</div>
                                <div class="small text-muted">@demand.ProjectPhase.ConstructionProject.Name</div>
                            </td>
                            <td><span class="badge bg-info text-dark">@demand.RequiredProfession</span></td>
                            <td class="fw-bold text-primary">@demand.RequiredQuantity Kişi</td>
                            <td>
                                @if (demand.TargetDate.Date == DateTime.Today)
                                {
                                    <span class="badge bg-danger">Bugün</span>
                                }
                                else if (demand.TargetDate.Date < DateTime.Today)
                                {
                                    <span class="text-danger">@demand.TargetDate.ToString("dd.MM.yyyy") (Geçti)</span>
                                }
                                else
                                {
                                    @demand.TargetDate.ToString("dd.MM.yyyy")
                                }
                            </td>
                            <td><small>@demand.Description</small></td>
                            <td>
                                @if(demand.Status == "Açık")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Açık / Bekliyor</span>
                                }
                                else if(demand.Status == "Karşılandı")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i> Karşılandı</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">İptal Edildi</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (demand.Status == "Açık")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@demand.Id" />
                                        <input type="hidden" name="status" value="Karşılandı" />
                                        <button type="submit" class="btn btn-sm btn-success" title="Karşılandı Olarak İşaretle">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline ms-1">
                                        <input type="hidden" name="id" value="@demand.Id" />
                                        <input type="hidden" name="status" value="İptal" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="İptal Et">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Açılmış herhangi bir işçi talebi bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Talep Modal -->
<div class="modal fade" id="newDemandModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title"><i class="bi bi-megaphone-fill me-2"></i> Yeni İşçi Talebi Oluştur</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hangi Proje ve Faz (Aşama) İçin? <span class="text-danger">*</span></label>
                        <select name="ProjectPhaseId" class="form-select select2-phase" required>
                            <option value="">-- Seçiniz --</option>
                            @if (ViewBag.Phases != null)
                            {
                                var projGroups = ((IEnumerable<GMK360.Core.Entities.Construction.ProjectPhase>)ViewBag.Phases)
                                                    .GroupBy(p => p.ConstructionProject.Name);
                                foreach(var group in projGroups)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach(var phase in group)
                                        {
                                            <option value="@phase.Id">@phase.Name</option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">İstenen Meslek/Uzmanlık <span class="text-danger">*</span></label>
                            <select name="RequiredProfession" class="form-select" required>
                                <option value="">-- Seçiniz --</option>
                                <option value="Düz İşçi">Düz İşçi</option>
                                <option value="Kalıp Ustası">Kalıp Ustası</option>
                                <option value="Demir Ustası">Demir Ustası</option>
                                <option value="Duvar Ustası">Duvar Ustası</option>
                                <option value="Elektrik Ustası">Elektrik Ustası</option>
                                <option value="Tesisat Ustası">Tesisat Ustası</option>
                                <option value="Boya/Sıva Ustası">Boya/Sıva Ustası</option>
                                <option value="Operatör (Kepçe/Vinç)">Operatör (Kepçe/Vinç)</option>
                                <option value="Şoför">Şoför</option>
                                <option value="Formen">Formen</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Kişi Sayısı <span class="text-danger">*</span></label>
                            <input type="number" name="RequiredQuantity" class="form-control" min="1" value="1" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hangi Tarihte Lazım? <span class="text-danger">*</span></label>
                        <input type="date" name="TargetDate" class="form-control" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama (Opsiyonel)</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Örn: 2. kat beton dökümü için acil kalıpçılar..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Talebi Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2-phase').select2({
                dropdownParent: $('#newDemandModal'),
                width: '100%'
            });
        });
    </script>
}
