@{
    ViewData["Title"] = "İş Akış Haritası";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Üst Başlık ve Özet Bilgiler -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-diagram-3-fill text-primary me-2"></i> Şantiye İş Akış Haritası</h3>
            <p class="text-muted mb-0">Beyaz Konak Apartmanı - Kat Matrisi ve Günlük Operasyonlar</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-primary rounded-pill shadow-sm fw-bold px-4">
                <i class="bi bi-magic me-1"></i> Kat Matrisini Oluştur
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- SOL PANEL: Kat Matrisi (Gantt'ın Ölümü) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-building me-2 text-info"></i> Kat & Kot İlerleme Matrisi</h5>
                        <span class="badge bg-light text-dark border">3 Şeritli Otoban: Kaba / Sabit / Seçmeli</span>
                    </div>
                </div>
                <div class="card-body px-4">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <thead class="table-light rounded-top">
                                <tr>
                                    <th class="fw-bold text-muted py-3" style="width: 15%;">KAT / KOT</th>
                                    <th class="fw-bold text-muted py-3 text-center" style="width: 28%;">KABA İNŞAAT</th>
                                    <th class="fw-bold text-muted py-3 text-center" style="width: 28%;">İNCE İŞLER (SABİT)</th>
                                    <th class="fw-bold text-muted py-3 text-center" style="width: 28%;">İNCE İŞLER (SEÇMELİ)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Örnek Satır: 2. Kat -->
                                <tr class="border-bottom">
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-layers text-secondary me-2"></i> 2. Kat
                                    </td>
                                    <td>
                                        <div class="card bg-success bg-opacity-10 border-success border-opacity-25 shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Tavan Betonu</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card bg-primary bg-opacity-10 border-primary border-opacity-25 shadow-none rounded-3 mb-1" style="cursor: pointer;">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-primary"><i class="bi bi-play-circle-fill me-1"></i> Tuğla Duvar</small>
                                                <span class="badge bg-primary mt-1" style="font-size: 0.65rem;">Aktif</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card bg-light border-light shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block text-muted"><i class="bi bi-hourglass-split me-1"></i> Bekliyor</small>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Örnek Satır: 1. Kat -->
                                <tr class="border-bottom">
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-layers text-secondary me-2"></i> 1. Kat
                                    </td>
                                    <td>
                                        <div class="card bg-success bg-opacity-10 border-success border-opacity-25 shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Tavan Betonu</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card bg-success bg-opacity-10 border-success border-opacity-25 shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Tuğla Duvar</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card bg-primary bg-opacity-10 border-primary border-opacity-25 shadow-none rounded-3 mb-1" style="cursor: pointer;">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-primary"><i class="bi bi-play-circle-fill me-1"></i> Pencereler</small>
                                                <span class="badge bg-primary mt-1" style="font-size: 0.65rem;">Aktif</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                
                                <!-- Örnek Satır: Zemin Kat -->
                                <tr>
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-layers text-secondary me-2"></i> Zemin Kat
                                    </td>
                                    <td>
                                        <div class="card bg-success bg-opacity-10 border-success border-opacity-25 shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Tamamlandı</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card bg-success bg-opacity-10 border-success border-opacity-25 shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Sıva İşleri</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card bg-warning bg-opacity-10 border-warning border-opacity-25 shadow-none rounded-3 mb-1">
                                            <div class="card-body p-2 text-center">
                                                <small class="d-block fw-bold text-warning"><i class="bi bi-pause-circle-fill me-1"></i> Seramik (Seçim Bekliyor)</small>
                                                <span class="badge bg-warning text-dark mt-1" style="font-size: 0.65rem;">Onay/Seçim</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ PANEL: Günlük Operasyon ve Şantiye Hafızası -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Günlük Operasyon</h5>
                    
                    <button class="btn btn-outline-danger w-100 rounded-pill fw-bold mb-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-plus-circle-fill me-2"></i> Acil Durum / Plan Dışı İş</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <button class="btn btn-outline-secondary w-100 rounded-pill fw-bold mb-4 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-snow2 me-2"></i> Hava Muhalefeti / Şantiye Durdur</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <!-- Şantiye Hafızası Uyarısı -->
                    <div class="alert alert-warning border-0 border-start border-4 border-warning shadow-sm rounded-3 mt-4" role="alert">
                        <div class="d-flex">
                            <div class="fs-3 text-warning me-3"><i class="bi bi-exclamation-triangle-fill"></i></div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">Şantiye Hafızası (Zemin Kat Seramik)</h6>
                                <p class="mb-0 small text-muted">Müşteri seramik modelini değiştirmişti. Usta başlamadan önce mal sahibinden mutlaka WhatsApp üzerinden teyit alın!</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Onay Bekleyen Kalite Kontroller (Gatekeepers) -->
            <div class="card border-0 shadow-sm rounded-4 border-top border-4 border-info">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-info me-2"></i> Kilit Kapıları (Kalite Kontrol)</h6>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">2. Kat Demir Vizesi</h6>
                            <p class="text-muted small mb-1">Yapı Denetim firmasının onayı bekleniyor. Onay gelmeden 2. Kat Betonu'na geçilemez.</p>
                            <a href="#" class="text-info small fw-bold text-decoration-none">Onay Belgesini Yükle -></a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
