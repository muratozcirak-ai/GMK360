@{
    ViewData["Title"] = "Aktif Fazlar (İş Akışı)";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- SAYFA BAŞLIĞI -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0 text-navy"><i class="bi bi-bar-chart-steps text-primary me-2"></i> Aktif Şantiye Fazları (İş Akışı)</h4>
            <p class="text-muted mb-0 small mt-1">Şantiyelerdeki canlı operasyonları, tamamlanan işleri ve süreç özetlerini takip edin.</p>
        </div>
        <button class="btn btn-outline-primary rounded-pill shadow-sm"><i class="bi bi-printer me-1"></i> Rapor Al</button>
    </div>

    <!-- FİLTRELEME ALANI -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label small text-muted fw-bold mb-1">Şantiye (Proje) Seçin</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-building text-primary"></i></span>
                        <select class="form-select border-start-0 bg-light fw-bold text-navy">
                            <option value="0">-- Tüm Şantiyeler (Genel Akış) --</option>
                            <option value="1" selected>Beyaz Konak Apartmanı (Ataşehir)</option>
                            <option value="2">Zümrüt Plaza (Kadıköy)</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted fw-bold mb-1">Faz (Aşama) Filtrele</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-layers text-info"></i></span>
                        <select class="form-select border-start-0 bg-light">
                            <option value="all">-- Tüm Fazlar --</option>
                            <option value="1">Faz 1: Hafriyat & Zemin</option>
                            <option value="2">Faz 2: Temel & İzolasyon</option>
                            <option value="3" selected>Faz 3: Kaba İnşaat (Kalıp/Demir/Beton)</option>
                            <option value="4">Faz 4: Duvar & Çatı</option>
                            <option value="5">Faz 5: Kaba Tesisat (Elektrik/Su)</option>
                            <option value="6">Faz 6: İnce İşler (Alçı/Boya/Seramik)</option>
                            <option value="7">Faz 7: Montaj (Mobilya/Kapı)</option>
                            <option value="8">Faz 8: Peyzaj & Teslim</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100 rounded-3 shadow-sm"><i class="bi bi-funnel me-1"></i> Filtrele</button>
                </div>
            </div>
        </div>
    </div>

    <!-- İŞ AKIŞI ZAMAN ÇİZELGESİ (TIMELINE) -->
    <div class="row">
        <div class="col-12">
            <div class="position-relative ms-3">
                <!-- Timeline Çizgisi -->
                <div class="position-absolute top-0 start-0 border-start border-3 border-primary opacity-25" style="height: 100%; margin-left: 19px;"></div>

                <!-- ITEM 1 (TAMAMLANMIŞ) -->
                <div class="position-relative mb-4">
                    <div class="position-absolute top-0 start-0 bg-success text-white rounded-circle d-flex justify-content-center align-items-center shadow" style="width: 40px; height: 40px; z-index: 2;">
                        <i class="bi bi-check-lg fs-5"></i>
                    </div>
                    <div class="ms-5 ps-3">
                        <div class="card border-0 shadow-sm rounded-4 border-start border-success border-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25"><i class="bi bi-layers-half me-1"></i> Faz 3: Kaba İnşaat</span>
                                    <span class="text-muted small"><i class="bi bi-clock me-1"></i> Bugün, 10:30</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">3. Kat Kolon Beton Dökümü Tamamlandı</h5>
                                <p class="text-muted mb-3 small">C25 sınıfı 120 mikser beton dökümü sorunsuz şekilde bitirildi. Vibratör işlemi taşeron 'Güven Beton' ekibi tarafından yapıldı.</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i> Şantiye Şefi: Ahmet K.</span>
                                    <span class="badge bg-light text-dark border"><i class="bi bi-camera me-1"></i> 3 Görsel Eklendi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ITEM 2 (DEVAM EDİYOR) -->
                <div class="position-relative mb-4">
                    <div class="position-absolute top-0 start-0 bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow" style="width: 40px; height: 40px; z-index: 2;">
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    </div>
                    <div class="ms-5 ps-3">
                        <div class="card border-0 shadow-sm rounded-4 border-start border-primary border-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 border border-primary border-opacity-25"><i class="bi bi-layers-half me-1"></i> Faz 4: Duvar Kapama</span>
                                    <span class="text-primary small fw-bold"><i class="bi bi-arrow-repeat me-1"></i> Devam Ediyor</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">Zemin Kat Ytong Örüm İşlemi</h5>
                                <p class="text-muted mb-3 small">Taşeron ekip sahada, malzeme paletleri katlara vinç ile dağıtılıyor. İskele kurulumu devam ediyor.</p>
                                <div class="progress mb-3" style="height: 10px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 45%;">45%</div>
                                </div>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark border"><i class="bi bi-hammer me-1"></i> Usta Ekibi: 8 Kişi</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ITEM 3 (PLANLANAN / BEKLEYEN) -->
                <div class="position-relative mb-4">
                    <div class="position-absolute top-0 start-0 bg-light text-muted border border-2 rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px; z-index: 2;">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                    <div class="ms-5 ps-3">
                        <div class="card border-0 shadow-sm rounded-4 border-start border-secondary border-4 bg-light bg-opacity-50">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 border border-secondary border-opacity-25"><i class="bi bi-layers-half me-1"></i> Faz 5: Kaba Tesisat</span>
                                    <span class="text-muted small"><i class="bi bi-calendar me-1"></i> Yarın Planlanıyor</span>
                                </div>
                                <h5 class="fw-bold text-muted mb-2">Zemin Kat Elektrik Tesisat Borulama</h5>
                                <p class="text-muted mb-0 small">Duvar örümü %70 oranında bittiğinde elektrikçi ekip sahaya girecek. Malzeme merkez depodan çıkış bekliyor.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
