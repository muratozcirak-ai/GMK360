@{
    ViewData["Title"] = "Proje Puantaj Defteri";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    
    var targetDate = (DateTime)ViewBag.TargetDate;
    var workers = ViewBag.Workers as IEnumerable<GMK360.Core.Entities.Construction.AgencyWorker>;
    var existingTimesheets = ViewBag.ExistingTimesheets as Dictionary<int, GMK360.Core.Entities.Construction.DailyTimesheet>;
    var projects = ViewBag.Projects as IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Günlük Puantaj Defteri</h2>
        <p class="text-muted mb-0">Ýþçilerin günlük devam durumu ve faz bazlý görevlendirmeleri</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body py-3">
        <form method="get" class="row align-items-end g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Puantaj Tarihi</label>
                <input type="date" name="date" class="form-control" value="@targetDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Sadece Þu Proje Ýçin (Opsiyonel)</label>
                <select name="projectId" class="form-select">
                    <option value="">-- Tüm Projeler --</option>
                    @foreach (var proj in projects)
                    {
                        <!option value="@proj.Id" @(ViewBag.SelectedProjectId == proj.Id ? "selected" : "")>@proj.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Getir</button>
            </div>
        </form>
    </div>
</div>

<form asp-action="SaveTimesheets" method="post">
        <input type="hidden" name="sourceProjectId" value="@ViewBag.Project?.Id" />
    <input type="hidden" name="targetDate" value="@targetDate.ToString("yyyy-MM-dd")" />
    
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Personel / Usta</th>
                            <th>Çalýþtýðý Yer (Faz)</th>
                            <th style="width: 150px;">Durum</th>
                            <th style="width: 120px;">Hak Ediþ (?)</th>
                            <th style="width: 120px;">Avans (?)</th>
                            <th>Notlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var worker in workers)
                        {
                            var t = existingTimesheets.ContainsKey(worker.Id) ? existingTimesheets[worker.Id] : null;
                            var status = t != null ? t.AttendanceStatus : "Gelmedi";
                            var phaseId = t?.ProjectPhaseId ?? 0;
                            var wage = t?.EarnedWage ?? (status == "Tam Gün" ? worker.DefaultDailyWage : 0);
                            var advance = t?.AdvancePayment ?? 0;
                            var notes = t?.Notes ?? "";

                            <tr>
                                <td class="ps-4">
                                    <input type="hidden" name="workerIds" value="@worker.Id" />
                                    <div class="fw-bold">@worker.FullName</div>
                                    <div class="small text-muted">@worker.Profession</div>
                                </td>
                                <td>
                                    <select name="phaseIds" class="form-select form-select-sm phase-select">
                                        <option value="0">-- Yok / Boþta --</option>
                                        @foreach(var p in projects)
                                        {
                                            <optgroup label="@p.Name">
                                                @if(p.Phases != null)
                                                {
                                                    foreach(var phase in p.Phases)
                                                    {
                                                        <!option value="@phase.Id" @(phase.Id == phaseId ? "selected" : "")>@phase.Name</!option>
                                                    }
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="statuses" class="form-select form-select-sm status-select" data-default-wage="@worker.DefaultDailyWage">
                                        <!option value="Gelmedi" @(status == "Gelmedi" ? "selected" : "")>Gelmedi</!option>
                                        <!option value="Tam Gün" @(status == "Tam Gün" ? "selected" : "")>Tam Gün</!option>
                                        <!option value="Yarým Gün" @(status == "Yarým Gün" ? "selected" : "")>Yarým Gün</!option>
                                        <!option value="Ýzinli" @(status == "Ýzinli" ? "selected" : "")>Ýzinli (Ücretli)</!option>
                                        <!option value="Raporlu" @(status == "Raporlu" ? "selected" : "")>Raporlu</!option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="wages" class="form-control form-control-sm wage-input" value="@wage.ToString("0.##")" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" name="advances" class="form-control form-control-sm text-danger fw-bold" value="@advance.ToString("0.##")" placeholder="0" />
                                </td>
                                <td>
                                    <input type="text" name="notes" class="form-control form-control-sm" value="@notes" placeholder="Ek açýklama..." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="d-flex justify-content-end mb-5">
        <button type="submit" class="btn btn-success btn-lg px-5 shadow">
            <i class="bi bi-save2-fill me-2"></i> Puantajlarý Kaydet
        </button>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.status-select').change(function() {
                var $row = $(this).closest('tr');
                var status = $(this).val();
                var defaultWage = parseFloat($(this).data('default-wage')) || 0;
                var $wageInput = $row.find('.wage-input');
                var $phaseSelect = $row.find('.phase-select');

                if (status === 'Tam Gün') {
                    $wageInput.val(defaultWage);
                } else if (status === 'Yarým Gün') {
                    $wageInput.val(defaultWage / 2);
                } else if (status === 'Ýzinli') {
                    $wageInput.val(defaultWage);
                    $phaseSelect.val('0'); // Fazda çalýþmýyor
                } else {
                    $wageInput.val(0);
                    $phaseSelect.val('0');
                }
            });
        });
    </script>
}


