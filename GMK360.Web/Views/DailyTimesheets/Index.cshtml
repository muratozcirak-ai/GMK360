@model IEnumerable<GMK360.Core.Entities.Construction.DailyTimesheet>
@{
    ViewData["Title"] = "Tüm Þantiyeler Puantaj Özeti";
    Layout = "_ConstructionLayout";
    DateTime targetDate = ViewBag.TargetDate;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-calendar-check-fill text-primary me-2"></i>Tüm Þantiyeler Puantaj Özeti</h2>
        <p class="text-muted mb-0">Bugün hangi þantiyede kaç iþçi çalýþýyor, toplam yevmiye maliyeti nedir?</p>
    </div>
    <div>
        <form action="/DailyTimesheets/Index" method="get" class="d-flex gap-2">
            <input type="date" name="date" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
        </form>
    </div>
</div>

<div class="alert alert-info rounded-4 border-0 shadow-sm">
    <i class="bi bi-info-circle-fill me-2"></i> <b>Bilgi:</b> Günlük puantaj veri giriþi (iþçi ekleme/düzenleme) artýk doðrudan ilgili <b>Proje Panosu (Þantiye)</b> içerisindeki <b>Proje Puantajý</b> sekmesinden yapýlmaktadýr. Bu ekran sadece genel özeti gösterir.
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
            <div class="card-body text-center py-4">
                <h6 class="text-white-50 text-uppercase">Toplam Çalýþan (Bugün)</h6>
                <h1 class="fw-bold mb-0 display-4">@Model.Count(m => m.ProjectPhaseId != null)</h1>
                <small>Þantiyelere daðýlmýþ aktif personel</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
            <div class="card-body text-center py-4">
                <h6 class="text-white-50 text-uppercase">Toplam Yevmiye Maliyeti (Bugün)</h6>
                <h1 class="fw-bold mb-0 display-5">@Model.Sum(m => m.EarnedWage).ToString("N0") ?</h1>
                <small>Bugünkü çalýþmanýn toplam hak ediþi</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark h-100">
            <div class="card-body text-center py-4">
                <h6 class="text-muted text-uppercase">Verilen Günlük Avans</h6>
                <h1 class="fw-bold mb-0 display-5">@Model.Sum(m => m.AdvancePayment).ToString("N0") ?</h1>
                <small>Elden/Hesaba verilen günlük nakit</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mt-4">
    <div class="card-header bg-white border-bottom-0 pt-4">
        <h5 class="fw-bold mb-0">Proje Bazlý Daðýlým (@targetDate.ToString("dd.MM.yyyy"))</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Proje Adý</th>
                        <th>Çalýþan Ýþçi Sayýsý</th>
                        <th>Toplam Yevmiye Maliyeti</th>
                        <th class="text-end pe-4">Ýþlem</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var grouped = Model
                            .Where(m => m.ProjectPhase != null && m.ProjectPhase.ConstructionProject != null)
                            .GroupBy(m => m.ProjectPhase.ConstructionProject)
                            .ToList();
                    }
                    @if (!grouped.Any())
                    {
                        <tr><td colspan="4" class="text-center py-5 text-muted">Bu tarih için þantiyelerde puantaj kaydý bulunmuyor.</td></tr>
                    }
                    @foreach (var g in grouped)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@g.Key.Name</td>
                            <td><span class="badge bg-primary rounded-pill px-3 fs-6">@g.Count() Kiþi</span></td>
                            <td class="text-danger fw-bold">@g.Sum(x => x.EarnedWage).ToString("N2") ?</td>
                            <td class="text-end pe-4">
                                <a href="/DailyTimesheets/ProjectTimesheet/@g.Key.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-pencil-square me-1"></i> Puantaja Git
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
