@model IEnumerable<GMK360.Core.Entities.Construction.DailyTimesheet>
@{
    ViewData["Title"] = "Şantiye Günlük Puantaj & Giderler";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h4 class="mb-0">Günlük Puantaj ve Saha Giderleri (Elden Ödemeler)</h4>
            <p class="text-muted">Proje bazlı personel yoklaması ve belge bekleyen şantiye giderlerini buradan takip edebilirsiniz.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Proje Seçin</label>
                    <select name="projectId" class="form-select" asp-items="ViewBag.Projects" required>
                        <option value="">-- Proje Seçiniz --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Puantaj Tarihi</label>
                    <input type="date" name="workDate" class="form-control" value="@ViewBag.CurrentDate" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Getir</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
    }

    @if (ViewBag.CurrentProjectId != null && Model != null)
    {
        <form asp-action="SaveTimesheets" method="post">
            <input type="hidden" name="projectId" value="@ViewBag.CurrentProjectId" />
            <input type="hidden" name="workDate" value="@ViewBag.CurrentDate" />
            
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0 align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Ad Soyad (Uzmanlık)</th>
                                    <th width="150">Yoklama Durumu</th>
                                    <th width="200">Bağlı Olduğu Faz (Aşama)</th>
                                    <th width="200">Belge Bekleyen Saha Gideri (TL)</th>
                                    <th>Gider Açıklaması (Örn: Beton Mesaisi)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var index = 0; }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" name="workerIds[@index]" value="@item.AgencyWorkerId" />
                                            <strong>@item.AgencyWorker?.FullName</strong> <br/>
                                            <small class="text-muted">@item.AgencyWorker?.Profession</small>
                                        </td>
                                        <td>
                                            <select name="attendance[@index]" class="form-select form-select-sm">
                                                <option value="Tam Gün" selected="@(item.AttendanceStatus == "Tam Gün")">Tam Gün</option>
                                                <option value="Yarım Gün" selected="@(item.AttendanceStatus == "Yarım Gün")">Yarım Gün</option>
                                                <option value="Gelmedi" selected="@(item.AttendanceStatus == "Gelmedi")">Gelmedi</option>
                                                <option value="İzinli" selected="@(item.AttendanceStatus == "İzinli")">İzinli</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select name="selectedPhases[@index]" class="form-select form-select-sm">
                                                <option value="">-- Faz Bağımsız --</option>
                                                @foreach (var phase in ViewBag.Phases ?? new List<string>())
                                                {
                                                    <option value="@phase" selected="@(item.PhaseName == phase)">@phase</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">₺</span>
                                                <input type="number" step="0.01" name="pendingFieldExpenses[@index]" class="form-control" value="@item.PendingFieldExpense.ToString("0.##")" />
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" name="fieldExpenseDesc[@index]" class="form-control form-control-sm" value="@item.FieldExpenseDescription" placeholder="Örn: Yağmur öncesi acil beton..." />
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Puantaj ve Masrafları Kaydet
                    </button>
                </div>
            </div>
        </form>
    }
</div>