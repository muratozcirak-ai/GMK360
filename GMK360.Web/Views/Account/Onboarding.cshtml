@{
    ViewData["Title"] = "Profilinizi Tamamlayın";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="onboarding-page py-5" style="background-color: #f8fafc; min-height: calc(100vh - 80px);">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="fw-bold text-navy" style="letter-spacing: -1px;">GMK360 Ekosistemine Hoş Geldiniz</h2>
                <p class="text-muted fs-5">Platformu hangi amaçla kullanacağınızı seçerek kişiselleştirilmiş deneyiminizi başlatın.</p>
            </div>
        </div>

        <div class="row bg-white rounded-4 shadow-sm overflow-hidden" style="min-height: 600px;">
            <!-- Sol Menü: Adımlar -->
                        <div class="col-md-3 p-0" style="background-color: #f1f5f9; border-right: 1px solid #e2e8f0;">
                <ul class="wizard-steps list-unstyled m-0 p-4">
                    @if (!Model.IsShadowAccount) {
                    <li class="step-item active mb-4" data-step="1">
                        <div class="d-flex align-items-center">
                            <div class="step-icon me-3 d-flex justify-content-center align-items-center rounded-circle" style="width: 40px; height: 40px; background-color: #f97316; color: white; font-weight: bold;">1</div>
                            <div>
                                <h6 class="mb-0 fw-bold">Modül Seçimi</h6>
                                <small class="text-muted">Kullanım Amacınız</small>
                            </div>
                        </div>
                    </li>
                    }
                    <li class="step-item mb-4 @(Model.IsShadowAccount ? "active" : "")" data-step="2">
                        <div class="d-flex align-items-center">
                            <div class="step-icon me-3 d-flex justify-content-center align-items-center rounded-circle" style="width: 40px; height: 40px; background-color: @(Model.IsShadowAccount ? "#f97316" : "#cbd5e1"); color: white; font-weight: bold;">2</div>
                            <div>
                                <h6 class="mb-0 fw-bold">Kişisel Doğrulama</h6>
                                <small class="text-muted">Güvenlik Adımları</small>
                            </div>
                        </div>
                    </li>
                    <li class="step-item" id="stepSummaryMenu" data-step="3">
                        <div class="d-flex align-items-center">
                            <div class="step-icon me-3 d-flex justify-content-center align-items-center rounded-circle" style="width: 40px; height: 40px; background-color: #cbd5e1; color: white; font-weight: bold;"><i class="ph ph-check"></i></div>
                            <div>
                                <h6 class="mb-0 fw-bold">Özet & Onay</h6>
                                <small class="text-muted">Tamamlanma</small>
                            </div>
                        </div>
                    </li>
                </ul>
            </div><!-- Sağ Taraf: İçerik Alanı -->
            <div class="col-md-9 p-5 position-relative">
                                <form id="onboardingForm" asp-action="Onboarding" method="post">
                    
                    @if (Model.IsShadowAccount) {
                        <input type="hidden" name="SelectedUserType" value="Individual" />
                        <div class="wizard-pane d-none" id="pane-1"></div>
                    } else {
                    <!-- ADIM 1: Modül Seçimi -->
                    <div class="wizard-pane active" id="pane-1">
                        <h4 class="mb-4 fw-bold text-navy">Hangi modüllerden yararlanmak istiyorsunuz?</h4>
                        <p class="text-muted mb-4">İhtiyacınıza uyan birden fazla modül seçebilirsiniz. Tüm hesaplar ilk 1 ay ücretsizdir.</p>
                        
                        <div class="row g-3">
                            <!-- Bina Yönetimi -->
                            <div class="col-md-6">
                                <label class="module-card border rounded p-4 d-block position-relative cursor-pointer hover-lift" for="mod-bina">
                                    <input type="checkbox" name="SelectedModules" value="BinaYonetimi" id="mod-bina" class="module-checkbox d-none" onchange="updateDynamicSteps()">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <i class="ph-fill ph-buildings fs-1 text-primary mb-3"></i>
                                        <span class="badge bg-primary rounded-pill">Standart Paket</span>
                                    </div>
                                    <h5 class="fw-bold text-navy">Bina & Site Yönetimi</h5>
                                    <p class="text-muted small mb-0">Apartman aidat takibi, gelir-gider raporlaması ve dijital karar defteri özellikleri.</p>
                                    <div class="check-indicator position-absolute top-0 end-0 m-3 d-none"><i class="ph-fill ph-check-circle text-success fs-3"></i></div>
                                </label>
                            </div>
                            
                            <!-- Dijital Evim -->
                            <div class="col-md-6">
                                <label class="module-card border rounded p-4 d-block position-relative cursor-pointer hover-lift" for="mod-evim">
                                    <input type="checkbox" name="SelectedModules" value="DijitalEvim" id="mod-evim" class="module-checkbox d-none" onchange="updateDynamicSteps()">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <i class="ph-fill ph-house-line fs-1 text-success mb-3"></i>
                                        <span class="badge bg-success rounded-pill">Ücretsiz</span>
                                    </div>
                                    <h5 class="fw-bold text-navy">Dijital Evim (Sakin/Sahip)</h5>
                                    <p class="text-muted small mb-0">Kendi mülkünüzün veya kiracısı olduğunuz dairenin borç ödeme ve talep yönetimi.</p>
                                    <div class="check-indicator position-absolute top-0 end-0 m-3 d-none"><i class="ph-fill ph-check-circle text-success fs-3"></i></div>
                                </label>
                            </div>

                            <!-- Hizmet & Usta -->
                            <div class="col-md-6">
                                <label class="module-card border rounded p-4 d-block position-relative cursor-pointer hover-lift" for="mod-hizmet">
                                    <input type="checkbox" name="SelectedModules" value="HizmetSaglayici" id="mod-hizmet" class="module-checkbox d-none" onchange="updateDynamicSteps()">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <i class="ph-fill ph-wrench fs-1 text-warning mb-3"></i>
                                        <span class="badge bg-warning text-dark rounded-pill">Komisyonlu</span>
                                    </div>
                                    <h5 class="fw-bold text-navy">Profesyonel Hizmet (Usta)</h5>
                                    <p class="text-muted small mb-0">Tesisat, boya, temizlik gibi hizmetler vererek sitedeki sakinlerden talep toplayın.</p>
                                    <div class="check-indicator position-absolute top-0 end-0 m-3 d-none"><i class="ph-fill ph-check-circle text-success fs-3"></i></div>
                                </label>
                            </div>

                            <!-- Günlük Kiralama -->
                            <div class="col-md-6">
                                <label class="module-card border rounded p-4 d-block position-relative cursor-pointer hover-lift" for="mod-kiralama">
                                    <input type="checkbox" name="SelectedModules" value="GunlukKiralama" id="mod-kiralama" class="module-checkbox d-none" onchange="updateDynamicSteps()">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <i class="ph-fill ph-calendar-check fs-1 text-info mb-3"></i>
                                        <span class="badge bg-info rounded-pill">Komisyonlu</span>
                                    </div>
                                    <h5 class="fw-bold text-navy">Kısa Dönem / Pansiyon</h5>
                                    <p class="text-muted small mb-0">Evinizi, odanızı veya pansiyonunuzu günlük/haftalık kiralamaya açın.</p>
                                    <div class="check-indicator position-absolute top-0 end-0 m-3 d-none"><i class="ph-fill ph-check-circle text-success fs-3"></i></div>
                                </label>
                            </div>
                        </div>
                        
                        <div class="text-end mt-5 border-top pt-3">
                            <button type="button" class="btn btn-orange px-5 py-2 fw-bold rounded-pill shadow-sm" onclick="nextStep(1)">Devam Et <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>

                                        <!-- ADIM 2: Doğrulama -->
                    }
                    <div class="wizard-pane @(Model.IsShadowAccount ? "active" : "d-none")" id="pane-2">
                        <h4 class="mb-4 fw-bold text-navy">Hesap Güvenliğiniz İçin Doğrulama</h4>
                        <p class="text-muted mb-4">Sistemimizde sahte işlemleri engellemek için telefon numarası doğrulaması zorunludur.</p>

                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input type="text" class="form-control premium-input" id="Phone" name="Phone" placeholder="05XX XXX XX XX" required>
                                    <label for="Phone"><i class="ph ph-phone me-2"></i>Cep Telefonu Numaranız</label>
                                </div>
                            </div>
                            
                            <div class="col-md-12">
                                <div class="alert alert-info d-flex mb-0" role="alert">
                                    <i class="ph-fill ph-info fs-4 me-3 text-info"></i>
                                    <div>
                                        <strong>SMS Doğrulaması:</strong> Demo sürecinde telefonunuza gerçekten SMS gitmeyecektir. Rastgele bir telefon girip devam edebilirsiniz.
                                    </div>
                                </div>
                            </div>

                            <hr class="border-light-subtle my-4" />
                            
                            <h5 class="fw-bold text-navy mb-2">Dijital İmza (İşlem Şifresi)</h5>
                            <p class="text-muted small mb-3">Sistem içindeki kritik işlemlerde (oylama, sözleşme onayı, bakiye transferi) kullanılmak üzere 6 haneli bir işlem şifresi (PIN) belirleyin. Bu sizin dijital imzanız yerine geçer.</p>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="password" class="form-control premium-input text-center fs-4 letter-spacing-2" id="TransactionPin" name="TransactionPin" placeholder="******" maxlength="6" pattern="\d{6}" required>
                                    <label for="TransactionPin"><i class="ph ph-lock-key me-2"></i>6 Haneli PIN Belirleyin</label>
                                </div>
                                <small class="text-muted">Sadece rakamlardan oluşmalıdır.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5 border-top pt-3">
                                                        @if (!Model.IsShadowAccount) {
                                <button type="button" class="btn btn-outline-secondary px-4 fw-bold rounded-pill" onclick="prevStep(2)"><i class="ph ph-arrow-left me-2"></i> Geri</button>
                            } else {
                                <div></div>
                            }
                            <button type="button" class="btn btn-orange px-5 py-2 fw-bold rounded-pill shadow-sm" onclick="nextStep(2)">Devam Et <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>

                    <!-- ADIM 3: Özet -->
                    <div class="wizard-pane d-none" id="pane-3">
                        <h4 class="mb-4 fw-bold text-navy">Harika! Son bir adım kaldı.</h4>
                        <p class="text-muted mb-4">Seçimlerinizi kontrol edin ve kayıt işlemini tamamlayın.</p>

                        <div class="bg-light rounded p-4 mb-4">
                            <h6 class="fw-bold mb-3 border-bottom pb-2">Seçilen Modüller:</h6>
                            <ul id="summaryList" class="list-unstyled mb-0">
                                <!-- JavaScript ile doldurulacak -->
                            </ul>
                        </div>
                        
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" value="true" id="terms" required>
                            <label class="form-check-label text-muted small" for="terms">
                                <a href="#" class="text-primary text-decoration-none">Kullanıcı Sözleşmesi</a>'ni ve <a href="#" class="text-primary text-decoration-none">Aydınlatma Metni</a>'ni okudum, onaylıyorum.
                            </label>
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <button type="button" class="btn btn-outline-secondary px-4 fw-bold rounded-pill" onclick="prevStep(3)"><i class="ph ph-arrow-left me-2"></i> Geri</button>
                            <button type="submit" class="btn btn-navy px-5 py-2 fw-bold rounded-pill shadow-sm"><i class="ph ph-check-circle me-2"></i> Kurulumu Tamamla</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .module-card { transition: all 0.2s ease-in-out; border: 2px solid transparent !important; }
    .module-card:hover { border-color: #cbd5e1 !important; transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1) !important; }
    .module-checkbox:checked + div + h5 + p + .check-indicator { display: block !important; }
    .module-checkbox:checked ~ div > i { color: #f97316 !important; }
    
    .cursor-pointer { cursor: pointer; }
    .premium-input { border-radius: 8px; border: 1px solid #cbd5e1; background-color: #f8fafc; }
    .premium-input:focus { border-color: #f97316; box-shadow: 0 0 0 0.25rem rgba(249, 115, 22, 0.25); background-color: #fff; }
</style>

@section Scripts {
    <script>
        // Basit Wizard Navigasyonu
        function nextStep(currentStep) {
            let selected = document.querySelectorAll('input[name="SelectedModules"]:checked').length;
            if (currentStep === 1 && selected === 0) {
                alert("Lütfen en az bir modül seçiniz.");
                return;
            }
            
            document.getElementById('pane-' + currentStep).classList.add('d-none');
            document.getElementById('pane-' + currentStep).classList.remove('active');
            
            let nextId = currentStep + 1;
            document.getElementById('pane-' + nextId).classList.remove('d-none');
            document.getElementById('pane-' + nextId).classList.add('active');
            
            // Update Menu
            document.querySelector('.step-item[data-step="' + currentStep + '"] .step-icon').style.backgroundColor = '#cbd5e1';
            document.querySelector('.step-item[data-step="' + nextId + '"] .step-icon').style.backgroundColor = '#f97316';
            
            if(nextId === 3) {
                buildSummary();
            }
        }

        function prevStep(currentStep) {
            document.getElementById('pane-' + currentStep).classList.add('d-none');
            document.getElementById('pane-' + currentStep).classList.remove('active');
            
            let prevId = currentStep - 1;
            document.getElementById('pane-' + prevId).classList.remove('d-none');
            document.getElementById('pane-' + prevId).classList.add('active');
            
            // Update Menu
            document.querySelector('.step-item[data-step="' + currentStep + '"] .step-icon').style.backgroundColor = '#cbd5e1';
            document.querySelector('.step-item[data-step="' + prevId + '"] .step-icon').style.backgroundColor = '#f97316';
        }

        function updateDynamicSteps() {
            // Görsel geribildirim için seçili olanların kenarlığını turuncu yap
            document.querySelectorAll('.module-card').forEach(card => {
                card.style.borderColor = 'transparent';
                card.style.backgroundColor = '#fff';
            });
            document.querySelectorAll('input[name="SelectedModules"]:checked').forEach(checkbox => {
                let card = checkbox.closest('.module-card');
                card.style.borderColor = '#f97316';
                card.style.backgroundColor = '#fff7ed';
            });
        }
        
                function buildSummary() {
            let list = document.getElementById('summaryList');
            list.innerHTML = '';
            
            let isShadow = '@Model.IsShadowAccount.ToString().ToLower()' === 'true';
            if (isShadow) {
                list.innerHTML = '<li class="mb-2 d-flex align-items-center"><i class="ph-fill ph-check-circle text-success me-2"></i> Sakin / Kiracı Hesabı (Bireysel)</li>';
                return;
            }

            document.querySelectorAll('input[name="SelectedModules"]:checked').forEach(checkbox => {
                let title = checkbox.closest('.module-card').querySelector('h5').innerText;
                list.innerHTML += <li class="mb-2 d-flex align-items-center"><i class="ph-fill ph-check-circle text-success me-2"></i> </li>;
            });
        });
        }
    </script>
}











