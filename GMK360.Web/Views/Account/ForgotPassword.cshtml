@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white p-4 border-0">
            <h4 class="fw-bold mb-1"><i class="ph ph-key me-2 text-warning"></i>Şifremi Unuttum</h4>
            <p class="small text-white-50 mb-0">Kayıtlı e-posta adresinizi yazın; şifre yenileme bağlantısını hemen gönderelim.</p>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success rounded-3 border-0 small fw-semibold">
                    <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.SuccessMessage
                </div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger rounded-3 border-0 small fw-semibold">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.ErrorMessage
                </div>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-bold small">E-Posta Adresi *</label>
                    <input type="email" name="email" class="form-control form-control-lg" required placeholder="ornek@gmk360.com" autocomplete="email" />
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">
                    <i class="ph ph-paper-plane-tilt me-1"></i> Sıfırlama Bağlantısı Gönder
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <a href="/Account/Login" class="text-decoration-none small fw-semibold">&larr; Giriş Ekranına Dön</a>
            </div>
        </div>
    </div>
</div>
