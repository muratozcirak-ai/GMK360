@model GMK360.Core.Entities.Identity.ApplicationUser
@{
    ViewData["Title"] = "Doğrulama Gerekiyor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 pt-5 pb-2 text-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mb-3" style="width: 80px; height: 80px;">
                        <i class="ph ph-shield-check display-4"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Doğrulama Gerekiyor</h3>
                    <p class="text-muted px-4">İlan verebilmeniz için hesabınızı doğrulamanız gerekmektedir. <br/> Doğrulama işlemi sadece <strong>tek seferliğine</strong> yapılır, sonraki ilanlarınızda tekrar istenmez.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    
                    <!-- Step 1: Phone -->
                    <div class="d-flex align-items-center mb-4 p-3 border rounded-3 @(Model.PhoneNumberConfirmed ? "bg-success bg-opacity-10 border-success" : "")" style="transition: all 0.3s ease;">
                        <div class="me-3">
                            @if(Model.PhoneNumberConfirmed)
                            {
                                <i class="ph-fill ph-check-circle text-success display-6"></i>
                            }
                            else
                            {
                                <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">1</div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">Telefon Doğrulaması</h6>
                            <p class="text-muted small mb-0" style="line-height:1.4;">
                                @if(Model.PhoneNumberConfirmed)
                                {
                                    <span class="text-success"><i class="ph ph-check"></i> Doğrulandı: @Model.PhoneNumber</span>
                                }
                                else
                                {
                                    <span>İletişim bilgilerinizin güvenliği için gereklidir.</span>
                                }
                            </p>
                        </div>
                        <div>
                            @if(!Model.PhoneNumberConfirmed)
                            {
                                <a href="#" class="btn btn-outline-dark btn-sm fw-bold px-4 rounded-pill">Doğrula</a>
                            }
                        </div>
                    </div>

                    <!-- Step 2: E-Devlet -->
                    <div class="d-flex align-items-center mb-2 p-3 border rounded-3 @(Model.IsEDevletVerified ? "bg-success bg-opacity-10 border-success" : (Model.PhoneNumberConfirmed ? "border-primary" : "opacity-50"))" style="transition: all 0.3s ease;">
                        <div class="me-3">
                            @if(Model.IsEDevletVerified)
                            {
                                <i class="ph-fill ph-check-circle text-success display-6"></i>
                            }
                            else
                            {
                                <div class="@(Model.PhoneNumberConfirmed ? "bg-primary" : "bg-secondary") text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">2</div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">e-Devlet Doğrulaması</h6>
                            <p class="text-muted small mb-0" style="line-height:1.4;">
                                @if(Model.IsEDevletVerified)
                                {
                                    <span class="text-success"><i class="ph ph-check"></i> Kimlik bilgileri doğrulandı.</span>
                                }
                                else
                                {
                                    <span>Sahte ilanların önüne geçmek için NVİ üzerinden T.C. Kimlik doğrulamanız yapılır.</span>
                                }
                            </p>
                        </div>
                        <div>
                            @if(!Model.IsEDevletVerified && Model.PhoneNumberConfirmed)
                            {
                                <a href="#" class="btn btn-primary btn-sm fw-bold px-4 rounded-pill">Doğrula</a>
                            }
                            else if(!Model.IsEDevletVerified && !Model.PhoneNumberConfirmed)
                            {
                                <button class="btn btn-secondary btn-sm fw-bold px-3 rounded-pill" disabled style="font-size:0.8rem;">Önce Telefon</button>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
