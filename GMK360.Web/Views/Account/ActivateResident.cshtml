@model GMK360.Core.Entities.Identity.ApplicationUser
@{
    ViewData["Title"] = "Hesap Doğrulama, Şifre & Kişisel PIN Kurulumu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var units = ViewBag.LinkedUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var linkedStaffs = ViewBag.LinkedStaffs as List<GMK360.Core.Entities.BuildingStaff> ?? new List<GMK360.Core.Entities.BuildingStaff>();
    bool isStaff = ViewBag.IsStaffActivation == true;
    string token = ViewBag.Token as string ?? "";
    var primaryStaff = linkedStaffs.FirstOrDefault();
    string? knownTc = !string.IsNullOrWhiteSpace(Model.TcIdentityNo) ? Model.TcIdentityNo : primaryStaff?.TcIdentityNo;
    string? knownEmail = Model.Email != null && !Model.Email.EndsWith("@gmk360.local") ? Model.Email : null;
}

<div class="container py-5 mt-4" style="max-width: 720px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header @(isStaff ? "bg-primary" : "bg-success") text-white p-4 border-0">
            <h4 class="fw-bold mb-1 text-white">
                <i class="bi bi-shield-lock-fill me-2"></i>@(isStaff ? "Personel İlk Giriş — Şifre, Gizli PIN & Adres Kurulumu" : "Kişisel Profil & Güvenlik Aktivasyonu")
            </h4>
            <p class="small mb-0 opacity-75">
                @(isStaff
                    ? "Kimlik bilgileriniz yönetim tarafından kaydedilmiştir. Lütfen ikametgah adresinizi seçin, kalıcı şifrenizi ve yalnızca sizin bileceğiniz PIN kodunuzu belirleyin."
                    : "E-posta doğrulamanızı tamamlayın, kendi giriş şifrenizi ve yalnızca sizin bileceğiniz onay PIN'inizi belirleyin.")
            </p>
        </div>
        <div class="card-body p-4">
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info rounded-3 small mb-3">@TempData["InfoMessage"]</div>
            }
            @if (linkedStaffs.Any())
            {
                <div class="alert alert-primary bg-opacity-10 border-primary-subtle rounded-3 small mb-3">
                    <strong>Bağlı Olduğunuz Görev / Kadrolar:</strong>
                    <div class="mt-1 d-flex flex-wrap gap-1 mb-2">
                        @foreach (var st in linkedStaffs)
                        {
                            string scopeLabel = st.IsSiteWide && (st.HousingComplex != null || st.Building?.HousingComplex != null)
                                ? $"{(st.HousingComplex?.Name ?? st.Building?.HousingComplex?.Name)} (Site Geneli)"
                                : (st.Building?.Name ?? "Tesis");
                            <span class="badge bg-primary text-white">
                                🏢 @scopeLabel — @st.RoleType@(!string.IsNullOrWhiteSpace(st.JobDescription) ? $" ({st.JobDescription})" : "")
                            </span>
                        }
                    </div>
                    <div class="border-top pt-2 text-dark">
                        <strong>Kayıtlı Personel Bilgisi:</strong> @Model.FullName
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber)) { <span> • Tel: <b>@Model.PhoneNumber</b></span> }
                        @if (!string.IsNullOrWhiteSpace(knownTc)) { <span> • TC: <b>@knownTc</b></span> }
                        @if (!string.IsNullOrWhiteSpace(knownEmail)) { <span> • E-Posta: <b>@knownEmail</b></span> }
                    </div>
                </div>
            }
            @if (units.Any())
            {
                <div class="alert alert-light border rounded-3 small mb-4">
                    <strong>Bağlı Olduğunuz Bağımsız Bölümler:</strong>
                    <div class="mt-1 d-flex flex-wrap gap-1">
                        @foreach (var u in units)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @(u.Building?.Name ?? "Bina") — No: @u.DoorNumber (@(u.OwnerUserId == Model.Id ? "Malik" : "Kiracı"))
                            </span>
                        }
                    </div>
                </div>
            }

            @if (ViewBag.ActivationError != null)
            {
                <div class="alert alert-danger rounded-3 small">@ViewBag.ActivationError</div>
            }

            <form asp-action="ActivateResident" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@token" />

                @if (!isStaff)
                {
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Ad *</label>
                            <input type="text" name="firstName" class="form-control" value="@Model.FirstName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Soyad *</label>
                            <input type="text" name="lastName" class="form-control" value="@Model.LastName" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">E-Posta Adresiniz *</label>
                            <input type="email" name="email" class="form-control" value="@(knownEmail ?? "")" required placeholder="ornek@mail.com" />
                            <small class="text-success" style="font-size:.72rem;"><i class="bi bi-envelope-check me-1"></i>Giriş ve bilgilendirmeler için kullanılır.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Cep Telefonunuz (Opsiyonel)</label>
                            <input type="text" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="05XX XXX XX XX" />
                            <input type="hidden" name="confirmPhoneDeclaration" value="true" />
                            <small class="text-muted" style="font-size:.72rem;">İsteğe bağlı; acil duyuru ve arıza takibi için.</small>
                        </div>
                    </div>
                }

                @if (isStaff)
                {
                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <label class="form-label fw-bold small text-dark mb-2">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>Yapılandırılmış Gerçek İkametgah Adresiniz *
                        </label>
                        @{
                            var actAddrVd = new ViewDataDictionary(ViewData)
                            {
                                ["AddressPrefix"] = "act",
                                ["AddressRequired"] = true,
                                ["AddressCityId"] = Model.AddressCityId ?? primaryStaff?.AddressCityId,
                                ["AddressDistrictId"] = Model.AddressDistrictId ?? primaryStaff?.AddressDistrictId,
                                ["AddressNeighborhoodId"] = Model.AddressNeighborhoodId ?? primaryStaff?.AddressNeighborhoodId,
                                ["AddressStreetId"] = Model.AddressStreetId ?? primaryStaff?.AddressStreetId,
                                ["AddressStreetName"] = Model.AddressStreetName ?? primaryStaff?.AddressStreetName,
                                ["AddressBuildingNo"] = Model.AddressBuildingNo ?? primaryStaff?.AddressBuildingNo,
                                ["AddressApartmentNo"] = Model.AddressApartmentNo ?? primaryStaff?.AddressApartmentNo,
                                ["AddressFormatted"] = Model.Address ?? primaryStaff?.Address
                            };
                        }
                        @await Html.PartialAsync("_StructuredAddressPartial", null, actAddrVd)
                    </div>
                }

                <hr class="my-3" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Yeni Giriş Şifreniz *</label>
                        <input type="password" name="newPassword" class="form-control" required minlength="8" placeholder="Örn: Site2026!" />
                        <small class="text-muted" style="font-size:.72rem;">En az 8 karakter (büyük/küçük harf, rakam ve !.* gibi bir sembol).</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Şifre Tekrar *</label>
                        <input type="password" name="confirmPassword" class="form-control" required minlength="8" placeholder="Aynı şifreyi tekrar yazın" />
                    </div>
                </div>

                <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning-subtle mb-3">
                    <label class="form-label fw-bold small text-dark mb-1">
                        <i class="bi bi-key-fill text-warning me-1"></i>Hızlı Giriş &amp; Onay PIN Kodunuz (4-6 Rakam) *
                    </label>
                    <input type="password" inputmode="numeric" pattern="[0-9]{4,6}" maxlength="6" name="personalPin" class="form-control form-control-lg text-center fw-bold" required placeholder="••••" />
                    <small class="text-muted d-block mt-1">Sadece sizin bileceğiniz 4–6 haneli rakam belirleyin (telefon uygulamasından hızlı giriş için).</small>
                </div>

                <div class="small text-muted text-center mb-3">
                    <i class="bi bi-phone me-1 text-success"></i>Aktivasyon tamamlanınca açılan ekrandan mobil uygulamayı telefonunuza tek dokunuşla kurabilirsiniz.
                </div>

                <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm">
                    @(isStaff ? "Şifre, PIN ve Adresi Kaydet → Giriş Yap" : "Profilimi Doğrula ve Hesabımı Aktifleştir")
                </button>
            </form>
        </div>
    </div>
</div>
