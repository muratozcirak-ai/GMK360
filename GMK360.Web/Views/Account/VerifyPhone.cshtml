@{
    ViewData["Title"] = "Telefon Doğrulama";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary text-white p-4 text-center">
                    <h3 class="fw-bold m-0"><i class="ph-bold ph-device-mobile me-2"></i> Telefon Doğrulama</h3>
                    <p class="mb-0 mt-2 opacity-75">Güvenliğiniz için telefonunuza gönderilen 6 haneli kodu giriniz.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form method="post" asp-action="VerifyPhone" asp-controller="Account">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold text-muted mb-3">6 Haneli Doğrulama Kodu</label>
                            <input type="text" name="code" class="form-control form-control-lg text-center fw-bold fs-3 rounded-3" style="letter-spacing: 0.5rem;" maxlength="6" required autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                            Doğrula ve Devam Et <i class="ph-bold ph-arrow-right ms-1"></i>
                        </button>
                    </form>
                    
                    <div class="text-center mt-4">
                        <p class="text-muted small mb-0">Kod gelmedi mi?</p>
                        <a href="#" class="text-primary fw-bold text-decoration-none small" onclick="alert('Yeni kod gönderildi.'); return false;">Yeni Kod Gönder</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
