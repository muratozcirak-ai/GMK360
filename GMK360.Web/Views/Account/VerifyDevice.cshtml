@{
    ViewData["Title"] = "Cihaz Doğrulama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4 border-0">
                    <i class="bi bi-shield-lock-fill display-4 mb-2 d-block"></i>
                    <h4 class="mb-0 fw-bold">Yeni Cihaz Tespit Edildi</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <p class="text-muted text-center mb-4">
                        Hesabınızın güvenliği için, yeni veya tanınmayan cihazlardan yapılan girişlerde doğrulama yapmanız gerekmektedir. Lütfen doğrulama kodunu nasıl almak istediğinizi seçin.
                    </p>

                    <form asp-action="SendDeviceCode" asp-controller="Account" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="d-grid gap-3">
                            <button type="submit" name="provider" value="Email" class="btn btn-outline-primary btn-lg d-flex align-items-center justify-content-center gap-2 py-3 rounded-3">
                                <i class="bi bi-envelope-fill fs-5"></i>
                                <span><strong>E-posta</strong> (@ViewData["Email"]) ile gönder</span>
                            </button>

                            <button type="submit" name="provider" value="SMS" class="btn btn-outline-success btn-lg d-flex align-items-center justify-content-center gap-2 py-3 rounded-3">
                                <i class="bi bi-phone-fill fs-5"></i>
                                <span><strong>SMS</strong> ile telefonuma gönder</span>
                            </button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-4 pt-3 border-top">
                        <a asp-action="Login" class="text-decoration-none text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Geri Dön
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
