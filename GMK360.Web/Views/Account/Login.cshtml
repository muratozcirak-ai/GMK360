@model GMK360.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-split">
        <!-- Sol Taraf: Form -->
        <div class="auth-form-side">
            <div class="auth-form-wrapper w-100" style="max-width: 450px; margin: 0 auto;">
                <div class="text-center mb-5">
                    <h2 class="form-title">Hoş Geldiniz</h2>
                    <p class="form-subtitle">Devam etmek için hesap bilgilerinizi giriniz.</p>
                </div>

                <div class="login-form-container d-flex flex-column gap-3 mt-5">
                    <!-- E-Posta ile Giriş (Her Zaman Açık Form) -->
                    <div id="emailLoginForm" class="p-4 border rounded bg-light mb-2">
                        <form asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
                            <div class="form-group mb-3 position-relative">
                                <i class="ph ph-envelope form-icon"></i>
                                <input name="Email" type="email" class="form-control premium-input" placeholder=" " required />
                                <label class="premium-label">E-Posta Adresi</label>
                            </div>
                            <div class="form-group mb-4 position-relative">
                                <i class="ph ph-lock-key form-icon"></i>
                                <input name="Password" type="password" class="form-control premium-input" placeholder=" " required />
                                <label class="premium-label">Şifre</label>
                            </div>
                            <button type="submit" class="btn btn-dark w-100 fw-bold py-2 rounded-3">Giriş Yap</button>
                        </form>
                    </div>

                    <div class="d-flex align-items-center my-2">
                        <hr class="flex-grow-1">
                        <span class="mx-3 text-muted small">veya</span>
                        <hr class="flex-grow-1">
                    </div>

                    <!-- Google Giriş Butonu -->
                    <form asp-action="ExternalLogin" asp-controller="Account" method="post" class="w-100" asp-route-returnurl="@ViewData["ReturnUrl"]">
                        <button type="submit" name="provider" value="Google" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-3" style="border-radius: 12px; padding: 1rem; font-size: 1.1rem; border-color: #ddd;">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" style="width: 24px; height: 24px;" />
                            <span class="fw-bold text-dark">Google ile Devam Et</span>
                        </button>
                    </form>

                    <!-- Apple Giriş Butonu -->
                    <form asp-action="ExternalLogin" asp-controller="Account" method="post" class="w-100" asp-route-returnurl="@ViewData["ReturnUrl"]">
                        <button type="submit" name="provider" value="Apple" class="btn w-100 d-flex align-items-center justify-content-center gap-3" style="border-radius: 12px; padding: 1rem; font-size: 1.1rem; background-color: #000; color: #fff;">
                            <i class="ph-fill ph-apple-logo fs-4"></i>
                            <span class="fw-bold">Apple ile Devam Et</span>
                        </button>
                    </form>
                </div>

                    <div class="text-center mt-4">
                        <p class="mb-0 text-muted">Henüz hesabınız yok mu?</p>
                        <a asp-action="Register" class="register-link">Hemen Üye Olun</a>
                    </div>
            </div>
        </div>

        <!-- Sağ Taraf: Görsel ve Marka Mesajı -->
        <div class="auth-image-side">
            <div class="h-100 w-100 position-sticky top-0" style="height: calc(100vh - 80px) !important;">
                @await Component.InvokeAsync("AuthBanner")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .auth-page {
        min-height: calc(100vh - 80px); /* Adjust for header */
        width: 100%;
        background-color: #f8fafc;
        overflow-x: hidden; /* Fix horizontal scroll issue */
    }

    .auth-split {
        display: flex;
        min-height: calc(100vh - 80px);
        width: 100%;
    }

    .auth-form-side {
        flex: 0 0 50%;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: white;
    }

    .auth-image-side {
        flex: 0 0 50%;
        position: relative;
    }

    @@media (max-width: 991.98px) {
        .auth-form-side {
            flex: 1;
            padding: 1.5rem;
        }
        .auth-image-side {
            display: none;
        }
    }

    .auth-form-wrapper {
        animation: fadeUp 0.6s ease-out forwards;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .auth-brand-content {
        position: relative;
        z-index: 2;
        padding: 4rem;
        color: white;
        max-width: 600px;
    }

    .auth-logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.5rem;
        font-weight: 800;
        color: white;
        text-decoration: none;
        margin-bottom: 4rem;
    }
    
    .auth-logo i {
        color: var(--primary);
        font-size: 2rem;
    }

    .auth-hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        letter-spacing: -1px;
    }

    .auth-hero-text {
        font-size: 1.2rem;
        color: #cbd5e1;
        line-height: 1.6;
        margin-bottom: 3rem;
    }

    .auth-stats {
        display: flex;
        gap: 3rem;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        color: var(--primary);
    }

    .stat-label {
        color: #94a3b8;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Sağ Taraf (Form) */

    .auth-form-wrapper {
        width: 100%;
        max-width: 450px;
        animation: fadeUp 0.6s ease-out forwards;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-title {
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 0.5rem;
    }

    .form-subtitle {
        color: #64748b;
        font-size: 1rem;
    }

    .error-box {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #ef4444;
        padding: 1rem;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .error-box ul {
        margin: 0;
        padding-left: 1.2rem;
    }

    /* Input Animations */
    .form-group {
        position: relative;
    }

    .form-icon {
        position: absolute;
        left: 1.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.2rem;
        color: #94a3b8;
        transition: all 0.3s ease;
        z-index: 10;
    }

    .premium-input {
        width: 100%;
        padding: 1.2rem 1.2rem 1.2rem 3rem !important;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        font-size: 1rem;
        color: #0f172a;
        transition: all 0.3s ease;
        height: auto;
    }

    .premium-input:focus {
        background: white;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(248, 193, 70, 0.15);
        outline: none;
    }

    .premium-input:focus ~ .form-icon {
        color: var(--primary);
    }

    .premium-label {
        position: absolute;
        left: 3rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1rem;
        pointer-events: none;
        transition: all 0.2s ease;
        background: transparent;
        padding: 0 0.2rem;
    }

    /* Float label on focus or when input is not empty */
    .premium-input:focus ~ .premium-label,
    .premium-input:not(:placeholder-shown) ~ .premium-label {
        top: 0;
        font-size: 0.8rem;
        color: var(--primary);
        font-weight: 600;
        background: white;
    }

    /* Checkbox & Links */
    .premium-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        user-select: none;
    }

    .premium-checkbox input {
        display: none;
    }

    .checkmark {
        width: 20px;
        height: 20px;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .premium-checkbox input:checked ~ .checkmark {
        background: var(--primary);
        border-color: var(--primary);
    }

    .premium-checkbox input:checked ~ .checkmark::after {
        content: '\2714';
        color: white;
        font-size: 12px;
    }

    .checkbox-text {
        color: #475569;
        font-size: 0.95rem;
    }

    .forgot-password {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.2s;
    }

    .forgot-password:hover {
        color: #d9a02e;
    }

    /* Auth Button */
    .btn-auth {
        background: #0f172a;
        color: white;
        border: none;
        padding: 1.2rem;
        border-radius: 16px;
        font-size: 1.1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.15);
    }

    .btn-auth:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 25px rgba(15, 23, 42, 0.25);
        background: var(--primary);
        color: #0f172a;
    }

    .btn-auth:hover i {
        transform: translateX(5px);
    }

    .btn-auth i {
        transition: transform 0.3s ease;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 2rem 0;
    }
    .auth-divider::before, .auth-divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }
    .auth-divider span {
        padding: 0 1rem;
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .register-link {
        display: inline-block;
        margin-top: 0.5rem;
        color: #0f172a;
        font-weight: 800;
        font-size: 1.1rem;
        text-decoration: none;
        position: relative;
    }

    .register-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--primary);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    .register-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }
</style>

