@{
    ViewData["Title"] = "Erişim Yetkisi Yetersiz";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6 text-center">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-4" style="width: 90px; height: 90px;">
                        <i class="bi bi-shield-lock-fill display-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-2">Erişim Yetkisi Yetersiz</h3>
                <p class="text-muted mb-4">
                    Bu alana erişmek için gerekli rol veya yetkiye sahip değilsiniz. Yeni bir hesap açtıysanız veya yetkileriniz yeni tanımlandıysa oturumunuzu yenilemeniz gerekebilir.
                </p>

                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <div class="alert alert-light border small text-muted text-break mb-4">
                        <strong>Hedef Sayfa:</strong> @returnUrl
                    </div>
                }

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="/Dashboard/Hub" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-grid-fill me-1"></i> Uygulama Merkezi (Hub)
                    </a>
                    <a href="/Account/Login" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Yeniden Giriş Yap
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
