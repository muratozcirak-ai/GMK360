@{
    ViewData["Title"] = "Doğrulama Kodu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white text-center py-4 border-0">
                    <i class="bi bi-key-fill display-4 mb-2 d-block"></i>
                    <h4 class="mb-0 fw-bold">Kodu Giriniz</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    
                    @if (TempData["VerificationMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["VerificationMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="VerifyDeviceCode" asp-controller="Account" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="mb-4">
                            <label for="Code" class="form-label fw-bold">6 Haneli Doğrulama Kodu</label>
                            <input type="text" id="Code" name="Code" class="form-control form-control-lg text-center fw-bold fs-4" placeholder="_ _ _ _ _ _" maxlength="6" required autocomplete="off" />
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg fw-bold py-3">
                                Doğrula ve Giriş Yap <i class="bi bi-arrow-right-circle ms-1"></i>
                            </button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-4 pt-3 border-top">
                        <a asp-action="VerifyDevice" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-decoration-none text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Farklı bir yöntem seç
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
