@model GMK360.Web.Models.RegisterCorporateViewModel
@{
    ViewData["Title"] = "Kurumsal (SaaS) Üyelik";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Sol Bilgi Paneli -->
                    <div class="col-md-5 text-white p-5 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                        <div>
                            <h2 class="fw-bold mb-4">Sektörün Zirvesine Çıkın.</h2>
                            <p class="opacity-75 mb-4">Kendi alt alan adınız, kendi logonuz ve kendi renklerinizle dijital gayrimenkul ofisinizi 5 dakikada kurun.</p>
                            
                            <ul class="list-unstyled mb-5">
                                <li class="mb-3 d-flex align-items-center"><i class="ph-fill ph-check-circle text-primary fs-4 me-3"></i> White-Label Mağaza</li>
                                <li class="mb-3 d-flex align-items-center"><i class="ph-fill ph-check-circle text-primary fs-4 me-3"></i> Size Özel Subdomain</li>
                                <li class="mb-3 d-flex align-items-center"><i class="ph-fill ph-check-circle text-primary fs-4 me-3"></i> Müşteri İzolasyonu</li>
                                <li class="mb-3 d-flex align-items-center"><i class="ph-fill ph-check-circle text-primary fs-4 me-3"></i> Sınırsız İlan Vitrini</li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Sağ Form Paneli -->
                    <div class="col-md-7 p-5">
                        <h4 class="fw-bold mb-4" style="color: #0f172a;">Kurumsal Hesap Oluştur</h4>
                        
                        <form asp-action="RegisterCorporate" asp-controller="Account" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label asp-for="CompanyName" class="form-label text-muted small fw-bold">Firma Adı</label>
                                    <input asp-for="CompanyName" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="TaxOffice" class="form-label text-muted small fw-bold">Vergi Dairesi</label>
                                    <input asp-for="TaxOffice" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="TaxOffice" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TaxNumber" class="form-label text-muted small fw-bold">Vergi Numarası</label>
                                    <input asp-for="TaxNumber" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="TaxNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <hr class="text-muted" />
                            <h6 class="text-primary fw-bold mb-3"><i class="ph-bold ph-user-circle"></i> Yetkili Kişi (NVI Doğrulaması)</h6>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label text-muted small fw-bold">Yetkili Adı</label>
                                    <input asp-for="FirstName" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label text-muted small fw-bold">Yetkili Soyadı</label>
                                    <input asp-for="LastName" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label asp-for="TcIdentityNo" class="form-label text-muted small fw-bold">Yetkili TCKN</label>
                                    <input asp-for="TcIdentityNo" class="form-control" maxlength="11" oninput="this.value = this.value.replace(/[^0-9]/g, '')" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="TcIdentityNo" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="BirthYear" class="form-label text-muted small fw-bold">Doğum Yılı</label>
                                    <input asp-for="BirthYear" type="number" class="form-control" placeholder="1980" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="BirthYear" class="text-danger small"></span>
                                </div>
                            </div>
                            <hr class="text-muted" />

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label text-muted small fw-bold">Kurumsal E-Posta</label>
                                <input asp-for="Email" class="form-control" placeholder="info@firma.com" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="PhoneNumber" class="form-label text-muted small fw-bold">Yetkili Telefon Numarası</label>
                                <input asp-for="PhoneNumber" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <hr class="text-muted opacity-25 my-4" />
                            <h6 class="fw-bold mb-3" style="color: #0f172a;">Markalaşma & Dijital Mağaza (White-Label)</h6>

                            <div class="mb-3">
                                <label asp-for="Subdomain" class="form-label text-muted small fw-bold">Size Özel Alt Alan Adı (Subdomain)</label>
                                <div class="input-group">
                                    <input asp-for="Subdomain" class="form-control" placeholder="firmaadi" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-top-left-radius: 10px; border-bottom-left-radius: 10px;" />
                                    <span class="input-group-text bg-light text-muted border-start-0" style="border: 1px solid #e2e8f0; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">.gmk360.com</span>
                                </div>
                                <span asp-validation-for="Subdomain" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="ThemePrimaryColor" class="form-label text-muted small fw-bold">Kurumsal Tema Rengi</label>
                                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                        <input asp-for="ThemePrimaryColor" type="color" class="form-control form-control-color border-0 p-0 bg-transparent" style="width: 30px; height: 30px; cursor: pointer;" title="Renk Seçin" />
                                        <span class="small text-muted">Renk Seçin</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LogoFile" class="form-label text-muted small fw-bold">Firma Logosu (Opsiyonel)</label>
                                    <input asp-for="LogoFile" type="file" accept="image/*" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 10px; border-radius: 10px;" />
                                </div>
                            </div>

                            <hr class="text-muted opacity-25 my-4" />

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label text-muted small fw-bold">Şifre</label>
                                    <input asp-for="Password" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label text-muted small fw-bold">Şifre Tekrar</label>
                                    <input asp-for="ConfirmPassword" class="form-control" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px;" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-dark w-100 py-3 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2" style="border-radius: 12px; background: #0f172a;">
                                Dijital Ofisimi Kur <i class="ph-bold ph-rocket-launch"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
