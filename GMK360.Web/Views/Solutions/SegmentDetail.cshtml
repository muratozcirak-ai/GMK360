@model GMK360.Web.Models.SolutionViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Dinamik Slogan Üretimi
    string heroTitle = Model.Title;
    string heroSubtitle = Model.Subtitle;

    if (Model.SegmentId == "bireysel-kiraci")
    {
        heroTitle = "Kira Peşinde Koşmaya Son.";
        heroSubtitle = "Mülkünüz siz uyurken bile tıkır tıkır işlesin. Ödemeleri, sözleşmeleri ve talepleri tek ekrandan profesyonelce yönetin.";
    }
    else if (Model.SegmentId == "bina-site-yonetimi")
    {
        heroTitle = "Yüzlerce Daireyi Yönetmek, Tek E-Posta Atmak Kadar Kolay.";
        heroSubtitle = "Aidat kargaşasına son verin. Şeffaf gelir-gider takibi ve dijital karar defteri ile binalarınızı zahmetsizce yönetin.";
    }
    else if (Model.SegmentId == "esnaf-hizmet")
    {
        heroTitle = "Müşteri Aramayın, Müşteri Sizi Bulsun.";
        heroSubtitle = "Ustalar, temizlik firmaları ve mimarlar için binlerce hazır müşterinin bulunduğu kapalı devre ekosisteme katılın.";
    }
    else if (Model.SegmentId == "insaat-proje")
    {
        heroTitle = "Anahtarı Teslim Etmek Prestijinizin Başlangıcıdır.";
        heroSubtitle = "Satış sonrası destek, demirbaş hasar tespiti ve şikayet yönetimini kusursuzlaştırarak marka değerinizi zirveye taşıyın.";
    }
    else if (Model.SegmentId == "gunluk-kiralama")
    {
        heroTitle = "Siz Tatildeyken, Takviminiz Tıkır Tıkır İşlesin.";
        heroSubtitle = "Günlük kiralama süreçlerinizi, giriş-çıkışları ve temizlik ekibinizi otomatikleştirin, arkanıza yaslanın.";
    }
    else if (Model.SegmentId == "emlak-danisman")
    {
        heroTitle = "Portföyünüzü Gerçek Bir İmparatorluğa Çevirin.";
        heroSubtitle = "İlanlarınızı, müşteri eşleşmelerini ve dijital sözleşmelerinizi en gelişmiş CRM altyapısıyla yönetin.";
    }
}

<div class="solution-page">
    <!-- HERO BÖLÜMÜ (2 Kolonlu) -->
    <section class="hero-section py-5" style="background-color: #f8fafc; padding-top: 5rem !important; padding-bottom: 5rem !important; overflow: hidden;">
        <div class="container position-relative">
            <div class="row align-items-center">
                <!-- Sol Kolon: Yazılar -->
                <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm mb-4" style="width: 60px; height: 60px;">
                        <i class="ph @Model.IconClass text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <h1 class="display-4 fw-bolder text-dark mb-4" style="letter-spacing: -1px; line-height: 1.2;">
                        @heroTitle
                    </h1>
                    <p class="lead text-secondary mb-4" style="font-size: 1.2rem; max-width: 600px; margin: 0 auto; margin-lg: 0;">
                        @heroSubtitle
                    </p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
                        <a href="#plans" class="btn btn-primary btn-lg fw-bold px-4 rounded-pill shadow-sm text-dark">
                            Planları İncele
                        </a>
                        <a href="/Account/Register?userType=@Model.IdentityUserType" class="btn btn-outline-dark btn-lg fw-bold px-4 rounded-pill">
                            Hemen Başla
                        </a>
                    </div>
                </div>
                
                <!-- Sağ Kolon: Görsel / Mockup -->
                <div class="col-lg-6 position-relative">
                    <!-- Arkadaki şekil/blob efekti -->
                    <div class="position-absolute bg-primary rounded-circle" style="width: 400px; height: 400px; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.1; filter: blur(40px);"></div>
                    
                    <img src="@Model.CoverImageUrl" alt="@Model.Title" class="img-fluid rounded-4 shadow-lg position-relative" style="border: 1px solid rgba(0,0,0,0.05);" onerror="this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80'" />
                </div>
            </div>
        </div>
    </section>

    <!-- KAMPANYA BANNER (Sektöre Özel) -->
    @if (Model.ActiveCampaign != null && Model.ActiveCampaign.IsActive)
    {
        <!-- Arka plan siyah, yazı beyaz olacak şekilde contrast düzeltildi -->
        <section class="campaign-banner bg-dark text-white py-3 position-relative overflow-hidden shadow-lg">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(90deg, rgba(248, 193, 70, 0.15), transparent);"></div>
            
            <div class="container position-relative z-index-1">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
                    <div class="d-flex align-items-center mb-3 mb-md-0">
                        <span class="badge bg-primary text-dark fw-bold px-3 py-2 me-3 fs-6 rounded-pill">Özel Fırsat</span>
                        <div>
                            <!-- fw-bold ve text-white kullanıldı ki okunaklı olsun -->
                            <h4 class="fw-bold mb-1 text-white m-0" style="font-size: 1.3rem;">@Model.ActiveCampaign.Title</h4>
                            <p class="mb-0 text-white-50 small">@Model.ActiveCampaign.Description</p>
                        </div>
                    </div>
                    <div>
                        <a href="@Model.ActiveCampaign.ActionUrl" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm text-dark text-nowrap">
                            Fırsatı Yakala <i class="ph-bold ph-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- GÜVEN BANDI (Social Proof) -->
    <section class="trust-band py-4 border-bottom bg-white">
        <div class="container">
            <div class="row text-center text-muted align-items-center justify-content-center g-4">
                <div class="col-6 col-md-3">
                    <i class="ph-fill ph-buildings fs-1 mb-2 text-primary"></i>
                    <h5 class="fw-bold text-dark mb-0">10.000+</h5>
                    <span class="small">Yönetilen Daire</span>
                </div>
                <div class="col-6 col-md-3">
                    <i class="ph-fill ph-check-circle fs-1 mb-2 text-success"></i>
                    <h5 class="fw-bold text-dark mb-0">%100</h5>
                    <span class="small">Tahsilat Başarısı</span>
                </div>
                <div class="col-6 col-md-3">
                    <i class="ph-fill ph-shield-check fs-1 mb-2 text-info"></i>
                    <h5 class="fw-bold text-dark mb-0">Uçtan Uca</h5>
                    <span class="small">Veri Güvenliği</span>
                </div>
                <div class="col-6 col-md-3">
                    <i class="ph-fill ph-headset fs-1 mb-2 text-warning"></i>
                    <h5 class="fw-bold text-dark mb-0">7/24</h5>
                    <span class="small">Otonom Destek</span>
                </div>
            </div>
        </div>
    </section>

    <!-- PAKETLER / ÖZELLİKLER BÖLÜMÜ -->
    <section id="plans" class="packages-section py-5 bg-light">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-dark">İhtiyacınıza Uygun Planı Seçin</h2>
                <p class="text-muted">Size özel geliştirdiğimiz araçlarla işinizi hemen dijitale taşıyın.</p>
            </div>

            <div class="row g-4 justify-content-center">
                <!-- Standart Paket -->
                <div class="col-md-6 col-lg-5">
                    <div class="card h-100 border-0 shadow-sm rounded-4 package-card bg-white">
                        <div class="card-body p-5 d-flex flex-column">
                            <div class="text-center mb-4">
                                <h3 class="fw-bold text-dark">@Model.StandardPackageName</h3>
                                <p class="text-muted">@Model.StandardPackageSubtitle</p>
                                <h2 class="display-5 fw-bold text-dark my-3">@Model.StandardPackagePrice</h2>
                            </div>
                            <hr class="mb-4">
                            <ul class="list-unstyled mb-5">
                                @foreach (var feature in Model.StandardFeatures)
                                {
                                    <li class="d-flex align-items-start mb-3">
                                        <i class="ph-fill ph-check-circle text-success fs-4 me-3"></i>
                                        <span class="fs-6 text-dark">@feature</span>
                                    </li>
                                }
                            </ul>
                            <div class="mt-auto text-center">
                                <a href="/Account/Register?userType=@Model.IdentityUserType&plan=standard" class="btn btn-outline-dark w-100 py-3 rounded-3 fw-bold">Hemen Başla</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pro Paket -->
                <div class="col-md-6 col-lg-5">
                    <div class="card h-100 border-0 shadow-lg rounded-4 package-card position-relative bg-white" style="border: 2px solid var(--primary) !important;">
                        <!-- Popüler Etiketi -->
                        <div class="position-absolute top-0 end-0 bg-primary text-dark fw-bold px-4 py-1" style="border-bottom-left-radius: 12px;">Önerilen</div>
                        
                        <div class="card-body p-5 d-flex flex-column">
                            <div class="text-center mb-4">
                                <h3 class="fw-bold text-dark">@Model.ProPackageName</h3>
                                <p class="text-muted">@Model.ProPackageSubtitle</p>
                                <h2 class="display-5 fw-bold text-dark my-3">@Model.ProPackagePrice <span class="fs-5 text-muted">/ay</span></h2>
                            </div>
                            <hr class="mb-4">
                            <ul class="list-unstyled mb-5">
                                <li class="d-flex align-items-start mb-3 text-muted">
                                    <i class="ph-bold ph-plus fs-5 me-3"></i>
                                    <span class="fs-6 fw-bold">Standart paketteki her şey ve;</span>
                                </li>
                                @foreach (var feature in Model.ProFeatures)
                                {
                                    <li class="d-flex align-items-start mb-3">
                                        <i class="ph-fill ph-check-circle text-primary fs-4 me-3"></i>
                                        <span class="fs-6 fw-bold text-dark">@feature</span>
                                    </li>
                                }
                            </ul>
                            <div class="mt-auto text-center">
                                <a href="/Account/Register?userType=@Model.IdentityUserType&plan=pro" class="btn btn-primary w-100 py-3 rounded-3 fw-bold text-dark">Pro'ya Geçiş Yap</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SIKÇA SORULAN SORULAR (FAQ) -->
    <section class="faq-section py-5 bg-white border-top">
        <div class="container py-4" style="max-width: 800px;">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-dark">Aklınıza Takılanlar</h2>
                <p class="text-muted">En çok merak edilen soruları sizin için yanıtladık.</p>
            </div>
            
            <div class="accordion accordion-flush" id="faqAccordion">
                <div class="accordion-item border-0 mb-3 rounded-3 shadow-sm overflow-hidden">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                            Verilerim ne kadar güvende?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            GMK360 altyapısı uluslararası bankacılık standartlarında (256-bit şifreleme) korunur. İşlem şifreniz (Dijital İmza) olmadan kimse adınıza işlem yapamaz. Verileriniz KVKK uyumlu sunucularımızda günlük yedeklenir.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 mb-3 rounded-3 shadow-sm overflow-hidden">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                            İstediğim zaman iptal edebilir miyim?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Sistemimizi ilk 2 ay tamamen ücretsiz deneyebilirsiniz. Ücretli plana (Pro) geçtiğinizde de ilk 1 ay içinde koşulsuz iptal ve iade hakkınız bulunur. Yani toplamda ilk 3 ay içinde aboneliğinizi dilediğiniz zaman iptal edebilirsiniz. 3. aydan sonra (iş ortaklarımıza komisyon ödemeleri gerçekleştiği için) para iadesi yapılmamaktadır.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .package-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .package-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }
    .accordion-button:not(.collapsed) {
        background-color: #f8fafc;
        color: var(--primary);
        box-shadow: none;
    }
    .accordion-button:focus {
        border-color: transparent;
        box-shadow: none;
    }
</style>
