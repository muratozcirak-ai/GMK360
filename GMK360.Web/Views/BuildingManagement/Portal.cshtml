@model GMK360.Core.Entities.Construction.ProjectManagementInvitation
@{
    Layout = "_Layout";
    ViewData["Title"] = "Müşteri Dijital Ev Portalı";
    bool isAccepted = Model.Status == "Kabul Edildi";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Branding Header -->
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-primary mb-3">GMK360 Akıllı Ev Portalı</h1>
                <p class="lead text-muted">Evinizin inşa sürecini koltuğunuzdan, şeffafça takip edin.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success shadow-sm rounded-4 mb-4 border-0 border-start border-success border-5">
                    <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                    <strong>@TempData["SuccessMessage"]</strong>
                </div>
            }

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary bg-gradient p-4 text-white text-center">
                    <i class="bi bi-house-door fs-1 mb-2"></i>
                    <h3 class="fw-bold mb-0">@ViewBag.ProjectName</h3>
                    <p class="mb-0 opacity-75">Dijital Müşteri Dosyası</p>
                </div>
                <div class="card-body p-5">
                    <h4 class="text-dark fw-bold mb-4">Sayın @ViewBag.ManagerName,</h4>
                    
                    <p class="fs-5 text-secondary mb-4">
                        <strong>@ViewBag.AgencyName</strong> firması, projeniz için dijital ve şeffaf bir çalışma dosyası oluşturdu.
                    </p>

                    @if (!isAccepted)
                    {
                        <div class="bg-light rounded-4 p-4 mb-4 border border-info border-opacity-25">
                            <h5 class="fw-bold text-info mb-3"><i class="bi bi-star-fill text-warning me-2"></i> Müşteri Hesabı İle Neler Yapabilirsiniz?</h5>
                            <ul class="list-unstyled mb-0 text-muted">
                                <li class="mb-3"><i class="bi bi-cone-striped text-warning me-2 fs-5"></i> <strong>Canlı Şantiye Takibi:</strong> İnşaat aşamalarını evden anlık görün.</li>
                                <li class="mb-0"><i class="bi bi-palette text-danger me-2 fs-5"></i> <strong>Kişisel Seçimler:</strong> Dairenizin parke, seramik ve boya renklerini katalogdan seçip onaylayın.</li>
                            </ul>
                        </div>

                        <div class="text-center mt-5">
                            <p class="text-muted small mb-3">Süreci takip etmek için ücretsiz Müşteri (Gölge) profilinizi aktifleştirin.</p>
                            <form action="/BuildingManagement/AcceptInvite" method="post">
                                <input type="hidden" name="token" value="@ViewBag.Token" />
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 shadow hover-scale">
                                    <i class="bi bi-phone-vibrate me-2"></i> Portala Ücretsiz Katıl
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mt-4 mb-5">
                            <div class="alert alert-success bg-success bg-opacity-10 border-0 rounded-4 p-4">
                                <i class="bi bi-patch-check-fill fs-1 text-success mb-2 d-block"></i>
                                <h4 class="fw-bold text-success mb-2">Müşteri Profiliniz Aktif!</h4>
                                <p class="mb-0 text-dark"><strong>@ViewBag.AgencyName</strong> firmasının sizin için sunduğu şantiye takibi ve malzeme seçimi ekranlarına sol menüden ulaşabilirsiniz.</p>
                            </div>
                        </div>
                        
                        <hr class="my-5 text-muted opacity-25" />
                        
                        <!-- TEASER / PRO UPGRADE ALANI (Tamamen masum, sadece Bina Yönetimi odaklı) -->
                        <div class="text-start bg-light p-4 rounded-4 border border-secondary border-opacity-25 position-relative overflow-hidden">
                            <!-- Lock Overlay -->
                            <div class="position-absolute top-0 start-0 w-100 h-100 bg-light bg-opacity-75 d-flex align-items-center justify-content-center" style="z-index: 10; backdrop-filter: blur(2px);">
                                <div class="text-center">
                                    <i class="bi bi-lock-fill fs-1 text-secondary mb-2 d-block"></i>
                                    <button class="btn btn-dark fw-bold rounded-pill px-4 shadow-sm disabled" title="Çok Yakında">Yönetici Olarak Doğrula</button>
                                </div>
                            </div>
                            
                            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-building-gear text-primary me-2"></i> Bina Yöneticisi misiniz? (PRO Üyelik)</h5>
                            <p class="text-muted small mb-3">Eğer bu binanın resmi yöneticisiyseniz, ilerleyen günlerde hesabınızı doğrulayarak GMK360 <strong>Bina Yönetim</strong> modülünü ücretsiz açabileceksiniz:</p>
                            
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2 text-muted"><i class="bi bi-wallet2 me-2"></i> <strong>Aidat Takibi:</strong> Sakinlerin ödemelerini dijital olarak yönetin.</li>
                                <li class="mb-2 text-muted"><i class="bi bi-journal-text me-2"></i> <strong>Dijital Karar Defteri:</strong> Toplantı kararlarını şeffafça kaydedin.</li>
                                <li class="mb-0 text-muted"><i class="bi bi-tools me-2"></i> <strong>Asansör & Bakım:</strong> Periyodik bakımları sistem üzerinden otomatik hatırlatın.</li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
            
            <div class="text-center mt-4">
                <small class="text-muted"><i class="bi bi-c-circle"></i> 2026 GMK360 - Şeffaf ve Güvenilir Dijital İnşaat Ekosistemi</small>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: scale(1.05); }
</style>
