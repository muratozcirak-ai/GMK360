@model GMK360.Core.Entities.Finance.SubcontractorContract
@using GMK360.Core.Entities.Finance
@{
    ViewData["Title"] = "Taşeron Sözleşme, Hakediş & Kesinti Detayı";
    Layout = "_ConstructionLayout";
    var hakedisler = ViewBag.Hakedisler as List<SubcontractorHakedis> ?? new List<SubcontractorHakedis>();
    decimal totalBrutClaim = hakedisler.Sum(h => h.ClaimAmount);
    decimal totalDeduction = hakedisler.Sum(h => h.DeductionAmount);
    decimal totalNetApproved = totalBrutClaim - totalDeduction;
    decimal remainingContractAmount = Model.TotalAmount - totalBrutClaim;
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-check text-primary me-2"></i>Taşeron Sözleşmesi, Hakediş & Kesinti (Stopaj/Avans) Masası</h4>
            <p class="text-muted small mb-0">
                <strong>@(Model.PhonebookContact?.Name ?? "Taşeron Firma")</strong> • @Model.Title
                @if (Model.Project != null)
                {
                    <span class="badge bg-info-subtle text-info-emphasis border ms-2"><i class="bi bi-building me-1"></i>@Model.Project.Name</span>
                }
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.PhonebookContactId > 0)
            {
                <a href="/AgencyPhonebook/Details/@Model.PhonebookContactId" class="btn btn-outline-primary rounded-pill px-3 fw-bold shadow-sm">
                    <i class="bi bi-building-gear me-1"></i> 360° Firma Hafızası & Cari Ekstresi
                </a>
            }
            <button class="btn btn-warning rounded-pill px-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#printModal">
                <i class="bi bi-printer me-1"></i> Sözleşme Yazdır
            </button>
            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#newHakedisModal">
                <i class="bi bi-plus-circle me-1"></i> + Yeni Hakediş & Kesinti Hesapla
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 KPI Özeti -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100" style="border-left: 4px solid #2563eb !important;">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Sözleşme Toplam Bedeli</div>
                    <div class="fs-4 fw-bold text-primary">@Model.TotalAmount.ToString("N2") @Model.Currency</div>
                    <div class="small text-muted">Sözleşme Tarihi: @Model.ContractDate.ToString("dd.MM.yyyy")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100" style="border-left: 4px solid #f59e0b !important;">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Toplam Kesintiler (Teminat/Avans/Ceza)</div>
                    <div class="fs-4 fw-bold text-warning-emphasis">@totalDeduction.ToString("N2") @Model.Currency</div>
                    <div class="small text-muted">Brüt Hakediş: @totalBrutClaim.ToString("N2") @Model.Currency</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100" style="border-left: 4px solid #10b981 !important;">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Cariye Yansıyan Net Hakediş</div>
                    <div class="fs-4 fw-bold text-success">@totalNetApproved.ToString("N2") @Model.Currency</div>
                    <div class="small text-muted">Brüt - Kesintiler = Net Alacak</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100" style="border-left: 4px solid #64748b !important;">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Sözleşmeden Kalan İmalat Bakiyesi</div>
                    <div class="fs-4 fw-bold text-dark">@remainingContractAmount.ToString("N2") @Model.Currency</div>
                    <div class="small text-muted">İlerleme: %@(Model.TotalAmount > 0 ? Math.Round((totalBrutClaim / Model.TotalAmount) * 100, 1) : 0)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-0"><i class="bi bi-list-check text-primary me-2"></i>Onaylanan Hakedişler, Teminat/Avans Kesintileri ve Cari Yansımaları</h6>
                <p class="text-muted small mb-0">Her hakedişte brüt tutardan nakit teminat (garanti), avans mahsubu ve malzeme/İSG kesintileri düşülerek net tutar taşeron carisine alacak yazılır.</p>
            </div>
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#newHakedisModal">
                <i class="bi bi-plus-lg me-1"></i> + Yeni Hakediş Ekle
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Hakediş No</th>
                            <th>Tarih</th>
                            <th>İmalat / Hakediş Açıklaması</th>
                            <th class="text-end">Brüt Hakediş</th>
                            <th class="text-end">Kesinti (Teminat/Avans/Ceza)</th>
                            <th>Kesinti Detayı</th>
                            <th class="text-end pe-3">Net Cariye İşlenen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!hakedisler.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-clipboard2-check fs-1 d-block mb-2 text-secondary"></i>
                                    Henüz bu sözleşme için hakediş girilmemiş. Sağ üstteki <strong>"+ Yeni Hakediş & Kesinti Hesapla"</strong> butonuyla ilk hakedişi oluşturun.
                                </td>
                            </tr>
                        }
                        @foreach (var h in hakedisler)
                        {
                            <tr>
                                <td class="ps-3"><span class="badge bg-dark text-warning fw-bold">Hakediş #@h.HakedisNo</span></td>
                                <td>@h.HakedisDate.ToString("dd.MM.yyyy")</td>
                                <td class="fw-semibold">@h.Description</td>
                                <td class="text-end fw-bold text-primary">@h.ClaimAmount.ToString("N2") @Model.Currency</td>
                                <td class="text-end fw-bold text-danger">-@h.DeductionAmount.ToString("N2") @Model.Currency</td>
                                <td class="small text-muted">@(string.IsNullOrEmpty(h.DeductionReason) ? "Kesinti Yok" : h.DeductionReason)</td>
                                <td class="text-end pe-3 fw-bold text-success fs-6">@((h.ClaimAmount - h.DeductionAmount).ToString("N2")) @Model.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Hakediş & Kesinti Hesaplayıcı Modalı -->
<div class="modal fade" id="newHakedisModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-calculator-fill text-warning me-2"></i>Yeni Taşeron Hakedişi & Otomatik Kesinti (Teminat/Avans) Hesaplayıcı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddHakedis" method="post">
                <input type="hidden" name="contractId" value="@Model.Id" />
                <input type="hidden" name="deductionAmount" id="hkTotalDeductionInput" value="0" />
                <input type="hidden" name="deductionReason" id="hkDeductionReasonInput" value="" />
                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 small mb-3">
                        Sözleşme Kalan Brüt Limit: <strong>@remainingContractAmount.ToString("N2") @Model.Currency</strong>. Girilen net hakediş tutarı otomatik olarak <strong>@(Model.PhonebookContact?.Name)</strong> cari hesabına alacak olarak işlenir.
                    </div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Hakediş / İmalat Açıklaması *</label>
                            <input type="text" name="description" class="form-control" placeholder="Örn: A Blok 2. ve 3. Kat Kalıp-Demir İmalatı Hakedişi" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-primary">1. Brüt Hakediş Tutarı (@Model.Currency) *</label>
                            <input type="number" step="0.01" name="claimAmount" id="hkBrutInput" class="form-control fw-bold border-primary" placeholder="Örn: 250000" oninput="recalcHakedisModal()" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold">2. Nakit Teminat (Garanti Stopajı %)</label>
                            <div class="input-group">
                                <span class="input-group-text">%</span>
                                <input type="number" step="0.5" id="hkRetentionPct" class="form-control" value="5" oninput="recalcHakedisModal()" />
                            </div>
                            <small class="text-muted">Teminat Kesintisi: <strong id="hkRetentionVal">0.00</strong> ₺</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">3. Verilen Avans Mahsubu (₺)</label>
                            <input type="number" step="0.01" id="hkAdvanceDed" class="form-control" value="0" oninput="recalcHakedisModal()" />
                            <small class="text-muted">Önceden verilen iş avansı düşümü</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">4. Malzeme Zayi / İSG Ceza Kesintisi (₺)</label>
                            <input type="number" step="0.01" id="hkPenaltyDed" class="form-control" value="0" oninput="recalcHakedisModal()" />
                            <small class="text-muted">Beton/Demir fire veya İSG cezası</small>
                        </div>

                        <div class="col-12">
                            <div class="bg-light border rounded-4 p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <span class="text-muted small d-block">Toplam Kesinti (Teminat + Avans + Ceza):</span>
                                    <strong class="text-danger fs-5" id="hkTotalDeductionDisplay">0.00 @Model.Currency</strong>
                                </div>
                                <div class="text-end">
                                    <span class="text-muted small d-block">Taşeron Carisine İşlenecek NET Hakediş:</span>
                                    <strong class="text-success fs-4" id="hkNetPayableDisplay">0.00 @Model.Currency</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success rounded-pill fw-bold px-4">
                        <i class="bi bi-check2-circle me-1"></i> Hakedişi Onayla ve Taşeron Carisine İşle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function recalcHakedisModal() {
        var brut = parseFloat(document.getElementById('hkBrutInput')?.value || '0') || 0;
        var retPct = parseFloat(document.getElementById('hkRetentionPct')?.value || '0') || 0;
        var advDed = parseFloat(document.getElementById('hkAdvanceDed')?.value || '0') || 0;
        var penDed = parseFloat(document.getElementById('hkPenaltyDed')?.value || '0') || 0;

        var retVal = Math.round((brut * retPct / 100.0) * 100) / 100;
        var totalDed = Math.round((retVal + advDed + penDed) * 100) / 100;
        var netVal = Math.round((brut - totalDed) * 100) / 100;

        document.getElementById('hkRetentionVal').innerText = retVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('hkTotalDeductionDisplay').innerText = totalDed.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' @Model.Currency';
        document.getElementById('hkNetPayableDisplay').innerText = netVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' @Model.Currency';

        document.getElementById('hkTotalDeductionInput').value = totalDed.toFixed(2);
        var reasons = [];
        if (retVal > 0) reasons.push('%' + retPct + ' Nakit Teminat (' + retVal.toFixed(2) + ' TL)');
        if (advDed > 0) reasons.push('Avans Mahsubu (' + advDed.toFixed(2) + ' TL)');
        if (penDed > 0) reasons.push('Malzeme/İSG Kesintisi (' + penDed.toFixed(2) + ' TL)');
        document.getElementById('hkDeductionReasonInput').value = reasons.join(', ');
    }
</script>





<!-- YAZDIRMA MODALI -->
<div class="modal fade" id="printModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="/SubcontractorContract/PrintContract" method="get" target="_blank">
            <input type="hidden" name="contractId" value="@Model.Id" />
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-printer me-2"></i> Sözleşme Yazdır</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-4">Aşağıdan yazdırmak istediğiniz sözleşme şablonunu seçin. Sistem <strong>Firma Adı</strong>, <strong>Tutar</strong> ve <strong>Proje Adı</strong> gibi bilgileri otomatik dolduracaktır.</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Şablon Seçiniz</label>
                        <select name="templateId" class="form-select" required>
                            <option value="">-- Şablon Seçin --</option>
                            @if(ViewBag.Templates != null)
                            {
                                foreach(var t in ViewBag.Templates)
                                {
                                    <option value="@t.Id">@t.TemplateName (@t.Category)</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="bi bi-file-earmark-pdf me-1"></i> Önizle & Yazdır</button>
                </div>
            </div>
        </form>
    </div>
</div>
