@model GMK360.Core.Entities.Finance.SubcontractorContract
@using GMK360.Core.Entities.Finance
@{
    ViewData["Title"] = "Sözleşme & Hakediş Detayı";
    Layout = "_ConstructionProjectLayout";
    var payments = ViewBag.Payments as List<ProgressPayment> ?? new List<ProgressPayment>();
    decimal totalPaid = ViewBag.TotalPaid ?? 0m;
    decimal totalApproved = ViewBag.TotalApproved ?? 0m;
    decimal remainingAmount = Model.TotalAmount - totalApproved;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-file-earmark-text text-primary me-2"></i>Sözleşme Detayı</h2>
            <p class="text-muted mb-0">@Model.PhonebookContact.Name - @Model.Title</p>
        </div>
                <div class="d-flex gap-2">
            <button class="btn btn-warning shadow-sm" data-bs-toggle="modal" data-bs-target="#printModal">
                <i class="bi bi-printer me-2"></i> Şablondan Yazdır
            </button>
            <a asp-action="ProjectContracts" asp-route-id="@Model.ProjectId" class="btn btn-light border shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Sözleşmelere Dön
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-primary text-white h-100">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase">Sözleşme Toplam Bedeli</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalAmount.ToString("N2") @Model.Currency</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-success text-white h-100">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase">Onaylanan Toplam Hakediş</h6>
                    <h3 class="fw-bold mb-0">@totalApproved.ToString("N2") @Model.Currency</h3>
                    <small>Ödenen: @totalPaid.ToString("N2") @Model.Currency</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-light h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase">Kalan (İçerideki) Bakiye</h6>
                    <h3 class="fw-bold mb-0 text-dark">@remainingAmount.ToString("N2") @Model.Currency</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-list-check me-2"></i>Serbest Hakedişler (Ödeme Talepleri)</h5>
            <button class="btn btn-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newPaymentModal">
                <i class="bi bi-plus-lg me-1"></i> Yeni Hakediş Ekle
            </button>
        </div>
        <div class="card-body">
            <div class="alert alert-info border-0 bg-info bg-opacity-10 mb-4">
                <i class="bi bi-info-circle-fill me-2"></i> <b>Esnek Hakediş Yapısı:</b> Şantiyedeki duruma göre (örn: Kat çıkıldığında, Kalıp çakıldığında vb.) istediğiniz tutarda serbest hakediş talebi oluşturabilirsiniz. Fazlara bağımlı olmak zorunda değilsiniz.
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Hakediş / Talep Adı</th>
                            <th class="text-end">Talep Edilen</th>
                            <th class="text-end">Onaylanan (Hakediş)</th>
                            <th class="text-center">Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!payments.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Henüz bu sözleşme için hakediş girilmemiş.</td></tr>
                        }
                        @foreach(var p in payments)
                        {
                            <tr>
                                <td>@p.RequestDate.ToShortDateString()</td>
                                <td>
                                    <strong>@p.PaymentTitle</strong>
                                    @if(!string.IsNullOrEmpty(p.Notes)) { <br/><small class="text-muted">@p.Notes</small> }
                                </td>
                                <td class="text-end">@p.RequestedAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">@p.ApprovedAmount.ToString("N2")</td>
                                <td class="text-center">
                                    @if(p.Status == ProgressPaymentStatus.Draft) { <span class="badge bg-secondary">Taslak</span> }
                                    else if(p.Status == ProgressPaymentStatus.PendingApproval) { <span class="badge bg-warning text-dark">Onay Bekliyor</span> }
                                    else if(p.Status == ProgressPaymentStatus.Approved) { <span class="badge bg-success">Onaylandı</span> }
                                    else if(p.Status == ProgressPaymentStatus.Paid) { <span class="badge bg-primary">Ödendi</span> }
                                    else { <span class="badge bg-danger">Reddedildi</span> }
                                </td>
                                <td class="text-end">
                                    @if(p.Status == ProgressPaymentStatus.Draft || p.Status == ProgressPaymentStatus.PendingApproval) {
                                        <button class="btn btn-sm btn-success rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#approveModal-@p.Id">
                                            <i class="bi bi-check-circle me-1"></i> Onayla
                                        </button>

                                        <!-- Approve Modal -->
                                        <div class="modal fade text-start" id="approveModal-@p.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg">
                                                    <div class="modal-header bg-success text-white border-0">
                                                        <h5 class="modal-title">Hakedişi Onayla</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-action="ApprovePayment" method="post">
                                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                                        <div class="modal-body p-4">
                                                            <div class="alert alert-warning border-0">
                                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                                Bu hakedişi onayladığınızda, tutar taşeronun <b>Cari Hesabına</b> otomatik olarak borç/alacak olarak işlenecektir.
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Onaylanan Tutar (TL)</label>
                                                                <input type="number" step="0.01" name="approvedAmount" class="form-control form-control-lg text-end fw-bold text-success" value="@p.RequestedAmount.ToString("0.00")" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Onay Notu</label>
                                                                <textarea name="approvalNotes" class="form-control" rows="2"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                                                            <button type="submit" class="btn btn-success fw-bold px-4">Onayla ve Cari'ye İşle</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Hakediş Modalı -->
<div class="modal fade" id="newPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title"><i class="bi bi-cash-coin me-2"></i>Yeni Hakediş (Ödeme Talebi)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddPayment" method="post">
                <input type="hidden" name="contractId" value="@Model.Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hakediş Adı / Açıklaması <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="Örn: 1. Kat Tabliye Betonu Hakedişi" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Talep Edilen / Hak Edilen Tutar (@Model.Currency) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="requestedAmount" class="form-control form-control-lg text-end" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ek Notlar (Opsiyonel)</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Şantiye şefinin notları..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Talebi Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>





<!-- YAZDIRMA MODALI -->
<div class="modal fade" id="printModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="/SubcontractorContract/PrintContract" method="get" target="_blank">
            <input type="hidden" name="contractId" value="@Model.Id" />
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-printer me-2"></i> Sözleşme Yazdır</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-4">Aşağıdan yazdırmak istediğiniz sözleşme şablonunu seçin. Sistem <strong>Firma Adı</strong>, <strong>Tutar</strong> ve <strong>Proje Adı</strong> gibi bilgileri otomatik dolduracaktır.</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Şablon Seçiniz</label>
                        <select name="templateId" class="form-select" required>
                            <option value="">-- Şablon Seçin --</option>
                            @if(ViewBag.Templates != null)
                            {
                                foreach(var t in ViewBag.Templates)
                                {
                                    <option value="@t.Id">@t.TemplateName (@t.Category)</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="bi bi-file-earmark-pdf me-1"></i> Önizle & Yazdır</button>
                </div>
            </div>
        </form>
    </div>
</div>
