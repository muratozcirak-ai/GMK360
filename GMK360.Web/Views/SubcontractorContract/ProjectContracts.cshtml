@model IEnumerable<GMK360.Core.Entities.Finance.SubcontractorContract>
@{
    ViewData["Title"] = "Proje Taþeronlarý";
    Layout = "_ConstructionProjectLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-file-earmark-text text-primary me-2"></i>Proje Taþeronlarý</h2>
            <p class="text-muted mb-0">Bu þantiyede aktif olarak çalýþan firmalar ve sözleþmeleri.</p>
        </div>
        <a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg fw-bold me-1"></i> Sözleþme (Taþeron) Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3">Firma (Taþeron)</th>
                            <th class="py-3">Sözleþme Adý</th>
                            <th class="py-3">Tip</th>
                            <th class="py-3 text-end">Toplam Bedel</th>
                            <th class="px-4 py-3 text-center">Ýþlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inboxes display-4 mb-2 d-block"></i>
                                    Bu þantiyeye henüz herhangi bir taþeron/sözleþme atanmamýþ.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <strong>@item.PhonebookContact.Name</strong><br />
                                    <small class="text-muted">@item.PhonebookContact.Name</small>
                                </td>
                                <td>
                                    <h6 class="mb-0 fw-bold">@item.Title</h6>
                                    <small class="text-muted">@item.ContractDate.ToShortDateString()</small>
                                </td>
                                <td>
                                    @if(item.IsExpenseContract)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">Gider (Ödeme)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Gelir (Tahsilat)</span>
                                    }
                                </td>
                                <td class="text-end fw-bold">
                                    @item.TotalAmount.ToString("N2") @item.Currency
                                </td>
                                <td class="px-4 text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="Sözleþme Detayý ve Fazlar">
                                        <i class="bi bi-search"></i> Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

