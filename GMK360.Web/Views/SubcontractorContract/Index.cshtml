@model IEnumerable<GMK360.Core.Entities.Finance.SubcontractorContract>
@{
    ViewData["Title"] = "Taþeron Sözleþmeleri";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="ph ph-handshake text-orange me-2"></i>Taþeron Sözleþmeleri</h2>
            <p class="text-muted mb-0">Þantiyelerinizdeki taþeron sözleþmelerini ve hakediþlerini yönetin.</p>
        </div>
        <a asp-action="Create" class="btn btn-orange rounded-pill px-4">
            <i class="ph ph-plus fw-bold me-1"></i> Yeni Sözleþme Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3">Sözleþme Adý</th>
                            <th class="py-3">Þantiye</th>
                            <th class="py-3">Taþeron</th>
                            <th class="py-3">Tip</th>
                            <th class="py-3 text-end">Toplam Bedel</th>
                            <th class="px-4 py-3 text-center">Ýþlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="ph ph-file-dashed display-4 mb-2 d-block"></i>
                                    Henüz kayýtlý bir taþeron sözleþmesi bulunmuyor.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <h6 class="mb-0 fw-bold">@item.Title</h6>
                                    <small class="text-muted">@item.ContractDate.ToShortDateString()</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="ph ph-buildings me-1"></i> @item.Project.Name
                                    </span>
                                </td>
                                <td>
                                    <strong>@item.PhonebookContact.Name</strong><br />
                                    <small class="text-muted">@item.PhonebookContact.Name</small>
                                </td>
                                <td>
                                    @if(item.IsExpenseContract)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger"><i class="ph ph-arrow-down-right"></i> Gider (Biz Ödeyeceðiz)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success"><i class="ph ph-arrow-up-right"></i> Gelir (Hurda/Tahsilat)</span>
                                    }
                                </td>
                                <td class="text-end fw-bold">
                                    @item.TotalAmount.ToString("N2") @item.Currency
                                </td>
                                <td class="px-4 text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="Sözleþme Detayý ve Fazlar">
                                        <i class="ph ph-magnifying-glass"></i> Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



