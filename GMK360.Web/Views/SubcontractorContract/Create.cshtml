@model GMK360.Core.Entities.Finance.SubcontractorContract
@{
    ViewData["Title"] = "Yeni Sözleþme Oluþtur";
    Layout = "_ConstructionLayout";
    var projects = ViewBag.Projects as IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>;
    var subcontractors = ViewBag.Subcontractors as IEnumerable<GMK360.Core.Entities.B2B.B2BNetworkContact>;
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle p-2 me-3">
            <i class="ph ph-arrow-left fs-4"></i>
        </a>
        <h2 class="fw-bold mb-0">Yeni Sözleþme Ekle</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="ProjectId" class="form-label fw-bold">Þantiye (Proje) Seçimi <span class="text-danger">*</span></label>
                                <select asp-for="ProjectId" class="form-select form-select-lg rounded-3" required>
                                    <option value="">-- Þantiye Seçiniz --</option>
                                    @if(projects != null)
                                    {
                                        foreach(var p in projects)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="ProjectId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhonebookContactId" class="form-label fw-bold">Taþeron Seçimi <span class="text-danger">*</span></label>
                                <select asp-for="PhonebookContactId" class="form-select form-select-lg rounded-3" required>
                                    <option value="">-- Taþeron Seçiniz --</option>
                                    @if(subcontractors != null)
                                    {
                                        foreach(var s in subcontractors)
                                        {
                                            <option value="@s.Id">@s.CompanyName (@s.ContactPerson)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PhonebookContactId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Title" class="form-label fw-bold">Sözleþme Adý / Baþlýðý <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="Örn: A Blok Demir Ýþçiliði" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Sözleþme Tipi <span class="text-danger">*</span></label>
                                <div class="d-flex gap-3">
                                    <div class="form-check border rounded-3 p-3 flex-fill">
                                        <input class="form-check-input ms-0 me-2" type="radio" asp-for="IsExpenseContract" value="true" id="typeExpense">
                                        <label class="form-check-label" for="typeExpense">
                                            <strong class="d-block text-danger"><i class="ph ph-arrow-down-right"></i> Gider Sözleþmesi</strong>
                                            <small class="text-muted">Normal taþeron iþleri. Biz taþerona para ödeyeceðiz.</small>
                                        </label>
                                    </div>
                                    <div class="form-check border rounded-3 p-3 flex-fill">
                                        <input class="form-check-input ms-0 me-2" type="radio" asp-for="IsExpenseContract" value="false" id="typeIncome">
                                        <label class="form-check-label" for="typeIncome">
                                            <strong class="d-block text-success"><i class="ph ph-arrow-up-right"></i> Gelir Sözleþmesi</strong>
                                            <small class="text-muted">Hurda vb. karþýlýðý yýkým iþleri. Taþeron bize para ödeyecek.</small>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TotalAmount" class="form-label fw-bold">Toplam Sözleþme Bedeli <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                    <select asp-for="Currency" class="form-select" style="max-width: 100px;">
                                        <option value="TRY">TRY</option>
                                        <option value="USD">USD</option>
                                        <option value="EUR">EUR</option>
                                    </select>
                                </div>
                                <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ContractDate" class="form-label fw-bold">Sözleþme Tarihi <span class="text-danger">*</span></label>
                                <input asp-for="ContractDate" type="date" class="form-control form-control-lg rounded-3" required />
                                <span asp-validation-for="ContractDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold">Ýþe Baþlama Tarihi (Opsiyonel)</label>
                                <input asp-for="StartDate" type="date" class="form-control form-control-lg rounded-3" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold">Ýþ Bitiþ Tarihi (Opsiyonel)</label>
                                <input asp-for="EndDate" type="date" class="form-control form-control-lg rounded-3" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold">Sözleþme / Ýþ Kapsamý (Opsiyonel)</label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Sözleþmenin detaylarý..."></textarea>
                            </div>
                        </div>

                        <hr class="my-5" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg rounded-pill px-4">Ýptal</a>
                            <button type="submit" class="btn btn-orange btn-lg rounded-pill px-5 fw-bold">Sözleþmeyi Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


