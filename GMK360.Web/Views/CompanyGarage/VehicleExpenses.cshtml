@model GMK360.Core.Entities.Logistics.CompanyVehicle
@{
    ViewData["Title"] = "Araç Masraf Geçmişi";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-receipt"></i> @Model.PlateNumber - Masraf Detayı</h4>
        <a href="/CompanyGarage" class="btn btn-outline-secondary">Garaja Dön</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Masraf Türü</th>
                            <th>Fiş/Fatura No</th>
                            <th>Tutar</th>
                            <th>O Anki KM</th>
                            <th>Belge Fotoğrafı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.Expenses.OrderByDescending(e => e.ExpenseDate))
                        {
                            <tr>
                                <td>@item.ExpenseDate.ToShortDateString()</td>
                                <td><span class="badge bg-secondary">@item.ExpenseType</span></td>
                                <td>@(item.ReceiptNumber ?? "-")</td>
                                <td class="fw-bold text-danger">@item.Amount.ToString("N2") ₺</td>
                                <td>@(item.OdometerAtExpense?.ToString() ?? "-") KM</td>
                                <td>
                                    @if(!string.IsNullOrEmpty(item.PhotoPath))
                                    {
                                        <a href="@item.PhotoPath" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-image"></i> Fişi Gör</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Yok</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if(!Model.Expenses.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Henüz masraf kaydedilmemiş.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>