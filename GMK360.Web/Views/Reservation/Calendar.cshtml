@model GMK360.Web.Models.DailyRentalCalendarViewModel
@{
    ViewData["Title"] = "Günlük Kiralama Takvimi";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-primary"><i class="fas fa-calendar-alt me-2"></i> @Model.UnitNumber - Günlük Kiralama</h2>
            <p class="text-muted mb-0">Oda Tipi: @Model.RoomLayout</p>
        </div>
        <div>
            <a href="@Url.Action("Calendar", new { unitId = Model.UnitId, year = Model.Month == 1 ? Model.Year - 1 : Model.Year, month = Model.Month == 1 ? 12 : Model.Month - 1 })" class="btn btn-outline-secondary me-2"><i class="fas fa-chevron-left"></i> Önceki Ay</a>
            <span class="fw-bold fs-5 mx-3">@Model.Month / @Model.Year</span>
            <a href="@Url.Action("Calendar", new { unitId = Model.UnitId, year = Model.Month == 12 ? Model.Year + 1 : Model.Year, month = Model.Month == 12 ? 1 : Model.Month + 1 })" class="btn btn-outline-secondary ms-2">Sonraki Ay <i class="fas fa-chevron-right"></i></a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="row row-cols-1 row-cols-md-4 row-cols-lg-7 g-3">
                @foreach (var day in Model.Days)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm @day.CssClass rounded-3 transition-hover" style="min-height: 100px;">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center position-relative">
                                <h4 class="fw-bold mb-0">@day.Date.Day</h4>
                                <small class="text-white-50">@day.Date.ToString("ddd")</small>
                                
                                @if (day.IsReserved)
                                {
                                    <span class="badge bg-light text-danger mt-2">Dolu</span>
                                    <small class="mt-1 text-white-50" style="font-size: 0.7rem;">G: @day.GuestName</small>
                                    <a href="#" class="stretched-link" data-bs-toggle="modal" data-bs-target="#reservationModal" data-res-id="@day.ReservationId" data-guest="@day.GuestName" data-date="@day.Date.ToShortDateString()" title="Detayları Gör"></a>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success mt-2">Müsait</span>
                                    <a href="#" class="stretched-link" title="Rezerve Et"></a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Reservation Details Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white border-0">
        <h5 class="modal-title" id="reservationModalLabel"><i class="fas fa-info-circle me-2"></i> Rezervasyon Detayı</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="mb-3">
            <h6 class="text-muted mb-1">Tarih</h6>
            <p class="fw-bold fs-5" id="modalResDate">-</p>
        </div>
        <div class="mb-3">
            <h6 class="text-muted mb-1">Misafir (Ana Hesap)</h6>
            <p class="fw-bold fs-5" id="modalResGuest">-</p>
        </div>
        <div class="mb-4">
            <h6 class="text-muted mb-1">KBS Bildirim Durumu</h6>
            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> Bildirildi</span>
        </div>
        <div class="d-grid gap-2">
            <a href="#" class="btn btn-outline-primary"><i class="fas fa-users me-2"></i> Diğer Misafirleri Gör (KBS)</a>
            <button class="btn btn-outline-danger"><i class="fas fa-times-circle me-2"></i> Rezervasyonu İptal Et</button>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var reservationModal = document.getElementById('reservationModal');
            reservationModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var guest = button.getAttribute('data-guest');
                var date = button.getAttribute('data-date');
                var resId = button.getAttribute('data-res-id');

                var modalGuest = reservationModal.querySelector('#modalResGuest');
                var modalDate = reservationModal.querySelector('#modalResDate');

                modalGuest.textContent = guest || "Bilinmiyor";
                modalDate.textContent = date;
            });
        });
    </script>
}

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
