@model GMK360.Core.Entities.Agency
@{
    Layout = null; // Kendi ozel ofis tasariimi
    var color = string.IsNullOrEmpty(Model.ThemePrimaryColor) ? "#1e3a8a" : Model.ThemePrimaryColor;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.CompanyName - GMK360</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --agency-color: @color;
        }
        .bg-agency { background-color: var(--agency-color); }
        .text-agency { color: var(--agency-color); }
        .btn-agency { background-color: var(--agency-color); color: white; border: none; }
        .btn-agency:hover { filter: brightness(0.9); color: white; }
    </style>
</head>
<body class="bg-light">

    <!-- Header -->
    <header class="bg-white shadow-sm sticky-top">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                @if(!string.IsNullOrEmpty(Model.LogoUrl)) {
                    <img src="@Model.LogoUrl" alt="Logo" height="40" class="me-3" />
                } else {
                    <div class="bg-agency text-white fw-bold rounded px-3 py-2 me-3 fs-5">@(Model.CompanyName.Substring(0,1))</div>
                }
                <h4 class="mb-0 fw-bold text-dark">@Model.CompanyName</h4>
            </div>
            <div>
                <a href="tel:@Model.WhatsAppNumber" class="btn btn-outline-success rounded-pill fw-bold">
                    <i class="bi bi-whatsapp"></i> Bize Ulaþýn
                </a>
            </div>
        </div>
    </header>

    <!-- Hero / Banner -->
    <section class="bg-agency py-5 text-center text-white" style="@(!string.IsNullOrEmpty(Model.BannerUrl) ? $"background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('{Model.BannerUrl}') center/cover;" : "")">
        <div class="container py-5">
            <h1 class="display-4 fw-bold mb-3">Sýcak Yuvanýzý Bulalým</h1>
            <p class="lead mb-4">Güvenilir ve hýzlý gayrimenkul çözümleri.</p>
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="input-group input-group-lg shadow-sm">
                        <input type="text" class="form-control border-0" placeholder="Ýlan No, Bölge veya Kelime Arayýn...">
                        <button class="btn btn-warning fw-bold px-4"><i class="bi bi-search"></i> Ara</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Danismanlar (Ornek) -->
    <section class="container py-5">
        <h3 class="fw-bold mb-4 text-center">Ekibimiz</h3>
        <div class="row g-4">
            @if(Model.AgencyConsultants != null && Model.AgencyConsultants.Any())
            {
                foreach(var c in Model.AgencyConsultants)
                {
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm text-center p-3 h-100">
                            <img src="@(string.IsNullOrEmpty(c.User.ProfileImageUrl) ? "/images/default-avatar.png" : c.User.ProfileImageUrl)" class="rounded-circle mx-auto mb-3" width="80" height="80" style="object-fit:cover;">
                            <h6 class="fw-bold mb-1">@(c.User.FirstName + " " + c.User.LastName)</h6>
                            <span class="badge bg-light text-dark mb-2">@c.Role.ToString()</span>
                            <small class="text-muted"><i class="bi bi-telephone"></i> @c.User.PhoneNumber</small>
                        </div>
                    </div>
                }
            } else {
                <div class="col-12 text-center text-muted">Henüz danýþman eklenmedi.</div>
            }
        </div>
    </section>

    <!-- Ýlanlar (Mockup) -->
    <section class="bg-white py-5">
        <div class="container">
            <h3 class="fw-bold mb-4 text-center">Öne Çýkan Ýlanlarýmýz</h3>
            <div class="text-center text-muted py-5">
                <i class="bi bi-house-door display-1 text-agency opacity-25"></i>
                <p class="mt-3">Ýlanlar yakýnda eklenecek...</p>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white py-4 text-center">
        <small>&copy; @System.DateTime.Now.Year @Model.CompanyName. Altyapý: <b>GMK360</b> Kurumsal Çözümleri</small>
    </footer>

</body>
</html>
