@{
    ViewData["Title"] = "İş Ortağı Özeti";
    Layout = "~/Views/Shared/_PartnerLayout.cshtml";
    var contact = ViewBag.Contact as GMK360.Core.Entities.Construction.AgencyPhonebook;
    var account = ViewBag.Account as GMK360.Core.Entities.Finance.SupplierCurrentAccount;
    var contracts = ViewBag.Contracts as IEnumerable<GMK360.Core.Entities.Finance.SubcontractorContract>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Hoş Geldiniz, @contact.Name</h2>
        <p class="text-muted mb-0">İş Ortağı Portalınız</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 bg-primary text-white p-4">
            <h6 class="text-white-50 text-uppercase fw-bold mb-3"><i class="bi bi-wallet2 me-2"></i> Güncel Bakiye (Alacağınız)</h6>
            @if(account != null)
            {
                <h1 class="display-5 fw-bold mb-0">@account.CurrentBalance.ToString("N2") ₺</h1>
                @if(account.CurrentBalance > 0)
                {
                    <p class="mt-2 mb-0 opacity-75">Bu tutar şirketimizden tahsil edilmeyi bekleyen toplam alacağınızdır.</p>
                }
                else if(account.CurrentBalance < 0)
                {
                    <p class="mt-2 mb-0 opacity-75">Şu an @Math.Abs(account.CurrentBalance).ToString("N2") ₺ avanslı (borçlu) durumdasınız.</p>
                }
            }
            else
            {
                <h1 class="display-5 fw-bold mb-0">0.00 ₺</h1>
                <p class="mt-2 mb-0 opacity-75">Henüz finansal bir işleminiz bulunmuyor.</p>
            }
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 p-4">
            <h6 class="text-muted text-uppercase fw-bold mb-3"><i class="bi bi-file-earmark-text me-2"></i> Aktif Sözleşmeleriniz</h6>
            @if(contracts != null && contracts.Any())
            {
                <h1 class="display-5 fw-bold text-dark mb-0">@contracts.Count() <span class="fs-6 text-muted fw-normal">Sözleşme</span></h1>
                <a href="/PartnerPortal/Contracts" class="btn btn-sm btn-outline-dark rounded-pill mt-3 w-100">Hakedişlere Git</a>
            }
            else
            {
                <div class="text-center py-2 text-muted">
                    <i class="bi bi-file-x fs-1 d-block mb-2 opacity-25"></i>
                    Sistemde adınıza tanımlı bir taşeron sözleşmesi bulunmuyor.
                </div>
            }
        </div>
    </div>
</div>

@if(account != null && account.Transactions.Any())
{
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 px-4">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i> Son İşlemler (Cari Hareketler)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Açıklama</th>
                            <th class="text-end pe-4">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var tx in account.Transactions)
                        {
                            var amountClass = tx.Type == GMK360.Core.Entities.Finance.SupplierTransactionType.PaymentMade ? "text-success" : "text-danger";
                            var prefix = tx.Type == GMK360.Core.Entities.Finance.SupplierTransactionType.PaymentMade ? "-" : "+";
                            <tr>
                                <td class="ps-4 text-muted small">@tx.TransactionDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@tx.Description</td>
                                <td class="text-end pe-4 fw-bold @amountClass">@prefix @tx.Amount.ToString("N2") ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="text-center p-3 border-top">
                <a href="/PartnerPortal/Ledger" class="btn btn-light btn-sm w-100 fw-bold">Tüm Ekstreyi Gör</a>
            </div>
        </div>
    </div>
}
