@model GMK360.Core.Entities.B2B.B2BQuoteInvite
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang=""tr"">
<head>
    <meta charset=""utf-8"">
    <meta name=""viewport"" content=""width=device-width, initial-scale=1"">
    <title>Teklif Talebi | @Model.QuoteRequest.RequesterAgency.CompanyName</title>
    <link href=""https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"" rel=""stylesheet"">
    <link rel=""stylesheet"" href=""https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"">
    <style>
        body { background-color: #f8f9fa; }
        .quote-header { background-color: #0d6efd; color: white; padding: 2rem 0; border-bottom: 5px solid #0a58ca; }
    </style>
</head>
<body>
    <div class=""quote-header mb-4 shadow-sm"">
        <div class=""container"">
            <div class=""row align-items-center"">
                <div class=""col-md-8"">
                    <h2 class=""mb-1 fw-bold""><i class=""bi bi-file-earmark-text""></i> Fiyat Teklif Formu</h2>
                    <p class=""mb-0 opacity-75"">Gönderen: @Model.QuoteRequest.RequesterAgency.CompanyName</p>
                </div>
                <div class=""col-md-4 text-md-end mt-3 mt-md-0"">
                    <span class=""badge bg-light text-primary rounded-pill px-3 py-2"">Son Tarih: @Model.QuoteRequest.Deadline.ToString("dd.MM.yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class=""container mb-5"">
        <div class=""card border-0 shadow-sm rounded-4 mb-4"">
            <div class=""card-body p-4"">
                <h4 class=""fw-bold mb-3 text-primary"">@Model.QuoteRequest.Title</h4>
                <p class=""text-muted"">@Model.QuoteRequest.Description</p>
                
                <hr>
                <div class=""row mb-3"">
                    <div class=""col-md-6"">
                        <small class=""text-muted d-block"">Tedarikçi / Muhatap</small>
                        <strong class=""fs-5"">@Model.NetworkContact.CompanyName</strong><br>
                        <span class=""text-secondary"">@Model.NetworkContact.ContactPerson</span>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action=""Submit"" method=""post"">
            <input type=""hidden"" name=""token"" value=""@Model.AccessToken"" />
            
            <div class=""card border-0 shadow-sm rounded-4 mb-4"">
                <div class=""card-header bg-white border-bottom-0 pt-4 pb-0 px-4"">
                    <h5 class=""fw-bold mb-0""><i class=""bi bi-list-check text-primary me-2""></i>İstenen Malzemeler / Hizmetler</h5>
                </div>
                <div class=""card-body p-4"">
                    <div class=""table-responsive"">
                        <table class=""table table-hover align-middle"">
                            <thead class=""table-light"">
                                <tr>
                                    <th>Kalem Adı</th>
                                    <th>Açıklama</th>
                                    <th class=""text-center"">Miktar</th>
                                    <th width=""200"">Birim Fiyat Teklifiniz (₺)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.QuoteRequest.Items)
                                {
                                    var existingOffer = Model.InviteItems?.FirstOrDefault(i => i.B2BQuoteItemId == item.Id)?.OfferedUnitPrice;
                                    <tr>
                                        <td class=""fw-bold"">@item.MaterialCatalog?.Name</td>
                                        <td class=""text-muted small"">@item.Description</td>
                                        <td class=""text-center"">
                                            <span class=""badge bg-secondary rounded-pill px-3 py-2 fs-6"">@item.Quantity @item.MaterialCatalog?.DefaultUnit</span>
                                        </td>
                                        <td>
                                            <input type=""hidden"" name=""itemIds"" value=""@item.Id"" />
                                            <div class=""input-group"">
                                                <input type=""number"" step=""0.01"" class=""form-control"" name=""itemPrices"" placeholder=""0.00"" value=""@(existingOffer)"" required>
                                                <span class=""input-group-text"">₺</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class=""card border-0 shadow-sm rounded-4 mb-4"">
                <div class=""card-body p-4"">
                    <div class=""row"">
                        <div class=""col-md-6 mb-3"">
                            <label class=""form-label fw-bold"">Genel Toplam Teklif (KDV Hariç vb.)</label>
                            <div class=""input-group"">
                                <span class=""input-group-text bg-light"">₺</span>
                                <input type=""number"" step=""0.01"" class=""form-control form-control-lg"" name=""offeredPrice"" value=""@Model.OfferedPrice"">
                            </div>
                            <small class=""text-muted"">Yukarıdaki kalemlerin toplamını buraya yazabilirsiniz.</small>
                        </div>
                        <div class=""col-md-12 mb-3"">
                            <label class=""form-label fw-bold"">Teklif Notu / Şartlarınız</label>
                            <textarea class=""form-control"" name=""offerNotes"" rows=""3"" placeholder=""Örn: Nakliye firmamıza aittir, ödeme peşin vb..."">@Model.OfferNotes</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class=""text-end"">
                <button type=""submit"" class=""btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm"">
                    <i class=""bi bi-send me-2""></i> Teklifi Gönder
                </button>
            </div>
        </form>
    </div>
</body>
</html>

