@model GMK360.Web.Models.KurumsalB2BDashboardViewModel
@{
    ViewData["Title"] = "Kurumsal B2B Çözüm Ortakları & Sanayi Hub'ı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --kurumsal-primary: #1e293b;
        --kurumsal-accent: #0284c7;
        --whatsapp-green: #25D366;
    }

    body {
        background-color: #f8fafc;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .kurumsal-hero {
        background: linear-gradient(135deg, #090d16 0%, #1e293b 60%, #0369a1 100%);
        color: white;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.4);
    }

    .card-modern {
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        background: #ffffff;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
    }

    .nav-pills-kurumsal .nav-link {
        color: #475569;
        font-weight: 700;
        border-radius: 1rem;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s;
    }

    .nav-pills-kurumsal .nav-link.active {
        background: var(--kurumsal-primary);
        color: white;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.3);
    }

    .btn-whatsapp {
        background-color: var(--whatsapp-green);
        color: white;
        font-weight: 700;
        border: none;
    }
    .btn-whatsapp:hover {
        background-color: #128C7E;
        color: white;
    }
</style>

<div class="container-fluid p-0 mb-5">

    <!-- BİLDİRİM MESAJLARI -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- KURUMSAL HERO BAŞLIĞI -->
    <div class="kurumsal-hero pt-4 pb-5 px-3 px-md-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge bg-primary text-white fw-bold rounded-pill px-3 py-1">
                            <i class="bi bi-buildings-fill me-1"></i> B2B Sanayi & Çözüm Ortakları
                        </span>
                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1">
                            <i class="bi bi-shield-check me-1"></i> Bakanlık & TÜRKAK Onaylı
                        </span>
                        <span class="badge bg-info text-dark fw-bold rounded-pill px-3 py-1">
                            <i class="bi bi-cpu-fill me-1"></i> Şantiye DNA Motoru Entegre
                        </span>
                    </div>

                    <h2 class="fw-bold mb-1 text-white">Kurumsal İnşaat & Sanayi Hub'ı</h2>
                    <p class="text-white-50 mb-0 fs-6">
                        Müteahhitlerin ve inşaat firmalarının çalıştığı <strong>orman ürünleri, alçıpan, hazır beton, Braas çatı</strong> üreticileri ile <strong>yapı denetim, laboratuvar ve hukuk</strong> masası.
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="AddSampleData" class="btn btn-outline-warning text-white rounded-4 px-3 py-3" title="Demo Verileri Yenile">
                        <i class="bi bi-arrow-clockwise me-1"></i> Demo Yükle
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ANA İÇERİK -->
    <div class="container" style="margin-top: -1.75rem;">

        <!-- SEKMELER -->
        <ul class="nav nav-pills nav-pills-kurumsal mb-4 gap-2" id="kurumsalTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="suppliers-tab" data-bs-toggle="pill" data-bs-target="#suppliers-pane" type="button">
                    <i class="bi bi-truck me-1"></i> İhtisas Endüstriyel Tedarikçiler (@Model.Suppliers.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="authorities-tab" data-bs-toggle="pill" data-bs-target="#authorities-pane" type="button">
                    <i class="bi bi-patch-check-fill me-1"></i> Yapı Denetim & Akredite Laboratuvar (@Model.TechnicalAuthorities.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="legal-tab" data-bs-toggle="pill" data-bs-target="#legal-pane" type="button">
                    <i class="bi bi-file-earmark-medical-fill me-1"></i> GMK İmar, Hukuk & SGK Danışmanlığı
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="tenders-tab" data-bs-toggle="pill" data-bs-target="#tenders-pane" type="button">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Aktif Şantiye DNA İhaleleri (@Model.ActiveDnaTenders.Count)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="kurumsalTabsContent">

            <!-- 1. SEKME: İHTİSAS ENDÜSTRİYEL TEDARİKÇİLER -->
            <div class="tab-pane fade show active" id="suppliers-pane" role="tabpanel">
                <div class="row g-4">
                    @foreach (var s in Model.Suppliers)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card-modern p-4 h-100 border-start border-4 border-primary">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-dark rounded-pill px-3 py-1 mb-2">@s.SpecializationCategory</span>
                                        <h5 class="fw-bold text-dark mb-1">@s.CompanyName</h5>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @s.CityDistrict 
                                            &bull; <i class="bi bi-person-fill text-primary me-1"></i> @s.ContactPerson
                                        </p>
                                    </div>
                                    <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1">
                                        <i class="bi bi-star-fill text-dark me-1"></i> @s.Rating
                                    </span>
                                </div>

                                <!-- HİBRİT YETENEK MATRİSİ ROZETLERİ -->
                                <div class="d-flex flex-wrap gap-2 my-3">
                                    @if (s.SuppliesMaterial)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small">
                                            <i class="bi bi-box-seam-fill me-1"></i> Malzeme & Toptan Tedarik
                                        </span>
                                    }
                                    @if (s.ProvidesLaborInstallation)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                                            <i class="bi bi-tools me-1"></i> Şantiye Taşeronluk & Montaj
                                        </span>
                                    }
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1 small">
                                        <i class="bi bi-truck me-1"></i> @s.MinimumOrderScale
                                    </span>
                                </div>

                                <!-- ANA ÜRÜNLER -->
                                <div class="bg-light p-3 rounded-4 mb-3 border small">
                                    <strong class="text-dark d-block mb-1">Başlıca Ürün & Hizmetler:</strong>
                                    <ul class="mb-0 ps-3">
                                        @foreach (var prod in s.MainProducts)
                                        {
                                            <li>@prod</li>
                                        }
                                    </ul>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <a href="tel:@s.PhoneNumber" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        <i class="bi bi-telephone-fill me-1"></i> @s.PhoneNumber
                                    </a>
                                    <a href="@s.WhatsAppQuoteUrl" target="_blank" class="btn btn-whatsapp btn-sm rounded-pill px-4 flex-grow-1 text-center">
                                        <i class="bi bi-whatsapp me-1"></i> Doğrudan Fiyat Teklifi İste
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. SEKME: YAPI DENETİM & AKREDİTE LABORATUVAR -->
            <div class="tab-pane fade" id="authorities-pane" role="tabpanel">
                <div class="row g-4">
                    @foreach (var auth in Model.TechnicalAuthorities)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card-modern p-4 h-100 border-start border-4 border-success">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-success rounded-pill px-3 py-1 mb-2">@auth.AuthorityType</span>
                                        <h5 class="fw-bold text-dark mb-1">@auth.OrganizationName</h5>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-shield-check text-success me-1"></i> Lisans/Akreditasyon No: <strong>@auth.LicenseNumber</strong>
                                        </p>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @auth.CityDistrict 
                                            &bull; Yetkili: @auth.ContactPerson
                                        </p>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-patch-check-fill me-1"></i> Onaylı
                                    </span>
                                </div>

                                <div class="bg-light p-3 rounded-4 mb-3 border small">
                                    <strong class="text-dark d-block mb-1">Yetki ve Denetim Kapsamı:</strong>
                                    <ul class="mb-0 ps-3">
                                        @foreach (var serv in auth.ServicesProvided)
                                        {
                                            <li>@serv</li>
                                        }
                                    </ul>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <a href="tel:@auth.PhoneNumber" class="btn btn-outline-success btn-sm rounded-pill px-4 w-100 text-center fw-bold">
                                        <i class="bi bi-telephone-fill me-1"></i> Şantiye Denetim & Test Randevusu Al (@auth.PhoneNumber)
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 3. SEKME: GMK HUKUK & SGK DANIŞMANLIĞI -->
            <div class="tab-pane fade" id="legal-pane" role="tabpanel">
                <div class="row g-4">
                    @foreach (var law in Model.LegalAdvisors)
                    {
                        <div class="col-12 col-lg-8 mx-auto">
                            <div class="card-modern p-4 border-top border-4 border-warning">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 mb-2">@law.PracticeArea</span>
                                        <h4 class="fw-bold text-dark mb-1">@law.LawyerOrFirmName</h4>
                                        <small class="text-muted"><i class="bi bi-bank me-1"></i> @law.BarAssociationCity</small>
                                    </div>
                                </div>

                                <p class="text-muted my-3">@law.Description</p>

                                <div class="p-3 bg-light rounded-4 border mb-3 small">
                                    <strong class="text-dark d-block mb-2">Uzmanlık ve Danışmanlık Alanları:</strong>
                                    <div class="row g-2">
                                        @foreach (var spec in law.KeySpecialties)
                                        {
                                            <div class="col-12 col-md-6">
                                                <i class="bi bi-check-circle-fill text-success me-1"></i> @spec
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <a href="tel:@law.ContactPhone" class="btn btn-dark fw-bold rounded-pill px-4 w-100 text-center">
                                        <i class="bi bi-telephone-fill me-1"></i> Hukukî Danışmanlık & Sözleşme Randevusu (@law.ContactPhone)
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. SEKME: AKTİF ŞANTİYE DNA İHALELERİ -->
            <div class="tab-pane fade" id="tenders-pane" role="tabpanel">
                <div class="card-modern p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Canlı Şantiye DNA İhale Talepleri</h5>
                            <p class="text-muted small mb-0">Müteahhit firmaların şantiye DNA'sından doğrudan açtığı endüstriyel toptan malzeme ve taşeron ihaleleri.</p>
                        </div>
                        <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold">Canlı İhaleler</span>
                    </div>

                    <div class="row g-3">
                        @foreach (var tender in Model.ActiveDnaTenders)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="p-3 border rounded-4 bg-white shadow-sm h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="badge bg-primary rounded-pill px-3">@tender.TenderCategory</span>
                                            <small class="text-danger fw-bold"><i class="bi bi-clock-history"></i> Kalan: 3 Gün</small>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">@tender.ProjectName</h5>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-buildings text-primary me-1"></i> Müteahhit: <strong>@tender.ContractorCompany</strong> 
                                            &bull; <i class="bi bi-geo-alt-fill text-danger me-1"></i> @tender.Location
                                        </p>
                                        <div class="p-2 bg-light rounded-3 small mb-3">
                                            <strong>İhale Metrajı / İhtiyaç:</strong> @tender.QuantityDescription
                                        </div>
                                    </div>

                                    <div class="pt-2 border-top">
                                        <button class="btn btn-warning text-dark fw-bold rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#tenderBidModal-@tender.Id">
                                            <i class="bi bi-send-fill me-1"></i> Bu İhaleye Fiyat Teklifi Ver
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- İHALEYE TEKLİF VERME MODALI -->
                            <div class="modal fade" id="tenderBidModal-@tender.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0">
                                        <div class="modal-header bg-dark text-white">
                                            <h5 class="modal-title fw-bold text-white"><i class="bi bi-send text-warning me-2"></i>İhale Teklifi Ver</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="SubmitTenderBid" method="post">
                                            <input type="hidden" name="tenderId" value="@tender.Id" />
                                            <div class="modal-body p-4">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted">Şantiye & Proje</label>
                                                    <input type="text" class="form-control rounded-3" value="@tender.ProjectName (@tender.ContractorCompany)" readonly />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted">Firmanızın Ünvanı</label>
                                                    <input type="text" name="bidderCompany" class="form-control rounded-3" placeholder="Örn: Marmara Orman Ürünleri A.Ş." required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted">Toplam Fiyat Teklifiniz (KDV Hariç TL)</label>
                                                    <input type="number" step="any" name="bidAmount" class="form-control form-control-lg rounded-3 fw-bold text-success" placeholder="Örn: 480000" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted">Vade & Sevkiyat Şartları</label>
                                                    <textarea name="notes" rows="2" class="form-control rounded-3" placeholder="Örn: Şantiyeye tır teslim, 60 gün vadeli çek ile..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                                                <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">Teklifi Müteahhide İlet</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
