@model IEnumerable<GMK360.Core.Entities.Construction.ProjectMaterialCatalog>

@{
    ViewData["Title"] = "Malzeme ve Donanım Kataloğu";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    
    var categories = Model.Select(m => m.Category).Distinct().ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-palette text-primary me-2"></i>Katalog Yönetimi</h2>
        <p class="text-muted mb-0"><i class="bi bi-building me-1"></i>Proje: @ViewBag.ProjectName</p>
    </div>
    <div>
        <a asp-controller="ConstructionProject" asp-action="Details" asp-route-id="@ViewBag.ProjectId" class="btn btn-outline-secondary rounded-pill px-3 me-2">
            <i class="bi bi-arrow-left me-1"></i> Projeye Dön
        </a>
        <a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Yeni Seçenek Ekle
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3 fw-bold">Katalog Henüz Boş</h4>
            <p class="text-muted">Bu proje için müşterilerinize sunacağınız fayans, laminat, dolap rengi gibi malzeme seçeneklerini eklemeye başlayın.</p>
            <a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary rounded-pill px-4 mt-2">
                İlk Malzemeyi Ekle
            </a>
        </div>
    </div>
}
else
{
    @foreach (var category in categories)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-tags text-orange me-2"></i>@category Seçenekleri</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    @foreach (var item in Model.Where(m => m.Category == category))
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="card h-100 border rounded-4 overflow-hidden position-relative">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.MaterialName" style="height: 150px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 150px;">
                                        <i class="bi bi-image" style="font-size: 2rem;"></i>
                                    </div>
                                }
                                <div class="card-body">
                                    <h6 class="fw-bold">@item.MaterialName</h6>
                                    <p class="small text-muted mb-2">@item.Description</p>
                                    
                                    @if (item.PriceDifference > 0)
                                    {
                                        <div class="badge bg-danger-subtle text-danger mb-2">
                                            +@item.PriceDifference.ToString("N2") ₺ Fark
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="badge bg-success-subtle text-success mb-2">
                                            Standart Paket (Farksız)
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-white border-top-0 pt-0">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu malzemeyi katalogdan kaldırmak istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">Kaldır</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
