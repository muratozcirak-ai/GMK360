@{
    ViewData["Title"] = "Yeni Malzeme Seçeneği Ekle";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Kataloga Yeni Seçenek Ekle</h2>
    <a asp-action="Index" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i> İptal ve Geri Dön
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <input type="hidden" name="constructionProjectId" value="@ViewBag.ProjectId" />
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Malzeme Kategorisi</label>
                    <input type="text" name="category" class="form-control form-control-lg" placeholder="Örn: Mutfak Dolabı, Salon Zemini, Banyo Fayansı" required />
                    <div class="form-text">Müşteriler bu seçeneği bu kategori başlığı altında görecekler.</div>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">Seçenek Adı (Model / Marka)</label>
                    <input type="text" name="materialName" class="form-control form-control-lg" placeholder="Örn: Çamsan Açık Meşe, Akrilik Parlak Beyaz" required />
                </div>
                
                <div class="col-md-12">
                    <label class="form-label fw-bold">Açıklama (Opsiyonel)</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Örn: Suya dayanıklı birinci sınıf malzeme..."></textarea>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">Malzeme Görseli</label>
                    <input type="file" name="imageFile" class="form-control form-control-lg" accept="image/*" required />
                    <div class="form-text">Müşterilerin portaldan seçimi yaparken göreceği görseli yükleyin.</div>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">Fiyat Farkı (Opsiyonel)</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">₺</span>
                        <input type="number" step="0.01" name="priceDifference" class="form-control" value="0" />
                    </div>
                    <div class="form-text text-danger">Bu seçenek standart pakete dahilse "0" bırakın. Lüks pakete giriyorsa müşteri seçtiğinde yansıyacak farkı yazın.</div>
                </div>
                
                <div class="col-12 mt-5 text-end">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                        <i class="bi bi-save me-2"></i> Kataloga Ekle
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
