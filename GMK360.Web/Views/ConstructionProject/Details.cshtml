@model GMK360.Core.Entities.Construction.ConstructionProject

@functions {
    public int GetKotOffset(GMK360.Core.Entities.Building b) {
        if (b == null) return 0;
        if (!string.IsNullOrEmpty(b.AttachedToBlock)) {
            var match = System.Text.RegularExpressions.Regex.Match(b.AttachedToBlock, @"(?:Kot|Offset)\s*[:=]\s*([+-]?\d+)");
            if (match.Success && int.TryParse(match.Groups[1].Value, out int offset)) return offset;
        }
        if (!string.IsNullOrEmpty(b.TechnicalFeatures)) {
            var match = System.Text.RegularExpressions.Regex.Match(b.TechnicalFeatures, @"(?:KotOffset|KotKaymasi)\s*[:=]\s*([+-]?\d+)");
            if (match.Success && int.TryParse(match.Groups[1].Value, out int offset)) return offset;
        }
        return 0;
    }
}

@{
    ViewData["Title"] = "Proje Detayı: " + Model.Name;
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    ViewData["ProjectId"] = Model.Id;
    ViewData["ProjectName"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-building-check text-primary me-2"></i>@Model.Name
            @if(Model.IsDataLocked)
            {
                <span class="badge bg-danger ms-2 shadow-sm fs-6 align-middle"><i class="bi bi-lock-fill"></i> SİSTEM KİLİTLİ (Baseline)</span>
            }
        </h2>
        <p class="text-muted mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
            <span>@(string.IsNullOrWhiteSpace(Model.Address) ? "Adres belirtilmemiş" : Model.Address)</span>
            @if(Model.Latitude != null && Model.Longitude != null)
            {
                <a href="https://www.google.com/maps?q=@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" target="_blank" class="badge bg-danger bg-opacity-10 text-danger text-decoration-none rounded-pill px-2 py-1 shadow-sm" title="Haritada Gör">
                    <i class="bi bi-map-fill me-1"></i> Haritada Gör
                </a>
            }
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 me-2">
            <i class="bi bi-arrow-left me-1"></i> Projelere Dön
        </a> 
        <div class="dropdown d-inline-block ms-2">
            <button class="btn btn-outline-secondary rounded-pill px-4 shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Durum: @Model.Status.ToString().Replace("_", " ")
            </button>
            <ul class="dropdown-menu shadow">
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Aktif_Santiye" /><button type="submit" class="dropdown-item fw-bold text-primary"><i class="bi bi-cone-striped me-2"></i>Aktif Åantiye Yap</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Tamamlandi_Teslim" /><button type="submit" class="dropdown-item fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i>Projeyi Bitir (Biten)</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Anlasma_Yapildi" /><button type="submit" class="dropdown-item"><i class="bi bi-handshake me-2"></i>Anlaşma Yapıldı Yap</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Projelendirme_Teklif" /><button type="submit" class="dropdown-item"><i class="bi bi-search me-2"></i>Aday Proje Yap</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Satista_Topraktan" /><button type="submit" class="dropdown-item"><i class="bi bi-cash-coin me-2"></i>Satışa Çıkar</button></form></li>
            </ul>
        </div>

        
        <a href="/ProjectMatrix/Index?projectId=@Model.Id" target="_blank" class="btn btn-primary text-white fw-bold ms-2 shadow-sm"><i class="bi bi-grid-3x3-gap-fill"></i> Matris'e (Gantt) Git</a>

        <a href="/ConstructionProject/Create/@Model.Id" target="_blank" class="btn btn-warning text-dark fw-bold ms-2"><i class="bi bi-magic"></i> Sihirbaza Dön / Düzenle</a>
        
        

    </div>
</div>

@if (Model.ParentProjectId.HasValue && Model.ParentProject != null)
{
    <div class="alert alert-primary bg-primary bg-opacity-10 border-primary border-0 rounded-4 p-3 mb-3 d-flex align-items-center justify-content-between shadow-xs">
        <div class="d-flex align-items-center">
            <div class="rounded-circle bg-primary text-white p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="bi bi-diagram-3-fill fs-5"></i>
            </div>
            <div>
                <span class="badge bg-primary text-white mb-1">ALT İMALAT PROJESİ</span>
                <div class="fw-bold text-dark fs-6">Bu proje <u><a href="/ConstructionProject/Details/@Model.ParentProjectId" class="text-primary text-decoration-underline">@Model.ParentProject.Name</a></u> ana projesine bağlı bir alt imalat paketidir.</div>
            </div>
        </div>
        <a href="/ConstructionProject/Details/@Model.ParentProjectId" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
            <i class="bi bi-arrow-up-right-circle me-1"></i> Ana Projeye Git
        </a>
    </div>

    @* ALT PROJE İMALAT MODELİ BİLGİLENDİRME KARTI *@
