<div class="modal fade" id="createSubProjectModal" tabindex="-1" aria-labelledby="createSubProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="createSubProjectModalLabel">
                    <i class="bi bi-diagram-3-fill me-2"></i>Yeni Alt Proje / İmalat Paketi Ekle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <form id="createSubProjectForm">
                    <input type="hidden" id="subParentProjectId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Alt Proje / İmalat Paketi Adı <span class="text-danger">*</span></label>
                        <input type="text" id="subProjectNameInput" class="form-control rounded-3" placeholder="Örn: Giriş Güvenlik Kulübesi, Çocuk Oyun Parkı, Açık Yüzme Havuzu, İstinat Duvarı" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">İmalat Kategorisi</label>
                            <select id="subProjectCategorySelect" class="form-select rounded-3">
                                <option value="SosyalDonati">Sosyal Donatı & Sosyal Tesis</option>
                                <option value="DisSaha_Peyzaj">Dış Saha, Peyzaj & Yeşil Alan</option>
                                <option value="OzelImalat">Özel İmalat (Giriş Takı, Kulübe, Havuz)</option>
                                <option value="Altyapi">Altyapı, İstinat Duvarı & Çevre İhata</option>
                                <option value="Mekanik_Elektrik">Mekanik, Elektrik, Trafo & Jeneratör</option>
                                <option value="Asansor">Asansör & Taşıma Sistemleri</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Yaklaşık Bütçe (₺)</label>
                            <input type="number" id="subProjectBudgetInput" class="form-control rounded-3" placeholder="Opsiyonel Tahmini Bütçe" />
                        </div>
                    </div>

                    <!-- KRİTİK SEÇİM: DXF VS DÖKÜMAN -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">İmalat & Metraj Modeli <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="card h-100 border p-3 rounded-3 shadow-xs position-relative" style="cursor: pointer;">
                                    <div class="d-flex align-items-start gap-2">
                                        <input type="radio" name="subExecutionMode" value="DocumentProcurement" class="form-check-input mt-1" checked />
                                        <div>
                                            <div class="fw-bold text-dark"><i class="bi bi-file-earmark-text text-secondary me-1"></i>Teklif & Döküman (RFQ)</div>
                                            <small class="text-muted d-block mt-1">CAD/DXF çizimi olmayan hazır donatı alımları ve taşeron ihaleleri içindir (Şartname, teklif toplama, sözleşme takibi).</small>
                                        </div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="card h-100 border p-3 rounded-3 shadow-xs position-relative" style="cursor: pointer;">
                                    <div class="d-flex align-items-start gap-2">
                                        <input type="radio" name="subExecutionMode" value="DxfEngineering" class="form-check-input mt-1" />
                                        <div>
                                            <div class="fw-bold text-primary"><i class="bi bi-rulers text-primary me-1"></i>Mühendislik & Metraj (DXF)</div>
                                            <small class="text-muted d-block mt-1">AutoCAD/DXF çizimi bulunan; statik karkası, bağımsız duvar ve mahal metrajları hesaplanacak yapılar içindir.</small>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold text-dark">Açıklama & Notlar</label>
                        <textarea id="subProjectDescInput" class="form-control rounded-3" rows="2" placeholder="İmalat paketiyle ilgili teknik notlar..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-white border-0 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-xs" onclick="submitCreateSubProject()">
                    <i class="bi bi-check-circle me-1"></i> Alt Projeyi Başlat
                </button>
            </div>
        </div>
    </div>
</div>

<!-- AUTOCAD / DXF ÇİZİMİ YÜKLE MODAL -->
<div class="modal fade" id="uploadDxfModal" tabindex="-1" aria-labelledby="uploadDxfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="uploadDxfModalLabel">
                    <i class="bi bi-file-earmark-arrow-up-fill me-2"></i>AutoCAD / DXF Çizimi Yükle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="UploadProjectDxf" method="post" enctype="multipart/form-data">
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-info border-0 rounded-3 mb-3">
                        <i class="bi bi-info-circle me-2"></i><strong>Mühendislik & Metraj Moduna Geçiş:</strong> Çiziminizi yüklediğinizde proje otomatik olarak detaylı mühendislik ve metraj moduna yükseltilir.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">DXF / DWG Çizim Dosyası <span class="text-danger">*</span></label>
                        <input type="file" name="dxfFile" class="form-control rounded-3" accept=".dxf,.dwg" required />
                        <small class="text-muted">Desteklenen formatlar: .dxf, .dwg</small>
                    </div>
                </div>
                <div class="modal-footer bg-white border-0 py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-xs">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Çizimi Yükle ve Başlat
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Add child tower handler
        document.querySelectorAll('.btn-add-child-tower').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var parentId = this.getAttribute('data-parent-id');
                var parentName = this.getAttribute('data-parent-name');

                document.getElementById('addChildParentBuildingId').value = parentId || '';
                document.getElementById('addChildParentNameSpan').textContent = parentName || '';

                var towerModal = new bootstrap.Modal(document.getElementById('addChildTowerModal'));
                towerModal.show();
            });
        });

        // Edit block handler
        document.querySelectorAll('.btn-open-edit-block').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var id = this.getAttribute('data-id');
                var name = this.getAttribute('data-name');
                var basearea = this.getAttribute('data-basearea');
                var totalfloors = this.getAttribute('data-totalfloors');
                var basementfloors = this.getAttribute('data-basementfloors');
                var hasground = this.getAttribute('data-hasground');
                var hasroof = this.getAttribute('data-hasroof');
                var rooftype = this.getAttribute('data-rooftype');
                var elevators = this.getAttribute('data-elevators');
                var parking = this.getAttribute('data-parking');
                var insulation = this.getAttribute('data-insulation');
                var features = this.getAttribute('data-features') || '';
                var desc = this.getAttribute('data-desc');
                var kotoffset = this.getAttribute('data-kotoffset');

                document.getElementById('editBlockId').value = id || '';
                document.getElementById('editBlockName').value = name || '';
                document.getElementById('editBlockBaseArea').value = (basearea && basearea != '0') ? basearea : '';
                document.getElementById('editBlockTotalFloors').value = totalfloors || '0';
                document.getElementById('editBlockBasementFloors').value = basementfloors || '0';
                document.getElementById('editBlockHasGround').value = (hasground === 'true') ? 'true' : 'false';
                document.getElementById('editBlockHasRoof').value = (hasroof === 'true') ? 'true' : 'false';
                document.getElementById('editBlockRoofType').value = rooftype || '';
                document.getElementById('editBlockElevators').value = (elevators && elevators != '0') ? elevators : '';
                document.getElementById('editBlockParking').value = parking || '';
                document.getElementById('editBlockInsulation').value = insulation || '';
                document.getElementById('editBlockDesc').value = desc || '';
                var kotSelect = document.getElementById('editBlockKotOffset');
                if (kotSelect) {
                    kotSelect.value = kotoffset || '0';
                }

                // Donanımlar checkbox matching
                var featureList = features ? features.split(',').map(function(s) { return s.trim(); }) : [];
                var extraFeatures = [];
                document.querySelectorAll('.edit-block-feature-chk').forEach(function(chk) {
                    if (featureList.indexOf(chk.value) !== -1) {
                        chk.checked = true;
                    } else {
                        chk.checked = false;
                    }
                });
                featureList.forEach(function(item) {
                    var found = false;
                    document.querySelectorAll('.edit-block-feature-chk').forEach(function(chk) {
                        if (chk.value.toLowerCase() === item.toLowerCase()) found = true;
                    });
                    if (!found && item.length > 0) {
                        extraFeatures.push(item);
                    }
                });
                document.getElementById('editBlockFeatures').value = extraFeatures.join(', ');

                var editModal = new bootstrap.Modal(document.getElementById('editBlockModal'));
                editModal.show();
            });
        });

        // Delete block handler
        document.querySelectorAll('.btn-open-delete-block').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var id = this.getAttribute('data-id');
                var name = this.getAttribute('data-name');

                document.getElementById('deleteBlockId').value = id || '';
                document.getElementById('deleteBlockNameSpan').textContent = name || '';

                var delModal = new bootstrap.Modal(document.getElementById('deleteBlockModal'));
                delModal.show();
            });
        });
    });

    function submitCreateSubProject() {
        var parentId = document.getElementById("subParentProjectId").value;
        var name = document.getElementById("subProjectNameInput").value.trim();
        if (!name) {
            alert("Lütfen alt proje veya imalat paketi için bir isim giriniz.");
            document.getElementById("subProjectNameInput").focus();
            return;
        }

        var category = document.getElementById("subProjectCategorySelect").value;
        var modeRadio = document.querySelector('input[name="subExecutionMode"]:checked');
        var executionMode = modeRadio ? modeRadio.value : "DocumentProcurement";
        var desc = document.getElementById("subProjectDescInput").value.trim();

        fetch("/ConstructionProject/CreateSubProjectFromAmenity", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                ParentProjectId: parseInt(parentId),
                CustomProjectName: name,
                Category: category,
                ExecutionMode: executionMode,
                HasDxf: (executionMode === "DxfEngineering"),
                Description: desc
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    location.reload();
                }
            } else {
                alert(data.message || "Alt proje oluşturulamadı.");
            }
        })
        .catch(err => {
            console.error(err);
            alert("Bağlantı hatası oluştu.");
        });
    }
</script>
