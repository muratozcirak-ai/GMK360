@model GMK360.Core.Entities.Construction.ConstructionProject

@{
    ViewData["Title"] = "Proje Detayı: " + Model.Name;
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-building-check text-primary me-2"></i>@Model.Name</h2>
        <p class="text-muted mb-0"><i class="bi bi-geo-alt me-1"></i>@Model.Address</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 me-2">
            <i class="bi bi-arrow-left me-1"></i> Projelere Dön
        </a> <a href="/ConstructionProject/Create/@Model.Id" class="btn btn-warning text-dark fw-bold ms-2"><i class="bi bi-magic"></i> Sihirbaza Dön / Düzenle</a>
        <a asp-controller="ProjectMaterial" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-palette me-2"></i> Müşteri Malzeme Kataloğu
        </a>
        <a asp-action="ManagePhases" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-4 shadow-sm text-white fw-bold">
            <i class="bi bi-kanban me-2"></i> Şantiye Aşamaları ve Bütçe (ERP)
        </a>

    </div>
</div>


<!-- BARIYER (FAZ 0) UYARISI YERINE GERCEK TABLO -->
<div class="accordion mb-4 shadow-sm" id="accordionFaz0">
    <div class="accordion-item border-0 rounded-4 overflow-hidden">
        <h2 class="accordion-header d-flex" id="headingFaz0">
            <button class="accordion-button bg-danger bg-opacity-10 text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaz0" aria-expanded="true" aria-controls="collapseFaz0">
                <i class="bi bi-file-earmark-lock-fill fs-5 text-danger me-2"></i> FAZ 0: Yasal Evrak, İzin ve Sözleşme Takibi
            </button>
            <div class="bg-danger bg-opacity-10 d-flex align-items-center pe-3">
                <button type="button" class="btn btn-sm btn-danger fw-bold rounded-pill text-nowrap shadow-sm" data-bs-toggle="modal" data-bs-target="#addCustomDocModal">
                    <i class="bi bi-plus-lg"></i> Özel Evrak Ekle
                </button>
            </div>
        </h2>
        <div id="collapseFaz0" class="accordion-collapse collapse show" aria-labelledby="headingFaz0">
            <div class="accordion-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Evrak / Kriter Adı</th>
                                <th>Kimden Alınır / Makam</th>
                                <th>Kurum İçi İlgili (Tanıdık)</th>
                                <th>Sorumlu Takipçi</th>
                                <th>Durum</th>
                                <th>Açıklama / Not</th>
                                <th class="text-end pe-3">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (((List<GMK360.Core.Entities.Construction.ProjectLegalDocument>)ViewBag.Phase0Docs) == null || !((List<GMK360.Core.Entities.Construction.ProjectLegalDocument>)ViewBag.Phase0Docs).Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Bu projeye henüz evrak/kriter eklenmemiş.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var doc in ((List<GMK360.Core.Entities.Construction.ProjectLegalDocument>)ViewBag.Phase0Docs).OrderByDescending(x => x.IsCustom).ThenBy(x => x.Id))
                                {
                                    <tr>
                                        <td class="fw-bold ps-3">
                                            @(doc.SystemTemplate?.Name ?? doc.DocumentName)
                                            @if(doc.IsCustom) { <span class="badge bg-info ms-1" title="Sizin Eklediğiniz Özel Evrak">Özel</span> }
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><i class="bi bi-building"></i> @(doc.AppliedTo ?? doc.SystemTemplate?.IssuedBy ?? "Belirtilmedi")</span></td>
                                        <td>
                                            @if(!string.IsNullOrEmpty(doc.InstitutionContact)) { <span class="text-primary"><i class="bi bi-person-lines-fill"></i> @doc.InstitutionContact</span> } else { <span class="text-muted fst-italic">Bilinmiyor</span> }
                                        </td>
                                        <td>
                                            @if(string.IsNullOrEmpty(doc.TrackingPerson)) { <span class="text-danger fw-bold"><i class="bi bi-exclamation-circle"></i> Atanmadı</span> } else { <span><i class="bi bi-person-badge text-primary"></i> @doc.TrackingPerson</span> }
                                        </td>
                                        <td>
                                            @if (doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.NotApplied)
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-x-circle"></i> Yok</span>
                                            }
                                            else if (doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.Applied)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-hourglass-split"></i> Başvuruldu</span>
                                            }
                                            else if (doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.Issue)
                                            {
                                                <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-exclamation-triangle"></i> Sorun Var</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle"></i> Alındı</span>
                                            }
                                            @if(doc.ExpiryDate.HasValue && doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.Approved) {
                                                var days = (doc.ExpiryDate.Value - DateTime.UtcNow).TotalDays;
                                                string color = days > 30 ? "success" : (days > 7 ? "warning" : "danger");
                                                string icon = days > 30 ? "check-circle" : (days > 7 ? "exclamation-triangle" : "exclamation-octagon-fill");
                                                <div class="mt-2">
                                                    <span class="badge bg-@color rounded-pill text-@(color == "warning" ? "dark" : "white")" title="Bitiş Tarihi">
                                                        <i class="bi bi-@icon"></i> Kalan: @((int)days) gün
                                                    </span>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if(!string.IsNullOrEmpty(doc.Notes)) { <small class="text-muted">@doc.Notes</small> } else { <span class="text-muted">-</span> }
                                        </td>
                                        <td class="text-end pe-3">
                                            <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#editDocModal_@doc.Id">
                                                <i class="bi bi-pencil-square"></i> Yönet
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Güncelle Modal -->
                                    <div class="modal fade" id="editDocModal_@doc.Id" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content border-0 shadow">
                                                <form asp-action="UpdateLegalDocumentStatus" asp-controller="ConstructionProject" method="post">
                                                    <div class="modal-header bg-light border-0">
                                                        <h5 class="modal-title text-dark fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Evrak / Aşama Yönetimi</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                                        
                                                        <div class="alert alert-info border-0 rounded-3 mb-4">
                                                            <strong class="d-block mb-1 fs-5">@(doc.SystemTemplate?.Name ?? doc.DocumentName)</strong>
                                                            <small>@(doc.SystemTemplate?.TargetModule ?? "Projeye özel eklenmiş evrak.")</small>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">Nereye Başvuruldu / Kimden Alınır?</label>
                                                            <input type="text" class="form-control bg-light" name="appliedTo" value="@(doc.AppliedTo ?? doc.SystemTemplate?.IssuedBy)">
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold text-primary"><i class="bi bi-person-lines-fill"></i> Kurum İçi İlgili / Tanıdık (Varsa)</label>
                                                            <input type="text" class="form-control border-primary" name="institutionContact" value="@doc.InstitutionContact" placeholder="Örn: İmar Md. Ayşe Hanım">
                                                            <div class="form-text">Devlet veya kurumda işlemleri hızlandıracak temas noktası.</div>
                                                        </div>
                                                        <hr/>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold text-danger"><i class="bi bi-person-badge"></i> Sorumlu Takipçi (Personel Ata)</label>
                                                            <input type="text" class="form-control border-danger" name="trackingPerson" value="@doc.TrackingPerson" placeholder="Örn: Proje Müdürü Ahmet Bey">
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">Evrak / Başvuru Durumu</label>
                                                            <select class="form-select" name="statusId">
                                                                <option value="0" selected="@(doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.NotApplied)">Alınmadı / Yok</option>
                                                                <option value="1" selected="@(doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.Applied)">Başvuruldu / Bekliyor</option>
                                                                <option value="2" selected="@(doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.Issue)">Sorun Çıktı / İptal (Açıklama Giriniz)</option>
                                                                <option value="3" selected="@(doc.Status == GMK360.Core.Entities.Construction.LegalDocumentStatus.Approved)">Onaylandı / Var</option>
                                                            </select>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">Açıklama / Süreç Notları</label>
                                                            <textarea class="form-control" name="notes" rows="3" placeholder="Örn: Belediye reddetti çünkü projede eksiklik var...">@doc.Notes</textarea>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold text-warning"><i class="bi bi-calendar-x"></i> Geçerlilik Bitiş Tarihi</label>
                                                            <input type="date" class="form-control" name="expiryDate" value="@(doc.ExpiryDate?.ToString("yyyy-MM-dd"))">
                                                            <small class="text-muted">Evrakın bir geçerlilik süresi varsa (örn: SGK dosyası, Yapı Ruhsatı süresi) giriniz. Yaklaşınca uyarı verilecektir.</small>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                                                        <button type="submit" class="btn btn-primary rounded-pill fw-bold">Değişiklikleri Kaydet</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- ŞANTİYE ÖZEL MAL KABUL BÖLÜMÜ -->
@if(ViewBag.PendingDeliveries != null)
{
    var pending = (IEnumerable<GMK360.Core.Entities.Construction.InventoryReceipt>)ViewBag.PendingDeliveries;
    if(pending.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-warning border-start border-5">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-truck text-warning me-2 fs-4"></i> Kamyon Yolda / Bekleyen Malzemeler</h5>
                    <span class="badge bg-warning text-dark fs-6 rounded-pill">@pending.Count() İrsaliye/Sipariş</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Tedarikçi</th>
                                <th>Evrak No</th>
                                <th>İnecek Depo</th>
                                <th>Sorumlu Personel</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var rec in pending)
                            {
                                <tr>
                                    <td>@rec.ReceiptDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="fw-bold">@rec.SupplierName</td>
                                    <td>@rec.DocumentNumber</td>
                                    <td><i class="bi bi-geo-alt text-muted"></i> @rec.Warehouse.Name</td>
                                    <td>
                                        @if(rec.AssignedUser != null)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                                <i class="bi bi-person me-1"></i> @rec.AssignedUser.DisplayName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Atanmadı</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <!-- Burada mobilde veya webde basılacak sayım ekranı butonu var -->
                                        <a href="/InventoryReceipts/Details/@rec.Id" class="btn btn-sm btn-success fw-bold px-3 rounded-pill shadow-sm">
                                            <i class="bi bi-box-seam me-1"></i> Sayım Yap & Teslim Al
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3">Proje Özeti</h5>
                <p>@Model.Description</p>
                <div class="row mt-4">
                    <div class="col-sm-4">
                        <div class="text-muted small">Başlangıç Tarihi</div>
                        <div class="fw-bold">@Model.StartDate.ToString("dd.MM.yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Bitiş Tarihi</div>
                        <div class="fw-bold">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd.MM.yyyy") : "Belirtilmedi")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Toplam Blok</div>
                        <div class="fw-bold">@(Model.Blocks?.Count ?? 0) Adet</div>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-top position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-muted">Arazi ve Dış Alanlar</h6>
                        <a asp-action="Amenities" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-pencil me-1"></i> Yönet</a>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-aspect-ratio text-success fs-4 me-3"></i>
                                <div>
                                    <div class="text-muted small">Toplam Arazi Alanı</div>
                                    <div class="fw-bold text-dark">@(Model.TotalLandArea.HasValue ? Model.TotalLandArea.Value + " m²" : "Belirtilmedi")</div>
                                </div>
                          <div class="col-sm-6">
                              <div class="d-flex align-items-center">
                                  <i class="bi bi-building text-primary fs-4 me-3"></i>
                                  <div>
                                      <div class="text-muted small">Toplam Bina Alanı (Oturum)</div>
                                      <div class="fw-bold text-dark">@(Model.Blocks?.Sum(b => b.BaseArea ?? 0) > 0 ? Model.Blocks.Sum(b => b.BaseArea ?? 0) + " m²" : "Belirtilmedi")</div>
                                  </div>
                              </div>
                          </div>
                            </div>
                        </div>
                        
                        
                        @if (Model.Amenities != null && Model.Amenities.Any())
                        {
                            foreach(var amenity in Model.Amenities)
                            {
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-check-circle text-primary fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small">@amenity.Name</div>
                                            <div class="fw-bold text-dark">
                                                @(amenity.SquareMeters.HasValue ? amenity.SquareMeters.Value + " m²" : "Mevcut")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 mt-3">
                                <div class="text-muted small fst-italic"><i class="bi bi-info-circle me-1"></i>Kamelya, açık otopark, çocuk parkı gibi dış alan donatıları henüz eklenmedi.</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-muted"><i class="bi bi-geo-alt text-danger me-1"></i> Çevre Özellikleri ve Yakın Konumlar</h6>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-arrow-repeat me-1"></i> Haritadan Güncelle</button>
                    </div>
                    
                    
                    <div class="alert alert-secondary d-flex align-items-center p-4 mb-0">
                        <i class="bi bi-geo-alt fs-2x text-muted me-4"></i>
                        <div class="d-flex flex-column">
                            <h4 class="mb-1 text-dark">Konum Verileri Bekleniyor</h4>
                            <span class="text-muted">Sistem canlıya alındığında Google Haritalar (Places API) üzerinden hastane, okul, park gibi çevre özellikleri buraya otomatik çekilecektir.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" class="img-fluid h-100" style="object-fit: cover;" alt="Proje Görseli" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light h-100 text-muted">
                    <div class="text-center">
                        <i class="bi bi-image" style="font-size: 3rem;"></i>
                        <p class="mt-2 mb-0">Görsel Yok</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>



<!-- TASLAK / KONU TARTIŞMA BÖLÜMÜ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-warning bg-opacity-10 border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-chat-square-dots text-warning me-2"></i>Açık Konular / Ön Hazırlık Talepleri</h5>
        <button class="btn btn-sm btn-warning text-dark fw-bold rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addDraftModal">
            <i class="bi bi-plus-lg"></i> Yeni Konu Aç
        </button>
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush rounded-bottom-4">
            @{
                var drafts = Model.Phases?.Where(p => p.Status == -1).ToList() ?? new List<GMK360.Core.Entities.Construction.ProjectPhase>();
                if (!drafts.Any())
                {
                    <div class="list-group-item p-4 text-center text-muted border-0">
                        Henüz tartışmaya açılmış bir konu veya ön talep bulunmuyor.
                    </div>
                }
                else
                {
                    foreach (var draft in drafts)
                    {
                        <a href="@Url.Action("DraftPhaseDetails", new { id = draft.Id })" class="list-group-item list-group-item-action p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">@draft.Name</h6>
                                <small class="text-muted">@draft.Description</small>
                            </div>
                            <span class="badge bg-warning text-dark rounded-pill">Tartışma Açık <i class="bi bi-arrow-right ms-1"></i></span>
                        </a>
                    }
                }
            }
        </div>
    </div>
</div>

<!-- Yeni Talep Modal -->
<div class="modal fade" id="addDraftModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddPhase" asp-controller="ConstructionProject" method="post">
                <div class="modal-header bg-warning border-0">
                    <h5 class="modal-title text-dark fw-bold"><i class="bi bi-journal-plus me-2"></i>Yeni Ön Çalışma / Konu Aç</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <!-- Status -1 means Draft/Talep -->
                    <input type="hidden" name="status" value="-1" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Konu Başlığı</label>
                        <input type="text" class="form-control" name="name" placeholder="Örn: Arazi Çevresinin Kapatılması" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama / İhtiyaç Özeti</label>
                        <textarea class="form-control" name="description" rows="3" placeholder="Örn: Depoda yeterli trapez sac yok, dışarıdan kiralama veya satın alma yapılacak. Onay bekliyoruz."></textarea>
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Bu konu bir <strong>Taslak</strong> olarak açılır. Yönetim onayladıktan sonra resmi şantiye fazına dönüşür ve harcamalar başlar.
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark">Talebi Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- KOMUTA MERKEZİ (DASHBOARD) -->
@{
    var allMessages = Model.Phases?
        .Where(p => p.PhaseTasks != null)
        .SelectMany(p => p.PhaseTasks)
        .Where(t => t.TaskMessages != null)
        .SelectMany(t => t.TaskMessages)
        .OrderByDescending(m => m.SentAt)
        .Take(5)
        .ToList() ?? new List<GMK360.Core.Entities.Construction.TaskMessage>();

    bool hasMessages = allMessages.Any();
}

<div class="row g-4 mb-4 mt-2">
    @if(hasMessages)
    {
        <!-- SOL: Canlı Saha Akışı -->
        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 rounded-4">
                <div class="card-header bg-white border-bottom py-3 rounded-top-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-broadcast text-primary me-2"></i>Canlı Saha Akışı (Radar)</h6>
                </div>
                <div class="card-body p-3" style="max-height: 350px; overflow-y: auto;">
                    @foreach(var msg in allMessages)
                    {
                        <div class="d-flex mb-3">
                            <div class="bg-light border rounded p-2 shadow-sm w-100">
                                <div class="d-flex justify-content-between">
                                    <strong class="text-primary small">@msg.SenderName</strong>
                                    <small class="text-muted">@msg.SentAt.ToString("HH:mm - dd MMM")</small>
                                </div>
                                <p class="mb-0 mt-1 small">@msg.Message</p>
                                <div class="text-end mt-1"><span class="badge bg-secondary" style="font-size: 0.65rem;">@msg.PhaseTask?.Name</span></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    

<!-- Custom Doc Modal at the bottom -->
<div class="modal fade" id="addCustomDocModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddCustomLegalDocument" asp-controller="ConstructionProject" method="post">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-plus me-2"></i>Projeye Özel Evrak/Kriter Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    
                    <div class="alert alert-warning small mb-4">
                        <i class="bi bi-exclamation-triangle me-1"></i> Bu evrak sadece <strong>bu projeye özel</strong> olarak eklenecektir. Tüm projelerde görünmesini istiyorsanız Sistem Yöneticisi olarak ayarlardan eklemelisiniz.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Evrak / Kriter Adı</label>
                        <input type="text" class="form-control" name="customName" placeholder="Örn: X Belediyesi Özel Yıkım İzni" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kimden Alınır / İlgili Kurum</label>
                        <input type="text" class="form-control bg-light" name="appliedTo" placeholder="Örn: X Belediyesi İmar Md." required>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill">Kaydet ve Listeye Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>


<h4 class="fw-bold mb-3"><i class="bi bi-grid-1x2 text-orange me-2"></i>Projedeki Bloklar / Binalar</h4>

<div class="row g-4">
    @if (Model.Blocks != null && Model.Blocks.Any())
    {
        foreach (var block in Model.Blocks)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold text-navy mb-0">@block.BlockName</h5>
                            <span class="badge bg-light text-dark border"><i class="bi bi-layers me-1"></i>@(block.TotalFloors ?? 0) Kat</span>
                        </div>
                        
                        <div class="d-flex justify-content-between text-muted small mb-4">
                            <div><i class="bi bi-door-open me-1"></i>Toplam @block.TotalUnits Bağımsız Bölüm</div>
                            <div><i class="bi bi-check-circle text-success me-1"></i>@(block.Units?.Count ?? 0) Tanımlı</div>
                        </div>

                        <a asp-action="ManageBlock" asp-route-id="@block.Id" class="btn btn-outline-primary w-100 rounded-pill">
                            Kat ve Daire Planlarını Yönet <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info rounded-4 border-0 d-flex align-items-center">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    Bu projeye henüz blok eklenmemiş. Lütfen düzenleme ekranından blok ekleyin.
                </div>
            </div>
        </div>
    }
</div>




