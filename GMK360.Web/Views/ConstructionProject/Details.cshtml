                                        <!-- Burada mobilde veya webde basÄ±lacak sayÄ±m ekranÄ± butonu var -->
                                        <a href="/InventoryReceipts/Details/@rec.Id" class="btn btn-sm btn-success fw-bold px-3 rounded-pill shadow-sm">
