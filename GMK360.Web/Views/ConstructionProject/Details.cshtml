<!-- KOMUTA MERKEZİ (DASHBOARD) -->
@{
    var allMessages = Model.Phases?
        .Where(p => p.PhaseTasks != null)
        .SelectMany(p => p.PhaseTasks)
        .Where(t => t.TaskMessages != null)
        .SelectMany(t => t.TaskMessages)
        .OrderByDescending(m => m.SentAt)
        .Take(5)
        .ToList() ?? new List<GMK360.Core.Entities.Construction.TaskMessage>();

    bool hasMessages = allMessages.Any();
}

<div class="row g-4 mb-4 mt-2">
    @if(hasMessages)
    {
        <!-- SOL: Canlı Saha Akışı -->
        <div class="col-12">
            <div class="card shadow-sm border-0 h-100 rounded-4">
                <div class="card-header bg-white border-bottom py-3 rounded-top-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-broadcast text-primary me-2"></i>Canlı Saha Akışı (Radar)</h6>
                </div>
                <div class="card-body p-3" style="max-height: 350px; overflow-y: auto;">
                    @foreach(var msg in allMessages)
                    {
                        <div class="d-flex mb-3">
                            <div class="bg-light border rounded p-2 shadow-sm w-100">
                                <div class="d-flex justify-content-between">
                                    <strong class="text-primary small">@msg.SenderName</strong>
                                    <small class="text-muted">@msg.SentAt.ToString("HH:mm - dd MMM")</small>
                                </div>
                                <p class="mb-0 mt-1 small">@msg.Message</p>
                                <div class="text-end mt-1"><span class="badge bg-secondary" style="font-size: 0.65rem;">@msg.PhaseTask?.Name</span></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    

