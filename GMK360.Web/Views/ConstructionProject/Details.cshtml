@model GMK360.Core.Entities.Construction.ConstructionProject

@{
    ViewData["Title"] = "Proje Detayı: " + Model.Name;
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    ViewData["ProjectId"] = Model.Id;
    ViewData["ProjectName"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-building-check text-primary me-2"></i>@Model.Name
            @if(Model.IsDataLocked)
            {
                <span class="badge bg-danger ms-2 shadow-sm fs-6 align-middle"><i class="bi bi-lock-fill"></i> SİSTEM KİLİTLİ (Baseline)</span>
            }
        </h2>
        <p class="text-muted mb-0"><i class="bi bi-geo-alt me-1"></i>@Model.Address</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 me-2">
            <i class="bi bi-arrow-left me-1"></i> Projelere Dön
        </a> 
        <div class="dropdown d-inline-block ms-2">
            <button class="btn btn-outline-secondary rounded-pill px-4 shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Durum: @Model.Status.ToString().Replace("_", " ")
            </button>
            <ul class="dropdown-menu shadow">
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Aktif_Santiye" /><button type="submit" class="dropdown-item fw-bold text-primary"><i class="bi bi-cone-striped me-2"></i>Aktif Åantiye Yap</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Tamamlandi_Teslim" /><button type="submit" class="dropdown-item fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i>Projeyi Bitir (Biten)</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Anlasma_Yapildi" /><button type="submit" class="dropdown-item"><i class="bi bi-handshake me-2"></i>Anlaşma Yapıldı Yap</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Projelendirme_Teklif" /><button type="submit" class="dropdown-item"><i class="bi bi-search me-2"></i>Aday Proje Yap</button></form></li>
                <li><form asp-action="ChangeProjectStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="newStatus" value="Satista_Topraktan" /><button type="submit" class="dropdown-item"><i class="bi bi-cash-coin me-2"></i>Satışa Çıkar</button></form></li>
            </ul>
        </div>

        <a href="/ConstructionProject/Create/@Model.Id" target="_blank" class="btn btn-warning text-dark fw-bold ms-2"><i class="bi bi-magic"></i> Sihirbaza Dön / Düzenle</a>
        
        

    </div>
</div>




<div class="accordion mb-4 shadow-sm" id="accordionStakeholders">
    <div class="accordion-item border-0 rounded-4 overflow-hidden">
        <h2 class="accordion-header d-flex" id="headingStakeholders">
            <button class="accordion-button collapsed bg-warning bg-opacity-10 text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStakeholders" aria-expanded="false" aria-controls="collapseStakeholders">
                <i class="bi bi-people-fill fs-5 text-warning me-2"></i> KİMLİK / PAYDAŞLAR: Hak Sahipleri, Arsa Sahipleri ve Ortaklar
            </button>
            <div class="bg-warning bg-opacity-10 d-flex align-items-center pe-3">
                <button class="btn btn-sm btn-warning fw-bold rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addStakeholderModal">
                    <i class="bi bi-person-plus-fill me-1"></i> Yeni Paydaş / Temsilci Ekle
                </button>
            </div>
        </h2>
        <div id="collapseStakeholders" class="accordion-collapse collapse" aria-labelledby="headingStakeholders" data-bs-parent="#accordionStakeholders">
            <div class="accordion-body bg-white p-4">
                <div class="alert alert-info border-info bg-info bg-opacity-10 mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i> <strong>Önemli:</strong> Projeye eklenen Arsa Sahipleri ve Temsilciler, giriş yaptıklarında projenin ilerleme raporlarını görebilirler. Kişinin TC Kimlik numarası MERNİS üzerinden doğrulanarak tekil CRM kaydı olarak tutulur.
                </div>
                
                <!-- Stakeholders List (Placeholder for now) -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>TC Kimlik No</th>
                                <th>Projedeki Rolü</th>
                                <th>Hisse / Arsa Payı</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var stakeholdersList = ViewBag.Stakeholders as List<GMK360.Core.Entities.Construction.ProjectStakeholder>; }
                              @if (stakeholdersList != null && stakeholdersList.Any())
                            {
                                foreach (var st in stakeholdersList)
                                {
                                    <tr>
                                          <td class="fw-bold align-middle">
                                              <i class="bi bi-person-circle text-secondary me-2"></i> @st.User.FirstName @st.User.LastName
                                          </td>
                                          <td class="align-middle">
                                              <span class="d-block mb-1">@(string.IsNullOrEmpty(st.User.TcIdentityNo) ? "Kayıtlı Değil" : st.User.TcIdentityNo)</span>
                                              @if (st.User.EmailConfirmed || st.User.PhoneNumberConfirmed)
                                              {
                                                  <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-check-circle-fill me-1"></i> Onaylı / Girdi</span>
                                              }
                                              else
                                              {
                                                  <span class="badge bg-warning bg-opacity-10 text-warning border border-warning" title="Sisteme henüz giriş yapmadı"><i class="bi bi-hourglass-split me-1"></i> SMS Bekliyor</span>
                                              }
                                          </td>
                                          <td class="align-middle">
                                              @if (st.Role == GMK360.Core.Entities.Construction.StakeholderRole.Landowner)
                                              {
                                                  <span class="badge bg-primary px-3 py-2">Arsa Sahibi</span>
                                              }
                                              else if (st.Role == GMK360.Core.Entities.Construction.StakeholderRole.Representative)
                                              {
                                                  <span class="badge bg-secondary px-3 py-2">Temsilci / Avukat</span>
                                              }
                                              else
                                              {
                                                  <span class="badge bg-info text-dark px-3 py-2">@st.Role.ToString()</span>
                                              }
                                          </td>
                                          <td class="fw-bold text-primary align-middle fs-5">
                                              @(st.SharePercentage.HasValue ? $"% {st.SharePercentage.Value.ToString("N2")}" : "-")
                                          </td>
                                          <td class="align-middle text-end pe-4">
                                              <button type="button" class="btn btn-sm btn-outline-warning rounded-pill shadow-sm me-1" onclick="editStakeholder('@st.Id', '@st.Role', '@(st.SharePercentage.HasValue ? st.SharePercentage.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")')" title="Düzenle">
                                                  <i class="bi bi-pencil-square"></i>
                                              </button>
                                              <button class="btn btn-sm btn-outline-primary rounded-pill shadow-sm" title="Mesaj Gönder"><i class="bi bi-chat-dots"></i></button>
                                          </td>
                                      </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        Bu projeye henüz bir paydaş veya arsa sahibi eklenmemiş.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Edit Stakeholder Modal -->
<div class="modal fade" id="editStakeholderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-warning border-2 rounded-4 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square me-2"></i> Paydaş Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditStakeholder" asp-controller="ConstructionProject" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="stakeholderId" id="editStakeholderId" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Projedeki Rolü</label>
                        <select name="role" id="editStakeholderRole" class="form-select form-select-lg bg-light border-0" required>
                            <option value="Landowner">Arsa Sahibi / Hak Sahibi</option>
                            <option value="Representative">Temsilci / Avukat</option>
                            <option value="Consultant">Müşavir / Takipçi</option>
                            <option value="Other">Diğer (Mirasçı vb.)</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Hisse / Arsa Payı (%)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-pie-chart text-muted"></i></span>
                            <input type="number" step="0.01" name="sharePercentage" id="editStakeholderShare" class="form-control bg-light border-0" placeholder="Örn: 25.50">
                            <span class="input-group-text bg-light border-0 text-muted">%</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-bold rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning px-4 fw-bold rounded-pill shadow-sm"><i class="bi bi-check2-circle me-2"></i>Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editStakeholder(id, role, share) {
        document.getElementById('editStakeholderId').value = id;
        document.getElementById('editStakeholderRole').value = role;
        document.getElementById('editStakeholderShare').value = share;
        var myModal = new bootstrap.Modal(document.getElementById('editStakeholderModal'));
        myModal.show();
    }
</script>

  <!-- Add Stakeholder Modal -->
<div class="modal fade" id="addStakeholderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-warning border-2 rounded-4 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-vcard me-2"></i> Yeni Proje Paydaşı Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="ConstructionProject" asp-action="AddStakeholder" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Projedeki Rolü</label>
                            <select class="form-select" name="role" id="stakeholderRoleSelect" onchange="toggleShareField()">
                                <option value="1">Arsa Sahibi / Hak Sahibi (Mirasçı)</option>
                                <option value="2">Yasal Temsilci / Avukat</option>
                                <option value="3">Proje Takipçisi / Müşavir</option>
                            </select>
                        </div>
                        
                        <div class="col-12" id="sharePercentageContainer">
                            <label class="form-label fw-bold text-primary">Arsa Payı / Hisse Oranı (%)</label>
                            <input type="number" name="sharePercentage" class="form-control fw-bold text-primary bg-primary bg-opacity-10" placeholder="Örn: 15.5" step="0.01" min="0" max="100">
                        </div>

                        <div class="col-12 mt-3">
                            <h6 class="fw-bold border-bottom pb-2"><i class="bi bi-person-lines-fill text-primary me-1"></i> Temel İletişim Bilgileri</h6>
                            <small class="text-muted d-block mb-3">Kişiye sisteme giriş yapabilmesi için SMS davetiyesi gönderilecektir.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ad</label>
                            <input type="text" name="firstName" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Soyad</label>
                            <input type="text" name="lastName" class="form-control" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cep Telefonu</label>
                            <input type="tel" name="phone" class="form-control" placeholder="05XX XXX XX XX" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">E-Posta (İsteğe Bağlı)</label>
                            <input type="email" name="email" class="form-control" placeholder="ornek@mail.com">
                        </div>
                        
                        <div class="col-12 mt-2">
                            <div class="alert alert-warning py-2 mb-0" style="font-size: 0.85rem;">
                                <i class="bi bi-shield-lock-fill me-1"></i> <strong>TC Kimlik Doğrulaması:</strong> Paydaş, SMS linkine tıklayıp sisteme ilk girişini yaptığında kendi TC Kimlik ve Doğum Yılı bilgilerini girerek hesabını yasal olarak onaylayacaktır. Sizin girmenize gerek yoktur.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-5 w-100">Kimliği Doğrula ve Projeye Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleShareField() {
        var role = document.getElementById('stakeholderRoleSelect').value;
        var shareContainer = document.getElementById('sharePercentageContainer');
        if (role == '1') {
            shareContainer.style.display = 'block';
        } else {
            shareContainer.style.display = 'none';
        }
    }
    // Initialize on load
    document.addEventListener('DOMContentLoaded', function() { toggleShareField(); });
</script>

