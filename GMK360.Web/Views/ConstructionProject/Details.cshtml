<h4 class="fw-bold mb-3"><i class="bi bi-grid-1x2 text-orange me-2"></i>Projedeki Bloklar / Binalar</h4>

@if (Model.Blocks != null && Model.Blocks.Any())
{
    // ONLY get root blocks (ParentBuildingId == null)
    var rootExistingBlocks = Model.Blocks.Where(b => b.IsExistingBuilding && b.ParentBuildingId == null).ToList();
    var rootNewBlocks = Model.Blocks.Where(b => !b.IsExistingBuilding && b.ParentBuildingId == null).ToList();

    if (rootExistingBlocks.Any())
    {
        <h6 class="fw-bold text-danger border-bottom border-danger pb-2 mb-3 mt-4"><i class="bi bi-building-dash me-2"></i>Eski (Yıkılacak) Binalar (Paketler)</h6>
        <div class="row g-4 mb-4">
            @foreach (var block in rootExistingBlocks)
            {
                var children = Model.Blocks.Where(c => c.ParentBuildingId == block.Id).ToList();
                var cleanBlockName = !string.IsNullOrEmpty(block.BlockName) ? block.BlockName : block.Name;
                <div class="col-12">
                    <div class="card border border-danger border-opacity-25 shadow-sm rounded-4 h-100">
                        <div class="card-header bg-danger bg-opacity-10 border-0 p-3">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge bg-danger text-white fs-6 px-3 py-2 rounded-3 shadow-sm">
                                        <i class="bi bi-building me-1"></i>@cleanBlockName
                                    </span>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        @(block.LayoutPattern ?? (children.Any() ? "Ana Kütle" : "Tekil Yapı"))
                                    </span>
                                    @if(block.BaseArea.HasValue && block.BaseArea.Value > 0)
                                    {
                                        <span class="badge bg-white text-dark border px-2 py-1 shadow-sm">
                                            <i class="bi bi-bounding-box-circles me-1 text-danger"></i>Taban: <strong>@block.BaseArea.Value m²</strong>
                                        </span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-white text-danger border border-danger-subtle px-3 py-2 rounded-pill small shadow-sm">
                                        @(children.Any() ? $"{children.Count} Bağımsız Kule / Blok" : "Müstakil Blok")
                                    </span>
                                    <button type="button" class="btn btn-sm btn-white border shadow-sm rounded-circle p-1 btn-open-edit-block" 
                                            data-id="@block.Id" 
                                            data-name="@cleanBlockName" 
                                            data-basearea="@(block.BaseArea ?? 0)" 
                                            data-totalfloors="@(block.TotalFloors ?? 0)" 
                                            data-basementfloors="@block.BasementFloors" 
                                            data-hasground="@block.HasGroundFloor.ToString().ToLower()" 
                                            data-hasroof="@block.HasRoof.ToString().ToLower()" 
                                            data-rooftype="@block.RoofType" 
                                            data-elevators="@(block.ElevatorCount ?? 0)" 
                                            data-parking="@block.ParkingType" 
                                            data-insulation="@block.InsulationType" 
                                            data-features="@block.TechnicalFeatures" 
                                            data-desc="@block.Description" 
                                            data-kotoffset="@GetKotOffset(block)" 
                                            title="Blok Özelliklerini Düzenle" style="width: 32px; height: 32px;">
                                        <i class="bi bi-pencil text-danger"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-white border shadow-sm rounded-circle p-1 btn-open-delete-block" 
                                            data-id="@block.Id" 
                                            data-name="@cleanBlockName" 
                                            title="Bloğu Sil" style="width: 32px; height: 32px;">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <!-- Main Block Info -->
                            <div class="row mb-3 align-items-center g-3">
                                <div class="col-lg-8">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        @if(block.LayoutPattern == "Bitişik Nizam")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-building me-1"></i>Bitişik Nizam (Ortak Temel / İskelet)
                                            </span>
                                        }
                                        else if (block.LayoutPattern == "Ortak Baza")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-shop me-1"></i>Ortak Baza / Podyum Çarşı
                                            </span>
                                        }

                                        @if ((block.TotalFloors ?? 0) > 0)
                                        {
                                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                <i class="bi bi-layers me-1 text-danger"></i>@(block.TotalFloors ?? 0) Normal Kat
                                            </span>
                                        }

                                        @if (block.BasementFloors > 0)
                                        {
                                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                <i class="bi bi-box-arrow-in-down me-1 text-secondary"></i>@block.BasementFloors Bodrum Kat
                                            </span>
                                        }

                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                            <i class="bi bi-house-door me-1 text-info"></i>@(block.HasGroundFloor ? "Zemin Kat Var" : "Zemin Kat Yok")
                                        </span>

                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                            <i class="bi bi-umbrella me-1 text-warning"></i>@(block.HasRoof ? (!string.IsNullOrEmpty(block.RoofType) ? block.RoofType : "Çatılı") : "Çatısız / Teras")
                                        </span>

                                        @if(block.TotalApartments > 0 || block.TotalShops > 0)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-door-open me-1"></i>@block.TotalApartments Daire, @block.TotalShops Dükkan
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-4 text-lg-end">
                                    <a asp-action="ManageBlock" asp-route-id="@block.Id" class="btn btn-danger rounded-pill btn-sm fw-bold px-4 py-2 shadow-sm">
