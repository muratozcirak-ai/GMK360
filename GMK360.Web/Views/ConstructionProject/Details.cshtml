@if(ViewBag.PendingDeliveries != null)
{
    var pending = (IEnumerable<GMK360.Core.Entities.Construction.InventoryReceipt>)ViewBag.PendingDeliveries;
    if(pending.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-warning border-start border-5">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-truck text-warning me-2 fs-4"></i> Kamyon Yolda / Bekleyen Malzemeler</h5>
                    <span class="badge bg-warning text-dark fs-6 rounded-pill">@pending.Count() İrsaliye/Sipariş</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Tedarikçi</th>
                                <th>Evrak No</th>
                                <th>İnecek Depo</th>
                                <th>Sorumlu Personel</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var rec in pending)
                            {
                                <tr>
                                    <td>@rec.ReceiptDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="fw-bold">@rec.SupplierName</td>
                                    <td>@rec.DocumentNumber</td>
                                    <td><i class="bi bi-geo-alt text-muted"></i> @rec.Warehouse.Name</td>
                                    <td>
                                        @if(rec.AssignedUser != null)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                                <i class="bi bi-person me-1"></i> @rec.AssignedUser.DisplayName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Atanmadı</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <!-- Burada mobilde veya webde basılacak sayım ekranı butonu var -->
                                        <a href="/InventoryReceipts/Details/@rec.Id" class="btn btn-sm btn-success fw-bold px-3 rounded-pill shadow-sm">
                                            <i class="bi bi-box-seam me-1"></i> Sayım Yap & Teslim Al
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- ÖZET ALANLARI (COLLAPSIBLE) -->
<div class="accordion mb-4 shadow-sm" id="accordionSummaries">
    
    @if (Model.Blocks != null && Model.Blocks.Any(b => b.IsExistingBuilding))
    {
    <!-- ESKİ BİNA (MEVCUT DURUM) -->
    <div class="accordion-item border-0 rounded-4 overflow-hidden mb-3 shadow-sm">
        <h2 class="accordion-header" id="headingOldSummary">
            <button class="accordion-button bg-danger bg-opacity-10 text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOldSummary" aria-expanded="true" aria-controls="collapseOldSummary">
                <i class="bi bi-building-dash text-danger fs-5 me-2"></i> ESKİ BİNA (Mevcut Durum) Özeti
            </button>
        </h2>
        <div id="collapseOldSummary" class="accordion-collapse collapse show" aria-labelledby="headingOldSummary">
            <div class="accordion-body p-4">
                <div class="row g-4">
                    <div class="col-md-8">
                        @{
                            var eskiBloklar = Model.Blocks?.Where(b => b.IsExistingBuilding).ToList();
                            string yapimYiliText = "Belirtilmedi";
                            if (eskiBloklar != null && eskiBloklar.Any())
                            {
                                var yillar = eskiBloklar.Where(b => b.BuildingAge.HasValue).Select(b => b.BuildingAge.Value).Distinct().OrderBy(y => y).ToList();
                                if (yillar.Any())
                                {
                                    yapimYiliText = string.Join(", ", yillar);
                                }
                            }
                        }
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Eski Bina Bilgileri</h6>
                        <div class="row mb-4">
                            <div class="col-sm-6">
                                <div class="text-muted small">Yapım Yılı</div>
                                <div class="fw-bold text-dark">@yapimYiliText</div>
                            </div>
                        </div>

                        <div class="mt-2 position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-muted">Arazi ve Dış Alanlar (Mevcut)</h6>
                                <a asp-action="Amenities" asp-route-projectId="@Model.Id" asp-route-isExisting="true" class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-pencil me-1"></i> Yönet</a>
                            </div>
                            <div class="row g-3">
                                @{
                                    var eskiKokBloklar = eskiBloklar?.Where(b => b.ParentBuildingId == null).ToList();
                                    double totalLandEski = Model.TotalLandArea ?? 0;
                                    double existingBaseArea = eskiKokBloklar?.Sum(b => b.BaseArea ?? 0) ?? 0;
                                    var eskiDonatilar = Model.Amenities?.Where(a => a.IsExisting).ToList();
                                    double eskiDonatilarArea = eskiDonatilar?.Sum(a => a.SquareMeters ?? 0) ?? 0;
                                    double openSpaceEski = totalLandEski > 0 ? (totalLandEski - existingBaseArea - eskiDonatilarArea) : 0;
                                    double taksRateEski = totalLandEski > 0 ? (existingBaseArea / totalLandEski) * 100 : 0;
                                }
                                <div class="col-sm-4">
                                    <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                        <i class="bi bi-aspect-ratio text-secondary fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small fw-bold">Toplam Arazi Alanı</div>
                                            <div class="fw-bold text-dark">@(totalLandEski > 0 ? totalLandEski.ToString("N0") + " m²" : "Belirtilmedi")</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="d-flex align-items-center p-2 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                                        <i class="bi bi-building-dash text-danger fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small text-danger fw-bold">Eski Yapılar Tabanı (TAKS)</div>
                                            <div class="fw-bold text-dark">@(existingBaseArea > 0 ? existingBaseArea.ToString("N0") + " m²" : "0 m²") <small class="text-muted">(@taksRateEski.ToString("N1")%)</small></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="d-flex align-items-center p-2 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                                        <i class="bi bi-tree text-success fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small text-success fw-bold">Eski Dış & Bahçe Alanı</div>
                                            <div class="fw-bold text-dark">@((totalLandEski - existingBaseArea).ToString("N0")) m² <small class="text-muted">(@(openSpaceEski > 0 ? $"{openSpaceEski:N0} m² boş" : "Tamamı planlandı"))</small></div>
                                        </div>
                                    </div>
                                </div>

                                @if (eskiDonatilar != null && eskiDonatilar.Any())
                                {
                                    <div class="col-12 mt-1">
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <span class="small fw-bold text-muted me-1"><i class="bi bi-tree me-1 text-danger"></i>Mevcut Donatılar:</span>
                                            @foreach(var donati in eskiDonatilar)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill small">
                                                    <i class="bi bi-check2-circle me-1"></i>@donati.Name @(donati.SquareMeters.HasValue ? $"({donati.SquareMeters.Value} m²)" : "")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }

                                @{
                                    int eskiToplamYapi = eskiKokBloklar?.Count ?? 0;
                                    int eskiToplamBlok = eskiBloklar?.Count ?? 0;
                                    int eskiToplamDaire = eskiBloklar?.Sum(b => b.TotalApartments) ?? 0;
                                    int eskiToplamDukkan = eskiBloklar?.Sum(b => b.TotalShops) ?? 0;
                                    int eskiMaxKat = (eskiBloklar != null && eskiBloklar.Any()) ? eskiBloklar.Max(b => (b.TotalFloors ?? 0) + (b.BasementFloors)) : 0;
                                    string eskiNizam = (eskiKokBloklar != null && eskiKokBloklar.Any()) ? string.Join(", ", eskiKokBloklar.Where(b => !string.IsNullOrEmpty(b.LayoutPattern)).Select(b => b.LayoutPattern).Distinct()) : "Belirtilmedi";
                                    if (string.IsNullOrEmpty(eskiNizam)) eskiNizam = "Belirtilmedi";
                                }
                                <div class="col-sm-12 mt-2">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                                <i class="bi bi-grid-3x3-gap text-secondary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small fw-bold">Nizam & Blok</div>
                                                    <div class="fw-bold text-dark">@eskiNizam | @eskiToplamYapi Yapı (@eskiToplamBlok Blok)</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                                <i class="bi bi-door-open text-secondary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small fw-bold">Bağımsız Bölüm</div>
                                                    <div class="fw-bold text-dark">@eskiToplamDaire Daire, @eskiToplamDukkan Dükkan</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                                <i class="bi bi-layers text-secondary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small fw-bold">Kat Sayısı</div>
                                                    <div class="fw-bold text-dark">Bodrum Dahil Max @eskiMaxKat Kat</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ESKİ BİNA SÖKÜM VARLIKLARI & HURDA KOKPİTİ -->
                                <div class="col-12 mt-3">
                                    <div class="card border border-danger border-opacity-25 shadow-sm rounded-4 overflow-hidden bg-white">
                                        <div class="card-header bg-danger bg-opacity-10 py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div class="fw-bold text-dark fs-6">
                                                <i class="bi bi-recycle text-danger me-2"></i> Eski Bina Söküm Varlıkları & Değerli Hurda Envanteri
                                            </div>
                                            <div class="d-flex gap-2">
                                                @if (eskiKokBloklar != null && eskiKokBloklar.Any())
                                                {
                                                    <a href="/ConstructionProject/ManageBlock/@eskiKokBloklar.First().Id" class="btn btn-sm btn-outline-danger fw-bold rounded-pill px-3">
                                                        <i class="bi bi-magic me-1"></i> Tipik Kat Sihirbazı
                                                    </a>
                                                }
                                                <a href="/DemolitionSalvage/Index?projectId=@Model.Id" class="btn btn-sm btn-danger fw-bold rounded-pill shadow-sm px-3">
                                                    <i class="bi bi-hammer me-1"></i> Hurda & Yıkım Kokpitini Aç
                                                </a>
                                            </div>

                                        </div>
                                        <div class="card-body p-3">
                                            <div class="row g-2 text-center">
                                                <div class="col-md-3">
                                                    <div class="p-2 bg-light rounded-3 border">
                                                        <div class="small text-muted fw-bold">Tahmini Kalorifer Petekleri</div>
                                                        <div class="fs-5 fw-bold text-dark">@(eskiToplamDaire > 0 ? (eskiToplamDaire * 5) + " Adet" : "Analiz Ediliyor")</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="p-2 bg-light rounded-3 border">
                                                        <div class="small text-muted fw-bold">Kombi & Şofben</div>
                                                        <div class="fs-5 fw-bold text-dark">@(eskiToplamDaire > 0 ? eskiToplamDaire + " Adet" : "Analiz Ediliyor")</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="p-2 bg-light rounded-3 border">
                                                        <div class="small text-muted fw-bold">Çelik & Ahşap Kapılar</div>
                                                        <div class="fs-5 fw-bold text-dark">@(eskiToplamDaire > 0 ? (eskiToplamDaire * 5) + " Adet" : "Analiz Ediliyor")</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="p-2 bg-light rounded-3 border">
                                                        <div class="small text-muted fw-bold">Tahmini Hurda İnşaat Demiri</div>
                                                        <div class="fs-5 fw-bold text-danger">@(totalLandEski > 0 ? (Math.Round(totalLandEski * 0.015, 1)) + " Ton" : "Analiz Ediliyor")</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top flex-wrap gap-2">
                                                <span class="small text-muted">
                                                    <i class="bi bi-info-circle text-primary me-1"></i> Bu binadaki sökümleri hurdacılara ayrı satıp gelir elde edebilir, ya da hurda karşılığı yıkım ihalesi başlatabilirsiniz.
                                                </span>
                                                <div class="d-flex gap-2">
                                                    <form method="post" action="/DemolitionSalvage/CreateScrapSaleTender" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="projectId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3 shadow-xs">
                                                            <i class="bi bi-cash me-1"></i> Hurda Satış İhalesi (+Gelir)
                                                        </button>
                                                    </form>
                                                    <form method="post" action="/DemolitionSalvage/CreateDemolitionTender" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="projectId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark fw-bold rounded-pill px-3 shadow-xs">
                                                            <i class="bi bi-truck me-1"></i> Hurda Karşılığı Yıkım İhalesi
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (Model.Amenities != null && Model.Amenities.Any())
                                {
                                    foreach(var amenity in Model.Amenities)
                                    {
                                        <div class="col-sm-6">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-check-circle text-primary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small">@amenity.Name</div>
                                                    <div class="fw-bold text-dark">
                                                        @(amenity.SquareMeters.HasValue ? amenity.SquareMeters.Value + " m²" : "Mevcut")
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 mt-2">
                                        <div class="text-muted small fst-italic"><i class="bi bi-info-circle me-1"></i>Kamelya, açık otopark, çocuk parkı gibi dış alan donatıları henüz eklenmedi.</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 w-100 overflow-hidden" style="height: 250px;">
                            @if (!string.IsNullOrEmpty((string)ViewBag.CurrentStateImageUrl))
                            {
                                <img src="@ViewBag.CurrentStateImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover;" alt="Proje Görseli" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light h-100 text-muted">
                                    <div class="text-center">
                                        <i class="bi bi-image" style="font-size: 3rem;"></i>
                                        <p class="mt-2 mb-0">Görsel Yok</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    @if (Model.Blocks != null && Model.Blocks.Any(b => !b.IsExistingBuilding))
    {
    <!-- YENİ BİNA (HEDEF DURUM) -->
    <div class="accordion-item border-0 rounded-4 overflow-hidden shadow-sm">
        <h2 class="accordion-header" id="headingNewSummary">
            <button class="accordion-button collapsed bg-primary bg-opacity-10 text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNewSummary" aria-expanded="false" aria-controls="collapseNewSummary">
                <i class="bi bi-building-add text-primary fs-5 me-2"></i> YENİ (HEDEF) BİNA Özeti
            </button>
        </h2>
        <div id="collapseNewSummary" class="accordion-collapse collapse" aria-labelledby="headingNewSummary">
            <div class="accordion-body p-4">
                <div class="row g-4">
                    <div class="col-md-8">
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Proje Açıklaması</h6>
                        <p class="small text-muted">@Model.Description</p>

                        <div class="row mt-4">
                            <div class="col-sm-6">
                                <div class="text-muted small">Proje Başlama Tarihi</div>
                                <div class="fw-bold">@Model.StartDate.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="col-sm-6">
                                <div class="text-muted small">Tahmini Teslim Tarihi</div>
                                <div class="fw-bold">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd.MM.yyyy") : "Belirtilmedi")</div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top position-relative">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-muted">Arazi ve Dış Alanlar (Hedef)</h6>
                                <a asp-action="Amenities" asp-route-projectId="@Model.Id" asp-route-isExisting="false" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-pencil me-1"></i> Yönet</a>
                            </div>
                            <div class="row g-3">
                                @{
                                    var hedefBloklar = Model.Blocks?.Where(b => !b.IsExistingBuilding).ToList();
                                    var hedefKokBloklar = hedefBloklar?.Where(b => b.ParentBuildingId == null).ToList();
                                    double totalLandYeni = Model.TotalLandArea ?? 0;
                                    double targetBaseArea = hedefKokBloklar?.Sum(b => b.BaseArea ?? 0) ?? 0;
                                    var hedefDonatilar = Model.Amenities?.Where(a => !a.IsExisting).ToList();
                                    double targetAmenitiesArea = hedefDonatilar?.Sum(a => a.SquareMeters ?? 0) ?? 0;
                                    double openSpaceYeni = totalLandYeni > 0 ? (totalLandYeni - targetBaseArea - targetAmenitiesArea) : 0;
                                    double taksRateYeni = totalLandYeni > 0 ? (targetBaseArea / totalLandYeni) * 100 : 0;
                                }
                                <div class="col-sm-4">
                                    <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                        <i class="bi bi-aspect-ratio text-secondary fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small fw-bold">Toplam Arazi Alanı</div>
                                            <div class="fw-bold text-dark">@(totalLandYeni > 0 ? totalLandYeni.ToString("N0") + " m²" : "Belirtilmedi")</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="d-flex align-items-center p-2 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                                        <i class="bi bi-building-add text-primary fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small text-primary fw-bold">Yeni Yapılar Tabanı (TAKS)</div>
                                            <div class="fw-bold text-dark">@(targetBaseArea > 0 ? targetBaseArea.ToString("N0") + " m²" : "0 m²") <small class="text-muted">(@taksRateYeni.ToString("N1")%)</small></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="d-flex align-items-center p-2 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                                        <i class="bi bi-tree text-success fs-4 me-3"></i>
                                        <div>
                                            <div class="text-muted small text-success fw-bold">Toplam Dış & Bahçe Alanı</div>
                                            <div class="fw-bold text-dark">@((totalLandYeni - targetBaseArea).ToString("N0")) m² <small class="text-muted">(@(openSpaceYeni > 0 ? $"{openSpaceYeni:N0} m² boş" : "Tamamı planlandı"))</small></div>
                                        </div>
                                    </div>
                                </div>

                                @if (hedefDonatilar != null && hedefDonatilar.Any())
                                {
                                    <div class="col-12 mt-1">
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <span class="small fw-bold text-muted me-1"><i class="bi bi-tree me-1 text-success"></i>Planlanan Donatılar:</span>
                                            @foreach(var donati in hedefDonatilar)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
                                                    <i class="bi bi-check2-circle me-1"></i>@donati.Name @(donati.SquareMeters.HasValue ? $"({donati.SquareMeters.Value} m²)" : "")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-12 mt-1">
                                        <div class="text-muted small fst-italic"><i class="bi bi-info-circle me-1"></i>Otopark, çocuk parkı, kamelya veya çevre çiti gibi dış alan donatıları henüz eklenmedi. "Yönet" butonundan ekleyebilirsiniz.</div>
                                    </div>
                                }

                                @{
                                    int hedefToplamYapi = hedefKokBloklar?.Count ?? 0;
                                    int hedefToplamBlok = hedefBloklar?.Count ?? 0;
                                    int hedefToplamDaire = hedefBloklar?.Sum(b => b.TotalApartments) ?? 0;
                                    int hedefToplamDukkan = hedefBloklar?.Sum(b => b.TotalShops) ?? 0;
                                    int hedefMaxKat = (hedefBloklar != null && hedefBloklar.Any()) ? hedefBloklar.Max(b => (b.TotalFloors ?? 0) + (b.BasementFloors)) : 0;
                                    string hedefNizam = (hedefKokBloklar != null && hedefKokBloklar.Any()) ? string.Join(", ", hedefKokBloklar.Where(b => !string.IsNullOrEmpty(b.LayoutPattern)).Select(b => b.LayoutPattern).Distinct()) : "Belirtilmedi";
                                    if (string.IsNullOrEmpty(hedefNizam)) hedefNizam = "Belirtilmedi";
                                }
                                <div class="col-sm-12 mt-2">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                                <i class="bi bi-grid-3x3-gap text-secondary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small fw-bold">Nizam & Blok</div>
                                                    <div class="fw-bold text-dark">@hedefNizam | @hedefToplamYapi Yapı (@hedefToplamBlok Blok)</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                                <i class="bi bi-door-open text-secondary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small fw-bold">Bağımsız Bölüm</div>
                                                    <div class="fw-bold text-dark">@hedefToplamDaire Daire, @hedefToplamDukkan Dükkan (Toplam @(hedefToplamDaire + hedefToplamDukkan))</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center p-2 rounded-3 bg-light border">
                                                <i class="bi bi-layers text-secondary fs-4 me-3"></i>
                                                <div>
                                                    <div class="text-muted small fw-bold">Kat Sayısı</div>
                                                    <div class="fw-bold text-dark">Bodrum Dahil Max @hedefMaxKat Kat</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 w-100 overflow-hidden" style="height: 250px;">
                            @if (!string.IsNullOrEmpty(Model.CoverImageUrl ?? ViewBag.CoverImageUrl))
                            {
                                <img src="@(Model.CoverImageUrl ?? ViewBag.CoverImageUrl)" class="img-fluid h-100 w-100" style="object-fit: cover; filter: hue-rotate(180deg);" alt="Hedef Proje Görseli" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light h-100 text-muted">
                                    <div class="text-center">
                                        <i class="bi bi-image" style="font-size: 3rem;"></i>
                                        <p class="mt-2 mb-0">Görsel Yok</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
</div>

