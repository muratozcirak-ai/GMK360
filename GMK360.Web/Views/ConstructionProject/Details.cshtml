            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-success text-white p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-file-earmark-ruled-fill fs-5"></i>
                </div>
                <div>
                    <span class="badge bg-success text-white mb-1 fw-bold"><i class="bi bi-rulers me-1"></i>DETAYLI MÜHENDİSLİK & METRAJ PROJESİ</span>
                    <div class="fw-bold text-dark fs-6">Bu alt proje AutoCAD / DXF çizimi ve parametrik metraj altyapısına sahiptir.</div>
                    <small class="text-muted">Statik karkas, mimari mahal listesi ve tesisat keşifleri bağımsız olarak hesaplanmaktadır.</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/Metraj/DnaWizard/@Model.Id" target="_blank" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-magic me-1"></i> DNA Sihirbazı
                </a>
                <a href="/Metraj/Index?projectId=@Model.Id" target="_blank" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-rulers me-1"></i> Metraj Detayı
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2" data-bs-toggle="modal" data-bs-target="#uploadDxfModal" title="Çizimi Güncelle">
                    <i class="bi bi-upload"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between shadow-xs">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-warning text-dark p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-file-earmark-text-fill fs-5"></i>
                </div>
                <div>
                    <span class="badge bg-warning text-dark mb-1 fw-bold"><i class="bi bi-receipt me-1"></i>TEKLİF & DÖKÜMANTASYON (RFQ) PAKETİ</span>
                    <div class="fw-bold text-dark fs-6">Bu paket dökümantasyon, teknik şartname ve taşeron teklif toplama (RFQ) odaklıdır. CAD/DXF çizimi tanımlanmamıştır.</div>
                    <small class="text-muted">Elinizde AutoCAD/DXF çizimi varsa, sisteme yükleyerek anında detaylı metraj ve mühendislik moduna yükseltebilirsiniz.</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#uploadDxfModal">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i> 📐 DXF Çizimi Yükle
                </button>
                <a href="/B2BPartnerPortal/Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-megaphone me-1"></i> RFQ Teklif Topla
                </a>
            </div>
        </div>
    }
}

@* ANA PROJE İÇİN: BAĞLI ALT PROJELER & İMALAT PAKETLERİ KARTI *@
@if (!Model.ParentProjectId.HasValue)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-diagram-3 text-primary me-2"></i>Bağlı Alt Projeler & İmalat Paketleri (@(Model.SubProjects?.Count ?? 0))
                </h6>
                <small class="text-muted">Ana projeye bağlı bağımsız yönetilen çevre, donatı, peyzaj ve özel imalat projeleri</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (Model.SubProjects != null && Model.SubProjects.Any())
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-1 fw-bold">
                        @Model.SubProjects.Count Alt Proje
                    </span>
                }
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#createSubProjectModal">
                    <i class="bi bi-plus-circle me-1"></i> Yeni Alt Proje / İmalat Paketi Ekle
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.SubProjects != null && Model.SubProjects.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted text-uppercase">
                                <th>Alt Proje Adı</th>
                                <th>Kategori</th>
                                <th>İmalat / Metraj Modeli</th>
                                <th>Durum</th>
                                <th>Başlangıç Tarihi</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in Model.SubProjects)
                            {
                                bool subHasDxf = sub.HasDxfDrawing || sub.ProjectExecutionMode == "DxfEngineering";
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark"><i class="bi bi-folder2-open text-warning me-2"></i>@sub.Name</div>
                                        <small class="text-muted">@sub.Description</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-2 py-1">
                                            @(sub.SubProjectCategory ?? sub.ProjectType ?? "Alt İmalat")
                                        </span>
                                    </td>
                                    <td>
                                        @if (subHasDxf)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-2 py-1 fw-bold">
                                                <i class="bi bi-file-earmark-ruled me-1"></i>📐 Mühendislik (DXF)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-2 py-1 fw-bold">
                                                <i class="bi bi-receipt me-1"></i>📄 Teklif & Döküman (RFQ)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-2 py-1">
                                            @sub.Status.ToString().Replace("_", " ")
                                        </span>
                                    </td>
                                    <td>@sub.StartDate.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <a href="/ConstructionProject/Details/@sub.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi bi-box-arrow-in-up-right me-1"></i> Projeyi Aç
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center">
                    <div class="text-muted mb-2"><i class="bi bi-diagram-3 fs-1 text-secondary opacity-50"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Henüz Tanımlanmış Alt Proje veya İmalat Paketi Yok</h6>
                    <p class="text-muted small mb-3">Çocuk parkı, peyzaj, güvenlik kulübesi, istinat duvarı gibi donatıları bağımsız bütçelendirip yönetmek için alt proje açabilirsiniz.</p>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#createSubProjectModal">
                        <i class="bi bi-plus-circle me-1"></i> İlk Alt Projeyi / İmalat Paketini Oluştur
                    </button>
                </div>
            }
        </div>
    </div>
}

<div class="accordion mb-4 shadow-sm" id="accordionStakeholders">
    <div class="accordion-item border-0 rounded-4 overflow-hidden">
        <h2 class="accordion-header d-flex" id="headingStakeholders">
            <button class="accordion-button collapsed bg-warning bg-opacity-10 text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStakeholders" aria-expanded="false" aria-controls="collapseStakeholders">
                <i class="bi bi-people-fill fs-5 text-warning me-2"></i> KİMLİK / PAYDAŞLAR: Hak Sahipleri, Arsa Sahipleri ve Ortaklar
            </button>
            <div class="bg-warning bg-opacity-10 d-flex align-items-center pe-3">
                <button class="btn btn-sm btn-warning fw-bold rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addStakeholderModal">
                    <i class="bi bi-person-plus-fill me-1"></i> Yeni Paydaş / Temsilci Ekle
                </button>
            </div>
        </h2>
        <div id="collapseStakeholders" class="accordion-collapse collapse" aria-labelledby="headingStakeholders" data-bs-parent="#accordionStakeholders">
            <div class="accordion-body bg-white p-4">
                <div class="alert alert-info border-info bg-info bg-opacity-10 mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i> <strong>Önemli:</strong> Projeye eklenen Arsa Sahipleri ve Temsilciler, giriş yaptıklarında projenin ilerleme raporlarını görebilirler. Kişinin TC Kimlik numarası MERNİS üzerinden doğrulanarak tekil CRM kaydı olarak tutulur.
                </div>
                
                <!-- Stakeholders List (Placeholder for now) -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>TC Kimlik No</th>
                                <th>Projedeki Rolü</th>
                                <th>Hisse / Arsa Payı</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var stakeholdersList = ViewBag.Stakeholders as List<GMK360.Core.Entities.Construction.ProjectStakeholder>; }
                              @if (stakeholdersList != null && stakeholdersList.Any())
                            {
                                foreach (var st in stakeholdersList)
                                {
                                    <tr>
                                          <td class="fw-bold align-middle">
                                              <i class="bi bi-person-circle text-secondary me-2"></i> @st.User.FirstName @st.User.LastName
                                          </td>
                                          <td class="align-middle">
                                              <span class="d-block mb-1">@(string.IsNullOrEmpty(st.User.TcIdentityNo) ? "Kayıtlı Değil" : st.User.TcIdentityNo)</span>
                                              @if (st.User.EmailConfirmed || st.User.PhoneNumberConfirmed)
                                              {
                                                  <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-check-circle-fill me-1"></i> Onaylı / Girdi</span>
                                              }
                                              else
                                              {
                                                  <span class="badge bg-warning bg-opacity-10 text-warning border border-warning" title="Sisteme henüz giriş yapmadı"><i class="bi bi-hourglass-split me-1"></i> SMS Bekliyor</span>
                                              }
                                          </td>
                                          <td class="align-middle">
                                              @if (st.Role == GMK360.Core.Entities.Construction.StakeholderRole.Landowner)
                                              {
                                                  <span class="badge bg-primary px-3 py-2">Arsa Sahibi</span>
                                              }
                                              else if (st.Role == GMK360.Core.Entities.Construction.StakeholderRole.Representative)
                                              {
                                                  <span class="badge bg-secondary px-3 py-2">Temsilci / Avukat</span>
                                              }
                                              else
                                              {
                                                  <span class="badge bg-info text-dark px-3 py-2">@st.Role.ToString()</span>
                                              }
                                          </td>
                                          <td class="fw-bold text-primary align-middle fs-5">
                                              @(st.SharePercentage.HasValue ? $"% {st.SharePercentage.Value.ToString("N2")}" : "-")
                                          </td>
                                          <td class="align-middle text-end pe-4">
                                              <button type="button" class="btn btn-sm btn-outline-warning rounded-pill shadow-sm me-1" onclick="editStakeholder('@st.Id', '@st.Role', '@(st.SharePercentage.HasValue ? st.SharePercentage.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")')" title="Düzenle">
                                                  <i class="bi bi-pencil-square"></i>
                                              </button>
                                              <form asp-action="DeleteStakeholder" asp-controller="ConstructionProject" method="post" class="d-inline" onsubmit="return confirm('Bu paydaşı projeden kaldırmak istediğinize emin misiniz?');">
                                                  <input type="hidden" name="stakeholderId" value="@st.Id" />
                                                  <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill shadow-sm me-1" title="Projeden Kaldır">
                                                      <i class="bi bi-trash"></i>
                                                  </button>
                                              </form>
                                              <button class="btn btn-sm btn-outline-primary rounded-pill shadow-sm" title="Mesaj Gönder"><i class="bi bi-chat-dots"></i></button>
                                          </td>
                                      </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        Bu projeye henüz bir paydaş veya arsa sahibi eklenmemiş.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Edit Stakeholder Modal -->
<div class="modal fade" id="editStakeholderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-warning border-2 rounded-4 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square me-2"></i> Paydaş Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditStakeholder" asp-controller="ConstructionProject" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="stakeholderId" id="editStakeholderId" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Projedeki Rolü</label>
                        <select name="role" id="editStakeholderRole" class="form-select form-select-lg bg-light border-0" required>
                            <option value="Landowner">Arsa Sahibi / Hak Sahibi</option>
                            <option value="Representative">Temsilci / Avukat</option>
                            <option value="Consultant">Müşavir / Takipçi</option>
                            <option value="Other">Diğer (Mirasçı vb.)</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Hisse / Arsa Payı (%)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-pie-chart text-muted"></i></span>
                            <input type="number" step="0.01" name="sharePercentage" id="editStakeholderShare" class="form-control bg-light border-0" placeholder="Örn: 25.50">
                            <span class="input-group-text bg-light border-0 text-muted">%</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-bold rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning px-4 fw-bold rounded-pill shadow-sm"><i class="bi bi-check2-circle me-2"></i>Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editStakeholder(id, role, share) {
        document.getElementById('editStakeholderId').value = id;
        document.getElementById('editStakeholderRole').value = role;
        document.getElementById('editStakeholderShare').value = share;
        var myModal = new bootstrap.Modal(document.getElementById('editStakeholderModal'));
        myModal.show();
    }
</script>

  <!-- Add Stakeholder Modal -->
<div class="modal fade" id="addStakeholderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-warning border-2 rounded-4 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-vcard me-2"></i> Yeni Proje Paydaşı Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="ConstructionProject" asp-action="AddStakeholder" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Projedeki Rolü</label>
                            <select class="form-select" name="role" id="stakeholderRoleSelect" onchange="toggleShareField()">
                                <option value="1">Arsa Sahibi / Hak Sahibi (Mirasçı)</option>
                                <option value="2">Yasal Temsilci / Avukat</option>
                                <option value="3">Proje Takipçisi / Müşavir</option>
                            </select>
                        </div>
                        
                        <div class="col-12" id="sharePercentageContainer">
                            <label class="form-label fw-bold text-primary">Arsa Payı / Hisse Oranı (%)</label>
                            <input type="number" name="sharePercentage" class="form-control fw-bold text-primary bg-primary bg-opacity-10" placeholder="Örn: 15.5" step="0.01" min="0" max="100">
                        </div>

                        <div class="col-12 mt-3">
