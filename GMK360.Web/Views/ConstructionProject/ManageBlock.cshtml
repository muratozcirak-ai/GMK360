                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-2 @bgClass">
                        <div class="d-flex align-items-center flex-fill btn-edit-unit" style="cursor:pointer;" data-unit-id="@unit.Id" data-door-number="@unit.DoorNumber" data-owner-name="@unit.OwnerName" data-unit-structure="@unit.RoomLayout" data-gross-sqm="@unit.GrossSquareMeters" data-facade="@unit.FacadeDirection" title="Düzenle">
                            <i class="bi @icon @textClass fs-5 me-2"></i>
                            <div>
                                <div class="fw-bold mb-0 text-dark" style="font-size: 0.85rem;">No: @unit.DoorNumber <span class="badge bg-light border text-secondary ms-1 fw-normal">@(unit.Category ?? "Mesken")</span></div>
                                <div class="small fw-bold @textClass" style="font-size: 0.7rem;">@(isOwned ? unit.OwnerName : "Müsait")</div>
                            </div>
                        </div>
                        <div class="d-flex gap-1 ms-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-edit-unit" data-unit-id="@unit.Id" data-door-number="@unit.DoorNumber" data-owner-name="@unit.OwnerName" data-unit-structure="@unit.RoomLayout" data-gross-sqm="@unit.GrossSquareMeters" data-facade="@unit.FacadeDirection" title="Düzenle">
                                <i class="bi bi-pencil" style="font-size:0.8rem;"></i>
                            </button>
                            <a href="/ConstructionProject/ManageUnitSpaces/@unit.Id" class="btn btn-sm btn-primary py-0 px-2 text-white" title="İçine Gir (Odalar)">
                                <i class="bi bi-box-arrow-in-right" style="font-size:0.8rem;"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    } else {
        <div class="text-muted small w-100 text-center py-2 bg-light rounded"><i class="bi bi-info-circle me-1"></i>Birim yok</div>
    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                                        </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-tree" style="font-size: 3rem;"></i>
                        <p class="mt-3">Bu blokta henüz hiçbir daire veya dükkan oluşturulmamış.</p>
                        <p class="small">Daireleri ekleyebileceğiniz detaylıı yönetim arayüzü yakında aktif edilecektir.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

