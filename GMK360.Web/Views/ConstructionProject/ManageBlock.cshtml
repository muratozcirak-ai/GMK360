                                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 btn-upload-plan shadow-sm" data-floor="@floorLevel" data-floorname="@floorName" data-buildingid="@Model.Id" data-bs-toggle="modal" data-bs-target="#uploadFloorPlanModal" style="font-size:0.75rem;" title="@Model.BlockName Kat Planı Yükle">

                                                            <i class="bi bi-upload me-1"></i>Plan

                                                        </button>

                                                    }

                                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-1 btn-copy-floor shadow-sm" data-floorlevel="@floorLevel" data-floorname="@floorName" data-buildingid="@Model.Id" data-blockname="@Model.BlockName" data-bs-toggle="modal" data-bs-target="#copyFloorModal" style="font-size:0.75rem;" title="@Model.BlockName - @floorName Katını Diğer Katlara Çoğalt">

                                                        <i class="bi bi-copy me-1"></i>Çoğalt

                                                    </button>

                                                </div>

                                            </div>

                                            <div class="d-flex flex-wrap gap-2">

                                                @{

                                                    var blockUnits = allUnits.Where(u => u.BuildingId == Model.Id && u.FloorLevel == floorLevel && !(floorLevel > 0 && (u.DoorNumber ?? "").Contains("Yangın"))).OrderBy(u => u.DoorNumber).ToList();

    if (blockUnits.Any()) {

        int tCount = blockUnits.Count;

        int dCount = blockUnits.Count(x => x.Category == "Dükkan" || x.Category == "Ticari");

        int oCount = blockUnits.Count(x => x.Category == "OrtakAlan");

        int depCount = blockUnits.Count(x => x.Category == "Depo" || x.Category == "Eklenti");

        int rCount = tCount - dCount - oCount - depCount;

        int sCount = blockUnits.Count(x => !string.IsNullOrEmpty(x.OwnerName));

        int mCount = tCount - sCount - oCount;

        string unitCollapseId = "collapse_" + Model.Id + "_" + (floorLevel < 0 ? "neg" + Math.Abs(floorLevel) : floorLevel.ToString());



        <div class="w-100 mb-2">

            <button class="btn btn-sm btn-light w-100 text-start border shadow-sm d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#@unitCollapseId" aria-expanded="false" aria-controls="@unitCollapseId">

                <span class="text-dark fw-bold" style="font-size:0.8rem;"><i class="bi bi-list-ul me-1"></i> @tCount Birim <span class="fw-normal text-muted">(@rCount Daire@(dCount > 0 ? $", {dCount} Dükkan" : "")@(oCount > 0 ? $", {oCount} Ortak Alan" : "")@(depCount > 0 ? $", {depCount} Depo" : ""))</span></span>

                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill" style="font-size:0.7rem;">@mCount Müsait</span>

            </button>

        </div>

        <div class="collapse w-100" id="@unitCollapseId">

            <div class="list-group list-group-flush border rounded mb-2">

                @foreach(var unit in blockUnits) {

                    bool isCommon = unit.Category == "OrtakAlan";

                    bool isOwned = !string.IsNullOrEmpty(unit.OwnerName);

                    string bgClass = isCommon ? "bg-warning bg-opacity-10" : (isOwned ? "bg-danger bg-opacity-10" : "bg-success bg-opacity-10");

                    string textClass = isCommon ? "text-dark" : (isOwned ? "text-danger" : "text-success");

                    string icon = unit.Category == "Dükkan" || unit.Category == "Ticari" ? "bi-shop" : (isCommon ? "bi-shield-check text-warning" : (unit.Category == "Depo" || unit.Category == "Eklenti" ? "bi-box-seam text-secondary" : "bi-door-open-fill"));



                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-2 @bgClass">

                        <div class="form-check me-2 mb-0">

                            <input class="form-check-input unit-checkbox shadow-none" type="checkbox" value="@unit.Id" data-floor="@floorLevel" data-unitid="@unit.Id" data-doornumber="@unit.DoorNumber" />

                        </div>

                        <div class="d-flex align-items-center flex-fill btn-edit-unit" style="cursor:pointer;" data-unit-id="@unit.Id" data-door-number="@unit.DoorNumber" data-owner-name="@unit.OwnerName" data-owner-userid="@unit.OwnerUserId" data-unit-structure="@unit.RoomLayout" data-gross-sqm="@unit.GrossSquareMeters" data-facade="@unit.FacadeDirection" data-listprice="@unit.ListPrice" data-listingtype="@unit.ListingType" data-salesstatus="@unit.SalesStatus" data-assignedagent="@unit.AssignedAgent" data-salesstage="@unit.SalesStage" data-category="@(unit.Category ?? "Daire")" data-parentunitid="@(unit.ParentUnitId ?? 0)" title="Düzenle">

                            <i class="bi @icon @textClass fs-4 me-2"></i>

                            <div>

                                <div class="fw-bold mb-1 text-dark d-flex align-items-center flex-wrap gap-1" style="font-size: 0.85rem;">

                                    <span class="badge bg-dark text-white rounded-pill px-2">No: @unit.DoorNumber</span>

                                    @if (!string.IsNullOrEmpty(unit.RoomLayout) && unit.RoomLayout != "-")

                                    {

                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">@unit.RoomLayout</span>

                                    }

                                    @if (!string.IsNullOrEmpty(unit.FacadeDirection) && unit.FacadeDirection != "-")

                                    {

                                        <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold"><i class="bi bi-compass me-1"></i>@unit.FacadeDirection</span>

                                    }

                                    @if (unit.GrossSquareMeters.HasValue && unit.GrossSquareMeters.Value > 0)

                                    {

                                        <span class="badge bg-light text-dark border fw-semibold">

                                            <i class="bi bi-aspect-ratio me-1 text-muted"></i>@unit.GrossSquareMeters.Value.ToString("N0") m² Brüt @(unit.NetSquareMeters.HasValue && unit.NetSquareMeters.Value > 0 ? $"({unit.NetSquareMeters.Value.ToString("N0")} m² Net)" : "")

                                        </span>

                                    }

                                    @if (unit.Category == "Depo" || unit.Category == "Eklenti")

                                    {

                                        if (unit.ParentUnit != null)

                                        {

                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1 fw-normal" title="Bağlı Ana Daire"><i class="bi bi-link-45deg me-1"></i>Bağlı No @unit.ParentUnit.DoorNumber</span>

                                        }

                                        else

                                        {

                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1 fw-normal"><i class="bi bi-box-seam me-1"></i>Eklenti</span>

                                        }

                                    }

                                    else if (unit.Category == "OrtakAlan")

                                    {

                                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning ms-1 fw-normal"><i class="bi bi-shield-check me-1"></i>Ortak Alan</span>

                                    }

                                    else if (unit.Category == "Dükkan" || unit.Category == "Ticari")

                                    {

                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1 fw-normal"><i class="bi bi-shop me-1"></i>Ticari / Dükkan</span>

                                    }

                                </div>

                                <div class="small fw-semibold d-flex align-items-center gap-2 flex-wrap" style="font-size: 0.75rem;">

                                    @if (isCommon)

                                    {

                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning"><i class="bi bi-shield-check me-1 text-warning"></i>Bina Tesis / Ortak Alan</span>

                                    }

                                    else if (isOwned)

                                    {

                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><i class="bi bi-person-fill-check me-1"></i>Hak Sahibi: @unit.OwnerName</span>

                                    }

                                    else

                                    {

                                        <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-tag-fill me-1"></i>Müteahhit Payı (Satılık)</span>

                                        @if (unit.ListPrice.HasValue && unit.ListPrice.Value > 0)

                                        {

                                            <span class="text-muted fw-bold">@unit.ListPrice.Value.ToString("N0") ₺</span>

                                        }

                                    }

                                </div>

                            </div>

                        </div>

                        <div class="d-flex gap-1 ms-2">

                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-edit-unit" data-unit-id="@unit.Id" data-door-number="@unit.DoorNumber" data-owner-name="@unit.OwnerName" data-owner-userid="@unit.OwnerUserId" data-unit-structure="@unit.RoomLayout" data-gross-sqm="@unit.GrossSquareMeters" data-facade="@unit.FacadeDirection" data-listprice="@unit.ListPrice" data-listingtype="@unit.ListingType" data-salesstatus="@unit.SalesStatus" data-assignedagent="@unit.AssignedAgent" data-salesstage="@unit.SalesStage" data-category="@(unit.Category ?? "Daire")" data-parentunitid="@(unit.ParentUnitId ?? 0)" title="Düzenle">

                                <i class="bi bi-pencil" style="font-size:0.8rem;"></i>

                            </button>

                            <a href="/ConstructionProject/ManageUnitSpaces/@unit.Id" class="btn btn-sm btn-primary py-0 px-2 text-white" title="İçine Gir (Odalar)">

                                <i class="bi bi-box-arrow-in-right" style="font-size:0.8rem;"></i>

                            </a>

                                    <form asp-action="DeleteBuildingUnit" method="post" onsubmit="return confirm('Bu birimi silmek istediğinize emin misiniz?');" class="d-inline m-0 p-0">

                                        <input type="hidden" name="unitId" value="@unit.Id" />

                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Birimi Sil">

                                            <i class="bi bi-trash" style="font-size:0.8rem;"></i>

                                        </button>

                                    </form>

                        </div>

                    </div>

                }

            </div>

        </div>

    } else {

        <div class="text-muted small w-100 text-center py-2 bg-light rounded"><i class="bi bi-info-circle me-1"></i>Birim yok</div>

    }

                                                }

                                            </div>

                                        </div>

                                    }

                                </div>

                            </div>

                        }

                                        </div>

                }

                else

                {

                    <div class="text-center py-5 text-muted">

                        <i class="bi bi-tree" style="font-size: 3rem;"></i>

                        <p class="mt-3">Bu blokta henüz hiçbir daire veya dükkan oluşturulmamış.</p>

                        <p class="small">Daireleri ekleyebileceğiniz detaylıı yönetim arayüzü yakında aktif edilecektir.</p>

                    </div>

                }

            </div>

        </div>

    </div>

</div>



<!-- Edit Block Details Modal -->

<div class="modal fade" id="editBlockDetailsModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content rounded-4 border-0 shadow">

            <form asp-action="UpdateBlockDetails" method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <input type="hidden" name="returnUrl" value="@Url.Action("ManageBlock", new { id = Model.Id })" />

                <input type="hidden" name="TotalFloors" value="@(Model.TotalFloors ?? 0)" />

                <input type="hidden" name="BasementFloors" value="@Model.BasementFloors" />

                <input type="hidden" name="HasGroundFloor" value="@(Model.HasGroundFloor ? "true" : "false")" />

                <input type="hidden" name="HasRoof" value="@(Model.HasRoof ? "true" : "false")" />

