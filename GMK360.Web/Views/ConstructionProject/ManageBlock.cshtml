function adjustGridMultiplier(delta) {

    var input = $('#wFloorMultiplier');

    var val = (parseInt(input.val()) || 1) + delta;

    if (val < 1) val = 1;

    input.val(val);



    // Otomatik olarak tüm kat kalemlerinin çarpanını güncelle (tek seferlik olmayanları)

    $('#salvageGridBody tr').each(function () {

        var isOneTime = $(this).data('one-time') === true;

        if (!isOneTime) {

            $(this).find('.row-mult').val(val);

        }

    });



    recalcGridTable();

}



function loadDefaultGridTemplate() {

    $('#salvageGridBody').empty();

    var currentMultiplier = parseInt($('#wFloorMultiplier').val()) || 4;



    $.each(defaultGridRows, function (idx, item) {

        var mult = item.isOneTime ? 1 : currentMultiplier;

        appendGridRowHtml(item.name, item.type, item.qty, item.unit, mult, item.price, item.cat, item.isOneTime);

    });



    recalcGridTable();

}



function addEmptyGridRow() {

    var currentMultiplier = parseInt($('#wFloorMultiplier').val()) || 4;

    appendGridRowHtml('', '', 1, 'Adet', currentMultiplier, 500, 'Genel', false);

    recalcGridTable();

}



function addPresetRow(name, type, qty, unit, price, cat, isOneTime) {

    var currentMultiplier = parseInt($('#wFloorMultiplier').val()) || 4;

    var mult = isOneTime ? 1 : currentMultiplier;

    appendGridRowHtml(name, type, qty, unit, mult, price, cat, isOneTime);

    recalcGridTable();

}



function appendGridRowHtml(name, type, qty, unit, mult, price, cat, isOneTime) {

    var rowIndex = $('#salvageGridBody tr').length + 1;

    var tr = $('<tr></tr>').data('one-time', isOneTime).data('category', cat);



    var html = `

        <td class="text-center fw-bold text-muted row-index">${rowIndex}</td>

        <td>

            <div class="input-group input-group-sm">

                <input type="text" class="form-control form-control-sm fw-bold text-dark row-name" value="${escapeHtml(name)}" placeholder="Kalem Adı (Örn: Petek, Kapı)" oninput="recalcGridTable()" list="commonItemList" />

            </div>

        </td>

        <td>

            <input type="text" class="form-control form-control-sm text-secondary row-type" value="${escapeHtml(type || '')}" placeholder="Tipi / Malzeme" oninput="recalcGridTable()" list="commonTypeList" />

        </td>

        <td>

            <input type="number" class="form-control form-control-sm text-center fw-bold row-qty" value="${qty}" min="0" step="any" oninput="recalcGridTable()" />

        </td>

        <td>

            <select class="form-select form-select-sm row-unit" onchange="recalcGridTable()">

                <option value="Adet" ${unit === 'Adet' ? 'selected' : ''}>Adet</option>

                <option value="Metre" ${unit === 'Metre' ? 'selected' : ''}>Metre</option>

                <option value="Takım" ${unit === 'Takım' ? 'selected' : ''}>Takım</option>

                <option value="Set" ${unit === 'Set' ? 'selected' : ''}>Set</option>

                <option value="Kg" ${unit === 'Kg' ? 'selected' : ''}>Kg</option>

                <option value="m2" ${unit === 'm2' ? 'selected' : ''}>m²</option>

            </select>

        </td>

        <td class="text-center">

            <div class="input-group input-group-sm">

                <input type="number" class="form-control form-control-sm text-center fw-bold ${isOneTime ? 'bg-light' : 'text-danger'} row-mult" value="${mult}" min="1" oninput="recalcGridTable()" title="${isOneTime ? 'Tek seferlik bina varlığı' : 'Kat Çarpanı'}" />

                <span class="input-group-text small" style="font-size:0.7rem;">${isOneTime ? 'Bina' : 'Kat'}</span>

            </div>

        </td>

        <td class="text-center bg-light">

            <span class="fw-bold text-dark row-total-qty">0</span>

        </td>

        <td>

            <div class="input-group input-group-sm">

                <span class="input-group-text" style="font-size:0.75rem;">₺</span>

                <input type="number" class="form-control form-control-sm text-end fw-bold row-price" value="${price}" min="0" step="any" oninput="recalcGridTable()" />

            </div>

        </td>

        <td class="text-end bg-light fw-bold text-success pe-2">

            <span class="row-total-val">₺0</span>

        </td>

        <td class="text-center">

            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 border-0" onclick="$(this).closest('tr').remove(); reindexGridRows(); recalcGridTable();" title="Satırı Sil">

                <i class="bi bi-trash fs-6"></i>

            </button>

        </td>

    `;



    tr.html(html);

    $('#salvageGridBody').append(tr);

}



function reindexGridRows() {

    $('#salvageGridBody tr').each(function (idx) {

        $(this).find('.row-index').text(idx + 1);

    });

}



function recalcGridTable() {

    var sumFloorItems = 0;

    var rowCount = 0;



    $('#salvageGridBody tr').each(function () {

        rowCount++;

        var qty = parseFloat($(this).find('.row-qty').val()) || 0;

        var mult = parseInt($(this).find('.row-mult').val()) || 1;

        var price = parseFloat($(this).find('.row-price').val()) || 0;

        var unit = $(this).find('.row-unit').val() || 'Adet';



        var totalQty = Math.round(qty * mult * 100) / 100;

        var totalVal = Math.round(totalQty * price);



        $(this).find('.row-total-qty').text(totalQty.toLocaleString('tr-TR') + ' ' + unit);

        $(this).find('.row-total-val').text('₺' + totalVal.toLocaleString('tr-TR'));



        sumFloorItems += totalVal;

    });



    // Hurda İnşaat Demiri Hesabı

    var calcRebar = $('#wCalculateRebar').is(':checked');

    var totalM2 = parseFloat($('#wTotalBuildingM2').val()) || 0;

    var rebarTon = calcRebar ? Math.round(((totalM2 * 25) / 1000) * 10) / 10 : 0;

    var rebarVal = Math.round(rebarTon * 14500);



    if (calcRebar && rebarTon > 0) {

        $('#wCalculatedRebarBadge').html('<i class="bi bi-hammer text-danger me-1"></i>' + rebarTon.toLocaleString('tr-TR') + ' Ton (~₺' + rebarVal.toLocaleString('tr-TR') + ')');

        $('#gridRebarTotalBadge').text('₺' + rebarVal.toLocaleString('tr-TR') + ' (' + rebarTon.toLocaleString('tr-TR') + ' Ton)');

    } else {

        $('#wCalculatedRebarBadge').html('<span class="text-muted">Hesaplama Kapalı</span>');

        $('#gridRebarTotalBadge').text('₺0 (0 Ton)');

    }



    var grandTotal = sumFloorItems + rebarVal;



    $('#gridTotalRowsBadge').text(rowCount + ' Kalem');

    $('#gridFloorItemsTotalBadge').text('₺' + Math.round(sumFloorItems).toLocaleString('tr-TR'));

    $('#gridGrandTotalBadge').text('₺' + Math.round(grandTotal).toLocaleString('tr-TR'));

}



function submitSalvageGrid() {

    var rowsData = [];

    $('#salvageGridBody tr').each(function () {

        var name = $(this).find('.row-name').val()?.trim();

        var type = $(this).find('.row-type').val()?.trim();

        var qty = parseFloat($(this).find('.row-qty').val()) || 0;

        var unit = $(this).find('.row-unit').val() || 'Adet';

        var mult = parseInt($(this).find('.row-mult').val()) || 1;

        var price = parseFloat($(this).find('.row-price').val()) || 0;

        var cat = $(this).data('category') || 'Söküm & Hurda';



        if (name && qty > 0) {

            rowsData.push({

                category: cat,

                itemName: name,

                itemType: type,

                quantityPerFloor: qty,

                unit: unit,

                multiplier: mult,

                unitPrice: price,

                notes: null

            });

        }

    });



    if (rowsData.length === 0) {

        alert('Lütfen en az bir adet söküm kalemi girin.');

        return;

    }



    var btn = $('#btnSaveSalvageWizard');

    var oldText = btn.html();

    btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Envanter Kaydediliyor...').prop('disabled', true);



    var payload = {

        projectId: @Model.ConstructionProjectId,

        buildingId: @Model.Id,

        floorMultiplier: parseInt($('#wFloorMultiplier').val()) || 1,

        calculateRebarScrap: $('#wCalculateRebar').is(':checked'),

        totalBuildingM2: parseFloat($('#wTotalBuildingM2').val()) || 0,

        rebarKgPerM2: 25,

        rows: rowsData

    };



    $.ajax({

        url: '/DemolitionSalvage/SaveWizardEstimate',

        type: 'POST',

        contentType: 'application/json',

        data: JSON.stringify(payload),

        success: function (res) {

            btn.html(oldText).prop('disabled', false);

            if (res.success) {

                alert('Tebrikler! ' + res.message + '\n\nToplam ' + res.totalItems + ' kalem envantere işlendi.\nGenel Hurda Değeri: ₺' + Math.round(res.grandTotal).toLocaleString('tr-TR'));

                if (res.redirectUrl) {

                    window.location.href = res.redirectUrl;

                } else {

                    window.location.reload();

                }

            } else {

                alert(res.message || 'Hata oluştu');

            }

        },

        error: function (xhr, status, error) {

            btn.html(oldText).prop('disabled', false);

            alert('Sunucu hatası: ' + error);

        }

    });

}



function escapeHtml(text) {

    if (!text) return '';

    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");

}



// Modal açıldığında

$('#demolitionSalvageWizardModal').on('show.bs.modal', function () {

    $.getJSON('/DemolitionSalvage/GetWizardDefaults', { projectId: @Model.ConstructionProjectId, buildingId: @Model.Id }, function (data) {

        if (data && data.success) {

            if (data.normalFloors) $('#wFloorMultiplier').val(data.normalFloors);

            if (data.totalM2) $('#wTotalBuildingM2').val(data.totalM2);

            if (data.buildingName) $('#wBuildingNameDisplay').text(data.buildingName);

        }

        if ($('#salvageGridBody tr').length === 0) {

            loadDefaultGridTemplate();

        } else {

            recalcGridTable();

        }

    }).fail(function () {

        if ($('#salvageGridBody tr').length === 0) {

            loadDefaultGridTemplate();

        } else {

            recalcGridTable();

        }

    });

});



$(document).ready(function () {

    if ($('#salvageGridBody tr').length === 0) {

        loadDefaultGridTemplate();

    }

});

