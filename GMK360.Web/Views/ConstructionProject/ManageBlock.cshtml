                            </div>

                            @if (totalUnitsCount > 0)

                            {

                                int nonCommon = totalUnitsCount - ortakCount;

                                int hakPercent = nonCommon > 0 ? (int)Math.Round((double)ownedUnitsCount / nonCommon * 100) : 0;

                                int mutPercent = 100 - hakPercent;

                                <div class="progress" style="height: 6px;">

                                    <div class="progress-bar bg-danger" role="progressbar" style="width: @hakPercent%" title="Hak Sahibi % @hakPercent"></div>

