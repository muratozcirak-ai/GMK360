                            var headingId = $"heading{floorLevel}".Replace("-", "minus");

                            var collapseId = $"collapse{floorLevel}".Replace("-", "minus");

                            var planDoc = floorPlans.FirstOrDefault(d => d.EntityType == "BuildingFloor_" + Model.Id && d.EntityId == floorLevel);



                            <div class="d-flex w-100 mb-2 align-items-start">

