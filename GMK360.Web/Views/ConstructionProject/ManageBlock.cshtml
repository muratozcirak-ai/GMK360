                                <small class="text-white-50 d-block">🏗️ Hurda İnşaat Demiri</small>

                                <span class="fw-bold text-danger" id="gridRebarTotalBadge">₺0 (0 Ton)</span>

                            </div>

                        </div>

                        <div class="text-end">

                            <small class="text-white-50 d-block">Σ GENEL HURDA & İKİNCİ EL GELİR POTANSİYELİ</small>

                            <span class="fw-bold text-success fs-3" id="gridGrandTotalBadge">₺0</span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer border-0 bg-white py-3 px-4 d-flex justify-content-between">

                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>

                <button type="button" class="btn btn-danger rounded-pill px-5 fw-bold shadow-lg" id="btnSaveSalvageWizard" onclick="submitSalvageGrid()">

                    <i class="bi bi-check2-circle me-1"></i> Hurda Envanterine Aktar & Kaydet

                </button>

            </div>

        </div>

    </div>

</div>



<!-- BULK GENERATOR MODAL -->



<div class="modal fade" id="bulkGenerateModal" tabindex="-1" data-bs-backdrop="static">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 rounded-4 shadow-lg">

            <div class="modal-header bg-warning bg-opacity-10 border-bottom-0 py-3 rounded-top-4">

                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Çoklu Bağımsız Bölüm & Ortak Alan Üretici</h5>

                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Kapat"></button>

            </div>

            <div class="modal-body p-4">

                <p class="text-muted small mb-3">Bu sihirbaz, seçtiğiniz kule ve katlara anında bağımsız bölümler (daire, dükkan) veya ortak alanlar (sığınak, su deposu, otopark) üretir.</p>



                <!-- Target Single Floor Summary Banner (when opened from a floor/tower cell) -->

                <div id="bulkGenTargetSummary" class="alert alert-primary py-2 px-3 mb-3 d-flex align-items-center justify-content-between rounded-3" style="display:none;">

                    <div>

                        <i class="bi bi-geo-alt-fill me-1 text-primary"></i> <span id="bulkGenTargetText" class="fw-bold"></span>

                    </div>

                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2" id="btnShowAllBulkFloors">Tüm Kat Seçimini Göster</button>

                </div>

                

                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <label class="form-label fw-bold text-dark small">Mahal / Bölüm Türü</label>

                        <select class="form-select shadow-sm fw-semibold" id="bulkGenCategory">

                            <optgroup label="Bağımsız Bölümler (Satış / Yaşam)">

                                <option value="Daire" data-default-count="4" selected>Daire (Mesken)</option>

                                <option value="Dükkan" data-default-count="2">Dükkan / Ticari Alan</option>

                                <option value="Ofis" data-default-count="2">Ofis / Büro</option>

                                <option value="Depo" data-default-count="2">Depo / Ardiye (Daire Eklentisi)</option>

                            </optgroup>

                            <optgroup label="Bina Tesis ve Ortak Alanları (Demirbaş & Yönetim)">

                                <option value="Sığınak" data-default-count="1">Sığınak</option>

                                <option value="Su Deposu & Hidrofor" data-default-count="1">Su Deposu & Hidrofor Odası</option>

                                <option value="Kapalı Otopark" data-default-count="1">Kapalı Otopark Alanı</option>

                                <option value="Açık Otopark" data-default-count="1">Açık Otopark Alanı</option>

                                <option value="Jeneratör Odası" data-default-count="1">Jeneratör Odası</option>

                                <option value="Kazan Dairesi" data-default-count="1">Kazan Dairesi / Isı Merkezi</option>

                                <option value="Yangın Pompa İstasyonu" data-default-count="1">Yangın Pompa İstasyonu</option>

                                <option value="Bina Giriş Holü" data-default-count="1">Bina Giriş Holü / Lobi</option>

                                <option value="Asansör Makine Dairesi" data-default-count="1">Asansör Makine Dairesi</option>

                                <option value="Elektrik & Pano Odası" data-default-count="1">Elektrik & Pano Odası</option>

                                <option value="Ortak Alan (Genel)" data-default-count="1">Genel Ortak Alan</option>

                            </optgroup>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label fw-bold text-dark small">Seçili Her Kata Kaç Adet Üretilecek?</label>

                        <input type="number" class="form-control shadow-sm fw-bold text-primary" id="bulkGenCount" value="4" min="1" max="100">

                    </div>

                </div>



                <!-- Quick Selection Filter Buttons -->

                <div class="d-flex flex-wrap gap-2 mb-3 align-items-center bg-light p-2 rounded-3 border">

                    <span class="small fw-bold text-muted me-1"><i class="bi bi-funnel me-1"></i>Hızlı Kat Seçimi:</span>

                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3 btn-bulk-filter" data-filter="all">

                        <i class="bi bi-check-all me-1"></i>Tümünü Seç

                    </button>

                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill py-1 px-3 btn-bulk-filter" data-filter="normal">

                        <i class="bi bi-building me-1"></i>Normal Katlar

                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-3 btn-bulk-filter" data-filter="ground-basement">

                        <i class="bi bi-box-arrow-in-down me-1"></i>Zemin & Bodrum Katlar

                    </button>

                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-1 px-3 btn-bulk-filter" data-filter="clear">

                        <i class="bi bi-x-circle me-1"></i>Temizle

                    </button>

                </div>



                <label class="form-label fw-bold text-dark small border-bottom w-100 pb-2 mb-3">Hedef Katları Seçin</label>

                <div class="row g-3" id="bulkGenFloorsContainer" style="max-height: 380px; overflow-y: auto;">

                    @if (isParentBlock)

                    {

                        if (isOrtakBaza && podiumKots > 0)

                        {

                            <div class="col-md-6 mb-3">

                                <div class="card border bg-light shadow-sm h-100">

                                    <div class="card-body p-3">

                                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">

                                            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-building me-1"></i>@Model.BlockName (Ortak Baza)</h6>

                                            <div class="form-check m-0">

                                                <input class="form-check-input select-all-block-floors" type="checkbox" data-target-block="@Model.Id" id="selAll_@Model.Id">

                                                <label class="form-check-label small fw-bold" for="selAll_@Model.Id">Tümü</label>

                                            </div>

                                        </div>

                                        <div class="d-flex flex-column gap-1" style="max-height: 250px; overflow-y: auto;">

                                            @for (int slab = podiumKots; slab >= 1; slab--)

                                            {

                                                var fName = GetFloorNameBySlabIndex(Model, slab);

                                                bool isBasement = slab <= Model.BasementFloors;

                                                bool isGround = Model.HasGroundFloor && (slab == Model.BasementFloors + 1);

                                                string fType = isBasement ? "basement" : (isGround ? "ground" : "normal");

                                                string chkId = $"chk_bulk_{Model.Id}_{slab}";

                                                <div class="form-check">

                                                    <input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="@(Model.Id)|@(slab)" data-block="@Model.Id" data-type="@fType" id="@chkId">

                                                    <label class="form-check-label small" for="@chkId">

                                                        @fName

                                                        @if (isBasement) { <span class="badge bg-secondary-subtle text-secondary small ms-1">Bodrum</span> }

                                                        else if (isGround) { <span class="badge bg-info-subtle text-info small ms-1">Zemin</span> }

                                                    </label>

                                                </div>

                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                        }



                        if (Model.ChildBuildings != null)

                        {

                            int childCount = Model.ChildBuildings.Count;

                            string colClass = childCount >= 3 ? "col-md-4 mb-3" : "col-md-6 mb-3";

                            foreach (var child in Model.ChildBuildings.OrderBy(c => c.BlockName))

                            {

                                int childTotalSlabs = GetTotalSlabs(child);

                                <div class="@colClass">

                                    <div class="card border bg-light shadow-sm h-100">

                                        <div class="card-body p-3">

                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">

                                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-building me-1"></i>@child.BlockName</h6>

                                                <div class="form-check m-0">

                                                    <input class="form-check-input select-all-block-floors" type="checkbox" data-target-block="@child.Id" id="selAll_@child.Id">

                                                    <label class="form-check-label small fw-bold" for="selAll_@child.Id">Tümü</label>

                                                </div>

                                            </div>

                                            <div class="d-flex flex-column gap-1" style="max-height: 250px; overflow-y: auto;">

                                                @for (int slab = childTotalSlabs; slab >= 1; slab--)

                                                {

                                                    var fName = GetFloorNameBySlabIndex(child, slab);

                                                    bool isBasement = slab <= child.BasementFloors;

                                                    bool isGround = child.HasGroundFloor && (slab == child.BasementFloors + 1);

                                                    string fType = isBasement ? "basement" : (isGround ? "ground" : "normal");

                                                    string chkId = $"chk_bulk_{child.Id}_{slab}";

                                                    <div class="form-check">

                                                        <input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="@(child.Id)|@(slab)" data-block="@child.Id" data-type="@fType" id="@chkId">

                                                        <label class="form-check-label small" for="@chkId">

                                                            @fName

                                                            @if (isBasement) { <span class="badge bg-secondary-subtle text-secondary small ms-1">Bodrum</span> }

                                                            else if (isGround) { <span class="badge bg-info-subtle text-info small ms-1">Zemin</span> }

                                                        </label>

                                                    </div>

                                                }

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            }

                        }

                    }

                    else

                    {

                        <!-- Single Building Floors -->

                        <div class="col-12">

                            <div class="card border bg-light shadow-sm">

                                <div class="card-body p-3">

                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">

                                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-building me-1"></i>@Model.BlockName Katları</h6>

                                        <div class="form-check m-0">

                                            <input class="form-check-input select-all-block-floors" type="checkbox" data-target-block="@Model.Id" id="selAll_@Model.Id">

                                            <label class="form-check-label small fw-bold" for="selAll_@Model.Id">Tümü</label>

                                        </div>

                                    </div>

                                    <div class="row g-2">

                                        @if (Model.HasRoof)

                                        {

                                            int roofKot = (Model.TotalFloors ?? 0) + 1;

                                            string chkId = $"chk_bulk_{Model.Id}_{roofKot}";

                                            <div class="col-sm-6 col-md-4">

                                                <div class="form-check">

                                                    <input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="@(Model.Id)|@(roofKot)" data-block="@Model.Id" data-type="roof" id="@chkId">

                                                    <label class="form-check-label small" for="@chkId">Çatı Katı</label>

                                                </div>

                                            </div>

                                        }

                                        @for (int f = (Model.TotalFloors ?? 0); f >= 1; f--)

                                        {

                                            string chkId = $"chk_bulk_{Model.Id}_{f}";

                                            <div class="col-sm-6 col-md-4">

                                                <div class="form-check">

                                                    <input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="@(Model.Id)|@(f)" data-block="@Model.Id" data-type="normal" id="@chkId">

                                                    <label class="form-check-label small" for="@chkId">@f. Kat</label>

                                                </div>

                                            </div>

                                        }

                                        @if (Model.HasGroundFloor)

                                        {

                                            string chkId = $"chk_bulk_{Model.Id}_0";

                                            <div class="col-sm-6 col-md-4">

                                                <div class="form-check">

                                                    <input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="@(Model.Id)|0" data-block="@Model.Id" data-type="ground" id="@chkId">

                                                    <label class="form-check-label small" for="@chkId">Zemin Kat <span class="badge bg-info-subtle text-info small ms-1">Zemin</span></label>

                                                </div>

                                            </div>

                                        }

                                        @for (int b = 1; b <= Model.BasementFloors; b++)

                                        {

                                            string chkId = $"chk_bulk_{Model.Id}_minus{b}";

                                            <div class="col-sm-6 col-md-4">

                                                <div class="form-check">

                                                    <input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="@(Model.Id)|@(-b)" data-block="@Model.Id" data-type="basement" id="@chkId">

                                                    <label class="form-check-label small" for="@chkId">@b. Bodrum <span class="badge bg-secondary-subtle text-secondary small ms-1">Bodrum</span></label>

                                                </div>

                                            </div>

                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            </div>

            <div class="modal-footer border-top-0 bg-light rounded-bottom-4 py-3">

                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat ve Maketi Yenile</button>

                <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm" id="btnSubmitBulkGen">

                    <i class="bi bi-magic me-1"></i> Üret ve Devam Et

                </button>

            </div>

        </div>

    </div>

</div>



<!-- Upload Floor Plan Modal -->

