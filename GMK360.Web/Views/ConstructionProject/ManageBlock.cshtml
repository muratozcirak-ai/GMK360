                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Yapı Özelliklerini Düzenle</h5>
