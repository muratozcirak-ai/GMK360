@model GMK360.Core.Entities.Building

@functions {
    public string GetFloorNameBySlabIndex(GMK360.Core.Entities.Building b, int slabIndex) {
        int current = 1;
        int basements = b.BasementFloors;
        if (slabIndex <= basements) {
            int bodrumNo = (basements - slabIndex) + 1;
            return $"-{bodrumNo}. Bodrum";
        }
        current += basements;

        if (b.HasGroundFloor) {
            if (slabIndex == current) return "Zemin Kat";
            current++;
        }

        int totalF = b.TotalFloors ?? 0;
        if (slabIndex < current + totalF) {
            int katNo = slabIndex - current + 1;
            return $"{katNo}. Kat";
        }
        current += totalF;

        if (b.HasRoof && slabIndex == current) {
            return "Çatı Katı";
        }

        return "Bilinmeyen Kat";
    }

    public int GetTotalSlabs(GMK360.Core.Entities.Building b) {
        return b.BasementFloors + (b.HasGroundFloor ? 1 : 0) + (b.TotalFloors ?? 0) + (b.HasRoof ? 1 : 0);
    }
}
@{
    ViewData["Title"] = "Yapı Yönetimi";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    var allUnits = Model.Units?.ToList() ?? new List<GMK360.Core.Entities.BuildingUnit>();
    if (Model.ChildBuildings != null) {
        foreach(var cb in Model.ChildBuildings) {
            if (cb.Units != null) {
                allUnits.AddRange(cb.Units);
            }
        }
    }
    // Determine all possible floor levels (Expected + Actual)
    var floorLevels = new HashSet<int>();
    // 1. Add expected floors from Building properties
    bool isParentBlock = Model.ChildBuildings != null && Model.ChildBuildings.Any();
    bool isOrtakBaza = Model.LayoutPattern == "Ortak Baza" || Model.LayoutPattern == "Kule";
    int podiumKots = isOrtakBaza ? GetTotalSlabs(Model) : 0;

    if (isParentBlock) {
        int maxKots = 0;
        foreach(var child in Model.ChildBuildings) {
            int childKots = GetTotalSlabs(child);
            if (childKots > maxKots) maxKots = childKots;
        }
        int totalMasterKots = podiumKots + maxKots;
        for (int i = totalMasterKots; i >= 1; i--) {
            floorLevels.Add(i);
        }
    } else {
        int totalF = Model.TotalFloors ?? 0;
        int baseF = Model.BasementFloors;
        if (Model.HasRoof) floorLevels.Add(totalF + 1);
        for (int i = totalF; i >= 1; i--) floorLevels.Add(i);
        if (Model.HasGroundFloor) floorLevels.Add(0);
        for (int i = 1; i <= baseF; i++) floorLevels.Add(-i);
    }
    // 2. Add any floors that actually have units (in case they added one outside expected bounds)
    foreach(var u in allUnits) {
        floorLevels.Add(u.FloorLevel);
    }
    var sortedFloors = floorLevels.OrderByDescending(f => f).ToList();
    var blockImages = ViewBag.BlockImages as List<GMK360.Core.Entities.DmsDocument> ?? new List<GMK360.Core.Entities.DmsDocument>();
    var floorPlans = ViewBag.FloorPlans as List<GMK360.Core.Entities.DmsDocument> ?? new List<GMK360.Core.Entities.DmsDocument>();
}
