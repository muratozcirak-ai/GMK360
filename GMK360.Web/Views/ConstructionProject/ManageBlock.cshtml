@section Scripts {

    <script>

        $(document).ready(function() {

            // Floor button or Kot Axis button: open Bulk Generator with this floor pre-selected

            $(document).on('click', '.btn-add-unit-to-floor', function() {

                var floorLevel = $(this).data('floorlevel');

                var floorName = $(this).data('floorname') || '';

                var buildingId = $(this).data('buildingid');

                var blockName = $(this).data('blockname') || '';



                var modalEl = document.getElementById('bulkGenerateModal');

                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);



                // Clear previous selections

                $('.chk-bulk-gen').prop('checked', false);

                $('.select-all-block-floors').prop('checked', false);



                // Check the target floor checkbox

                var targetCb = $('.chk-bulk-gen[value="' + buildingId + '|' + floorLevel + '"]');

                if (targetCb.length) {

                    targetCb.prop('checked', true);

                    setTimeout(function() {

                        if (targetCb[0]) {

                            targetCb[0].scrollIntoView({ behavior: 'smooth', block: 'center' });

                        }

                    }, 250);

                }



                $('#bulkGenTargetSummary').show();

                $('#bulkGenTargetText').html('Seçili Hedef: <strong>' + (blockName ? blockName + ' - ' : '') + floorName + '</strong>');



                modal.show();

            });



            $('#btnOpenBulkGenerator').click(function() {

                $('#bulkGenTargetSummary').hide();

            });



            $('#btnShowAllBulkFloors').click(function(e) {

                e.preventDefault();

                $('#bulkGenTargetSummary').slideUp(200);

            });



            // Auto-update quantity based on category selection

            $('#bulkGenCategory').on('change', function() {

                var defaultCount = $(this).find(':selected').data('default-count') || 1;

                $('#bulkGenCount').val(defaultCount);

            });



            // Populate Copy Floor Modal

            $(document).on('click', '.btn-copy-floor', function() {

                var floorLevel = $(this).data('floorlevel');

                var floorName = $(this).data('floorname') || '';

                var buildingId = $(this).data('buildingid') || '@Model.Id';

                var blockName = $(this).data('blockname') || '';



                $('#copyFloorModal #sourceFloorLevel').val(floorLevel);

                $('#copyFloorModal #copyFloorBuildingId').val(buildingId);

                $('#copyFloorModal #sourceFloorNameDisplay').text((blockName ? blockName + ' - ' : '') + floorName);

                $('#copyFloorModal #copyTargetFloorLevelsHidden').val('');



                // Reset target floor checkboxes

                $('.chk-copy-floor').prop('checked', false);

                $('.select-all-copy-block-floors').prop('checked', false);



                // Show only the selected building's card in the target floors grid

                $('.copy-block-col').hide();

                $('.copy-block-col[data-block="' + buildingId + '"]').show();



                // Hide the source floor row so you don't copy a floor to itself

                $('.copy-floor-row').show();

                $('.copy-floor-row[data-block="' + buildingId + '"][data-floorlevel="' + floorLevel + '"]').hide();



                updateCopySummary();



                // Fetch units of source floor

                $('#copyUnitsCheckboxes').html('<div class="text-center text-muted small py-3">Birimler yükleniyor... <div class="spinner-border spinner-border-sm ms-2" role="status"></div></div>');

                

                $.get('/ConstructionProject/GetFloorUnits', { buildingId: buildingId, floorLevel: floorLevel }, function(data) {

                    var html = '';

                    if(data && data.length > 0) {

                        data.forEach(function(u) {

                            var icon = 'bi-door-open';

                            var isCommon = false;

                            if(u.category === 'OrtakAlan' || u.category === 'OrtakAlan_Blok' || u.category === 'OrtakAlan_Kat') {

                                icon = 'bi-building text-success';

                                isCommon = true;

                            } else if (u.category === 'Eklenti') {

                                icon = 'bi-box text-secondary';

                            } else if (u.category === 'Dükkan') {

                                icon = 'bi-shop text-primary';

                            }

                            

                            html += '<div class="form-check mb-1">';

                            html += '  <input class="form-check-input copy-unit-cb" type="checkbox" name="selectedUnitIds" value="' + u.id + '" id="cb_' + u.id + '" data-iscommon="' + isCommon + '" checked>';

                            html += '  <label class="form-check-label small" for="cb_' + u.id + '">';

                            html += '    <i class="bi ' + icon + ' me-1"></i> ' + u.doorNumber + ' <span class="text-muted" style="font-size:0.8em">(' + (u.roomLayout || u.category) + ')</span>';

                            html += '  </label>';

                            html += '</div>';

                        });

                    } else {

                        html = '<div class="text-muted small py-2">Bu katta hiç birim yok.</div>';

                    }

                    $('#copyUnitsCheckboxes').html(html);

                });

            });

            

            $('#selectAllCopyUnits').click(function(e) {

                e.preventDefault();

                $('.copy-unit-cb').prop('checked', true);

            });

            $('#selectCommonOnly').click(function(e) {

                e.preventDefault();

                $('.copy-unit-cb').prop('checked', false);

                $('.copy-unit-cb[data-iscommon="true"]').prop('checked', true);

            });



            // Fast Filter for Copy Floor Modal

            $(document).on('click', '.btn-copy-filter', function(e) {

                e.preventDefault();

                var filter = $(this).data('filter');

                var activeBlockId = $('#copyFloorBuildingId').val();

                var visibleCheckboxes = $('.chk-copy-floor:visible[data-block="' + activeBlockId + '"]');



                if (filter === 'all') {

                    visibleCheckboxes.prop('checked', true);

                } else if (filter === 'normal') {

                    visibleCheckboxes.prop('checked', false);

                    $('.chk-copy-floor:visible[data-block="' + activeBlockId + '"][data-type="normal"]').prop('checked', true);

                } else if (filter === 'ground-basement') {

                    visibleCheckboxes.prop('checked', false);

                    $('.chk-copy-floor:visible[data-block="' + activeBlockId + '"][data-type="ground"], .chk-copy-floor:visible[data-block="' + activeBlockId + '"][data-type="basement"]').prop('checked', true);

                } else if (filter === 'clear') {

                    visibleCheckboxes.prop('checked', false);

                }

                updateCopySummary();

            });



            $(document).on('change', '.select-all-copy-block-floors', function() {

                var bId = $(this).data('target-block');

                var isChecked = $(this).is(':checked');

                $('.chk-copy-floor:visible[data-block="' + bId + '"]').prop('checked', isChecked);

                updateCopySummary();

            });



            $(document).on('change', '.chk-copy-floor', function() {

                updateCopySummary();

            });



            function updateCopySummary() {

                var activeBlockId = $('#copyFloorBuildingId').val();

                var count = $('.chk-copy-floor:checked[data-block="' + activeBlockId + '"]').length;

                $('#copySelectedFloorsSummary').text('Seçili Hedef: ' + count + ' kat');

            }



            // On Copy Floor Form Submit

            $(document).on('submit', '#formCopyFloor', function(e) {

