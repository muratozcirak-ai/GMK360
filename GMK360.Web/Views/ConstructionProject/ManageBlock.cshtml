                                int daireCount = allUnits.Count(u => u.Category == "Daire" || string.IsNullOrEmpty(u.Category) || u.Category == "Mesken");

                                int dukkanCount = allUnits.Count(u => u.Category == "Dükkan" || u.Category == "Ticari");

                                int ortakCount = allUnits.Count(u => u.Category == "OrtakAlan");

                                int depoCount = allUnits.Count(u => u.Category == "Depo" || u.Category == "Eklenti");

                            }

