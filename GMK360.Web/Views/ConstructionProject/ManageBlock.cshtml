                            if (isParentBlock) {

                                defaultName = $"{floorLevel}. Kot Düzlemi";

                            } else {

                                defaultName = floorLevel == 0 ? "Zemin Kat" : (floorLevel < 0 ? $"{-floorLevel}. Bodrum" : (floorLevel == (Model.TotalFloors ?? 0) + 1 && Model.HasRoof ? "Çatı Katı" : $"{floorLevel}. Kat"));

                            }

