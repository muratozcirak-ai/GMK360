                                                        <i class="bi bi-image me-1"></i>@(isParentBlock ? "Kot Planı" : "Plan")

                                                    </a>

                                                }

                                                else

                                                {

                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 btn-upload-plan shadow-sm" data-floor="@floorLevel" data-floorname="@floorName" data-buildingid="@Model.Id" data-bs-toggle="modal" data-bs-target="#uploadFloorPlanModal" style="font-size:0.75rem;" title="Kot Planı Yükle">

                                                        <i class="bi bi-upload me-1"></i>@(isParentBlock ? "Kot Planı" : "Plan")

                                                    </button>

                                                }

                                            </div>

                                        </div>

                                    </div>

                                }

                                <!-- RIGHT: The Visual Matrix (Blocks) -->

                                <div class="matrix-cells-container d-flex flex-grow-1 @(Model.IsExistingBuilding ? "ps-0" : "ps-4")" style="gap: 24px;">



                                    @if (isParentBlock) {

                                        if (isOrtakBaza && floorLevel <= podiumKots) {

                                            <!-- Podium spans the whole width -->

