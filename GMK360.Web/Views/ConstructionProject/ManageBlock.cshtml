<!-- Modal 3: Kat Yangın Güvenlik İstasyonu & Donanım Pasaportu Modal -->
<div class="modal fade" id="floorFireStationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="SaveFloorFireStation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <input type="hidden" name="floorLevel" id="fireStationFloorLevel" value="" />
                
                <div class="modal-header bg-danger text-white border-0 py-3 rounded-top-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-fire me-2"></i>🧯 Kat Yangın Güvenlik İstasyonu & Donanım Pasaportu
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 mb-4">
                        <div class="fw-bold text-danger mb-1" id="fireStationFloorTitle">Kat Yangın Donanımı</div>
                        <p class="small text-muted mb-0">
                            Binaların Yangından Korunması Hakkında Yönetmelik ve Kat Mülkiyeti Kanunu (KMK) gereği her kat sahanlığında bulunması zorunlu yangın güvenlik donanımları ve periyodik servis/muayene takvimi.
                        </p>
                    </div>

                    <!-- 1. Yangın Söndürme Cihazı (Tüp) -->
                    <div class="card border shadow-none bg-light rounded-3 p-3 mb-3">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-fill-check text-danger me-2"></i>1. Yangın Söndürme Cihazı (Tüp)</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Cihaz Türü & Model</label>
                                <input type="text" name="extinguisherModel" class="form-control form-control-sm" value="6 kg ABC Kuru Kimyevi Toz" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Üretici / Marka</label>
                                <input type="text" name="extinguisherBrand" class="form-control form-control-sm" value="Yangınsan TSE" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Son Dolum / Kontrol Tarihi</label>
                                <input type="date" name="lastRefillDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Gelecek Periyodik Muayene Tarihi</label>
                                <input type="date" name="nextInspectionDate" class="form-control form-control-sm" value="@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <!-- 2. Yetkili Servis & Şantiye Güvencesi -->
                    <div class="card border shadow-none bg-light rounded-3 p-3 mb-3">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-tools text-primary me-2"></i>2. Yetkili Yangın Servisi (Satış Sonrası Destek)</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Yetkili Firma Adı</label>
                                <input type="text" name="serviceName" class="form-control form-control-sm" value="Yıldız Yangın Güvenlik Sistemleri Ltd." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">7/24 Servis Telefonu</label>
                                <input type="text" name="servicePhone" class="form-control form-control-sm" value="0216 444 0 911" />
                            </div>
                        </div>
                    </div>

                    <!-- 3. Dolap ve İhbar Sistemi -->
                    <div class="card border shadow-none bg-light rounded-3 p-3">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-broadcast text-warning me-2"></i>3. Yangın Dolabı & Algılama Tesisatı</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hasHoseCabinet" value="true" id="chkHoseCabinet" checked>
                                    <label class="form-check-label small fw-semibold" for="chkHoseCabinet">
                                        Yangın Dolabı & 20mt Yarı Sert Hortum Makarası (TS EN 671-1)
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hasSmokeDetector" value="true" id="chkSmokeDetector" checked>
                                    <label class="form-check-label small fw-semibold" for="chkSmokeDetector">
                                        Adresli Duman Dedektörü & Manuel Yangın İhbar Butonu
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 rounded-bottom-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-shield-check me-1"></i> 💾 Yangın Güvenlik Pasaportunu Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 1: DXF Kat & Daire Çözümleme Modal -->

<div class="modal fade" id="dxfFloorSyncModal" tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content rounded-4 border-0 shadow">

            <form asp-action="AutoPopulateBuildingFromDxf" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="buildingId" value="@Model.Id" />

                <div class="modal-header bg-primary text-white border-0 py-3 rounded-top-4">

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-cpu me-2"></i>⚡ Mimari DWG / DXF Kat & Daire Çözümleme

                    </h5>

                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body p-4">

                    <div class="alert alert-primary bg-primary bg-opacity-10 border-primary border-opacity-25 rounded-3 mb-4">

                        <h6 class="fw-bold text-primary mb-1"><i class="bi bi-file-earmark-check me-2"></i>Ruhsat Projesi ve Mimari İskelet Eşleştirmesi</h6>

                        <p class="small mb-0 text-muted">

                            Bu işlem, binanın mimari DWG/DXF ruhsat projesinde yer alan kat dağılımını (Bodrum otopark/sığınak, Zemin dükkanlar, 1-15. katlar 3+1 ve 2+1 daireler, çatı dubleksleri) analiz ederek bağımsız bölümlere kapı numarası, tip, brüt/net m² ve cephe bilgilerini otomatik işler.

                        </p>

                    </div>



                    <div class="row g-3 mb-3">

                        <div class="col-md-6">

                            <div class="card h-100 border shadow-none bg-light p-3 rounded-3">

                                <div class="fw-bold text-dark small mb-2"><i class="bi bi-building me-1 text-primary"></i>Mimari Kat Dağılımı</div>

                                <ul class="list-unstyled small text-muted mb-0">

                                    <li><i class="bi bi-check2 text-success me-1"></i><strong>-2. Bodrum:</strong> Kapalı Otopark, Su Deposu</li>

                                    <li><i class="bi bi-check2 text-success me-1"></i><strong>-1. Bodrum:</strong> Sığınak, Jeneratör & Pano Odası</li>

                                    <li><i class="bi bi-check2 text-success me-1"></i><strong>Zemin Kat:</strong> 2 Adet Cadde Dükkanı & Giriş Holü</li>

                                    <li><i class="bi bi-check2 text-success me-1"></i><strong>1 - 15. Katlar:</strong> Kat başı 2 Daire (30 Daire)</li>

                                    <li><i class="bi bi-check2 text-success me-1"></i><strong>Çatı Katı:</strong> 2 Adet Çatı Dubleksi</li>

                                </ul>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="card h-100 border shadow-none bg-light p-3 rounded-3">

                                <div class="fw-bold text-dark small mb-2"><i class="bi bi-layout-text-sidebar-reverse me-1 text-info"></i>Tip Daire Standartları</div>

                                <ul class="list-unstyled small text-muted mb-0">

                                    <li><i class="bi bi-check2 text-primary me-1"></i><strong>Tip A (Tek No):</strong> 3+1 | Kuzey-Doğu | 135 m² Brüt (112 m² Net)</li>

                                    <li><i class="bi bi-check2 text-primary me-1"></i><strong>Tip B (Çift No):</strong> 2+1 | Güney-Batı | 95 m² Brüt (80 m² Net)</li>

                                    <li><i class="bi bi-check2 text-primary me-1"></i><strong>Ticari Dükkanlar:</strong> 180 m² ve 140 m² Brüt</li>

                                    <li><i class="bi bi-check2 text-primary me-1"></i><strong>Çatı Dubleks:</strong> 4+1 | 210 m² Brüt (175 m² Net)</li>

                                </ul>

                            </div>

                        </div>

                    </div>



                    <div class="alert alert-warning py-2 small mb-0 rounded-3">

                        <i class="bi bi-info-circle me-1"></i> Mevcut boş veya isimsiz dairelerin başlıkları ruhsat projesi numaralandırma standardına göre güncellenir. Hak sahibi atamaları silinmez.

                    </div>

                </div>

                <div class="modal-footer bg-light border-0 py-3 rounded-bottom-4">

                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">

                        <i class="bi bi-check-circle-fill me-1"></i> ⚡ Kat ve Daireleri İskelete Göre Doldur

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- Modal 2: Daire Sahiplendirme & Mülkiyet Paylaşım Masası Modal -->

<div class="modal fade" id="ownershipDistributionModal" tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content rounded-4 border-0 shadow">

            <form asp-action="BulkAssignOwnership" method="post" id="formBulkAssignOwnership">

                @Html.AntiForgeryToken()

                <input type="hidden" name="buildingId" value="@Model.Id" />

                <div class="modal-header bg-dark text-white border-0 py-3 rounded-top-4">

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-people-fill text-warning me-2"></i>👥 Daire Sahiplendirme & Mülkiyet Paylaşım Masası

                    </h5>

                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body p-4">

                    <div class="alert alert-light border shadow-sm rounded-3 mb-3 p-3">

                        <div class="row align-items-center">

                            <div class="col-md-7">

                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-briefcase-fill text-primary me-2"></i>Mülkiyet Hedefini Seçin</h6>

                                <p class="small text-muted mb-0">Seçili bağımsız bölümleri Arsa/Hak Sahibine tahsis edebilir veya Müteahhit Satılık Portföyüne aktarabilirsiniz.</p>

                            </div>

                            <div class="col-md-5">

                                <div class="d-flex gap-3">

                                    <div class="form-check">

                                        <input class="form-check-input" type="radio" name="assignmentType" id="assignStakeholderRadio" value="Stakeholder" checked>

                                        <label class="form-check-label fw-bold text-danger cursor-pointer" for="assignStakeholderRadio">

                                            🔴 Hak Sahibine Ver

                                        </label>

                                    </div>

                                    <div class="form-check">

                                        <input class="form-check-input" type="radio" name="assignmentType" id="assignContractorRadio" value="Contractor">

                                        <label class="form-check-label fw-bold text-success cursor-pointer" for="assignContractorRadio">

                                            🟢 Müteahhit Payı (Satılık)

                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- Hak Sahibi Seçimi Dropdown -->

                    <div id="stakeholderSelectWrapper" class="bg-light p-3 rounded-3 border mb-3">

                        <label class="form-label fw-bold small text-dark"><i class="bi bi-person-fill text-danger me-1"></i>Hak Sahibi / Arsa Sahibi Seçiniz</label>

                        @{

                            var stakeholders = ViewBag.Stakeholders as List<GMK360.Core.Entities.Construction.ProjectStakeholder> ?? new List<GMK360.Core.Entities.Construction.ProjectStakeholder>();

                        }

                        <select name="stakeholderUserId" class="form-select fw-semibold" id="selectStakeholderUser">

                            @if (stakeholders.Any())

                            {

                                foreach (var s in stakeholders)

                                {

                                    string roleName = s.Role == GMK360.Core.Entities.Construction.StakeholderRole.Landowner ? "Arsa Sahibi" : "Hak Sahibi / Hissedar";

                                    <option value="@s.UserId">@s.User?.FirstName @s.User?.LastName (@roleName - %@(s.SharePercentage ?? 0))</option>

                                }

                            }

                            else

                            {

                                <option value="">Projede Kayıtlı Hak Sahibi Bulunmuyor</option>

                            }

                        </select>

                    </div>



                    <!-- Hızlı Dağıtım Aksiyon Butonları -->

                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">

                        <div class="d-flex align-items-center gap-1">

                            <span class="small fw-bold text-muted me-2">Hızlı Seçim:</span>

                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" id="btnSelectOddUnits">

                                <i class="bi bi-lightning-charge me-1"></i>Tek Numaraları Seç (1, 3, 5...)

                            </button>

                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold" id="btnSelectEvenUnits">

                                <i class="bi bi-lightning-charge me-1"></i>Çift Numaraları Seç (2, 4, 6...)

                            </button>

                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2" id="btnSelectAllUnitsInModal">

                                Tümünü Seç

                            </button>

                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-2" id="btnClearModalSelection">

                                Temizle

                            </button>

                        </div>

                        <div>

                            <span class="badge bg-primary px-3 py-2 rounded-pill" id="modalSelectedCount">0 birim seçildi</span>

                        </div>

                    </div>



                    <!-- Daire Tablosu -->

                    <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">

                        <table class="table table-hover align-middle mb-0" style="font-size:0.85rem;">

                            <thead class="table-light sticky-top">

                                <tr>

                                    <th style="width: 40px;"></th>

                                    <th>Kat</th>

                                    <th>No</th>

                                    <th>Tip</th>

                                    <th>Cephe</th>

                                    <th>Metrekare</th>

                                    <th>Mevcut Mülkiyet Durumu</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var u in allUnits.OrderByDescending(x => x.FloorLevel).ThenBy(x => x.Id))

                                {

                                    bool isCommon = u.Category == "OrtakAlan";

                                    bool isOwned = !string.IsNullOrEmpty(u.OwnerName);

                                    <tr>

                                        <td>

                                            @if (!isCommon)

                                            {

                                                <input type="checkbox" name="unitIds" value="@u.Id" class="form-check-input modal-unit-chk shadow-none" data-door="@u.DoorNumber" />

                                            }

                                        </td>

                                        <td><span class="badge bg-light text-dark border">@u.FloorLevel. Kat</span></td>

                                        <td class="fw-bold text-dark">No: @u.DoorNumber</td>

                                        <td><span class="badge bg-primary-subtle text-primary border">@(u.RoomLayout ?? "-")</span></td>

                                        <td><span class="badge bg-info-subtle text-info border">@(u.FacadeDirection ?? "-")</span></td>

                                        <td>

                                            @(u.GrossSquareMeters.HasValue ? $"{u.GrossSquareMeters.Value:N0} m²" : "-")

                                        </td>

                                        <td>

                                            @if (isCommon)

                                            {

                                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning"><i class="bi bi-shield-check me-1"></i>Bina Tesis / Ortak</span>

                                            }

                                            else if (isOwned)

                                            {

                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><i class="bi bi-person-fill-check me-1"></i>Hak Sahibi: @u.OwnerName</span>

                                            }

                                            else

                                            {

                                                <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-tag-fill me-1"></i>Müteahhit Payı (Satılık)</span>

                                            }

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <div class="modal-footer bg-light border-0 py-3 rounded-bottom-4">

                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>

                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" id="btnSaveOwnership">

                        <i class="bi bi-save-fill me-1"></i> 💾 Mülkiyet Dağıtımını Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



