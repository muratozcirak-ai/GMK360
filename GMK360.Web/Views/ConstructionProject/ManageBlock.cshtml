<!-- Copy Floor Modal -->

<div class="modal fade" id="copyFloorModal" tabindex="-1" aria-labelledby="copyFloorModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content rounded-4 border-0 shadow-lg">

            <form asp-action="CopyFloor" method="post" id="formCopyFloor">

                @Html.AntiForgeryToken()

                <input type="hidden" name="buildingId" id="copyFloorBuildingId" value="@Model.Id" />

                <input type="hidden" name="sourceFloorLevel" id="sourceFloorLevel" value="" />

                <input type="hidden" name="targetFloorLevels" id="copyTargetFloorLevelsHidden" value="" />

                

                <div class="modal-header bg-info bg-opacity-10 border-0 py-3 px-4">

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-copy text-info fs-4"></i>

                        <div>

                            <h5 class="modal-title fw-bold mb-0 text-dark">Katı Diğer Katlara Çoğalt / Kopyala</h5>

                            <small class="text-muted">Kaynak Kat: <strong id="sourceFloorNameDisplay" class="text-primary">-</strong></small>

                        </div>

                    </div>

                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Kapat"></button>

                </div>



                <div class="modal-body p-4">

                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">

                        <i class="bi bi-info-circle-fill fs-5 text-info"></i>

                        <div>

                            Bu kattaki daireleri, <strong>odaları (salon, yatak odaları, banyo)</strong>, <strong>ölçüleri</strong> ve <strong>demirbaşları (kapı, petek)</strong> seçtiğiniz hedef katlara birebir çoğaltır. Hedef katta zaten var olan kapı numaraları otomatik korunur.

                        </div>

                    </div>

                    

                    <!-- Neler Kopyalanacak? -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <label class="form-label fw-bold small text-dark mb-0">1. Kopyalanacak Birimler ve Odalar:</label>

                            <div>

                                <a href="#" id="selectAllCopyUnits" class="badge bg-light text-primary border text-decoration-none px-2 py-1">Tümünü Seç</a>

                                <a href="#" id="selectCommonOnly" class="badge bg-light text-success border text-decoration-none px-2 py-1 ms-1">Sadece Ortak Alanlar</a>

                            </div>

                        </div>

                        <div id="copyUnitsCheckboxes" class="border rounded-3 p-3 bg-light" style="max-height: 140px; overflow-y: auto;">

                            <div class="text-center text-muted small py-3" id="copyUnitsLoading">Birimler yükleniyor... <div class="spinner-border spinner-border-sm ms-2" role="status"></div></div>

                        </div>

                    </div>

                    

                    <!-- Hedef Katları Seçin -->

                    <div class="border-top pt-3">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <label class="form-label fw-bold small text-dark mb-0">2. Hedef Katları Seçin:</label>

                        </div>



                        <!-- Hızlı Kat Seçim Filtresi -->

                        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center bg-light p-2 rounded-3 border">

                            <span class="small fw-bold text-muted me-1"><i class="bi bi-funnel me-1"></i>Hızlı Kat Seçimi:</span>

                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3 btn-copy-filter" data-filter="all">

                                <i class="bi bi-check-all me-1"></i>Tümünü Seç

                            </button>

                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill py-1 px-3 btn-copy-filter" data-filter="normal">

                                <i class="bi bi-building me-1"></i>Normal Katlar

                            </button>

                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-3 btn-copy-filter" data-filter="ground-basement">

                                <i class="bi bi-box-arrow-in-down me-1"></i>Zemin & Bodrum Katlar

                            </button>

                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-1 px-3 btn-copy-filter" data-filter="clear">

                                <i class="bi bi-x-circle me-1"></i>Temizle

                            </button>

                        </div>



                        <!-- Hedef Katlar Grid / Listesi -->

                        <div class="row g-3" id="copyFloorsContainer" style="max-height: 280px; overflow-y: auto;">

                            @if (isParentBlock)

                            {

                                if (isOrtakBaza && podiumKots > 0)

                                {

                                    <div class="col-md-6 mb-2 copy-block-col" data-block="@Model.Id">

                                        <div class="card border bg-light shadow-xs h-100">

                                            <div class="card-body p-3">

                                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">

                                                    <h6 class="fw-bold text-primary mb-0 small"><i class="bi bi-building me-1"></i>@Model.BlockName (Ortak Baza)</h6>

                                                    <div class="form-check m-0">

                                                        <input class="form-check-input select-all-copy-block-floors" type="checkbox" data-target-block="@Model.Id" id="selAllCp_@Model.Id">

                                                        <label class="form-check-label small fw-bold" for="selAllCp_@Model.Id">Tümü</label>

                                                    </div>

                                                </div>

                                                <div class="d-flex flex-column gap-1">

                                                    @for (int slab = podiumKots; slab >= 1; slab--)

                                                    {

                                                        var fName = GetFloorNameBySlabIndex(Model, slab);

                                                        bool isBasement = slab <= Model.BasementFloors;

                                                        bool isGround = Model.HasGroundFloor && (slab == Model.BasementFloors + 1);

                                                        string fType = isBasement ? "basement" : (isGround ? "ground" : "normal");

                                                        int actualLevel = isBasement ? -(Model.BasementFloors - slab + 1) : (isGround ? 0 : (slab - Model.BasementFloors - (Model.HasGroundFloor ? 1 : 0)));

                                                        string chkId = $"chk_cp_{Model.Id}_{actualLevel}";

                                                        <div class="form-check copy-floor-row" data-floorlevel="@actualLevel" data-block="@Model.Id">

                                                            <input class="form-check-input chk-copy-floor shadow-sm" type="checkbox" value="@actualLevel" data-floorlevel="@actualLevel" data-block="@Model.Id" data-type="@fType" id="@chkId">

                                                            <label class="form-check-label small" for="@chkId">

                                                                @fName

                                                                @if (isBasement) { <span class="badge bg-secondary-subtle text-secondary small ms-1">Bodrum</span> }

                                                                else if (isGround) { <span class="badge bg-info-subtle text-info small ms-1">Zemin</span> }

                                                                else { <span class="badge bg-success-subtle text-success small ms-1">Normal</span> }

                                                            </label>

                                                        </div>

                                                    }

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                }



                                if (Model.ChildBuildings != null)

                                {

                                    int childCount = Model.ChildBuildings.Count;

                                    string colClass = childCount >= 3 ? "col-md-4 mb-2" : "col-md-6 mb-2";

                                    foreach (var child in Model.ChildBuildings.OrderBy(c => c.BlockName))

                                    {

                                        int childTotalSlabs = GetTotalSlabs(child);

                                        <div class="@colClass copy-block-col" data-block="@child.Id">

                                            <div class="card border bg-light shadow-xs h-100">

                                                <div class="card-body p-3">

                                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">

                                                        <h6 class="fw-bold text-primary mb-0 small"><i class="bi bi-building me-1"></i>@child.BlockName</h6>

                                                        <div class="form-check m-0">

                                                            <input class="form-check-input select-all-copy-block-floors" type="checkbox" data-target-block="@child.Id" id="selAllCp_@child.Id">

                                                            <label class="form-check-label small fw-bold" for="selAllCp_@child.Id">Tümü</label>

                                                        </div>

                                                    </div>

                                                    <div class="d-flex flex-column gap-1">

                                                        @for (int slab = childTotalSlabs; slab >= 1; slab--)

                                                        {

                                                            var fName = GetFloorNameBySlabIndex(child, slab);

                                                            bool isBasement = slab <= child.BasementFloors;

                                                            bool isGround = child.HasGroundFloor && (slab == child.BasementFloors + 1);

                                                            string fType = isBasement ? "basement" : (isGround ? "ground" : "normal");

                                                            int actualLevel = isBasement ? -(child.BasementFloors - slab + 1) : (isGround ? 0 : (slab - child.BasementFloors - (child.HasGroundFloor ? 1 : 0)));

                                                            string chkId = $"chk_cp_{child.Id}_{actualLevel}";

                                                            <div class="form-check copy-floor-row" data-floorlevel="@actualLevel" data-block="@child.Id">

                                                                <input class="form-check-input chk-copy-floor shadow-sm" type="checkbox" value="@actualLevel" data-floorlevel="@actualLevel" data-block="@child.Id" data-type="@fType" id="@chkId">

                                                                <label class="form-check-label small" for="@chkId">

                                                                    @fName

                                                                    @if (isBasement) { <span class="badge bg-secondary-subtle text-secondary small ms-1">Bodrum</span> }

                                                                    else if (isGround) { <span class="badge bg-info-subtle text-info small ms-1">Zemin</span> }

                                                                    else { <span class="badge bg-success-subtle text-success small ms-1">Normal</span> }

                                                                </label>

                                                            </div>

                                                        }

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    }

                                }

                            }

                            else

                            {

                                int singleTotalSlabs = GetTotalSlabs(Model);

                                <div class="col-md-12 copy-block-col" data-block="@Model.Id">

                                    <div class="card border bg-light shadow-xs">

                                        <div class="card-body p-3">

                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">

                                                <h6 class="fw-bold text-primary mb-0 small"><i class="bi bi-building me-1"></i>@Model.BlockName</h6>

                                                <div class="form-check m-0">

                                                    <input class="form-check-input select-all-copy-block-floors" type="checkbox" data-target-block="@Model.Id" id="selAllCp_@Model.Id">

                                                    <label class="form-check-label small fw-bold" for="selAllCp_@Model.Id">Tümü</label>

                                                </div>

                                            </div>

                                            <div class="d-flex flex-column gap-1">

                                                @for (int slab = singleTotalSlabs; slab >= 1; slab--)

                                                {

                                                    var fName = GetFloorNameBySlabIndex(Model, slab);

                                                    bool isBasement = slab <= Model.BasementFloors;

                                                    bool isGround = Model.HasGroundFloor && (slab == Model.BasementFloors + 1);

                                                    string fType = isBasement ? "basement" : (isGround ? "ground" : "normal");

                                                    int actualLevel = isBasement ? -(Model.BasementFloors - slab + 1) : (isGround ? 0 : (slab - Model.BasementFloors - (Model.HasGroundFloor ? 1 : 0)));

                                                    string chkId = $"chk_cp_{Model.Id}_{actualLevel}";

                                                    <div class="form-check copy-floor-row" data-floorlevel="@actualLevel" data-block="@Model.Id">

                                                        <input class="form-check-input chk-copy-floor shadow-sm" type="checkbox" value="@actualLevel" data-floorlevel="@actualLevel" data-block="@Model.Id" data-type="@fType" id="@chkId">

                                                        <label class="form-check-label small" for="@chkId">

                                                            @fName

                                                            @if (isBasement) { <span class="badge bg-secondary-subtle text-secondary small ms-1">Bodrum</span> }

                                                            else if (isGround) { <span class="badge bg-info-subtle text-info small ms-1">Zemin</span> }

                                                            else { <span class="badge bg-success-subtle text-success small ms-1">Normal</span> }

                                                        </label>

                                                    </div>

                                                }

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            }

                        </div>

                    </div>

                </div>

                

                <div class="modal-footer border-0 bg-light py-3 px-4 d-flex justify-content-between align-items-center">

                    <span class="small text-muted" id="copySelectedFloorsSummary">Seçili Hedef: 0 kat</span>

                    <div class="d-flex gap-2">

                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>

                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="btnSubmitCopyFloor">

                            <i class="bi bi-copy me-1"></i> Seçili Katlara Çoğalt

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>



