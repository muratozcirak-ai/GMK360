                                @if (ortakCount > 0) { <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@ortakCount Ortak Alan</span> }

                                @if (depoCount > 0) { <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@depoCount Eklenti/Depo</span> }

                            </div>

                        </div>

                    </div>



