                        <input type="text" name="OwnerName" id="editOwnerName" class="form-control" placeholder="Mal Sahibi Adı Soyadı" style="display:none;" />
                        <div class="form-text small text-muted">Boş bırakırsanız "Sahipsiz / Boş" olarak görünür.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Copy Floor Modal -->
<div class="modal fade" id="copyFloorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="CopyFloor" method="post">
                <input type="hidden" name="buildingId" value="@Model.Id" />
                <input type="hidden" name="sourceFloorLevel" id="sourceFloorLevel" value="" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Kat Kopyala (<span id="sourceFloorNameDisplay" class="text-primary"></span>)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small rounded-3">
                        <i class="bi bi-info-circle me-1"></i> Sadece seçtiğiniz birimler hedef katlara eklenecektir. (Eğer o katta zaten aynı isimde bir birim varsa otomatik atlanır).
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-primary d-flex justify-content-between">
                            Neler Kopyalanacak?
                            <div>
                                <a href="#" id="selectAllCopyUnits" class="small ms-2">Hepsini Seç</a> |
                                <a href="#" id="selectCommonOnly" class="small text-success ms-1">Sadece Ortak Alanlar</a>
                            </div>
                        </label>
                        <div id="copyUnitsCheckboxes" class="border rounded p-2" style="max-height: 150px; overflow-y: auto; background: #f8f9fa;">
                            <div class="text-center text-muted small py-3" id="copyUnitsLoading">Birimler yükleniyor... <div class="spinner-border spinner-border-sm ms-2" role="status"></div></div>
                        </div>
                    </div>
                    
                    <div class="mb-3 mt-4 border-top pt-3">
                        <label class="form-label fw-bold small">Hedef Katlar (Virgülle ayırın)</label>
                        <input type="text" name="targetFloorLevels" class="form-control" placeholder="Örn: 1,2,3,4,5,6,7,9" required />
                        <div class="form-text">Örn: 1. ve 3. katlara kopyalamak için <b>1,3</b> yazın.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kopyala</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Populate Add Unit Modal automatically when clicking "Bu Kata Yeni Birim Ekle"
            $('.btn-add-unit-to-floor').click(function() {
                var floorLevel = $(this).data('floorlevel');
                var floorName = $(this).data('floorname');
                if (floorLevel !== undefined) {
                    $('#addUnitModal input[name="FloorLevel"]').val(floorLevel);
                }
                if (floorName !== undefined) {
                    $('#addUnitModal input[name="FloorName"]').val(floorName);
                }
            });

            // Populate Copy Floor Modal
            $('.btn-copy-floor').click(function() {
                var floorLevel = $(this).data('floorlevel');
                var floorName = $(this).data('floorname');
                var buildingId = '@Model.Id';
                $('#copyFloorModal #sourceFloorLevel').val(floorLevel);
                $('#copyFloorModal #sourceFloorNameDisplay').text(floorName);
                $('#copyFloorModal input[name="targetFloorLevels"]').val('');
                
                // Fetch units
                $('#copyUnitsCheckboxes').html('<div class="text-center text-muted small py-3">Birimler yükleniyor... <div class="spinner-border spinner-border-sm ms-2" role="status"></div></div>');
                
                $.get('/ConstructionProject/GetFloorUnits', { buildingId: buildingId, floorLevel: floorLevel }, function(data) {
                    var html = '';
                    if(data && data.length > 0) {
                        data.forEach(function(u) {
                            var icon = 'bi-door-open';
                            var isCommon = false;
                            if(u.category === 'OrtakAlan' || u.category === 'OrtakAlan_Blok' || u.category === 'OrtakAlan_Kat') {
                                icon = 'bi-building text-success';
                                isCommon = true;
                            } else if (u.category === 'Eklenti') {
                                icon = 'bi-box text-secondary';
                            } else if (u.category === 'Dükkan') {
                                icon = 'bi-shop text-primary';
                            }
                            
                            html += '<div class="form-check mb-1">';
                            html += '  <input class="form-check-input copy-unit-cb" type="checkbox" name="selectedUnitIds" value="' + u.id + '" id="cb_' + u.id + '" data-iscommon="' + isCommon + '" checked>';
                            html += '  <label class="form-check-label small" for="cb_' + u.id + '">';
                            html += '    <i class="bi ' + icon + ' me-1"></i> ' + u.doorNumber + ' <span class="text-muted" style="font-size:0.8em">(' + (u.roomLayout || u.category) + ')</span>';
                            html += '  </label>';
                            html += '</div>';
                        });
                    } else {
                        html = '<div class="text-muted small py-2">Bu katta hiç birim yok.</div>';
                    }
                    $('#copyUnitsCheckboxes').html(html);
                });
            });
            
            $('#selectAllCopyUnits').click(function(e) {
                e.preventDefault();
                $('.copy-unit-cb').prop('checked', true);
            });
            $('#selectCommonOnly').click(function(e) {
                e.preventDefault();
                $('.copy-unit-cb').prop('checked', false);
                $('.copy-unit-cb[data-iscommon="true"]').prop('checked', true);
            });
            // Populate Add Unit Modal when clicked from a specific floor
            var rowIdx = 1;
            $('#btnAddNewUnitRow').click(function() {
                var newRow = `<tr>
                                <td><input type="text" name="Units[${rowIdx}].DoorNumber" class="form-control form-control-sm" required /></td>
                                <td>
                                    <select name="Units[${rowIdx}].UnitStructure" class="form-select form-select-sm">
                                        <option value="Mesken" selected>Mesken (Normal Daire)</option>
                                        <option value="Çatı Dubleksi">Çatı Dubleksi</option>
                                        <option value="Ters Dubleks">Ters Dubleks</option>
                                <option value="Bahce Dubleksi">Bahçe Dubleksi</option>
                                        <option value="Bahçe Katı">Bahçe Katı</option>
                                        <option value="Düz Dükkan">Düz Dükkan (Tek Kat)</option>
                                  <option value="Asma Katlı Dükkan">Asma Katlı Dükkan</option>
                                  <option value="Depolu Dükkan">Depolu Dükkan (Bodrumlu vb.)</option>
                                  <option value="Ofis / Büro">Ofis / Büro</option>
                                    </select>
                                </td>
                                <td>
                                    <select name="Units[${rowIdx}].FacadeDirection" class="form-select form-select-sm">
                                        <option value="">Seçiniz...</option>
                                        <option value="Kuzey">Kuzey</option>
                                        <option value="Güney">Güney</option>
                                        <option value="Doğu">Doğu</option>
                                        <option value="Batı">Batı</option>
                                        <option value="Kuzeydoğu">Kuzeydoğu</option>
                                        <option value="Kuzeybatı">Kuzeybatı</option>
                                        <option value="Güneydoğu">Güneydoğu</option>
                                        <option value="Güneybatı">Güneybatı</option>
                                    </select>
                                </td>
                                <td><input type="number" name="Units[${rowIdx}].GrossSquareMeters" class="form-control form-control-sm" /></td>
                                <td><button type="button" class="btn btn-sm btn-danger remove-unit-row"><i class="bi bi-trash"></i></button></td>
                              </tr>`;
                $('#dynamicUnitsTable tbody').append(newRow);
                rowIdx++;
            });
            $(document).on('click', '.remove-unit-row', function() {
                $(this).closest('tr').remove();
            });
            $('.btn-add-unit-to-floor').click(function() {
                  var floorLevel = $(this).data('floorlevel');
                  var floorName = $(this).data('floorname');
                  var buildingId = $(this).data('buildingid');
                  $('[name="FloorLevel"]').val(floorLevel);
                  $('[name="FloorName"]').val(floorName);
                  if (buildingId) {
                      $('#addUnitModal input[name="BuildingId"]').val(buildingId);
                  }
                  $('#addUnitModal .modal-title').html('<i class="bi bi-plus-square text-success me-2"></i>' + floorName + ' - Hızlı Birim Ekle');
                  $('#floorDataRow').hide();
                  $('#addUnitAlert').hide();
              });
              $('[data-bs-target="#addUnitModal"]:not(.btn-add-unit-to-floor)').click(function() {
                  $('[name="FloorLevel"]').val('');
                  $('[name="FloorName"]').val('');
                  $('#addUnitModal .modal-title').html('<i class="bi bi-plus-square text-success me-2"></i>Yeni Kat / Birim Ekle');
                  $('#floorDataRow').show();
                  $('#addUnitAlert').show();
              });            
            // For the global Add Floor button
            $('.btn-add-global').click(function(){
                 $('#addUnitModalTitle').text('Yeni Kat / Birim Ekle');
                 // For a global add, we need them to type the floor manually, but we hid it!
                 // Let's just prompt them for floor level if it's empty
            });
            // Floor checkbox toggles all units in that floor// Floor checkbox toggles all units in that floor
            $('.select-all-floor').change(function() {
                var floor = $(this).data('floor');
                var isChecked = $(this).is(':checked');
                $('.unit-checkbox[data-floor="' + floor + '"]').prop('checked', isChecked);
            });
            // Bulk Edit Submit
            $('#btnSubmitBulkEdit').click(function() {
                var selectedIds = [];
                $('.unit-checkbox:checked').each(function() {
                    selectedIds.push($(this).val());
                });
                if (selectedIds.length === 0) {
                    alert('Lütfen düzenlemek için en az bir daire seçin.');
                    return;
                }
                $('#bulkUnitIds').val(selectedIds.join(','));
                // Set action and submit form
                $('#bulkEditForm').attr('action', '/ConstructionProject/BulkUpdateUnits?buildingId=@Model.Id');
                $('#bulkEditForm').submit();
            });
        });
    function toggleUnitCategory() {
        var cat = document.getElementById('unitCategorySelect').value;
        var parentWrapper = document.getElementById('parentUnitWrapper');
        var doorNumberLabel = document.getElementById('doorNumberLabel');
        
        if(doorNumberLabel) {
            if(cat.startsWith('OrtakAlan')) {
                doorNumberLabel.innerText = "Ortak Alan Adı (Örn: Hol, Şaft)";
            } else if(cat === 'Eklenti') {
                doorNumberLabel.innerText = "Eklenti Adı (Örn: Ayakkabılık, Depo)";
            } else {
                doorNumberLabel.innerText = "Kapı No / İsim";
            }
        }

        var floorRow = document.getElementById('floorDataRow');
        var structureWrapper = document.getElementById('unitStructureWrapper');
        if(cat === 'Eklenti') {
            parentWrapper.style.display = 'block';
        } else {
            parentWrapper.style.display = 'none';
        }
        if(cat === 'OrtakAlan_Blok') {
            floorRow.style.display = 'none';
        } else {
            floorRow.style.display = 'flex';
        }
        var ownershipWrapper = document.getElementById('ownershipWrapper');
        
        if(cat === 'Daire' || cat === 'Dükkan') {
            if(ownershipWrapper) ownershipWrapper.style.display = 'block';
        } else {
            if(ownershipWrapper) ownershipWrapper.style.display = 'none';
        }
        
        var facadeWrapper = document.getElementById('facadeWrapper');
        
        if(cat === 'Daire' || cat === 'Dükkan') {
            if(structureWrapper) structureWrapper.style.display = 'block';
            if(facadeWrapper) facadeWrapper.style.display = 'block';
        } else {
            if(structureWrapper) structureWrapper.style.display = 'none';
            if(facadeWrapper) facadeWrapper.style.display = 'none';
        }
    }

    // EDIT UNIT MODAL LOGIC
    $(document).on('click', '.btn-edit-unit', function() {
        var id = $(this).data('unit-id');
        var door = $(this).data('door-number');
        var owner = $(this).data('owner-name');
        var structure = $(this).data('unit-structure') || '';
        
        $('#editUnitId').val(id);
        $('#editDoorNumber').val(door);
        
        if(owner) {
            $('#editIsOwnedSwitch').prop('checked', true);
            $('#editOwnerName').val(owner).show();
        } else {
            $('#editIsOwnedSwitch').prop('checked', false);
            $('#editOwnerName').val('').hide();
        }
        
        var myModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editUnitModal'));
        myModal.show();
    });

    $('#editIsOwnedSwitch').change(function() {
        if($(this).is(':checked')) {
            $('#editOwnerName').show().attr('required', true);
        } else {
            $('#editOwnerName').hide().removeAttr('required').val('');
        }
    });

    
// BULK GENERATOR LOGIC
$(document).on('click', '#btnOpenBulkGenerator', function() {
    try {
        var targets = {};
        var btnCount = 0;
        alert('Sistem arka planda ' + $('.btn-add-unit-to-floor').length + ' adet kat tespit etti!');
        
        $('.btn-add-unit-to-floor').each(function() {
            btnCount++;
            var bId = $(this).data('buildingid') || $(this).attr('data-buildingid') || 'bilinmeyen';
            var fLevel = $(this).data('floorlevel') || $(this).attr('data-floorlevel') || 0;
            var fName = $(this).data('floorname') || $(this).attr('data-floorname') || 'Kat';
            
            var bName = "Bilinmeyen Blok";
            var header = $(this).closest('.tower-cell, .podium-cell, .single-block-cell').find('h6').first();
            if(header.length) { bName = header.text().replace('Ekle', '').trim().split('-')[0].trim(); }
            
            if (!targets[bId]) { targets[bId] = { name: bName, floors: [] }; }
            
            var exists = false;
            for(var i=0; i<targets[bId].floors.length; i++) {
                if(targets[bId].floors[i].level == fLevel) { exists = true; break; }
            }
            
            if (!exists) {
                 targets[bId].floors.push({ level: fLevel, name: fName });
            }
        });

        var html = '';
        var blockCount = 0;
        for (var bId in targets) {
            blockCount++;
            var b = targets[bId];
            html += '<div class="col-md-6 mb-4">';
            html += '<div class="card border-0 bg-light shadow-sm"><div class="card-body p-3">';
            html += '<h6 class="fw-bold text-primary mb-3"><i class="bi bi-building me-2"></i>' + b.name + '</h6>';
            
            html += '<div class="form-check mb-2 pb-2 border-bottom">';
            html += '<input class="form-check-input select-all-block-floors shadow-sm" type="checkbox" data-target-block="' + bId + '" id="selAll_' + bId + '">';
            html += '<label class="form-check-label fw-bold text-dark" for="selAll_' + bId + '">Tüm Katları Seç</label>';
            html += '</div>';

            b.floors.sort(function(x,y){ return y.level - x.level; }); 
            for (var i = 0; i < b.floors.length; i++) {
                var f = b.floors[i];
                var val = bId + '|' + f.level;
                var id = 'chk_' + bId + '_' + f.level;
                html += '<div class="form-check">';
                html += '<input class="form-check-input chk-bulk-gen shadow-sm" type="checkbox" value="' + val + '" data-block="' + bId + '" id="' + id + '">';
                html += '<label class="form-check-label small" for="' + id + '">' + f.name + '</label>';
                html += '</div>';
            }
            html += '</div></div></div>';
        }
        
        if (blockCount === 0) {
            html = '<div class="alert alert-warning">Seçilecek kat bulunamadı! (Bulunan Ekle butonu: ' + btnCount + ')</div>';
        }
        
        $('#bulkGenFloorsContainer').html(html);

    } catch (e) {
        $('#bulkGenFloorsContainer').html('<div class="alert alert-danger">JS Hatası: ' + e.message + '</div>');
        console.error("HATA:", e);
    }
});

$(document).on('change', '.select-all-block-floors', function() {
    var bId = $(this).data('target-block');
    var isChecked = $(this).is(':checked');
    $('.chk-bulk-gen[data-block="'+bId+'"]').prop('checked', isChecked);
});

$(document).on('click', '#btnSubmitBulkGen', function() {
    var selected = [];
    $('.chk-bulk-gen:checked').each(function() {
        selected.push($(this).val());
    });
    
    if(selected.length === 0) {
        alert("Lütfen en az bir kat seçin!");
        return;
    }
    
    var category = $('#bulkGenCategory').val();
    var count = $('#bulkGenCount').val();
    
    var btn = $(this);
    var oldText = btn.html();
    btn.html('<i class="spinner-border spinner-border-sm"></i> Üretiliyor...').prop('disabled', true);
    
    $.ajax({
        url: '/ConstructionProject/BulkGenerateEmptyUnits',
        type: 'POST',
        data: {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
            projectId: '@Model.ConstructionProjectId',
            targetFloors: selected,
            category: category,
            count: count
        },
        traditional: true,
        success: function(res) {
            btn.html(oldText).prop('disabled', false);
            if(res.success) {
                $('.chk-bulk-gen').prop('checked', false);
                $('.select-all-block-floors').prop('checked', false);
                alert(res.message);
                $('#bulkGenerateModal').data('needs-reload', true);
            } else {
                alert(res.message || 'Hata oluştu');
            }
        },
        error: function(xhr, status, error) {
            btn.html(oldText).prop('disabled', false);
            alert('HTTP Hatası: ' + xhr.status + ' - ' + error + '\nDetay: ' + (xhr.responseText ? xhr.responseText.substring(0, 500) : 'Yok'));
        }
    });
});

$('#bulkGenerateModal').on('hidden.bs.modal', function() {
    if($(this).data('needs-reload')) {
        window.location.reload();
    }
});

// ACCORDION STATE PERSISTENCE LOGIC
    $('.accordion-collapse').on('shown.bs.collapse', function (e) {
        localStorage.setItem('gmk_openAccordion', $(this).attr('id'));
    });
    
    var lastOpen = localStorage.getItem('gmk_openAccordion');
    if (lastOpen) {
        var el = document.getElementById(lastOpen);
        if (el) {
            // Use Bootstrap native collapse to show it properly
            var bsCollapse = new bootstrap.Collapse(el, { toggle: false });
            bsCollapse.show();
            
            // Just scroll it into view naturally, no aggressive animation
            setTimeout(function() {
                el.parentElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 300);
        }
    }

</script>
}