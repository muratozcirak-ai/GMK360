@model GMK360.Core.Entities.Construction.ConstructionProject
@{
    Layout = null;
    var cityName = (ViewBag.CityName as string) ?? "";
    var distName = (ViewBag.DistrictName as string) ?? "";
    var neighName = (ViewBag.NeighborhoodName as string) ?? "";
    var streetName = (ViewBag.StreetName as string) ?? "";
    var fullLoc = string.Join(" / ", new[] { streetName, neighName, distName, cityName }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var landArea = Model.TotalLandArea ?? 0;
    var hasCoords = Model.Latitude.HasValue && Model.Longitude.HasValue;
    var lat = Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "40.981438";
    var lng = Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "29.073143";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TKGM Kadastro & Canlı Uydu Haritası - @Model.Name</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #111;
        }
        #fullMap {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1;
        }
        .hud-card {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 1000;
            max-width: 440px;
            backdrop-filter: blur(12px);
            background: rgba(18, 24, 38, 0.90);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            color: #fff;
            padding: 16px 20px;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
        }
        .layer-switcher {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
            backdrop-filter: blur(10px);
            background: rgba(18, 24, 38, 0.90);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 30px;
            padding: 4px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.35);
            display: flex;
            gap: 4px;
        }
        .bottom-hud {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            backdrop-filter: blur(12px);
            background: rgba(18, 24, 38, 0.92);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 30px;
            padding: 8px 22px;
            color: #fff;
            box-shadow: 0 8px 28px rgba(0,0,0,0.45);
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 0.9rem;
        }
        .btn-layer {
            border: none;
            background: transparent;
            color: #adb5bd;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.82rem;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }
        .btn-layer.active {
            background: #0d6efd;
            color: #fff;
            box-shadow: 0 2px 8px rgba(13, 110, 253, 0.4);
        }
        .btn-hud-tool {
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-hud-tool:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffc107;
        }
    </style>
</head>
<body>
    <div id="fullMap"></div>

    <!-- HUD BİLGİ KARTI -->
    <div class="hud-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                <i class="bi bi-geo-alt-fill me-1"></i>TKGM MEGSİS RESMİ PARSEL
            </span>
            <span class="text-white-50 small">Proje #@Model.Id</span>
        </div>
        <h5 class="fw-bold mb-1 text-white">@Model.Name</h5>
        <div class="text-white-50 small mb-3">
            <i class="bi bi-pin-map text-warning me-1"></i>@(string.IsNullOrWhiteSpace(fullLoc) ? "Konum girilmemiş" : fullLoc)
        </div>

        <div class="row g-2 text-center p-2 rounded-3" style="background: rgba(255,255,255,0.08);">
            <div class="col-4 border-end border-white-50">
                <small class="text-white-50 d-block" style="font-size: 0.70rem;">ADA</small>
                <span class="fw-bold text-white fs-6">@(string.IsNullOrWhiteSpace(Model.Ada) ? "-" : Model.Ada)</span>
            </div>
            <div class="col-4 border-end border-white-50">
                <small class="text-white-50 d-block" style="font-size: 0.70rem;">PARSEL</small>
                <span class="fw-bold text-white fs-6">@(string.IsNullOrWhiteSpace(Model.Parsel) ? "-" : Model.Parsel)</span>
            </div>
            <div class="col-4">
                <small class="text-white-50 d-block" style="font-size: 0.70rem;">TAPU ALANI</small>
                <span class="fw-bold text-warning fs-6">@landArea.ToString("N2") m²</span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top border-secondary">
            @if (hasCoords)
            {
                <a href="https://maps.google.com/?q=@(lat),@(lng)&t=k" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold flex-fill" style="font-size: 0.8rem;">
                    <i class="bi bi-google me-1"></i>Google Haritalar
                </a>
            }
            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3 fw-bold" onclick="window.close()" style="font-size: 0.8rem;">
                <i class="bi bi-x me-1"></i>Kapat
            </button>
        </div>
    </div>

    <!-- KATMAN DEĞİŞTİRİCİ -->
    <div class="layer-switcher">
        <button type="button" class="btn-layer active" id="btnGoogleHybrid" onclick="switchLayer('googleHybrid')">🛰️ Google Hibrit (Uydu + Sokak)</button>
        <button type="button" class="btn-layer" id="btnSat" onclick="switchLayer('satellite')">🛰️ Esri Uydu</button>
        <button type="button" class="btn-layer" id="btnOsm" onclick="switchLayer('osm')">🗺️ Sokak Haritası</button>
    </div>

    <!-- ALT KONTROL BARI -->
    <div class="bottom-hud">
        <span><i class="bi bi-compass text-danger me-1"></i><b>Kadastro Çizgisi:</b> Kırmızı Poligon</span>
        <span class="text-white-50">|</span>
        <button type="button" class="btn-hud-tool" onclick="zoomInMap()" title="Daha da Yakınlaştır">
            <i class="bi bi-zoom-in me-1"></i>Yakınlaş (+)
        </button>
        <button type="button" class="btn-hud-tool" onclick="zoomOutMap()" title="Uzaklaştır">
            <i class="bi bi-zoom-out me-1"></i>Uzaklaş (-)
        </button>
        <button type="button" class="btn-hud-tool text-warning" onclick="focusOnParcel()" title="Parsel Sınırlarına Odaklan">
            <i class="bi bi-crosshair me-1"></i>Parsele Odaklan
        </button>
    </div>

    <!-- GİZLİ GEOJSON VERİSİ -->
    <script id="polygonGeoJsonData" type="application/json">
        @Html.Raw(Model.ParcelPolygonGeoJson ?? "")
    </script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var lat = @lat;
        var lng = @lng;

        // 1. Google Hibrit Katmanı (Yüksek Çözünürlüklü Uydu + Sokak İsimleri & Bina Numaraları)
        var googleHybridLayer = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
            maxZoom: 22,
            maxNativeZoom: 20,
            attribution: '© Google Haritalar & Kadastro'
        });

        // 2. Esri Canlı Uydu
        var satLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 22,
            maxNativeZoom: 19,
            attribution: '© Esri & TKGM Kadastro'
        });

        // 3. OpenStreetMap Sokak
        var osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 22,
            maxNativeZoom: 19,
            attribution: '© OpenStreetMap contributors'
        });

        var activeLayer = googleHybridLayer;

        var map = L.map('fullMap', {
            layers: [googleHybridLayer],
            zoomControl: false,
            maxZoom: 22,
            wheelPxPerZoomLevel: 80
        }).setView([lat, lng], 19);

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        var currentParcelLayer = null;
        var polygonScript = document.getElementById('polygonGeoJsonData');
        var geoRaw = polygonScript ? polygonScript.textContent.trim() : '';

        if (geoRaw && geoRaw.length > 10) {
            try {
                var geoObj = JSON.parse(geoRaw);
                currentParcelLayer = L.geoJSON(geoObj, {
                    style: {
                        color: '#ff1744',
                        weight: 4,
                        opacity: 1,
                        fillColor: '#ffea00',
                        fillOpacity: 0.35
                    }
                }).addTo(map);

                currentParcelLayer.bindPopup("<div class='p-2 text-center'><b>@Model.Name</b><br/><span class='badge bg-danger'>Ada: @Model.Ada / Parsel: @Model.Parsel</span><br/><small class='text-muted'>@landArea.ToString("N2") m²</small></div>");

                map.fitBounds(currentParcelLayer.getBounds(), { padding: [100, 100], maxZoom: 20 });
            } catch (err) {
                console.warn('GeoJSON parse error', err);
            }
        } else {
            L.marker([lat, lng]).addTo(map).bindPopup("<b>@Model.Name</b><br/>Proje Sahası").openPopup();
        }

        function focusOnParcel() {
            if (currentParcelLayer && currentParcelLayer.getBounds) {
                map.fitBounds(currentParcelLayer.getBounds(), { padding: [100, 100], maxZoom: 20 });
            } else {
                map.setView([lat, lng], 19);
            }
        }

        function zoomInMap() {
            map.zoomIn();
        }

        function zoomOutMap() {
            map.zoomOut();
        }

        function switchLayer(type) {
            map.removeLayer(activeLayer);
            document.querySelectorAll('.btn-layer').forEach(function(b) { b.classList.remove('active'); });

            if (type === 'googleHybrid') {
                activeLayer = googleHybridLayer;
                document.getElementById('btnGoogleHybrid').classList.add('active');
            } else if (type === 'satellite') {
                activeLayer = satLayer;
                document.getElementById('btnSat').classList.add('active');
            } else if (type === 'osm') {
                activeLayer = osmLayer;
                document.getElementById('btnOsm').classList.add('active');
            }
            map.addLayer(activeLayer);
        }
    </script>
</body>
</html>
