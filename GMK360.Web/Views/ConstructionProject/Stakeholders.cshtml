                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-2">
                                <label class="form-label fw-bold small text-muted">Bu Dairede Kaç Hissedar / Hak Sahibi Var? *</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" min="1" max="20" step="1" name="shareCount" id="batchShareCount" class="form-control fw-bold fs-6 text-center" value="1" required oninput="renderStakeholderCards()" />
