@model IEnumerable<GMK360.Core.Entities.Construction.ProjectStakeholder>
@{
    ViewData["Title"] = "Hak Sahipleri (Kira & Taşınma Ödenekleri)";
    Layout = "_ConstructionLayout";

    var projects = ViewBag.Projects as List<GMK360.Core.Entities.Construction.ConstructionProject> ?? new List<GMK360.Core.Entities.Construction.ConstructionProject>();
    int? selectedProjectId = ViewBag.SelectedProjectId as int?;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
    string searchTerm = ViewBag.SearchTerm as string ?? "";

    int totalCount = ViewBag.TotalCount ?? 0;
    decimal totalRent = ViewBag.TotalRent ?? 0m;
    decimal totalRelocation = ViewBag.TotalRelocation ?? 0m;
    int paidCount = ViewBag.PaidCount ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int notStartedCount = ViewBag.NotStartedCount ?? 0;
    decimal totalProjectCommitment = ViewBag.TotalProjectCommitment ?? 0m;
}

<div class="container-fluid mt-3">
    <!-- Üst Başlık & Eylem Çubuğu (Sade & Fonksiyonel) -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i> Hak Sahipleri (Kira & Taşınma Hakedişleri)
            </h4>
            <div class="text-muted small">Kentsel dönüşüm kira desteği, tek seferlik taşınma yardımı, banka talimatı ve kasa/banka çıkış takibi.</div>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <!-- Banka Talimatı / Gişe Dağıtım Listesi Butonu (Seçim Yapılınca Görünür) -->
            <button type="button" id="btnBankInstruction" class="btn btn-outline-primary rounded-pill px-3 fw-bold shadow-sm d-none" onclick="openBankInstructionModal()">
                <i class="bi bi-file-earmark-text me-1"></i> Banka Talimatı / Gişe Listesi Al (<span id="instructionCountBadge">0</span>)
            </button>

            <!-- Toplu Ödeme Butonu (Seçim Yapılınca Parlar) -->
            <button type="button" id="btnBatchPay" class="btn btn-success rounded-pill px-3 fw-bold shadow-sm d-none" onclick="openBatchPayModal()">
                <i class="bi bi-wallet2 me-1"></i> <span id="batchPayCountBadge">0</span> Kişiyi Toplu Öde (<span id="batchPayTotalBadge">0</span> ₺)
            </button>

            <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#batchModal" onclick="openBatchAddModal()">
                <i class="bi bi-plus-circle me-1"></i> Yeni Daire & Hak Sahibi Ekle
            </button>
        </div>
    </div>

    <!-- Filtre & Arama Barı (Kompakt Tek Satır) -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
        <div class="card-body p-2 px-3">
            <form method="get" asp-action="Stakeholders" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@searchTerm" class="form-control bg-light border-start-0" placeholder="Hak Sahibi Adı, TC, Telefon veya Daire No..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="projectId" class="form-select form-select-sm bg-light">
                        <option value="">-- Tüm Şantiyeler --</option>
                        @foreach (var p in projects)
                        {
                            <option value="@p.Id" selected="@(selectedProjectId == p.Id)">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm bg-light">
                        <option value="">-- Tüm Ödeme Durumları --</option>
                        <option value="Bekliyor" selected="@(selectedStatus == "Bekliyor")">Ödeme Bekliyor</option>
                        <option value="Başlamadı" selected="@(selectedStatus == "Başlamadı")">Henüz Başlamadı</option>
                        <option value="Ödendi" selected="@(selectedStatus == "Ödendi")">Ödendi (Temizlendi)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill w-100 fw-bold">Filtrele</button>
                    @if (!string.IsNullOrEmpty(searchTerm) || selectedProjectId.HasValue || !string.IsNullOrEmpty(selectedStatus))
                    {
                        <a href="/ConstructionProject/Stakeholders" class="btn btn-sm btn-light rounded-pill px-3" title="Filtreyi Temizle"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Hızlı Seçim Yardımcı Çubuğu (Toplu Ödemeyi Kolaylaştıran Araçlar) -->
    @if (Model != null && Model.Any())
    {
        <div class="d-flex align-items-center justify-content-between mb-2 px-1 small">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted fw-semibold">Hızlı Seçim:</span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill" onclick="selectAllEligible()">
                    <i class="bi bi-check-all me-1"></i>Tüm Vadesi Gelenleri Seç
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill" onclick="clearAllSelections()">
                    Seçimi Temizle
                </button>
            </div>
            <div id="selectionStatusText" class="text-muted fst-italic">
                Tablodan hak sahiplerini seçerek tek seferde toplu ödeme yapabilir veya banka memuruna verilecek talimat çıktısı alabilirsiniz.
            </div>
        </div>
    }

    <!-- Ana Hakediş & Ödeme Tablosu (Grid / Muhasebe Yapısı) -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-sm" style="font-size: 0.92rem;">
                <thead class="table-light text-secondary border-bottom">
                    <tr>
                        <th class="ps-3 py-2" style="width: 40px;">
                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input" onchange="toggleSelectAll(this)" title="Tümünü Seç / Kaldır" />
                        </th>
                        <th class="py-2">Hak Sahibi</th>
                        <th class="py-2">Şantiye</th>
                        <th class="py-2">Mülk & Pay</th>
                        <th class="py-2">Kira Başlangıç & Vade</th>
                        <th class="py-2 text-end">Aylık Kira</th>
                        <th class="py-2 text-end">Taşınma Yardımı</th>
                        <th class="py-2">Banka & IBAN</th>
                        <th class="py-2 text-center">Ödeme Durumu</th>
                        <th class="text-end pe-3 py-2">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var st in Model)
                        {
                            bool isRealEmail = !string.IsNullOrEmpty(st.User?.Email) && !st.User.Email.EndsWith("@gmk360.local");
                            bool isRelocationPaid = st.Notes != null && st.Notes.Contains("[Taşınma yardımı ödendi]");
                            bool isSmsSent = st.Notes != null && st.Notes.Contains("[SMS İletildi");
                            bool isNotStarted = st.PaymentStatus == "Başlamadı" || (st.RentStartDate.HasValue && st.RentStartDate.Value.Date > DateTime.Today);
                            bool isPaid = st.PaymentStatus == "Ödendi";

                            decimal pRent = st.MonthlyRentAllowance ?? 0m;
                            decimal pReloc = isRelocationPaid ? 0m : (st.RelocationAllowance ?? 0m);
                            decimal pPayableTotal = pRent + pReloc;

                            <tr>
                                <!-- Seçim Kutusu -->
                                <td class="ps-3">
                                    @if (!isPaid)
                                    {
                                        <input type="checkbox" class="form-check-input stakeholder-chk" 
                                               value="@st.Id" 
                                               data-id="@st.Id"
                                               data-name="@st.User?.FirstName @st.User?.LastName"
                                               data-tc="@(st.User?.TcIdentityNo ?? "")"
                                               data-rent="@Math.Round(pRent)"
                                               data-reloc="@Math.Round(pReloc)"
                                               data-total="@Math.Round(pPayableTotal)"
                                               data-iban="@(st.Iban ?? "")"
                                               data-bank="@(st.BankName ?? "")"
                                               data-unit="@(st.UnitNumbers ?? "")"
                                               data-project="@(st.Project?.Name ?? "")"
                                               data-not-started="@(isNotStarted ? "1" : "0")"
                                               onchange="onStakeholderCheckboxChange()" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Ödendi"></i>
                                    }
                                </td>

                                <!-- Hak Sahibi Bilgisi -->
                                <td>
                                    <div class="fw-bold text-dark">
                                        @st.User?.FirstName @st.User?.LastName
                                        @if (st.User?.IsShadowAccount == true)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-1 py-0 ms-1" style="font-size: 0.65rem;" title="Gölge Müşteri Havuzunda"><i class="bi bi-shield-lock me-1"></i>Gölge</span>
                                        }
                                    </div>
                                    <div class="small text-muted" style="font-size: 0.8rem;">
                                        <span>TC: @(string.IsNullOrEmpty(st.User?.TcIdentityNo) ? "-" : st.User.TcIdentityNo)</span>
                                        <span class="mx-1">•</span>
                                        <span>Tel: @(st.User?.PhoneNumber ?? "-")</span>
                                        @if (isRealEmail)
                                        {
                                            <span class="mx-1">•</span>
                                            <span>@st.User?.Email</span>
                                        }
                                    </div>
                                </td>

                                <!-- Şantiye / Proje -->
                                <td>
                                    <a href="/ConstructionProject/Details/@st.ProjectId#headingStakeholders" class="text-decoration-none fw-semibold text-primary" title="Şantiyeye Git">
                                        @st.Project?.Name
                                    </a>
                                </td>

                                <!-- Mülk & Kendine Düşen Pay -->
                                <td>
                                    <span class="fw-bold text-dark">@(string.IsNullOrEmpty(st.UnitNumbers) ? "Belirtilmemiş" : st.UnitNumbers)</span>
                                    <span class="badge bg-light text-dark border ms-1">@(string.IsNullOrEmpty(st.ShareRatio) ? "1 Kişi (Tam)" : st.ShareRatio)</span>
                                </td>

                                <!-- Kira Başlangıç & Ödeme Günü -->
                                <td>
                                    <div>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-calendar-event text-primary me-1"></i>Her ayın @(st.PaymentDay ?? 5). günü
                                        </span>
                                    </div>
                                    <div class="small text-muted mt-1" style="font-size:0.75rem;">
                                        @if (st.RentStartDate.HasValue)
                                        {
                                            <span><i class="bi bi-play-circle text-success me-1"></i>Başlangıç: <strong>@st.RentStartDate.Value.ToString("dd.MM.yyyy")</strong></span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-play-circle text-muted me-1"></i>Başlangıç: Anında</span>
                                        }
                                        @if (st.RentEndDate.HasValue)
                                        {
                                            <span class="d-block"><i class="bi bi-flag text-danger me-1"></i>Taahhüt: <strong>@st.RentEndDate.Value.ToString("dd.MM.yyyy")</strong></span>
                                        }
                                    </div>
                                </td>

                                <!-- Aylık Kira Yardımı (Tam Sayı / Virgülsüz) -->
                                <td class="text-end fw-bold text-success font-monospace">
                                    @((st.MonthlyRentAllowance ?? 0m).ToString("N0")) ₺
                                </td>

                                <!-- Taşınma Yardımı (Tam Sayı / Virgülsüz) -->
                                <td class="text-end font-monospace">
                                    @if (isRelocationPaid)
                                    {
                                        <span class="text-decoration-line-through text-muted small me-1">@((st.RelocationAllowance ?? 0m).ToString("N0")) ₺</span>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success" style="font-size:0.7rem;"><i class="bi bi-check2"></i> Ödendi</span>
                                    }
                                    else if ((st.RelocationAllowance ?? 0m) > 0)
                                    {
                                        <span class="fw-bold text-warning">@((st.RelocationAllowance ?? 0m).ToString("N0")) ₺</span>
                                        <small class="d-block text-muted" style="font-size: 0.7rem;">(1 Seferlik)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- Banka & IBAN -->
                                <td>
                                    @if (!string.IsNullOrEmpty(st.Iban))
                                    {
                                        <div>
                                            @if (!string.IsNullOrEmpty(st.BankName))
                                            {
                                                <div class="small fw-semibold text-secondary" style="font-size:0.78rem;">@st.BankName</div>
                                            }
                                            <div class="d-flex align-items-center gap-1 font-monospace small bg-light px-2 py-0 rounded border" style="max-width: 220px; font-size: 0.8rem;">
                                                <span class="text-truncate">@st.Iban</span>
                                                <button type="button" class="btn btn-sm btn-link p-0 text-muted ms-auto" onclick="navigator.clipboard.writeText('@st.Iban'); alert('IBAN kopyalandı');" title="Kopyala">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">IBAN Yok</span>
                                    }
                                </td>

                                <!-- Ödeme Durumu & Butonu -->
                                <td class="text-center">
                                    @if (isPaid)
                                    {
                                        <div class="d-flex align-items-center justify-content-center gap-1 flex-wrap">
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-1">
                                                <i class="bi bi-check2-circle me-1"></i>Ödendi
                                            </span>
                                            @if (!string.IsNullOrEmpty(st.ReceiptUrl))
                                            {
                                                <a href="@st.ReceiptUrl" target="_blank" class="btn btn-sm btn-outline-success p-1 py-0 rounded" title="Kaşeli Banka Dekontunu Aç">
                                                    <i class="bi bi-file-earmark-pdf"></i> Dekont
                                                </a>
                                            }
                                            @if (isSmsSent)
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info px-1 py-0" title="Hak sahibine 'Kiranız Yattı' SMS'i iletildi">
                                                    <i class="bi bi-chat-left-text me-1"></i>SMS
                                                </span>
                                            }
                                        </div>
                                    }
                                    else if (isNotStarted)
                                    {
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary px-2 py-1" title="Kira henüz başlamadı">
                                            <i class="bi bi-hourglass-split me-1"></i>Başlamadı (@(st.RentStartDate?.ToString("dd.MM.yyyy") ?? "Gelecek"))
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-sm"
                                                onclick="openPayModal(@st.Id, '@st.User?.FirstName @st.User?.LastName', '@st.Project?.Name', '@st.Iban', '@st.BankName', @(Math.Round(st.MonthlyRentAllowance ?? 0m)), @(Math.Round(st.RelocationAllowance ?? 0m)), @(isRelocationPaid ? "true" : "false"))">
                                            <i class="bi bi-cash-stack me-1"></i> Öde
                                        </button>
                                    }
                                </td>

                                <!-- İşlemler -->
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary p-1 px-2" 
                                                onclick="openSingleEditModal(@st.Id, @st.ProjectId, '@st.User?.FirstName', '@st.User?.LastName', '@st.User?.TcIdentityNo', '@st.User?.PhoneNumber', '@(isRealEmail ? st.User?.Email : "")', '@st.Iban', '@st.BankName', '@st.UnitNumbers', '@st.ShareRatio', @(Math.Round(st.MonthlyRentAllowance ?? 0m)), @(Math.Round(st.RelocationAllowance ?? 0m)), @(st.PaymentDay ?? 5), '@(st.RentStartDate?.ToString("yyyy-MM-dd") ?? "")', '@(st.RentEndDate?.ToString("yyyy-MM-dd") ?? "")', '@st.Notes')" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-action="DeleteStakeholder" asp-controller="ConstructionProject" method="post" class="d-inline" onsubmit="return confirm('@st.User?.FirstName @st.User?.LastName kaydını silmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="stakeholderId" value="@st.Id" />
                                            <input type="hidden" name="returnUrl" value="/ConstructionProject/Stakeholders" />
                                            <button type="submit" class="btn btn-outline-danger p-1 px-2" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                        <a href="/ConstructionProject/Details/@st.ProjectId#headingStakeholders" class="btn btn-outline-primary p-1 px-2" title="Şantiye Detayı">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle me-1"></i> Henüz kayıtlı hak sahibi / hakediş bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>

                <!-- ALT TOPLAM / ÇIKAN PARA (GRID FOOTER - TAM SAYI & PROJE TAAHHÜT ÖZETİ) -->
                @if (Model != null && Model.Any())
                {
                    <tfoot class="table-light border-top border-2" style="font-size: 0.93rem;">
                        <!-- 1. Satır: Cari Ay / Dönem Çıkış Özeti -->
                        <tr class="fw-bold align-middle">
                            <td colspan="5" class="ps-3 py-2 text-dark">
                                <i class="bi bi-calendar-check me-1 text-primary"></i> CARİ AY DÖNEM ÇIKIŞI
                                <span class="badge bg-light text-secondary border ms-2">@totalCount Hak Sahibi</span>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success ms-1">@paidCount Ödendi</span>
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning ms-1">@pendingCount Ödeme Bekliyor</span>
                                @if (notStartedCount > 0)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary ms-1">@notStartedCount Henüz Başlamadı</span>
                                }
                            </td>
                            <td class="text-end py-2 text-success font-monospace fs-6">
                                @totalRent.ToString("N0") ₺
                            </td>
                            <td class="text-end py-2 text-warning font-monospace fs-6">
                                @totalRelocation.ToString("N0") ₺
                            </td>
                            <td colspan="3" class="text-end pe-3 py-2">
                                <span class="text-muted small me-2">Bu Ay Çıkacak Toplam:</span>
                                <span class="badge bg-dark text-white px-3 py-2 font-monospace fs-6 shadow-sm">
                                    @((totalRent + totalRelocation).ToString("N0")) ₺
                                </span>
                            </td>
                        </tr>

                        <!-- 2. Satır: Proje Genel Taahhüdü (Tüm İnşaat Süresince Çıkacak Toplam Masraf) -->
                        <tr class="align-middle bg-primary bg-opacity-10 border-top">
                            <td colspan="5" class="ps-3 py-2 text-dark">
                                <i class="bi bi-buildings-fill text-primary me-2"></i>
                                <strong class="text-primary">PROJE TOPLAM KİRA & DÖNÜŞÜM TAAHHÜDÜ (Tüm İnşaat Süreci):</strong>
                                <span class="text-muted small ms-1">Sözleşme başlangıcından anahtar teslime kadar çıkacak toplam tahmini bütçe (Gecikme/ilave ay durumunda süre ve tazminat tutarı otomatik güncellenir).</span>
                            </td>
                            <td colspan="5" class="text-end pe-3 py-2">
                                <span class="badge bg-primary text-white px-3 py-2 font-monospace fs-6 shadow-sm">
                                    <i class="bi bi-cash-stack me-1"></i> @totalProjectCommitment.ToString("N0") ₺ Toplam Taahhüt
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 1: YENİ DAİRE & HAK SAHİPLERİ EKLE (PARASI BAŞTA)  -->
<!-- ======================================================== -->
<div class="modal fade" id="batchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="SaveUnitStakeholdersBatch" asp-controller="ConstructionProject" method="post">
                <input type="hidden" name="returnUrl" value="/ConstructionProject/Stakeholders" />

                <div class="modal-header border-bottom py-3 bg-light">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-building-add text-primary me-2"></i> Yeni Daire & Hak Sahipleri Ekle
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="row g-2">
                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-muted">Şantiye / Proje *</label>
                                <select name="projectId" id="batchProjectId" class="form-select form-select-sm fw-semibold" required>
                                    <option value="">-- Şantiye Seçiniz --</option>
                                    @foreach (var p in projects)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Mülk / Daire No *</label>
                                <input type="text" name="unitNumbers" id="batchUnitNumbers" class="form-control form-control-sm fw-bold" placeholder="Örn: Daire 4" required oninput="renderStakeholderCards()" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Dairenin Toplam Aylık Kirası *</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="1" name="totalRent" id="batchTotalRent" class="form-control fw-bold text-success font-monospace" placeholder="Örn: 30000" value="30000" required oninput="renderStakeholderCards()" />
                                    <span class="input-group-text fw-bold">₺</span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small text-muted">Dairenin Toplam Taşınma Bedeli *</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="1" name="totalRelocation" id="batchTotalRelocation" class="form-control fw-bold text-warning font-monospace" placeholder="Örn: 40000" value="40000" required oninput="renderStakeholderCards()" />
                                    <span class="input-group-text fw-bold">₺</span>
                                </div>
                            </div>

                            <div class="col-md-4 mt-2">
                                <label class="form-label fw-bold small text-muted">Kira Başlangıç Tarihi *</label>
                                <input type="date" name="rentStartDate" id="batchRentStartDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-01")" required onchange="calculateBatchEndDate()" />
                                <small class="text-muted" style="font-size:0.7rem;">Tahliye veya ilk kira ayı</small>
                            </div>

                            <div class="col-md-4 mt-2">
