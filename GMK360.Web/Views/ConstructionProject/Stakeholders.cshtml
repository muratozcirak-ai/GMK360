                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-muted">Muhatap Banka & Şube:</label>
                            <input type="text" id="insBankBranch" class="form-control form-control-sm fw-bold" value="T.C. Ziraat Bankası Kadıköy Şube Müdürlüğü'ne" oninput="updatePrintableDoc()" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">Talimat Türü:</label>
                            <select id="insInstructionType" class="form-select form-select-sm fw-semibold" onchange="updatePrintableDoc()">
                                <option value="account">1. Banka Hesabından Transfer Talimatı (Hesaptan Dağıtım)</option>
                                <option value="teller">2. Gişe / Vezne Nakit Dağıtım Talimatı (Kiralık Kasa Bozumu)</option>
                            </select>
                        </div>
                        <div class="col-md-3 text-end pt-3">
                            <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 fw-bold" onclick="window.print()">
                                <i class="bi bi-printer me-1"></i> A4 Yazdır / PDF Al
                            </button>
                        </div>
                    </div>
                </div>

                <!-- YAZDIRILABİLİR RESMİ A4 EVRAK ALANI -->
                <div class="bg-white p-4 border rounded shadow-sm print-area" style="font-family: Arial, sans-serif; color: #111;">
                    <!-- Resmi Başlık -->
                    <div class="text-end text-muted small mb-2">Tarih: @DateTime.Now.ToString("dd.MM.yyyy")</div>
                    <div class="fw-bold fs-5 text-uppercase border-bottom pb-2 mb-3" id="docBankTitle">
                        T.C. ZİRAAT BANKASI KADIKÖY ŞUBE MÜDÜRLÜĞÜ'NE
                    </div>

                    <!-- Talimat Metni -->
                    <p class="mb-3" style="line-height: 1.6; font-size: 0.95rem;" id="docBodyText">
                        Şirketimiz bünyesinde yürütülmekte olan Kentsel Dönüşüm projeleri kapsamında, aşağıda adı soyadı, T.C. kimlik numarası, banka ve IBAN bilgileri yer alan hak sahiplerine ait kira desteği ve hakediş tutarlarının belirtilen açıklama formatıyla transfer edilmesini arz ve talep ederiz.
                    </p>

                    <!-- Sıralı Hak Sahipleri Tablosu -->
                    <table class="table table-bordered table-sm align-middle mb-3" style="font-size: 0.88rem; border-color: #333;">
                        <thead class="table-light text-dark fw-bold text-center">
                            <tr>
                                <th style="width: 35px;">No</th>
                                <th>Hak Sahibi Adı Soyadı</th>
                                <th style="width: 110px;">T.C. Kimlik No</th>
                                <th>Alıcı Banka</th>
                                <th>Alıcı IBAN Numarası</th>
                                <th class="text-end" style="width: 110px;">Tutar (₺)</th>
                                <th>Dekont Açıklaması</th>
                            </tr>
                        </thead>
                        <tbody id="insDocTableBody"></tbody>
                        <tfoot class="fw-bold table-light">
                            <tr>
                                <td colspan="5" class="text-end pe-2">TOPLAM ÖDENECEK HAKEDİŞ TUTARI:</td>
                                <td class="text-end text-primary font-monospace fs-6" id="docTotalAmountCell">0 ₺</td>
                                <td class="small fst-italic" id="docAmountInWords">Yalnız: ...</td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Yetkili Kaşe & İmza Bloğu -->
                    <div class="row mt-5 pt-3">
                        <div class="col-6">
                            <div class="small text-muted">İşlemi Yapan / Teslim Eden Yetkili:</div>
                            <div class="fw-bold mt-1">Firma Yetkilisi / Şantiye Muhasebesi</div>
                            <div class="text-muted small mt-4">İmza: _______________________</div>
                        </div>
                        <div class="col-6 text-end">
                            <div class="small text-muted">Şirket Kaşesi & Yetkili İmzası:</div>
                            <div class="mt-4"><span class="border border-dark px-4 py-3 text-muted small">[ Şirket Kaşesi ]</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top py-3 d-print-none">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> A4 Yazdır / PDF Olarak Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        #printableInstructionArea, #printableInstructionArea .print-area, #printableInstructionArea .print-area * {
            visibility: visible;
        }
        #printableInstructionArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
        }
        .d-print-none {
            display: none !important;
        }
    }
</style>

<script>
    // ----------------------------------------------------
    // CHECKBOX & ÇOKLU SEÇİM YÖNETİMİ
    // ----------------------------------------------------
    function onStakeholderCheckboxChange() {
        const checkboxes = document.querySelectorAll('.stakeholder-chk');
        const checkedList = document.querySelectorAll('.stakeholder-chk:checked');
        const count = checkedList.length;

        let totalPayable = 0;
        checkedList.forEach(chk => {
            totalPayable += parseFloat(chk.getAttribute('data-total')) || 0;
        });
        totalPayable = Math.round(totalPayable);

        const btnBatch = document.getElementById('btnBatchPay');
        const btnInstruction = document.getElementById('btnBankInstruction');
        const countBadge = document.getElementById('batchPayCountBadge');
        const totalBadge = document.getElementById('batchPayTotalBadge');
        const instructionCountBadge = document.getElementById('instructionCountBadge');
        const statusText = document.getElementById('selectionStatusText');

        if (count > 0) {
            btnBatch.classList.remove('d-none');
            btnInstruction.classList.remove('d-none');
            countBadge.innerText = count;
            instructionCountBadge.innerText = count;
            totalBadge.innerText = totalPayable.toLocaleString('tr-TR');
            if (statusText) statusText.innerText = count + ' hak sahibi seçildi. Toplam ödenecek tutar: ' + totalPayable.toLocaleString('tr-TR') + ' ₺';
        } else {
            btnBatch.classList.add('d-none');
            btnInstruction.classList.add('d-none');
            if (statusText) statusText.innerText = 'Tablodan hak sahiplerini seçerek tek seferde toplu ödeme yapabilir veya banka memuruna verilecek talimat çıktısı alabilirsiniz.';
        }

        const selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) {
            selectAll.checked = (checkboxes.length > 0 && checkedList.length === checkboxes.length);
        }
    }

    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.stakeholder-chk');
        checkboxes.forEach(chk => {
            chk.checked = master.checked;
        });
        onStakeholderCheckboxChange();
    }

    function selectAllEligible() {
        const checkboxes = document.querySelectorAll('.stakeholder-chk');
        checkboxes.forEach(chk => chk.checked = true);
        onStakeholderCheckboxChange();
    }

    function clearAllSelections() {
        const checkboxes = document.querySelectorAll('.stakeholder-chk');
        checkboxes.forEach(chk => chk.checked = false);
        const selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) selectAll.checked = false;
        onStakeholderCheckboxChange();
    }

    function toggleFxContainer(selectId, containerId) {
        const val = document.getElementById(selectId).value;
        const cont = document.getElementById(containerId);
        if (val.includes('Kiralık Kasası')) {
            cont.classList.remove('d-none');
        } else {
            cont.classList.add('d-none');
        }
    }

    // ----------------------------------------------------
    // RESMİ BANKA TALİMATI / GİŞE LİSTESİ YAZDIRMA
    // ----------------------------------------------------
    function openBankInstructionModal() {
        const checkedList = document.querySelectorAll('.stakeholder-chk:checked');
        if (checkedList.length === 0) {
            alert('Lütfen en az bir hak sahibi seçiniz.');
            return;
        }

        let total = 0;
        let rowsHtml = '';
        let rowIdx = 1;

        checkedList.forEach(chk => {
            const name = chk.getAttribute('data-name');
            const tc = chk.getAttribute('data-tc') || '-';
            const bank = chk.getAttribute('data-bank') || '-';
            const iban = chk.getAttribute('data-iban') || 'IBAN Belirtilmemiş';
            const project = chk.getAttribute('data-project');
            const unit = chk.getAttribute('data-unit') || 'Daire';
            const amount = Math.round(parseFloat(chk.getAttribute('data-total')) || 0);
            total += amount;

            const desc = `${project} ${unit} Kira Desteği`;

            rowsHtml += `
                <tr>
                    <td class="text-center">${rowIdx++}</td>
                    <td class="fw-bold">${name}</td>
                    <td class="text-center font-monospace">${tc}</td>
                    <td>${bank}</td>
                    <td class="font-monospace small">${iban}</td>
                    <td class="text-end fw-bold font-monospace">${amount.toLocaleString('tr-TR')} ₺</td>
                    <td class="small text-muted">${desc}</td>
                </tr>
            `;
        });

        document.getElementById('insDocTableBody').innerHTML = rowsHtml;
        document.getElementById('docTotalAmountCell').innerText = total.toLocaleString('tr-TR') + ' ₺';
        document.getElementById('docAmountInWords').innerText = `Yalnız: #${total.toLocaleString('tr-TR')} Türk Lirası#`;

        updatePrintableDoc();
        var myModal = new bootstrap.Modal(document.getElementById('bankInstructionModal'));
        myModal.show();
    }

    function updatePrintableDoc() {
        const bankTitle = document.getElementById('insBankBranch').value.trim() || 'T.C. ZİRAAT BANKASI MÜDÜRLÜĞÜ\'NE';
        document.getElementById('docBankTitle').innerText = bankTitle.toUpperCase();

        const type = document.getElementById('insInstructionType').value;
        const bodyText = document.getElementById('docBodyText');

        if (type === 'teller') {
            bodyText.innerHTML = `Şirketimiz yetkilisi tarafından veznenize / gişenize <strong>elden nakit olarak teslim edilen</strong> toplam hakediş tutarının; aşağıda kimlik, banka ve IBAN bilgileri belirtilen hak sahiplerinin hesaplarına belirtilen açıklamalarla gişeden transfer edilerek onaylı dekontlarının tarafımıza teslim edilmesini arz ve talep ederiz.`;
        } else {
            bodyText.innerHTML = `Şirketimiz bünyesinde yürütülmekte olan Kentsel Dönüşüm projeleri kapsamında, <strong>firmamıza ait banka hesabımızdan</strong> aşağıda adı soyadı, T.C. kimlik numarası, banka ve IBAN bilgileri yer alan hak sahiplerine ait kira desteği ve hakediş tutarlarının belirtilen açıklama formatıyla transfer edilmesini arz ve talep ederiz.`;
        }
    }

    // ----------------------------------------------------
    // TOPLU ÖDEME MODALI
    // ----------------------------------------------------
    function openBatchPayModal() {
        const checkedList = document.querySelectorAll('.stakeholder-chk:checked');
        if (checkedList.length === 0) {
            alert('Lütfen en az bir hak sahibi seçiniz.');
            return;
        }

        let totalAmount = 0;
        let hiddenInputs = '';
        let listHtml = '';

        checkedList.forEach(chk => {
            const id = chk.value;
            const name = chk.getAttribute('data-name');
            const project = chk.getAttribute('data-project');
            const unit = chk.getAttribute('data-unit') || 'Daire';
            const iban = chk.getAttribute('data-iban');
            const bank = chk.getAttribute('data-bank');
            const total = Math.round(parseFloat(chk.getAttribute('data-total')) || 0);

            totalAmount += total;
            hiddenInputs += `<input type="hidden" name="stakeholderIds" value="${id}" />`;

            listHtml += `
                <tr class="border-bottom">
                    <td class="ps-2 fw-semibold">${name}</td>
                    <td class="small text-muted">${project} (${unit})</td>
                    <td class="font-monospace small text-muted">${bank ? bank + ' - ' : ''}${iban ? iban : 'IBAN Yok'}</td>
                    <td class="text-end pe-2 fw-bold text-success font-monospace">${total.toLocaleString('tr-TR')} ₺</td>
                </tr>
            `;
        });

        document.getElementById('batchPayHiddenInputsContainer').innerHTML = hiddenInputs;
        document.getElementById('batchModalSelectedListBody').innerHTML = listHtml;
        document.getElementById('batchModalPersonCount').innerText = checkedList.length;
        document.getElementById('batchModalTotalAmountBadge').innerText = totalAmount.toLocaleString('tr-TR') + ' ₺';
        document.getElementById('batchModalTotalAmountInput').value = totalAmount;
        document.getElementById('batchSubmitBtnText').innerText = checkedList.length + ' Kişi İçin ' + totalAmount.toLocaleString('tr-TR') + ' ₺ Ödemeyi Gerçekleştir';

        toggleFxContainer('batchSourceAccount', 'batchFxContainer');
        var myModal = new bootstrap.Modal(document.getElementById('batchPayModal'));
        myModal.show();
    }

    // ----------------------------------------------------
    // DİNAMİK KİŞİ KARTLARI OLUŞTURMA (PARASI BAŞTA & EŞİT BÖLÜNÜR)
    // ----------------------------------------------------
    function calculateBatchEndDate() {
        const startDateVal = document.getElementById('batchRentStartDate').value;
        const months = parseInt(document.getElementById('batchCommitmentMonths').value) || 18;
        if (!startDateVal) return;

        const d = new Date(startDateVal);
        d.setMonth(d.getMonth() + months);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        document.getElementById('batchRentEndDate').value = `${yyyy}-${mm}-${dd}`;
    }

    function renderStakeholderCards() {
        const unitNo = document.getElementById('batchUnitNumbers').value.trim() || 'Daire';
        const totalRent = Math.round(parseFloat(document.getElementById('batchTotalRent').value) || 0);
        const totalReloc = Math.round(parseFloat(document.getElementById('batchTotalRelocation').value) || 0);
        let count = parseInt(document.getElementById('batchShareCount').value) || 1;
        if (count < 1) count = 1;
        if (count > 20) count = 20;

        const perPersonRent = Math.round(totalRent / count);
        const perPersonReloc = Math.round(totalReloc / count);

        const summaryText = count === 1 
            ? unitNo + ': 1 Kişi (Tam Hisse) — Aylık Kira: ' + perPersonRent.toLocaleString('tr-TR') + ' ₺ | Taşınma: ' + perPersonReloc.toLocaleString('tr-TR') + ' ₺'
            : unitNo + ': ' + count + ' Hissedar (Kişi Başı 1/' + count + ') — Kişi Başı Aylık Kira: ' + perPersonRent.toLocaleString('tr-TR') + ' ₺ | Kişi Başı Taşınma: ' + perPersonReloc.toLocaleString('tr-TR') + ' ₺';

        document.getElementById('batchSummaryText').innerText = summaryText;

        const container = document.getElementById('stakeholdersCardsContainer');
        const existingData = [];
        const existingCards = container.querySelectorAll('.stakeholder-card');
        existingCards.forEach((c) => {
            existingData.push({
                fName: c.querySelector('.f-name')?.value || '',
                lName: c.querySelector('.l-name')?.value || '',
                tc: c.querySelector('.f-tc')?.value || '',
                phone: c.querySelector('.f-phone')?.value || '',
                email: c.querySelector('.f-email')?.value || '',
                bank: c.querySelector('.f-bank')?.value || '',
                iban: c.querySelector('.f-iban')?.value || ''
            });
        });

        let html = '';
        for (let i = 0; i < count; i++) {
            const cur = existingData[i] || { fName: '', lName: '', tc: '', phone: '', email: '', bank: '', iban: '' };
            const cardTitle = count === 1 
                ? 'Hak Sahibi Bilgileri' 
                : (i + 1) + '. Hak Sahibi (1/' + count + ' Hisse — ' + perPersonRent.toLocaleString('tr-TR') + ' ₺ Kira | ' + perPersonReloc.toLocaleString('tr-TR') + ' ₺ Taşınma)';

            html += `
            <div class="card p-3 mb-3 border rounded-3 stakeholder-card bg-white shadow-sm">
                <div class="fw-bold text-primary border-bottom pb-2 mb-2 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-fill me-1"></i>${cardTitle}</span>
                    <span class="badge bg-light text-dark border font-monospace">${perPersonRent.toLocaleString('tr-TR')} ₺/ay</span>
                </div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Adı *</label>
                        <input type="text" name="firstNames" class="form-control form-control-sm f-name" required placeholder="Örn: Ahmet" value="${cur.fName}" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Soyadı *</label>
                        <input type="text" name="lastNames" class="form-control form-control-sm l-name" required placeholder="Örn: Yılmaz" value="${cur.lName}" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">TC Kimlik No</label>
                        <input type="text" name="tcIdentityNos" class="form-control form-control-sm f-tc" maxlength="11" placeholder="11 haneli TC" value="${cur.tc}" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Telefon No *</label>
                        <input type="tel" name="phones" class="form-control form-control-sm f-phone" required placeholder="05XXXXXXXXX" value="${cur.phone}" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">E-posta Adresi</label>
                        <input type="email" name="emails" class="form-control form-control-sm f-email" placeholder="ornek@alanadi.com" value="${cur.email}" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Banka Adı</label>
                        <input type="text" name="bankNames" class="form-control form-control-sm f-bank" placeholder="Örn: Ziraat, Garanti" value="${cur.bank}" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small text-muted mb-1">IBAN Numarası</label>
                        <input type="text" name="ibans" class="form-control form-control-sm font-monospace f-iban" placeholder="TR00 0000 0000 0000 0000 0000 00" value="${cur.iban}" />
                    </div>
                </div>
            </div>
            `;
        }

        container.innerHTML = html;
        document.getElementById('btnSaveBatch').innerHTML = '<i class="bi bi-check2-circle me-1"></i> ' + unitNo + ' ve ' + count + ' Hak Sahibini Kaydet';
    }

    function openBatchAddModal() {
        document.getElementById('batchUnitNumbers').value = '';
        document.getElementById('batchTotalRent').value = '30000';
        document.getElementById('batchTotalRelocation').value = '40000';
        document.getElementById('batchShareCount').value = '1';
        calculateBatchEndDate();
        renderStakeholderCards();
    }

    // ----------------------------------------------------
    // TEK KİŞİ DÜZENLE MODALI
    // ----------------------------------------------------
    function openSingleEditModal(id, projectId, first, last, tc, phone, email, iban, bankName, units, share, rent, relocation, paymentDay, rentStartDate, rentEndDate, notes) {
        document.getElementById('editModalTitle').innerHTML = '<i class="bi bi-pencil-square text-primary me-2"></i> Hak Sahibi Düzenle: ' + first + ' ' + last;
        document.getElementById('editStakeholderId').value = id;
        document.getElementById('editProjectId').value = projectId;
        document.getElementById('editFirstName').value = first;
        document.getElementById('editLastName').value = last;
        document.getElementById('editTc').value = (tc && tc !== 'null') ? tc : '';
        document.getElementById('editPhone').value = (phone && phone !== 'null') ? phone : '';
        document.getElementById('editEmail').value = (email && email !== 'null') ? email : '';
        document.getElementById('editUnitNumbers').value = (units && units !== 'null') ? units : '';
        document.getElementById('editPaymentDay').value = (paymentDay && paymentDay !== 'null') ? paymentDay : '5';
        document.getElementById('editRentStartDate').value = (rentStartDate && rentStartDate !== 'null') ? rentStartDate : '';
        document.getElementById('editRentEndDate').value = (rentEndDate && rentEndDate !== 'null') ? rentEndDate : '';
        document.getElementById('editBankName').value = (bankName && bankName !== 'null') ? bankName : '';
        document.getElementById('editIban').value = (iban && iban !== 'null') ? iban : '';
        document.getElementById('editRent').value = Math.round(rent);
        document.getElementById('editRelocation').value = Math.round(relocation);
        document.getElementById('editNotes').value = (notes && notes !== 'null') ? notes : '';

        var myModal = new bootstrap.Modal(document.getElementById('singleEditModal'));
        myModal.show();
    }

    // ----------------------------------------------------
    // TEKİL ÖDEME MODALI
    // ----------------------------------------------------
    let currentRent = 0;
    let currentRelocation = 0;

    function openPayModal(id, name, project, iban, bank, rent, relocation, isRelocationPaid) {
        document.getElementById('payStakeholderId').value = id;
        document.getElementById('payPersonName').innerText = name;
        document.getElementById('payProjectName').innerText = project;
        document.getElementById('payIbanInfo').innerText = (bank ? bank + ' | ' : '') + (iban ? iban : 'IBAN Girilmemiş');

        currentRent = Math.round(parseFloat(rent) || 0);
        currentRelocation = Math.round(parseFloat(relocation) || 0);

        document.getElementById('lblRentAmount').innerText = currentRent.toLocaleString('tr-TR') + ' ₺';
        document.getElementById('lblRelocationAmount').innerText = currentRelocation.toLocaleString('tr-TR') + ' ₺';

        document.getElementById('chkPayRent').checked = true;

        const relCheckbox = document.getElementById('chkPayRelocation');
        const relRow = document.getElementById('relocationRow');
        const relPaidNotice = document.getElementById('relocationAlreadyPaidNotice');

        if (isRelocationPaid) {
            relCheckbox.checked = false;
            relCheckbox.disabled = true;
            relPaidNotice.classList.remove('d-none');
            relRow.classList.add('opacity-50');
        } else {
            relCheckbox.checked = currentRelocation > 0;
            relCheckbox.disabled = false;
            relPaidNotice.classList.add('d-none');
            relRow.classList.remove('opacity-50');
        }

        recalcPayAmount();
        toggleFxContainer('singleSourceAccount', 'singleFxContainer');
        var myModal = new bootstrap.Modal(document.getElementById('payModal'));
        myModal.show();
    }

    function recalcPayAmount() {
        let total = 0;
        if (document.getElementById('chkPayRent').checked) {
            total += currentRent;
        }
        if (document.getElementById('chkPayRelocation').checked && !document.getElementById('chkPayRelocation').disabled) {
            total += currentRelocation;
        }
        total = Math.round(total);
        document.getElementById('lblTotalPayAmount').innerText = total.toLocaleString('tr-TR') + ' ₺';
        document.getElementById('txtTotalPayAmount').value = total;
    }
</script>
