@model IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>

@{
    ViewData["Title"] = "İnşaat Projelerim";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-buildings text-primary me-2"></i>İnşaat Projelerim</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="bi bi-plus-lg me-2"></i> Yeni Proje Ekle
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                {
                    <img src="@item.CoverImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="bi bi-image fs-1 opacity-50"></i>
                    </div>
                }
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title fw-bold mb-0">@item.Name</h5>
                        @if (item.Status == 0)
                        {
                            <span class="badge bg-warning text-dark">Yakında Başlayacak</span>
                        }
                        else if (item.Status == 1)
                        {
                            <span class="badge bg-primary">Devam Ediyor</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Tamamlandı</span>
                        }
                    </div>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i>@item.Address</p>
                    
                    <div class="d-flex justify-content-between text-muted small mb-4">
                        <div>
                            <i class="bi bi-calendar-event me-1"></i> Başlangıç: <br>
                            <strong>@item.StartDate.ToString("dd.MM.yyyy")</strong>
                        </div>
                        <div class="text-end">
                            <i class="bi bi-check2-circle me-1"></i> Bitiş: <br>
                            <strong>@(item.EndDate?.ToString("dd.MM.yyyy") ?? "Belirsiz")</strong>
                        </div>
                    </div>
                    
                    <div class="border-top pt-3 d-flex justify-content-between">
                        <span class="text-muted small fw-bold">@(item.Phases?.Count ?? 0) Aşama</span>
                        <div>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu projeyi ve ona bağlı tüm blokları tamamen silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill me-1"><i class="bi bi-trash"></i></button>
                            </form>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary rounded-pill">Yönet</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info border-0 rounded-4 p-4 text-center">
                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                Kayıtlı hiçbir inşaat projeniz bulunmuyor. Sağ üstten yeni bir proje ekleyebilirsiniz.
            </div>
        </div>
    }
</div>
