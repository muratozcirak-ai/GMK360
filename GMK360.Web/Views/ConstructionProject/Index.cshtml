@{
    ViewData["Title"] = "Ýnþaat Projelerim";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    var aktifProjeler = ViewBag.AktifProjeler as List<GMK360.Core.Entities.Construction.ConstructionProject> ?? new List<GMK360.Core.Entities.Construction.ConstructionProject>();
    var teklifler = ViewBag.Teklifler as List<GMK360.Core.Entities.Construction.ConstructionProject> ?? new List<GMK360.Core.Entities.Construction.ConstructionProject>();
    var tamamlananlar = ViewBag.Tamamlananlar as List<GMK360.Core.Entities.Construction.ConstructionProject> ?? new List<GMK360.Core.Entities.Construction.ConstructionProject>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-buildings text-primary me-2"></i>Ýnþaat Projelerim</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="bi bi-plus-lg me-2"></i> Yeni Proje Ekle
    </a>
</div>

<!-- Sekme Baþlýklarý -->
<ul class="nav nav-pills nav-fill bg-white p-2 rounded-pill shadow-sm mb-4" id="projectTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active rounded-pill fw-bold" data-bs-toggle="pill" data-bs-target="#aktif" type="button" role="tab">
        <i class="bi bi-cone-striped me-2"></i>Aktif Þantiyeler <span class="badge bg-light text-primary ms-2">@aktifProjeler.Count</span>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link rounded-pill fw-bold" data-bs-toggle="pill" data-bs-target="#teklif" type="button" role="tab">
        <i class="bi bi-file-earmark-text me-2"></i>Teklif & Hazýrlýk <span class="badge bg-light text-primary ms-2">@teklifler.Count</span>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link rounded-pill fw-bold" data-bs-toggle="pill" data-bs-target="#tamamlanan" type="button" role="tab">
        <i class="bi bi-check-circle me-2"></i>Tamamlananlar (Referans) <span class="badge bg-light text-primary ms-2">@tamamlananlar.Count</span>
    </button>
  </li>
</ul>

<!-- Sekme Ýçerikleri -->
<div class="tab-content" id="projectTabsContent">
  
  <!-- Aktif Þantiyeler -->
  <div class="tab-pane fade show active" id="aktif" role="tabpanel">
      <div class="row g-4">
          @if (!aktifProjeler.Any()) { <div class="col-12 text-center py-5 text-muted">Kayýtlý aktif þantiye bulunmuyor.</div> }
          @foreach (var item in aktifProjeler) { @await Html.PartialAsync("_ProjectCardPartial", item) }
      </div>
  </div>

  <!-- Teklifler -->
  <div class="tab-pane fade" id="teklif" role="tabpanel">
      <div class="row g-4">
          @if (!teklifler.Any()) { <div class="col-12 text-center py-5 text-muted">Görüþmesi devam eden proje bulunmuyor.</div> }
          @foreach (var item in teklifler) { @await Html.PartialAsync("_ProjectCardPartial", item) }
      </div>
  </div>

  <!-- Tamamlananlar -->
  <div class="tab-pane fade" id="tamamlanan" role="tabpanel">
      <div class="row g-4">
          @if (!tamamlananlar.Any()) { <div class="col-12 text-center py-5 text-muted">Tamamlanan referans proje bulunmuyor.</div> }
          @foreach (var item in tamamlananlar) { @await Html.PartialAsync("_ProjectCardPartial", item) }
      </div>
  </div>
  
</div>
