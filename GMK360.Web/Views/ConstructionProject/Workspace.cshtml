                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">E-Posta</label>
                        <input type="email" name="email" id="modalEmail" class="form-control rounded-3" placeholder="ortak@firma.com" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">Ortaklık Sözleşmesi / Evrak <small class="text-secondary">(İsteğe Bağlı)</small></label>
                        <input type="file" name="contractFile" id="modalContractFile" class="form-control rounded-3" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                        <div id="modalExistingDocInfo" class="small text-muted mt-1" style="display: none;"></div>
                    </div>
