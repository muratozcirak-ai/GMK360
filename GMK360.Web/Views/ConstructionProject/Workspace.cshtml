    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="SaveProjectPartner" asp-controller="ConstructionProject" method="post" enctype="multipart/form-data" id="partnerModalForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="partnerId" id="modalPartnerId" value="" />

                <div class="modal-header border-bottom py-3 bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="partnerModalLabel">
                        <i class="bi bi-person-plus-fill text-primary me-2"></i> Yeni Ortak Ekle
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Firma Ünvanı <small class="text-secondary">(Varsa / Şahıssa Boş Bırakın)</small></label>
                        <input type="text" name="companyName" id="modalCompanyName" class="form-control rounded-3" placeholder="Örn: Denge İnşaat Ltd. Şti." />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Ortağın Adı <span class="text-danger">*</span></label>
                            <input type="text" name="firstName" id="modalFirstName" class="form-control rounded-3" placeholder="Örn: Ahmet" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Ortağın Soyadı</label>
                            <input type="text" name="lastName" id="modalLastName" class="form-control rounded-3" placeholder="Örn: Karakaya" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Hisse Oranı (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white fw-bold">%</span>
                                <input type="number" name="sharePercentage" id="modalSharePercentage" class="form-control fw-bold text-danger fs-5" min="1" max="100" step="1" placeholder="30" required />
