<!-- HARİTA SEÇİM MODALI (LEAFLET OSM) -->
<div class="modal fade" id="mapModal" tabindex="-1" aria-labelledby="mapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3 bg-light">
                <h5 class="modal-title fw-bold text-dark" id="mapModalLabel">
                    <i class="bi bi-geo-alt-fill text-danger me-2"></i> Harita Üzerinden Konum Belirle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <p class="text-muted small mb-0">
                        İşaretçiyi arsanın üzerine bırakıp <b>TKGM MEGSİS</b> butonuna basarak arsanın resmi sınır çizgisini ve m² bilgisini anında görebilirsiniz.
                    </p>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold shadow-xs" onclick="queryTkgmInMapModal()" id="btnMapModalTkgm">
                        <i class="bi bi-crosshair me-1"></i> TKGM Kadastro Parselini Çiz
                    </button>
                </div>
                <div id="mapModalTkgmInfo" class="alert alert-info py-2 px-3 small rounded-3 mb-2" style="display: none;"></div>
                <div id="projectMap" style="height: 420px; width: 100%; border-radius: 12px;" class="border"></div>
            </div>
            <div class="modal-footer border-top py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                    <i class="bi bi-check2 me-1"></i> Bu Konumu Kullan
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    // 1. Proje Niteliği (Kentsel Dönüşüm vs Boş Arsa) Akıllı Alan Açma/Kapatma
    function toggleOriginFields() {
        var isKentsel = document.getElementById('originKentsel').checked;
        var section = document.getElementById('kentselDonusumSection');
        var lblImage = document.getElementById('lblCurrentStateImage');

        if (isKentsel) {
            section.style.display = 'block';
            if (lblImage) lblImage.innerText = 'Yıkılacak Eski Yapı Görseli (Portföy)';
        } else {
            section.style.display = 'none';
            if (lblImage) lblImage.innerText = 'Arsa / Saha Görseli (Boş Hali)';
        }
    }

    // 2. Tahmini Destek Rozetlerini Daire Adedine Senkronize Etme
    function syncDestekCounts() {
        var count = document.getElementById('eskiDaireInput').value || 0;
        var badgeKira = document.getElementById('badgeKiraDesteği');
        var badgeTasinma = document.getElementById('badgeTasinmaDesteği');
        if (badgeKira) badgeKira.innerText = count + ' Daire / Kişi';
        if (badgeTasinma) badgeTasinma.innerText = count + ' Daire';
    }

    // 3. Konum Cascading Dropdowns (İl -> İlçe -> Mahalle -> Sokak)
    document.addEventListener("DOMContentLoaded", function() {
        var cpCity = document.getElementById('CityId');
        var cpDist = document.getElementById('DistrictId');
        var cpNeigh = document.getElementById('NeighborhoodId');
        var cpStreet = document.getElementById('StreetId');

        if (cpCity) {
            cpCity.addEventListener('change', function() {
                var cityId = this.value;
                cpDist.innerHTML = '<option value="">Yükleniyor...</option>';
                if (cpNeigh) cpNeigh.innerHTML = '<option value="">Önce İlçe Seçin</option>';
                if (cpStreet) cpStreet.innerHTML = '<option value="">Önce Mahalle Seçin</option>';

                if (!cityId) {
                    cpDist.innerHTML = '<option value="">İlçe Seçin</option>';
                    return;
                }

                fetch('/api/Location/Districts/' + cityId)
                    .then(res => res.json())
                    .then(data => {
                        cpDist.innerHTML = '<option value="">İlçe Seçin</option>';
                        if (data && data.length > 0) {
                            data.forEach(d => {
                                cpDist.innerHTML += `<option value="${d.id}">${d.name}</option>`;
                            });
                        }
                    })
                    .catch(() => {
                        cpDist.innerHTML = '<option value="">Hata Oluştu</option>';
                    });
            });
        }

        if (cpDist) {
            cpDist.addEventListener('change', function() {
                var distId = this.value;
                if (cpNeigh) cpNeigh.innerHTML = '<option value="">Yükleniyor...</option>';
                if (cpStreet) cpStreet.innerHTML = '<option value="">Önce Mahalle Seçin</option>';

                if (!distId) {
                    if (cpNeigh) cpNeigh.innerHTML = '<option value="">Mahalle Seçin</option>';
                    return;
                }

                fetch('/api/Location/Neighborhoods/' + distId)
                    .then(res => res.json())
                    .then(data => {
                        if (cpNeigh) {
                            cpNeigh.innerHTML = '<option value="">Mahalle Seçin</option>';
                            if (data && data.length > 0) {
                                data.forEach(n => {
                                    cpNeigh.innerHTML += `<option value="${n.id}">${n.name}</option>`;
                                });
                            }
                        }
                    })
                    .catch(() => {
                        if (cpNeigh) cpNeigh.innerHTML = '<option value="">Hata Oluştu</option>';
                    });
            });
        }

        if (cpNeigh) {
            cpNeigh.addEventListener('change', function() {
                var neighId = this.value;
                if (cpStreet) cpStreet.innerHTML = '<option value="">Yükleniyor...</option>';

                if (!neighId) {
                    if (cpStreet) cpStreet.innerHTML = '<option value="">Sokak Seçin</option>';
                    return;
                }

                fetch('/api/Location/Streets/' + neighId)
                    .then(res => res.json())
                    .then(data => {
                        if (cpStreet) {
                            cpStreet.innerHTML = '<option value="">Sokak Seçin</option>';
                            if (data && data.length > 0) {
                                data.forEach(s => {
                                    cpStreet.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                                });
                            }
                        }
                    })
                    .catch(() => {
                        if (cpStreet) cpStreet.innerHTML = '<option value="">Hata Oluştu</option>';
                    });
            });
        }
    });

    // 4. Leaflet Harita Entegrasyonu
    let kunyeMap, kunyeMarker;

    function openMapModal() {
        var mapModal = new bootstrap.Modal(document.getElementById('mapModal'));
        mapModal.show();

        var initialLat = parseFloat(document.getElementById('latInput').value) || 41.0082;
        var initialLng = parseFloat(document.getElementById('lngInput').value) || 28.9784;

        setTimeout(() => {
            if (!kunyeMap) {
                kunyeMap = L.map('projectMap').setView([initialLat, initialLng], 16);
                var satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '© Esri & TKGM'
                });
                var street = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap'
                });
                satellite.addTo(kunyeMap);
                L.control.layers({
                    "🛰️ Uydu": satellite,
                    "🗺️ Sokak": street
                }).addTo(kunyeMap);

                kunyeMarker = L.marker([initialLat, initialLng], { draggable: true }).addTo(kunyeMap);

                kunyeMarker.on('dragend', function (e) {
                    var position = kunyeMarker.getLatLng();
                    document.getElementById('latInput').value = position.lat.toFixed(6);
                    document.getElementById('lngInput').value = position.lng.toFixed(6);
                });

                kunyeMap.on('click', function (e) {
                    kunyeMarker.setLatLng(e.latlng);
                    document.getElementById('latInput').value = e.latlng.lat.toFixed(6);
                    document.getElementById('lngInput').value = e.latlng.lng.toFixed(6);
                });
            } else {
                kunyeMap.invalidateSize();
                kunyeMap.setView([initialLat, initialLng], 14);
                kunyeMarker.setLatLng([initialLat, initialLng]);
            }
        }, 300);
    }

    // 5. Collapse Açma / Kapama Durum Etiketi & İkonu
    var kunyeCollapse = document.getElementById('kunyeCollapse');
    if (kunyeCollapse) {
        kunyeCollapse.addEventListener('hidden.bs.collapse', function () {
            var txt = document.getElementById('collapseText');
            var icon = document.getElementById('collapseIcon');
            if (txt) txt.innerText = 'Genişlet';
            if (icon) icon.className = 'bi bi-chevron-down ms-1';
        });
        kunyeCollapse.addEventListener('shown.bs.collapse', function () {
            var txt = document.getElementById('collapseText');
            var icon = document.getElementById('collapseIcon');
            if (txt) txt.innerText = 'Daralt';
            if (icon) icon.className = 'bi bi-chevron-up ms-1';
        });
    }

    // 6. Proje Temel Bilgileri Autosave (Otomatik Kayıt)
    let autosaveTimer = null;

    function triggerKunyeAutosave() {
        clearTimeout(autosaveTimer);
        var statusEl = document.getElementById('autosaveStatus');
        if (statusEl) {
            statusEl.innerHTML = '<span class="badge bg-warning bg-opacity-10 text-dark border border-warning px-2 py-1"><span class="spinner-border spinner-border-sm me-1" style="width: 0.75rem; height: 0.75rem;" role="status"></span>Kaydediliyor...</span>';
        }
        autosaveTimer = setTimeout(executeKunyeAutosave, 1000);
    }

    function executeKunyeAutosave() {
        var form = document.getElementById('kunyeForm');
        if (!form) return;

        var statusEl = document.getElementById('autosaveStatus');
        var formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        })
        .then(function(data) {
            if (statusEl) {
                var now = new Date();
                var timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                statusEl.innerHTML = '<span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Otomatik Kaydedildi (' + timeStr + ')</span>';
            }
        })
        .catch(function(err) {
            if (statusEl) {
                statusEl.innerHTML = '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1"><i class="bi bi-exclamation-circle me-1"></i>Kayıt Hatası</span>';
            }
        });
    }

    // Form içindeki input, select, textarea öğelerine autosave dinleyicileri bağlama
    var kunyeForm = document.getElementById('kunyeForm');
    if (kunyeForm) {
        var formElements = kunyeForm.querySelectorAll('input:not([type=file]), select, textarea');
        formElements.forEach(function(el) {
            el.addEventListener('change', triggerKunyeAutosave);
            if (el.tagName === 'INPUT' && (el.type === 'text' || el.type === 'number')) {
                el.addEventListener('input', triggerKunyeAutosave);
            }
            if (el.tagName === 'TEXTAREA') {
                el.addEventListener('input', triggerKunyeAutosave);
            }
        });

        // Dosya inputları seçildiğinde beklemeden doğrudan arka planda yüklesin
        var fileInputs = kunyeForm.querySelectorAll('input[type=file]');
        fileInputs.forEach(function(fEl) {
            fEl.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    var statusEl = document.getElementById('autosaveStatus');
                    if (statusEl) {
                        statusEl.innerHTML = '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1"><span class="spinner-border spinner-border-sm me-1" style="width: 0.75rem; height: 0.75rem;" role="status"></span>Dosya Yükleniyor...</span>';
                    }
                    executeKunyeAutosave();
                }
            });
        });
    }
</script>