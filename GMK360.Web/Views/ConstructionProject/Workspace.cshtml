@model GMK360.Core.Entities.Construction.ConstructionProject
@{
    ViewData["Title"] = "Proje Künyesi: " + Model.Name;
    ViewData["ProjectId"] = Model.Id;
    ViewData["ProjectName"] = Model.Name;
    ViewData["ProjectStatus"] = Model.Status;
    Layout = "_ProjectLayout";

    string partnerDisplay = string.IsNullOrWhiteSpace(Model.ProjectOwnerContact) 
        ? "Bayraktar İnşaat (%100 - Ana Yüklenici)" 
        : Model.ProjectOwnerContact;

    bool isKentsel = !Model.ProjectOriginId.HasValue || Model.ProjectOriginId == 1;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<div class="card border-0 shadow-sm rounded-3 bg-white p-2 p-md-3" style="min-height: 500px;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-card-heading text-primary me-1"></i> @Model.Name
                <span class="badge bg-warning text-dark border border-warning px-3 py-1 rounded-pill fw-bold shadow-xs" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <i class="bi bi-hourglass-split me-1"></i> ADAY
                </span>
                <span class="text-muted fw-normal fs-5">— Proje Künyesi</span>
            </h4>
            <div class="text-muted small">Projenin ilk kabul, arsa keşfi ve ön teklif aşaması</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill">
                Proje ID: #@Model.Id
            </span>
            <a href="/ConstructionProject/Feasibility/@Model.Id" class="btn btn-warning text-dark border border-warning rounded-pill px-3 py-1 fw-bold shadow-sm d-flex align-items-center gap-2" title="2. Adım: Hızlı Arsa Ön Etüdü & Simülatör"><i class="bi bi-rulers"></i><span>📐 Hızlı Arsa Ön Etüdü ➔</span></a>
        </div>
    </div>
    <hr class="opacity-25 my-3" />

    <!-- 1 & 1.5 BÖLÜM: PROJE SAHİPLİĞİ VE MUHATAP (YAN YANA KOMPAKT ROW) -->
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="card border border-light-subtle rounded-3 p-2 bg-light h-100 shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-people-fill text-primary"></i>
                        <span class="fw-bold text-dark small" style="font-size: 0.82rem;">Hissedarlar & Ortaklık</span>
                    </div>
                    <button type="button" class="btn btn-outline-primary rounded-pill px-2 py-0 fw-bold btn-sm" style="font-size: 0.72rem;" data-bs-toggle="modal" data-bs-target="#partnerModal">
                        <i class="bi bi-pencil-square me-1"></i>Düzenle
                    </button>
                </div>
                <div class="p-2 bg-white rounded-2 border">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1 rounded-pill fw-bold text-truncate d-inline-block" style="font-size: 0.80rem; max-width: 100%;">
                        <i class="bi bi-building me-1"></i>@partnerDisplay
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border border-light-subtle rounded-3 p-2 bg-light h-100 shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-person-lines-fill text-warning"></i>
                        <span class="fw-bold text-dark small" style="font-size: 0.82rem;">Proje Muhatabı & İrtibat</span>
                    </div>
                    <button type="button" class="btn btn-outline-primary rounded-pill px-2 py-0 fw-bold btn-sm" style="font-size: 0.72rem;" data-bs-toggle="modal" data-bs-target="#contactModal">
                        <i class="bi bi-pencil-square me-1"></i>Düzenle
                    </button>
                </div>
                <div class="p-2 bg-white rounded-2 border">
                    @if (Model.BinaYoneticisi != null && (!string.IsNullOrWhiteSpace(Model.BinaYoneticisi.FirstName) || !string.IsNullOrWhiteSpace(Model.BinaYoneticisi.PhoneNumber)))
                    {
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-1">
                            <span class="badge bg-warning bg-opacity-15 text-dark border border-warning px-2 py-1 rounded-pill fw-bold" style="font-size: 0.78rem;">
                                @(string.IsNullOrWhiteSpace(Model.BinaYoneticisi.ContactType) ? "Muhatap" : Model.BinaYoneticisi.ContactType): @Model.BinaYoneticisi.FirstName @Model.BinaYoneticisi.LastName
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.BinaYoneticisi.PhoneNumber))
                            {
                                <a href="tel:@Model.BinaYoneticisi.PhoneNumber" class="btn btn-outline-success btn-sm rounded-pill px-2 py-0 fw-bold" style="font-size: 0.72rem;">
                                    <i class="bi bi-telephone-fill me-1"></i>@Model.BinaYoneticisi.PhoneNumber
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small py-1" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1 text-secondary"></i>Muhatap belirlenmedi.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 2. BÖLÜM: PROJE TEMEL BİLGİLERİ (ÖN FİZİBİLİTE & TEKLİF AŞAMASI) -->
    <form id="kunyeForm" asp-action="UpdateProjectKunye" asp-controller="ConstructionProject" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-sm overflow-hidden">
            <!-- BAŞLIK & COLLAPSE HEADER -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-2 px-3 bg-light border-bottom" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#kunyeCollapse" aria-expanded="false" aria-controls="kunyeCollapse">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-geo-alt-fill text-white"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Proje Temel Bilgileri</h6>
                        <small class="text-muted" style="font-size: 0.78rem;">Teklif hazırlama, tapu/kadastro ve mevcut saha verileri</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3" onclick="event.stopPropagation();">
                    <!-- AUTOSAVE BİLDİRİMİ -->
                    <div id="autosaveStatus" class="d-flex align-items-center"></div>

                    <!-- COLLAPSE BUTONU -->
                    <button type="button" class="btn btn-sm btn-white border rounded-pill px-3 fw-bold text-secondary d-flex align-items-center gap-1 shadow-xs" data-bs-toggle="collapse" data-bs-target="#kunyeCollapse" aria-expanded="false" aria-controls="kunyeCollapse">
                        <span id="collapseText">Genişlet</span>
                        <i class="bi bi-chevron-down ms-1" id="collapseIcon"></i>
                    </button>
                </div>
            </div>

            <!-- COLLAPSE İÇERİĞİ -->
            <div class="collapse p-2 p-md-3" id="kunyeCollapse">

            <!-- PROJE NİTELİĞİ SEÇİMİ -->
            <div class="mb-4 p-3 rounded-3" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                <label class="form-label fw-bold text-dark mb-2">
                    <i class="bi bi-diagram-3 me-1 text-primary"></i> Proje Niteliği (Proje Kaynağı)
                </label>
                <div class="d-flex gap-4 flex-wrap">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="projectOriginId" id="originKentsel" value="1" @(isKentsel ? "checked" : "") onchange="toggleOriginFields()">
                        <label class="form-check-label fw-bold text-dark" for="originKentsel">
                            🏚️ Kentsel Dönüşüm / Eski Yapı (Yıkım & Yenileme)
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="projectOriginId" id="originBosArsa" value="2" @(!isKentsel ? "checked" : "") onchange="toggleOriginFields()">
                        <label class="form-check-label fw-bold text-dark" for="originBosArsa">
                            🌱 Boş Arsa (Sıfır Yapı / Kat Karşılığı / Özmal)
                        </label>
                    </div>
                </div>
                <div class="form-text text-muted small mt-1">
                    Proje niteliğine göre yıkılacak yapı ve tahmini destek alanları akıllıca açılır veya gizlenir.
                </div>
            </div>

            <!-- PROJE GENEL TANIMI -->
            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label class="form-label fw-bold small text-muted">Proje Adı</label>
                    <input type="text" name="name" class="form-control rounded-3 fw-bold" value="@Model.Name" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Ana Yapı Türü</label>
                    <select name="projectType" class="form-select rounded-3">
                        <option value="Apartman" selected="@(Model.ProjectType == "Apartman")">Apartman</option>
                        <option value="Site / Karma Proje" selected="@(Model.ProjectType == "Site / Karma Proje")">Site / Karma Proje</option>
                        <option value="Müstakil / Villa" selected="@(Model.ProjectType == "Müstakil / Villa")">Müstakil / Villa</option>
                        <option value="İş Merkezi / Ofis" selected="@(Model.ProjectType == "İş Merkezi / Ofis")">İş Merkezi / Ofis</option>
                        <option value="AVM / Ticari Proje" selected="@(Model.ProjectType == "AVM / Ticari Proje")">AVM / Ticari Proje</option>
                        <option value="Sanayi / Fabrika Tesisi" selected="@(Model.ProjectType == "Sanayi / Fabrika Tesisi")">Sanayi / Fabrika Tesisi</option>
                        <option value="Altyapı / Taahhüt İşi" selected="@(Model.ProjectType == "Altyapı / Taahhüt İşi")">Altyapı / Taahhüt İşi</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Proje Statüsü</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="0" selected="@((int)Model.Status == 0)">Ön Görüşme / Fizibilite</option>
                        <option value="1" selected="@((int)Model.Status == 1)">Aday Proje (Teklif)</option>
                        <option value="2" selected="@((int)Model.Status == 2)">Aktif Şantiye (Devam Eden)</option>
                        <option value="3" selected="@((int)Model.Status == 3)">Tamamlandı / Teslim</option>
                        <option value="4" selected="@((int)Model.Status == 4)">Satışta (Topraktan)</option>
                        <option value="5" selected="@((int)Model.Status == 5)">Anlaşma Yapıldı</option>
                        <option value="6" selected="@((int)Model.Status == 6)">İptal / Anlaşma Olmadı</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small text-muted">Kısa Açıklama / Vizyon & Notlar</label>
                    <textarea name="description" class="form-control rounded-3" rows="2" placeholder="Projenin konsepti, arsa sahipleriyle yapılan ilk görüşme notları...">@Model.Description</textarea>
                </div>
            </div>

            <hr class="my-3 opacity-25" />

            <!-- KONUM, KADASTRO & HARİTA -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-compass me-1 text-primary"></i> 1. Tapu, Kadastro & Konum Bilgileri
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold d-flex align-items-center gap-1 shadow-xs" onclick="queryTkgmForKunye()" id="btnKunyeTkgm" title="Harita koordinatına göre TKGM MEGSİS'ten resmi ada, parsel ve m² çek">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <span>🗺️ TKGM'den Resmi Kadastro & Alanı Çek</span>
                    </button>
                </div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">İl</label>
                        <select name="cityId" id="CityId" class="form-select rounded-3" asp-items="ViewBag.Cities">
                            <option value="">İl Seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">İlçe</label>
                        <select name="districtId" id="DistrictId" class="form-select rounded-3" asp-items="ViewBag.Districts">
                            <option value="">İlçe Seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Mahalle</label>
                        <select name="neighborhoodId" id="NeighborhoodId" class="form-select rounded-3" asp-items="ViewBag.Neighborhoods">
                            <option value="">Mahalle Seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Sokak / Cadde</label>
                        <select name="streetId" id="StreetId" class="form-select rounded-3" asp-items="ViewBag.Streets">
                            <option value="">Sokak Seçiniz</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Ada</label>
                        <input type="text" name="ada" class="form-control rounded-3" value="@Model.Ada" placeholder="Örn: 145" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Parsel</label>
                        <input type="text" name="parsel" class="form-control rounded-3" value="@Model.Parsel" placeholder="Örn: 12" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Toplam Arazi Alanı (m²)</label>
                        <div class="input-group">
                            <input type="number" step="any" name="totalLandArea" class="form-control rounded-start-3" value="@Model.TotalLandArea" placeholder="Örn: 850" />
                            <span class="input-group-text rounded-end-3">m²</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Harita Konumu</label>
                        <div class="input-group">
                            <input type="text" name="latitude" id="latInput" class="form-control bg-light" value="@Model.Latitude" placeholder="Enlem" readonly />
                            <input type="text" name="longitude" id="lngInput" class="form-control bg-light" value="@Model.Longitude" placeholder="Boylam" readonly />
                            <button class="btn btn-outline-secondary" type="button" onclick="openMapModal()" title="Haritadan Konum Seç">
                                <i class="bi bi-geo-alt-fill"></i>
                            </button>
                            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                            {
                                <a href="https://maps.google.com/?q=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-outline-primary" id="btnGoogleMaps" title="Google Haritada Aç">
                                    <i class="bi bi-map"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. BÖLÜM: DİNAMİK KENTSEL DÖNÜŞÜM & MEVCUT YAPI (SADECE KENTSEL DÖNÜŞÜMDE AÇILIR) -->
            <div id="kentselDonusumSection" class="p-3 rounded-3 mb-4 border" style="background-color: #fffaf0; border-color: #fed7aa !important; display: @(isKentsel ? "block" : "none");">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-building-exclamation me-1 text-warning"></i> 2. Mevcut Yapı & Saha Detayları (Yıkılacak Bina Havuzu)
                    </h6>
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small">
                        Kentsel Dönüşüm Keşfi
                    </span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Bina / Dış Kapı No</label>
                        <input type="text" name="address" id="fullAddress" class="form-control rounded-3" value="@Model.Address" placeholder="Örn: No: 14 veya 16/A" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Bina Yapım Tarihi / Yaşı <small class="text-secondary">(İsteğe Bağlı)</small></label>
                        <input type="number" name="buildingAge" class="form-control rounded-3" value="@Model.BuildingAge" placeholder="Örn: 1988 veya 36 Yaş" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Mevcut Kat Adedi</label>
                        <input type="number" name="eskiKatSayisi" class="form-control rounded-3" value="@Model.EskiKatSayisi" placeholder="Örn: 5" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Mevcut Daire Sayısı</label>
                        <input type="number" name="eskiDaireSayisi" id="eskiDaireInput" class="form-control rounded-3 fw-bold" value="@Model.EskiDaireSayisi" placeholder="Örn: 10" oninput="syncDestekCounts()" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Mevcut Dükkan Sayısı</label>
                        <input type="number" name="eskiDukkanSayisi" class="form-control rounded-3" value="@Model.EskiDukkanSayisi" placeholder="Örn: 2" />
                    </div>
                </div>
            </div>

            <!-- 3. BÖLÜM: TARİHLER & RESMİ BELGELER (DOSYA ARŞİVİ ENTEGRASYONU) -->
            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-folder-check me-1 text-primary"></i> 3. Tarihler & Resmi Dosya Arşivi
                </h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Proje Başlama Tarihi</label>
                        <input type="date" name="startDate" class="form-control rounded-3" 
                               value="@(Model.StartDate.Year > 1 ? Model.StartDate.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Tahmini Teslim Tarihi</label>
                        <input type="date" name="endDate" class="form-control rounded-3" 
                               value="@(Model.EndDate.HasValue && Model.EndDate.Value.Year > 1 ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted" id="lblCurrentStateImage">
                            @(isKentsel ? "Yıkılacak Eski Yapı Görseli (Portföy)" : "Arsa / Saha Görseli (Boş Hali)")
                        </label>
                        <div class="input-group">
                            <input type="file" name="currentStateImageFile" class="form-control rounded-3" accept="image/*,.pdf" />
                        </div>
                        @if (!string.IsNullOrEmpty((string)ViewBag.CurrentStateImageUrl))
                        {
                            <div class="mt-1">
                                <a href="@ViewBag.CurrentStateImageUrl" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                    <i class="bi bi-image me-1"></i> Kayıtlı Görseli Gör
                                </a>
                            </div>
                        }
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Tapu Belgesi / Krokisi</label>
                        <div class="input-group">
                            <input type="file" name="tapuDocumentFile" class="form-control rounded-3" accept="image/*,.pdf" />
                        </div>
                        @if (!string.IsNullOrEmpty((string)ViewBag.TapuDocumentUrl))
                        {
                            <div class="mt-1">
                                <a href="@ViewBag.TapuDocumentUrl" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                    <i class="bi bi-file-earmark-check me-1"></i> Kayıtlı Tapu Belgesini Gör
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-2">
                <div class="text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i> Tüm alanlar otomatik kaydedilir. İsteğe bağlı olarak bu butonla da kaydedebilirsiniz.
                </div>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                    <i class="bi bi-floppy me-2"></i> Künye & Keşif Bilgilerini Kaydet
                </button>
            </div>
            </div> <!-- End of #kunyeCollapse -->
        </div>
    </form>
</div>

<!-- HİSSEDAR DÜZENLEME MODALI -->
<div class="modal fade" id="partnerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="UpdateProjectPartners" asp-controller="ConstructionProject" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="modal-header border-bottom py-3 bg-light">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-people-fill text-primary me-2"></i> Hissedar & Ortaklık Yapısı
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Projede tekil yüklenici misiniz yoksa yatırımcı/ortak var mı? Pay oranlarını belirtiniz. İleride yeni ortak girerse oranları buradan güncelleyebilirsiniz.
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Ortaklık & Hisse Paylaşımı</label>
                        <input type="text" name="projectOwnerContact" class="form-control fw-bold" 
                               value="@(Model.ProjectOwnerContact ?? "Bayraktar İnşaat (%100 - Ana Yüklenici)")" 
                               placeholder="Örn: Bayraktar İnşaat (%70), Ali Bey (%30)" required />
                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                            Örnek: <code>Bayraktar İnşaat (%100)</code> veya <code>Bayraktar İnşaat (%60), Ahmet Bey (%40)</code>
                        </small>
                    </div>
                </div>

                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

