@model GMK360.Core.Entities.Construction.ConstructionProject
<div class="col-md-6 col-lg-4">
    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" class="card-img-top" alt="@Model.Name" style="height: 200px; object-fit: cover;">
        }
        else
        {
            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                <i class="bi bi-image fs-1 opacity-50"></i>
            </div>
        }
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title fw-bold mb-0">@Model.Name</h5>
                @if (Model.StatusId == GMK360.Core.Entities.Construction.ProjectConstants.StatusTeklif)
                {
                    <span class="badge bg-warning text-dark">Görüþmede / Teklif</span>
                }
                else if (Model.StatusId == GMK360.Core.Entities.Construction.ProjectConstants.StatusAktif)
                {
                    <span class="badge bg-primary">Aktif Þantiye</span>
                }
                else
                {
                    <span class="badge bg-success">Tamamlandý</span>
                }
            </div>
            <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i>@Model.Address</p>
            
            <div class="d-flex justify-content-between text-muted small mb-4">
                <div>
                    <i class="bi bi-calendar-event me-1"></i> Baþlangýç: <br>
                    <strong>@(Model.StartDate.Year > 1 ? Model.StartDate.ToString("dd.MM.yyyy") : "-")</strong>
                </div>
                <div class="text-end">
                    <i class="bi bi-calendar-check me-1"></i> Teslim: <br>
                    <strong>@(Model.EndDate.HasValue && Model.EndDate.Value.Year > 1 ? Model.EndDate.Value.ToString("dd.MM.yyyy") : "-")</strong>
                </div>
            </div>
            
            <a asp-action="Details" asp-controller="ConstructionProject" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold">
                <i class="bi bi-arrow-right-circle me-2"></i> Proje Panosuna Git
            </a>
        </div>
    </div>
</div>
