@model GMK360.Core.Entities.UnitTemplate

@{
    ViewData["Title"] = Model.Name + " - İç Plan Yönetimi";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ConstructionProjectId" class="text-decoration-none">Proje</a></li>
                <li class="breadcrumb-item"><a asp-action="Templates" asp-route-projectId="@Model.ConstructionProjectId" class="text-decoration-none">Şablonlar</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1"><i class="bi bi-door-open text-primary me-2"></i>@Model.Name Şablonu İç Planı</h2>
        <p class="text-muted mb-0 small">Plan: @Model.RoomLayout</p>
    </div>
    <a asp-action="Templates" asp-route-projectId="@Model.ConstructionProjectId" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i> Şablonlara Dön
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Alan Ekleme Formu -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-plus-square-dotted text-success me-2"></i>Yeni Alan Ekle</h5>
                <p class="text-muted small mb-4">Şablon içerisindeki odaları (Örn: Salon, Mutfak, Banyo) buraya tanımlayın.</p>
                
                <form asp-action="AddTemplateSpace" method="post">
                    <input type="hidden" name="templateId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Oda Adı</label>
                        <input type="text" name="name" class="form-control" placeholder="Örn: Ebeveyn Banyosu" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Kullanım Tipi</label>
                        <select name="type" class="form-select">
                            <option value="Yaşam Alanı">Yaşam Alanı (Oda/Salon)</option>
                            <option value="Mutfak">Mutfak</option>
                            <option value="Islak Hacim">Islak Hacim (Banyo/WC)</option>
                            <option value="Sirkülasyon">Sirkülasyon (Antre/Koridor)</option>
                            <option value="Balkon">Balkon / Teras</option>
                            <option value="Depolama">Depolama (Kiler/Giyinme Odası)</option>
                            <option value="Ortak Alan">Ortak Alan</option>
                        </select>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Metrekare (m2) - Opsiyonel</label>
                        <input type="number" step="0.01" name="squareMeters" class="form-control" placeholder="Örn: 15.5" />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Alanı Ekle
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Eklenen Alanların Listesi (Ağaç Gösterimi) -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0 row align-items-center">
                <div class="col-auto"><h5 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-2 text-info"></i>Şablon İç Planı</h5></div>
                <div class="col-auto text-end"><span class="badge bg-light text-dark border">Toplam: @(Model.Spaces?.Count ?? 0) Alan</span></div>
            </div>
            <div class="card-body p-4">
                
                @if (Model.Spaces != null && Model.Spaces.Any())
                {
                    <div class="accordion" id="spacesAccordion">
                        @foreach (var space in Model.Spaces.OrderBy(s => s.Id))
                        {
                            var collapseId = "collapseSpace" + space.Id;
                            <div class="accordion-item border mb-2 rounded-3 overflow-hidden shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button bg-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId""><span class="w-100 text-truncate fw-bold"><i class="bi bi-bounding-box-circles me-2 text-secondary"></i> @space.Name <small class="text-muted fw-normal ms-2">(@space.Type @if(space.SquareMeters.HasValue){<text>- @space.SquareMeters m²</text>})</small></span></button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#spacesAccordion">
                                    <div class="accordion-body bg-white text-end border-top p-3">
                                        <form asp-action="DeleteTemplateSpace" method="post" class="d-inline">
                                            <input type="hidden" name="spaceId" value="@space.Id" />
                                            <input type="hidden" name="templateId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Bu alanı şablondan silmek istediğinize emin misiniz?');">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="alert alert-info mt-4 small border-0 rounded-4">
                        <i class="bi bi-info-circle-fill me-2"></i> <strong>Bilgi:</strong> Blok yönetiminde "Mimariyi Üret" sihirbazını çalıştırdığınızda ve bu şablonu seçtiğinizde, yukarıdaki tüm odalar dairelerin içine otomatik olarak klonlanacaktır.
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-layout-text-window" style="font-size: 3rem;"></i>
                        <p class="mt-3">Bu şablonda henüz tanımlanmış bir alan (oda) yok.</p>
                        <p class="small">Sol taraftaki formu kullanarak odaları eklemeye başlayın.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
