@model GMK360.Core.Entities.Construction.ConstructionProject

@{
    ViewData["Title"] = "Daire Şablonları Yönetimi";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-collection text-primary me-2"></i>Daire Tipleri (Şablonlar)</h2>
        <p class="text-muted mb-0"><i class="bi bi-building me-1"></i>Proje: @Model.Name</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i> Proje Detayına Dön
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Yeni Şablon Ekleme Formu -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4"><i class="bi bi-plus-circle-fill text-success me-2"></i>Yeni Şablon Oluştur</h5>
                
                <form asp-action="AddTemplate" method="post">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Şablon Adı</label>
                        <input type="text" name="name" class="form-control" placeholder="Örn: A Tipi VIP" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Standart Plan</label>
                        <select name="roomLayout" class="form-select">
                            <option value="1+1">1+1</option>
                            <option value="2+1">2+1</option>
                            <option value="3+1" selected>3+1</option>
                            <option value="4+1">4+1</option>
                            <option value="5+1">5+1</option>
                            <option value="Dubleks">Dubleks</option>
                            <option value="Ticari">Ticari Alan (Dükkan)</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small">Açıklama (Opsiyonel)</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Örn: 2 banyolu köşe daireler için..."></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm">
                        <i class="bi bi-save me-2"></i> Şablonu Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Şablon Listesi -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4"><i class="bi bi-list-ul text-navy me-2"></i>Mevcut Şablonlar</h5>
                
                @if (Model.UnitTemplates != null && Model.UnitTemplates.Any())
                {
                    <div class="row g-3">
                        @foreach (var template in Model.UnitTemplates)
                        {
                            <div class="col-md-6">
                                <div class="card bg-light border-0 rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold mb-0">@template.Name</h6>
                                            <span class="badge bg-primary">@template.RoomLayout</span>
                                        </div>
                                        <p class="small text-muted mb-3">@template.Description</p>
                                        
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge bg-secondary"><i class="bi bi-bounding-box-circles me-1"></i> @(template.Spaces?.Count ?? 0) Oda/Alan</span>
                                            <a asp-action="TemplateSpaces" asp-route-templateId="@template.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                İç Planı (Odaları) Yönet <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
                        <p class="mt-3">Bu projeye henüz hiçbir daire şablonu eklenmemiş.</p>
                        <p class="small">Sol taraftaki formu kullanarak ilk şablonunuzu oluşturun.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
