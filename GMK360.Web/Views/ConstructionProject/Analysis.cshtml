<div class="modal fade" id="unitOwnerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <form asp-action="SaveUnitStakeholder" asp-controller="ConstructionProject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="stakeholderId" id="uoStakeholderId" value="" />
                <div class="modal-header border-bottom py-2.5 px-3 bg-light">
                    <h6 class="modal-title fw-bold text-dark" id="uoModalTitle">Hak Sahibi Bilgisi</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">Bağımsız Bölüm (Daire / Dükkan No) *</label>
                        <input type="text" name="unitNumber" id="uoUnitNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">Hak Sahibi Adı Soyadı (Şahıs) *</label>
                        <input type="text" name="fullName" id="uoFullName" class="form-control" required />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">Telefon *</label>
                            <input type="text" name="phone" id="uoPhone" class="form-control font-monospace" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-muted">E-Posta</label>
                            <input type="email" name="email" id="uoEmail" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">Banka IBAN (Kira & Taşınma Desteği İçin)</label>
                        <input type="text" name="iban" id="uoIban" class="form-control font-monospace" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-bold small text-muted">Not / Hisse Durumu</label>
                        <input type="text" name="notes" id="uoNotes" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light border-top">
                    <button type="button" class="btn btn-sm btn-white border rounded px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded px-4 fw-bold">
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    function openUnitOwnerModal(id, unit, name, phone, email, iban, notes) {
        document.getElementById('uoStakeholderId').value = id || '';
        document.getElementById('uoUnitNumber').value = unit || '';
        document.getElementById('uoFullName').value = name || '';
        document.getElementById('uoPhone').value = phone || '';
        document.getElementById('uoEmail').value = email || '';
        document.getElementById('uoIban').value = iban || '';
        document.getElementById('uoNotes').value = notes || '';
        
        var titleEl = document.getElementById('uoModalTitle');
        if (titleEl) {
            titleEl.textContent = id ? ('Düzenle: ' + unit + ' - ' + name) : (unit ? ('Yeni Hak Sahibi: ' + unit) : 'Yeni Hak Sahibi Ekle');
        }
        
        var modalEl = document.getElementById('unitOwnerModal');
        if (modalEl) {
            var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function openDocModal(docId) {
        fetch('/PhaseZero/GetDoc/' + docId)
            .then(function(res) { return res.json(); })
            .then(function(data) {
                document.getElementById('modalDocId').value = data.id;
                var titleEl = document.getElementById('modalDocTitle');
                if (titleEl) titleEl.textContent = data.documentName || 'Evrak Yönetimi';
                var statusEl = document.getElementById('modalDocStatus');
                if (statusEl) statusEl.value = data.status || 'Bekliyor';
                var userEl = document.getElementById('modalDocAssignedUser');
                if (userEl) userEl.value = data.assignedUserId || '';
                var feeEl = document.getElementById('modalDocFee');
                if (feeEl) feeEl.value = data.documentFee || 0;
                var addEl = document.getElementById('modalDocAddCost');
                if (addEl) addEl.value = data.additionalCost || 0;
                var contactEl = document.getElementById('modalDocContact');
                if (contactEl) contactEl.value = data.institutionContact || '';
                var phaseEl = document.getElementById('modalLinkedPhase');
                if (phaseEl) phaseEl.value = data.linkedPhaseCategory !== null && data.linkedPhaseCategory !== undefined ? data.linkedPhaseCategory : '';

                var filePrev = document.getElementById('modalFilePreview');
                var fileLink = document.getElementById('modalFileLink');
                if (data.filePath && filePrev && fileLink) {
                    fileLink.href = data.filePath;
                    filePrev.style.display = 'block';
                } else if (filePrev) {
                    filePrev.style.display = 'none';
                }

                var modalEl = document.getElementById('docManageModal');
                if (modalEl) {
                    var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.show();
                }
            });
    }
</script>

