<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>

    // MARKDOWN DÖNÜŞTÜRÜCÜ (AI RAPORU İÇİN)

    function parseAiMarkdown(md) {

        if (!md) return '';

        var lines = md.split('\n');

        var html = '';

        var inList = false;

        for (var i = 0; i < lines.length; i++) {

            var line = lines[i].trim();

            if (!line) {

                if (inList) { html += '</ul>'; inList = false; }

                continue;

            }

            if (line.startsWith('### ')) {

                if (inList) { html += '</ul>'; inList = false; }

                html += '<h6 class="fw-bold text-dark mt-2 mb-2 pb-1 border-bottom"><i class="bi bi-geo-alt text-primary me-1"></i>' + line.substring(4) + '</h6>';

            } else if (line.startsWith('#### ')) {

                if (inList) { html += '</ul>'; inList = false; }

                html += '<h6 class="fw-bold text-primary mt-3 mb-1"><i class="bi bi-chevron-right text-primary me-1"></i>' + line.substring(5) + '</h6>';

            } else if (line.startsWith('* ') || line.startsWith('- ')) {

                if (!inList) { html += '<ul class="mb-2 ps-3">'; inList = true; }

                var content = line.substring(2);

                content = content.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

                html += '<li class="mb-1 text-secondary">' + content + '</li>';

            } else {

                if (inList) { html += '</ul>'; inList = false; }

                var text = line.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

                html += '<p class="mb-2 text-dark" style="text-align: justify;">' + text + '</p>';

            }

        }

        if (inList) { html += '</ul>'; }

        return html;

    }

    function setupCollapseToggle(collapseId, btnTextId, iconId) {

        var el = document.getElementById(collapseId);

        if (!el) return;

        el.addEventListener('show.bs.collapse', function () {

            var textEl = document.getElementById(btnTextId);

            var iconEl = document.getElementById(iconId);

            if (textEl) textEl.innerText = 'Daralt';

            if (iconEl) iconEl.className = 'bi bi-chevron-up';

        });

        el.addEventListener('hide.bs.collapse', function () {

            var textEl = document.getElementById(btnTextId);

            var iconEl = document.getElementById(iconId);

            if (textEl) textEl.innerText = 'Genişlet';

            if (iconEl) iconEl.className = 'bi bi-chevron-down';

        });

    }

    document.addEventListener("DOMContentLoaded", function() {

        // AI Raporunu Render Et

        // Collapse Olaylarını Bağla

        setupCollapseToggle('hakSahipleriCollapse', 'textHakSahipleriToggle', 'iconHakSahipleriChevron');
        setupCollapseToggle('kiraBedellerCollapse', 'textKiraBedellerToggle', 'iconKiraBedellerChevron');
        setupCollapseToggle('eskiBinaCollapse', 'textEskiBinaToggle', 'iconEskiBinaChevron');
        setupCollapseToggle('burokrasiCollapse', 'textBurokrasiToggle', 'iconBurokrasiChevron');

        setupCollapseToggle('imarCollapse', 'textImarToggle', 'iconImarChevron');
        setupCollapseToggle('fazlarCollapse', 'textFazlarToggle', 'iconFazlarChevron');
        setupCollapseToggle('projeKarakteriCollapse', 'textProjeKarakteriToggle', 'iconProjeKarakteriChevron');

        // İmar Form Olaylarını Bağla

        var form = document.getElementById('imarForm');

        if (form) {

            var inputs = form.querySelectorAll('input, textarea');

            inputs.forEach(function(el) {

                el.addEventListener('change', triggerImarAutosave);

                if (el.tagName === 'TEXTAREA' || (el.tagName === 'INPUT' && (el.type === 'text' || el.type === 'number'))) {

                    el.addEventListener('input', triggerImarAutosave);

                }

            });

        }

        recalculateCapacity();
        recalculateRontgenAndDecision();
    });
</script>

@{
    int rFloors = Model.TotalFloors ?? 15;
    int rUnitsPerFloor = rentPolicy.UnitsPerFloor > 0 ? rentPolicy.UnitsPerFloor : 2;
    int rTotalUnits = Model.TargetTotalApartments ?? (rFloors * rUnitsPerFloor);
    decimal rOwnerShare = rentPolicy.OwnerSharePercent > 0 ? rentPolicy.OwnerSharePercent : 50m;
    int rOwnerUnits = (int)Math.Round(rTotalUnits * (rOwnerShare / 100m));
    int rContractorUnits = Math.Max(0, rTotalUnits - rOwnerUnits);
    decimal rFlatPrice = Model.AverageFlatSalePrice > 0 ? Model.AverageFlatSalePrice : 10000000m;
    int rContractorShops = Math.Max(0, rentPolicy.PlannedNewShops - rentPolicy.OwnerGivenShops);
    decimal rShopPrice = rentPolicy.EstimatedShopSalePrice > 0 ? rentPolicy.EstimatedShopSalePrice : 15000000m;
    decimal rRevenue = (rContractorUnits * rFlatPrice) + (rContractorShops * rShopPrice);
    int rCostFloors = rFloors + rentPolicy.BasementFloors + 2;
    decimal rFirmUnit = rentPolicy.FirmUnitCostPerSqm > 0 ? rentPolicy.FirmUnitCostPerSqm : 25000m;
    decimal rConstCost = rCostFloors * 271m * rFirmUnit;
    decimal rRentBurden = rentPolicy.IncludeRentInFeasibility
        ? (((Model.EskiDaireSayisi ?? 4) * ((rentPolicy.FlatMonthlyRent * rentPolicy.RentDurationMonths) + rentPolicy.FlatRelocationFee))
           + ((Model.EskiDukkanSayisi ?? 0) * ((rentPolicy.ShopMonthlyRent * rentPolicy.RentDurationMonths) + rentPolicy.ShopRelocationFee)))
        : 0m;
    decimal rBaseNetProfit = rRevenue - (rConstCost + rRentBurden);
}
<script>
    var baseFeasibilityNetProfit = @rBaseNetProfit.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    function setRiskBadge(elId, level) {
        var el = document.getElementById(elId);
        if (!el) return;
        if (level === 'high') {
            el.className = 'badge bg-danger text-white rounded-pill px-2 py-0.5';
            el.innerText = '🔴 Kritik Risk';
        } else if (level === 'medium') {
            el.className = 'badge bg-warning text-dark border border-warning rounded-pill px-2 py-0.5';
            el.innerText = '🟡 Orta Risk (Şartlı)';
        } else {
            el.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5';
            el.innerText = '🟢 Düşük Risk';
        }
    }

    function recalculateRontgenAndDecision() {
        var titleDeed = document.getElementById('selTitleDeed') ? document.getElementById('selTitleDeed').value : '';
        var inheritance = document.getElementById('selInheritance') ? document.getElementById('selInheritance').value : '';
        var hostile = document.getElementById('selHostileOwner') ? document.getElementById('selHostileOwner').value : '';

        var legalRisk = 'low';
        if (titleDeed.indexOf('Kritik') >= 0 || inheritance.indexOf('Kritik') >= 0 || hostile.indexOf('Kritik') >= 0) legalRisk = 'high';
        else if (titleDeed.indexOf('Kredili') >= 0 || inheritance.indexOf('Mirasçılı') >= 0 || hostile.indexOf('2/3') >= 0) legalRisk = 'medium';
        setRiskBadge('badgeRiskLegal', legalRisk);

        var neighbor = document.getElementById('selNeighborRisk') ? document.getElementById('selNeighborRisk').value : '';
        var shoring = document.getElementById('selShoringReq') ? document.getElementById('selShoringReq').value : '';
        var street = document.getElementById('selStreetLogistics') ? document.getElementById('selStreetLogistics').value : '';
        var demMode = document.getElementById('selDemolitionMode') ? document.getElementById('selDemolitionMode').value : '';
        var demShieldNote = document.getElementById('lblDemolitionShieldNote');
        if (demShieldNote) {
            if (demMode.indexOf('Dışarıdan') >= 0) {
                demShieldNote.innerHTML = '🛡️ <b>Yıkım İhale Kalkanı:</b> Komşu bina hasarlarından yıkım taşeronu sorumludur; taşerondan All-Risk Yıkım Sigortası (Komşu Mali Mesuliyet Klozlu), Noter Delil Tespiti ve Teminat Senedi zorunlu tutulacaktır.';
            } else {
                demShieldNote.innerHTML = '🛡️ <b>Kendi Bünyemizde Yıkım Kalkanı:</b> Yıkım kendi makine parkımızla yapılacağından, yıkım öncesi komşu binalar için Noter Delil Tespiti ve Genişletilmiş Komşu Mali Mesuliyet Sigortası poliçesi doğrudan şirketimizce yaptırılacaktır.';
            }
        }

        var neighborRisk = 'low';
        if (neighbor.indexOf('İki Yandan') >= 0 || shoring.indexOf('Ağır') >= 0 || street.indexOf('Çok Dar') >= 0) neighborRisk = 'high';
        else if (neighbor.indexOf('Tek Yandan') >= 0 || shoring.indexOf('Standart') >= 0 || street.indexOf('Dar') >= 0) neighborRisk = 'medium';
        setRiskBadge('badgeRiskNeighbor', neighborRisk);

        var slope = document.getElementById('selLandSlope') ? document.getElementById('selLandSlope').value : '';
        var soil = document.getElementById('selSoilBearing') ? document.getElementById('selSoilBearing').value : '';
        var water = document.getElementById('selGroundwater') ? document.getElementById('selGroundwater').value : '';
        var groundRisk = 'low';
        if (slope.indexOf('Dik') >= 0 || soil.indexOf('Balçık') >= 0 || water.indexOf('Yüksek') >= 0) groundRisk = 'high';
        else if (slope.indexOf('Eğimli') >= 0 || soil.indexOf('Zayıf') >= 0 || water.indexOf('Yüzeysel') >= 0) groundRisk = 'medium';
        setRiskBadge('badgeRiskGround', groundRisk);

        var coreTest = document.getElementById('selCoreTest') ? document.getElementById('selCoreTest').value : '';
        var regHarmony = document.getElementById('selRegionalHarmony') ? document.getElementById('selRegionalHarmony').value : '';
        var burRisk = 'low';
        if (coreTest.indexOf('Erken') >= 0 || regHarmony.indexOf('Zayıf') >= 0) burRisk = 'high';
        else if (coreTest.indexOf('Riskli') >= 0 || regHarmony.indexOf('Orta') >= 0) burRisk = 'medium';
        setRiskBadge('badgeRiskBureaucracy', burRisk);

        // Ekstra Maliyet Hesabı
        var shoringCost = parseFloat(document.getElementById('inpShoringCost') ? document.getElementById('inpShoringCost').value : 0) || 0;
        var demPolicyCost = parseFloat(document.getElementById('inpDemolitionPolicyCost') ? document.getElementById('inpDemolitionPolicyCost').value : 0) || 0;
        var retainingCost = parseFloat(document.getElementById('inpRetainingCost') ? document.getElementById('inpRetainingCost').value : 0) || 0;
        var pilingCost = parseFloat(document.getElementById('inpPilingCost') ? document.getElementById('inpPilingCost').value : 0) || 0;
        var waterCost = parseFloat(document.getElementById('inpGroundwaterCost') ? document.getElementById('inpGroundwaterCost').value : 0) || 0;

        var totalExtraSiteCost = shoringCost + demPolicyCost + retainingCost + pilingCost + waterCost;
        var payer = document.getElementById('selGroundPayer') ? document.getElementById('selGroundPayer').value : '';
        var contractorExtraBurden = totalExtraSiteCost;
        if (payer.indexOf('Sözleşmeye') >= 0) {
            contractorExtraBurden = demPolicyCost; // Zemin/iksa/kazık maliklere yansıtılır
        } else if (payer.indexOf('Yarı') >= 0) {
            contractorExtraBurden = Math.round(totalExtraSiteCost * 0.5);
        }

        var revisedNetProfit = baseFeasibilityNetProfit - contractorExtraBurden;

        var lblBase = document.getElementById('lblBaseFeasibilityProfit');
        if (lblBase) lblBase.innerText = baseFeasibilityNetProfit.toLocaleString('tr-TR') + ' ₺';
        var lblExtra = document.getElementById('lblTotalExtraSiteCost');
        if (lblExtra) lblExtra.innerText = '+' + totalExtraSiteCost.toLocaleString('tr-TR') + ' ₺';
        var lblBurden = document.getElementById('lblContractorExtraBurden');
        if (lblBurden) lblBurden.innerText = '-' + contractorExtraBurden.toLocaleString('tr-TR') + ' ₺';
        var lblRev = document.getElementById('lblRevisedNetProfit');
        if (lblRev) {
            lblRev.innerText = revisedNetProfit.toLocaleString('tr-TR') + ' ₺';
            lblRev.className = revisedNetProfit >= 0 ? 'fs-6 fw-extrabold text-success font-monospace' : 'fs-6 fw-extrabold text-danger font-monospace';
        }

        // Eğer sözleşme kalkanı alanı boşsa otomatik doldur
        var txtShield = document.getElementById('txtContractShieldClauses');
        if (txtShield && !txtShield.value.trim()) {
            generateContractShieldClauses(false);
        }
    }

    function generateContractShieldClauses(forceOverwrite) {
        var txtShield = document.getElementById('txtContractShieldClauses');
        if (!txtShield) return;
        if (!forceOverwrite && txtShield.value.trim().length > 0) return;

        var clauses = [];
        var neighbor = document.getElementById('selNeighborRisk') ? document.getElementById('selNeighborRisk').value : '';
        var shoring = document.getElementById('selShoringReq') ? document.getElementById('selShoringReq').value : '';
        var demMode = document.getElementById('selDemolitionMode') ? document.getElementById('selDemolitionMode').value : '';
        var demShield = document.getElementById('chkDemolitionShield') ? document.getElementById('chkDemolitionShield').checked : false;
        var payer = document.getElementById('selGroundPayer') ? document.getElementById('selGroundPayer').value : '';
        var totalExtra = (parseFloat(document.getElementById('inpShoringCost')?.value) || 0)
                       + (parseFloat(document.getElementById('inpRetainingCost')?.value) || 0)
                       + (parseFloat(document.getElementById('inpPilingCost')?.value) || 0)
                       + (parseFloat(document.getElementById('inpGroundwaterCost')?.value) || 0);

        if (demShield || neighbor.indexOf('Bitişik') >= 0) {
            if (demMode.indexOf('Dışarıdan') >= 0) {
                clauses.push('• [YIKIM & KOMŞU BİNA GÜVENCE ŞARTI]: Bitişik/komşu nizam yapı güvenliği kapsamında; yıkım işlemi başlamadan önce komşu binalar için Noter Delil Tespiti yaptırılacak olup, ihaleyi alan yıkım firması tarafından Komşu Mali Mesuliyet Klozlu All-Risk Sigorta Poliçesi ve teminat senedi ibraz edilmeden yıkıma başlanmayacaktır.');
            } else {
                clauses.push('• [YIKIM & KOMŞU BİNA GÜVENCE ŞARTI]: Yıkım operasyonu yüklenici firma makine parkı ile yürütülecek olup, yıkım öncesi bitişik komşu yapılar için Noter Delil Tespiti ve Genişletilmiş Komşu Mali Mesuliyet Sigortası poliçesi düzenlenecektir.');
            }
        }

        if (totalExtra > 0 || shoring.indexOf('Gerekmiyor') < 0) {
            if (payer.indexOf('Sözleşmeye') >= 0) {
                clauses.push('• [ZEMİN, İSTİNAT VE İKSA SÜRPRİZ MALİYET KALKANI]: Resmi zemin etüdü ve statik proje sonucunda zorunlu kılınacak ekstra fore kazık, jet-grout, istinat duvarı ve ağır iksa imalat giderleri (Tahmini ~' + totalExtra.toLocaleString('tr-TR') + ' TL) arsa sahiplerine (maliklere) ait olup, malik paylaşım oranından veya nakdi katkı payından mahsup edilecektir.');
            } else if (payer.indexOf('Yarı') >= 0) {
                clauses.push('• [ZEMİN, İSTİNAT VE İKSA MALİYET PAYLAŞIMI]: Zemin etüdü sonucunda çıkacak ekstra fore kazık, istinat duvarı ve iksa güçlendirme maliyetleri (%50 Yüklenici - %50 Arsa Sahipleri) yarı yarıya paylaşılacaktır.');
            } else {
                clauses.push('• [ZEMİN & İKSA TAAHHÜDÜ]: Standart zemin iyileştirme ve iksa güvenlik önlemleri yüklenici firma tarafından teknik şartname kapsamında üstlenilmiştir.');
            }
        }

        clauses.push('• [KİRA & TAHLİYE BAŞLANGIÇ KALKANI]: Kira yardımı ödemeleri; tüm maliklerin (%100) noter sözleşmesini imzalayıp vekaletlerini vermesi, binanın tamamen boşaltılarak elektrik/su/doğalgaz ilişik kesme belgelerinin yükleniciye teslim edildiği tarihte başlar. 6306 sayılı kanun kapsamındaki 2/3 çoğunluk süreçlerinden veya malikler arası hukuki davalardan kaynaklanan gecikmeler inşaat teslim süresine eklenir.');

        txtShield.value = clauses.join('\n');
    }
</script>


