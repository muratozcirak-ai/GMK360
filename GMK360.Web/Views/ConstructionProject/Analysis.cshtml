<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

@model GMK360.Core.Entities.Construction.ConstructionProject

@using GMK360.Core.Entities.Construction

@using GMK360.Core.Entities

@{

    ViewData["Title"] = "Ön Analiz & Bürokrasi: " + Model.Name;

    ViewData["ProjectId"] = Model.Id;

    ViewData["ProjectName"] = Model.Name;

    ViewData["ProjectStatus"] = Model.Status;

    Layout = "_ProjectLayout";

    string cityName = ViewBag.CityName as string ?? "İl Seçilmedi";

    string distName = ViewBag.DistrictName as string ?? "İlçe Seçilmedi";

    string neighName = ViewBag.NeighborhoodName as string ?? "";

    double landArea = Model.TotalLandArea ?? 0;

    int oldUnits = Model.EskiDaireSayisi ?? 0;

    var initialDocs = ViewBag.InitialDocs as List<ProjectLegalDocument> ?? new List<ProjectLegalDocument>();

    var stageRules = ViewBag.StageRules as List<ModuleDocumentRule> ?? new List<ModuleDocumentRule>();

    decimal totalInitialFee = ViewBag.TotalInitialFee != null ? (decimal)ViewBag.TotalInitialFee : 0;

    int completedCount = ViewBag.CompletedInitialCount != null ? (int)ViewBag.CompletedInitialCount : 0;

    var stakeholders = ViewBag.Stakeholders as List<ProjectStakeholder> ?? new List<ProjectStakeholder>();

    var blocks = ViewBag.Blocks as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();

}

<!-- KOMPAKT PROJE BAŞLIK ŞERİDİ (TEK SATIR & SIFIR DİKEY İSRAF) -->

    <div class="d-flex justify-content-between align-items-center py-1.5 px-3 mb-2 bg-white rounded-3 border shadow-xs flex-wrap gap-2">

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <span class="badge bg-success bg-opacity-10 text-success rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">

                <i class="bi bi-graph-up-arrow"></i>

            </span>

            <span class="fw-bold text-dark fs-6">@Model.Name</span>

            <span class="badge bg-warning text-dark border border-warning px-2 py-0 rounded-pill fw-bold" style="font-size: 0.70rem;">

                <i class="bi bi-hourglass-split me-1"></i>ADAY

            </span>

            <span class="text-muted small" style="font-size: 0.76rem;">— Ön Analiz & Bürokrasi Masası</span>

            <span class="text-muted opacity-50">|</span>

            <span class="badge bg-light text-dark border px-2 py-0 rounded-pill small" style="font-size: 0.72rem;">

                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@cityName / @distName (@neighName Mah.)

            </span>

        </div>

        <div class="d-flex align-items-center gap-2">

            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill small" style="font-size: 0.72rem;">

                ID: #@Model.Id

            </span>

            <a href="/ConstructionProject/Workspace/@Model.Id" class="btn btn-outline-primary rounded-pill px-2.5 py-0 fw-bold btn-sm shadow-xs" style="font-size: 0.74rem;">

                <i class="bi bi-card-heading me-1"></i>Künyeye Git ➔

            </a>

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)

    {

        <div class="alert alert-success alert-dismissible fade show rounded-3 py-1.5 px-3 mb-2 small shadow-xs" role="alert">

            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]

            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Kapat"></button>

        </div>

    }


    <!-- 1. BÖLÜM: ESKİ BİNA DAİRE & DÜKKAN HAK SAHİPLERİ -->
    @{
        int shopCount = Model.EskiDukkanSayisi ?? 0;
        int flatCount = Model.EskiDaireSayisi ?? 0;
        // Otomatik sıralı bağımsız bölüm listesi (Önce Dükkanlar, sonra Daireler)
        var unitOrderList = new List<string>();
        for (int i = 1; i <= shopCount; i++) { unitOrderList.Add($"Dükkan {i}"); }
        for (int i = 1; i <= flatCount; i++) { unitOrderList.Add($"Daire {i}"); }
        // Normalizasyon fonksiyonu
        Func<string, string> normalizeUnitKey = u => {
            if (string.IsNullOrWhiteSpace(u)) return "";
            var s = u.Trim().ToLowerInvariant()
                .Replace("ı", "i").Replace("ç", "c").Replace("ş", "s").Replace("ğ", "g").Replace("ü", "u").Replace("ö", "o").Replace(" ", "");
            if (int.TryParse(s, out int n)) return $"daire{n}";
            return s;
        };
        // Eğer sistemde kayıtlı fakat standart listenin dışındaki birimler varsa onları da ekle
        foreach (var st in stakeholders)
        {
            if (!string.IsNullOrWhiteSpace(st.UnitNumbers))
            {
                string norm = normalizeUnitKey(st.UnitNumbers);
                if (!unitOrderList.Any(k => normalizeUnitKey(k) == norm))
                {
                    unitOrderList.Add(st.UnitNumbers.Trim());
                }
            }
        }
        if (!unitOrderList.Any())
        {
            unitOrderList.Add("Daire 1");
        }
    }
    <div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-2.5 px-3 bg-light border-bottom flex-wrap gap-2"
             role="button" data-bs-toggle="collapse" data-bs-target="#hakSahipleriCollapse" aria-expanded="true" aria-controls="hakSahipleriCollapse" style="cursor: pointer;">
            
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary fs-5"></i>
                <span class="fw-bold text-dark fs-6">1. Eski Bina Daire & Dükkan Hak Sahipleri</span>
                <span class="text-muted small">(@(shopCount) Dükkan, @(flatCount) Daire — Toplam @unitOrderList.Count Bağımsız Bölüm)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" 
                        onclick="event.stopPropagation(); openUnitOwnerModal('', '', '', '', '', '', '')">
                    <i class="bi bi-plus-circle me-1"></i>Hak Sahibi Ekle
                </button>
                <button class="btn btn-sm btn-white border rounded-pill px-2.5 py-1 fw-bold text-secondary" 
                        type="button" data-bs-toggle="collapse" data-bs-target="#hakSahipleriCollapse" aria-expanded="true" aria-controls="hakSahipleriCollapse" id="btnHakSahipleriToggle">
                    <span id="textHakSahipleriToggle">Daralt</span>
                    <i class="bi bi-chevron-up ms-1" id="iconHakSahipleriChevron"></i>
                </button>
            </div>
        </div>
        <div class="collapse show p-2 p-md-3" id="hakSahipleriCollapse">
            <div class="table-responsive rounded-3 border">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th style="width: 14%;">Bağımsız Bölüm</th>
                            <th style="width: 20%;">Hak Sahibi (Şahıs)</th>
                            <th style="width: 14%;">Telefon</th>
                            <th style="width: 18%;">E-Posta</th>
                            <th style="width: 18%;">Banka IBAN</th>
                            <th style="width: 8%;">Not</th>
                            <th class="text-end pe-3" style="width: 8%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unitName in unitOrderList)
                        {
                            string normName = normalizeUnitKey(unitName);
                            var unitOwners = stakeholders.Where(s => normalizeUnitKey(s.UnitNumbers) == normName).ToList();
                            if (!unitOwners.Any())
                            {
                                <tr class="table-light bg-opacity-25">
                                    <td class="fw-bold text-dark">
                                        @unitName
                                    </td>
                                    <td class="text-muted fst-italic">
                                        (Henüz kayıt girilmedi)
                                    </td>
                                    <td class="text-muted">—</td>
                                    <td class="text-muted">—</td>
                                    <td class="text-muted">—</td>
                                    <td class="text-muted">—</td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5" 
                                                onclick="openUnitOwnerModal('', '@unitName', '', '', '', '', '')">
                                            <i class="bi bi-plus me-1"></i>Ekle
                                        </button>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                for (int i = 0; i < unitOwners.Count; i++)
                                {
                                    var o = unitOwners[i];
                                    string fullNameVal = !string.IsNullOrWhiteSpace(o.User?.FirstName) || !string.IsNullOrWhiteSpace(o.User?.LastName)
                                        ? $"{o.User?.FirstName} {o.User?.LastName}".Trim()
                                        : (o.User?.DisplayName ?? o.User?.UserName ?? "");
                                    string phoneVal = o.User?.PhoneNumber ?? "";
                                    string emailVal = (o.User?.Email != null && !o.User.Email.EndsWith("@gmk360.local")) ? o.User.Email : "";
                                    string ibanVal = o.Iban ?? "";
                                    string notesVal = o.Notes ?? "";
                                    <tr>
                                        <!-- Bağımsız Bölüm -->
                                        <td>
                                            @if (i == 0)
                                            {
                                                <div class="fw-bold text-dark">
                                                    @unitName
                                                    @if (unitOwners.Count > 1)
                                                    {
                                                        <small class="text-muted fw-normal d-block">(@unitOwners.Count Hissedar)</small>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small ps-2">↳ @unitName</span>
                                            }
                                        </td>
                                        <!-- Hak Sahibi Adı -->
                                        <td class="fw-bold text-dark">
                                            @fullNameVal
                                        </td>
                                        <!-- Telefon -->
                                        <td class="font-monospace">
                                            @(string.IsNullOrWhiteSpace(phoneVal) ? "—" : phoneVal)
                                        </td>
                                        <!-- E-Posta -->
                                        <td class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(emailVal) ? "—" : emailVal)
                                        </td>
                                        <!-- IBAN -->
                                        <td class="font-monospace small">
                                            @(string.IsNullOrWhiteSpace(ibanVal) ? "—" : ibanVal)
                                        </td>
                                        <!-- Not -->
                                        <td class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(notesVal) ? "—" : notesVal)
                                        </td>
                                        <!-- İşlemler -->
                                        <td class="text-end pe-3">
                                            <div class="d-flex align-items-center justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm btn-light border rounded px-2 py-0 text-secondary" 
                                                        title="Düzenle: @fullNameVal"
                                                        onclick="openUnitOwnerModal('@o.Id', '@unitName', '@fullNameVal', '@phoneVal', '@emailVal', '@ibanVal', '@notesVal')">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-action="DeleteUnitStakeholder" asp-controller="ConstructionProject" method="post" class="d-inline" onsubmit="return confirm('@fullNameVal kaydı silinsin mi?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="projectId" value="@Model.Id" />
                                                    <input type="hidden" name="stakeholderId" value="@o.Id" />
                                                    <button type="submit" class="btn btn-sm btn-light border rounded px-2 py-0 text-danger" title="Sil">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                                @if (i == unitOwners.Count - 1)
                                                {
                                                    <button type="button" class="btn btn-sm btn-light border rounded px-1.5 py-0 text-primary ms-1" 
                                                            title="Bu daireye yeni hissedar ekle"
                                                            onclick="openUnitOwnerModal('', '@unitName', '', '', '', '', '')">
                                                        <i class="bi bi-person-plus"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

        @{
        var rentPolicy = ViewBag.RentPolicy as GMK360.Core.DTOs.Construction.ProjectRentPolicyDto ?? new GMK360.Core.DTOs.Construction.ProjectRentPolicyDto();
    }
    <!-- 1.1 BÖLÜM: KİRA & TAŞINMA BEDELLERİ POLİTİKASI -->
    <div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-2.5 px-3 bg-light border-bottom flex-wrap gap-2"
             role="button" data-bs-toggle="collapse" data-bs-target="#kiraBedellerCollapse" aria-expanded="true" aria-controls="kiraBedellerCollapse" style="cursor: pointer;">
            
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-cash-stack text-success fs-5"></i>
                <span class="fw-bold text-dark fs-6">Kira & Taşınma Bedelleri</span>
                <span class="text-muted small">(Daire ve dükkan bazında genel hakediş ve banka ödeme takvimi)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-white border rounded-pill px-2.5 py-1 fw-bold text-secondary" 
                        type="button" data-bs-toggle="collapse" data-bs-target="#kiraBedellerCollapse" aria-expanded="true" aria-controls="kiraBedellerCollapse" id="btnKiraBedellerToggle">
                    <span id="textKiraBedellerToggle">Daralt</span>
                    <i class="bi bi-chevron-up ms-1" id="iconKiraBedellerChevron"></i>
                </button>
            </div>
        </div>
        <div class="collapse show p-2 p-md-3" id="kiraBedellerCollapse">
            <form asp-action="SaveProjectRentPolicy" asp-controller="ConstructionProject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="applyToStakeholders" id="hfApplyToStakeholders" value="false" />
                <div class="table-responsive rounded-3 border mb-3">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th style="width: 16%;">Nitelik</th>
                                <th style="width: 14%;">Taşınma Bedeli</th>
                                <th style="width: 14%;">Aylık Kira</th>
                                <th style="width: 14%;">Başlama Tarihi</th>
                                <th style="width: 14%;">Bitiş Tarihi</th>
                                <th style="width: 14%;">Ödeme Günü</th>
                                <th style="width: 14%;">Emniyet (Gün)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Daireler İçin -->
                            <tr>
                                <td class="fw-bold text-dark">
                                    🏠 Daireler İçin
                                    <small class="text-muted d-block">(@flatCount Adet)</small>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="1000" name="FlatRelocationFee" class="form-control form-control-sm font-monospace fw-bold" value="@rentPolicy.FlatRelocationFee.ToString("0")" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="500" name="FlatMonthlyRent" class="form-control form-control-sm font-monospace fw-bold text-success" value="@rentPolicy.FlatMonthlyRent.ToString("0")" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </td>
                                <td>
                                    <input type="date" name="FlatStartDate" class="form-control form-control-sm" value="@(rentPolicy.FlatStartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
                                </td>
                                <td>
                                    <input type="date" name="FlatEndDate" class="form-control form-control-sm" value="@(rentPolicy.FlatEndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddMonths(18).ToString("yyyy-MM-dd"))" required />
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" min="1" max="31" name="FlatPaymentDay" class="form-control form-control-sm font-monospace fw-bold text-center" value="@rentPolicy.FlatPaymentDay" required />
                                        <span class="input-group-text text-muted" style="font-size:0.75rem;">. Günü</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" min="0" max="30" name="FlatGraceDays" class="form-control form-control-sm font-monospace fw-bold text-center text-primary" value="@rentPolicy.FlatGraceDays" required />
                                        <span class="input-group-text text-muted" style="font-size:0.75rem;">Gün</span>
                                    </div>
                                </td>
                            </tr>
                            <!-- Dükkanlar İçin -->
                            <tr>
                                <td class="fw-bold text-dark">
                                    🏢 Dükkanlar İçin
                                    <small class="text-muted d-block">(@shopCount Adet)</small>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="1000" name="ShopRelocationFee" class="form-control form-control-sm font-monospace fw-bold" value="@rentPolicy.ShopRelocationFee.ToString("0")" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="500" name="ShopMonthlyRent" class="form-control form-control-sm font-monospace fw-bold text-success" value="@rentPolicy.ShopMonthlyRent.ToString("0")" required />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </td>
                                <td>
                                    <input type="date" name="ShopStartDate" class="form-control form-control-sm" value="@(rentPolicy.ShopStartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
                                </td>
                                <td>
                                    <input type="date" name="ShopEndDate" class="form-control form-control-sm" value="@(rentPolicy.ShopEndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddMonths(18).ToString("yyyy-MM-dd"))" required />
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" min="1" max="31" name="ShopPaymentDay" class="form-control form-control-sm font-monospace fw-bold text-center" value="@rentPolicy.ShopPaymentDay" required />
                                        <span class="input-group-text text-muted" style="font-size:0.75rem;">. Günü</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" min="0" max="30" name="ShopGraceDays" class="form-control form-control-sm font-monospace fw-bold text-center text-primary" value="@rentPolicy.ShopGraceDays" required />
                                        <span class="input-group-text text-muted" style="font-size:0.75rem;">Gün</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!-- Eylem ve Finans Özet Çubuğu -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 bg-light p-2 px-3 rounded-3 border">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="small text-muted">
                            Aylık Kira Toplamı: <b class="text-success font-monospace fs-6">@(((flatCount * rentPolicy.FlatMonthlyRent) + (shopCount * rentPolicy.ShopMonthlyRent)).ToString("N0")) ₺ / Ay</b>
                        </span>
                        <span class="text-muted">|</span>
                        <span class="small text-muted">
                            Toplam Taşınma Yardımı: <b class="text-dark font-monospace fs-6">@(((flatCount * rentPolicy.FlatRelocationFee) + (shopCount * rentPolicy.ShopRelocationFee)).ToString("N0")) ₺</b>
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="submit" class="btn btn-sm btn-white border rounded-pill px-3 py-1 fw-bold text-dark shadow-xs" onclick="document.getElementById('hfApplyToStakeholders').value='false';">
                            <i class="bi bi-save me-1"></i>Bedelleri Kaydet
                        </button>
                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="document.getElementById('hfApplyToStakeholders').value='true';">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Bedelleri Hak Sahiplerine Dağıt
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. BÖLÜM: EVRAK, BÜROKRASİ VE RESMİ SÜREÇ MASASI (TÜM AŞAMALAR & ÖNKOŞUL ZİNCİRİ) -->
    @{
        decimal totalOfficialFee = ViewBag.TotalOfficialFee != null ? (decimal)ViewBag.TotalOfficialFee : initialDocs.Sum(x => x.DocumentFee ?? 0);
        decimal totalAdditionalFee = ViewBag.TotalAdditionalFee != null ? (decimal)ViewBag.TotalAdditionalFee : initialDocs.Sum(x => x.AdditionalCost ?? 0);
        var quotesList = ViewBag.Quotes as List<GMK360.Core.Entities.B2B.B2BQuoteRequest> ?? new List<GMK360.Core.Entities.B2B.B2BQuoteRequest>();
        var realizedDocIds = ViewBag.RealizedDocIds as HashSet<int> ?? new HashSet<int>();
    }
    <div class="card border border-primary border-opacity-25 rounded-3 bg-white mb-2 shadow-sm overflow-hidden" id="burokrasiSection">
        <div class="d-flex justify-content-between align-items-center p-2.5 px-3 bg-light border-bottom flex-wrap gap-2"
             role="button" data-bs-toggle="collapse" data-bs-target="#burokrasiCollapse" aria-expanded="true" aria-controls="burokrasiCollapse" style="cursor: pointer;">
            
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary text-white rounded-circle p-1.5 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-folder-check fs-5"></i>
                </span>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-bold text-dark fs-6">2. Evrak, Bürokrasi ve Resmi Süreç Masası (Tüm Aşamalar)</span>
                        <span class="badge bg-warning text-dark border border-warning px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">
                            <i class="bi bi-diagram-3-fill me-1"></i>Önkoşul Zinciri: Bu Evrak Olmadan O Alınmaz / O İş Başlamaz
                        </span>
                    </div>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Bina inşaat maliyeti dışında kalan tüm resmi harç, proje, ruhsat, yapı denetim ve iskan giderleri (Eski proje / merkez havuz fiyatlarıyla)</small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-1.5 flex-wrap" onclick="event.stopPropagation();">
                <span class="badge bg-primary text-white px-2.5 py-1 rounded-pill fw-bold shadow-xs" id="badgeTotalCost" style="font-size: 0.76rem;">
                    <i class="bi bi-wallet2 me-1"></i>Toplam Bürokrasi: @totalInitialFee.ToString("N2") ₺
                </span>
                <span class="badge bg-success bg-opacity-15 text-success border border-success px-2 py-1 rounded-pill fw-bold" style="font-size: 0.74rem;" id="badgeCompletedCount">
                    <i class="bi bi-file-earmark-check me-1"></i>@completedCount / @initialDocs.Count Tamamlandı
                </span>
                <form method="post" action="/PhaseZero/SyncDocs/@Model.Id" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-warning text-dark rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" style="font-size: 0.73rem;" title="Eski projelerde gerçekleşen fiyatları ve merkez havuz evrak şablonlarını senkronize et">
                        <i class="bi bi-arrow-repeat me-1"></i>Eski Proje / Havuzdan Çek
                    </button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" style="font-size: 0.73rem;" data-bs-toggle="modal" data-bs-target="#addCustomDocModal">
                    <i class="bi bi-plus-lg me-1"></i>Özel Evrak Ekle
                </button>
                <button class="btn btn-sm btn-white border rounded-pill px-2.5 py-0.5 fw-bold d-flex align-items-center gap-1 shadow-xs text-secondary" 
                        type="button" data-bs-toggle="collapse" data-bs-target="#burokrasiCollapse" aria-expanded="true" aria-controls="burokrasiCollapse" id="btnBurokrasiToggle" style="font-size: 0.74rem;">
                    <span id="textBurokrasiToggle">Daralt</span>
                    <i class="bi bi-chevron-up ms-1" id="iconBurokrasiChevron"></i>
                </button>
            </div>
        </div>

        <div class="collapse show p-2 p-md-3" id="burokrasiCollapse">
            <!-- 4 KARTLI ÖZET ŞERİDİ -->
            <div class="row g-2 mb-3">
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-primary text-white d-flex justify-content-between align-items-center shadow-xs">
                        <div>
                            <small class="d-block opacity-75 fw-bold" style="font-size: 0.68rem;">TOPLAM BÜROKRASİ & EVRAK MALİYETİ</small>
                            <span class="fs-5 fw-bold font-monospace">@totalInitialFee.ToString("N2") ₺</span>
                        </div>
                        <i class="bi bi-wallet2 fs-4 opacity-75"></i>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block fw-bold" style="font-size: 0.68rem;">RESMİ HARÇLAR & KURUM ÜCRETLERİ</small>
                            <span class="fs-6 fw-bold text-dark font-monospace">@totalOfficialFee.ToString("N2") ₺</span>
                        </div>
                        <i class="bi bi-bank fs-4 text-secondary"></i>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block fw-bold" style="font-size: 0.68rem;">EK GİDER / YAN MASRAF / HİZMET</small>
                            <span class="fs-6 fw-bold text-danger font-monospace">@totalAdditionalFee.ToString("N2") ₺</span>
                        </div>
                        <i class="bi bi-cash-coin fs-4 text-danger"></i>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-muted fw-bold" style="font-size: 0.68rem;">EVRAK & ÖNKOŞUL ZİNCİRİ</small>
                                <span class="badge bg-success" style="font-size: 0.68rem;">@completedCount / @initialDocs.Count</span>
                            </div>
                            @{
                                int docPct = initialDocs.Count > 0 ? (completedCount * 100) / initialDocs.Count : 0;
                            }
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @docPct%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!initialDocs.Any())
            {
                <div class="alert alert-info rounded-3 p-3 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <i class="bi bi-info-circle-fill me-1"></i> Henüz evrak listesi senkronize edilmedi. Eski proje fiyatlarıyla tüm aşamaları çekmek için tıklayın.
                    </div>
                    <form method="post" action="/PhaseZero/SyncDocs/@Model.Id" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                            <i class="bi bi-cloud-download me-1"></i> Şablonları ve Eski Fiyatları Çek
                        </button>
                    </form>
                </div>
            }
            else
            {
                var groupedStages = initialDocs.GroupBy(d => string.IsNullOrWhiteSpace(d.Stage) ? "1. Aşama: Ön Keşif & İmar Bürokrasisi" : d.Stage).ToList();
                int stgIdx = 0;
                foreach (var stageGroup in groupedStages)
                {
                    stgIdx++;
                    string stgCollapseId = "analysisStageCollapse_" + stgIdx;
                    decimal stageSubTotal = stageGroup.Sum(x => (x.DocumentFee ?? 0) + (x.AdditionalCost ?? 0));
                    int stageDoneCount = stageGroup.Count(x => x.Status == "Alındı" || x.Status == "Tamamlandı");
                    <div class="card border rounded-3 mb-2.5 overflow-hidden shadow-xs">
                        <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-light border-bottom flex-wrap gap-2"
                             role="button" data-bs-toggle="collapse" data-bs-target="#@stgCollapseId" aria-expanded="true" style="cursor: pointer;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-folder2-open text-primary fs-6"></i>
                                <span class="fw-bold text-dark" style="font-size: 0.88rem;">@stageGroup.Key</span>
                                <span class="badge bg-primary rounded-pill" style="font-size: 0.70rem;">@stageGroup.Count() Evrak</span>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill" style="font-size: 0.68rem;">@stageDoneCount / @stageGroup.Count() Hazır</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-primary font-monospace small">Aşama Toplamı: @stageSubTotal.ToString("N2") ₺</span>
                                <i class="bi bi-chevron-down text-muted small"></i>
                            </div>
                        </div>
                        <div id="@stgCollapseId" class="collapse show">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="font-size: 0.84rem;">
                                    <thead class="table-light text-muted small text-uppercase">
                                        <tr>
                                            <th class="ps-3" style="width: 32%;">Evrak / Süreç Adı & Önkoşul Zinciri</th>
                                            <th style="width: 20%;">Kimden Alınır / Kurum</th>
                                            <th style="width: 13%;">Takipçi (Sorumlu)</th>
                                            <th class="text-end" style="width: 13%;">Resmi + Yan Maliyet</th>
                                            <th class="text-center" style="width: 9%;">Durum</th>
                                            <th class="text-end pe-3" style="width: 13%;">Fiyat Araştır / Yönet</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in stageGroup.OrderBy(x => x.DisplayOrder))
                                        {
                                            decimal lineTotal = (doc.DocumentFee ?? 0) + (doc.AdditionalCost ?? 0);
                                            var matchingRule = stageRules?.FirstOrDefault(r => r.SystemLegalDocumentTemplateId == doc.SystemTemplateId);
                                            var prereqs = matchingRule?.Prerequisites?.ToList();
                                            bool isDependent = prereqs != null && prereqs.Any();
                                            bool isReadyToApply = true;
                                            int completedPrereqCount = 0;
                                            if (isDependent)
                                            {
                                                foreach (var pr in prereqs!)
                                                {
                                                    var cDoc = initialDocs.FirstOrDefault(d => d.SystemTemplateId == pr.PrerequisiteTemplateId);
                                                    if (cDoc != null && (cDoc.Status == "Alındı" || cDoc.Status == "Tamamlandı"))
                                                    {
                                                        completedPrereqCount++;
                                                    }
                                                    else
                                                    {
                                                        isReadyToApply = false;
                                                    }
                                                }
                                            }
                                            // Bu evrak hangi sonraki evrakların zorunlu önkoşulu? ("Bu evrak olmadan bu alınmaz!")
                                            var unlocksRules = stageRules?
                                                .Where(r => r.Prerequisites != null && r.Prerequisites.Any(p => p.PrerequisiteTemplateId == doc.SystemTemplateId))
                                                .ToList() ?? new List<ModuleDocumentRule>();

                                            var relatedQuote = quotesList.FirstOrDefault(q => q.SourceReferenceId == doc.Id);
                                            var submittedQ = relatedQuote?.Invites.Count(i => i.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Submitted || i.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Accepted || (i.OfferNotes != null && i.OfferNotes.Contains("KEŞİF"))) ?? 0;
                                            decimal bestPrice = submittedQ > 0 ? (relatedQuote!.Invites.Where(i => i.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Submitted || i.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Accepted || (i.OfferNotes != null && i.OfferNotes.Contains("KEŞİF"))).Min(i => i.OfferedPrice) ?? 0) : 0;
                                            bool isFromOldProject = realizedDocIds.Contains(doc.Id);

                                            <tr data-bs-toggle="@(isDependent ? "collapse" : "")" data-bs-target=".analysis-child-of-@doc.Id" style="@(isDependent ? "cursor: pointer;" : "")">
                                                <td class="ps-3">
                                                    <div class="d-flex align-items-start gap-2">
                                                        @if (isDependent)
                                                        {
                                                            <i class="bi bi-chevron-expand text-primary mt-1"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-file-earmark-text text-secondary mt-1"></i>
                                                        }
                                                        <div>
                                                            <div class="fw-bold @(isDependent && !isReadyToApply ? "text-danger" : "text-dark")">
                                                                @doc.DocumentName
                                                                @if (!string.IsNullOrWhiteSpace(doc.FilePath))
                                                                {
                                                                    <a href="@doc.FilePath" target="_blank" class="ms-1 text-success" title="Yüklenen Belgeyi Gör" onclick="event.stopPropagation();">
                                                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                                                    </a>
                                                                }
                                                            </div>
                                                            @if (isDependent)
                                                            {
                                                                @if (!isReadyToApply)
                                                                {
                                                                    <small class="text-danger d-block mt-0.5" style="font-size: 0.72rem;">
                                                                        <i class="bi bi-lock-fill me-1"></i><b>Önkoşul Kilidi:</b> Altındaki @(prereqs!.Count - completedPrereqCount) zorunlu evrak alınmadan bu evrak alınamaz! <span class="text-decoration-underline">(Tıklayıp alt evrakları açın)</span>
                                                                    </small>
                                                                }
                                                                else
                                                                {
                                                                    <small class="text-success d-block mt-0.5" style="font-size: 0.72rem;">
                                                                        <i class="bi bi-unlock-fill me-1"></i>Tüm alt önkoşul evrakları tamam (@completedPrereqCount/@prereqs!.Count) — Başvuruya hazır.
                                                                    </small>
                                                                }
                                                            }
                                                            @if (unlocksRules.Any())
                                                            {
                                                                <div class="mt-1">
                                                                    <span class="badge bg-warning bg-opacity-15 text-dark border border-warning fw-normal text-wrap text-start" style="font-size: 0.68rem;">
                                                                        <i class="bi bi-arrow-right-circle-fill text-warning me-1"></i><b>Bu olmadan alınamaz:</b> @string.Join(", ", unlocksRules.Select(r => r.SystemLegalDocumentTemplate?.Name).Where(n => !string.IsNullOrEmpty(n)).Take(2))@(unlocksRules.Count > 2 ? $" (+{unlocksRules.Count - 2} süreç daha)" : "")
                                                                    </span>
                                                                </div>
                                                            }
                                                            @if (doc.LinkedPhaseCategory.HasValue)
                                                            {
                                                                <div class="mt-1">
                                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size: 0.68rem;">
                                                                        <i class="bi bi-cone-striped me-1"></i>Bu evrak olmadan <b>@doc.LinkedPhaseCategory.Value</b> fazı başlayamaz!
                                                                    </span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted small">
                                                        <i class="bi bi-building me-1"></i>@(string.IsNullOrWhiteSpace(doc.InstitutionContact) ? (doc.SystemTemplate?.IssuedBy ?? "İlgili Belediye / Kurum") : doc.InstitutionContact)
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(doc.AssignedUserId))
                                                    {
                                                        <span class="badge bg-light text-dark border px-2 py-1">
                                                            <i class="bi bi-person-check-fill text-primary me-1"></i>@doc.AssignedUserId
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic small">Atanmadı</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold font-monospace">
                                                    @if (bestPrice > 0)
                                                    {
                                                        <span class="text-success">@bestPrice.ToString("N2") ₺</span>
                                                        <div class="text-success fw-normal" style="font-size: 0.66rem;">En Uygun Yeni Teklif</div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-primary">@lineTotal.ToString("N2") ₺</span>
                                                        @if ((doc.AdditionalCost ?? 0) > 0)
                                                        {
                                                            <div class="text-danger fw-normal" style="font-size: 0.66rem;">(+@((doc.AdditionalCost ?? 0).ToString("N0")) ₺ yan gider)</div>
                                                        }
                                                        <div class="text-muted fw-normal" style="font-size: 0.66rem;">
                                                            @if (isFromOldProject)
                                                            {
                                                                <i class="bi bi-clock-history text-success me-1"></i><span class="text-success fw-semibold">Eski Proje Fiyatı</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-database-check text-primary me-1"></i><span>Merkez Havuz Referans</span>
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (isDependent && !isReadyToApply)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill" style="font-size: 0.70rem;">
                                                            <i class="bi bi-lock-fill me-1"></i>Kilitli (@completedPrereqCount/@prereqs!.Count)
                                                        </span>
                                                    }
                                                    else if (doc.Status == "Alındı" || doc.Status == "Tamamlandı")
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" style="font-size: 0.70rem;">
                                                            <i class="bi bi-check-circle-fill me-1"></i>Alındı
                                                        </span>
                                                    }
                                                    else if (doc.Status == "Fiyat Araştırılıyor")
                                                    {
                                                        <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="font-size: 0.70rem;">
                                                            <i class="bi bi-search me-1"></i>Araştırılıyor
                                                        </span>
                                                    }
                                                    else if (doc.Status == "Başvuru Yapıldı" || doc.Status == "İşlemde")
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded-pill" style="font-size: 0.70rem;">
                                                            <i class="bi bi-send me-1"></i>Başvuruldu
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border px-2 py-1 rounded-pill" style="font-size: 0.70rem;">
                                                            Bekliyor
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-end pe-3" onclick="event.stopPropagation();">
                                                    <div class="d-flex justify-content-end gap-1">
                                                        @if (relatedQuote != null)
                                                        {
                                                            <a href="/B2BPurchasing/Details/@relatedQuote.Id" class="btn btn-sm btn-info text-white rounded-pill px-2 py-0.5 fw-bold shadow-xs" style="font-size: 0.72rem;" title="Gelen teklifleri gör ve firma seç">
                                                                <i class="bi bi-box-arrow-up-right me-1"></i>İhaleye Git
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <form method="post" action="/PhaseZero/RequestQuote/@doc.Id" class="m-0 d-inline">
                                                                <button type="submit" class="btn btn-sm btn-warning text-dark rounded-pill px-2 py-0.5 fw-bold shadow-xs" style="font-size: 0.72rem;" title="Kurumlardan veya yeni firmalardan fiyat araştırması / teklif başlat">
                                                                    <i class="bi bi-search me-1"></i>Araştır / Teklif
                                                                </button>
                                                            </form>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" style="font-size: 0.72rem;" onclick="openDocModal(@doc.Id)">
                                                            <i class="bi bi-pencil-square me-1"></i>Yönet
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>

                                            @if (isDependent)
                                            {
                                                foreach (var pr in prereqs!)
                                                {
                                                    var childDoc = initialDocs.FirstOrDefault(d => d.SystemTemplateId == pr.PrerequisiteTemplateId);
                                                    if (childDoc != null)
                                                    {
                                                        bool isChildDone = childDoc.Status == "Alındı" || childDoc.Status == "Tamamlandı";
                                                        decimal childTotal = (childDoc.DocumentFee ?? 0) + (childDoc.AdditionalCost ?? 0);
                                                        <tr class="collapse analysis-child-of-@doc.Id bg-light" style="border-left: 4px solid @(isChildDone ? "#198754" : "#dc3545");">
                                                            <td class="ps-4 py-1.5">
                                                                <div class="d-flex align-items-center gap-2 ps-3">
                                                                    <i class="bi bi-arrow-return-right @(isChildDone ? "text-success" : "text-danger")"></i>
                                                                    <div>
                                                                        <span class="fw-bold text-dark">@childDoc.DocumentName</span>
                                                                        <span class="badge @(isChildDone ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") border ms-1" style="font-size: 0.65rem;">
                                                                            Zorunlu Önkoşul (@doc.DocumentName için şart)
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="py-1.5 small text-muted">
                                                                @(string.IsNullOrWhiteSpace(childDoc.InstitutionContact) ? (childDoc.SystemTemplate?.IssuedBy ?? "İlgili Kurum") : childDoc.InstitutionContact)
                                                            </td>
                                                            <td class="py-1.5 small">
                                                                @(string.IsNullOrWhiteSpace(childDoc.AssignedUserId) ? "Atanmadı" : childDoc.AssignedUserId)
                                                            </td>
                                                            <td class="text-end py-1.5 fw-bold font-monospace small">
                                                                @childTotal.ToString("N2") ₺
                                                            </td>
                                                            <td class="text-center py-1.5">
                                                                <span class="badge @(isChildDone ? "bg-success text-white" : "bg-warning text-dark") rounded-pill" style="font-size: 0.68rem;">
                                                                    @(isChildDone ? "Hazır" : "Bekliyor")
                                                                </span>
                                                            </td>
                                                            <td class="text-end pe-3 py-1.5">
                                                                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0 fw-bold" style="font-size: 0.70rem;" onclick="openDocModal(@childDoc.Id)">
                                                                    Yönet
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- 3. BÖLÜM: ESKİ BİNA DURUMU & KEŞİF VERİLERİ -->

    <div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">

        <div class="d-flex justify-content-between align-items-center p-2 px-3 bg-light border-bottom flex-wrap gap-1"

             role="button" data-bs-toggle="collapse" data-bs-target="#eskiBinaCollapse" aria-expanded="false" aria-controls="eskiBinaCollapse" style="cursor: pointer;">

            

            <div class="d-flex align-items-center gap-2">

                <i class="bi bi-building-down text-warning fs-5"></i>

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <span class="fw-bold text-dark small" style="font-size: 0.88rem;">3. Eski Bina Durumu & Keşif Verileri</span>

                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-1.5 py-0 rounded-pill" style="font-size: 0.68rem;">

                        <i class="bi bi-cone-striped me-1"></i>Yıkılacak Yapı Havuzu

                    </span>

                    <small class="text-muted d-none d-lg-inline" style="font-size: 0.72rem;">Mevcut bina özellikleri, kat/daire kütüğü ve saha keşfi</small>

                </div>

            </div>

            <div class="d-flex align-items-center gap-1.5 flex-wrap" >

                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill" style="font-size: 0.74rem;">

                    <i class="bi bi-calendar-event me-1"></i>Yaş: <b>@(Model.BuildingAge.HasValue ? Model.BuildingAge + " Yaş" : "Bilinmiyor")</b>

                </span>

                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill" style="font-size: 0.74rem;">

                    <i class="bi bi-layers me-1"></i>Kat: <b>@(Model.EskiKatSayisi ?? 0)</b>

                </span>

                <span class="badge bg-warning bg-opacity-15 text-dark border border-warning px-2 py-1 rounded-pill" style="font-size: 0.74rem;">

                    <i class="bi bi-door-open me-1"></i>Daire: <b>@(Model.EskiDaireSayisi ?? 0)</b> | Dükkan: <b>@(Model.EskiDukkanSayisi ?? 0)</b>

                </span>

                <button class="btn btn-sm btn-white border rounded-pill px-2.5 py-0 fw-bold d-flex align-items-center gap-1 shadow-xs text-secondary" 

                        type="button" data-bs-toggle="collapse" data-bs-target="#eskiBinaCollapse" aria-expanded="false" aria-controls="eskiBinaCollapse" id="btnEskiBinaToggle" style="font-size: 0.74rem;">

                    <span id="textEskiBinaToggle">Genişlet</span>

                    <i class="bi bi-chevron-down ms-1" id="iconEskiBinaChevron"></i>

                </button>

            </div>

        </div>

        <div class="collapse p-2 p-md-3" id="eskiBinaCollapse">

            <!-- METRİK ÖZET KARTLARI -->

            <div class="row g-2 mb-3">

                <div class="col-6 col-md-3">

                    <div class="p-2 border rounded-3 bg-light text-center">

                        <span class="text-muted d-block small" style="font-size: 0.72rem;">Toplam Bağımsız Bölüm</span>

                        <span class="fw-bold text-dark fs-6">@((Model.EskiDaireSayisi ?? 0) + (Model.EskiDukkanSayisi ?? 0)) <small class="text-muted fw-normal" style="font-size: 0.72rem;">Adet</small></span>

                    </div>

                </div>

                <div class="col-6 col-md-3">

                    <div class="p-2 border rounded-3 bg-light text-center">

                        <span class="text-muted d-block small" style="font-size: 0.72rem;">Mevcut Brüt Alan</span>

                        <span class="fw-bold text-dark fs-6">@(Model.EskiToplamMetrekare.HasValue ? Model.EskiToplamMetrekare.Value.ToString("N0") : (landArea * 1.5).ToString("N0")) <small class="text-muted fw-normal" style="font-size: 0.72rem;">m²</small></span>

                    </div>

                </div>

                <div class="col-6 col-md-3">

                    <div class="p-2 border rounded-3 bg-light text-center">

                        <span class="text-muted d-block small" style="font-size: 0.72rem;">Arsa / Parsel Alanı</span>

                        <span class="fw-bold text-dark fs-6">@(Model.TotalLandArea.HasValue ? Model.TotalLandArea.Value.ToString("N0") : "-") <small class="text-muted fw-normal" style="font-size: 0.72rem;">m²</small></span>

                    </div>

                </div>

                <div class="col-6 col-md-3">

                    <div class="p-2 border rounded-3 bg-light text-center">

                        <span class="text-muted d-block small" style="font-size: 0.72rem;">Riskli Yapı Raporu</span>

                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-0.5 rounded-pill" style="font-size: 0.72rem;">

                            <i class="bi bi-clock-history me-1"></i>Keşif Aşamasında

                        </span>

                    </div>

                </div>

            </div>

            <!-- BİNA BİLGİ DETAYLARI -->

            <div class="p-2.5 bg-light rounded-3 border mb-2">

                <div class="row g-2 align-items-center" style="font-size: 0.82rem;">

                    <div class="col-md-6">

                        <i class="bi bi-geo-alt text-danger me-1"></i><b>Adres / Kapı No:</b> @(string.IsNullOrEmpty(Model.Address) ? "Belirtilmedi" : Model.Address)

                    </div>

                    <div class="col-md-3">

                        <i class="bi bi-pin-map text-primary me-1"></i><b>Ada / Parsel:</b> @(string.IsNullOrEmpty(Model.Ada) ? "-" : Model.Ada) / @(string.IsNullOrEmpty(Model.Parsel) ? "-" : Model.Parsel)

                    </div>

                    <div class="col-md-3 text-md-end">

                        <a href="/ConstructionProject/Workspace/@Model.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0 fw-bold" style="font-size: 0.74rem;">

                            <i class="bi bi-pencil me-1"></i>Künyede Güncelle

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- 3. BÖLÜM: 5 BOYUTLU PROJE RÖNTGENİ, SAHA/ZEMİN/YIKIM KEŞFİ VE GO / NO-GO KARAR MASASI -->
    <div class="card border border-primary border-opacity-25 rounded-3 bg-white mb-2 shadow-sm overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-2.5 px-3 bg-light border-bottom flex-wrap gap-2"
             role="button" data-bs-toggle="collapse" data-bs-target="#fazlarCollapse" aria-expanded="true" aria-controls="fazlarCollapse" style="cursor: pointer;">
            
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-circle p-1.5 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-clipboard2-pulse-fill fs-5"></i>
                </span>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-bold text-dark fs-6">4. Detaylı İnceleme (Proje Röntgeni) & GO / NO-GO Karar Masası</span>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">
                            <i class="bi bi-shield-check me-1"></i>5 Hayati İnceleme Adımı & Sözleşme Kalkanı
                        </span>
                    </div>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Hukuki takyidat, komşu bina/iksa/yıkım modu, zemin/istinat/kazık maliyeti ve teklife aktarılacak sözleşme koruma maddeleri</small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-1.5 flex-wrap" onclick="event.stopPropagation();">
                @{
                    string curDec = rentPolicy.GoNoGoDecision ?? "CONDITIONAL_GO";
                    string decBadgeClass = curDec == "GO" ? "bg-success text-white" : (curDec == "NO_GO" ? "bg-danger text-white" : "bg-warning text-dark border border-warning");
                    string decBadgeText = curDec == "GO" ? "🟢 GİRİLİR (GO)" : (curDec == "NO_GO" ? "🔴 GİRİLMEZ (NO-GO)" : "🟡 ŞARTLI GİRİLİR");
                }
                <span class="badge @decBadgeClass px-2.5 py-1 rounded-pill fw-bold" id="headerGoNoGoBadge" style="font-size: 0.74rem;">
                    @decBadgeText
                </span>
                <button class="btn btn-sm btn-white border rounded-pill px-2.5 py-0.5 fw-bold d-flex align-items-center gap-1 shadow-xs text-secondary" 
                        type="button" data-bs-toggle="collapse" data-bs-target="#fazlarCollapse" aria-expanded="true" aria-controls="fazlarCollapse" id="btnFazlarToggle" style="font-size: 0.74rem;">
                    <span id="textFazlarToggle">Daralt</span>
                    <i class="bi bi-chevron-up ms-1" id="iconFazlarChevron"></i>
                </button>
            </div>
        </div>

        <div class="collapse show p-2.5 p-md-3" id="fazlarCollapse">
            <form asp-action="SaveAnalysisRontgen" asp-controller="ConstructionProject" method="post" id="rontgenForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="proceedToProposal" id="hfProceedToProposal" value="false" />

                <div class="row g-3 mb-3">
                    <!-- ADIM A: HUKUKİ & MALİK TARAMASI -->
                    <div class="col-xl-6">
                        <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100">
                            <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                <span class="fw-bold text-dark small">
                                    <i class="bi bi-bank2 text-danger me-1"></i>A. Hukuki & Malik Taraması (Tapu & Uzlaşı Röntgeni)
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" id="badgeRiskLegal" style="font-size: 0.68rem;">Düşük Risk</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Tapu Takyidat / Haciz / İpotek</label>
                                    <select name="titleDeedEncumbranceStatus" id="selTitleDeed" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Temiz (Şerh/İpotek Yok)" selected="@(rentPolicy.TitleDeedEncumbranceStatus == "Temiz (Şerh/İpotek Yok)")">🟢 Temiz (Şerh/İpotek Yok)</option>
                                        <option value="Kredili/İpotekli Malik Var (Çözülebilir)" selected="@(rentPolicy.TitleDeedEncumbranceStatus == "Kredili/İpotekli Malik Var (Çözülebilir)")">🟡 Kredili/İpotekli Malik Var</option>
                                        <option value="Kamulaştırma / Davalı / Ağır Haciz (Kritik Risk)" selected="@(rentPolicy.TitleDeedEncumbranceStatus == "Kamulaştırma / Davalı / Ağır Haciz (Kritik Risk)")">🔴 Kamulaştırma / Ağır Haciz</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Veraset / Mirasçılık Durumu</label>
                                    <select name="inheritanceStatus" id="selInheritance" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Sorunsuz (Tüm Malikler Sağ/Net)" selected="@(rentPolicy.InheritanceStatus == "Sorunsuz (Tüm Malikler Sağ/Net)")">🟢 Sorunsuz (Malikler Sağ/Net)</option>
                                        <option value="Mirasçılı Daire Var (İntikal Bekliyor)" selected="@(rentPolicy.InheritanceStatus == "Mirasçılı Daire Var (İntikal Bekliyor)")">🟡 Mirasçılı Daire (İntikal Bekliyor)</option>
                                        <option value="Ulaşılamayan / Yurt Dışı Hissedar Var (Kritik)" selected="@(rentPolicy.InheritanceStatus == "Ulaşılamayan / Yurt Dışı Hissedar Var (Kritik)")">🔴 Ulaşılamayan / Davalı Mirasçı</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Malik Uzlaşı & Arıza Malik</label>
                                    <select name="hostileOwnerStatus" id="selHostileOwner" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Tam Uzlaşı (%100 İstekli)" selected="@(rentPolicy.HostileOwnerStatus == "Tam Uzlaşı (%100 İstekli)")">🟢 Tam Uzlaşı (%100 İstekli)</option>
                                        <option value="2/3 Çoğunluk Sağlanıyor (1-2 Çekimser)" selected="@(rentPolicy.HostileOwnerStatus == "2/3 Çoğunluk Sağlanıyor (1-2 Çekimser)")">🟡 2/3 Çoğunluk Var (1-2 Çekimser)</option>
                                        <option value="Müteahhitleri Bıktıran Arıza Malik Var (Kritik)" selected="@(rentPolicy.HostileOwnerStatus == "Müteahhitleri Bıktıran Arıza Malik Var (Kritik)")">🔴 Arıza Malik / İmkansız Talep</option>
                                    </select>
                                </div>
                                <div class="col-12 mt-2">
                                    <input type="text" name="legalCheckNotes" id="inpLegalNotes" class="form-control form-control-sm" value="@rentPolicy.LegalCheckNotes" placeholder="Hukuki/Malik özel notu (Örn: 3. kattaki dairenin veraset ilamı 15 gün içinde çıkacak...)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ADIM B: SAHA, KOMŞU BİNA, BİTİŞİK NİZAM / İKSA & YIKIM OPERASYON MASASI -->
                    <div class="col-xl-6">
                        <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100">
                            <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                <span class="fw-bold text-dark small">
                                    <i class="bi bi-cone-striped text-warning me-1"></i>B. Komşu Bina, Bitişik Nizam / İksa & Yıkım Keşfi
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" id="badgeRiskNeighbor" style="font-size: 0.68rem;">Düşük Risk</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Bina Nizam & Komşu Durumu</label>
                                    <select name="adjacentBuildingRisk" id="selNeighborRisk" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Ayrık Nizam (Risksiz)" selected="@(rentPolicy.AdjacentBuildingRisk == "Ayrık Nizam (Risksiz)" || rentPolicy.BuildingOrderType == "Ayrık Nizam")">🟢 Ayrık Nizam (Risksiz)</option>
                                        <option value="Tek Yandan Bitişik Nizam" selected="@(rentPolicy.AdjacentBuildingRisk == "Tek Yandan Bitişik Nizam" || rentPolicy.BuildingOrderType == "Tek Yandan Bitişik Nizam")">🟡 Tek Yandan Bitişik Nizam</option>
                                        <option value="İki Yandan Bitişik (Kritik İksa Riski)" selected="@(rentPolicy.AdjacentBuildingRisk == "İki Yandan Bitişik (Kritik İksa Riski)" || rentPolicy.BuildingOrderType == "İki Yandan Bitişik Nizam")">🔴 İki Yandan Bitişik (Kritik)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">İksa & Komşu Güçlendirme</label>
                                    <select name="shoringRequirement" id="selShoringReq" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Gerekmiyor" selected="@(rentPolicy.ShoringRequirement == "Gerekmiyor")">🟢 İksa Gerekmiyor</option>
                                        <option value="Standart Mini Kazık / İksa" selected="@(rentPolicy.ShoringRequirement == "Standart Mini Kazık / İksa")">🟡 Standart Mini Kazık / İksa</option>
                                        <option value="Ağır İksa + Komşu Temel Güçlendirme" selected="@(rentPolicy.ShoringRequirement == "Ağır İksa + Komşu Temel Güçlendirme")">🔴 Ağır İksa + Komşu Güçlendirme</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Tahmini İksa Maliyeti (₺)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="50000" name="estimatedShoringCost" id="inpShoringCost" class="form-control fw-bold text-danger" value="@rentPolicy.EstimatedShoringCost.ToString("0")" oninput="recalculateRontgenAndDecision()" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Yıkım Operasyon Modu (Çift Modül)</label>
                                    <select name="demolitionExecutionMode" id="selDemolitionMode" class="form-select form-select-sm fw-bold text-primary" onchange="recalculateRontgenAndDecision()">
                                        <option value="Dışarıdan Yıkım Firmasına İhale Edilecek (Enkaz Karşılığı / Nakit)" selected="@(rentPolicy.DemolitionExecutionMode.StartsWith("Dışarıdan"))">🚜 Dışarıdan Yıkım Firmasına İhale</option>
                                        <option value="Kendi Bünyemizde Yıkılacak (Firma Makine Parkı & Ekibiyle)" selected="@(rentPolicy.DemolitionExecutionMode.StartsWith("Kendi"))">🏗️ Kendi Bünyemizde Yıkılacak</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Sokak & Vinç/Mikser Lojistiği</label>
                                    <select name="streetLogisticsStatus" id="selStreetLogistics" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Geniş Sokak (Mikser/Vinç Rahat Girer)" selected="@(rentPolicy.StreetLogisticsStatus.StartsWith("Geniş"))">🟢 Geniş Sokak (Rahat)</option>
                                        <option value="Dar Sokak / Trafo / Ağaç Engeli Var" selected="@(rentPolicy.StreetLogisticsStatus.StartsWith("Dar"))">🟡 Dar Sokak / Engel Var</option>
                                        <option value="Çok Dar / Saat Kısıtlamalı (Ek Lojistik Maliyeti)" selected="@(rentPolicy.StreetLogisticsStatus.StartsWith("Çok Dar"))">🔴 Çok Dar / Kısıtlamalı</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Yıkım Sigorta/Noter (₺)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="10000" name="demolitionExtraPolicyCost" id="inpDemolitionPolicyCost" class="form-control fw-bold" value="@rentPolicy.DemolitionExtraPolicyCost.ToString("0")" oninput="recalculateRontgenAndDecision()" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <div class="col-12 mt-1">
                                    <div class="p-2 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-50 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" name="requireDemolitionShield" id="chkDemolitionShield" value="true" @(rentPolicy.RequireDemolitionShield ? "checked" : "") onchange="recalculateRontgenAndDecision()" />
                                            <label class="form-check-label fw-bold text-dark" for="chkDemolitionShield" style="font-size: 0.72rem;" id="lblDemolitionShieldNote">
                                                🛡️ Komşu Bina Noter Delil Tespiti + All-Risk Komşu Mali Mesuliyet Sigortası ve Teminat Kalkanı Zorunlu Olsun
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ADIM C: ZEMİN, İSTİNAT VE KAZIK RİSK MASASI ("SÜRPRİZ MALİYET KALKANI") -->
                    <div class="col-xl-7">
                        <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100">
                            <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                <span class="fw-bold text-dark small">
                                    <i class="bi bi-layers-half text-primary me-1"></i>C. Zemin, İstinat ve Kazık Risk Masası ("Sürpriz Maliyet Kalkanı")
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" id="badgeRiskGround" style="font-size: 0.68rem;">Düşük Risk</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Arsa Eğimi & İstinat Duvarı</label>
                                    <select name="landSlopeStatus" id="selLandSlope" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Düz Arsa (İstinat Gerekmez)" selected="@(rentPolicy.LandSlopeStatus.StartsWith("Düz"))">🟢 Düz Arsa (İstinat Yok)</option>
                                        <option value="Eğimli Arsa (Normal İstinat Duvarı)" selected="@(rentPolicy.LandSlopeStatus.StartsWith("Eğimli"))">🟡 Eğimli Arsa (İstinat Duvarı)</option>
                                        <option value="Dik Yamaç / Heyelan Riski (Ağır İstinat)" selected="@(rentPolicy.LandSlopeStatus.StartsWith("Dik"))">🔴 Dik Yamaç / Ağır İstinat</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Zemin Taşıma & Kazık Durumu</label>
                                    <select name="soilBearingStatus" id="selSoilBearing" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Sağlam Zemin (Radye Temel Yeterli)" selected="@(rentPolicy.SoilBearingStatus.StartsWith("Sağlam"))">🟢 Sağlam Zemin (Radye Temel)</option>
                                        <option value="Zayıf Zemin (Zemin İyileştirme / Jet-Grout)" selected="@(rentPolicy.SoilBearingStatus.StartsWith("Zayıf"))">🟡 Zayıf Zemin (Jet-Grout)</option>
                                        <option value="Balçık / Dolgu Zemin (Fore Kazık Zorunlu)" selected="@(rentPolicy.SoilBearingStatus.StartsWith("Balçık"))">🔴 Dolgu/Balçık (Fore Kazık)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Yeraltı Suyu & Drenaj</label>
                                    <select name="groundwaterStatus" id="selGroundwater" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                        <option value="Kuru Zemin" selected="@(rentPolicy.GroundwaterStatus == "Kuru Zemin")">🟢 Kuru Zemin</option>
                                        <option value="Yüzeysel Su (Normal Drenaj)" selected="@(rentPolicy.GroundwaterStatus.StartsWith("Yüzeysel"))">🟡 Yüzeysel Su (Drenaj)</option>
                                        <option value="Yüksek Yeraltı Suyu (Bohçalama + Kuyu Pompa)" selected="@(rentPolicy.GroundwaterStatus.StartsWith("Yüksek"))">🔴 Yüksek Su (Bohçalama+Pompa)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Tahmini İstinat Maliyeti (₺)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="50000" name="estimatedRetainingWallCost" id="inpRetainingCost" class="form-control fw-bold text-danger" value="@rentPolicy.EstimatedRetainingWallCost.ToString("0")" oninput="recalculateRontgenAndDecision()" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Fore Kazık / İyileştirme (₺)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="100000" name="estimatedPilingCost" id="inpPilingCost" class="form-control fw-bold text-danger" value="@rentPolicy.EstimatedPilingCost.ToString("0")" oninput="recalculateRontgenAndDecision()" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Su Yalıtım / Drenaj Ek (₺)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="50000" name="estimatedGroundwaterCost" id="inpGroundwaterCost" class="form-control fw-bold text-danger" value="@rentPolicy.EstimatedGroundwaterCost.ToString("0")" oninput="recalculateRontgenAndDecision()" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </div>
                                <div class="col-12 mt-1">
                                    <div class="p-2 rounded-3 bg-white border d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <label class="fw-bold text-dark mb-0" style="font-size: 0.75rem;">
                                            <i class="bi bi-question-diamond-fill text-danger me-1"></i>ALTIN SORU: Bu Ekstra Zemin, İksa ve Kazık Parası Kimin Cebinden Çıkacak?
                                        </label>
                                        <select name="extraGroundCostPayer" id="selGroundPayer" class="form-select form-select-sm fw-bold text-primary" style="max-width: 420px;" onchange="recalculateRontgenAndDecision()">
                                            <option value="Müteahhit Üstlenecek (Kârdan Düşülecek)" selected="@(rentPolicy.ExtraGroundCostPayer.StartsWith("Müteahhit"))">💼 Müteahhit Üstlenecek (Net Kârdan Düşülür)</option>
                                            <option value="Sözleşmeye Şart Konulacak (Maliklerden veya Daire Payından Mahsup Edilecek)" selected="@(rentPolicy.ExtraGroundCostPayer.StartsWith("Sözleşmeye"))">🛡️ Sözleşmeye Şart Konulacak (Maliklerden / Paydan Mahsup)</option>
                                            <option value="Yarı Yarıya (%50 Müteahhit / %50 Malikler)" selected="@(rentPolicy.ExtraGroundCostPayer.StartsWith("Yarı"))">⚖️ Yarı Yarıya (%50 Müteahhit / %50 Malikler)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ADIM D: KAROT (6306), BÜROKRASİ VE BÖLGE RAYİÇ UYUMU -->
                    <div class="col-xl-5">
                        <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                    <span class="fw-bold text-dark small">
                                        <i class="bi bi-building-exclamation text-success me-1"></i>D. Karot (6306), Bürokrasi & Bölge Uyumu
                                    </span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" id="badgeRiskBureaucracy" style="font-size: 0.68rem;">Düşük Risk</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">6306 Riskli Yapı (Karot) Zamanlama Durumu</label>
                                        <select name="coreTestStatus" id="selCoreTest" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                            <option value="Henüz Karot Alınmadı (Sözleşme Sonrası Alınacak)" selected="@(rentPolicy.CoreTestStatus.StartsWith("Henüz"))">🟢 Henüz Karot Alınmadı (Noter Sözleşmesi Sonrası Alınacak - Doğru Zamanlama)</option>
                                            <option value="Riskli Yapı Raporu Alındı (60+30 Gün Süreci İşliyor)" selected="@(rentPolicy.CoreTestStatus.StartsWith("Riskli"))">🟡 Riskli Yapı Raporu Alındı (60+30 Gün Tahliye Takvimi İşliyor)</option>
                                            <option value="Erken Karot Riski Var (İmza Öncesi Karot Alınmış - Elektrik/Su Kesilebilir!)" selected="@(rentPolicy.CoreTestStatus.StartsWith("Erken"))">🔴 Erken Karot Alınmış! (%100 İmza Öncesi Elektrik/Su Kesilme Riski)</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.72rem;">Bölge Satış Rayici & Müşteri Profili Uyumu</label>
                                        <select name="regionalHarmonyStatus" id="selRegionalHarmony" class="form-select form-select-sm fw-semibold" onchange="recalculateRontgenAndDecision()">
                                            <option value="Tam Uyumlu (Bölgede Hızlı Satılır)" selected="@(rentPolicy.RegionalHarmonyStatus.StartsWith("Tam"))">🟢 Tam Uyumlu (Bölge Rayici İnşaat Maliyetini Fazlasıyla Karşılıyor)</option>
                                            <option value="Orta (Standart Satış Hızı)" selected="@(rentPolicy.RegionalHarmonyStatus.StartsWith("Orta"))">🟡 Orta Uyum (Standart Satış Süresi)</option>
                                            <option value="Zayıf (Lüks Maliyet Bölge Tavanını Aşıyor)" selected="@(rentPolicy.RegionalHarmonyStatus.StartsWith("Zayıf"))">🔴 Zayıf (Talep Edilen Lüks Şartname Bölge Fiyat Tavanını Aşıyor)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="p-2 rounded-3 bg-white border mt-2 small text-muted" style="font-size: 0.72rem;">
                                <i class="bi bi-info-circle-fill text-primary me-1"></i>
                                <b>1. Aşama Resmi Evrak Harç Toplamı:</b> <span class="fw-bold text-dark">@totalInitialFee.ToString("N0") ₺</span> (@completedCount / @initialDocs.Count Evrak Alındı)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GO / NO-GO KARAR KARTI VE OTOMATİK SÖZLEŞME KALKANI -->
                <div class="p-3 rounded-4 border border-2" id="goNoGoDecisionBox" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-color: #94a3b8 !important;">
                    <div class="row g-3 align-items-center">
                        <!-- SOL: 5 BOYUTLU TRAFİK IŞIĞI VE FİNANSAL ETKİ TERAZİSİ -->
                        <div class="col-xl-5">
                            <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-stoplights-fill text-primary"></i>
                                <span>PROJE RÖNTGENİ & NET KÂR ETKİ TABLOSU</span>
                            </h6>
                            <div class="p-2.5 rounded-3 bg-white border mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">2. Sayfa (Ön Fizibilite) Baz Net Kâr:</span>
                                    <strong class="text-dark font-monospace" id="lblBaseFeasibilityProfit">0 ₺</strong>
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Röntgende Çıkan Ekstra Saha/Zemin/İksa Yükü:</span>
                                    <strong class="text-danger font-monospace" id="lblTotalExtraSiteCost">0 ₺</strong>
                                </div>
                                <div class="d-flex justify-content-between small mb-1 pb-1 border-bottom">
                                    <span class="text-muted">Müteahhit Cebinden Çıkacak Ekstra Pay:</span>
                                    <strong class="text-danger font-monospace" id="lblContractorExtraBurden">0 ₺</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-1">
                                    <span class="fw-bold text-dark small">REVİZE GERÇEKÇİ NET KÂR:</span>
                                    <span class="fs-6 fw-extrabold text-success font-monospace" id="lblRevisedNetProfit">0 ₺</span>
                                </div>
                            </div>

                            <div class="row g-2 align-items-center">
                                <div class="col-5">
                                    <label class="form-label fw-bold text-dark mb-0" style="font-size: 0.76rem;">NİHAİ YÖNETİM KARARI:</label>
                                </div>
                                <div class="col-7">
                                    <select name="goNoGoDecision" id="selGoNoGoDecision" class="form-select form-select-sm fw-bold">
                                        <option value="GO" selected="@(rentPolicy.GoNoGoDecision == "GO")">🟢 GİRİLİR (GO - Standart Teklif)</option>
                                        <option value="CONDITIONAL_GO" selected="@(rentPolicy.GoNoGoDecision == "CONDITIONAL_GO" || string.IsNullOrEmpty(rentPolicy.GoNoGoDecision))">🟡 ŞARTLI GİRİLİR (Sözleşmeye Kalkan Eklenerek)</option>
                                        <option value="NO_GO" selected="@(rentPolicy.GoNoGoDecision == "NO_GO")">🔴 GİRİLMEZ (NO-GO - Red / Arşiv)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- SAĞ: OTOMATİK SÖZLEŞME KALKANI MADDELERİ (4. SAYFAYA AKTARILACAK) -->
                        <div class="col-xl-7">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <label class="form-label fw-bold text-dark mb-0" style="font-size: 0.78rem;">
                                    <i class="bi bi-shield-fill-check text-success me-1"></i>Sözleşme Kalkanı Maddeleri (4. Sayfa Teklif & Teknik Şartnameye Otomatik Aktarılır)
                                </label>
                                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-0.5 fw-bold" onclick="generateContractShieldClauses(true)" style="font-size: 0.70rem;">
                                    <i class="bi bi-magic me-1"></i>Röntgen Bulgularından Maddeleri Yenile
                                </button>
                            </div>
                            <textarea name="contractShieldClauses" id="txtContractShieldClauses" class="form-control rounded-3 font-monospace" rows="4" style="font-size: 0.76rem;" placeholder="Seçtiğiniz iksa, yıkım, zemin/kazık ve hukuki risklere göre sözleşmeye eklenecek koruyucu maddeler burada otomatik oluşturulur...">@rentPolicy.ContractShieldClauses</textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1 flex-wrap gap-2">
                                <small class="text-muted" style="font-size: 0.70rem;">
                                    <i class="bi bi-arrow-right-circle text-primary me-1"></i>Bu maddeler kaydedildiğinde <b>4. Sayfa (Teklif Hazırlama)</b> şartname özetine otomatik işlenir.
                                </small>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="document.getElementById('hfProceedToProposal').value='false';">
                                        <i class="bi bi-floppy me-1"></i>Röntgeni Kaydet
                                    </button>
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3.5 py-1 fw-bold shadow-sm text-white" onclick="document.getElementById('hfProceedToProposal').value='true';">
                                        <i class="bi bi-file-earmark-check-fill me-1"></i>Onayla & 4. Adım: Teklif Hazırlamaya Geç ➔
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- RESMİ İMAR DURUMU & KAPASİTE SİMÜLASYONU -->

    <form id="imarForm" asp-controller="ConstructionProject" asp-action="UpdateAnalysisImar" method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <input type="hidden" name="TargetTotalApartments" id="hiddenTargetUnits" value="@Model.TargetTotalApartments" />

        <div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">

            <div class="d-flex justify-content-between align-items-center p-2 px-3 bg-light border-bottom flex-wrap gap-1"

                 role="button" data-bs-toggle="collapse" data-bs-target="#imarCollapse" aria-expanded="false" aria-controls="imarCollapse" style="cursor: pointer;">

                

                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-calculator text-success fs-5"></i>

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <span class="fw-bold text-dark small" style="font-size: 0.88rem;">Resmi İmar Durumu & İnşaat Kapasitesi</span>

                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-1.5 py-0 rounded-pill" style="font-size: 0.68rem;">Çap Hesaplama</span>

                        <small class="text-muted d-none d-lg-inline" style="font-size: 0.72rem;">Belediye resmi imar çapına göre KAKS, TAKS ve daire hesabı</small>

                    </div>

                </div>

                <div class="d-flex align-items-center gap-1 flex-wrap" >

                    <a href="https://parselsorgu.tkgm.gov.tr" target="_blank" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-0 fw-bold" style="font-size: 0.72rem;" onclick="event.stopPropagation();">

                        <i class="bi bi-geo-alt-fill me-1"></i>TKGM Parsel

                    </a>

                    <a href="https://www.turkiye.gov.tr" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-0 fw-bold" style="font-size: 0.72rem;" onclick="event.stopPropagation();">

                        <i class="bi bi-bank me-1"></i>e-Devlet İmar

                    </a>

                    <button type="button" class="btn btn-success btn-sm rounded-pill px-2 py-0 fw-bold shadow-xs" onclick="event.stopPropagation(); downloadImarPdf()" style="font-size: 0.72rem;">

                        <i class="bi bi-file-earmark-pdf-fill me-1"></i>İmar Raporu

                    </button>

                    <span id="imarSaveIndicator" class="badge bg-success bg-opacity-15 text-success border border-success px-2 py-0 fw-bold" style="display:none; font-size: 0.70rem;">

                        <i class="bi bi-check2-circle me-1"></i>Kaydedildi

                    </span>

                    <button class="btn btn-sm btn-white border rounded-pill px-2.5 py-0 fw-bold d-flex align-items-center gap-1 shadow-xs text-secondary"

                            type="button" data-bs-toggle="collapse" data-bs-target="#imarCollapse" aria-expanded="false" aria-controls="imarCollapse" id="btnImarToggle" style="font-size: 0.74rem;">

                        <span id="textImarToggle">Genişlet</span>

                        <i class="bi bi-chevron-down ms-1" id="iconImarChevron"></i>

                    </button>

                </div>

            </div>

            <div class="collapse p-2 p-md-3" id="imarCollapse">

                <div class="row g-3 mb-3">

                    <div class="col-xl-3 col-md-6">

                        <div class="d-flex justify-content-between align-items-center mb-1">

                            <label class="form-label fw-bold small text-muted mb-0">

                                <i class="bi bi-bounding-box me-1"></i>Arsa Alanı (m²)

                            </label>

                            <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0 fw-bold" onclick="openTkgmModal()" title="TKGM MEGSİS'ten resmi kadastro parselini sorgula">

                                <i class="bi bi-geo-alt-fill me-1"></i>TKGM'den Çek

                            </button>

                        </div>

                        <input type="number" step="0.01" name="totalLandArea" id="calcLandArea" class="form-control rounded-3 fw-bold text-success" value="@landArea" oninput="recalculateCapacity()" />

                        <div class="d-flex align-items-center justify-content-between mt-1 text-muted" style="font-size: 0.72rem;">

                            <span>Ada: <b id="lblAda" class="text-dark">@(string.IsNullOrWhiteSpace(Model.Ada) ? "-" : Model.Ada)</b> / Parsel: <b id="lblParsel" class="text-dark">@(string.IsNullOrWhiteSpace(Model.Parsel) ? "-" : Model.Parsel)</b></span>

                            <span id="tkgmStatusBadge" class="badge @(Model.TotalLandArea.HasValue ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">@(Model.TotalLandArea.HasValue ? "TKGM Onaylı" : "Bekliyor")</span>

                        </div>

                        <input type="hidden" name="ada" id="calcAda" value="@Model.Ada" />

                        <input type="hidden" name="parsel" id="calcParsel" value="@Model.Parsel" />

                    </div>

                    <div class="col-xl-2 col-md-4">

                        <label class="form-label fw-bold small text-muted">

                            <i class="bi bi-percent me-1"></i>Onaylı Emsal (KAKS)

                        </label>

                        <input type="number" step="0.01" name="OnayliEmsal" id="calcEmsal" class="form-control rounded-3 fw-bold text-primary" value="@(ViewBag.OnayliEmsal ?? 2.00)" oninput="recalculateCapacity()" />

                        <small class="text-muted" style="font-size: 0.72rem;">Resmi çaptaki emsal katsayısı</small>

                    </div>

                    <div class="col-xl-2 col-md-4">

                        <label class="form-label fw-bold small text-muted">

                            <i class="bi bi-pie-chart me-1"></i>Taban Oturumu (TAKS)

                        </label>

                        <input type="number" step="0.01" name="TabanOturumuTaks" id="calcTaks" class="form-control rounded-3 fw-bold" value="@(ViewBag.TabanOturumuTaks ?? 0.35)" oninput="recalculateCapacity()" />

                        <small class="text-muted" style="font-size: 0.72rem;">Zemin katın taban oturum katsayısı</small>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <label class="form-label fw-bold small text-muted">

                            <i class="bi bi-building-up me-1"></i>İzinli Kat (Yençok)

                        </label>

                        <input type="number" name="TotalFloors" id="calcTotalFloors" class="form-control rounded-3 fw-bold" value="@(Model.TotalFloors ?? 8)" oninput="triggerImarAutosave()" />

                        <small class="text-muted" style="font-size: 0.72rem;">Maksimum kat yüksekliği</small>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <label class="form-label fw-bold small text-muted">

                            <i class="bi bi-house-door me-1"></i>Hedef Daire m² (Ortalama)

                        </label>

                        <input type="number" id="calcFlatSqm" class="form-control rounded-3 fw-bold" value="100" oninput="recalculateCapacity()" />

                        <small class="text-muted" style="font-size: 0.72rem;">Planlanan brüt daire büyüklüğü</small>

                    </div>

                </div>

                <!-- KOMPAKT ÇAP KAPASİTE HESAPLAMA ŞERİDİ -->

                <div class="p-3 rounded-4 border bg-light mb-3">

                    <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom flex-wrap gap-2">

                        <span class="text-muted fw-bold small">

                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>RESMİ ÇAP KAPASİTE SİMÜLASYONU

                        </span>

                        <div id="resSummaryBadge" class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1 rounded-pill">

                            Hesaplanıyor...

                        </div>

                    </div>

                    <div class="row g-2 text-center">

                        <div class="col-md-3 col-6">

                            <small class="text-muted d-block" style="font-size: 0.75rem;">Toplam Emsal İnşaat Alanı</small>

                            <h5 class="fw-bold text-dark mb-0" id="resTotalBuildingArea">0 m²</h5>

                        </div>

                        <div class="col-md-3 col-6 border-start">

                            <small class="text-muted d-block" style="font-size: 0.75rem;">Zemin Taban Oturum Alanı</small>

                            <h5 class="fw-bold text-dark mb-0" id="resGroundBaseArea">0 m²</h5>

                        </div>

                        <div class="col-md-3 col-6 border-start">

                            <small class="text-muted d-block" style="font-size: 0.75rem;">Üretilebilir Tahmin Daire</small>

                            <h5 class="fw-bold text-primary mb-0" id="resEstimatedUnits">~0 Daire</h5>

                        </div>

                        <div class="col-md-3 col-6 border-start">

                            <small class="text-muted d-block" style="font-size: 0.75rem;">Firma Satış Potansiyeli</small>

                            <h5 class="fw-bold text-success mb-0" id="resSurplusUnits">+0 Daire</h5>

                        </div>

                    </div>

                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center small text-muted" style="font-size: 0.75rem;">

                        <span><i class="bi bi-door-open me-1"></i>Eski Yapı: <b>@oldUnits Daire</b> ➔ Yeni Kapasite: <b id="resSummaryUnits">0 Daire</b></span>

                        <span class="text-muted">Resmi çapa dayalı matematiksel projeksiyondur</span>

                    </div>

                </div>

                <!-- TKGM RESMİ KADASTRO HARİTASI VE POLİGON KROKİSİ PANELİ (COLLAPSIBLE) -->

                <div class="card border border-light-subtle rounded-4 mb-3 overflow-hidden bg-light bg-opacity-50">

                    <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom flex-wrap gap-2">

                        <div class="d-flex align-items-center gap-2">

                            <span class="badge bg-danger rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">

                                <i class="bi bi-map-fill text-white" style="font-size: 0.75rem;"></i>

                            </span>

                            <div>

                                <span class="fw-bold text-dark small d-flex align-items-center gap-2">

                                    Resmi Kadastro Haritası & Sınır Krokisi

                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-0" style="font-size: 0.68rem;" id="tkgmInlineBadge">

                                        @(string.IsNullOrWhiteSpace(Model.Ada) ? "MEGSİS Canlı Entegrasyon" : $"{Model.Ada} Ada / {Model.Parsel} Parsel")

                                    </span>

                                </span>

                            </div>

                        </div>

                        <div class="d-flex align-items-center gap-2">

                            <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-1 shadow-xs" onclick="openTkgmModal()">

                                <i class="bi bi-crosshair"></i>

                                <span>Canlı Parseli Çek</span>

                            </button>

                            <button class="btn btn-xs btn-light border rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-1 shadow-xs" 

                                    type="button" 

                                    data-bs-toggle="collapse" 

                                    data-bs-target="#tkgmInlineCollapse" 

                                    aria-expanded="false" 

                                    id="btnTkgmInlineToggle">

                                <i class="bi bi-chevron-down" id="iconTkgmInlineChevron"></i>

                                <span id="textTkgmInlineToggle">Haritayı Göster</span>

                            </button>

                        </div>

                    </div>

                    <div class="collapse" id="tkgmInlineCollapse">

                        <div class="card-body p-3">

                            <div class="row g-3">

                                <div class="col-lg-8">

                                    <div id="inlineTkgmMap" style="height: 340px; width: 100%; border-radius: 12px; border: 1px solid #dee2e6; z-index: 1;"></div>

                                    <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted" style="font-size: 0.72rem;">

                                        <span><i class="bi bi-layers me-1"></i>Uydu görüntüsü üzerinde kırmızı çizgi TKGM'nin resmi parsel sınırıdır.</span>

                                        <span>Kaynak: <b>TKGM MEGSİS CBS</b></span>

                                    </div>

                                </div>

                                <div class="col-lg-4">

                                    <div class="bg-white p-3 rounded-4 border h-100 d-flex flex-column justify-content-between">

                                        <div>

                                            <h6 class="fw-bold text-dark mb-2 pb-2 border-bottom d-flex align-items-center justify-content-between">

                                                <span><i class="bi bi-card-checklist me-1 text-primary"></i>Kadastro Özeti</span>

                                                <span class="badge bg-success-subtle text-success small" id="inlineNitelik">@(Model.ProjectType ?? "Arsa")</span>

                                            </h6>

                                            <table class="table table-sm table-borderless small mb-0">

                                                <tbody>

                                                    <tr>

                                                        <td class="text-muted ps-0">İl / İlçe:</td>

                                                        <td class="fw-bold text-end pe-0" id="inlineIlIlce">@cityName / @distName</td>

                                                    </tr>

                                                    <tr>

                                                        <td class="text-muted ps-0">Mahalle:</td>

                                                        <td class="fw-bold text-end pe-0" id="inlineMahalle">@neighName</td>

                                                    </tr>

                                                    <tr>

                                                        <td class="text-muted ps-0">Ada / Parsel:</td>

                                                        <td class="fw-bold text-end pe-0 text-primary" id="inlineAdaParsel">@(Model.Ada ?? "-") / @(Model.Parsel ?? "-")</td>

                                                    </tr>

                                                    <tr>

                                                        <td class="text-muted ps-0">Pafta:</td>

                                                        <td class="fw-bold text-end pe-0" id="inlinePafta">-</td>

                                                    </tr>

                                                    <tr>

                                                        <td class="text-muted ps-0">Resmi Alan:</td>

                                                        <td class="fw-bold text-end pe-0 text-success fs-6" id="inlineAlan">@(Model.TotalLandArea?.ToString("N2") ?? "-") m²</td>

                                                    </tr>

                                                </tbody>

                                            </table>

                                        </div>

                                        <div class="pt-3 border-top mt-2">

                                            <button type="button" class="btn btn-sm btn-outline-danger w-100 rounded-pill fw-bold py-2 shadow-xs" onclick="openTkgmModal()">

                                                <i class="bi bi-arrow-repeat me-1"></i> TKGM MEGSİS'ten Güncelle

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- İMAR VE ÇAP NOTLARI -->

                <div class="mb-3">

                    <label class="form-label fw-bold small text-muted">

