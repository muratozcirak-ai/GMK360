    function sendFinanceNotification(channel) {

        const partyName = document.getElementById("notifyPartyName").textContent;

        const phone = document.getElementById("notifyPhone").value;

        const email = document.getElementById("notifyEmail").value;

        const msg = document.getElementById("notifyMessageText").value;

        const feedback = document.getElementById("notifyStatusFeedback");

        if (!msg || msg.trim().length === 0) {

            feedback.className = "alert alert-danger small py-1.5 px-2 mb-0";

            feedback.textContent = "Lütfen bir mesaj metni giriniz.";

            feedback.classList.remove("d-none");

            return;

        }

        if (channel === "sms" && (!phone || phone.trim().length < 10)) {

            feedback.className = "alert alert-warning small py-1.5 px-2 mb-0";

            feedback.textContent = "SMS göndermek için geçerli bir telefon numarası giriniz.";

            feedback.classList.remove("d-none");

            return;

        }

        if (channel === "email" && (!email || email.indexOf("@@") < 1)) {

            feedback.className = "alert alert-warning small py-1.5 px-2 mb-0";

            feedback.textContent = "E-Posta göndermek için geçerli bir e-posta adresi giriniz.";

            feedback.classList.remove("d-none");

            return;

        }

        feedback.className = "alert alert-info small py-1.5 px-2 mb-0";

        feedback.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Bildirim gönderiliyor...';

        feedback.classList.remove("d-none");

        const formData = new FormData();

        formData.append("projectId", "@Model.Id");

        formData.append("recipientName", partyName);

        formData.append("phone", phone);

        formData.append("email", email);

        formData.append("messageText", msg);

        formData.append("channel", channel);

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        if (tokenInput) {

            formData.append("__RequestVerificationToken", tokenInput.value);

        }

        fetch("/ConstructionProject/SendTransactionNotification", {

            method: "POST",

            body: formData

        })

        .then(res => res.json())

        .then(data => {

            if (data.success) {

                feedback.className = "alert alert-success small py-1.5 px-2 mb-0";

                feedback.textContent = data.message || "Bildirim başarıyla iletildi.";

            } else {

                feedback.className = "alert alert-danger small py-1.5 px-2 mb-0";

                feedback.textContent = data.message || "Bildirim gönderilemedi.";

            }

        })

        .catch(err => {

            feedback.className = "alert alert-danger small py-1.5 px-2 mb-0";

            feedback.textContent = "Bir hata oluştu: " + err.message;

        });

    }

    function openStatementModal(accId, accName, bankName, balance, symbol) {

        document.getElementById("statementAccountName").textContent = (bankName ? bankName + " - " : "") + accName;

        document.getElementById("statementCurrentBalance").textContent = "Bakiye: " + balance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + " " + symbol;

        const tbody = document.getElementById("statementTableBody");

        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>Hareketler yükleniyor...</td></tr>`;

        const modal = new bootstrap.Modal(document.getElementById("statementModal"));

        modal.show();

        fetch(`/ConstructionProject/GetAccountTransactions?projectId=@Model.Id&bankAccountId=` + accId)

            .then(res => res.json())

            .then(data => {

                if (!data || !data.success || !data.transactions || data.transactions.length === 0) {

                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">Bu hesaba henüz para girişi veya çıkışı kaydedilmedi.</td></tr>`;

                    return;

                }

                let html = "";

                data.transactions.forEach(t => {

                    const isGiris = t.type === "Giris";

                    const badgeClass = isGiris ? "bg-success text-white" : "bg-danger text-white";

                    const badgeText = isGiris ? "Giriş" : "Çıkış";

                    const amtPrefix = isGiris ? "+" : "-";

                    const amtClass = isGiris ? "text-success" : "text-danger";

                    const receiptBtn = t.receiptPath 

                        ? `<a href="${t.receiptPath}" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-1.5 py-0" style="font-size:0.68rem;" title="Dekontu Aç"><i class="bi bi-file-earmark-pdf me-0.5"></i>Gör</a>`

                        : `<span class="text-muted small">-</span>`;

                    html += `<tr>

                        <td class="ps-3 font-monospace small">${t.date}</td>

                        <td><span class="badge ${badgeClass} rounded-pill px-1.5 py-0" style="font-size:0.68rem;">${badgeText}</span></td>

                        <td><strong class="text-dark small">${t.party || '-'}</strong><div class="text-muted" style="font-size:0.70rem;">${t.category}</div></td>

                        <td class="text-secondary small">${t.description || '-'}</td>

                        <td class="text-end font-monospace fw-bold ${amtClass}">${amtPrefix}${t.amount} ${symbol}</td>

                        <td class="text-end font-monospace text-muted small">${t.balanceAfter} ${symbol}</td>

                        <td class="text-center pe-3">${receiptBtn}</td>

                    </tr>`;

                });

                tbody.innerHTML = html;

            })

            .catch(err => {

                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-3 text-danger small">Hareketler yüklenirken hata oluştu.</td></tr>`;

            });

    }

