                    <!-- Ödeme / Teslim Şekli (IBAN vs Elden) -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Ödeme / Teslim Şekli</label>

                        <div class="d-flex gap-3">

                            <div class="form-check">

