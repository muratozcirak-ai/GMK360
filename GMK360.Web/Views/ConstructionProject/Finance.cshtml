            <i class="bi bi-cash-coin text-warning"></i>

        </span>

        <span class="fw-bold text-dark fs-6">@Model.Name</span>

        <span class="badge bg-warning text-dark border border-warning px-2 py-0 rounded-pill fw-bold" style="font-size: 0.70rem;">

            <i class="bi bi-hourglass-split me-1"></i>@(Model.Status == ProjectStatus.Projelendirme_Teklif ? "ADAY PROJE" : Model.Status.ToString().ToUpperInvariant())

        </span>

        <span class="text-muted small" style="font-size: 0.76rem;">— Proje Finansı & Kasa Yönetimi</span>

        <span class="text-muted opacity-50">|</span>

        <span class="badge bg-light text-dark border px-2 py-0 rounded-pill small" style="font-size: 0.72rem;">

            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@cityName / @distName (@neighName Mah.)

        </span>

    </div>

<!-- ================= MODAL: ÖN ANALİZDEN KİRA & TAŞINMA TAKVİMİNİ AKTAR (#importRentScheduleModal) ================= -->
<div class="modal fade" id="importRentScheduleModal" tabindex="-1" aria-labelledby="importRentScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header py-2.5 px-3 bg-primary bg-opacity-10 border-bottom border-primary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white rounded-circle p-1.5"><i class="bi bi-calendar2-check fs-6"></i></span>
                    <h6 class="modal-title fw-bold text-dark mb-0" id="importRentScheduleModalLabel">📋 Ön Analizden Kira & Taşınma Takvimini Yansıt</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="ImportRentScheduleFromAnalysis" asp-controller="ConstructionProject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="modal-body p-3 small">
                    <div class="alert alert-info border-0 rounded-2 p-2.5 mb-3" style="font-size: 0.78rem;">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Ön Analiz aşamasında tanımladığınız <strong>Hak Sahipleri</strong>, telefonları, IBAN'ları ve <strong>Kira/Taşınma Politikası</strong> taranarak vade tarihine göre beklenenler tablonuza aktarılır.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark mb-1">Planlama Süresi (Kaç Aylık Takvim Çıkarılsın?)</label>
                        <select name="monthCount" class="form-select form-select-sm rounded-2 fw-semibold">
                            <option value="6">6 Ay (Yarım Yıllık)</option>
                            <option value="12" selected>12 Ay (1 Yıllık - Önerilen)</option>
                            <option value="18">18 Ay (İnşaat Süresince)</option>
                            <option value="24">24 Ay (2 Yıllık)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="includeRelocation" value="true" id="checkRelocFee" checked>
                            <label class="form-check-label fw-bold text-dark" for="checkRelocFee">
                                İlk Ay Taşınma Yardımlarını Dahil Et
                            </label>
                        </div>
                        <small class="text-muted d-block ps-4" style="font-size: 0.72rem;">İlk ay için taşınma desteği ve 1. ay kirası aynı hak sahibinin IBAN'ına eş zamanlı vade ile açılır.</small>
                    </div>

                    <div class="p-2 bg-light rounded-2 border">
                        <span class="fw-bold text-dark d-block mb-1" style="font-size: 0.76rem;">🎯 Otomatik Eşleşecek Hak Sahipleri:</span>
                        <ul class="mb-0 ps-3 text-secondary" style="font-size: 0.74rem;">
                            <li><strong>Murat Özçırak</strong> (Daire 4 - 17.500 ₺/ay kira + 35.000 ₺ taşınma)</li>
                            <li><strong>hahkkı ozcirak</strong> (Daire 4 - 17.500 ₺/ay kira + 35.000 ₺ taşınma)</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-xs">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Tek Tıkla Takvime Yansıt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL: BEKLENEN ÖDEMEYİ KASADAN DÜŞ VE BİLDİR (#completePaymentModal) ================= -->
<div class="modal fade" id="completePaymentModal" tabindex="-1" aria-labelledby="completePaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header py-2.5 px-3 bg-success bg-opacity-10 border-bottom border-success border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success text-white rounded-circle p-1.5"><i class="bi bi-check2-circle fs-6"></i></span>
                    <h6 class="modal-title fw-bold text-dark mb-0" id="completePaymentModalLabel">💳 Ödemeyi Kasadan Düş & Bildir</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="CompleteExpectedTransaction" asp-controller="ConstructionProject" method="post" id="completePaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="expectedId" id="completeExpectedId" value="" />

                <div class="modal-body p-3 small">
                    <!-- Özet Kartı -->
                    <div class="p-2.5 bg-light rounded-2 border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">Hak Sahibi / Muhatap:</span>
                            <strong class="text-dark fs-6" id="completePartyName">-</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">Ödeme Kalemi / Vade:</span>
                            <span class="fw-semibold text-secondary" id="completeCategoryAndDate">-</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-1 mt-1">
                            <span class="fw-bold text-dark">Kasadan Çıkacak Tutar:</span>
                            <strong class="text-danger fs-5 font-monospace" id="completeAmount">-</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1" id="completeIbanRow">
                            <span class="text-muted small">Alıcı IBAN:</span>
                            <span class="font-monospace text-dark small" id="completeIban">-</span>
                        </div>
                    </div>

                    <!-- Hangi Kasadan Çıkacak? -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark mb-1">Ödemenin Düşüleceği Kasa / Hesap</label>
                        <select name="bankAccountId" id="completeBankAccountId" class="form-select form-select-sm rounded-2 fw-semibold">
                            @foreach (var acc in projectAccounts)
                            {
                                string cur = DetectAccountCurrency(acc);
                                bool isR = (!string.IsNullOrWhiteSpace(acc.IBAN) && acc.IBAN.Trim().StartsWith("TR")) || (!string.IsNullOrWhiteSpace(acc.BankName) && !acc.BankName.Contains("Kasa") && !acc.BankName.Contains("Elden"));
                                string shortAcc = acc.AccountName ?? acc.BankName ?? "Hesap";
                                if (shortAcc.Contains("(")) shortAcc = shortAcc.Substring(0, shortAcc.IndexOf("(")).Trim();
                                <option value="@acc.Id">@(isR ? "🏛️ " : "💵 ")@shortAcc (@acc.CurrentBalance.ToString("N2") @GetAccountSymbol(cur))</option>
                            }
                        </select>
                    </div>

                    <!-- Bildirim Seçenekleri (SMS & E-Posta) -->
                    <div class="border rounded-2 p-2.5 bg-white mb-2">
                        <span class="fw-bold text-dark d-block mb-2" style="font-size: 0.78rem;">📲 Otomatik Hak Sahibi Bilgilendirmesi:</span>
                        
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="sendSms" value="true" id="completeSendSms" checked onchange="toggleCompleteSmsInputs()">
                            <label class="form-check-label fw-semibold text-dark small" for="completeSendSms">
                                Hak Sahibine SMS Gönder
                            </label>
                        </div>
                        <div id="completeSmsGroup" class="ms-4 mb-2">
                            <input type="text" name="notifyPhone" id="completePhone" class="form-control form-control-sm rounded-2 font-monospace" placeholder="05XXXXXXXXX" />
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="sendEmail" value="true" id="completeSendEmail" checked onchange="toggleCompleteEmailInputs()">
                            <label class="form-check-label fw-semibold text-dark small" for="completeSendEmail">
                                Hak Sahibine E-Posta İlet
                            </label>
                        </div>
                        <div id="completeEmailGroup" class="ms-4 mb-2">
                            <input type="email" name="notifyEmail" id="completeEmail" class="form-control form-control-sm rounded-2 font-monospace" placeholder="ornek@mail.com" />
                        </div>

                        <div class="mt-2">
                            <label class="form-label small text-muted mb-1">Gidecek Mesaj Metni (Düzenlenebilir):</label>
                            <textarea name="customMessage" id="completeCustomMessage" class="form-control form-control-sm rounded-2" rows="2" style="font-size: 0.74rem;"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-xs">
                        <i class="bi bi-check-circle-fill me-1"></i>Kasadan Düş ve Bildir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


    <div class="d-flex align-items-center gap-2">

        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill small" style="font-size: 0.72rem;">

            ID: #@Model.Id

        </span>

        <a href="/ConstructionProject/Workspace/@Model.Id" class="btn btn-outline-primary rounded-pill px-2.5 py-0 fw-bold btn-sm shadow-xs" style="font-size: 0.74rem;">

            <i class="bi bi-card-heading me-1"></i>Künyeye Git ➔

        </a>

