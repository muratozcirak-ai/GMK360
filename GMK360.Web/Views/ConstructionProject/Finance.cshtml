    function openCompletePaymentModal(expectedId, partyName, amountStr, dueDateStr, accountId, iban, bank, category, desc, directPhone, directEmail) {
        let phone = directPhone || '';
        let email = directEmail || '';
        document.getElementById('completeExpectedId').value = expectedId;
        document.getElementById('completePartyName').innerText = partyName;
        document.getElementById('completeCategoryAndDate').innerText = category + ' • Vade: ' + dueDateStr;
        document.getElementById('completeAmount').innerText = amountStr;
        
        if (iban && iban.trim()) {
            document.getElementById('completeIban').innerText = iban + (bank ? ' (' + bank + ')' : '');
            document.getElementById('completeIbanRow').style.display = 'flex';
        } else {
            document.getElementById('completeIbanRow').style.display = 'none';
        }

        if (accountId && document.getElementById('completeBankAccountId')) {
            document.getElementById('completeBankAccountId').value = accountId;
        }

        // Auto-extract phone and email from description if not directly provided
        if (!phone && desc) {
            const phoneMatch = desc.match(/\[?Tel:\s*([\d\s]+)\]?/i);
            if (phoneMatch) phone = phoneMatch[1].trim();
        }
        if (!email && desc) {
            const mailMatch = desc.match(/\[?Mail:\s*([^\s\]]+)\]?/i);
            if (mailMatch) email = mailMatch[1].trim();
        }

        // Default phones for Project 4 if party matches
        if (!phone && partyName.includes('Murat')) phone = '0506403437';
        if (!email && partyName.includes('Murat')) email = 'muratozcirak@hotmail.com';
        if (!phone && partyName.includes('hahkk')) phone = '05318968840';
        if (!email && partyName.includes('hahkk')) email = 'jhfsgs@gmail.com';

        document.getElementById('completePhone').value = phone;
        document.getElementById('completeEmail').value = email;

        const projectName = '@Html.Raw(Model.Name.Replace("'", "\\'"))';
        document.getElementById('completeCustomMessage').value = 'Sayın ' + partyName + ', ' + projectName + ' projesi kapsamında ' + amountStr + ' tutarındaki ' + category + ' ödemeniz banka hesabınıza aktarılmıştır. GMK Yapı';

        toggleCompleteSmsInputs();
        toggleCompleteEmailInputs();

        const modal = new bootstrap.Modal(document.getElementById('completePaymentModal'));
        modal.show();
    }

    function toggleCompleteSmsInputs() {
        const checked = document.getElementById('completeSendSms')?.checked;
        const grp = document.getElementById('completeSmsGroup');
        if (grp) grp.style.display = checked ? 'block' : 'none';
    }

    function toggleCompleteEmailInputs() {
        const checked = document.getElementById('completeSendEmail')?.checked;
        const grp = document.getElementById('completeEmailGroup');
        if (grp) grp.style.display = checked ? 'block' : 'none';
    }

