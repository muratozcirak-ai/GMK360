    function calcBatchTotals() {
        const rows = document.querySelectorAll('#batchWithdrawTbody tr');
        let totalGross = 0;
        let totalVat = 0;
        let totalNet = 0;
        let count = 0;

        rows.forEach(r => {
            const amtVal = parseFloat(r.querySelector('.batch-amount')?.value) || 0;
            const vatVal = parseInt(r.querySelector('.batch-vat')?.value) || 0;
            const vatType = r.querySelector('.batch-vat-type')?.value || "dahil";

            let net = amtVal;
            let vat = 0;
            let gross = amtVal;

            if (amtVal > 0) {
                count++;
                if (vatVal > 0) {
                    if (vatType === "haric") {
                        net = amtVal;
                        vat = amtVal * (vatVal / 100);
                        gross = net + vat;
                    } else {
                        // dahil
                        gross = amtVal;
                        vat = amtVal - (amtVal / (1 + (vatVal / 100)));
                        net = gross - vat;
                    }
                }
                totalNet += net;
                totalVat += vat;
                totalGross += gross;
            }

            const rowNetEl = r.querySelector('.batch-row-net');
            if (rowNetEl) rowNetEl.innerText = net.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            const rowVatEl = r.querySelector('.batch-row-vat');
            if (rowVatEl) rowVatEl.innerText = vat.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            const rowGrossEl = r.querySelector('.batch-row-gross');
            if (rowGrossEl) rowGrossEl.innerText = gross.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        });

        const cntEl = document.getElementById('batchRowCount');
        if (cntEl) cntEl.innerText = count;
        const netEl = document.getElementById('batchTotalNet');
        if (netEl) netEl.innerText = totalNet.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        const vatEl = document.getElementById('batchTotalVat');
        if (vatEl) vatEl.innerText = totalVat.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        const grossEl = document.getElementById('batchTotalGross');
        if (grossEl) grossEl.innerText = totalGross.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
    }

    async function submitBatchWithdrawals() {
        const projectId = @Model.Id;
        const rows = document.querySelectorAll('#batchWithdrawTbody tr');
        const items = [];

        for (let i = 0; i < rows.length; i++) {
            const r = rows[i];
            const amt = parseFloat(r.querySelector('.batch-amount')?.value) || 0;
            const party = r.querySelector('.batch-party')?.value.trim();
            const accSelect = r.querySelector('.batch-account-id');
            const accId = parseInt(accSelect?.value) || 0;
            const catSelect = r.querySelector('.batch-category');
            const vatSelect = r.querySelector('.batch-vat');
            const vatTypeSelect = r.querySelector('.batch-vat-type');
            const refNo = r.querySelector('.batch-ref')?.value.trim() || null;
            const notes = r.querySelector('.batch-notes')?.value.trim() || null;

            if (amt > 0 || party) {
                if (!party) {
                    alert(`${i + 1}. satırda muhatap/kime bilgisi boş bırakılamaz.`);
                    return;
                }
                if (amt <= 0) {
                    alert(`${i + 1}. satırda tutar bilgisi girilmelidir.`);
                    return;
                }
                if (!accId) {
                    alert(`${i + 1}. satırda kasa/hesap seçimi yapılmadı. Lütfen ödemenin çıkacağı hesabı seçiniz.`);
                    return;
                }

                const chosenAcc = projectAccountsData.find(a => a.id === accId);
                const isResmi = chosenAcc ? chosenAcc.isResmi : true;

                items.push({
                    transactionDate: r.querySelector('.batch-date')?.value || null,
                    recipientName: party,
                    outflowCategory: catSelect && catSelect.value ? catSelect.value : "Şantiye Harcaması",
                    bankAccountId: accId,
                    paymentMethod: isResmi ? "IBAN" : "Elden",
                    recipientIban: refNo,
                    recipientBank: null,
                    amount: amt,
                    currency: "TRY",
                    vatRate: vatSelect ? parseInt(vatSelect.value) || 0 : 0,
                    vatType: vatTypeSelect ? vatTypeSelect.value : "dahil",
                    notes: notes
                });
            }
        }

        if (items.length === 0) {
            alert('Lütfen kaydedilecek en az bir satır (muhatap, tutar ve hesap) giriniz.');
            return;
        }

        const btn = document.getElementById('btnSaveBatchWithdrawals');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kaydediliyor...';
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/ConstructionProject/AddProjectBatchWithdrawals', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    projectId: projectId,
                    sourceBankAccountId: items[0].bankAccountId,
                    items: items
                })
            });

            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Kayıt sırasında bir hata oluştu.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-save me-1"></i>Tüm Satırları Kaydet ve Kasadan Düş';
                }
            }
        } catch (err) {
            console.error(err);
            alert('Sunucu ile iletişim kurulurken hata oluştu.');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save me-1"></i>Tüm Satırları Kaydet ve Kasadan Düş';
            }
        }
    }

