    function onEditAccKindChanged() {
        const isElden = document.getElementById('editAccKindElden')?.checked;
        const lblBank = document.getElementById('editLblBankName');
        const inpBank = document.getElementById('editBankNameInput');
        const lblIban = document.getElementById('editLblIban');
        const inpIban = document.getElementById('editIbanInput');

        if (isElden) {
            if (lblBank) lblBank.innerHTML = 'Kasa Yeri / Açıklama';
