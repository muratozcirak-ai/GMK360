<!-- ================= 3. PROJE HESAPLARI & KASALARI (TEK ANA ÇATI DİVİ) ================= -->

@{

    string DetectAccountCurrency(GMK360.Core.Entities.BankAccount a)

    {

        if (a == null) return "TRY";

        string comb = $"{a.AccountName} {a.BankName} {a.IBAN}".ToUpperInvariant();

        if (comb.Contains("USD") || comb.Contains("DOLAR") || comb.Contains("$")) return "USD";

        if (comb.Contains("EUR") || comb.Contains("EURO") || comb.Contains("AVRO") || comb.Contains("€")) return "EUR";

        return "TRY";

    }

    string GetAccountSymbol(string c)

    {

        return c switch

        {

            "USD" => "$",

            "EUR" => "€",

            _ => "₺"

        };

    }

    var accountsList = (ViewBag.ProjectAccounts as List<GMK360.Core.Entities.BankAccount>) ?? new List<GMK360.Core.Entities.BankAccount>();

    var allTransactions = (ViewBag.ProjectTransactions as List<GMK360.Core.DTOs.Construction.ProjectAccountTransactionDto>) ?? new List<GMK360.Core.DTOs.Construction.ProjectAccountTransactionDto>();

    var expectedTransactions = (ViewBag.ProjectExpectedTransactions as List<GMK360.Core.DTOs.Construction.ProjectExpectedTransactionDto>) ?? new List<GMK360.Core.DTOs.Construction.ProjectExpectedTransactionDto>();

    var stakeholders = (ViewBag.Stakeholders as List<GMK360.Core.Entities.Construction.ProjectStakeholder>) ?? new List<GMK360.Core.Entities.Construction.ProjectStakeholder>();

    var actualInflows = allTransactions.Where(t => t.TransactionType == "Giris").ToList();

    var actualOutflows = allTransactions.Where(t => t.TransactionType == "Cikis").ToList();

    var expectedInflows = expectedTransactions.Where(t => t.Direction == "Inflow" && !t.IsCompleted).ToList();

    var expectedOutflows = expectedTransactions.Where(t => t.Direction == "Outflow" && !t.IsCompleted).ToList();

    decimal totalActualInflowTL = actualInflows.Sum(t => t.AmountTL ?? (t.Currency == "USD" ? t.Amount * usdRate : (t.Currency == "EUR" ? t.Amount * eurRate : t.Amount)));

    decimal totalExpectedInflowTL = expectedInflows.Sum(t => t.Currency == "USD" ? t.Amount * usdRate : (t.Currency == "EUR" ? t.Amount * eurRate : t.Amount));

    decimal totalActualOutflowTL = actualOutflows.Sum(t => t.AmountTL ?? (t.Currency == "USD" ? t.Amount * usdRate : (t.Currency == "EUR" ? t.Amount * eurRate : t.Amount)));

    decimal totalExpectedOutflowTL = expectedOutflows.Sum(t => t.Currency == "USD" ? t.Amount * usdRate : (t.Currency == "EUR" ? t.Amount * eurRate : t.Amount));

    decimal totalVatOutflowTL = actualOutflows.Sum(t => t.VatAmount ?? 0m);

    decimal totalNetOutflowTL = totalActualOutflowTL - totalVatOutflowTL;

    decimal totalTryVault = 0m;

    decimal totalUsdVault = 0m;

    decimal totalEurVault = 0m;

    decimal consolidatedTotalVaultTL = 0m;

    foreach (var a in accountsList)

    {

        var cur = DetectAccountCurrency(a);

        if (cur == "USD")

        {

            totalUsdVault += a.CurrentBalance;

            consolidatedTotalVaultTL += (a.CurrentBalance * usdRate);

        }

        else if (cur == "EUR")

        {

            totalEurVault += a.CurrentBalance;

            consolidatedTotalVaultTL += (a.CurrentBalance * eurRate);

        }

        else

        {

            totalTryVault += a.CurrentBalance;

            consolidatedTotalVaultTL += a.CurrentBalance;

        }

    }

}

