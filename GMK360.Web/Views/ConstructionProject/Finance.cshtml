                    </span>

                </div>

            </div>

            <!-- Sağ: Konsolide Toplam Varlık, Tek Merkezden Giriş/Çıkış/Hesap Aç Butonları ve Bölüm Kapatma Oku -->

            <div class="d-flex align-items-center gap-1.5 flex-wrap">

                <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill font-monospace me-1" style="font-size: 0.76rem;">

                    Toplam Kasa: <strong class="text-success fs-6">@consolidatedTotalVaultTL.ToString("N2") ₺</strong>

                    @if (totalUsdVault > 0 || totalEurVault > 0)

                    {

                        <span class="text-muted fw-normal ms-1" style="font-size: 0.72rem;">

                            (@(totalTryVault > 0 ? totalTryVault.ToString("N0") + " ₺" : "")@(totalUsdVault > 0 ? (totalTryVault > 0 ? " + " : "") + totalUsdVault.ToString("N0") + " $" : "")@(totalEurVault > 0 ? " + " + totalEurVault.ToString("N0") + " €" : ""))

                        </span>

                    }

                </span>

                <button type="button" class="btn btn-sm btn-success rounded-pill px-2.5 py-0.5 fw-bold shadow-xs d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#depositModal" style="font-size: 0.74rem;" onclick="event.stopPropagation();">

                    <i class="bi bi-plus-circle"></i>+ Para Girişi

                </button>

                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5 fw-bold shadow-xs d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#batchWithdrawModal" style="font-size: 0.74rem;" onclick="event.stopPropagation();">

                    <i class="bi bi-receipt"></i>- Fatura / Masraf Çıkışı

                </button>

                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#newAccountModal" style="font-size: 0.72rem;" onclick="event.stopPropagation();">

                    <i class="bi bi-plus-lg me-1"></i>Yeni Hesap / Kasa Aç

                </button>

                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0.5 text-muted shadow-xs collapse-chevron-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseAllAccountsSection" title="Gizle / Göster" aria-expanded="false" style="font-size: 0.72rem;">

                    <i class="bi bi-chevron-down"></i>

                </button>

            </div>

        </div>

        <!-- 2. BU ÇATININ İÇİ: TÜM KASALAR ALT ALTA SIRALI -->

        <div class="collapse" id="collapseAllAccountsSection">

            @for (int i = 0; i < accountsList.Count; i++)

            {

                var acc = accountsList[i];

                string accCurrency = DetectAccountCurrency(acc);

                bool isUsd = accCurrency == "USD";

                bool isEur = accCurrency == "EUR";

                string sym = GetAccountSymbol(accCurrency);

                var accTx = allTransactions.Where(t => t.BankAccountId == acc.Id)
                                           .OrderByDescending(t => t.TransactionDate)
                                           .ThenByDescending(t => t.CreatedAt)
                                           .ToList();

                bool isResmiAcc = (!string.IsNullOrWhiteSpace(acc.IBAN) && acc.IBAN.Trim().StartsWith("TR", StringComparison.OrdinalIgnoreCase)) || 
                                  (!string.IsNullOrWhiteSpace(acc.BankName) && (acc.BankName.Contains("Resmi") || (!acc.BankName.Contains("Kasa") && !acc.BankName.Contains("Elden"))));

                <div class="border-bottom @(i % 2 == 1 ? "bg-light bg-opacity-25" : "bg-white")">
                    <!-- HESAP SATIRI (TEK SATIRDA ADI, BANKASI, BAKİYESİ VE İŞLEM BUTONLARI) -->
                    <div class="d-flex justify-content-between align-items-center py-2 px-3 flex-wrap gap-2">
                        <!-- Sol: Hesap Adı, Banka ve IBAN Tek Hizada (Tıklayınca defteri açar/kapatır) -->
                        <div class="d-flex align-items-center gap-2 flex-wrap" role="button" data-bs-toggle="collapse" data-bs-target="#collapseAcc-@acc.Id" style="cursor: pointer;" title="Defteri Göster / Gizle">
                            <span class="badge @(isResmiAcc ? "bg-primary" : "bg-warning text-dark") text-white rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                <i class="bi @(isResmiAcc ? "bi-bank" : "bi-safe") fs-6"></i>
                            </span>
                            <span class="fw-bold text-dark fs-6 font-monospace mb-0">@acc.AccountName</span>
                            @if (isResmiAcc)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-0.5 rounded-pill small fw-bold" style="font-size: 0.72rem;">
                                    🏛️ Resmi Banka Hesabı
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-15 text-dark border border-warning-subtle px-2 py-0.5 rounded-pill small fw-bold" style="font-size: 0.72rem;">
                                    💵 Elden / Şantiye Kasası
                                </span>
                            }
                            <span class="badge bg-light text-secondary border px-2 py-0.5 rounded-pill small" style="font-size: 0.72rem;">@acc.BankName</span>
                            @if (!string.IsNullOrWhiteSpace(acc.IBAN))
                            {
                                <span class="font-monospace text-muted small" style="font-size: 0.75rem;">@acc.IBAN</span>
                            }
                        </div>

                        <!-- Sağ: Güncel Bakiye, Para Yatır, Para Çek, Düzenle ve Defter Oku -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="d-flex align-items-center gap-1.5 me-1 flex-wrap">
                                <span class="text-muted small" style="font-size: 0.70rem; letter-spacing: 0.5px;">GÜNCEL BAKİYE:</span>
                                <span class="fw-bold text-dark font-monospace fs-5">@acc.CurrentBalance.ToString("N2") @sym</span>
                                @if (isUsd)
                                {
                                    var tlEq = acc.CurrentBalance * usdRate;
                                    <span class="badge bg-light text-muted border font-monospace ms-1" style="font-size: 0.74rem;" title="Güncel TCMB USD Kuru (@usdRate.ToString("N4") ₺) ile TL Karşılığı">
                                        (≈ @tlEq.ToString("N2") ₺)
                                    </span>
                                }
                                else if (isEur)
                                {
                                    var tlEq = acc.CurrentBalance * eurRate;
                                    <span class="badge bg-light text-muted border font-monospace ms-1" style="font-size: 0.74rem;" title="Güncel TCMB EUR Kuru (@eurRate.ToString("N4") ₺) ile TL Karşılığı">
                                        (≈ @tlEq.ToString("N2") ₺)
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-1 text-secondary shadow-xs fw-semibold" 
                                        onclick="openEditAccountModal('@acc.Id', '@acc.AccountName', '@acc.BankName', '@acc.IBAN', '@accCurrency', @(isResmiAcc ? "true" : "false"))" title="Hesabı Düzenle" style="font-size: 0.72rem;">
                                    <i class="bi bi-pencil me-1"></i>Düzenle
                                </button>

                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-1 text-muted shadow-xs collapse-chevron-btn @(i == 0 ? "" : "collapsed")" 

                                        data-bs-toggle="collapse" data-bs-target="#collapseAcc-@acc.Id" title="Defteri Aç / Gizle" aria-expanded="@(i == 0 ? "true" : "false")" style="font-size: 0.72rem;">

                                    <i class="bi bi-chevron-down"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                    <!-- KOLAPSE TABLO (SADECE 5 SÜTUN: TARİH, KİM, AÇIKLAMA, TUTAR, DEKONT) -->

                    <div class="collapse @(i == 0 ? "show" : "")" id="collapseAcc-@acc.Id">

                        <div class="table-responsive border-top bg-white">

                            <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">

                                <thead class="table-light text-muted small text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">

                                    <tr>

                                        <th class="ps-3" style="width: 110px;">TARİH</th>

                                        <th style="min-width: 200px;">KİM YATIRDI / KİME ÇIKTI</th>

                                        <th>AÇIKLAMA</th>

                                        <th class="text-end" style="width: 160px;">TUTAR</th>

                                        <th class="text-center pe-3" style="width: 90px;">DEKONT</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (accTx.Count == 0)

                                    {

                                        <tr>

                                            <td colspan="5" class="text-center py-4 text-muted">

                                                Bu hesaba henüz para girişi veya çıkışı kaydedilmedi. Yukarıdaki <strong>[Para Yatır]</strong> butonu ile giriş yapabilirsiniz.

                                            </td>

                                        </tr>

                                    }

                                    else

                                    {

                                        @foreach (var t in accTx)

                                        {

                                            bool isGiris = t.TransactionType == "Giris";

                                            string sign = isGiris ? "+" : "-";

                                            string textClass = isGiris ? "text-success" : "text-danger";

                                            <tr>

                                                <td class="ps-3 font-monospace small text-muted">@t.TransactionDate.ToString("dd.MM.yyyy")</td>

                                                <td>

                                            <strong class="text-dark">@t.PartyName</strong>

                                            @if (!string.IsNullOrWhiteSpace(t.RecipientIban))

                                            {

                                                <div class="font-monospace text-primary small d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.70rem;">

                                                    <i class="bi bi-credit-card-2-front"></i>

                                                    <span>@t.RecipientIban</span>

                                                    @if (!string.IsNullOrWhiteSpace(t.RecipientBank))

                                                    {

                                                        <span class="text-muted fw-semibold">(@t.RecipientBank)</span>

                                                    }

                                                </div>

                                            }

                                            else if (t.PaymentMethod == "Elden")

                                            {

                                                <div class="text-secondary small d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.70rem;">

                                                    <i class="bi bi-cash-stack text-success"></i>

                                                    <span>Elden Nakit Teslim</span>

                                                </div>

                                            }

                                        </td>

                                                <td class="text-secondary">@(string.IsNullOrWhiteSpace(t.Description) ? "-" : t.Description)</td>

                                                <td class="text-end font-monospace">

                                                    <span class="fw-bold fs-6 @textClass">@sign@t.Amount.ToString("N2") @sym</span>

                                                    @if (isUsd)

                                                    {

                                                        <div class="text-muted font-monospace" style="font-size: 0.68rem;">(≈ @((t.Amount * usdRate).ToString("N2")) ₺)</div>

                                                    }

                                                    else if (isEur)

                                                    {

                                                        <div class="text-muted font-monospace" style="font-size: 0.68rem;">(≈ @((t.Amount * eurRate).ToString("N2")) ₺)</div>

                                                    }

                                                </td>

                                                <td class="text-center pe-3">

                                                    @if (!string.IsNullOrWhiteSpace(t.ReceiptDocumentPath))

                                                    {

                                                        <a href="@t.ReceiptDocumentPath" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0 fw-bold" style="font-size: 0.70rem;" title="Dekontu Gör">

                                                            <i class="bi bi-file-earmark-pdf me-0.5"></i>Gör

                                                        </a>

                                                    }

                                                    else

                                                    {

                                                        <span class="text-muted small">-</span>

                                                    }

                                                </td>

                                            </tr>

                                        }

                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

}

<!-- ================= 4. PARA GİRİŞLERİ & TAHSİLAT MASASI (EXCEL BİREBİR) ================= -->

<div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">

    <div class="d-flex justify-content-between align-items-center p-2 px-3 bg-light border-bottom flex-wrap gap-2">

        <div class="d-flex align-items-center gap-2" role="button" data-bs-toggle="collapse" data-bs-target="#collapseInflowsSection" class="collapsed" aria-expanded="false" style="cursor: pointer;">
            <span class="badge bg-success bg-opacity-10 text-success rounded-circle p-1.5 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-box-arrow-in-down fs-6"></i>
            </span>
            <div>
                <span class="fw-bold text-dark small" style="font-size: 0.88rem;">Para Girişleri</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-dark font-monospace small" style="font-size: 0.82rem;">
                Toplam Giriş: <strong class="text-success">@totalActualInflowTL.ToString("N2") ₺</strong>
            </span>
            <button type="button" class="btn btn-sm btn-success rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#depositModal" style="font-size: 0.72rem;" onclick="event.stopPropagation();">
                <i class="bi bi-plus-circle me-1"></i>+ Para Girişi Yap
            </button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0.5 text-muted shadow-xs collapse-chevron-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseInflowsSection" title="Gizle / Göster" aria-expanded="false" style="font-size: 0.72rem;">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
    </div>
    <div class="collapse" id="collapseInflowsSection">

        <!-- Sekmeler -->

        <ul class="nav nav-tabs px-3 pt-2 bg-light border-bottom" role="tablist" style="font-size: 0.78rem;">

            <li class="nav-item" role="presentation">

                <button class="nav-link active fw-bold text-dark" id="tab-inflow-actual-btn" data-bs-toggle="tab" data-bs-target="#tab-inflow-actual" type="button" role="tab">

                    <i class="bi bi-check-circle-fill text-success me-1"></i>Hesaplara Girişler (Gerçekleşen)

                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill ms-1">@actualInflows.Count</span>

                </button>

            </li>

            <li class="nav-item" role="presentation">

                <button class="nav-link fw-bold text-dark" id="tab-inflow-expected-btn" data-bs-toggle="tab" data-bs-target="#tab-inflow-expected" type="button" role="tab">

                    <i class="bi bi-hourglass-split text-primary me-1"></i>Giriş Beklenenler (Gelecek Tahsilatlar)

                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-1">@expectedInflows.Count</span>

                </button>

            </li>

        </ul>

        <div class="tab-content">

            <!-- TAB 1: GERÇEKLEŞEN GİRİŞLER -->

            <div class="tab-pane fade show active" id="tab-inflow-actual" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.80rem;">
                        <thead class="table-light text-muted small text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-3" style="width: 45px;">SIRA</th>
                                <th style="width: 90px; white-space: nowrap;">TARİH</th>
                                <th style="min-width: 140px; white-space: nowrap;">KİM YATIRDI</th>
                                <th style="width: 75px; white-space: nowrap;">TÜR</th>
                                <th style="min-width: 110px; white-space: nowrap;">HESAP</th>
                                <th class="text-end" style="width: 125px; white-space: nowrap;">SAF TUTAR (NET)</th>
                                <th class="text-center" style="width: 130px; white-space: nowrap;">KDV (% / TUTAR)</th>
                                <th class="text-end" style="width: 125px; white-space: nowrap;">TOPLAM GİRİŞ</th>
                                <th style="min-width: 110px; white-space: nowrap;">GELİR TÜRÜ</th>
                                <th style="max-width: 220px; white-space: nowrap;">AÇIKLAMA</th>
                                <th class="text-center" style="width: 70px; white-space: nowrap;">DEKONT</th>
                                <th class="text-center pe-3" style="width: 85px; white-space: nowrap;">BİLDİR</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (actualInflows.Count == 0)
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-4 text-muted">
                                        Henüz gerçekleşen para girişi kaydedilmedi. Yukarıdaki <strong>[+ Para Girişi Yap]</strong> butonu ile ekleyebilirsiniz.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rowNo = 1;
                                @foreach (var t in actualInflows.OrderByDescending(x => x.TransactionDate).ThenByDescending(x => x.CreatedAt))
                                {
                                    string sym = t.Currency == "USD" ? "$" : (t.Currency == "EUR" ? "€" : "₺");
                                    decimal rate = t.ExchangeRate ?? (t.Currency == "USD" ? usdRate : (t.Currency == "EUR" ? eurRate : 1m));
                                    decimal tlVal = t.AmountTL ?? Math.Round(t.Amount * rate, 2);
                                    bool isResmi = (t.AccountKind == "Resmi") || (t.AccountName != null && (t.AccountName.Contains("Resmi") || t.AccountName.Contains("Banka")));

                                    string cleanAcc = t.AccountName ?? "-";
                                    if (cleanAcc.Contains("(")) cleanAcc = cleanAcc.Substring(0, cleanAcc.IndexOf("(")).Trim();
                                    if (t.Currency == "USD" && !cleanAcc.Contains("USD") && !cleanAcc.Contains("Dolar")) cleanAcc += " ($)";
                                    else if (t.Currency == "EUR" && !cleanAcc.Contains("EUR") && !cleanAcc.Contains("Euro")) cleanAcc += " (€)";
                                    else if (t.Currency == "TRY" && !cleanAcc.Contains("TL")) cleanAcc += " (TL)";

                                    decimal netVal = t.NetAmount ?? (t.VatRate > 0 ? Math.Round(t.Amount / (1m + ((decimal)t.VatRate / 100m)), 2) : t.Amount);
                                    decimal vatVal = t.VatAmount ?? (t.Amount - netVal);

                                    <tr>
                                        <td class="ps-3 font-monospace text-muted small text-nowrap">@(rowNo++)</td>
                                        <td class="font-monospace small text-muted text-nowrap">@t.TransactionDate.ToString("dd.MM.yyyy")</td>
                                        <td class="text-nowrap"><strong class="text-dark">@t.PartyName</strong></td>
                                        <td class="text-nowrap">
                                            @if (isResmi)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Resmi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Elden</span>
                                            }
                                        </td>
                                        <td class="text-dark small text-nowrap" title="@t.AccountName">@cleanAcc</td>
                                        <td class="text-end font-monospace fw-bold text-dark text-nowrap">@netVal.ToString("N2") @sym</td>
                                        <td class="text-center font-monospace text-nowrap small">
                                            @if (t.VatRate > 0)
                                            {
                                                <span class="text-info fw-semibold">%@t.VatRate</span> <span class="text-muted">(@vatVal.ToString("N2") @sym)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end font-monospace fw-bold text-success text-nowrap">@t.Amount.ToString("N2") @sym</td>
                                        <td class="text-nowrap"><span class="badge bg-light text-dark border px-2 py-0.5 rounded-pill small">@t.CategoryOrPurpose</span></td>
                                        <td class="text-muted small text-truncate" style="max-width: 220px;" title="@t.Description">
                                            @(string.IsNullOrWhiteSpace(t.Description) ? "-" : t.Description)
                                        </td>
                                        <td class="text-center text-nowrap">
                                            @if (!string.IsNullOrWhiteSpace(t.ReceiptDocumentPath))
                                            {
                                                <a href="@t.ReceiptDocumentPath" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.68rem;" title="Dekont Görüntüle">
                                                    <i class="bi bi-file-earmark-pdf text-primary me-0.5"></i>Dekont
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td class="text-center pe-3 text-nowrap">
                                            <button type="button" class="btn btn-xs btn-outline-info rounded-pill px-2 py-0 fw-bold shadow-xs" style="font-size: 0.68rem;"
                                                    onclick="openNotifyModal('@Html.Raw(t.PartyName.Replace("'", "\'"))', '@t.Amount.ToString("N2") @sym', 'Inflow', '@Html.Raw((t.CategoryOrPurpose ?? "").Replace("'", "\'"))', '@(t.ReceiptDocumentPath ?? "")', '', '')">
                                                <i class="bi bi-chat-dots-fill me-0.5"></i>İlet
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- TAB 2: GİRİŞ BEKLENENLER (GELECEK TAHSİLATLAR) -->

            <div class="tab-pane fade" id="tab-inflow-expected" role="tabpanel">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0" style="font-size: 0.80rem;">

                        <thead class="table-light text-muted small text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">

                            <tr>

                                <th class="ps-3" style="width: 50px;">SIRA</th>

                                <th style="min-width: 170px;">KİMDEN (KAYNAK)</th>

                                <th style="width: 170px;">VADE (TARİH 1 - TARİH 2)</th>

                                <th style="width: 100px;">HESAP TÜRÜ</th>

                                <th style="min-width: 160px;">HANGİ HESABA</th>

                                <th class="text-end" style="width: 140px;">MİKTAR</th>

                                <th>NE İÇİN</th>

                                <th>AÇIKLAMA</th>

                                <th class="text-center" style="width: 80px;">EVRAK</th>

                                <th class="text-center pe-3" style="width: 150px;">İŞLEM</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (expectedInflows.Count == 0)

                            {

                                <tr>

                                    <td colspan="10" class="text-center py-4 text-muted">

                                        Beklenen tahsilat kaydı bulunmuyor. Gelecek ödemeleri planlamak için <strong>[+ Beklenen Giriş Ekle]</strong> butonunu kullanabilirsiniz.

                                    </td>

                                </tr>

                            }

                            else

                            {

                                int rowNo = 1;

                                @foreach (var e in expectedInflows.OrderBy(x => x.Date1))

                                {

                                    string sym = e.Currency == "USD" ? "$" : (e.Currency == "EUR" ? "€" : "₺");

                                    <tr>

                                        <td class="ps-3 font-monospace text-muted small">@(rowNo++)</td>

                                        <td>

                                            <strong class="text-dark">@e.PartyName</strong>

                                            @if (!string.IsNullOrWhiteSpace(e.RecipientIban))

                                            {

                                                <div class="font-monospace text-primary small d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.70rem;">

                                                    <i class="bi bi-credit-card-2-front"></i>

                                                    <span>@e.RecipientIban</span>

                                                    @if (!string.IsNullOrWhiteSpace(e.RecipientBank))

                                                    {

                                                        <span class="text-muted fw-semibold">(@e.RecipientBank)</span>

                                                    }

                                                </div>

                                            }

                                            else if (e.PaymentMethod == "Elden")

                                            {

                                                <div class="text-secondary small d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.70rem;">

                                                    <i class="bi bi-cash-stack text-success"></i>

                                                    <span>Elden Nakit Teslim</span>

                                                </div>

                                            }

                                        </td>

                                        <td class="font-monospace small text-primary fw-semibold">

                                            @e.Date1.ToString("dd.MM.yyyy")

                                            @if (e.Date2.HasValue)

                                            {

                                                <span> — @e.Date2.Value.ToString("dd.MM.yyyy")</span>

                                            }

                                        </td>

                                        <td>

                                            @if (e.AccountType == "Resmi")

                                            {

                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Resmi</span>

                                            }

                                            else

                                            {

                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Elden</span>

                                            }

                                        </td>

                                        <td class="text-secondary small">@(string.IsNullOrWhiteSpace(e.TargetAccountName) ? "Herhangi Bir Kasa" : e.TargetAccountName)</td>

                                        <td class="text-end font-monospace fw-bold fs-6 text-primary">@e.Amount.ToString("N2") @sym</td>

                                        <td><span class="badge bg-light text-dark border px-2 py-0.5 rounded-pill small">@e.CategoryOrPurpose</span></td>

                                        <td class="text-secondary small">@(string.IsNullOrWhiteSpace(e.Description) ? "-" : e.Description)</td>

                                        <td class="text-center">

                                            @if (!string.IsNullOrWhiteSpace(e.DocumentPath))

                                            {

                                                <a href="@e.DocumentPath" target="_blank" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.68rem;">Evrak</a>

                                            }

                                            else

                                            {

                                                <span class="text-muted small">-</span>

                                            }

                                        </td>

                                        <td class="text-center pe-3">

                                            <div class="d-flex align-items-center justify-content-center gap-1">

                                                <form asp-action="CompleteExpectedTransaction" asp-controller="ConstructionProject" method="post" style="display:inline;" onsubmit="return confirm('Bu beklenen girişin tahsil edildiğini ve kasaya işleneceğini onaylıyor musunuz?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="projectId" value="@Model.Id" />

                                                    <input type="hidden" name="expectedId" value="@e.Id" />

                                                    <input type="hidden" name="bankAccountId" value="@(e.TargetBankAccountId ?? (accountsList.FirstOrDefault()?.Id ?? 0))" />

                                                    <button type="submit" class="btn btn-xs btn-success rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" style="font-size:0.70rem;">

                                                        <i class="bi bi-check2-circle me-1"></i>✓ Kasaya Al

                                                    </button>

                                                </form>

                                                <form asp-action="DeleteExpectedTransaction" asp-controller="ConstructionProject" method="post" style="display:inline;" onsubmit="return confirm('Bu beklenen giriş kaydını silmek istediğinize emin misiniz?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="projectId" value="@Model.Id" />

                                                    <input type="hidden" name="expectedId" value="@e.Id" />

                                                    <button type="submit" class="btn btn-xs btn-light text-danger border rounded-pill px-1.5 py-0.5" title="Sil">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                }

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================= 5. PARA ÇIKIŞLARI & ÖDEMELER MASASI (EXCEL BİREBİR) ================= -->

<div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">

    <div class="d-flex justify-content-between align-items-center p-2 px-3 bg-light border-bottom flex-wrap gap-2">

        <div class="d-flex align-items-center gap-2" role="button" data-bs-toggle="collapse" data-bs-target="#collapseOutflowsSection" class="collapsed" aria-expanded="false" style="cursor: pointer;">
            <span class="badge bg-danger bg-opacity-10 text-danger rounded-circle p-1.5 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-box-arrow-up-right fs-6"></i>
            </span>
            <div>
                <span class="fw-bold text-dark small" style="font-size: 0.88rem;">Para Çıkışları</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-dark font-monospace small" style="font-size: 0.82rem;">
                Toplam Çıkış: <strong class="text-danger">@totalActualOutflowTL.ToString("N2") ₺</strong>
            </span>
            <button type="button" class="btn btn-sm btn-danger rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#batchWithdrawModal" style="font-size: 0.72rem;" onclick="event.stopPropagation();">
                <i class="bi bi-receipt me-1"></i>+ Fatura / Masraf Gir
            </button>
            <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0.5 text-muted shadow-xs collapse-chevron-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapseOutflowsSection" title="Gizle / Göster" aria-expanded="false" style="font-size: 0.72rem;">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
    </div>
    <div class="collapse" id="collapseOutflowsSection">

        <!-- Sekmeler -->

        <ul class="nav nav-tabs px-3 pt-2 bg-light border-bottom" role="tablist" style="font-size: 0.78rem;">

            <li class="nav-item" role="presentation">

                <button class="nav-link active fw-bold text-dark" id="tab-outflow-actual-btn" data-bs-toggle="tab" data-bs-target="#tab-outflow-actual" type="button" role="tab">

                    <i class="bi bi-check-circle-fill text-danger me-1"></i>Hesaptan Çıkışlar (Fiili Ödemeler)

                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill ms-1">@actualOutflows.Count</span>

                </button>

            </li>

            <li class="nav-item" role="presentation">

                <button class="nav-link fw-bold text-dark" id="tab-outflow-expected-btn" data-bs-toggle="tab" data-bs-target="#tab-outflow-expected" type="button" role="tab">

                    <i class="bi bi-clock-history text-warning me-1"></i>Çıkış Beklenenler (Hakediş, Kira & Vadeler)

                    <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill ms-1">@expectedOutflows.Count</span>

                </button>

            </li>

        </ul>

        <div class="tab-content">

            <!-- TAB 1: GERÇEKLEŞEN ÇIKIŞLAR -->

            <div class="tab-pane fade show active" id="tab-outflow-actual" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.80rem;">
                        <thead class="table-light text-muted small text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-3" style="width: 45px;">SIRA</th>
                                <th style="width: 90px; white-space: nowrap;">TARİH</th>
                                <th style="min-width: 140px; white-space: nowrap;">KİME ÖDENDİ</th>
                                <th style="width: 75px; white-space: nowrap;">TÜR</th>
                                <th style="min-width: 110px; white-space: nowrap;">HESAP</th>
                                <th class="text-end" style="width: 125px; white-space: nowrap;">SAF TUTAR (NET)</th>
                                <th class="text-center" style="width: 130px; white-space: nowrap;">KDV (% / TUTAR)</th>
                                <th class="text-end" style="width: 125px; white-space: nowrap;">TOPLAM ÇIKIŞ</th>
                                <th style="min-width: 110px; white-space: nowrap;">GİDER TÜRÜ</th>
                                <th style="max-width: 220px; white-space: nowrap;">AÇIKLAMA</th>
                                <th class="text-center" style="width: 70px; white-space: nowrap;">DEKONT</th>
                                <th class="text-center pe-3" style="width: 85px; white-space: nowrap;">BİLDİR</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (actualOutflows.Count == 0)
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-4 text-muted">
                                        Henüz gerçekleşen para çıkışı kaydedilmedi. Yukarıdaki <strong>[+ Fatura / Masraf Gir]</strong> butonu ile ekleyebilirsiniz.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rowNo = 1;
                                @foreach (var t in actualOutflows.OrderByDescending(x => x.TransactionDate).ThenByDescending(x => x.CreatedAt))
                                {
                                    string sym = t.Currency == "USD" ? "$" : (t.Currency == "EUR" ? "€" : "₺");
                                    decimal rate = t.ExchangeRate ?? (t.Currency == "USD" ? usdRate : (t.Currency == "EUR" ? eurRate : 1m));
                                    decimal tlVal = t.AmountTL ?? Math.Round(t.Amount * rate, 2);
                                    bool isResmi = (t.AccountKind == "Resmi") || (t.AccountName != null && (t.AccountName.Contains("Resmi") || t.AccountName.Contains("Banka")));

                                    string cleanAcc = t.AccountName ?? "-";
                                    if (cleanAcc.Contains("(")) cleanAcc = cleanAcc.Substring(0, cleanAcc.IndexOf("(")).Trim();
                                    if (t.Currency == "USD" && !cleanAcc.Contains("USD") && !cleanAcc.Contains("Dolar")) cleanAcc += " ($)";
                                    else if (t.Currency == "EUR" && !cleanAcc.Contains("EUR") && !cleanAcc.Contains("Euro")) cleanAcc += " (€)";
                                    else if (t.Currency == "TRY" && !cleanAcc.Contains("TL")) cleanAcc += " (TL)";

                                    decimal netVal = t.NetAmount ?? (t.VatRate > 0 ? Math.Round(t.Amount / (1m + ((decimal)t.VatRate / 100m)), 2) : t.Amount);
                                    decimal vatVal = t.VatAmount ?? (t.Amount - netVal);

                                    <tr>
                                        <td class="ps-3 font-monospace text-muted small text-nowrap">@(rowNo++)</td>
                                        <td class="font-monospace small text-muted text-nowrap">@t.TransactionDate.ToString("dd.MM.yyyy")</td>
                                        <td class="text-nowrap"><strong class="text-dark">@t.PartyName</strong></td>
                                        <td class="text-nowrap">
                                            @if (isResmi)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Resmi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Elden</span>
                                            }
                                        </td>
                                        <td class="text-dark small text-nowrap" title="@t.AccountName">@cleanAcc</td>
                                        <td class="text-end font-monospace fw-bold text-dark text-nowrap">@netVal.ToString("N2") @sym</td>
                                        <td class="text-center font-monospace text-nowrap small">
                                            @if (t.VatRate > 0)
                                            {
                                                <span class="text-info fw-semibold">%@t.VatRate</span> <span class="text-muted">(@vatVal.ToString("N2") @sym)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end font-monospace fw-bold text-danger text-nowrap">@t.Amount.ToString("N2") @sym</td>
                                        <td class="text-nowrap"><span class="badge bg-light text-dark border px-2 py-0.5 rounded-pill small">@t.CategoryOrPurpose</span></td>
                                        <td class="text-muted small text-truncate" style="max-width: 220px;" title="@t.Description">
                                            @(string.IsNullOrWhiteSpace(t.Description) ? "-" : t.Description)
                                        </td>
                                        <td class="text-center text-nowrap">
                                            @if (!string.IsNullOrWhiteSpace(t.ReceiptDocumentPath))
                                            {
                                                <a href="@t.ReceiptDocumentPath" target="_blank" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.68rem;" title="Dekont Görüntüle">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-0.5"></i>Dekont
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td class="text-center pe-3 text-nowrap">
                                            <button type="button" class="btn btn-xs btn-outline-info rounded-pill px-2 py-0 fw-bold shadow-xs" style="font-size: 0.68rem;"
                                                    onclick="openNotifyModal('@Html.Raw(t.PartyName.Replace("'", "\'"))', '@t.Amount.ToString("N2") @sym', 'Outflow', '@Html.Raw((t.CategoryOrPurpose ?? "").Replace("'", "\'"))', '@(t.ReceiptDocumentPath ?? "")', '', '', '@Html.Raw((t.RecipientIban ?? "").Replace("'", "\'"))', '@(t.PaymentMethod ?? "IBAN")')">
                                                <i class="bi bi-chat-dots-fill me-0.5"></i>İlet
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- TAB 2: ÇIKIŞ BEKLENENLER (GELECEK HAKEDİŞ, KİRA & VADELER) -->

            <div class="tab-pane fade" id="tab-outflow-expected" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center p-2.5 px-3 bg-light border-bottom flex-wrap gap-2" style="font-size: 0.80rem;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-primary"></i>
                        <span class="text-secondary">Hak sahipleri kira & taşınma planı ve taşeron vadeleri <strong>vade tarihine göre</strong> sıralanır.</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#importRentScheduleModal" style="font-size: 0.74rem;">
                            <i class="bi bi-calendar2-check me-1"></i>📋 Ön Analizden Kira & Taşınma Planını Yansıt
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 fw-bold shadow-xs" onclick="openAddExpectedModal('Outflow')" style="font-size: 0.74rem;">
                            <i class="bi bi-plus-lg me-1"></i>+ Manuel Beklenen Çıkış
                        </button>
                    </div>
                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0" style="font-size: 0.80rem;">

                        <thead class="table-light text-muted small text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">

                            <tr>

                                <th class="ps-3" style="width: 50px;">SIRA</th>

                                <th style="min-width: 170px;">KİME (TAŞERON / HAK SAHİBİ)</th>

                                <th style="width: 170px;">VADE (TARİH 1 - TARİH 2)</th>

                                <th style="width: 100px;">HESAP TÜRÜ</th>

                                <th style="min-width: 160px;">HANGİ HESAPTAN</th>

                                <th class="text-end" style="width: 140px;">MİKTAR</th>

                                <th>NE İÇİN</th>

                                <th>AÇIKLAMA</th>

                                <th class="text-center" style="width: 80px;">EVRAK</th>

                                <th class="text-center pe-3" style="width: 160px;">İŞLEM</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (expectedOutflows.Count == 0)

                            {

                                <tr>

                                    <td colspan="10" class="text-center py-4 text-muted">

                                        Beklenen ödeme kaydı bulunmuyor. Gelecek hakediş, kira desteği ve faturaları planlamak için <strong>[+ Beklenen Çıkış Ekle]</strong> butonunu kullanabilirsiniz.

                                    </td>

                                </tr>

                            }

                            else

                            {

                                int rowNo = 1;

                                @foreach (var e in expectedOutflows.OrderBy(x => x.Date1))

                                {

                                    string sym = e.Currency == "USD" ? "$" : (e.Currency == "EUR" ? "€" : "₺");

                                    <tr>

                                        <td class="ps-3 font-monospace text-muted small">@(rowNo++)</td>

                                        <td><strong class="text-dark">@e.PartyName</strong></td>

                                        <td class="font-monospace small text-danger fw-semibold">

                                            @e.Date1.ToString("dd.MM.yyyy")

                                            @if (e.Date2.HasValue)

                                            {

                                                <span> — @e.Date2.Value.ToString("dd.MM.yyyy")</span>

                                            }

                                        </td>

                                        <td>

                                            @if (e.AccountType == "Resmi")

                                            {

                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Resmi</span>

                                            }

                                            else

                                            {

                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill" style="font-size:0.68rem;">Elden</span>

                                            }

                                        </td>

                                        @{
                                            string dispAcc = e.TargetAccountName ?? "-";
                                            if (dispAcc.Contains(" - ")) dispAcc = dispAcc.Substring(dispAcc.LastIndexOf(" - ") + 3).Trim();
                                        }
                                        <td class="text-secondary small fw-medium">@(string.IsNullOrWhiteSpace(dispAcc) ? "Herhangi Bir Kasa" : dispAcc)</td>

                                        <td class="text-end font-monospace fw-bold fs-6 text-danger">@e.Amount.ToString("N2") @sym</td>

                                        <td><span class="badge bg-light text-dark border px-2 py-0.5 rounded-pill small">@e.CategoryOrPurpose</span></td>

                                        <td class="text-secondary small">@(string.IsNullOrWhiteSpace(e.Description) || e.Description.Contains("Malik") || e.Description.Contains("Kira Ödemesi") ? "-" : e.Description)</td>

                                        <td class="text-center">

                                            @if (!string.IsNullOrWhiteSpace(e.DocumentPath))

                                            {

                                                <a href="@e.DocumentPath" target="_blank" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.68rem;">Evrak</a>

                                            }

                                            else

                                            {

                                                <span class="text-muted small">-</span>

                                            }

                                        </td>

                                        <td class="text-center pe-3">

                                            <div class="d-flex align-items-center justify-content-center gap-1">

                                                <button type="button" class="btn btn-xs btn-danger rounded-pill px-2.5 py-0.5 fw-bold shadow-xs" style="font-size:0.70rem;"
                                                            onclick="openCompletePaymentModal('@e.Id', '@Html.Raw(e.PartyName.Replace("'", "\\'"))', '@e.Amount.ToString("N2") @sym', '@e.Date1.ToString("dd.MM.yyyy")', '@(e.TargetBankAccountId ?? (accountsList.FirstOrDefault()?.Id ?? 0))', '@Html.Raw((e.RecipientIban ?? "").Replace("'", "\\'"))', '@Html.Raw((e.RecipientBank ?? "").Replace("'", "\\'"))', '@Html.Raw((e.CategoryOrPurpose ?? "").Replace("'", "\\'"))', '@Html.Raw((e.Description ?? "").Replace("'", "\\'"))', '@Html.Raw((e.RecipientPhone ?? "").Replace("'", "\\'"))', '@Html.Raw((e.RecipientEmail ?? "").Replace("'", "\\'"))')">
                                                        <i class="bi bi-check2-circle me-0.5"></i>Ödendi & Bildir
                                                    </button>

                                                <form asp-action="DeleteExpectedTransaction" asp-controller="ConstructionProject" method="post" style="display:inline;" onsubmit="return confirm('Bu beklenen çıkış kaydını silmek istediğinize emin misiniz?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="projectId" value="@Model.Id" />

                                                    <input type="hidden" name="expectedId" value="@e.Id" />

                                                    <button type="submit" class="btn btn-xs btn-light text-danger border rounded-pill px-1.5 py-0.5" title="Sil">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                }

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================= 6. ORTAKLAR CARİ & HİSSE TAKİP MASASI (DİNAMİK HANELER) ================= -->

@if (Model.IsJointVenture && Model.PartnerList.Count > 0)

{

    var partners = Model.PartnerList;

    decimal totalPartnerAdvance = Model.PartnerList.Sum(p => actualInflows.Where(x => x.PartyName != null && x.PartyName.Contains(p.FullName)).Sum(x => x.AmountTL ?? x.Amount));

    decimal totalOurAdvance = actualInflows.Where(x => x.PartyName != null && (x.PartyName.Contains("Biz") || x.PartyName.Contains("Ana Yüklenici") || x.PartyName.Contains("Özkaynak"))).Sum(x => x.AmountTL ?? x.Amount);

    <div class="card border border-light-subtle rounded-3 bg-white mb-2 shadow-xs overflow-hidden">

        <div class="d-flex justify-content-between align-items-center p-2 px-3 bg-light border-bottom flex-wrap gap-2">

            <div class="d-flex align-items-center gap-2" role="button" data-bs-toggle="collapse" data-bs-target="#collapsePartnersMatrixSection" class="collapsed" aria-expanded="false" style="cursor: pointer;">

                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-circle p-1.5 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">

                    <i class="bi bi-people-fill"></i>

                </span>

                <div>

                    <span class="fw-bold text-dark small" style="font-size: 0.88rem;">Ortaklar Cari & Hisse Dağılım Masası</span>

                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill ms-1" style="font-size: 0.70rem;">

                        @(partners.Count + 1) Ortaklık Haneli (Biz: %@Model.OurSharePercentage.ToString("0.#") / Ortaklar: %@Model.PartnerSharePercentage.ToString("0.#"))

                    </span>

                </div>

            </div>

            <div>

                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0.5 text-muted shadow-xs collapse-chevron-btn collapsed" data-bs-toggle="collapse" data-bs-target="#collapsePartnersMatrixSection" title="Gizle / Göster" aria-expanded="false" style="font-size: 0.72rem;">

                    <i class="bi bi-chevron-down"></i>

                </button>

            </div>

        </div>

        <div class="collapse" id="collapsePartnersMatrixSection">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0" style="font-size: 0.80rem;">

                    <thead class="table-light small text-uppercase" style="font-size: 0.70rem; letter-spacing: 0.5px;">

                        <tr>

                            <th class="ps-3" style="width: 95px;">TARİH</th>

                            <th style="width: 140px;">İŞLEM / REFERANS</th>

                            <th>AÇIKLAMA</th>

                            <th class="text-end" style="width: 130px;">TOPLAM TL</th>

                            <th class="text-end text-dark border-start border-end" style="width: 160px; background-color: #f1f5f9; font-weight: 700;">

                                BİZ (%@Model.OurSharePercentage.ToString("0.#"))

                            </th>

                            @foreach (var p in partners)

                            {

                                <th class="text-end text-dark border-end" style="min-width: 160px; background-color: #f8fafc; font-weight: 700;">

                                    @p.FullName (%@p.SharePercentage.ToString("0.#"))

                                </th>

                            }

                        </tr>

                    </thead>

                    <tbody>

                        @if (allTransactions.Count == 0)

                        {

                            <tr>

                                <td colspan="@(5 + partners.Count)" class="text-center py-4 text-muted">

                                    Henüz ortaklık hareket kaydı bulunmuyor.

                                </td>

                            </tr>

                        }

                        else

                        {

                            @foreach (var tr in allTransactions.OrderBy(x => x.TransactionDate).ThenBy(x => x.CreatedAt))

                            {

                                decimal trTL = tr.AmountTL ?? (tr.Currency == "USD" ? tr.Amount * usdRate : (tr.Currency == "EUR" ? tr.Amount * eurRate : tr.Amount));

                                bool isGiris = tr.TransactionType == "Giris";

                                <tr>

                                    <td class="ps-3 font-monospace small text-muted">@tr.TransactionDate.ToString("dd.MM.yyyy")</td>

                                    <td>

                                        @if (isGiris)

                                        {

                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-0.5 rounded-pill">Sermaye / Avans</span>

                                        }

                                        else

                                        {

                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-0.5 rounded-pill">Harcama Çıkışı</span>

                                        }

                                    </td>

                                    <td class="text-dark small">

                                        <strong>@tr.PartyName</strong> — @tr.CategoryOrPurpose @(string.IsNullOrWhiteSpace(tr.Description) ? "" : $"({tr.Description})")

                                    </td>

                                    <td class="text-end font-monospace fw-bold @(isGiris ? "text-success" : "text-danger")">

                                        @(isGiris ? "+" : "-")@trTL.ToString("N2") ₺

                                    </td>

                                    <!-- Bizim Pay -->

                                    <td class="text-end font-monospace fw-bold border-start border-end" style="background-color: #ffffff;">

                                        @if (isGiris)

                                        {

                                            if (tr.PartyName != null && (tr.PartyName.Contains("Biz") || tr.PartyName.Contains("Ana Yüklenici") || tr.PartyName.Contains("Özkaynak")))

                                            {

                                                <span style="color: #166534; font-weight: 700;">+@trTL.ToString("N2") ₺</span>

                                            }

                                            else

                                            {

                                                <span class="text-muted">-</span>

                                            }

                                        }

                                        else

                                        {

                                            decimal ourShare = Math.Round(trTL * (Model.OurSharePercentage / 100m), 2);

                                            <span style="color: #b91c1c; font-weight: 700;">-@ourShare.ToString("N2") ₺</span>

                                        }

                                    </td>

                                    <!-- Ortaklar Payı -->

                                    @foreach (var p in partners)

                                    {

                                        <td class="text-end font-monospace fw-bold border-end" style="background-color: #ffffff;">

                                            @if (isGiris)

                                            {

                                                if (tr.PartyName != null && tr.PartyName.Contains(p.FullName))

                                                {

                                                    <span style="color: #166534; font-weight: 700;">+@trTL.ToString("N2") ₺</span>

                                                }

                                                else

                                                {

                                                    <span class="text-muted">-</span>

                                                }

                                            }

                                            else

                                            {

                                                decimal pShare = Math.Round(trTL * (p.SharePercentage / 100m), 2);

                                                <span style="color: #b91c1c; font-weight: 700;">-@pShare.ToString("N2") ₺</span>

                                            }

                                        </td>

                                    }

                                </tr>

                            }

                        }

                    </tbody>

                    <tfoot class="table-light fw-bold font-monospace border-top">

                        @{

                            decimal totalSpentTL = totalActualOutflowTL;

                            decimal ourSpentShare = Math.Round(totalSpentTL * (Model.OurSharePercentage / 100m), 2);

                            decimal ourMatrixNetBalance = totalOurAdvance - ourSpentShare;

                        }

                        <tr>

                            <td colspan="3" class="ps-3 text-uppercase">GENEL HESAPLAŞMA / KASADAKİ KALAN AVANS</td>

                            <td class="text-end text-dark">@totalSpentTL.ToString("N2") ₺</td>

                            <td class="text-end border-start border-end fs-6" style="background-color: #f1f5f9; font-weight: 800; color: @(ourMatrixNetBalance >= 0 ? "#166534" : "#b91c1c");">

                                @(ourMatrixNetBalance >= 0 ? "+" : "")@ourMatrixNetBalance.ToString("N2") ₺

                            </td>

                            @foreach (var p in partners)

                            {

                                decimal pAdvance = actualInflows.Where(x => x.PartyName != null && x.PartyName.Contains(p.FullName)).Sum(x => x.AmountTL ?? (x.Currency == "USD" ? x.Amount * usdRate : (x.Currency == "EUR" ? x.Amount * eurRate : x.Amount)));

                                decimal pSpent = Math.Round(totalSpentTL * (p.SharePercentage / 100m), 2);

                                decimal pNet = pAdvance - pSpent;

                                <td class="text-end border-end fs-6" style="background-color: #f8fafc; font-weight: 800; color: @(pNet >= 0 ? "#166534" : "#b91c1c");">

                                    @(pNet >= 0 ? "+" : "")@pNet.ToString("N2") ₺

                                </td>

                            }

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

    </div>

}

<!-- ================= MODAL 1: YENİ MASRAF / HAKEDİŞ EKLE ================= -->

<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">

