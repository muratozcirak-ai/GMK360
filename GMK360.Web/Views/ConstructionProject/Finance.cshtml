    function onBatchCategoryChanged(select) {
        const row = select.closest('tr');
        if (!row) return;
        const cat = select.value;
        const vatSelect = row.querySelector('.batch-vat');
        const vatTypeSelect = row.querySelector('.batch-vat-type');

        if (!vatSelect) return;

        if (cat.includes("Kira") || cat.includes("Taşınma") || cat.includes("Ruhsat")) {
            vatSelect.value = "0";
            vatSelect.disabled = true;
            if (vatTypeSelect) { vatTypeSelect.value = "dahil"; vatTypeSelect.disabled = true; }
        } else if (cat.includes("Yemek") || cat.includes("İaşe")) {
            vatSelect.disabled = false;
            vatSelect.value = "10";
            if (vatTypeSelect) { vatTypeSelect.disabled = false; vatTypeSelect.value = "dahil"; }
        } else if (cat.includes("Hakediş") || cat.includes("Malzeme") || cat.includes("Hafriyat")) {
            vatSelect.disabled = false;
            vatSelect.value = "20";
            if (vatTypeSelect) { vatTypeSelect.disabled = false; vatTypeSelect.value = "dahil"; }
        } else {
            vatSelect.disabled = false;
            if (vatTypeSelect) vatTypeSelect.disabled = false;
        }
        calcBatchTotals();
    }

