                <div class="modal-header py-2.5 px-3 bg-light border-bottom">

                    <div class="d-flex align-items-center gap-2">

                        <span class="badge bg-primary text-white rounded-circle p-1.5"><i class="bi bi-wallet2"></i></span>

                        <h6 class="modal-title fw-bold text-dark mb-0" id="newAccountModalLabel">Yeni Hesap / Kasa Aç</h6>

                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>

                </div>

                <div class="modal-body p-3">

                    <!-- 1. Hesap Niteliği (Resmi vs Elden / Özel Kasa) -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-dark mb-1">Hesap Niteliği <span class="text-danger">*</span></label>

                        <div class="d-flex gap-2">

                            <div class="form-check form-check-inline border rounded-2 px-3 py-2 flex-fill m-0 bg-white shadow-xs d-flex align-items-center gap-2">

                                <input class="form-check-input m-0" type="radio" name="accountKind" id="accKindResmi" value="Resmi" checked onchange="onNewAccKindChanged()">

                                <label class="form-check-label fw-bold small text-dark mb-0" for="accKindResmi" style="cursor: pointer;">

                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-0.5 rounded-pill me-1">Resmi</span> Resmi

                                </label>

                            </div>

                            <div class="form-check form-check-inline border rounded-2 px-3 py-2 flex-fill m-0 bg-white shadow-xs d-flex align-items-center gap-2">

                                <input class="form-check-input m-0" type="radio" name="accountKind" id="accKindElden" value="Elden" onchange="onNewAccKindChanged()">

                                <label class="form-check-label fw-bold small text-dark mb-0" for="accKindElden" style="cursor: pointer;">

                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-0.5 rounded-pill me-1">Elden</span> Elden

                                </label>

                            </div>

                        </div>

                    </div>

                    <!-- 2. Hesap / Kasa Türü -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-dark mb-1">Hesap / Kasa Türü <span class="text-danger">*</span></label>

                        <select name="accountType" id="newAccTypeSelect" class="form-select form-select-sm rounded-2 fw-semibold" onchange="onAccountTypeChanged()" required>

                            <option value="Banka Hesabı" selected>🏦 Resmi Banka Hesabı (Vadesiz)</option>

                            <option value="Banka Kiralık Kasası">🔐 Banka Özel Kasası / Kiralık Kasa</option>

                            <option value="Şahıs / Özel Banka Hesabı">👤 Şahıs / Özel Banka Hesabı (Elden / Nakit)</option>

                            <option value="Şirket Kasası">🏢 Şirket Merkez Kasası</option>

                            <option value="Şantiye Kasası">👷 Şantiye Kasası</option>

                        </select>

                    </div>

                    <!-- Banka ve Şube Bilgileri (Banka Kasasında ve Eldende de KORUNUR) -->

                    <div id="bankFieldsRow" class="row g-2 mb-2">

                        <div class="col-7">

                            <label class="form-label small fw-bold text-dark mb-1" id="lblBankName">Banka Adı <span class="text-danger" id="bankNameRequiredStar">*</span></label>

                            <input type="text" name="bankName" id="newAccBankName" class="form-control form-control-sm rounded-2" placeholder="Örn: Garanti BBVA, Denizbank" />

                        </div>

                        <div class="col-5">

                            <label class="form-label small fw-bold text-dark mb-1">Şube Kodu / Adı</label>

                            <input type="text" name="branchCode" id="newAccBranchCode" class="form-control form-control-sm rounded-2" placeholder="Örn: 0312 veya Göztepe" />

                        </div>

                    </div>

                    <!-- IBAN / Hesap / Kasa No -->

                    <div id="ibanFieldRow" class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1" id="lblIban">IBAN / Hesap No / Kasa No</label>

                        <input type="text" name="iban" id="newAccIban" class="form-control form-control-sm rounded-2 font-monospace" placeholder="Örn: TR... veya Kiralık Kasa No: 402" />

                    </div>

                    <!-- Hesap / Kasa Tanımı / Amacı -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1" id="lblAccountName">Hesap Adı / Kullanım Amacı <span class="text-danger">*</span></label>

                        <input type="text" name="accountName" id="newAccName" class="form-control form-control-sm rounded-2" placeholder="Örn: TL Proje Hesabı, Dolar Özel Kasası" required />

                    </div>

                    <!-- Para Birimi -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Para Birimi</label>

                        <select name="currency" class="form-select form-select-sm rounded-2">

                            <option value="TRY" selected>TL (₺ - Türk Lirası)</option>

                            <option value="USD">USD ($ - Amerikan Doları)</option>

                            <option value="EUR">EUR (€ - Euro)</option>

                        </select>

                    </div>

                    <div class="alert alert-light border small text-muted mb-0 py-1.5 px-2" style="font-size: 0.72rem;">

                        <i class="bi bi-info-circle me-1 text-primary"></i>Hesap açıldıktan sonra bakiye girişleri <strong>[+ Para Girişi]</strong> butonu ile dekontlu olarak eklenir.

                    </div>

                </div>

                <div class="modal-footer py-2 px-3 bg-light border-top">

                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>

                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">Hesabı / Kasayı Oluştur</button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ================= MODAL: HESABA PARA YATIR (#depositModal) ================= -->

<!-- ================= MODAL: ÇOKLU PARA / SERMAYE / TAHSİLAT SERİ GİRİŞ FİŞİ (#depositModal) ================= -->
<div class="modal fade" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 96%;">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header py-2 px-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success text-white rounded-circle p-1.5"><i class="bi bi-box-arrow-in-down fs-6"></i></span>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-0" id="depositModalLabel">📥 Çoklu Para / Sermaye / Tahsilat Seri Giriş Fişi (Muhasebeci Masası)</h6>
                        <small class="text-muted" style="font-size: 0.72rem;">Ortak sermayelerini, daire satış tahsilatlarını veya diğer gelirleri satır satır alt alta ekleyip ilgili kasalara tek seferde işleyebilirsiniz.</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-2 p-md-3">
                <!-- Üst Kontrol Çubuğu (Fiş Tarihi & Hızlı Ekle) -->
                <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded-2 border">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label small fw-bold text-dark mb-0">İşlem / Fiş Tarihi:</label>
                        <input type="date" id="batchDepositDefaultDate" class="form-control form-control-sm rounded-2" style="width: 140px;" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="applyDefaultDateToDepositRows()" />
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="addBatchDepositRow()">
                            <i class="bi bi-plus-lg me-1"></i>+ Yeni Satır Ekle
                        </button>
                    </div>
                </div>

                <!-- Satırlar Tablosu (Excel / Tahsilat Satırı Grid) -->
                <div class="table-responsive rounded-2 border bg-white" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-sm table-bordered align-middle mb-0" id="batchDepositTable" style="font-size: 0.80rem;">
                        <thead class="table-light text-muted small text-uppercase" style="position: sticky; top: 0; z-index: 2;">
                            <tr style="font-size: 0.70rem; letter-spacing: 0.5px;">
                                <th style="width: 32px;" class="text-center">#</th>
                                <th style="width: 105px;">TARİH</th>
                                <th style="min-width: 140px;">KİMDEN / MUHATAP</th>
                                <th style="min-width: 140px;">GİRİŞ TÜRÜ</th>
                                <th style="min-width: 170px;">HANGİ KASA / HESABA?</th>
                                <th style="width: 105px;" class="text-end">GİRİLEN TUTAR</th>
                                <th style="width: 135px;" class="text-center">KDV & TİP</th>
                                <th style="width: 115px;" class="text-end text-dark">SAF GELİR (NET)</th>
                                <th style="width: 95px;" class="text-end text-info">KDV TUTARI</th>
                                <th style="width: 115px;" class="text-end text-success fw-bold">TOPLAM GİRİŞ</th>
                                <th style="min-width: 120px;">DEKONT / REF NO</th>
                                <th style="min-width: 120px;">AÇIKLAMA</th>
                                <th style="width: 36px;" class="text-center">SİL</th>
                            </tr>
                        </thead>
                        <tbody id="batchDepositTbody">
                            <!-- Satırlar JS ile dinamik eklenir -->
                        </tbody>
                    </table>
                </div>

                <!-- Ortaklar Otomatik Tamamlama Listesi -->
                <datalist id="depositPartnersDatalist">
                    <option value="Ana Yüklenici (Biz - Firma Özkaynak)">Bizim Şirket Özkaynağı</option>
                    @if (Model.PartnerList != null)
                    {
                        @foreach (var p in Model.PartnerList)
                        {
        var pName = !string.IsNullOrWhiteSpace(p.CompanyName) ? p.CompanyName : $"{p.FirstName} {p.LastName}".Trim();
                            <option value="@pName (%@p.SharePercentage Ortak)">@p.SharePercentage% Proje Ortağı</option>
                        }
                    }
                    @foreach (var sh in stakeholders)
                    {
                        <option value="@(sh.User?.FullName ?? "Hak Sahibi") (Hak Sahibi)">Hak Sahibi</option>
                    }
                </datalist>
            </div>
            <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 font-monospace small" style="font-size: 0.82rem;">
                    <span>Satır: <b id="batchDepositRowCount" class="text-dark">0</b></span>
                    <span>Saf Net: <b id="batchDepositTotalNet" class="text-dark">0,00 ₺</b></span>
                    <span>KDV: <b id="batchDepositTotalVat" class="text-info">0,00 ₺</b></span>
                    <span class="fs-6 fw-bold">GENEL TOPLAM GİRİŞ: <b id="batchDepositTotalGross" class="text-success">0,00 ₺</b></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-xs" id="btnSaveBatchDeposits" onclick="submitBatchDeposits()">
                        <i class="bi bi-save me-1"></i>Tüm Satırları Kaydet ve Kasalara Ekle
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ================= MODAL: ÇOKLU FATURA & MASRAF SERİ GİRİŞ FİŞİ (#batchWithdrawModal) ================= -->

<div class="modal fade" id="batchWithdrawModal" tabindex="-1" aria-labelledby="batchWithdrawModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 96%;">

        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header py-2 px-3 bg-light border-bottom d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center gap-2">

                    <span class="badge bg-danger text-white rounded-circle p-1.5"><i class="bi bi-receipt-cutoff fs-6"></i></span>

                    <div>

                        <h6 class="modal-title fw-bold text-dark mb-0" id="batchWithdrawModalLabel">🧾 Çoklu Fatura & Masraf Seri Giriş Fişi (Muhasebeci Masası)</h6>

                        <small class="text-muted" style="font-size: 0.72rem;">Önünüzdeki faturaları ve fişleri satır satır alt alta ekleyip tek seferde kasadan düşebilirsiniz.</small>

                    </div>

                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>

            </div>

            <div class="modal-body p-2 p-md-3">

                <!-- Üst Kontrol Çubuğu (Fiş Tarihi & Hızlı Ekle) -->
                <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded-2 border">
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label small fw-bold text-dark mb-0">İşlem / Fiş Tarihi:</label>
                        <input type="date" id="batchDefaultDate" class="form-control form-control-sm rounded-2" style="width: 140px;" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="applyDefaultDateToBatchRows()" />
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-bold shadow-xs" onclick="addBatchRow()">
                            <i class="bi bi-plus-lg me-1"></i>+ Yeni Satır Ekle
                        </button>
                    </div>
                </div>

                <!-- Satırlar Tablosu (Excel / Fatura Satırı Grid) -->
                <div class="table-responsive rounded-2 border bg-white" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-sm table-bordered align-middle mb-0" id="batchWithdrawTable" style="font-size: 0.80rem;">
                        <thead class="table-light text-muted small text-uppercase" style="position: sticky; top: 0; z-index: 2;">
                            <tr style="font-size: 0.70rem; letter-spacing: 0.5px;">
                                <th style="width: 32px;" class="text-center">#</th>
                                <th style="width: 105px;">TARİH</th>
                                <th style="min-width: 140px;">KİME / MUHATAP</th>
                                <th style="min-width: 140px;">GİDER TÜRÜ</th>
                                <th style="min-width: 170px;">HANGİ KASA / HESAPTAN?</th>
                                <th style="width: 105px;" class="text-end">GİRİLEN TUTAR</th>
                                <th style="width: 135px;" class="text-center">KDV & TİP</th>
                                <th style="width: 115px;" class="text-end text-dark">SAF MATRAH (NET)</th>
                                <th style="width: 95px;" class="text-end text-info">KDV TUTARI</th>
                                <th style="width: 115px;" class="text-end text-danger fw-bold">TOPLAM ÇIKIŞ</th>
                                <th style="min-width: 120px;">FATURA / DEKONT / IBAN</th>
                                <th style="min-width: 120px;">AÇIKLAMA</th>
                                <th style="width: 36px;" class="text-center">SİL</th>
                            </tr>
                        </thead>
                        <tbody id="batchWithdrawTbody">

                            <!-- Satırlar JS ile dinamik eklenir -->

                        </tbody>

                    </table>

                </div>

                <!-- Hak Sahipleri Otomatik Tamamlama Listesi -->

                <datalist id="stakeholdersDatalist">

                    @foreach (var sh in stakeholders)

                    {

                        <option value="@(sh.User?.FullName ?? "Hak Sahibi") (Hak Sahibi)">IBAN: @sh.Iban - Kira: @((sh.MonthlyRentAllowance ?? 0m).ToString("N0")) ₺</option>

                    }

                </datalist>

            </div>

            <div class="modal-footer py-2 px-3 bg-light border-top d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div class="d-flex align-items-center gap-3 font-monospace small" style="font-size: 0.82rem;">

                    <span>Satır: <b id="batchRowCount" class="text-dark">0</b></span>

                    <span>Net Matrah: <b id="batchTotalNet" class="text-dark">0,00 ₺</b></span>

                    <span>KDV: <b id="batchTotalVat" class="text-info">0,00 ₺</b></span>

                    <span class="fs-6 fw-bold">GENEL TOPLAM: <b id="batchTotalGross" class="text-danger">0,00 ₺</b></span>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <button type="button" class="btn btn-sm btn-light border rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>

                    <button type="button" class="btn btn-sm btn-success rounded-pill px-4 fw-bold shadow-xs" id="btnSaveBatchWithdrawals" onclick="submitBatchWithdrawals()">

                        <i class="bi bi-check2-circle me-1"></i>💾 Tüm Satırları Kaydet ve Kasadan Düş

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-3">

            <form asp-action="AddProjectWithdrawal" asp-controller="ConstructionProject" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" name="projectId" value="@Model.Id" />

                <div class="modal-header py-2.5 px-3 bg-danger bg-opacity-10 border-bottom border-danger border-opacity-25">

                    <div class="d-flex align-items-center gap-2">

                        <span class="badge bg-danger text-white rounded-circle p-1.5"><i class="bi bi-box-arrow-up-right fs-6"></i></span>

                        <div>

                            <h6 class="modal-title fw-bold text-danger mb-0" id="withdrawModalLabel">Hesaptan Para Çıkışı / Ödeme Yap</h6>

                            <span class="text-muted small" style="font-size: 0.72rem;" id="withdrawAccountDisplayName">Kaynak Kasa & Gider Türü</span>

                        </div>

                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>

                </div>

                <div class="modal-body p-3">

                    <!-- Kaynak Kasa Seçimi (Dropdown) -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Hangi Kasadan / Hesaptan Çıkacak? <span class="text-danger">*</span></label>

                        <select name="sourceBankAccountId" id="withdrawAccountId" class="form-select form-select-sm rounded-2 fw-semibold" onchange="onWithdrawAccountChanged(this)" required>

                            @foreach (var acc in accountsList)

                            {

                                string accCur = DetectAccountCurrency(acc);

                                string accSym = GetAccountSymbol(accCur);

                                <option value="@acc.Id" data-currency="@accSym" data-name="@acc.BankName - @acc.AccountName" data-balance="@acc.CurrentBalance">

                                    @acc.BankName - @acc.AccountName (@acc.CurrentBalance.ToString("N2") @accSym)

                                </option>

                            }

                        </select>

                    </div>

                    <!-- Hesap Türü: Resmi vs Elden -->

                    <div class="mb-2.5">

                        <label class="form-label small fw-bold text-dark mb-1">Hesap Türü</label>

                        <div class="d-flex gap-3">

                            <div class="form-check">

                                <input class="form-check-input" type="radio" name="accountKind" id="withdrawKindResmi" value="Resmi" checked onchange="onWithdrawAccountKindChanged('Resmi')" />

                                <label class="form-check-label small fw-bold text-primary" for="withdrawKindResmi">🏛️ Resmi Banka Hesabı</label>

                            </div>

                            <div class="form-check">

                                <input class="form-check-input" type="radio" name="accountKind" id="withdrawKindElden" value="Elden" onchange="onWithdrawAccountKindChanged('Elden')" />

                                <label class="form-check-label small fw-bold text-secondary" for="withdrawKindElden">💵 Elden Nakit (KDV %0)</label>

                            </div>

                        </div>

                    </div>

                    <!-- Gider Türü (Ne İçin) -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Para Nereye Çıkıyor? (Gider Türü) <span class="text-danger">*</span></label>

                        <select name="outflowCategory" id="selOutflowCategory" class="form-select form-select-sm rounded-2 fw-semibold" onchange="onOutflowCategoryChanged()" required>

                            <option value="Hak Sahipleri Aylık Kira Desteği">🏠 Hak Sahipleri Aylık Kira Desteği</option>

                            <option value="Hak Sahipleri Taşınma Yardımı / Bedeli">📦 Hak Sahipleri Taşınma Yardımı</option>

                            <option value="Şantiye Masrafı & İaşe / Yemek Gideri">🍲 Şantiye İaşesi, Yemek & Mutfak Gideri</option>

                            <option value="Taşeron Hakedişi" selected>🏗️ Taşeron Hakedişi (Kalıp, Demir, Duvar vb.)</option>

                            <option value="Ana Malzeme (Demir, Beton, Tuğla vb.)">🧱 Ana İmalat Malzemesi (Beton, Demir vb.)</option>

                            <option value="Sarf Malzeme & Hırdavat">🔩 Sarf Malzeme & Hırdavat</option>

                            <option value="Akaryakıt & Mazot Gideri">⛽ Akaryakıt & Mazot Gideri</option>

                            <option value="Resmi Harç / Ruhsat / Proje / Yapı Denetim">🏛️ Resmi Harç / Ruhsat / Yapı Denetim</option>

                            <option value="Virman">🔄 Kasalar Arası Virman (Başka Hesaba Aktarım)</option>

                            <option value="Ortağa Avans İadesi / Kâr Dağıtımı">🤝 Ortağa Avans İadesi / Kâr Dağıtımı</option>

                            <option value="Diğer Şantiye Gideri">📝 Diğer Genel Şantiye Gideri</option>

                        </select>

                    </div>

                    <!-- Dinamik Alan: Virman Hedef Kasa -->

                    <div id="virmanTargetRow" class="mb-2" style="display: none;">

                        <label class="form-label small fw-bold text-dark mb-1">Hedef Hesap / Kasa <span class="text-danger">*</span></label>

                        <select name="targetBankAccountId" id="selTargetBankAccount" class="form-select form-select-sm rounded-2">

                            @foreach (var acc in accountsList)

                            {

                                <option value="@acc.Id">@acc.BankName - @acc.AccountName</option>

                            }

                        </select>

                    </div>

                    <!-- Kayıtlı Hak Sahipleri Hızlı Seçim Listesi (Kira Desteği vb. için) -->

                    <div class="mb-2" id="hakSahibiQuickSelectGroup">

                        <label class="form-label small fw-bold text-success mb-1 d-flex justify-content-between align-items-center">

                            <span><i class="bi bi-people-fill me-1"></i>Hak Sahibi / Arsa Sahibi (Kayıtlı Listeden Seç)</span>

                            <span class="text-muted" style="font-size: 0.68rem;">(Seçince Ad, IBAN ve Kira Otomatik Gelir)</span>

                        </label>

                        <select id="selHakSahibiQuick" class="form-select form-select-sm rounded-2 border-success border-opacity-50" onchange="onHakSahibiSelected(this)">

                            <option value="">-- Kayıtlı Hak Sahibi Seçin (Opsiyonel) --</option>

                            @foreach (var s in stakeholders)

                            {

                                string sName = s.User?.FullName ?? "Hak Sahibi";

                                string sPhone = s.User?.PhoneNumber ?? "";

                                string sEmail = s.User?.Email ?? "";

                                string sIban = s.Iban ?? "";

                                decimal sRent = s.MonthlyRentAllowance ?? 0m;

                                <option value="@sName" data-iban="@sIban" data-phone="@sPhone" data-email="@sEmail" data-rent="@sRent" data-units="@s.UnitNumbers">

                                    @sName @(!string.IsNullOrWhiteSpace(s.UnitNumbers) ? $"({s.UnitNumbers})" : "") @(sRent > 0 ? $"| Kira: {sRent:N0} ₺" : "") @(!string.IsNullOrWhiteSpace(sIban) ? $"| {sIban}" : "")

                                </option>

                            }

                        </select>

                    </div>

                    <!-- Dinamik Alan: Kime / Nereye Ödendi -->

                    <div id="recipientRow" class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1" id="lblRecipient">Kime Ödendi / Muhatap Adı <span class="text-danger">*</span></label>

                        <input type="text" name="recipientName" id="inpRecipientName" list="recipientSuggestionsList" class="form-control form-control-sm rounded-2 fw-semibold" placeholder="Örn: Hak Sahibi Ali İnan, Kalıpçı Taşeronu vb." required />

                        <datalist id="recipientSuggestionsList">

                            @if (Model.IsJointVenture && Model.PartnerList.Count > 0)

                            {

                                @foreach (var p in Model.PartnerList)

                                {

                                    <option value="@p.FullName (Ortak)" />

                                }

                            }

                            @foreach (var s in stakeholders)

                            {

                                <option value="@(s.User?.FullName ?? "Hak Sahibi") (Hak Sahibi)" />

                            }

                            <option value="Demirci Taşeronu" />

                            <option value="Kalıpçı Taşeronu" />

                            <option value="Hazır Beton Firması" />

                            <option value="Hafriyat ve Kazı Firması" />

                            <option value="Şantiye Yemek & İaşe Sorumlusu" />

                            <option value="Akaryakıt / Mazot Tedarikçisi" />

                            <option value="Belediye Ruhsat / İmar Şefliği" />

                            <option value="Yapı Denetim Firması" />

                        </datalist>

                    </div>

                    <!-- Ödeme / Teslim Yolu (IBAN vs Elden) -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Ödeme / Teslim Şekli <span class="text-danger">*</span></label>

                        <div class="d-flex gap-3">

                            <div class="form-check">

                                <input class="form-check-input" type="radio" name="paymentMethod" id="withdrawPayIban" value="IBAN" checked onchange="onPaymentMethodChanged('IBAN')" />

                                <label class="form-check-label small fw-bold text-primary" for="withdrawPayIban">

                                    <i class="bi bi-bank me-1"></i>Banka Havalesi / IBAN'a EFT

                                </label>

                            </div>

                            <div class="form-check">

                                <input class="form-check-input" type="radio" name="paymentMethod" id="withdrawPayElden" value="Elden" onchange="onPaymentMethodChanged('Elden')" />

                                <label class="form-check-label small fw-bold text-secondary" for="withdrawPayElden">

                                    <i class="bi bi-cash-stack me-1"></i>Elden Nakit Teslim Tutanağı

                                </label>

                            </div>

                        </div>

                    </div>

                    <!-- IBAN ve Banka Alanları (Banka seçildiğinde görünür) -->

                    <div id="ibanFieldsContainer" class="p-2.5 border rounded-3 bg-light mb-2">

                        <div class="row g-2">

                            <div class="col-8">

                                <label class="form-label small fw-bold text-dark mb-1">

                                    <i class="bi bi-credit-card-2-front text-primary me-1"></i>Alıcı IBAN Numarası

                                </label>

                                <input type="text" name="recipientIban" id="inpRecipientIban" class="form-control form-control-sm rounded-2 font-monospace fw-bold" placeholder="TR00 0000 0000 0000 0000 0000 00" maxlength="34" />

                            </div>

                            <div class="col-4">

                                <label class="form-label small fw-bold text-dark mb-1">Alıcı Bankası</label>

                                <input type="text" name="recipientBank" id="inpRecipientBank" class="form-control form-control-sm rounded-2" placeholder="Örn: Ziraat, Garanti" />

                            </div>

                        </div>

                        <small class="text-muted d-block mt-1" style="font-size: 0.68rem;">

                            Hak sahibinin kira desteği IBAN'ı veya taşeronun banka hesap bilgisi

                        </small>

                    </div>

                    <!-- Tutar & Tarih -->

                    <div class="row g-2 mb-2">

                        <div class="col-7">

                            <label class="form-label small fw-bold text-dark mb-1">Çıkış Tutarı <span class="text-danger">*</span></label>

                            <div class="input-group input-group-sm">

                                <input type="number" step="0.01" min="0.01" name="amount" id="withdrawAmountInput" class="form-control rounded-start-2 font-monospace fw-bold" placeholder="0.00" oninput="calcWithdrawVat()" required />

                                <span class="input-group-text bg-light text-muted font-monospace" id="withdrawCurrencySymbol">₺</span>

                            </div>

                        </div>

                        <div class="col-5">

                            <label class="form-label small fw-bold text-dark mb-1">İşlem Tarihi</label>

                            <input type="date" name="transactionDate" class="form-control form-control-sm rounded-2 font-monospace" value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        </div>

                    </div>

                    <!-- KDV Oranı & Tutar Ayrımı -->

                    <div class="row g-2 mb-2">

                        <div class="col-6">

                            <label class="form-label small fw-bold text-dark mb-1">KDV Oranı (%)</label>

                            <select name="vatRate" id="selWithdrawVatRate" class="form-select form-select-sm rounded-2 font-monospace fw-bold" onchange="calcWithdrawVat()">

                                <option value="0" selected>%0 (KDV'siz / Harç / Elden)</option>

                                <option value="1">%1 (İndirimli Oran)</option>

                                <option value="10">%10 (Gıda / Hizmet)</option>

                                <option value="20">%20 (Standart Fatura / Malzeme)</option>

                            </select>

                        </div>

                        <div class="col-6">

                            <label class="form-label small fw-bold text-muted mb-1">KDV / Net Ayrımı</label>

                            <div id="vatBreakdownBadge" class="p-1 border rounded-2 bg-light text-center font-monospace small" style="font-size: 0.72rem;">

                                Net: <span id="lblNetCalc" class="fw-bold text-dark">0.00</span> | KDV: <span id="lblVatCalc" class="fw-bold text-info">0.00</span>

                            </div>

                        </div>

                    </div>

                    <!-- Açıklama -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Açıklama</label>

                        <input type="text" name="notes" class="form-control form-control-sm rounded-2" placeholder="Örn: 2 kamyon kaba kum ve çimento nakliyesi ödendi" />

                    </div>

                    <!-- Evrak / Dekont Yükleme -->

                    <div class="p-2.5 border rounded-3 bg-light mb-1 shadow-xs">

                        <label class="form-label small fw-bold text-dark mb-1 d-flex align-items-center justify-content-between">

                            <span><i class="bi bi-file-earmark-arrow-up-fill text-danger me-1"></i>Fatura / Fiş / Dekont Yükle</span>

                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-1.5 py-0" style="font-size: 0.65rem;">PDF veya Resim</span>

                        </label>

                        <input type="file" name="receiptFile" class="form-control form-control-sm rounded-2 bg-white" accept=".pdf,image/*" />

                        <small class="text-muted d-block mt-1" style="font-size: 0.68rem;">

                            Ödeme dekontu, fatura veya şantiye tediye makbuzu ekleyebilirsiniz.

                        </small>

                    </div>

                </div>

                <div class="modal-footer py-2 px-3 bg-light border-top">

                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">İptal</button>

                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">

                        <i class="bi bi-check-circle me-1"></i>Para Çıkışını Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ================= MODAL: BEKLENEN GİRİŞ EKLE (#addExpectedInflowModal) ================= -->

<div class="modal fade" id="addExpectedInflowModal" tabindex="-1" aria-labelledby="addExpectedInflowModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-3">

            <form asp-action="AddExpectedTransaction" asp-controller="ConstructionProject" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" name="projectId" value="@Model.Id" />

                <input type="hidden" name="direction" value="Inflow" />

                <div class="modal-header py-2.5 px-3 bg-success bg-opacity-10 border-bottom border-success border-opacity-25">

                    <div class="d-flex align-items-center gap-2">

                        <span class="badge bg-success text-white rounded-circle p-1.5"><i class="bi bi-calendar-plus fs-6"></i></span>

                        <div>

                            <h6 class="modal-title fw-bold text-success mb-0" id="addExpectedInflowModalLabel">Beklenen Giriş / Gelecek Tahsilat Ekle</h6>

                            <span class="text-muted small" style="font-size: 0.72rem;">Planlanan ortak sermayesi, daire satışı veya alacak</span>

                        </div>

                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>

                </div>

                <div class="modal-body p-3">

                    <!-- Kimden / Kaynak -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Kimden Bekleniyor? (Kaynak / Ortak) <span class="text-danger">*</span></label>

                        <input type="text" name="partyName" list="expectedInflowPartyList" class="form-control form-control-sm rounded-2 fw-semibold" placeholder="Örn: Ahmet Karakaya (Proje Ortağı)" required />

                        <datalist id="expectedInflowPartyList">

                            @if (Model.IsJointVenture && Model.PartnerList.Count > 0)

                            {

                                @foreach (var p in Model.PartnerList)

                                {

                                    <option value="@p.FullName (@p.SharePercentage.ToString("0.#")% Ortak)" />

                                }

                            }

                            <option value="Firma Özkaynak (Biz)" />

                            <option value="Daire Satış Müşterisi" />

                            <option value="Yıkım & Hurda İhalesi Alıcısı" />

                        </datalist>

                    </div>

                    <!-- Vade: Tarih 1 & Tarih 2 (Esnek Vade) -->

                    <div class="row g-2 mb-2">

                        <div class="col-6">

                            <label class="form-label small fw-bold text-dark mb-1">

                                Vade Başlangıç (Tarih 1) <span class="text-danger">*</span>

                            </label>

                            <input type="date" name="date1" class="form-control form-control-sm rounded-2 font-monospace" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />

                        </div>

                        <div class="col-6">

                            <label class="form-label small fw-bold text-muted mb-1">

                                Vade Bitiş (Tarih 2) <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">Opsiyonel</span>

                            </label>

                            <input type="date" name="date2" class="form-control form-control-sm rounded-2 font-monospace" placeholder="Net değilse aralık sonu" />

                        </div>

                        <div class="col-12">

                            <span class="text-muted" style="font-size: 0.68rem;">

                                <i class="bi bi-info-circle me-0.5"></i>Tarih 1 kesin vade veya hafta başıdır. Ortak "bu hafta içi öderim" derse Tarih 2 hafta sonu verilebilir.

                            </span>

                        </div>

                    </div>

                    <!-- Hesap Türü & Hedef Kasa -->

                    <div class="row g-2 mb-2">

                        <div class="col-5">

                            <label class="form-label small fw-bold text-dark mb-1">Hesap Türü</label>

                            <select name="accountType" class="form-select form-select-sm rounded-2">

                                <option value="Resmi" selected>🏛️ Resmi Banka</option>

                                <option value="Elden">💵 Elden Nakit</option>

                            </select>

                        </div>

                        <div class="col-7">

                            <label class="form-label small fw-bold text-dark mb-1">Hangi Hesaba Gelecek?</label>

                            <select name="targetBankAccountId" class="form-select form-select-sm rounded-2">

                                <option value="">(Belirlenmedi / Herhangi Biri)</option>

                                @foreach (var acc in accountsList)

                                {

                                    <option value="@acc.Id">@acc.BankName - @acc.AccountName</option>

                                }

                            </select>

                        </div>

                    </div>

                    <!-- Tutar & Para Birimi -->

                    <div class="row g-2 mb-2">

                        <div class="col-8">

                            <label class="form-label small fw-bold text-dark mb-1">Beklenen Tutar <span class="text-danger">*</span></label>

                            <input type="number" step="0.01" min="0.01" name="amount" class="form-control form-control-sm rounded-2 font-monospace fw-bold" placeholder="0.00" required />

                        </div>

                        <div class="col-4">

                            <label class="form-label small fw-bold text-dark mb-1">Para Birimi</label>

                            <select name="currency" class="form-select form-select-sm rounded-2 font-monospace fw-bold">

                                <option value="TRY" selected>₺ (TRY)</option>

                                <option value="USD">$ (USD)</option>

                                <option value="EUR">€ (EUR)</option>

                            </select>

                        </div>

                    </div>

                    <!-- Ne İçin -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Ne İçin? (Tahsilat Amacı)</label>

                        <select name="categoryOrPurpose" class="form-select form-select-sm rounded-2">

                            <option value="Ortak Sermaye Çağrısı" selected>🤝 Ortak Sermaye / Avans Çağrısı</option>

                            <option value="Daire Satış Taksiti / Sözleşme Bedeli">🏢 Daire Satış Taksiti / Sözleşme Bedeli</option>

                            <option value="Yıkım & Hurda İhalesi Bedeli">🔨 Yıkım & Hurda İhalesi Bedeli</option>

                            <option value="Diğer Proje Alacağı">💼 Diğer Proje Alacağı / Transfer</option>

                        </select>

                    </div>

                    <!-- Açıklama & Evrak -->

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-dark mb-1">Açıklama</label>

                        <input type="text" name="notes" class="form-control form-control-sm rounded-2" placeholder="Örn: 1. Etap hafriyat öncesi ortak sermaye tamamlama payı" />

                    </div>

                    <div class="p-2 border rounded-2 bg-light">

                        <label class="form-label small fw-bold text-dark mb-1">Sözleşme / Protokol Belgesi (Opsiyonel)</label>

                        <input type="file" name="documentFile" class="form-control form-control-sm rounded-2 bg-white" accept=".pdf,image/*" />

                    </div>

                </div>

                <div class="modal-footer py-2 px-3 bg-light border-top">

                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">İptal</button>

                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">

                        <i class="bi bi-check-circle me-1"></i>Beklenen Girişi Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ================= MODAL: BEKLENEN ÇIKIŞ EKLE (#addExpectedOutflowModal) ================= -->

<div class="modal fade" id="addExpectedOutflowModal" tabindex="-1" aria-labelledby="addExpectedOutflowModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-3">

            <form asp-action="AddExpectedTransaction" asp-controller="ConstructionProject" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" name="projectId" value="@Model.Id" />

                <input type="hidden" name="direction" value="Outflow" />

                <div class="modal-header py-2.5 px-3 bg-warning bg-opacity-15 border-bottom border-warning border-opacity-25">

