    function calcWithdrawVat() {

        const amtInput = document.getElementById("withdrawAmountInput");

        const amt = amtInput ? (parseFloat(amtInput.value) || 0) : 0;

        const selVat = document.getElementById("selWithdrawVatRate");

        const vatRate = selVat ? (parseInt(selVat.value) || 0) : 0;

        const lblNet = document.getElementById("lblNetCalc");

        const lblVat = document.getElementById("lblVatCalc");

        if (vatRate <= 0) {

            if (lblNet) lblNet.textContent = amt.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (lblVat) lblVat.textContent = "0.00";

        } else {

            const vatAmt = amt - (amt / (1 + (vatRate / 100)));

            const netAmt = amt - vatAmt;

            if (lblNet) lblNet.textContent = netAmt.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            if (lblVat) lblVat.textContent = vatAmt.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        }

    }

