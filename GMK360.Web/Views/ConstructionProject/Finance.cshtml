                    } else {
                        gross = amtVal;
                        vat = amtVal - (amtVal / (1 + (vatVal / 100)));
                        net = gross - vat;
                    }
                }
                totalNet += net;
                totalVat += vat;
                totalGross += gross;
            }

            const rowNetEl = r.querySelector('.batch-dep-row-net');
            if (rowNetEl) rowNetEl.innerText = net.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            const rowVatEl = r.querySelector('.batch-dep-row-vat');
            if (rowVatEl) rowVatEl.innerText = vat.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            const rowGrossEl = r.querySelector('.batch-dep-row-gross');
            if (rowGrossEl) rowGrossEl.innerText = gross.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        });

        const cntEl = document.getElementById('batchDepositRowCount');
        if (cntEl) cntEl.innerText = count;
        const netEl = document.getElementById('batchDepositTotalNet');
        if (netEl) netEl.innerText = totalNet.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        const vatEl = document.getElementById('batchDepositTotalVat');
        if (vatEl) vatEl.innerText = totalVat.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        const grossEl = document.getElementById('batchDepositTotalGross');
        if (grossEl) grossEl.innerText = totalGross.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
    }

    async function submitBatchDeposits() {
        const projectId = @Model.Id;
        const rows = document.querySelectorAll('#batchDepositTbody tr');
        const items = [];

        for (let i = 0; i < rows.length; i++) {
            const r = rows[i];
            const amt = parseFloat(r.querySelector('.batch-dep-amount')?.value) || 0;
            const source = r.querySelector('.batch-dep-source')?.value.trim();
            const accSelect = r.querySelector('.batch-dep-account-id');
            const accId = parseInt(accSelect?.value) || 0;
            const catSelect = r.querySelector('.batch-dep-category');
            const vatSelect = r.querySelector('.batch-dep-vat');
            const vatTypeSelect = r.querySelector('.batch-dep-vat-type');
            const refNo = r.querySelector('.batch-dep-ref')?.value.trim() || null;
            const notes = r.querySelector('.batch-dep-notes')?.value.trim() || null;

            if (amt > 0 || source) {
                if (!source) {
                    alert(`${i + 1}. satırda kimden/kaynak bilgisi boş bırakılamaz.`);
                    return;
                }
                if (amt <= 0) {
                    alert(`${i + 1}. satırda tutar bilgisi girilmelidir.`);
                    return;
                }
                if (!accId) {
                    alert(`${i + 1}. satırda kasa/hesap seçimi yapılmadı. Lütfen paranın gireceği hesabı seçiniz.`);
                    return;
                }

                const chosenAcc = projectAccountsData.find(a => a.id === accId);
                const isResmi = chosenAcc ? chosenAcc.isResmi : true;

                items.push({
                    transactionDate: r.querySelector('.batch-dep-date')?.value || null,
                    sourceName: source,
                    inflowCategory: catSelect && catSelect.value ? catSelect.value : "Ortak Sermaye / Avansı",
                    bankAccountId: accId,
                    paymentMethod: isResmi ? "IBAN" : "Elden",
                    senderIban: refNo,
                    senderBank: null,
                    amount: amt,
                    currency: "TRY",
                    vatRate: vatSelect ? parseInt(vatSelect.value) || 0 : 0,
                    vatType: vatTypeSelect ? vatTypeSelect.value : "dahil",
                    notes: notes
                });
            }
        }

        if (items.length === 0) {
            alert('Lütfen kaydedilecek en az bir satır (kimden, tutar ve hesap) giriniz.');
            return;
        }

        const btn = document.getElementById('btnSaveBatchDeposits');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kaydediliyor...';
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/ConstructionProject/AddProjectBatchDeposits', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    projectId: projectId,
                    targetBankAccountId: items[0].bankAccountId,
                    items: items
                })
            });

            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Kayıt sırasında bir hata oluştu.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-save me-1"></i>Tüm Satırları Kaydet ve Kasalara Ekle';
                }
            }
        } catch (err) {
            console.error(err);
            alert('Sunucu ile iletişim kurulurken hata oluştu.');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save me-1"></i>Tüm Satırları Kaydet ve Kasalara Ekle';
            }
        }
    }
