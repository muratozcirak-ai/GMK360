                            </div>

                            <div class="form-check">

                                <input class="form-check-input" type="radio" name="paymentMethod" id="expPayElden" value="Elden" onchange="onExpectedPaymentMethodChanged('Elden')" />

                                <label class="form-check-label small fw-bold text-secondary" for="expPayElden">

                                    <i class="bi bi-cash-stack me-1"></i>Elden Nakit Teslim

                                </label>

                            </div>

                        </div>

                    </div>

                    <!-- IBAN ve Banka Alanları -->

                    <div id="expectedIbanFieldsContainer" class="p-2 border rounded-2 bg-light mb-2">

                        <div class="row g-2">

                            <div class="col-8">

                                <label class="form-label small fw-bold text-dark mb-1">Alıcı IBAN Numarası</label>

                                <input type="text" name="recipientIban" id="expRecipientIban" class="form-control form-control-sm rounded-2 font-monospace fw-bold" placeholder="TR00 0000 0000 0000 0000 0000 00" maxlength="34" />

                            </div>

                            <div class="col-4">

                                <label class="form-label small fw-bold text-dark mb-1">Alıcı Bankası</label>

                                <input type="text" name="recipientBank" id="expRecipientBank" class="form-control form-control-sm rounded-2" placeholder="Örn: VakıfBank" />

                            </div>

                        </div>

                    </div>

                    <!-- Vade: Tarih 1 & Tarih 2 (Esnek Vade) -->

                    <div class="row g-2 mb-2">

                        <div class="col-6">

                            <label class="form-label small fw-bold text-dark mb-1">

                                Vade Başlangıç (Tarih 1) <span class="text-danger">*</span>

                            </label>

                            <input type="date" name="date1" class="form-control form-control-sm rounded-2 font-monospace" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />

                        </div>

                        <div class="col-6">

                            <label class="form-label small fw-bold text-muted mb-1">

                                Vade Bitiş (Tarih 2) <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">Opsiyonel</span>

                            </label>

                            <input type="date" name="date2" class="form-control form-control-sm rounded-2 font-monospace" placeholder="Net değilse aralık sonu" />

                        </div>

                        <div class="col-12">

                            <span class="text-muted" style="font-size: 0.68rem;">

                                <i class="bi bi-info-circle me-0.5"></i>Ayın ilk haftası veya hafta içi ödenecekler için Tarih 1 ve Tarih 2 ile esnek vade aralığı verebilirsiniz.

                            </span>

                        </div>

                    </div>

                    <!-- Hesap Türü & Hangi Hesaptan -->

                    <div class="row g-2 mb-2">

                        <div class="col-5">

                            <label class="form-label small fw-bold text-dark mb-1">Hesap Türü</label>

                            <select name="accountType" class="form-select form-select-sm rounded-2">

