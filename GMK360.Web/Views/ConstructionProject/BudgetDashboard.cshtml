@model IEnumerable<GMK360.Core.Entities.Construction.ConstructionBudgetItem>
@{
    ViewData["Title"] = "Ana Bütçe ve Satın Alma Paneli";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    
    // Calculate Totals
    decimal totalPlanned = Model.Sum(x => x.PlannedTotalCost);
    decimal totalActual = Model.Sum(x => x.ActualTotalCost);
    decimal totalRemaining = totalPlanned - totalActual;
}

<div class="container-fluid mt-4">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-wallet2 text-primary me-2"></i> Bütçe ve Maliyet Merkezi</h2>
            <p class="text-muted mb-0">@ViewBag.ProjectName - Gerçek Zamanlı Maliyet ve Kar/Zarar Takibi</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-warning fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#emergencyRequestModal">
                <i class="bi bi-exclamation-triangle me-1"></i> Beklenmeyen Gider (Acil Onay)
            </button>
            <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addBudgetItemModal">
                <i class="bi bi-plus-lg me-1"></i> Yeni Bütçe Kalemi Ekle
            </button>
        </div>
    </div>

    <!-- WIDGETS -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <h6 class="text-muted fw-bold mb-2">TOPLAM PLANLANAN BÜTÇE</h6>
                    <h3 class="fw-bold text-primary mb-0">@totalPlanned.ToString("N2") ₺</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <h6 class="text-muted fw-bold mb-2">GERÇEKLEŞEN (ONAYLI) HARCAMA</h6>
                    <h3 class="fw-bold text-danger mb-0">@totalActual.ToString("N2") ₺</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 @(totalRemaining < 0 ? "bg-danger text-white" : "bg-success text-white")">
                <div class="card-body p-4 text-center">
                    <h6 class="fw-bold mb-2 text-white-50">KALAN LİMİT / SAPMA</h6>
                    <h3 class="fw-bold mb-0">@totalRemaining.ToString("N2") ₺</h3>
                    @if(totalRemaining < 0) {
                        <small><i class="bi bi-arrow-up-circle"></i> Bütçe aşıldı!</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- BÜTÇE TABLOSU (TEK EKRAN KURALI) -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0 text-dark">İş Kırılım Yapısı (WBS) ve Maliyetler</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">İŞ KALEMİ / AÇIKLAMA</th>
                            <th>DURUM</th>
                            <th class="text-end">MİKTAR</th>
                            <th class="text-end">BİRİM FİYAT (Plan)</th>
                            <th class="text-end text-primary">PLANLANAN BÜTÇE</th>
                            <th class="text-end text-danger">GERÇEKLEŞEN</th>
                            <th class="text-end pe-4">FARK</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var phase in Enum.GetValues(typeof(GMK360.Core.Entities.Construction.BudgetPhaseCategory)).Cast<GMK360.Core.Entities.Construction.BudgetPhaseCategory>())
                        {
                            var phaseItems = Model.Where(m => m.PhaseCategory == phase).ToList();
                            
                            <!-- FAZ BAŞLIĞI -->
                            <tr class="table-secondary border-bottom border-top border-2">
                                <td colspan="7" class="ps-4 py-2">
                                    <h6 class="fw-bold mb-0 text-dark text-uppercase"><i class="bi bi-layers me-2"></i> FAZ @((int)phase): @phase.ToString()</h6>
                                </td>
                            </tr>
                            
                            if (!phaseItems.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3 fst-italic">Bu faza henüz bütçe kalemi eklenmedi.</td>
                                </tr>
                            }
                            else
                            {
                                foreach(var item in phaseItems)
                                {
                                    decimal diff = item.PlannedTotalCost - item.ActualTotalCost;
                                    <tr class="@(item.IsUnplannedExtra ? "bg-warning bg-opacity-10" : "")">
                                        <td class="ps-4">
                                            <span class="fw-bold d-block text-dark">@item.ItemName</span>
                                            @if(item.IsUnplannedExtra) {
                                                <span class="badge bg-danger rounded-pill mt-1" style="font-size: 0.7rem;">Ekstra / Öngörülmeyen</span>
                                            }
                                            @if(item.SourceType == GMK360.Core.Entities.Construction.BudgetItemSourceType.DXF) {
                                                <span class="badge bg-info text-dark rounded-pill mt-1" style="font-size: 0.7rem;"><i class="bi bi-boxes"></i> DXF Metrajı</span>
                                            }
                                            <div class="small text-muted mt-1">@item.Description</div>
                                        </td>
                                        <td>
                                            @if(item.QuoteStatus == GMK360.Core.Entities.Construction.BudgetQuoteStatus.WaitingForPrice) {
                                                <span class="badge bg-secondary">Fiyat Bekleniyor</span>
                                            } else if(item.QuoteStatus == GMK360.Core.Entities.Construction.BudgetQuoteStatus.EstimatedOrQuoted) {
                                                <span class="badge bg-primary">Planlandı (Teklifli)</span>
                                            } else {
                                                <span class="badge bg-success">Gerçekleşti (Fatura)</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold">@item.Quantity.ToString("N2") <small class="text-muted fw-normal">@item.Unit</small></td>
                                        <td class="text-end">@item.PlannedUnitPrice.ToString("N2") ₺</td>
                                        <td class="text-end fw-bold text-primary">@item.PlannedTotalCost.ToString("N2") ₺</td>
                                        <td class="text-end fw-bold text-danger">@item.ActualTotalCost.ToString("N2") ₺</td>
                                        <td class="text-end pe-4 fw-bold @(diff < 0 ? "text-danger" : "text-success")">
                                            @(diff > 0 ? "+" : "")@diff.ToString("N2") ₺
                                        </td>
                                    </tr>
                                }
                            }
                            
                            <!-- FAZ ALT TOPLAMI VE BUTONLAR -->
                            var phasePlanned = phaseItems.Sum(x => x.PlannedTotalCost);
                            var phaseActual = phaseItems.Sum(x => x.ActualTotalCost);
                            var phaseDiff = phasePlanned - phaseActual;
                            
                            <tr class="bg-light border-bottom border-2">
                                <td colspan="4" class="text-end fw-bold text-muted py-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill me-3 float-start" onclick="alert('Yeni kalem modalı açılacak')"><i class="bi bi-plus"></i> Kalem Ekle</button>
                                    FAZ TOPLAMI:
                                </td>
                                <td class="text-end fw-bold text-primary py-2">@phasePlanned.ToString("N2") ₺</td>
                                <td class="text-end fw-bold text-danger py-2">@phaseActual.ToString("N2") ₺</td>
                                <td class="text-end pe-4 fw-bold @(phaseDiff < 0 ? "text-danger" : "text-success") py-2">@phaseDiff.ToString("N2") ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
