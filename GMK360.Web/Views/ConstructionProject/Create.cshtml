                document.getElementById('line-2').className = "step-line";
                
                var oldContainer = document.getElementById('oldBlocksContainer');
                var newContainer = document.getElementById('newBlocksContainer');
                if(oldContainer && oldContainer.innerHTML.trim() === '') {
