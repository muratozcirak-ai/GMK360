            if(invalidElements.length > 0) {
                alert("Lütfen tüm blok tanımlarını eksiksiz doldurun.");
                invalidElements[0].reportValidity();
                return;
            }

            var formData = new FormData(form);
            fetch('/ConstructionProject/SaveStep2', {
                method: 'POST',
