@model GMK360.Web.Models.CreateProjectWizardViewModel

@{
    ViewData["Title"] = "Yeni Proje Sihirbazı";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>





<style>
    .wizard-step { display: none; }
    .wizard-step.active { display: block; animation: fadeIn 0.5s; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .step-indicator {
        width: 40px; height: 40px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background-color: #e9ecef; color: #6c757d; font-weight: bold;
        transition: all 0.3s ease;
    }
    .step-indicator.active { background-color: #f97316; color: white; box-shadow: 0 0 15px rgba(249, 115, 22, 0.4); }
    .step-indicator.completed { background-color: #198754; color: white; }
    .step-line { flex-grow: 1; height: 3px; background-color: #e9ecef; margin: 0 15px; transition: all 0.3s ease; }
    .step-line.active { background-color: #198754; }
</style>

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card shadow-sm border-0 rounded-4">
            
            <!-- Wizard Header -->
            <div class="card-header bg-white border-bottom-0 pt-5 pb-4 px-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator active" id="ind-1">1</div>
                        <span class="small mt-2 fw-bold text-dark">Proje Künyesi</span>
                    </div>
                    <div class="step-line" id="line-1"></div>
                    
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator" id="ind-2">2</div>
                        <span class="small mt-2 text-muted">Blok ve Dağılım</span>
                    </div>
                    <div class="step-line" id="line-1b"></div>
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator" id="ind-3">3</div>
                        <span class="small mt-2 text-muted">Kat Malikleri</span>
                    </div>
                    <div class="step-line" id="line-2"></div>
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator" id="ind-4"><i class="ph ph-check"></i></div>
                        <span class="small mt-2 text-muted">Özet & Onay</span>
                    </div>
                </div>
            </div>

            <div class="card-body p-5 pt-0">
                <form id="wizardForm" action="/ConstructionProject/CreateWizard" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DraftProjectId" id="DraftProjectId" />
                    
                    <!-- STEP 1: Basic Info -->
                    <div class="wizard-step active" id="step1">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-buildings text-orange me-2"></i> İlk Projenizi Oluşturun</h4>
                        <div class="row g-4">
                                                        <div class="col-md-12 mb-2">
                                <label class="form-label fw-bold">Proje Durumu / Tipi</label>
                                <select asp-for="StatusId" style="pointer-events: none; background-color: #e9ecef;" tabindex="-1" readonly class="form-select form-select-lg rounded-3 border-primary" onchange="handleStatusChange()">
                                    <option value="2">Devam Eden Proje (Aktif Şantiye)</option>
                                    <option value="0">Aday Proje / Fizibilite (Kentsel Dönüşüm)</option>
                                    
                                    <option value="3">Tamamlanmış Proje (Referans / Portföy, Bina Yönetimi)</option>
                                </select>
                                <div class="form-text text-muted" id="statusHelpText">Aktif olarak inşaatı süren, puantaj ve maliyet takibi yapacağınız projedir.</div>
                            </div>
                                                          <div class="col-md-12">
                                  <label class="form-label fw-bold">Ana Yapı Türü (Proje Tipi)</label>
                                  <select asp-for="ProjectType" style="pointer-events: none; background-color: #e9ecef;" tabindex="-1" readonly class="form-select form-select-lg rounded-3 border-primary" required>
                                      <option value="">Lütfen Projenin Türünü Seçiniz...</option>
                                      <option value="Apartman">Apartman</option>
                                      <option value="Site / Karma Proje">Site / Karma Proje</option>
                                      <option value="Müstakil / Villa">Müstakil / Villa</option>
                                      <option value="İş Merkezi / Ofis">İş Merkezi / Ofis</option>
                                      <option value="AVM / Ticari">AVM / Ticari Proje</option>
                                      <option value="Sanayi / Fabrika">Sanayi / Fabrika Tesisi</option>
                                      <option value="Altyapı / Taahhüt">Altyapı / Taahhüt İşi</option>
                                  </select>
                              </div>
                              <div class="col-md-12">
                                  <label class="form-label fw-bold">Proje Adı</label>
                                <input asp-for="Name" readonly class="form-control form-control-lg rounded-3" style="pointer-events: none; background-color: #e9ecef;" tabindex="-1" placeholder="Örn: Vadi Konakları" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Kısa Açıklama / Proje Vizyonu</label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="2" placeholder="Projenin konseptini buraya yazabilirsiniz..."></textarea>
                            </div>
                            <hr/>
                            
                            
                            
                            
                            
                            
                            <div class="col-md-3">
                                <label class="form-label fw-bold">İl</label>
                                <select asp-for="CityId" class="form-select rounded-3" asp-items="ViewBag.Cities" required><option value="">Seçiniz</option></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">İlçe</label>
                                <select asp-for="DistrictId" class="form-select rounded-3" asp-items="ViewBag.Districts"><option value="">İlçe Seçin</option></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Mahalle</label>
                                <select asp-for="NeighborhoodId" class="form-select rounded-3" asp-items="ViewBag.Neighborhoods"><option value="">Seçiniz</option></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Sokak</label>
                                <select asp-for="StreetId" class="form-select rounded-3" asp-items="ViewBag.Streets"><option value="">Seçiniz</option></select>
                            </div>
<div class="col-md-2">
                                <label class="form-label fw-bold">Bina / Kapı No</label>
                                <input asp-for="Address" id="fullAddress" class="form-control rounded-3" placeholder="Örn: 16/A" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Ada</label>
                                    <input asp-for="Ada" class="form-control rounded-3" placeholder="Örn: 145" />
                                </div>
                                                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Parsel</label>
                                    <input asp-for="Parsel" class="form-control rounded-3" placeholder="Örn: 12" />
                                </div>
                                <div class="col-md-12 mt-2">
                                    <div class="form-check form-switch border p-3 rounded-3 bg-light">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsNewDesignForExisting" id="IsNewDesignForExisting">
                                        <label class="form-check-label fw-bold text-primary" for="IsNewDesignForExisting">
                                            Mevcut Arsaya Alternatif Tasarım (Aynı Ada/Parsele birden fazla teklif çizimi eklemek için işaretleyin)
                                        </label>
                                    </div>
                                </div>
                            <div class="col-md-10">
                                <label class="form-label fw-bold">Harita Konumu</label>
                                <div class="input-group">
                                    <input type="text" name="Latitude" id="latInput" class="form-control bg-light" placeholder="Enlem" value="@Model.Latitude" readonly />
                                    <input type="text" name="Longitude" id="lngInput" class="form-control bg-light" placeholder="Boylam" value="@Model.Longitude" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="openMapModal()"><i class="ph ph-map-pin"></i> Haritadan Seç</button>
                                      @if (!string.IsNullOrEmpty(Model.Latitude) && !string.IsNullOrEmpty(Model.Longitude))
                                      {
                                          <a href="https://maps.google.com/?q=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-outline-primary"><i class="ph ph-map-trifold"></i> Haritada Göster</a>
                                      }
                                </div>
                            </div>
                            <div id="projectDatesContainer" class="row g-3 m-0 p-0 w-100">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Planlanan Başlangıç Tarihi</label>
                                    <input name="StartDate" id="StartDate" type="date" value="@(Model.StartDate.Year > 1 ? Model.StartDate.ToString("yyyy-MM-dd") : "")" class="form-control rounded-3" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Hedeflenen Teslim</label>
                                    <input name="EndDate" id="EndDate" type="date" value="@(Model.EndDate.Year > 1 ? Model.EndDate.ToString("yyyy-MM-dd") : "")" class="form-control rounded-3" />
                                </div>
                            </div>
                            
<div class="col-md-12">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                            <label class="form-label fw-bold">Toplam Arazi Alanı (m²)</label>
                                            <div class="input-group">
                                                <input type="number" asp-for="TotalLandArea" class="form-control rounded-start-3" placeholder="Örn: 2500" min="1" required />
                                                <span class="input-group-text rounded-end-3">m²</span>
                                            </div>
                                        </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Mevcut Durum Görseli (İlk Hali)</label>
                                        <div class="input-group">
                                              <input asp-for="CurrentStateImageFile" type="file" class="form-control bg-light" accept="image/jpeg,image/png,application/pdf" />
                                              @if (!string.IsNullOrEmpty((string)ViewBag.CurrentStateImageUrl))
                                              {
                                                  <a href="@ViewBag.CurrentStateImageUrl" target="_blank" class="btn btn-outline-primary"><i class="ph ph-image"></i> Kayıtlı Görsel</a>
                                              }
                                          </div>
                                          <div class="form-text text-muted">Şantiyenin/arazinin şu anki hali (JPG/PNG).</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Proje Görseli (Geleceği Hali)</label>
                                        <div class="input-group">
                                              <input asp-for="CoverImageFile" type="file" class="form-control bg-light" accept="image/jpeg,image/png,application/pdf" />
                                              @if (!string.IsNullOrEmpty((string)ViewBag.CoverImageUrl))
                                              {
                                                  <a href="@ViewBag.CoverImageUrl" target="_blank" class="btn btn-outline-primary"><i class="ph ph-image"></i> Kayıtlı Görsel</a>
                                              }
                                          </div>
                                          <div class="form-text text-muted">Mimari 3D render görselini seçin (JPG/PNG).</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tapu Belgesi</label>
                                    <input type="file" name="TapuDocumentFile" class="form-control rounded-3 border-primary" accept="image/*,.pdf" @(string.IsNullOrEmpty((string)ViewBag.TapuDocumentUrl) ? "required" : "") />
                                    @if (!string.IsNullOrEmpty((string)ViewBag.TapuDocumentUrl))
                                    {
                                        <div class="mt-2"><a href="@ViewBag.TapuDocumentUrl" target="_blank" class="btn btn-sm btn-outline-success"><i class="bi bi-check-circle"></i> Yüklü Belgeyi Gör</a> <small class="text-muted">(Değiştirmek isterseniz yeni dosya seçin)</small></div>
                                    }
                                    else
                                    {
                                        <div class="form-text text-primary"><i class="bi bi-shield-check"></i> Tapu belgesi (PDF/Görsel) zorunludur.</div>
                                    }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end mt-5">
                            <button id="btnStep1Next" type="button" class="btn btn-orange btn-lg rounded-pill px-5 fw-bold" onclick="saveStep1AndContinue()">Blok Tanımları <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>

                    <!-- STEP 2: Blocks -->

                    <div class="wizard-step" id="step2">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-squares-four text-orange me-2"></i> Blok ve Aşama Dağılımı</h4>
                        <p class="text-muted mb-4">Temel kazısı, kaba inşaat gibi aşamaları blok bazlı takip edebilmeniz için projenizdeki blokları tanımlayın.</p>
                        
                        <div class="row mb-4 align-items-end bg-light p-4 rounded-4">
                            <div class="col-md-12">
                                  <label class="form-label fw-bold">Projenizde Kaç Blok (Bina) Var?</label>
                                  <input type="number" id="blockCount" class="form-control form-control-lg rounded-3" min="1" max="20" value="@(Model.Blocks != null && Model.Blocks.Any() ? Model.Blocks.Count : 1)" oninput="generateBlocks()" />
                              </div>
                            
                        </div>

                        <div id="blocksContainer">
                            @if (Model.Blocks != null && Model.Blocks.Any())
                            {
                                int i = 0;
                                foreach (var b in Model.Blocks)
                                {
                                    <div class="card border border-2 border-light shadow-sm rounded-4 mb-3 block-item">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold text-navy border-bottom pb-2 mb-3"><i class="ph ph-building me-2 text-orange"></i> @(i+1). Blok / Yapı Tanımı</h5>
                                            <div class="row g-3">
                                                <div class="col-md-12 col-lg-3">
                                                    <label class="form-label small fw-bold">Blok / Yapı Adı</label>
                                                    <input type="text" name="Blocks[@i].BlockName" class="form-control b-name" value="@b.BlockName" onkeyup="updatePodiumDropdowns(); updateAttachedDropdowns();" required  />
                                                    <input type="hidden" name="Blocks[@i].StructureType" value="independent" />
                                                    <input type="hidden" name="Blocks[@i].ParentIndex" value="" />
                                                </div>
                                                <div class="col-12 col-lg-2">
                                                    <label class="form-label small fw-bold">Taban (m²)</label>
                                                    <input type="number" name="Blocks[@i].BaseArea" class="form-control" value="@b.BaseArea" min="1" required />
                                                </div>
                                                <div class="col-6 col-lg-2">
                                                    <label class="form-label small fw-bold">Normal Kat Sayısı</label>
                                                    <input type="number" name="Blocks[@i].TotalFloors" class="form-control b-floors" value="@b.TotalFloors" min="0" required />
                                                </div>
                                                <div class="col-6 col-lg-1">
                                                    <label class="form-label small fw-bold">Daire</label>
                                                    <input type="number" name="Blocks[@i].TotalApartments" class="form-control" value="@b.TotalApartments" min="0" required />
                                                </div>
                                                <div class="col-6 col-lg-1">
                                                    <label class="form-label small fw-bold">Dükkan</label>
                                                    <input type="number" name="Blocks[@i].TotalShops" class="form-control" value="@b.TotalShops" min="0" required />
                                                </div>
                                                <div class="col-6 col-lg-2">
                                                    <label class="form-label small fw-bold">Bodrum Kat Sayısı</label>
                                                    <input type="number" name="Blocks[@i].BasementFloors" class="form-control b-basements" value="@b.BasementFloors" min="0" required />
                                                    <div class="form-check mt-2">
                                                        <input class="form-check-input" type="checkbox" name="Blocks[@i].HasGroundFloor" value="true" id="ground_@i" @(b.HasGroundFloor ? "checked" : "")>
                                                        <label class="form-check-label small fw-bold" for="ground_@i">Zemin Kat Var</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="Blocks[@i].HasRoof" value="true" id="roof_@i" @(b.HasRoof ? "checked" : "")>
                                                        <label class="form-check-label small fw-bold" for="roof_@i">Çatı Katı Var</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    i++;
                                }
                            }
                          </div>

                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-outline-secondary btn-lg rounded-pill px-4" onclick="nextStep(1)"><i class="ph ph-arrow-left me-2"></i> Geri</button>
                            <button type="button" class="btn btn-orange btn-lg rounded-pill px-5 fw-bold" onclick="saveBlocksAndContinue()">Kat Malikleri <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>

                    <!-- STEP 3: Kat Malikleri -->

                    <div class="wizard-step" id="step3">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-users text-orange me-2"></i> Kat Malikleri (Opsiyonel)</h4>
                        <p class="text-muted mb-4">Arsa veya eski bina sahiplerini sisteme şimdiden ekleyebilirsiniz. Girdiğiniz her isim arka planda otomatik olarak Rehberinize 'Kat Maliki' olarak kaydedilecektir. Bu adımı sonradan da tamamlayabilirsiniz.</p>

<div class="col-12 mt-3" id="eskiBinaContainer" style="display: none;">
                                
                            </div>

                          <div class="bg-light p-4 rounded-4 mb-4">
                            <div id="ownersList">
                                @if (Model.Owners != null && Model.Owners.Any())
                                {
                                    int oIdx = 0;
                                    foreach (var o in Model.Owners)
                                    {
                                        <div class="row g-2 align-items-end mb-2 pb-2 border-bottom owner-item">
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1">Ad Soyad</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" name="Owners[@oIdx].FirstName" class="form-control" value="@o.FirstName" placeholder="Ad" required />
                                                    <input type="text" name="Owners[@oIdx].LastName" class="form-control" value="@o.LastName" placeholder="Soyad" required />
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1">İletişim</label>
                                                <input type="tel" name="Owners[@oIdx].PhoneNumber" class="form-control form-control-sm" value="@o.PhoneNumber" placeholder="Telefon" />
                                                <input type="hidden" name="Owners[@oIdx].Email" value="@o.Email" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1">Blok Seçimi</label>
                                                <select name="Owners[@oIdx].BlockName" class="form-select form-select-sm">
                                                    <option value="">Tümü / Belirsiz</option>
                                                    @if(Model.Blocks != null)
                                                    {
                                                        foreach(var mb in Model.Blocks)
                                                        {
                                                            if(mb.BlockName == o.BlockName)
                                                            {
                                                                <option value="@mb.BlockName" selected>@mb.BlockName</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@mb.BlockName">@mb.BlockName</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1">Ünite Tipi</label>
                                                <select name="Owners[@oIdx].UnitType" class="form-select form-select-sm">
                                                    <option value="">Tümü</option>
                                                    @{
                                                        var utypes = new string[] { "Daire", "Dükkan", "Dubleks", "Ofis" };
                                                        foreach(var ut in utypes)
                                                        {
                                                            if(ut == o.UnitType)
                                                            {
                                                                <option value="@ut" selected>@ut</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@ut">@ut</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1 text-primary">Adet / Miktar</label>
                                                <input type="text" name="Owners[@oIdx].FlatNumber" class="form-control form-control-sm border-primary" value="@o.FlatNumber" placeholder="Örn: 4 Adet veya %50" />
                                            </div>
                                            <div class="col-md-1 text-center pb-1">
                                                <div class="form-check form-switch d-inline-block" title="Temsilci / Takipçi mi?">
                                                    <input class="form-check-input" type="checkbox" name="Owners[@oIdx].IsRepresentative" value="true" id="repSwitch_@oIdx" @(o.IsRepresentative ? "checked" : "")>
                                                    <label class="form-check-label" style="font-size:0.7rem;" for="repSwitch_@oIdx">Temsilci</label>
                                                </div>
                                            </div>
                                            <div class="col-md-1 d-flex gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-success w-100 save-row-btn" onclick="saveSingleOwner(this)" title="Anında Kaydet"><i class="bi bi-check-lg"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="this.closest('.owner-item').remove()" title="Sil"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                        oIdx++;
                                    }
                                }
                            </div>
                            <button type="button" class="btn btn-outline-primary rounded-pill mt-3 fw-bold" onclick="addOwnerRow()">
                                <i class="bi bi-person-plus me-1"></i> Yeni Kat Maliki Ekle
                            </button>
                        </div>
                        
                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-light btn-lg rounded-pill px-4" onclick="nextStep(2)"><i class="ph ph-arrow-left me-2"></i> Geri</button>
                            <button type="button" class="btn btn-orange btn-lg rounded-pill px-5 fw-bold" onclick="saveStep3AndContinue()">Özet ve Onay <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>
                    
                    <!-- STEP 4: Summary -->

                    <div class="wizard-step" id="step4">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-check-circle text-success me-2"></i> Proje Özeti ve Onay</h4>
                        
                        <div class="bg-light p-4 rounded-4 mb-4">
                            <h5 class="fw-bold text-orange" id="summaryName"></h5>
                            <p class="text-muted mb-3" id="summaryDesc"></p>
                            
                            <div class="row text-center mb-4">
                                <div class="col-4 border-end">
                                    <h3 class="fw-bold text-navy" id="summaryBlockCount">0</h3>
                                    <span class="small text-muted text-uppercase">Toplam Blok</span>
                                </div>
                                <div class="col-4 border-end">
                                    <h3 class="fw-bold text-navy" id="summaryTotalApts">0</h3>
                                    <span class="small text-muted text-uppercase">Toplam Daire</span>
                                </div>
                                <div class="col-4">
                                    <h3 class="fw-bold text-navy" id="summaryTotalShops">0</h3>
                                    <span class="small text-muted text-uppercase">Toplam Dükkan</span>
                                </div>
                            </div>
                            
                            <div class="alert alert-success d-flex align-items-center mb-0">
                                <i class="ph ph-info me-3 fs-4"></i>
                                <div>
