    function toggleParent(sel) {
              var val = $(sel).val();
              var parentSel = $(sel).siblings('.b-parent');
              if(val === 'tower') {
                  parentSel.show();
                  parentSel.attr('required', true);
              } else {
                  parentSel.hide();
                  parentSel.removeAttr('required');
                  parentSel.val('');
              }
              updatePodiumDropdowns();
          }

          function updatePodiumDropdowns() {
              var podiums = [];
              $('.block-item').each(function(index) {
                  var type = $(this).find('.b-type').val();
                  var name = $(this).find('.b-name').val();
                  if(type === 'podium' && name.trim() !== '') {
                      podiums.push({ idx: index, name: name });
                  }
              });
              
              $('.b-parent').each(function() {
                  var currentVal = $(this).val();
                  $(this).empty();
                  $(this).append('<option value="">Hangi Bazaya Bağlı?</option>');
                  var sel = $(this);
                  podiums.forEach(function(p) {
                      sel.append('<option value="' + p.idx + '">' + p.name + '</option>');
                  });
                  $(this).val(currentVal); 
              });
          }




          function prepareSummary() {
            const name = document.querySelector('input[name="Name"]').value;
            
            document.getElementById('summaryNameOld').innerText = name + " (Mevcut)";
            document.getElementById('summaryNameNew').innerText = name + " (Hedef)";

            let oldApts = 0, oldShops = 0;
            const oldBlocks = document.querySelectorAll('.block-item-old');
            oldBlocks.forEach(b => {
                oldApts += (parseInt(b.querySelector('input[name*="TotalApartments"]').value) || 0);
                oldShops += (parseInt(b.querySelector('input[name*="TotalShops"]').value) || 0);
            });
            document.getElementById('summaryBlockCountOld').innerText = oldBlocks.length;
            document.getElementById('summaryTotalAptsOld').innerText = oldApts;
            document.getElementById('summaryTotalShopsOld').innerText = oldShops;

            let newApts = 0, newShops = 0;
            const newBlocks = document.querySelectorAll('.block-item-new');
            newBlocks.forEach(b => {
                newApts += (parseInt(b.querySelector('input[name*="TotalApartments"]').value) || 0);
                newShops += (parseInt(b.querySelector('input[name*="TotalShops"]').value) || 0);
            });
            document.getElementById('summaryBlockCountNew').innerText = newBlocks.length;
            document.getElementById('summaryTotalAptsNew').innerText = newApts;
            document.getElementById('summaryTotalShopsNew').innerText = newShops;
            
            document.getElementById('firmStockApts').innerText = Math.max(0, newApts - oldApts);
            document.getElementById('firmStockShops').innerText = Math.max(0, newShops - oldShops);
        }
        
    


