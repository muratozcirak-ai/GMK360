@model GMK360.Web.Models.CreateProjectWizardViewModel

@{
    ViewData["Title"] = "Yeni Proje Sihirbazı";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>





<style>
    .wizard-step { display: none; }
    .wizard-step.active { display: block; animation: fadeIn 0.5s; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .step-indicator {
        width: 40px; height: 40px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background-color: #e9ecef; color: #6c757d; font-weight: bold;
        transition: all 0.3s ease;
    }
    .step-indicator.active { background-color: #f97316; color: white; box-shadow: 0 0 15px rgba(249, 115, 22, 0.4); }
    .step-indicator.completed { background-color: #198754; color: white; }
    .step-line { flex-grow: 1; height: 3px; background-color: #e9ecef; margin: 0 15px; transition: all 0.3s ease; }
    .step-line.active { background-color: #198754; }
</style>

@try {<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card shadow-sm border-0 rounded-4">
            
            <!-- Wizard Header -->
            <div class="card-header bg-white border-bottom-0 pt-5 pb-4 px-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator active" id="ind-1">1</div>
                        <span class="small mt-2 fw-bold text-dark">Proje Künyesi</span>
                    </div>
                    <div class="step-line" id="line-1"></div>
                    
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator" id="ind-2">2</div>
                        <span class="small mt-2 text-muted">Blok ve Dağılım</span>
                    </div>
                    <div class="step-line" id="line-2"></div>
                    
                    <div class="step-wrapper text-center d-flex flex-column align-items-center">
                        <div class="step-indicator" id="ind-3"><i class="ph ph-check"></i></div>
                        <span class="small mt-2 text-muted">Özet & Onay</span>
                    </div>
                </div>
            </div>

            <div class="card-body p-5 pt-0">
                <form id="wizardForm" action="/ConstructionProject/CreateWizard" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DraftProjectId" id="DraftProjectId" />
                    
                    <!-- STEP 1: Basic Info -->
                    <div class="wizard-step active" id="step1">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-buildings text-orange me-2"></i> İlk Projenizi Oluşturun</h4>
                        <div class="row g-4">
                                                        <div class="col-md-12 mb-2">
                                <label class="form-label fw-bold">Proje Durumu / Tipi</label>
                                @{
                                    string statusText = Model.StatusId switch {
                                        0 => "Ön Görüşme / Fizibilite",
                                        1 => "Aday Proje (Teklif)",
                                        2 => "Aktif Şantiye (Devam Eden)",
                                        3 => "Tamamlandı / Teslim",
                                        4 => "Satışta (Topraktan)",
                                        5 => "Anlaşma Yapıldı",
                                        6 => "İptal / Anlaşma Olmadı",
                                        _ => "Belirsiz"
                                    };
                                }
                                <div class="form-control form-control-lg rounded-3 border-primary" style="background-color: #e9ecef;">
                                    <i class="ph ph-info me-2 text-primary"></i> <strong>@statusText</strong>
                                </div>
                                <input type="hidden" asp-for="StatusId" />
                                <div class="form-text text-muted">Projenizin mevcut statüsü. Statü değişikliklerini projenin ana panelinden yapabilirsiniz.</div>
                            </div>
                                                          <div class="col-md-12">
                                  <label class="form-label fw-bold">Ana Yapı Türü (Proje Tipi)</label>
                                  <select asp-for="ProjectType" style="pointer-events: none; background-color: #e9ecef;" tabindex="-1" readonly class="form-select form-select-lg rounded-3 border-primary" required>
                                      <option value="">Lütfen Projenin Türünü Seçiniz...</option>
                                      <option value="Apartman">Apartman</option>
                                      <option value="Site / Karma Proje">Site / Karma Proje</option>
                                      <option value="Müstakil / Villa">Müstakil / Villa</option>
                                      <option value="İş Merkezi / Ofis">İş Merkezi / Ofis</option>
                                      <option value="AVM / Ticari">AVM / Ticari Proje</option>
                                      <option value="Sanayi / Fabrika">Sanayi / Fabrika Tesisi</option>
                                      <option value="Altyapı / Taahhüt">Altyapı / Taahhüt İşi</option>
                                  </select>
                              </div>
                              <div class="col-md-12">
                                  <label class="form-label fw-bold">Proje Adı</label>
                                <input asp-for="Name" readonly class="form-control form-control-lg rounded-3" style="pointer-events: none; background-color: #e9ecef;" tabindex="-1" placeholder="Örn: Vadi Konakları" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Kısa Açıklama / Proje Vizyonu</label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="2" placeholder="Projenin konseptini buraya yazabilirsiniz..."></textarea>
                            </div>
                            <hr/>
                            
                            
                            
                            
                            
                            
                            <div class="col-md-3">
                                <label class="form-label fw-bold">İl</label>
                                <select asp-for="CityId" class="form-select rounded-3" asp-items="ViewBag.Cities" required><option value="">Seçiniz</option></select>
                            </div>
                            @try {
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">İlçe</label>
                                    <select asp-for="DistrictId" class="form-select rounded-3" asp-items="ViewBag.Districts"><option value="">İlçe Seçin</option></select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Mahalle</label>
                                    <select asp-for="NeighborhoodId" class="form-select rounded-3" asp-items="ViewBag.Neighborhoods"><option value="">Seçiniz</option></select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Sokak</label>
                                    <select asp-for="StreetId" class="form-select rounded-3" asp-items="ViewBag.Streets"><option value="">Seçiniz</option></select>
                                </div>
                            } catch (Exception ex) {
                                <div class="col-md-9 text-danger fw-bold">
                                    HATA OLUŞTU: @ex.Message <br/> @ex.StackTrace
                                </div>
                            }
<div class="col-md-2">
                                <label class="form-label fw-bold">Bina / Kapı No</label>
                                <input asp-for="Address" id="fullAddress" class="form-control rounded-3" placeholder="Örn: 16/A" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Ada</label>
                                    <input asp-for="Ada" class="form-control rounded-3" placeholder="Örn: 145" />
                                </div>
                                                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Parsel</label>
                                    <input asp-for="Parsel" class="form-control rounded-3" placeholder="Örn: 12" />
                                </div>
                            <div class="col-md-10 mt-3">
                                <label class="form-label fw-bold">Harita Konumu</label>
                                <div class="input-group">
                                    <input type="text" name="Latitude" id="latInput" class="form-control bg-light" placeholder="Enlem" value="@Model.Latitude" readonly />
                                    <input type="text" name="Longitude" id="lngInput" class="form-control bg-light" placeholder="Boylam" value="@Model.Longitude" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="openMapModal()"><i class="ph ph-map-pin"></i> Haritadan Seç</button>
                                      @if (!string.IsNullOrEmpty(Model.Latitude) && !string.IsNullOrEmpty(Model.Longitude))
                                      {
                                          <a href="https://maps.google.com/?q=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-outline-primary"><i class="ph ph-map-trifold"></i> Haritada Göster</a>
                                      }
                                </div>
                            </div>
                            <div id="projectDatesContainer" class="row g-3 m-0 p-0 w-100">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Planlanan Başlangıç Tarihi</label>
                                    <input name="StartDate" id="StartDate" type="date" value="@(Model.StartDate.Year > 1 ? Model.StartDate.ToString("yyyy-MM-dd") : "")" class="form-control rounded-3" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Hedeflenen Teslim</label>
                                    <input name="EndDate" id="EndDate" type="date" value="@(Model.EndDate.Year > 1 ? Model.EndDate.ToString("yyyy-MM-dd") : "")" class="form-control rounded-3" />
                                </div>
                            </div>
                            
<div class="col-md-12">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                            <label class="form-label fw-bold">Toplam Arazi Alanı (m²)</label>
                                            <div class="input-group">
                                                <input type="number" asp-for="TotalLandArea" class="form-control rounded-start-3" placeholder="Örn: 199800" min="1" required />
                                                <span class="input-group-text rounded-end-3">m²</span>
                                            </div>
                                        </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Mevcut Durum Görseli (İlk Hali)</label>
                                        <div class="input-group">
                                              <input asp-for="CurrentStateImageFile" type="file" class="form-control bg-light" accept="image/jpeg,image/png,application/pdf" />
                                              @try {
                                                  @if (!string.IsNullOrEmpty((string)ViewBag.CurrentStateImageUrl))
                                                  {
                                                      <a href="@ViewBag.CurrentStateImageUrl" target="_blank" class="btn btn-outline-primary"><i class="ph ph-image"></i> Kayıtlı Görsel</a>
                                                  }
                                              } catch (Exception ex) {
                                                  <span>Hata: @ex.Message</span>
                                              }
                                          </div>
                                          <div class="form-text text-muted">Şantiyenin/arazinin şu anki hali (JPG/PNG).</div>
                                      </div>
                                      <div class="col-md-6">
                                        <label class="form-label fw-bold">Proje Görseli (Geleceği Hali)</label>
                                        <div class="input-group">
                                              <input asp-for="CoverImageFile" type="file" class="form-control bg-light" accept="image/jpeg,image/png,application/pdf" />
                                              @try {
                                                  @if (!string.IsNullOrEmpty((string)ViewBag.CoverImageUrl))
                                                  {
                                                      <a href="@ViewBag.CoverImageUrl" target="_blank" class="btn btn-outline-primary"><i class="ph ph-image"></i> Kayıtlı Görsel</a>
                                                  }
                                              } catch (Exception ex) {
                                                  <span>Hata: @ex.Message</span>
                                              }
                                          </div>
                                          <div class="form-text text-muted">Mimari 3D render görselini seçin (JPG/PNG).</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tapu Belgesi</label>
                                    <input type="file" name="TapuDocumentFile" class="form-control rounded-3 border-primary" accept="image/*,.pdf" @(string.IsNullOrEmpty((string)ViewBag.TapuDocumentUrl) ? "required" : "") />
                                    @if (!string.IsNullOrEmpty((string)ViewBag.TapuDocumentUrl))
                                    {
                                        <div class="mt-2"><a href="@ViewBag.TapuDocumentUrl" target="_blank" class="btn btn-sm btn-outline-success"><i class="bi bi-check-circle"></i> Yüklü Belgeyi Gör</a> <small class="text-muted">(Değiştirmek isterseniz yeni dosya seçin)</small></div>
                                    }
                                    else
                                    {
                                        <div class="form-text text-primary"><i class="bi bi-shield-check"></i> Tapu belgesi (PDF/Görsel) zorunludur.</div>
                                    }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end mt-5">
                            <button id="btnStep1Next" type="button" class="btn btn-orange btn-lg rounded-pill px-5 fw-bold" onclick="saveStep1AndContinue()">Blok Tanımları <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>

                    <!-- STEP 2: Blocks -->
                    <div class="wizard-step" id="step2">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-squares-four text-orange me-2"></i> Blok ve Aşama Dağılımı</h4>
                        <p class="text-muted mb-4">Temel kazısı, kaba inşaat gibi aşamaları blok bazlı takip edebilmeniz için projenizdeki blokları tanımlayın.</p>
                        
                        <!-- ESKİ BİNA BÖLÜMÜ -->
                        <div id="kentselDonusumOldBlocks" class="mb-5 border-bottom border-2 border-danger border-opacity-25 pb-4">
                            <h5 class="fw-bold text-danger mb-3"><i class="ph ph-buildings me-2"></i> ESKİ (MEVCUT) BİNALAR</h5>
                            <div class="row mb-4 align-items-end bg-danger bg-opacity-10 p-4 rounded-4">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold text-danger">Yıkılacak Mevcut Blok (Bina) Sayısı</label>
                                    <input type="number" id="oldBlockCount" class="form-control form-control-lg rounded-3 border-danger border-opacity-50" min="0" max="20" value="@(Model.ExistingBlocks != null && Model.ExistingBlocks.Any() ? Model.ExistingBlocks.Count : 1)" oninput="generateOldBlocks()" />
                                </div>
                            </div>
                            <div id="oldBlocksContainer">
                                @if (Model.ExistingBlocks != null && Model.ExistingBlocks.Any())
                                {
                                    int i = 0;
                                    foreach (var b in Model.ExistingBlocks)
                                    {
                                        <div class="card border border-2 border-danger border-opacity-25 shadow-sm rounded-4 mb-3 block-item-old">
                                            <div class="card-body p-4">
                                                <h5 class="fw-bold text-danger border-bottom pb-2 mb-3"><i class="ph ph-building me-2"></i> @(i+1). Eski Blok / Yapı</h5>
                                                <div class="row g-3">
                                                    <div class="col-md-12 col-lg-3">
                                                        <label class="form-label small fw-bold">Eski Blok Adı</label>
                                                        <input type="text" name="ExistingBlocks[@i].BlockName" class="form-control" value="@b.BlockName" required />
                                                    </div>
                                                    <div class="col-12 col-lg-2">
                                                        <label class="form-label small fw-bold">Taban (m²)</label>
                                                        <input type="number" name="ExistingBlocks[@i].BaseArea" class="form-control" placeholder="Örn: 200" min="1" value="@b.BaseArea" required />
                                                    </div>
                                                    <div class="col-6 col-lg-2">
                                                        <label class="form-label small fw-bold">Kat Sayısı</label>
                                                        <input type="number" name="ExistingBlocks[@i].TotalFloors" class="form-control" min="1" value="@b.TotalFloors" required />
                                                    </div>
                                                      <div class="col-6 col-lg-2">
                                                          <label class="form-label small fw-bold">Yapım Yılı</label>
                                                          <input type="number" name="ExistingBlocks[@i].BuildingAge" class="form-control" value="@b.BuildingAge" placeholder="Örn: 1998" />
                                                      </div>
                                                    <div class="col-6 col-lg-2">
                                                        <label class="form-label small fw-bold">Daire</label>
                                                        <input type="number" name="ExistingBlocks[@i].TotalApartments" class="form-control" value="@b.TotalApartments" required />
                                                    </div>
                                                    <div class="col-6 col-lg-1">
                                                        <label class="form-label small fw-bold">Dükkan</label>
                                                        <input type="number" name="ExistingBlocks[@i].TotalShops" class="form-control" value="@b.TotalShops" required />
                                                    </div>
                                                    <div class="col-6 col-lg-2">
                                                        <label class="form-label small fw-bold">Bodrum Kat</label>
                                                        <input type="number" name="ExistingBlocks[@i].BasementFloors" class="form-control" value="@b.BasementFloors" required />
                                                    </div>
                                                    
                                                    <!-- Yeni Eklenenler -->
                                                    <div class="col-4 col-lg-2">
                                                        <label class="form-label small fw-bold">Zemin Kat</label>
                                                        <div class="form-check form-switch mt-1">
                                                            <input class="form-check-input" type="checkbox" name="ExistingBlocks[@i].HasGroundFloor" value="true" @(b.HasGroundFloor ? "checked" : "")>
                                                        </div>
                                                    </div>
                                                    <div class="col-4 col-lg-2">
                                                        <label class="form-label small fw-bold">Çatı Katı</label>
                                                        <div class="form-check form-switch mt-1">
                                                            <input class="form-check-input" type="checkbox" name="ExistingBlocks[@i].HasRoof" value="true" @(b.HasRoof ? "checked" : "")>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-lg-3">
                                                        <label class="form-label small fw-bold">Temel / Baza Durumu</label>
                                                        <select name="ExistingBlocks[@i].LayoutPattern" class="form-select form-select-sm mt-1">
                                                            <option value="" selected="@(string.IsNullOrEmpty(b.LayoutPattern))">Belirtilmedi</option>
                                                            <option value="Bağımsız Temel" selected="@(b.LayoutPattern == "Bağımsız Temel")">Bağımsız Temel</option>
                                                            <option value="Ortak Baza" selected="@(b.LayoutPattern == "Ortak Baza")">Ortak Baza (Podyum)</option>
                                                            <option value="Bitişik Nizam" selected="@(b.LayoutPattern == "Bitişik Nizam")">Bitişik Nizam</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        i++;
                                    }
                                }
                            </div>
                        </div>

                        <!-- YENİ BİNA BÖLÜMÜ -->
                        <div id="newBlocksSection" class="mb-4">
                            <h5 class="fw-bold text-primary mb-3"><i class="ph ph-crane me-2"></i> YENİ (YAPILACAK) BİNALAR</h5>
                            <div class="row mb-4 align-items-end bg-primary bg-opacity-10 p-4 rounded-4">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold text-primary">İnşa Edilecek Yeni Blok Sayısı</label>
                                    <input type="number" id="newBlockCount" class="form-control form-control-lg rounded-3 border-primary border-opacity-50" min="1" max="20" value="@(Model.TargetBlocks != null && Model.TargetBlocks.Any() ? Model.TargetBlocks.Count : 1)" oninput="generateNewBlocks()" />
                                </div>
                            </div>
                            <div id="newBlocksContainer">
                                @if (Model.TargetBlocks != null && Model.TargetBlocks.Any())
                                {
                                    int i = 0;
                                    foreach (var b in Model.TargetBlocks)
                                    {
                                        <div class="card border border-2 border-primary border-opacity-25 shadow-sm rounded-4 mb-3 block-item-new">
                                            <div class="card-body p-4">
                                                <h5 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="ph ph-building me-2"></i> @(i+1). Yeni Blok / Yapı</h5>
                                                <div class="row g-3">
                                                    <div class="col-md-12 col-lg-3">
                                                        <label class="form-label small fw-bold">Yeni Blok Adı</label>
                                                        <input type="text" name="TargetBlocks[@i].BlockName" class="form-control" value="@b.BlockName" required />
                                                    </div>
                                                    <div class="col-12 col-lg-2">
                                                        <label class="form-label small fw-bold">Taban (m²)</label>
                                                        <input type="number" name="TargetBlocks[@i].BaseArea" class="form-control" placeholder="Örn: 200" min="1" value="@b.BaseArea" required />
                                                    </div>
                                                    <div class="col-6 col-lg-2">
                                                        <label class="form-label small fw-bold">Kat Sayısı</label>
                                                        <input type="number" name="TargetBlocks[@i].TotalFloors" class="form-control" min="1" value="@b.TotalFloors" required />
                                                    </div>
                                                    <div class="col-6 col-lg-2">
                                                        <label class="form-label small fw-bold">Daire</label>
                                                        <input type="number" name="TargetBlocks[@i].TotalApartments" class="form-control" value="@b.TotalApartments" required />
                                                    </div>
                                                    <div class="col-6 col-lg-1">
                                                        <label class="form-label small fw-bold">Dükkan</label>
                                                        <input type="number" name="TargetBlocks[@i].TotalShops" class="form-control" value="@b.TotalShops" required />
                                                    </div>
                                                    <div class="col-6 col-lg-2">
                                                        <label class="form-label small fw-bold">Bodrum Kat</label>
                                                        <input type="number" name="TargetBlocks[@i].BasementFloors" class="form-control" value="@b.BasementFloors" required />
                                                    </div>
                                                    
                                                    <!-- Yeni Eklenenler -->
                                                    <div class="col-4 col-lg-2">
                                                        <label class="form-label small fw-bold">Zemin Kat</label>
                                                        <div class="form-check form-switch mt-1">
                                                            <input class="form-check-input" type="checkbox" name="TargetBlocks[@i].HasGroundFloor" value="true" @(b.HasGroundFloor ? "checked" : "")>
                                                        </div>
                                                    </div>
                                                    <div class="col-4 col-lg-2">
                                                        <label class="form-label small fw-bold">Çatı Katı</label>
                                                        <div class="form-check form-switch mt-1">
                                                            <input class="form-check-input" type="checkbox" name="TargetBlocks[@i].HasRoof" value="true" @(b.HasRoof ? "checked" : "")>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-lg-3">
                                                        <label class="form-label small fw-bold">Temel / Baza Durumu</label>
                                                        <select name="TargetBlocks[@i].LayoutPattern" class="form-select form-select-sm mt-1">
                                                            <option value="" selected="@(string.IsNullOrEmpty(b.LayoutPattern))">Belirtilmedi</option>
                                                            <option value="Bağımsız Temel" selected="@(b.LayoutPattern == "Bağımsız Temel")">Bağımsız Temel</option>
                                                            <option value="Ortak Baza" selected="@(b.LayoutPattern == "Ortak Baza")">Ortak Baza (Podyum)</option>
                                                            <option value="Bitişik Nizam" selected="@(b.LayoutPattern == "Bitişik Nizam")">Bitişik Nizam</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        i++;
                                    }
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-light btn-lg px-4 rounded-pill" onclick="prevStep(1)"><i class="ph ph-arrow-left me-2"></i> Geri</button>
                            <button type="button" class="btn btn-primary btn-lg px-4 rounded-pill" onclick="saveBlocksAndContinue()">Özet ve Onay <i class="ph ph-arrow-right ms-2"></i></button>
                        </div>
                    </div>
                    
                    <!-- STEP 3: Summary -->
                    <div class="wizard-step" id="step3">
                        <h4 class="fw-bold text-navy mb-4"><i class="ph ph-check-circle text-success me-2"></i> Proje Özeti ve Onay</h4>
                        
                        <div class="card bg-danger bg-opacity-10 border-0 rounded-4 mb-4" id="oldSummaryCard">
                            <div class="card-body p-4 text-center">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold text-danger mb-0" id="summaryNameOld">Eski Bina Özeti</h5>
                                </div>
                                <div class="row g-4">
                                    <div class="col-4 border-end border-danger border-opacity-25">
