<script>
window.onerror = function(message, source, lineno, colno, error) {
    alert("JAVASCRIPT HATASI:\n" + message + "\nSatır: " + lineno);
};
</script>

    <script>
        
        let map, marker;
        
        
        function submitWizard() {
            document.getElementById('wizardForm').submit();
        }

        function saveStep3AndContinue() {
            prepareSummary();
        }
        
        // ==========================================

        // DİKKAT: AŞAMA 2 KAYDETME KODLARIDIR. 
        // KUSURSUZ ÇALIŞMAKTADIR. HİÇBİR ZAMAN BU KODLARA DOKUNMA/SİLME/DEĞİŞTİRME!
        // ==========================================
        function saveBlocksAndContinue() {
            var form = document.getElementById('wizardForm');
            var step = document.getElementById('step2');
            

            var formData = new FormData(form);
            fetch('/ConstructionProject/SaveStep2', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    prepareSummary();
                    nextStep(3);
                } else {
                    alert('Kayıt Hatası: ' + (data.message || 'Bilinmeyen Hata'));
                }
            })
            .catch(err => {
                alert('Beklenmeyen bir sunucu hatası oluştu.');
            });
        }
        
        // ==========================================

        // DİKKAT: AŞAMA 1 HARİTA (MAP) KODLARIDIR. 
        // KUSURSUZ ÇALIŞMAKTADIR. HİÇBİR ZAMAN BU KODLARA DOKUNMA/DEĞİŞTİRME!
        // ==========================================
        function openMapModal() {
            var mapModal = new bootstrap.Modal(document.getElementById('mapModal'));
            mapModal.show();
            
            setTimeout(() => {
                if(!map) {
                    map = L.map('projectMap').setView([41.0082, 28.9784], 13);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors'
                    }).addTo(map);
                    
                    marker = L.marker([41.0082, 28.9784], {draggable: true}).addTo(map);
                    
                    map.on('click', function(e) {
                        marker.setLatLng(e.latlng);
                    });
                } else {
                    map.invalidateSize();
                }

                var cityName = $('#CityId option:selected').text();
                var distName = $('#DistrictId option:selected').text();
                var neighName = $('#NeighborhoodId option:selected').text();
                var streetName = $('#StreetId option:selected').text();
                
                if (cityName && cityName !== 'Seçiniz') {
                    var query = '';
                    if (neighName && neighName !== 'Seçiniz' && neighName !== 'Yükleniyor...') {
                        if (streetName && streetName !== 'Seçiniz' && streetName !== 'Yükleniyor...') {
                            query = `${streetName}, ${neighName}, ${distName}, ${cityName}, Turkey`;
                        } else {
                            query = `${neighName}, ${distName}, ${cityName}, Turkey`;
                        }
                    } else if (distName && distName !== 'Seçiniz') {
                        query = `${distName}, ${cityName}, Turkey`;
                    } else {
                        query = `${cityName}, Turkey`;
                    }

                    var query = '';
                    if (neighName && neighName !== 'Seçiniz' && neighName !== 'Yükleniyor...') {
                        if (streetName && streetName !== 'Seçiniz' && streetName !== 'Yükleniyor...') {
                            query = `${streetName}, ${neighName}, ${distName}, ${cityName}, Turkey`;
                        } else {
                            query = `${neighName}, ${distName}, ${cityName}, Turkey`;
                        }
                    } else if (distName && distName !== 'Seçiniz') {
                        query = `${distName}, ${cityName}, Turkey`;
                    } else {
                        query = `${cityName}, Turkey`;
                    }

                    var tryGeocode = function(searchQuery, zoomLvl) {
                        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(searchQuery)}&limit=1`)
                        .then(res => res.json())
                        .then(data => {
                            if(data && data.length > 0) {
                                var lat = parseFloat(data[0].lat);
                                var lon = parseFloat(data[0].lon);
                                map.setView([lat, lon], zoomLvl);
                                marker.setLatLng([lat, lon]);
                            } else {
                                // Bulamazsa bir üste geç
                                if (searchQuery.includes(streetName) && streetName) {
                                    tryGeocode(`${neighName}, ${distName}, ${cityName}, Turkey`, 15);
                                } else if (searchQuery.includes(neighName) && neighName) {
                                    tryGeocode(`${distName}, ${cityName}, Turkey`, 13);
                                }
                            }
                        });
                    };
                    
                    tryGeocode(query, 16);
                }
            }, 500);
        }

        function saveMapLocation() {
            if(marker) {
                var pos = marker.getLatLng();
                document.getElementById('latInput').value = pos.lat.toFixed(6);
                document.getElementById('lngInput').value = pos.lng.toFixed(6);
            }
            var mapModal = bootstrap.Modal.getInstance(document.getElementById('mapModal'));
            if(mapModal) mapModal.hide();
        }

        
        // ==========================================
        // DİKKAT: AŞAMA 1 KAYDETME KODLARIDIR. 
        // KUSURSUZ ÇALIŞMAKTADIR. HİÇBİR ZAMAN BU KODLARA DOKUNMA/DEĞİŞTİRME!
        // ==========================================
        function saveStep1AndContinue() {
            var form = document.getElementById('wizardForm');
            var step = document.getElementById('step1');
            

            // AJAX POST
            var formData = new FormData(form);
            fetch('/ConstructionProject/SaveStep1', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    // Persist draft id in the hidden field
                    document.getElementById('DraftProjectId').value = data.projectId;

                    // Update the URL so that a page refresh keeps the draft id
                    // This ensures the Create(id) GET loads the same draft on F5
                    try {
                        const newUrl = new URL(window.location.href);
                        newUrl.searchParams.set('id', data.projectId);
                        window.history.replaceState({}, document.title, newUrl.toString());
                    } catch (e) {
                        // fallback
                        window.location.hash = '#draft-' + data.projectId;
                    }

                    nextStep(2);
                } else {
                    alert('Kayıt sırasında bir hata oluştu: ' + (data.message || 'Bilinmeyen hata'));
                }
            })
            .catch(err => {
                console.error(err);
                alert('Bağlantı hatası.');
            });
        }

        function prevStep(step) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');
            
            if(step == 1) {
                document.getElementById('ind2').classList.remove('active');
                document.getElementById('ind3').classList.remove('active');
            } else if(step == 2) {
                document.getElementById('ind3').classList.remove('active');
            }
        }

        
        document.addEventListener('DOMContentLoaded', function() {
            var selects = document.querySelectorAll('select[name$=".LayoutPattern"]');
            selects.forEach(function(s) {
                handleLayoutPatternChange(s, true);
            });
        });

        function nextStep(step) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');
            
            // Update Indicators
            if(step == 1) {
                document.getElementById('ind-1').className = "step-indicator active";
                document.getElementById('ind-2').className = "step-indicator";
                document.getElementById('ind-3').className = "step-indicator";
                document.getElementById('line-1').className = "step-line";
                document.getElementById('line-2').className = "step-line";
            }
            if(step == 2) {
                document.getElementById('ind-1').className = "step-indicator completed";
                document.getElementById('ind-2').className = "step-indicator active";
                document.getElementById('ind-3').className = "step-indicator";
                document.getElementById('line-1').className = "step-line active";
                document.getElementById('line-2').className = "step-line";
                
                var oldContainer = document.getElementById('oldBlocksContainer');
                var newContainer = document.getElementById('newBlocksContainer');
                if(oldContainer && oldContainer.innerHTML.trim() === '') {
                    if (typeof generateOldBlocks === "function") generateOldBlocks();
                }
                if(newContainer && newContainer.innerHTML.trim() === '') {
                    if (typeof generateNewBlocks === "function") generateNewBlocks();
                }
            }
            if(step == 3) {
                document.getElementById('ind-1').className = "step-indicator completed";
                document.getElementById('ind-2').className = "step-indicator completed";
                document.getElementById('ind-3').className = "step-indicator active";
                document.getElementById('line-1').className = "step-line active";
                document.getElementById('line-2').className = "step-line active";
            }
        }

