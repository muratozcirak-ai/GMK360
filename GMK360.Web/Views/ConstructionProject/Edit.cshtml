@model GMK360.Core.Entities.Construction.ConstructionProject

@{
    ViewData["Title"] = "Projeyi Düzenle";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-navy"><i class="ph ph-pencil-simple text-orange me-2"></i>Projeyi Düzenle</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4"><i class="ph ph-arrow-left me-2"></i>Geri Dön</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AgencyId" />
                <input type="hidden" asp-for="CoverImageUrl" />

                <div class="row g-4">

                    <div class="col-md-12">
                        <label asp-for="Status" class="form-label fw-bold">Proje Durumu</label>
                        <select asp-for="Status" class="form-select rounded-3">
                            <option value="1">Projelendirme / Teklif Aşamasında</option>
                            <option value="2">Aktif Şantiye (Yapım Aşamasında)</option>
                            <option value="4">Satışta (Topraktan)</option>
                            <option value="3">Tamamlandı / Teslim Edildi</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Name" class="form-label fw-bold">Proje Adı</label>
                        <input asp-for="Name" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-12">
                          <label asp-for="Description" class="form-label fw-bold">Kısa Açıklama / Proje Vizyonu</label>
                          <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                      </div>
                      
                      <div class="col-md-6">
                          <label asp-for="ProjectOriginId" class="form-label fw-bold text-success"><i class="bi bi-diagram-3"></i> Proje Kaynağı / Mülkiyet</label>
                          <select asp-for="ProjectOriginId" class="form-select rounded-3">
                              <option value="0">Seçiniz (Zorunlu Değil)</option>
                              <option value="1">Kentsel Dönüşüm (Bina Yönetimi Talebi)</option>
                              <option value="2">Kat Karşılığı (Arsa Sahibi)</option>
                              <option value="3">Kendi Arazimiz (Özmal / Doğrudan Yatırım)</option>
                              <option value="4">İhale / Kamu Projesi</option>
                              <option value="5">Kooperatif</option>
                          </select>
                      </div>
                      <div class="col-md-6">
                          <label asp-for="ProjectOwnerContact" class="form-label fw-bold text-success"><i class="bi bi-telephone"></i> Mal Sahibi / İletişim Notu</label>
                          <input asp-for="ProjectOwnerContact" type="text" class="form-control rounded-3" placeholder="Örn: Yöneticisi Ahmet Bey, Tel: 05..." />
                      </div>
                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label fw-bold">Adres</label>
                        <textarea asp-for="Address" class="form-control rounded-3" rows="2"></textarea>
                    </div>
                    <div id="projectDatesContainer" class="row g-3 m-0 p-0 w-100">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-bold">Başlangıç Tarihi</label>
                        <input asp-for="StartDate" type="date" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-bold">Hedeflenen Teslim</label>
                        <input asp-for="EndDate" type="date" class="form-control rounded-3" />
                    </div>
                </div>
                </div>

                <div class="text-end mt-5">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold"><i class="ph ph-floppy-disk me-2"></i>Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleStatusChange() {
            var status = document.getElementById('StatusId').value;
            var datesContainer = document.getElementById('projectDatesContainer');
            if (status == "1") {
                if(datesContainer) datesContainer.style.display = 'none';
            } else {
                if(datesContainer) datesContainer.style.display = 'flex';
            }
        }
        
        document.addEventListener("DOMContentLoaded", function() {
            handleStatusChange();
        });
    </script>
}
