    function parseAiMarkdown(markdownText) {
        if (!markdownText) return '';
        var lines = markdownText.split('\n');
        var html = '';
        var inList = false;

        for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (!line) {
                if (inList) { html += '</ul>'; inList = false; }
                continue;
            }
            if (line.startsWith('### ')) {
                if (inList) { html += '</ul>'; inList = false; }
                html += '<h6 class="fw-bold text-primary mt-3 mb-2">' + line.substring(4) + '</h6>';
            } else if (line.startsWith('## ')) {
                if (inList) { html += '</ul>'; inList = false; }
                html += '<h5 class="fw-bold text-dark mt-3 mb-2">' + line.substring(3) + '</h5>';
            } else if (line.startsWith('# ')) {
                if (inList) { html += '</ul>'; inList = false; }
                html += '<h5 class="fw-bold text-dark mt-3 mb-2">' + line.substring(2) + '</h5>';
            } else if (line.startsWith('- ') || line.startsWith('* ')) {
                if (!inList) { html += '<ul class="ps-3 mb-2">'; inList = true; }
                var content = line.substring(2);
                content = content.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                html += '<li class="mb-1 text-secondary">' + content + '</li>';
            } else {
                if (inList) { html += '</ul>'; inList = false; }
                var pContent = line.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                html += '<p class="mb-2 text-secondary">' + pContent + '</p>';
            }
        }
        if (inList) html += '</ul>';
        return html;
    }

    function triggerNeighborhoodAi() {
        var emptyBox = document.getElementById('aiEmptyContainer');
        var loading = document.getElementById('aiLoadingIndicator');
        var reportBox = document.getElementById('aiReportContainer');
        var reportBody = document.getElementById('aiReportBody');
        var btnTop = document.getElementById('btnTriggerAiTop');

        if (emptyBox) emptyBox.style.display = 'none';
        if (loading) loading.style.display = 'block';
        if (reportBox) reportBox.style.display = 'none';
        if (btnTop) btnTop.disabled = true;

        fetch('/ConstructionProject/RefreshNeighborhoodAi?projectId=@Model.Id', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (loading) loading.style.display = 'none';

            if (data.success && data.report) {
                if (reportBox) reportBox.style.display = 'block';
                if (reportBody) reportBody.innerHTML = parseAiMarkdown(data.report);
                var updatedEl = document.getElementById('aiUpdatedAtText');
                if (updatedEl && data.updatedAt) updatedEl.innerText = data.updatedAt;

                if (btnTop) {
                    btnTop.outerHTML = '<span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fw-bold" id="badgeAiStatus"><i class="bi bi-check-circle-fill me-1"></i>Analiz Kayıtlı</span>';
                }
            } else {
                if (emptyBox) emptyBox.style.display = 'block';
                alert(data.message || 'Yapay zeka analizi oluşturulurken hata meydana geldi.');
            }
        })
        .catch(function(err) {
            if (loading) loading.style.display = 'none';
            if (emptyBox) emptyBox.style.display = 'block';
            alert('Yapay zeka servisine bağlanırken bir hata oluştu.');
        });
    }

    function openMarketPortal(portal) {
        var city = '@cityName';
        var dist = '@distName';
        var neigh = '@neighName';
        var q = '';

        if (portal === 'sahibinden-satilik') {
            q = 'sahibinden satilik daire ' + city + ' ' + dist + ' ' + neigh;
        } else if (portal === 'sahibinden-kiralik') {
            q = 'sahibinden kiralik daire ' + city + ' ' + dist + ' ' + neigh;
        } else if (portal === 'endeksa') {
            q = 'endeksa ' + city + ' ' + dist + ' ' + neigh + ' konut fiyati degerleme';
        }

        var searchUrl = 'https://www.google.com/search?q=' + encodeURIComponent(q);
        window.open(searchUrl, '_blank');
    }

    // ==========================================
    // BÖLGE İSTİHBARATI & DONATILAR (20 POI)
    // ==========================================
    function loadLocationIntelligence() {
        var neighborhoodId = @(Model.NeighborhoodId ?? 0);
        if (!neighborhoodId) {
            var container = document.getElementById('poiListContainer');
            if (container) container.innerHTML = '<div class="col-12 text-center py-3 text-muted">Bu projeye atanmış mahalle bilgisi bulunamadı.</div>';
            return;
        }

        fetch('/api/LocationIntelligence/GetNearbyPlaces?neighborhoodId=' + neighborhoodId)
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data && data.length > 0) {
                    allPoisData = data;
                    renderPoiCards(data);
                    updatePoiCounts(data);
                } else {
                    fetch('/api/Location/POIs/' + neighborhoodId)
                        .then(function(r) { return r.json(); })
                        .then(function(data2) {
                            if (data2 && data2.length > 0) {
                                var mapped = data2.map(function(item) {
                                    return {
                                        id: item.id,
                                        poiName: item.poiName,
                                        category: item.categoryName || (item.poiCategory === 1 ? 'Education' : item.poiCategory === 2 ? 'Health' : item.poiCategory === 3 ? 'Transport' : item.poiCategory === 4 ? 'Security' : item.poiCategory === 5 ? 'SocialAndPark' : 'Shopping'),
                                        subCategory: '',
                                        distanceInMeters: item.distanceInMeters
                                    };
                                });
                                allPoisData = mapped;
                                renderPoiCards(mapped);
                                updatePoiCounts(mapped);
                            } else {
                                var container = document.getElementById('poiListContainer');
                                if (container) container.innerHTML = '<div class="col-12 text-center py-4 text-muted">Bu mahalle için henüz kayıtlı donatı bulunamadı.</div>';
                            }
                        });
                }
            })
            .catch(function(err) {
                console.error('POI yükleme hatası:', err);
            });
    }

    function updatePoiCounts(data) {
        var countBadge = document.getElementById('badgePoiCount');
        if (countBadge) countBadge.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i>' + data.length + ' Donatı';

        var cntAll = document.getElementById('cntAll');
        var cntHealth = document.getElementById('cntHealth');
        var cntEducation = document.getElementById('cntEducation');
        var cntTransport = document.getElementById('cntTransport');
        var cntPark = document.getElementById('cntPark');
        var cntShopping = document.getElementById('cntShopping');

        if (cntAll) cntAll.innerText = data.length;
        if (cntHealth) cntHealth.innerText = data.filter(function(x) { return x.category === 'Health'; }).length;
        if (cntEducation) cntEducation.innerText = data.filter(function(x) { return x.category === 'Education'; }).length;
        if (cntTransport) cntTransport.innerText = data.filter(function(x) { return x.category === 'Transport'; }).length;
        if (cntPark) cntPark.innerText = data.filter(function(x) { return x.category === 'SocialAndPark'; }).length;
        if (cntShopping) cntShopping.innerText = data.filter(function(x) { return x.category === 'Shopping' || x.category === 'Security'; }).length;
    }

    function renderPoiCards(list) {
        var container = document.getElementById('poiListContainer');
        if (!container) return;
        if (!list || list.length === 0) {
            container.innerHTML = '<div class="col-12 text-center py-4 text-muted">Bu kategoride donatı bulunamadı.</div>';
            return;
        }

        var html = '';
        list.forEach(function(item) {
            var iconClass = 'bi-geo-alt';
            var catLabel = 'Donatı';
            var badgeBg = 'bg-secondary bg-opacity-10 text-secondary border border-secondary';

            if (item.category === 'Health') {
                iconClass = 'bi-heart-pulse-fill text-danger';
                catLabel = 'Sağlık';
                badgeBg = 'bg-danger bg-opacity-10 text-danger border border-danger';
            } else if (item.category === 'Education') {
                iconClass = 'bi-mortarboard-fill text-info';
                catLabel = 'Eğitim';
                badgeBg = 'bg-info bg-opacity-10 text-info border border-info';
            } else if (item.category === 'Transport') {
                iconClass = 'bi-train-front-fill text-primary';
                catLabel = 'Ulaşım';
                badgeBg = 'bg-primary bg-opacity-10 text-primary border border-primary';
            } else if (item.category === 'SocialAndPark') {
                iconClass = 'bi-tree-fill text-success';
                catLabel = 'Park & Sosyal';
                badgeBg = 'bg-success bg-opacity-10 text-success border border-success';
            } else if (item.category === 'Shopping') {
                iconClass = 'bi-bag-fill text-warning';
                catLabel = 'Alışveriş';
                badgeBg = 'bg-warning bg-opacity-10 text-dark border border-warning';
            } else if (item.category === 'Security') {
                iconClass = 'bi-shield-shaded text-secondary';
                catLabel = 'Güvenlik';
                badgeBg = 'bg-secondary bg-opacity-10 text-secondary border border-secondary';
            }

            var distText = item.distanceInMeters >= 1000 
                ? (item.distanceInMeters / 1000).toFixed(1) + ' km' 
                : Math.round(item.distanceInMeters) + ' m';

            var walkMins = Math.max(1, Math.round(item.distanceInMeters / 80));

            html += '<div class="col-md-6 col-xl-4">' +
                '<div class="card h-100 border border-light-subtle rounded-3 p-3 shadow-xs bg-white poi-card">' +
                    '<div class="d-flex justify-content-between align-items-start mb-2">' +
                        '<div class="d-flex align-items-center gap-2">' +
                            '<span class="d-inline-flex align-items-center justify-content-center rounded-circle p-2 ' + badgeBg + '" style="width: 30px; height: 30px;">' +
                                '<i class="bi ' + iconClass + ' fs-6"></i>' +
                            '</span>' +
                            '<div>' +
                                '<span class="badge ' + badgeBg + ' px-2 py-0 fw-semibold" style="font-size: 0.66rem;">' + (item.subCategory || catLabel) + '</span>' +
                            '</div>' +
                        '</div>' +
                        '<span class="badge bg-light text-dark border fw-bold px-2 py-1" style="font-size: 0.72rem;">' +
                            '<i class="bi bi-geo-alt me-1 text-primary"></i>' + distText +
                        '</span>' +
                    '</div>' +
                    '<h6 class="fw-bold text-dark mb-1 text-truncate" title="' + item.poiName + '">' + item.poiName + '</h6>' +
                    '<div class="text-muted d-flex align-items-center gap-2 mt-auto pt-1" style="font-size: 0.72rem;">' +
                        '<span><i class="bi bi-person-walking text-primary me-1"></i>~' + walkMins + ' dk yürüme mesafesinde</span>' +
                    '</div>' +
                '</div>' +
            '</div>';
        });

        container.innerHTML = html;
    }

    function filterPoiList(category, btn) {
        var buttons = document.querySelectorAll('#poiFilterButtons .filter-btn');
        buttons.forEach(function(b) {
            b.classList.remove('active');
            b.classList.remove('btn-primary');
            b.classList.add('btn-outline-primary');
        });

        btn.classList.add('active');
        btn.classList.remove('btn-outline-primary');
        btn.classList.add('btn-primary');

        if (category === 'all') {
            renderPoiCards(allPoisData);
        } else if (category === 'Shopping') {
            var filtered = allPoisData.filter(function(x) { return x.category === 'Shopping' || x.category === 'Security'; });
            renderPoiCards(filtered);
        } else {
            var filtered = allPoisData.filter(function(x) { return x.category === category; });
            renderPoiCards(filtered);
        }
    }

    // ==========================================
    // TKGM CANLI PARSEL SORGUSU
    // ==========================================
    function openTkgmModal() {
        loadTkgmProvinces();
        var modal = new bootstrap.Modal(document.getElementById('tkgmModal'));
        modal.show();
    }

    function loadTkgmProvinces() {
        var provSelect = document.getElementById('modalTkgmProvince');
        if (provSelect.options.length > 1) return;

        fetch('/ConstructionProject/GetTkgmProvinces')
            .then(function (res) { return res.json(); })
            .then(function (data) {
                provSelect.innerHTML = '<option value="">Seçiniz...</option>';
                data.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value = p.id;
                    opt.text = p.name;
                    if (p.name.toLowerCase().includes('istanbul')) opt.selected = true;
                    provSelect.appendChild(opt);
                });
                if (provSelect.value) loadTkgmDistricts();
            });
    }

    function loadTkgmDistricts() {
        var provId = document.getElementById('modalTkgmProvince').value;
        var distSelect = document.getElementById('modalTkgmDistrict');
        distSelect.innerHTML = '<option value="">Yükleniyor...</option>';

        fetch('/ConstructionProject/GetTkgmDistricts?provinceId=' + provId)
            .then(function (res) { return res.json(); })
            .then(function (data) {
                distSelect.innerHTML = '<option value="">Seçiniz...</option>';
                data.forEach(function (d) {
                    var opt = document.createElement('option');
                    opt.value = d.id;
                    opt.text = d.name;
                    if (d.name.toLowerCase().includes('@distName.ToLower()')) opt.selected = true;
                    distSelect.appendChild(opt);
                });
                if (distSelect.value) loadTkgmNeighborhoods();
            });
    }

    function loadTkgmNeighborhoods() {
        var distId = document.getElementById('modalTkgmDistrict').value;
        var neighSelect = document.getElementById('modalTkgmNeighborhood');
        neighSelect.innerHTML = '<option value="">Yükleniyor...</option>';

        fetch('/ConstructionProject/GetTkgmNeighborhoods?districtId=' + distId)
            .then(function (res) { return res.json(); })
            .then(function (data) {
                neighSelect.innerHTML = '<option value="">Seçiniz...</option>';
                data.forEach(function (n) {
                    var opt = document.createElement('option');
                    opt.value = n.id;
                    opt.text = n.name;
                    if (n.name.toLowerCase().includes('@neighName.ToLower()')) opt.selected = true;
                    neighSelect.appendChild(opt);
                });
            });
    }

    function executeTkgmQuery() {
        var neighId = document.getElementById('modalTkgmNeighborhood').value;
        var ada = document.getElementById('modalTkgmAda').value.trim();
        var parsel = document.getElementById('modalTkgmParsel').value.trim();

        if (!neighId || !ada || !parsel) {
            alert('Lütfen Mahalle, Ada ve Parsel alanlarını eksiksiz giriniz.');
            return;
        }

        document.getElementById('tkgmQueryLoading').style.display = 'block';
        document.getElementById('tkgmResultBox').style.display = 'none';
        document.getElementById('btnApplyTkgm').style.display = 'none';

        fetch('/ConstructionProject/QueryTkgmParcel?neighborhoodId=' + neighId + '&ada=' + ada + '&parsel=' + parsel)
            .then(function (res) { return res.json(); })
            .then(function (data) {
                document.getElementById('tkgmQueryLoading').style.display = 'none';
                if (data.success && data.parcel) {
                    lastFoundTkgmDto = data.parcel;
                    document.getElementById('resTkgmMevkii').innerText = (data.parcel.ilAd || '') + ' / ' + (data.parcel.ilceAd || '') + ' - ' + (data.parcel.mahalleAd || '');
                    document.getElementById('resTkgmAlan').innerText = data.parcel.alan.toLocaleString('tr-TR', { minimumFractionDigits: 2 });
                    document.getElementById('resTkgmNitelik').innerText = data.parcel.nitelik || 'Arsa';
                    document.getElementById('tkgmResultBox').style.display = 'block';
                    document.getElementById('btnApplyTkgm').style.display = 'inline-block';
                } else {
                    alert('TKGM Parsel Sorgu Hatası: ' + (data.message || 'Parsel bulunamadı.'));
                }
            })
            .catch(function (err) {
                document.getElementById('tkgmQueryLoading').style.display = 'none';
                alert('TKGM MEGSİS servisine bağlanırken bir hata oluştu.');
            });
    }

    function applyTkgmToProject() {
        if (!lastFoundTkgmDto) return;

        var payload = {
            projectId: @Model.Id,
            ada: lastFoundTkgmDto.ada,
            parsel: lastFoundTkgmDto.parsel,
            area: lastFoundTkgmDto.alan,
            geoJson: JSON.stringify(lastFoundTkgmDto.geoJsonCoordinates),
            latitude: lastFoundTkgmDto.centerLatitude,
            longitude: lastFoundTkgmDto.centerLongitude
        };

        fetch('/ConstructionProject/ApplyTkgmParcelData', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (data.success) {
                document.getElementById('calcLandArea').value = lastFoundTkgmDto.alan;
                document.getElementById('mapAreaText').innerText = lastFoundTkgmDto.alan.toLocaleString('tr-TR', { maximumFractionDigits: 2 });
                document.getElementById('mapAdaText').innerText = lastFoundTkgmDto.ada;
                document.getElementById('mapParselText').innerText = lastFoundTkgmDto.parsel;
                document.getElementById('dispAda').innerText = lastFoundTkgmDto.ada;
                document.getElementById('dispParsel').innerText = lastFoundTkgmDto.parsel;

                if (lastFoundTkgmDto.geoJsonCoordinates) {
                    renderParcelPolygon(lastFoundTkgmDto.geoJsonCoordinates);
                }

                runContractorEstimate(true);

                var modalEl = document.getElementById('tkgmModal');
                var modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            }
        });
    }
