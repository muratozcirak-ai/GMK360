@model GMK360.Web.Models.FeasibilityViewModel
@{
    ViewData["Title"] = "Eski Bina Fizibilitesi ve Malik Borçlandırma";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-calculator text-primary me-2"></i> Fizibilite ve Borçlandırma</h2>
            <p class="text-muted mb-0">@Model.ProjectName - Aday Bütçe ve Kat Maliki Dağılımı</p>
        </div>
        <div>
            <a href="@Url.Action("Details", new { id = Model.ProjectId })" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Projeye Dön
            </a>
        </div>
    </div>

    <form id="feasibilityForm">
        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
        
        <div class="row">
            <!-- Sol Kolon: Bütçe Girdileri -->
            <div class="col-md-5">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h5 class="fw-bold"><i class="bi bi-building-down text-danger me-2"></i> Eski Bina Referans Verileri</h5>
                    </div>
                    <div class="card-body bg-light rounded-4 m-3 mt-2">
                        <div class="row text-center">
                            <div class="col-4 border-end">
                                <h3 class="fw-bold text-dark mb-0">@(Model.EskiKatSayisi ?? 0)</h3>
                                <span class="text-muted small">Eski Kat</span>
                            </div>
                            <div class="col-4 border-end">
                                <h3 class="fw-bold text-dark mb-0">@(Model.EskiDaireSayisi ?? 0)</h3>
                                <span class="text-muted small">Eski Daire</span>
                            </div>
                            <div class="col-4">
                                <h3 class="fw-bold text-dark mb-0">@(Model.EskiToplamMetrekare ?? 0) <small class="fs-6">m²</small></h3>
                                <span class="text-muted small">Toplam Alan</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h5 class="fw-bold"><i class="bi bi-cash-stack text-success me-2"></i> Tahmini Maliyetler (Gider)</h5>
                        <p class="text-muted small">Maliyetler eski bina m²'sine göre tahmini üretilmiştir.</p>
                    </div>
                    <div class="card-body pt-2">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Yıkım İzni ve Harçlar (₺)</label>
                            <input type="number" class="form-control cost-input" name="YikimIzniVeHarclar" value="@Model.YikimIzniVeHarclar" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Çevre Kapanması (İskele/Bariyer) (₺)</label>
                            <input type="number" class="form-control cost-input" name="CevreKapanmasiMaliyeti" value="@Model.CevreKapanmasiMaliyeti" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Yıkım ve Hafriyat Maliyeti (₺)</label>
                            <input type="number" class="form-control cost-input" name="YikimHafriyatMaliyeti" value="@Model.YikimHafriyatMaliyeti" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Asbest Söküm Maliyeti (₺)</label>
                            <input type="number" class="form-control cost-input" name="AsbestSokumMaliyeti" value="@Model.AsbestSokumMaliyeti" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Yeni Ruhsat ve Harçlar (₺)</label>
                            <input type="number" class="form-control cost-input" name="YeniRuhsatHarci" value="@Model.YeniRuhsatHarci" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">İnşaat Yapım Maliyeti (₺)</label>
                            <input type="number" class="form-control cost-input" name="InsaatYapimMaliyeti" value="@Model.InsaatYapimMaliyeti" />
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">TOPLAM MALİYET:</h6>
                            <h4 class="fw-bold text-danger mb-0" id="toplamMaliyetLbl">@Model.ToplamMaliyet.ToString("N2") ₺</h4>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 bg-primary text-white mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold"><i class="bi bi-graph-up-arrow me-2"></i> Müteahhit Gelir Beklentisi</h5>
                        <p class="small text-white-50">Size kalacak dairelerin tahmini satış toplamını giriniz.</p>
                        <div class="input-group input-group-lg mb-0">
                            <span class="input-group-text bg-white border-0 fw-bold">₺</span>
                            <input type="number" class="form-control border-0 fw-bold" id="gelirInput" name="SatisGeliriBeklentisi" value="@Model.SatisGeliriBeklentisi" placeholder="Örn: 15000000" />
                        </div>
                    </div>
                </div>
                
                <div class="card shadow-sm border-0 rounded-4 mb-4 border-danger border-2" id="zararCard" style="display: none;">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-2"></i>
                        <h5 class="fw-bold text-danger">Finansman Açığı (Zarar)</h5>
                        <h3 class="fw-bold mb-3" id="toplamFarkLbl">0.00 ₺</h3>
                        <p class="text-muted small mb-0">Bu açık, arsa payları oranında kat maliklerine borçlandırılacaktır.</p>
                    </div>
                </div>
                
                <div class="card shadow-sm border-0 rounded-4 mb-4 border-success border-2" id="karCard" style="display: none;">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-check-circle-fill text-success fs-1 mb-2"></i>
                        <h5 class="fw-bold text-success">Kârlı Proje</h5>
                        <h3 class="fw-bold mb-3" id="toplamKarLbl">0.00 ₺</h3>
                        <p class="text-muted small mb-0">Satış gelirleri maliyetleri karşılıyor. Kat maliklerinden ek ödeme talep edilmeyecektir.</p>
                    </div>
                </div>
            </div>

            <!-- Sağ Kolon: Kat Malikleri Borçlandırma Tablosu -->
            <div class="col-md-7">
                <div class="card shadow-sm border-0 rounded-4 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0"><i class="bi bi-people text-warning me-2"></i> Kat Malikleri Pay & Borç Dağılımı</h5>
                            <p class="text-muted small mb-0 mt-1">Zarar durumu, girilen arsa payı oranında otomatik dağıtılır.</p>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="sendMassSms()">
                                <i class="bi bi-chat-dots me-1"></i> Toplu SMS
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Malik Adı</th>
                                        <th>Bağımsız Bölüm</th>
                                        <th style="width: 150px;">Arsa Payı (%)</th>
                                        <th class="text-end pe-4">Düşen Borç (₺)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for(int i=0; i<Model.Owners.Count; i++)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <input type="hidden" name="Owners[@i].OwnerId" value="@Model.Owners[i].OwnerId" />
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary me-3">
                                                        @Model.Owners[i].FullName.Substring(0, 1)
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 fw-bold">@Model.Owners[i].FullName</h6>
                                                        <small class="text-muted">@Model.Owners[i].PhoneNumber</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">@Model.Owners[i].FlatNumber</span>
                                            </td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <input type="number" step="0.01" class="form-control share-input" name="Owners[@i].LandShare" value="@Model.Owners[i].LandShare" />
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </td>
                                            <td class="text-end pe-4">
                                                <input type="hidden" class="debt-input-hidden" name="Owners[@i].CalculatedDebt" value="@Model.Owners[i].CalculatedDebt" />
                                                <h6 class="mb-0 fw-bold text-danger debt-label">@Model.Owners[i].CalculatedDebt.ToString("N2") ₺</h6>
                                            </td>
                                        </tr>
                                    }
                                    @if(Model.Owners.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
                                                Projeye henüz kat maliki eklenmemiş.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light">
                                    <tr>
                                        <td colspan="2" class="text-end ps-4">
                                            <h6 class="fw-bold text-dark mb-0">TOPLAM:</h6>
                                        </td>
                                        <td>
                                            <h6 class="fw-bold text-dark mb-0 text-center" id="toplamPayLbl">100%</h6>
                                        </td>
                                        <td class="text-end pe-4">
                                            <h6 class="fw-bold text-danger mb-0" id="toplamDagitilanLbl">0.00 ₺</h6>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-4 pt-3 text-end">
                        <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow" onclick="saveFeasibility()">
                            <i class="bi bi-check2-circle me-2"></i> Fizibiliteyi Kaydet
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function calculateAll() {
            var costInputs = document.querySelectorAll('.cost-input');
            var totalCost = 0;
            costInputs.forEach(function(input) {
                totalCost += parseFloat(input.value || 0);
            });
            
            document.getElementById('toplamMaliyetLbl').innerText = formatMoney(totalCost) + ' ₺';
            
            var revenue = parseFloat(document.getElementById('gelirInput').value || 0);
            var difference = totalCost - revenue;
            
            var zararCard = document.getElementById('zararCard');
            var karCard = document.getElementById('karCard');
            
            if (difference > 0) {
                zararCard.style.display = 'block';
                karCard.style.display = 'none';
                document.getElementById('toplamFarkLbl').innerText = formatMoney(difference) + ' ₺';
            } else {
                zararCard.style.display = 'none';
                karCard.style.display = 'block';
                document.getElementById('toplamKarLbl').innerText = formatMoney(Math.abs(difference)) + ' ₺';
                difference = 0;
            }
            
            var shareInputs = document.querySelectorAll('.share-input');
            var debtHiddenInputs = document.querySelectorAll('.debt-input-hidden');
            var debtLabels = document.querySelectorAll('.debt-label');
            
            var totalShare = 0;
            var totalDistributed = 0;
            
            for (var i = 0; i < shareInputs.length; i++) {
                var share = parseFloat(shareInputs[i].value || 0);
                totalShare += share;
                
                var debt = (difference * (share / 100.0));
                debtHiddenInputs[i].value = debt;
                debtLabels[i].innerText = formatMoney(debt) + ' ₺';
                
                totalDistributed += debt;
            }
            
            document.getElementById('toplamPayLbl').innerText = totalShare.toFixed(2) + '%';
            if (totalShare > 100.1 || totalShare < 99.9) {
                document.getElementById('toplamPayLbl').classList.add('text-danger');
            } else {
                document.getElementById('toplamPayLbl').classList.remove('text-danger');
            }
            
            document.getElementById('toplamDagitilanLbl').innerText = formatMoney(totalDistributed) + ' ₺';
        }
        
        function formatMoney(amount) {
            return amount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        
        document.querySelectorAll('.cost-input, #gelirInput, .share-input').forEach(function(el) {
            el.addEventListener('input', calculateAll);
        });
        
        calculateAll();
        
        function saveFeasibility() {
            var formData = new FormData(document.getElementById('feasibilityForm'));
            
            fetch('@Url.Action("SaveFeasibility", "ConstructionProject")', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Kaydedildi!',
                        text: 'Fizibilite bütçesi ve malik borçlandırmaları başarıyla kaydedildi.',
                        confirmButtonText: 'Tamam'
                    });
                } else {
                    Swal.fire('Hata', data.message, 'error');
                }
            })
            .catch(e => {
                Swal.fire('Hata', 'Bir ağ hatası oluştu.', 'error');
            });
        }
        
        function sendMassSms() {
            Swal.fire({
                title: 'Toplu SMS Gönder',
                text: `Kayıtlı @Model.Owners.Count kat malikine 'Kentsel Dönüşüm Bilgilendirme ve Karar Toplantısı' daveti SMS olarak gönderilecektir. Onaylıyor musunuz?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Evet, Gönder!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Gönderiliyor...',
                        html: 'Operatör üzerinden SMS'ler iletiliyor.',
                        timer: 2000,
                        timerProgressBar: true,
                        didOpen: () => {
                            Swal.showLoading()
                        }
                    }).then((result) => {
                        Swal.fire(
                            'Gönderildi!',
                            `@Model.Owners.Count adet SMS başarıyla iletildi.`,
                            'success'
                        )
                    });
                }
            })
        }
    </script>
}
