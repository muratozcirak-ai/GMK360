    function getCurrentActiveScenario() {
        var floors = parseInt(document.getElementById('calcTotalFloors').value) || 15;
        var unitsPerFloor = parseInt(document.getElementById('calcUnitsPerFloor').value) || 2;
        var ownerSharePercent = parseFloat(document.getElementById('calcOwnerShare').value) || 50;
        var flatSalePrice = parseFloat(document.getElementById('calcFlatSalePrice').value) || 10000000;
        var firmUnitCost = parseFloat(document.getElementById('calcFirmUnitCost').value) || 25000;
        var basementInp = document.getElementById('calcBasementFloors');
        var basementFloors = basementInp ? (parseInt(basementInp.value) || 2) : 2;
        var coreLossInp = document.getElementById('calcCoreLossSqm');
        var coreLoss = coreLossInp ? (parseFloat(coreLossInp.value) || 35) : 35;

        var totalCostFloors = floors + basementFloors + 2;
        var totalUnits = floors * unitsPerFloor;
        var ownerUnits = Math.round(totalUnits * (ownerSharePercent / 100.0));
        var contractorUnits = totalUnits - ownerUnits;
        var totalRevenue = contractorUnits * flatSalePrice;
        var totalConstSqm = totalCostFloors * 271;
        var totalCost = totalConstSqm * firmUnitCost;
        var netProfit = totalRevenue - totalCost;

        var grossFloorArea = 271;
        var usableFloorArea = Math.max(0, grossFloorArea - coreLoss);
        var unitSqm = unitsPerFloor > 0 ? Math.round(usableFloorArea / unitsPerFloor) : 0;
        var unitType = unitSqm >= 100 ? 'Ferah 3+1' : (unitSqm >= 65 ? 'Kompakt 2+1' : '1+1');

        return {
            title: 'Aktif Teklif Planı (' + unitsPerFloor + ' Daire - ' + unitType + ')',
            floors: floors,
            unitsPerFloor: unitsPerFloor,
            totalUnits: totalUnits,
            ownerUnits: ownerUnits,
            contractorUnits: contractorUnits,
            ownerSharePercent: ownerSharePercent,
            unitSqm: unitSqm,
            unitType: unitType,
            unitPrice: flatSalePrice,
            totalRevenue: totalRevenue,
            totalConstSqm: totalConstSqm,
            firmCost: totalCost,
            netProfit: netProfit
        };
    }

