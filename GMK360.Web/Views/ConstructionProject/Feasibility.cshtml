<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    var mapInstance = null;
    var currentParcelLayer = null;
    var osmLayer = null;
    var satLayer = null;
    var lastFoundTkgmDto = null;
    var simAutosaveTimer = null;
    var allPoisData = [];

    document.addEventListener('DOMContentLoaded', function () {
        // Raw AI rapor varsa parse et
        var rawReportEl = document.getElementById('rawAiReport');
        if (rawReportEl) {
            var rawText = rawReportEl.innerText;
            var reportBody = document.getElementById('aiReportBody');
            if (reportBody) reportBody.innerHTML = parseAiMarkdown(rawText);
        }

        // Çevre donatılarını çek
        loadLocationIntelligence();

        // Haritayı başlat (varsayılan container gizli)
        var mapCont = document.getElementById('feasibilityMapCollapse');
        if (mapCont && mapCont.style.display !== 'none') {
            initLeafletMap();
        }

        // İlk hesaplamayı çalıştır
        runContractorEstimate();

        // Kayıtlı modelleri yerel depolamadan yükle (Gezinip gelince kaybolmaz)
        loadScenariosFromStorage();
    });

    // ==========================================
    // AKORDEON AÇ/KAPA (TEK TIKLA BAŞLIKTAN)
    // ==========================================
    function toggleSection(sectionId) {
        var el = document.getElementById(sectionId);
        if (!el) return;

        var bsCollapse = bootstrap.Collapse.getInstance(el);
        if (!bsCollapse) {
            bsCollapse = new bootstrap.Collapse(el, { toggle: false });
        }

        if (el.classList.contains('show')) {
            bsCollapse.hide();
            updateAccordionHeader(sectionId, false);
        } else {
            bsCollapse.show();
            updateAccordionHeader(sectionId, true);
        }
    }

    function updateAccordionHeader(sectionId, isOpen) {
        if (sectionId === 'aiSectionCollapse') {
            var icon = document.getElementById('iconAiSectionChevron');
            var text = document.getElementById('textAiSectionToggle');
            if (icon) icon.className = isOpen ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
            if (text) text.innerText = isOpen ? 'Daralt' : 'Genişlet';
        } else if (sectionId === 'poiSectionCollapse') {
            var icon = document.getElementById('iconPoiSectionChevron');
            var text = document.getElementById('textPoiSectionToggle');
            if (icon) icon.className = isOpen ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
            if (text) text.innerText = isOpen ? 'Daralt' : 'Genişlet';
        }
    }

    // ==========================================
    // HARİTA YÖNETİMİ
    // ==========================================
    function toggleMapCollapse(forceOpen) {
        var container = document.getElementById('feasibilityMapCollapse');
        var textEl = document.getElementById('textMapToggle');
        var iconEl = document.getElementById('iconMapChevron');
        if (!container) return;

        var shouldOpen = forceOpen !== undefined ? forceOpen : (container.style.display === 'none');

        if (shouldOpen) {
            container.style.display = 'block';
            if (textEl) textEl.innerText = 'Haritayı Gizle';
            if (iconEl) iconEl.className = 'bi bi-chevron-up ms-1';
            localStorage.setItem('gmk_map_feasibility_@Model.Id', 'open');

            setTimeout(function() {
                if (!mapInstance) {
                    initLeafletMap();
                } else {
                    mapInstance.invalidateSize();
                    if (currentParcelLayer) {
                        mapInstance.fitBounds(currentParcelLayer.getBounds(), { padding: [30, 30] });
                    }
                }
            }, 100);
        } else {
            container.style.display = 'none';
            if (textEl) textEl.innerText = 'Haritayı Göster';
            if (iconEl) iconEl.className = 'bi bi-chevron-down ms-1';
            localStorage.setItem('gmk_map_feasibility_@Model.Id', 'closed');
        }
    }

    function toggleMapFullscreen() {
        var mapEl = document.getElementById('feasibilityMap');
        var iconEl = document.getElementById('iconFullscreen');
        var textEl = document.getElementById('textFullscreen');

        if (mapEl.style.height === '80vh') {
            mapEl.style.height = '480px';
            if (iconEl) iconEl.className = 'bi bi-arrows-fullscreen me-1';
            if (textEl) textEl.innerText = 'Tam Ekran';
        } else {
            mapEl.style.height = '80vh';
            if (iconEl) iconEl.className = 'bi bi-fullscreen-exit me-1';
            if (textEl) textEl.innerText = 'Küçült';
        }

        setTimeout(function() {
            if (mapInstance) mapInstance.invalidateSize();
        }, 200);
    }

    function initLeafletMap() {
        var mapContainer = document.getElementById('feasibilityMap');
        if (!mapContainer || mapInstance) return;

        satLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
            maxZoom: 19
        });

        osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
        });

        var hasProjectCoords = @(Model.Latitude.HasValue && Model.Longitude.HasValue ? "true" : "false");
        var defaultLat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "41.0082");
        var defaultLng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "28.9784");
        var initZoom = hasProjectCoords ? 18 : 12;

        mapInstance = L.map('feasibilityMap', {
            layers: [satLayer]
        }).setView([defaultLat, defaultLng], initZoom);

        if (hasProjectCoords) {
            L.marker([defaultLat, defaultLng]).addTo(mapInstance);
        } else {
            var locQuery = '@Html.Raw(((ViewBag.NeighborhoodName as string) != null ? (ViewBag.NeighborhoodName as string) + ", " : "") + ((ViewBag.DistrictName as string) != null ? (ViewBag.DistrictName as string) + ", " : "") + ((ViewBag.CityName as string) ?? ""))';
            if (locQuery && locQuery.trim().length > 2) {
                fetch('https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?f=json&maxLocations=1&SingleLine=' + encodeURIComponent(locQuery + ', Türkiye'))
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        if (d && d.candidates && d.candidates.length > 0 && mapInstance) {
                            var loc = d.candidates[0].location;
                            mapInstance.setView([loc.y, loc.x], 15);
                        }
                    }).catch(function() {});
            }
        }

        var existingGeoJson = '@Html.Raw(Model.ParcelPolygonGeoJson ?? "")';
        if (existingGeoJson && existingGeoJson.length > 10) {
            try {
                var geoData = JSON.parse(existingGeoJson);
                renderParcelPolygon(geoData);
            } catch (e) {
                console.warn('Existing GeoJSON parse error', e);
            }
        }
        setTimeout(function() { if (mapInstance) { mapInstance.invalidateSize(); if (currentParcelLayer) mapInstance.fitBounds(currentParcelLayer.getBounds(), { padding: [30, 30] }); } }, 150);
    }

    function setMapLayer(layerType) {
        if (!mapInstance) return;
        if (layerType === 'osm') {
            mapInstance.removeLayer(satLayer);
            mapInstance.addLayer(osmLayer);
            document.getElementById('btnLayerOsm').classList.add('active');
            document.getElementById('btnLayerSat').classList.remove('active');
        } else {
            mapInstance.removeLayer(osmLayer);
            mapInstance.addLayer(satLayer);
            document.getElementById('btnLayerSat').classList.add('active');
            document.getElementById('btnLayerOsm').classList.remove('active');
        }
    }

    function renderParcelPolygon(geoJson) {
        if (!mapInstance) return;
        if (currentParcelLayer) {
            mapInstance.removeLayer(currentParcelLayer);
        }

        currentParcelLayer = L.geoJSON(geoJson, {
            style: {
                color: '#dc3545',
                weight: 4,
                opacity: 0.9,
                fillColor: '#ffc107',
                fillOpacity: 0.35
            }
        }).addTo(mapInstance);

        mapInstance.fitBounds(currentParcelLayer.getBounds(), { padding: [30, 30] });
    }

    // ==========================================
    // CANLI "BANA NE KALIR?" SİMÜLATÖRÜ
    // ==========================================
        // ==========================================
    // MÜTEAHHİT HIZLI KARAR & ÖN FİZİBİLİTE TERAZİSİ
    // ==========================================
    function updateFlatPriceForUnits(units) {
        var priceInp = document.getElementById('calcFlatSalePrice');
        if (!priceInp) return;
        if (units === 2) {
            priceInp.value = 10000000;
        } else if (units === 3) {
            priceInp.value = 6800000;
        } else if (units === 1) {
            priceInp.value = 18000000;
        } else if (units >= 4) {
            priceInp.value = 4500000;
        }
    }

    function syncUnitsPresetButtons(units) {
        var btn2 = document.getElementById('btnUnitPreset2');
        var btn3 = document.getElementById('btnUnitPreset3');
        if (btn2) {
            btn2.classList.toggle('btn-primary', units === 2);
            btn2.classList.toggle('btn-outline-primary', units !== 2);
        }
        if (btn3) {
            btn3.classList.toggle('btn-primary', units === 3);
            btn3.classList.toggle('btn-outline-primary', units !== 3);
        }
    }

    function setUnitsPerFloor(units, btn) {
        var inp = document.getElementById('calcUnitsPerFloor');
        if (inp) inp.value = units;
        syncUnitsPresetButtons(units);
        updateFlatPriceForUnits(units);
        runContractorEstimate(true);
    }

    function onUnitsPerFloorChange(val) {
        var units = parseInt(val) || 2;
        syncUnitsPresetButtons(units);
        updateFlatPriceForUnits(units);
        runContractorEstimate(true);
    }

    function setOwnerShare(percent, btn) {
        var inp = document.getElementById('calcOwnerShare');
        if (inp) inp.value = percent;
        var card = document.getElementById('cardFeasibilityEstimates');
        if (card) {
            var buttons = card.querySelectorAll('button[onclick^="setOwnerShare"]');
            buttons.forEach(function(b) {
                b.classList.remove('btn-success');
                b.classList.add('btn-outline-success');
            });
        }
        if (btn) {
            btn.classList.remove('btn-outline-success');
            btn.classList.add('btn-success');
        }
        runContractorEstimate(true);
    }

    function runContractorEstimate(isUserAction) {
        var floors = parseInt(document.getElementById('calcTotalFloors').value) || 0;
        var basementInp = document.getElementById('calcBasementFloors');
        var basementFloors = basementInp ? (parseInt(basementInp.value) || 0) : 2;
        var unitsPerFloor = parseInt(document.getElementById('calcUnitsPerFloor').value) || 0;
        var coreLossInp = document.getElementById('calcCoreLossSqm');
        var coreLoss = coreLossInp ? (parseFloat(coreLossInp.value) || 35) : 35;
        var ownerSharePercent = parseFloat(document.getElementById('calcOwnerShare').value) || 0;
        var flatSalePrice = parseFloat(document.getElementById('calcFlatSalePrice').value) || 0;
        var firmUnitInp = document.getElementById('calcFirmUnitCost');
        var firmUnitCost = firmUnitInp ? (parseFloat(firmUnitInp.value) || 0) : 25000;
        var oldOwners = @(Model.EskiDaireSayisi ?? 4);
        var oldShops = @(Model.EskiDukkanSayisi ?? 0);

        var plannedShopsInp = document.getElementById('calcPlannedNewShops');
        var plannedNewShops = plannedShopsInp ? (parseInt(plannedShopsInp.value) || 0) : 0;
        var ownerShopsInp = document.getElementById('calcOwnerGivenShops');
        var ownerGivenShops = ownerShopsInp ? (parseInt(ownerShopsInp.value) || 0) : 0;
        var shopPriceInp = document.getElementById('calcShopSalePrice');
        var shopSalePrice = shopPriceInp ? (parseFloat(shopPriceInp.value) || 0) : 0;
        var rentMonthsInp = document.getElementById('calcRentMonths');
        var rentMonths = rentMonthsInp ? (parseInt(rentMonthsInp.value) || 18) : 18;
        var includeRentInp = document.getElementById('calcIncludeRent');
        var includeRent = includeRentInp ? includeRentInp.checked : true;

        var flatMonthlyRent = @(Model.RentAndRontgenPolicy.FlatMonthlyRent.ToString("0", System.Globalization.CultureInfo.InvariantCulture));
        var flatRelocFee = @(Model.RentAndRontgenPolicy.FlatRelocationFee.ToString("0", System.Globalization.CultureInfo.InvariantCulture));
        var shopMonthlyRent = @(Model.RentAndRontgenPolicy.ShopMonthlyRent.ToString("0", System.Globalization.CultureInfo.InvariantCulture));
        var shopRelocFee = @(Model.RentAndRontgenPolicy.ShopRelocationFee.ToString("0", System.Globalization.CultureInfo.InvariantCulture));

        var totalRentAndRelocBurden = (oldOwners * ((flatMonthlyRent * rentMonths) + flatRelocFee)) + (oldShops * ((shopMonthlyRent * rentMonths) + shopRelocFee));
        var elRentRelocText = document.getElementById('resRentRelocationTotalText');
        if (elRentRelocText) {
            elRentRelocText.innerText = (includeRent ? '+' : '(Hariç) ') + totalRentAndRelocBurden.toLocaleString('tr-TR') + ' ₺';
        }

        // Zemin ve çatı dahil toplam kat hacmi (Maliyet hesabı için)
        var totalCostFloors = floors + basementFloors + 1 + 1; // +1 Zemin + 1 Çatı
        var noteCostFloors = document.getElementById('resTotalFloorsWithZeminCati');
        if (noteCostFloors) {
            noteCostFloors.innerHTML = 'Zemin ve çatı dahil edilince <b>' + totalCostFloors + ' kat</b> olur maliyet birim hesabı için';
        }

        // Toplam Üretilen Daire = Kat x Kata Düşen Daire
        var totalUnits = floors * unitsPerFloor;

        // Maliklere Verilecek Daire
        var ownerGivenUnits = Math.round(totalUnits * (ownerSharePercent / 100.0));

        // Müteahhide Kalan Daire ve Dükkan
        var contractorKeptUnits = totalUnits - ownerGivenUnits;
        var contractorKeptShops = Math.max(0, plannedNewShops - ownerGivenShops);

        // Müteahhit Satış Cirosu (Daire + Kalan Dükkanlar)
        var totalRevenue = (contractorKeptUnits * flatSalePrice) + (contractorKeptShops * shopSalePrice);

        // Kat alanı ~271 m², merdiven, yangın merdiveni ve asansör çekirdeği düşüldüğünde net daire alanı:
        var grossFloorArea = 271;
        var usableFloorArea = Math.max(0, grossFloorArea - coreLoss);
        var unitSqm = unitsPerFloor > 0 ? Math.round(usableFloorArea / unitsPerFloor) : 0;

        var elUnitSqm = document.getElementById('resUnitAvgSqm');
        if (elUnitSqm) elUnitSqm.innerText = '~' + unitSqm + ' m² / Daire';

        var elArchType = document.getElementById('resUnitArchitecturalType');
        var elHint = document.getElementById('resUnitFeasibilityHint');

        if (elArchType && elHint) {
            if (unitSqm >= 100) {
                elArchType.className = 'd-block fw-bold text-success';
                elArchType.innerText = 'Ferah 3+1';
                elHint.className = 'text-success text-center d-block fw-semibold';
                elHint.innerText = 'Tabana rahat sığar';
            } else if (unitSqm >= 65) {
                elArchType.className = 'd-block fw-bold text-warning';
                elArchType.innerText = 'Kompakt 2+1';
                elHint.className = 'text-danger text-center d-block fw-semibold';
                elHint.innerText = unitsPerFloor >= 3 ? '3 daire zorlayabilir' : 'Kompakt plan';
            } else {
                elArchType.className = 'd-block fw-bold text-danger';
                elArchType.innerText = 'Stüdyo / 1+1';
                elHint.className = 'text-danger text-center d-block fw-semibold';
                elHint.innerText = 'Çok sıkışık plan';
            }
        }

        // Satış Fiyatı Kutusu Altındaki m² Rayici ve Daire Tipi Notu
        var elPriceNote = document.getElementById('resFlatPriceTypeNote');
        var elPriceBadge = document.getElementById('resPriceSqmRayicBadge');
        var unitPricePerSqm = unitSqm > 0 ? Math.round(flatSalePrice / unitSqm) : 0;
        if (elPriceBadge) {
            elPriceBadge.innerText = '~' + unitPricePerSqm.toLocaleString('tr-TR') + ' ₺/m² Rayiç';
        }
        if (elPriceNote) {
            if (unitSqm >= 100) {
                elPriceNote.innerText = '3+1 Sıfır Daire Rayici';
            } else if (unitSqm >= 65) {
                elPriceNote.innerText = '2+1 Sıfır Daire Rayici';
            } else {
                elPriceNote.innerText = 'Stüdyo / 1+1 Daire Rayici';
            }
        }

        // Malik Başına Düşen
        var perHead = oldOwners > 0 ? (ownerGivenUnits / oldOwners).toFixed(1) : 0;

        // DOM Güncellemeleri
        var elTotal = document.getElementById('resTotalBuildingUnits');
        if (elTotal) elTotal.innerText = totalUnits;

        var elTarget = document.getElementById('hiddenTargetUnits');
        if (elTarget) elTarget.value = totalUnits;

        var elFloorsDetail = document.getElementById('resFloorsDetailText');
        if (elFloorsDetail) {
            elFloorsDetail.innerText = floors + ' Kat × ' + unitsPerFloor + ' Daire' + (plannedNewShops > 0 ? (' + ' + plannedNewShops + ' Dükkan') : '');
        }

        var elOwnerUnits = document.getElementById('resOwnerGivenUnits');
        if (elOwnerUnits) elOwnerUnits.innerText = ownerGivenUnits;

        var elPerHead = document.getElementById('resOwnerPerHeadNote');
        if (elPerHead) {
            elPerHead.innerText = '(' + oldOwners + ' Malike ~' + perHead + ' Daire' + (ownerGivenShops > 0 ? (' + ' + ownerGivenShops + ' Dükkan') : '') + ')';
        }

        var elContractor = document.getElementById('resContractorKeptUnits');
        if (elContractor) {
            elContractor.innerText = contractorKeptUnits + ' DAİRE' + (contractorKeptShops > 0 ? (' + ' + contractorKeptShops + ' DÜKKAN') : '');
        }

        var contractorSharePercent = 100 - ownerSharePercent;
        var elContractorShare = document.getElementById('resContractorShareText');
        if (elContractorShare) elContractorShare.innerText = '(Toplamın %' + contractorSharePercent + "\'si)";

        var elRevenue = document.getElementById('resContractorTotalRevenue');
        if (elRevenue) elRevenue.innerText = totalRevenue.toLocaleString('tr-TR') + ' ₺';

        var elRevCalc = document.getElementById('resRevenueCalcDetail');
        if (elRevCalc) {
            elRevCalc.innerText = contractorKeptUnits + ' Daire × ' + flatSalePrice.toLocaleString('tr-TR') + ' ₺' + (contractorKeptShops > 0 ? (' + ' + contractorKeptShops + ' Dükkan') : '');
        }

        // Toplam İnşaat Alanı (m²) = Toplam Kat Hacmi x Kat Oturumu (271 m²)
        var totalConstSqm = totalCostFloors * 271;
        var elConstSqm = document.getElementById('resTotalConstSqm');
        if (elConstSqm) elConstSqm.innerText = totalConstSqm.toLocaleString('tr-TR') + ' m²';

        var elConstCalc = document.getElementById('resConstCalcDetail');
        if (elConstCalc) elConstCalc.innerText = totalCostFloors + ' Kat × 271 m² (Zemin, Çatı, Bodrum Dahil)';

        // Firma Şantiye Maliyeti = (Toplam m² x Firma Birim Maliyeti) + (Varsa Kira & Taşınma Yükü)
        var effFirmUnit = firmUnitCost > 0 ? firmUnitCost : 25000;
        var constructionCostOnly = totalConstSqm * effFirmUnit;
        var totalCost = constructionCostOnly + (includeRent ? totalRentAndRelocBurden : 0);

        // Net Proje Kârı = Ciro - Maliyet
        var netProfit = totalRevenue - totalCost;

        var elFormRev = document.getElementById('resFormulaRevenue');
        if (elFormRev) elFormRev.innerText = totalRevenue.toLocaleString('tr-TR') + ' TL (Ciro)';

        var elFormCost = document.getElementById('resFormulaCost');
        if (elFormCost) {
            elFormCost.innerText = totalCost.toLocaleString('tr-TR') + ' TL (' + (includeRent ? 'İnşaat + Kira/Taşınma Maliyeti' : 'İnşaat Maliyeti') + ')';
        }

        var elFormProfit = document.getElementById('resFormulaProfit');
        var elProfitBadge = document.getElementById('resNetProfitBadge');
        if (elFormProfit) {
            if (netProfit >= 0) {
                elFormProfit.className = 'text-success fs-6 fw-extrabold';
                elFormProfit.innerText = netProfit.toLocaleString('tr-TR') + ' TL';
                if (elProfitBadge) {
                    elProfitBadge.className = 'badge bg-success text-white px-3 py-2 fw-bold';
                    elProfitBadge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>KÂRLI PROJE';
                }
            } else {
                elFormProfit.className = 'text-danger fs-6 fw-extrabold';
                elFormProfit.innerText = netProfit.toLocaleString('tr-TR') + ' TL (ZARAR)';
                if (elProfitBadge) {
                    elProfitBadge.className = 'badge bg-danger text-white px-3 py-2 fw-bold';
                    elProfitBadge.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>ZARAR RİSKİ';
                }
            }
        }

        // Canlı Karar Yorumu
        var noteEl = document.getElementById('resQuickScenarioNote');
        if (noteEl) {
            if (contractorKeptUnits > 0 && ownerGivenUnits >= oldOwners) {
                noteEl.innerHTML = '<b>Ön Karar Notu:</b> ' + floors + ' katta ' + unitsPerFloor + "\'şer daireden <b>" + totalUnits + ' daire' + (plannedNewShops > 0 ? (' + ' + plannedNewShops + ' dükkan') : '') + '</b> üretilir. %' + ownerSharePercent + ' payla maliklere ' + ownerGivenUnits + ' daire' + (ownerGivenShops > 0 ? (' + ' + ownerGivenShops + ' dükkan') : '') + ' verilir; <b>müteahhide ' + contractorKeptUnits + ' daire' + (contractorKeptShops > 0 ? (' + ' + contractorKeptShops + ' dükkan') : '') + ' (' + totalRevenue.toLocaleString('tr-TR') + ' ₺ ciro)</b> kalır.';
            } else if (ownerGivenUnits < oldOwners) {
                noteEl.innerHTML = '<span class="text-danger"><b>Kritik Emsal Uyarısı:</b></span> Maliklere verilen ' + ownerGivenUnits + ' daire, mevcut ' + oldOwners + ' malikin hak edişini karşılamıyor. Kat sayısını artırın veya malik payını yükseltin.';
            } else {
                noteEl.innerHTML = '<b>Senaryo:</b> Değerleri girdiğinizde müteahhit ve malik terazi dağılımı burada anlık hesaplanacaktır.';
            }
        }

        if (isUserAction) {
            triggerSimAutosave();
        }
    }

    function triggerSimAutosave() {
        if (simAutosaveTimer) clearTimeout(simAutosaveTimer);
        simAutosaveTimer = setTimeout(function () {
            saveQuickContractorPlan(true);
        }, 1200);
    }

    function saveQuickContractorPlan(isAuto) {
        var form = document.getElementById('simForm');
        var formData = new FormData(form);
        var firmUnitInp = document.getElementById('calcFirmUnitCost');
        if (firmUnitInp) formData.set('firmUnitCostPerSqm', firmUnitInp.value);
        var incRentInp = document.getElementById('calcIncludeRent');
        if (incRentInp) formData.set('includeRentInFeasibility', incRentInp.checked ? 'true' : 'false');

        var statusEl = document.getElementById('simAutosaveStatus');
        if (statusEl) statusEl.innerHTML = '<span class="badge bg-warning text-dark px-2 py-1 small"><i class="bi bi-arrow-repeat spin me-1"></i>Kaydediliyor...</span>';

        fetch('/ConstructionProject/UpdateAnalysisImar', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (statusEl) {
                statusEl.innerHTML = '<span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 small"><i class="bi bi-check2-circle me-1"></i>Ön Plan Projeye Kaydedildi</span>';
            }
            if (!isAuto) {
                alert('Tebrikler! Ön fizibilite ve teklif parametreleri başarıyla projeye kaydedildi.');
            }
        })
        .catch(function (err) {
            if (statusEl) statusEl.innerHTML = '<span class="badge bg-danger text-white px-2 py-1 small">Kayıt hatası</span>';
            if (!isAuto) alert('Plan kaydedilirken bir hata oluştu.');
        });
    }

    // ÇOKLU MODEL & SENARYO YÖNETİMİ (TARAYICI KALICI HAFIZASI & KARŞILAŞTIRMA)
    var STORAGE_KEY_SCENARIOS = 'gmk360_scenarios_@Model.Id';
    var savedScenarios = [];

    function loadScenariosFromStorage() {
        try {
            var raw = localStorage.getItem(STORAGE_KEY_SCENARIOS);
            if (raw) {
                var parsed = JSON.parse(raw);
                if (Array.isArray(parsed)) {
                    savedScenarios = parsed;
                }
            }
        } catch (e) {
            console.warn('Scenarios storage read error:', e);
        }
        renderScenarioTray();
    }

    function saveScenariosToStorage() {
        try {
            localStorage.setItem(STORAGE_KEY_SCENARIOS, JSON.stringify(savedScenarios));
        } catch (e) {
            console.warn('Scenarios storage write error:', e);
        }
    }

    function addCurrentScenarioToComparison() {
        var floors = parseInt(document.getElementById('calcTotalFloors').value) || 15;
        var unitsPerFloor = parseInt(document.getElementById('calcUnitsPerFloor').value) || 2;
        var ownerSharePercent = parseFloat(document.getElementById('calcOwnerShare').value) || 50;
        var flatSalePrice = parseFloat(document.getElementById('calcFlatSalePrice').value) || 10000000;
        var firmUnitCost = parseFloat(document.getElementById('calcFirmUnitCost').value) || 25000;
        var basementInp = document.getElementById('calcBasementFloors');
        var basementFloors = basementInp ? (parseInt(basementInp.value) || 2) : 2;
        var coreLossInp = document.getElementById('calcCoreLossSqm');
        var coreLoss = coreLossInp ? (parseFloat(coreLossInp.value) || 35) : 35;

        var totalCostFloors = floors + basementFloors + 2;
        var totalUnits = floors * unitsPerFloor;
        var ownerUnits = Math.round(totalUnits * (ownerSharePercent / 100.0));
        var contractorUnits = totalUnits - ownerUnits;
        var totalRevenue = contractorUnits * flatSalePrice;
        var totalConstSqm = totalCostFloors * 271;
        var totalCost = totalConstSqm * firmUnitCost;
        var netProfit = totalRevenue - totalCost;

        var grossFloorArea = 271;
        var usableFloorArea = Math.max(0, grossFloorArea - coreLoss);
        var unitSqm = unitsPerFloor > 0 ? Math.round(usableFloorArea / unitsPerFloor) : 0;
        var unitType = unitSqm >= 100 ? 'Ferah 3+1' : (unitSqm >= 65 ? 'Kompakt 2+1' : '1+1');

        var modelLetter = String.fromCharCode(65 + savedScenarios.length);
        var modelTitle = 'Model ' + modelLetter + ' (' + unitsPerFloor + ' Daire - ' + unitType + ')';

        savedScenarios.push({
            title: modelTitle,
            floors: floors,
            unitsPerFloor: unitsPerFloor,
            totalUnits: totalUnits,
            ownerUnits: ownerUnits,
            contractorUnits: contractorUnits,
            ownerSharePercent: ownerSharePercent,
            unitSqm: unitSqm,
            unitType: unitType,
            unitPrice: flatSalePrice,
            totalRevenue: totalRevenue,
            totalConstSqm: totalConstSqm,
            firmCost: totalCost,
            netProfit: netProfit
        });

        saveScenariosToStorage();
        renderScenarioTray();
    }

    function renderScenarioTray() {
        var container = document.getElementById('scenarioBadgesList');
        var clearBtn = document.getElementById('btnClearScenarios');
        var showBtn = document.getElementById('btnShowScenarios');
        var countBadge = document.getElementById('modalScenarioCountBadge');
        var pdfBtnText = document.getElementById('btnDownloadPdfText');

        if (!container) return;

        if (savedScenarios.length === 0) {
            if (clearBtn) clearBtn.style.display = 'none';
            if (showBtn) showBtn.style.display = 'none';
            if (pdfBtnText) pdfBtnText.innerText = 'Ön Teklif & Fizibilite Raporu (PDF)';
            container.innerHTML = '<span class="text-muted small italic" id="emptyScenarioText">Henüz karşılaştırma modeli eklenmedi. Farklı daire veya paylaşım oranları deneyip <b>"+ Model"</b> butonuna basarak kaydedebilirsiniz.</span>';
