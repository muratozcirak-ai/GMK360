@model IEnumerable<GMK360.Core.Entities.Construction.Workflows.CompanyEquipment>
@{
    ViewData["Title"] = "Makine Parkı & Kiralık Araçlar";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
    var logs = ViewData["Logs"] as IEnumerable<GMK360.Core.Entities.Construction.Workflows.EquipmentUsageLog>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="fas fa-truck-monster text-warning me-2"></i>Makine Parkı ve Kiralık Araç Tahsisi</h3>
            <p class="text-muted small mt-1 mb-0">Şantiye için araç kiralama, günlük/saatlik süreler ve maliyetlerin gerçek zamanlı veritabanı kaydı.</p>
        </div>
        <button class="btn btn-warning fw-bold text-dark rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#newLogModal"><i class="fas fa-plus me-1"></i> Yeni Vinç/Araç Çağır</button>
    </div>

    <!-- GERÇEK KİRALAMA GEÇMİŞİ -->
    <div class="card shadow-sm border-0 rounded-4 mb-5">
        <div class="card-header bg-dark text-white p-3 border-0">
            <h5 class="mb-0 fw-bold"><i class="fas fa-clipboard-list me-2"></i>Şantiyenin Aktif Kiralama Kayıtları</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Araç</th>
                            <th>Kiralama Tipi</th>
                            <th>Başlangıç</th>
                            <th>Süre</th>
                            <th>Toplam Maliyet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(logs == null || !logs.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">Bu şantiye için henüz kiralık araç kaydı girilmemiştir.</td>
                            </tr>
                        }
                        else
                        {
                            foreach(var log in logs)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@log.CompanyEquipment?.EquipmentName</td>
                                    <td><span class="badge bg-secondary">@log.UsageType</span></td>
                                    <td>@log.StartDate.ToString("dd.MM.yyyy") @(log.StartTime.HasValue ? log.StartTime.Value.ToString(@"hh\:mm") : "")</td>
                                    <td>@log.Duration birim</td>
                                    <td><span class="fw-bold text-danger">@log.TotalCost.ToString("C2")</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- SEED DATA ARAÇ LİSTESİ -->
    <h5 class="fw-bold text-dark mb-3">Sistemde Kayıtlı Olan Özmal ve Kiralık Araç Tipleri</h5>
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Araç Kodu & Adı</th>
                            <th>Türü</th>
                            <th>Birim Maliyeti</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var eq in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded p-2 me-3">
                                            <i class="fas fa-truck text-secondary fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0">@eq.EquipmentName</h6>
                                            <span class="small text-muted">@eq.EquipmentCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if(eq.OwnershipType == "Özmal" || eq.OwnershipType == "Ozmal")
                                    {
                                        <span class="badge bg-success">Özmal (Şirket)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Kiralık (Dışarıdan)</span>
                                    }
                                </td>
                                <td><span class="fw-bold text-dark">@eq.UnitCost.ToString("C2")</span> <span class="text-muted small">/ @eq.PricingUnit</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newLogModal" tabindex="-1" aria-labelledby="newLogModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header bg-warning text-dark border-0">
        <h5 class="modal-title fw-bold" id="newLogModalLabel"><i class="fas fa-calendar-plus me-2"></i>Araç/Vinç Kiralama Kaydı Ekle</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/ConstructionProject/AddEquipmentLog" method="post">
          <input type="hidden" name="projectId" value="@ViewData["ProjectId"]" />
          <div class="modal-body p-4 bg-light">
                <div class="mb-3">
                    <label class="form-label fw-bold">Araç Seçimi (Veritabanından)</label>
                    <select class="form-select" name="equipmentId" required>
                        <option value="">Lütfen araç seçin...</option>
                        @foreach(var eq in Model)
                        {
                            <option value="@eq.Id">@eq.EquipmentName (@eq.UnitCost ₺ / @eq.PricingUnit)</option>
                        }
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Kullanım Tipi</label>
                        <select class="form-select" name="usageType" required>
                            <option value="Saatlik">Saatlik Kiralama</option>
                            <option value="Günlük">Günlük Kiralama</option>
                            <option value="Aylık">Aylık Kiralama (Kule Vinç vs.)</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Süre (Kaç Birim?)</label>
                        <input type="number" class="form-control" name="duration" required min="1" placeholder="Örn: 5 (saat/gün)" />
                    </div>
                </div>
                <div class="row border-top pt-3 mt-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" name="startDate" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Bitiş Tarihi (Opsiyonel)</label>
                        <input type="date" class="form-control" name="endDate" />
                    </div>
                </div>
                <div class="row border-top pt-3 mt-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Başlama Saati (Opsiyonel)</label>
                        <input type="time" class="form-control" name="startTime" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Bitiş Saati (Opsiyonel)</label>
                        <input type="time" class="form-control" name="endTime" />
                    </div>
                </div>
          </div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="btn btn-success fw-bold rounded-pill px-4"><i class="fas fa-save me-2"></i>Veritabanına Kaydet ve Bedeli Hesapla</button>
          </div>
      </form>
    </div>
  </div>
</div>
