@model GMK360.Core.Entities.BuildingUnit
@{
    ViewData["Title"] = "Mahal ve Demirbaş Yönetimi";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    bool isCommonArea = Model.Category == "OrtakAlan_Blok" || Model.Category == "OrtakAlan";
    bool isStorage = Model.Category == "Eklenti" || Model.Category == "Depo";
    string unitTitle = isCommonArea 
        ? $"Bina Ortak Alanı - {Model.RoomLayout ?? Model.DoorNumber}" 
        : (isStorage 
            ? $"Depo / Eklenti - No {Model.DoorNumber}" 
            : $"Kat {Model.FloorLevel} - No {Model.DoorNumber}");
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="ManageBlock" asp-route-id="@Model.BuildingId" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1">
                    <i class="bi bi-arrow-left me-1"></i> Yapı Yönetimine Dön
                </a>
                <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-door-open-fill text-primary me-2"></i>@unitTitle</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">@(Model.RoomLayout ?? "Mesken")</span>
                @if (Model.GrossSquareMeters.HasValue && Model.GrossSquareMeters > 0)
                {
                    <span class="badge bg-light text-dark border fs-6">@Model.GrossSquareMeters m² Brüt @(Model.NetSquareMeters.HasValue ? $"({Model.NetSquareMeters} m² Net)" : "")</span>
                }
            </div>
            <div class="text-muted small">
                <i class="bi bi-building me-1"></i>@Model.Building.ConstructionProject.Name &bull; @Model.Building.BlockName &bull; <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.OwnerName) ? "Müteahhit Payı (Satılık)" : $"Hak Sahibi: {Model.OwnerName}")</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="PopulateDefaultUnitSpaces" method="post" class="d-inline" onsubmit="return confirm('Tip plan standardına göre mahaller ve metrajlar yeniden dağıtılacak. Devam edilsin mi?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="unitId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary rounded-pill px-3 shadow-sm fw-bold" title="Tip plan standardına göre (3+1, 2+1, Dükkan) iç oda ve metrajları otomatik doldurur">
                    <i class="bi bi-magic me-1"></i> Tip Plandan Dağıt
                </button>
            </form>
            <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#cloneUnitModal">
                <i class="bi bi-copy me-1"></i> @(isCommonArea ? "Bu Ortak Alanı Çoğalt" : "Bu Daireyi Diğer Dairelere Klonla")
            </button>
        </div>
    </div>

    <div class="row">
        <!-- Left Panel: Space List -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">@(isCommonArea ? "Tesis / Ortak Alan Bölümleri" : "İç Mahaller (Odalar)")</h6>
                    <button class="btn btn-sm btn-success rounded-pill" data-bs-toggle="modal" data-bs-target="#addSpaceModal">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (!Model.Spaces.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2 text-primary"></i>
                            <div class="fw-bold text-dark mb-1">Henüz mahal eklenmemiş.</div>
                            <p class="text-muted small mb-3">Bu daireye ait oda ve metrajları tek tek elle girebilir veya tip plandan tek tıkla yükleyebilirsiniz.</p>
                            <form asp-action="PopulateDefaultUnitSpaces" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="unitId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold">
                                    <i class="bi bi-magic me-1"></i> Tip Plandan Mahalleleri & Metrajları Doldur
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var space in Model.Spaces)
                            {
                                <div id="space-btn-@space.Id" class="list-group-item border-0 rounded mb-2 p-3 bg-light shadow-sm">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fw-bold fs-6 text-dark cursor-pointer" onclick="loadSpace(@space.Id, '@space.Name', '@space.Type')">@space.Name</div>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="deleteUnitSpace(@space.Id); event.stopPropagation();" title="Mahali Sil"><i class="bi bi-trash fs-5"></i></button>
                                    </div>
                                    <div class="small text-muted d-flex gap-3">
                                        <span class="cursor-pointer text-decoration-underline" onclick="loadSpace(@space.Id, '@space.Name', '@space.Type', 'fixtures')">
                                            <i class="bi bi-box me-1"></i>@space.Fixtures.Count Ürün
                                        </span>
                                        <span class="cursor-pointer text-decoration-underline" onclick="loadSpace(@space.Id, '@space.Name', '@space.Type', 'measurements')">
                                            <i class="bi bi-rulers me-1"></i>@space.Measurements.Count Ölçü
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        
        <!-- Right Panel: Space Details (Fixtures & Measurements) -->
        <div class="col-md-9">
            <div class="card border-0 shadow-sm rounded-4 h-100" id="rightPanel">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-muted" id="rightPanelEmpty">
                    <i class="bi bi-arrow-left-circle fs-1 mb-3 text-light"></i>
                    <h5>Soldan bir mahal seçin</h5>
                    <p class="small">Veya sol üstteki + butonundan yeni bir mahal ekleyin (Örn: Salon, Şaft, Banyo)</p>
                </div>
                <div class="card-body d-none" id="rightPanelContent">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold mb-0 text-dark"><span id="spaceTitle">Oda Adı</span></h4>
                            <span id="viewTitle" class="badge bg-light text-primary border"></span>
                        </div>
                        <div class="btn-group btn-group-sm rounded-pill shadow-sm" role="group">
                            <button type="button" class="btn btn-primary" id="btnTabMeasurements" onclick="switchView('measurements')">
                                <i class="bi bi-rulers me-1"></i> Ölçüler & Metraj
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="btnTabFixtures" onclick="switchView('fixtures')">
                                <i class="bi bi-box me-1"></i> Ürünler & Demirbaşlar
                            </button>
                        </div>
                    </div>
                    
                    <div id="fixturesView" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <div id="commonAreaTemplatesGroup" style="display:none;">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-info dropdown-toggle rounded-pill px-3 fw-bold shadow-sm" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-magic me-1"></i> Hazır Donanım / Tesisat Şablonu Yükle
                                    </button>
                                    <ul class="dropdown-menu shadow rounded-3 border-0">
                                        <li><h6 class="dropdown-header">Bina & Tesis Donanım Şablonları</h6></li>
                                        <li><a class="dropdown-item cursor-pointer" onclick="applyCommonFixturesTemplate('Su Deposu')"><i class="bi bi-droplet-fill text-primary me-2"></i>Su Deposu & Hidrofor Donanımı</a></li>
                                        <li><a class="dropdown-item cursor-pointer" onclick="applyCommonFixturesTemplate('Sığınak')"><i class="bi bi-shield-shaded text-danger me-2"></i>Sığınak Havalandırma & Güvenlik Donanımı</a></li>
                                        <li><a class="dropdown-item cursor-pointer" onclick="applyCommonFixturesTemplate('Jeneratör')"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Jeneratör Grubu & ATS Transfer Panosu</a></li>
                                        <li><a class="dropdown-item cursor-pointer" onclick="applyCommonFixturesTemplate('Kazan Dairesi')"><i class="bi bi-fire text-danger me-2"></i>Kazan Dairesi & Sirkülasyon Pompaları</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="ms-auto">
                                <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="openAddFixtureModal()">
                                    <i class="bi bi-plus-lg me-1"></i> Yeni Ürün Ekle
                                </button>
                            </div>
                        </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Ürün / Demirbaş & Marka</th>
                                    <th>Kategori</th>
                                    <th>Adet / Ölçü</th>
                                    <th>Malzeme / Renk Opsiyonları</th>
                                    <th>Tedarikçi / Servis / Garanti</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody id="fixturesTableBody">
                                <!-- Fixtures will be loaded here -->
                            </tbody>
                        </table>
                    </div>

                    </div> <!-- end fixturesView -->
                    
                    <div id="measurementsView" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0 text-dark">Ölçüler ve Metraj (Zemin, Duvar vs.)</h5>
                        <div>
                            <button class="btn btn-sm btn-outline-success rounded-pill px-3 me-2" onclick="cleanEmptyMeasurements()">
                                <i class="bi bi-check2-all me-1"></i> Bitti (Sıfırları Sil)
                            </button>
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openAddMeasurementModal()">
                                <i class="bi bi-rulers me-1"></i> Yeni Ölçü Ekle
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Kategori</th>
                                    <th>Açıklama (Örn: Duvar Alanı)</th>
                                    <th>En x Boy</th>
                                    <th>Miktar / Ölçü</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody id="measurementsTableBody">
                                <!-- Measurements will be loaded here -->
                            </tbody>
                        </table>
                    </div>

                </div>
                    </div> <!-- end measurementsView -->
            </div>
        </div>

    </div>
</div>

<!-- Add Space Modal -->
<div class="modal fade" id="addSpaceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="AddUnitSpace" method="post">
                <input type="hidden" name="unitId" value="@Model.Id" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Yeni Mahal Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mahal Adı</label>
                        <input type="text" name="spaceName" class="form-control" placeholder="Örn: Ebeveyn Banyosu, Ana Şaft" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Türü (Grup)</label>
                        <select name="spaceType" class="form-select">
                            <option value="Oda">Oda / Yaşam Alanı</option>
                            <option value="Islak Hacim">Islak Hacim (Banyo/WC)</option>
                            <option value="Mutfak">Mutfak</option>
                            <option value="Balkon">Balkon / Teras</option>
                            <option value="Tesisat">Tesisat / Mekanik Şaft / Pano</option>
                            <option value="Depo">Depo / Ardiye / Stok Bölümü</option>
                            <option value="OrtakAlan">Bina Ortak Alanı (Su Deposu, Sığınak, Jeneratör)</option>
                            <option value="Dolaşım">Hol / Koridor / Merdiven</option>
                            <option value="Diğer">Diğer</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Add Measurement Modal -->
<div class="modal fade" id="addMeasurementModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <form id="addMeasurementForm" onsubmit="submitMeasurementForm(event)">
                <input type="hidden" name="spaceId" id="measurementSpaceId" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Yeni Ölçü / Metraj Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Kategori</label>
                            <select name="category" class="form-select" required>
                                <option value="Zemin">Zemin Alanı</option>
                                <option value="Duvar">Duvar Alanı</option>
                                <option value="Tavan">Tavan Alanı</option>
                                <option value="Süpürgelik">Süpürgelik (Çevre Uzunluğu)</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Açıklama</label>
                        <input type="text" name="description" class="form-control" placeholder="İsteğe bağlı (Boş bırakabilirsiniz)..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Miktar ve Birim</label>
                        <div class="input-group">
                            <input type="number" step="0.01" name="quantity" class="form-control" placeholder="Örn: 15.5" required />
                            <select name="unit" class="form-select" style="max-width:100px;">
                                <option value="m2">m² (Metrekare)</option>
                                <option value="mt">mt (Metretül)</option>
                                <option value="m3">m³ (Metreküp)</option>
                                <option value="Adet">Adet</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Smart Template Modal -->
<div class="modal fade" id="smartTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="SaveSmartTemplate" method="post">
                <input type="hidden" name="SpaceId" id="templateSpaceId" />
                
                <div class="modal-header border-0 pb-0 bg-warning bg-opacity-10 rounded-top-4">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-magic text-warning me-2"></i>Akıllı Şablon Veri Girişi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-light">
                    <p class="small text-muted mb-4">Aşağıdaki alanlar bu odanın türüne (<span id="templateSpaceType" class="fw-bold"></span>) göre özel olarak getirilmiştir. Değerini 0 bıraktığınız alanlar kaydedilmez.</p>
                    
                    <div id="smartTemplateFields">
                        <div class="text-center py-4"><div class="spinner-border text-warning" role="status"></div></div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">Toplu Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Fixture Modal -->
<div class="modal fade" id="addFixtureModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="AddSpaceFixture" method="post">
                <input type="hidden" name="spaceId" id="fixtureSpaceId" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Yeni Ürün / Demirbaş Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Ürün Adı (Serbest Metin)</label>
                            <input type="text" name="itemName" class="form-control" placeholder="Örn: Lavabo Bataryası, Mutfak Dolabı, Kombi" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Kategori</label>
                            <select name="category" class="form-select">
                                <option value="Vitrifiye">Vitrifiye / Banyo</option>
                                <option value="Zemin">Zemin & Parke</option>
                                <option value="Doğrama">Kapı & Doğrama</option>
                                <option value="Mobilya">Mobilya & Dolap</option>
                                <option value="Beyaz Eşya">Beyaz Eşya / Ankastre</option>
                                <option value="Tesisat">Mekanik / Tesisat</option>
                                <option value="Elektrik">Elektrik / Elektronik</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Standart Marka</label>
                            <input type="text" name="standardBrand" class="form-control" placeholder="Örn: Grohe, VitrA, E.C.A., Vaillant" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Standart Model / Seri</label>
                            <input type="text" name="standardModel" class="form-control" placeholder="Örn: Eurosmart Cosmopolitan, ecoTEC Plus" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Miktar</label>
                            <div class="input-group">
                                <input type="number" step="0.01" name="quantity" class="form-control" value="1" required />
                                <select name="unit" class="form-select" style="max-width:100px;">
                                    <option value="Adet">Adet</option>
                                    <option value="m2">m²</option>
                                    <option value="Set">Set</option>
                                    <option value="mt">mt</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Tahmini Birim Fiyat (TL)</label>
                            <input type="number" step="0.01" name="estimatedPrice" class="form-control" placeholder="Örn: 2450.00" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold small">Şantiye Deposu / Stok Konumu & İmalat Açıklaması <span class="text-muted fw-normal">(Ustanın veya mal kabulün kolay bulması için)</span></label>
                            <textarea name="maintenanceNotes" class="form-control" rows="2" placeholder="Örn: Zemin kat sol köşe, Ana Depo Raf 2B, Kilitli şantiye odası"></textarea>
                        </div>
                        <div class="col-12 mb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isCustomizable" name="isCustomizable" value="true" checked>
                                <label class="form-check-label fw-bold" for="isCustomizable">Müşteri Değiştirebilir (Opsiyonel)</label>
                                <div class="small text-muted">Dış cephe doğraması gibi bina bütünlüğünü etkileyen demirbaşlar için bu tiki kaldırın.</div>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <hr />
                            <h6 class="fw-bold text-primary"><i class="bi bi-briefcase me-2"></i>CRM ve Ağ Bağlantıları</h6>
                            <p class="small text-muted mb-3">İleride bu kısımlar sistemdeki kayıtlı firmalardan (ServiceProvider) otomatik arama yapacaktır. Şimdilik serbest metin olarak ekleyebilirsiniz, numara veya firma adı yazın. Olmayan firmalar "Gölge Kullanıcı" olarak kaydedilecektir.</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Tedarikçi / Satıcı Firma</label>
                            <input type="text" name="supplierName" class="form-control" placeholder="Firma Adı veya Telefon" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Teknik Servis</label>
                            <input type="text" name="technicalServiceName" class="form-control" placeholder="Servis Adı veya Telefon" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small"><i class="bi bi-shield-check text-success me-1"></i>Garanti Bitiş Tarihi</label>
                            <input type="date" name="warrantyExpiryDate" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small"><i class="bi bi-calendar-event text-warning me-1"></i>Periyodik Bakım / Servis Tarihi</label>
                            <input type="date" name="nextMaintenanceDate" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    var projectUnits = ViewBag.ProjectUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var totalSpacesCount = Model.Spaces?.Count ?? 0;
    var totalMeasurementsCount = Model.Spaces?.Sum(s => s.Measurements?.Count ?? 0) ?? 0;
    var totalFixturesCount = Model.Spaces?.Sum(s => s.Fixtures?.Count ?? 0) ?? 0;
}

<!-- Clone Unit Spaces Modal -->
<div class="modal fade" id="cloneUnitModal" tabindex="-1" aria-labelledby="cloneUnitModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0 py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="cloneUnitModalLabel">
                    <i class="bi bi-copy me-2"></i>Daireyi Klonla / Diğer Dairelere Çoğalt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Source Unit Summary Card -->
                <div class="card border-0 bg-primary bg-opacity-10 rounded-4 mb-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge bg-primary text-white px-3 py-1 rounded-pill mb-1">Kaynak Daire</span>
                                <h5 class="fw-bold text-dark mb-0">@Model.Building.BlockName - @unitTitle</h5>
                                <div class="text-muted small mt-1">
                                    <span class="me-3"><i class="bi bi-door-open me-1"></i>Tür: <strong>@(Model.RoomLayout ?? "Mesken")</strong></span>
                                    <span class="me-3"><i class="bi bi-compass me-1"></i>Cephe: <strong>@(Model.FacadeDirection ?? "-")</strong></span>
                                    @if(Model.GrossSquareMeters.HasValue && Model.GrossSquareMeters.Value > 0)
                                    {
                                        <span><i class="bi bi-rulers me-1"></i>Brüt: <strong>@Model.GrossSquareMeters m²</strong></span>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="d-flex gap-2">
                                    <span class="badge bg-white text-primary border shadow-sm px-3 py-2">
                                        <i class="bi bi-grid-fill me-1"></i>@totalSpacesCount Oda (Mahal)
                                    </span>
                                    <span class="badge bg-white text-success border shadow-sm px-3 py-2">
                                        <i class="bi bi-rulers me-1"></i>@totalMeasurementsCount Ölçü
                                    </span>
                                    <span class="badge bg-white text-info border shadow-sm px-3 py-2">
                                        <i class="bi bi-box me-1"></i>@totalFixturesCount Ürün/Demirbaş
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Overwrite Setting -->
                <div class="form-check form-switch mb-4 p-3 bg-light rounded-3 border">
                    <input class="form-check-input ms-0 me-3" type="checkbox" id="chkCloneOverwrite" checked style="width: 2.5em; height: 1.25em;">
                    <label class="form-check-label fw-bold text-dark" for="chkCloneOverwrite">
                        Hedef dairelerdeki mevcut mahallerin üzerine yaz (Sıfırla ve Birebir Kopyala)
                    </label>
                    <div class="text-muted small mt-1">
                        İşaretli kalırsa hedef dairedeki eski odalar silinip bu dairenin odaları, ölçüleri ve malzeme seçimleri birebir aktarılır.
                    </div>
                </div>

                <!-- Fast Filter Buttons -->
                <div class="d-flex flex-wrap gap-2 mb-3 align-items-center bg-light p-2 rounded-3 border">
                    <span class="small fw-bold text-muted me-1"><i class="bi bi-funnel me-1"></i>Hızlı Hedef Seçimi:</span>
                    @if (!string.IsNullOrEmpty(Model.FacadeDirection) && Model.FacadeDirection != "-")
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3 btn-clone-filter" data-filter="facade">
                            <i class="bi bi-compass me-1"></i>Aynı Cephedekiler (@Model.FacadeDirection)
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(Model.RoomLayout) && Model.RoomLayout != "-")
                    {
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill py-1 px-3 btn-clone-filter" data-filter="layout">
                            <i class="bi bi-door-open me-1"></i>Aynı Tiptekiler (@Model.RoomLayout)
                        </button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill py-1 px-3 btn-clone-filter" data-filter="sameblock">
                        <i class="bi bi-building me-1"></i>Bu Bloğun Tüm Daireleri
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-3 btn-clone-filter" data-filter="all">
                        <i class="bi bi-check-all me-1"></i>Tümünü Seç
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-1 px-3 btn-clone-filter" data-filter="clear">
                        <i class="bi bi-x-circle me-1"></i>Temizle
                    </button>
                </div>

                <!-- Target Units List -->
                <label class="form-label fw-bold text-dark small border-bottom w-100 pb-2 mb-3">
                    Hedef Daireleri Seçin (<span id="selectedCloneCount" class="text-primary fw-bold">0</span> daire seçildi)
                </label>
                <div class="row g-3" style="max-height: 380px; overflow-y: auto;">
                    @if (!projectUnits.Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-warning text-center">
                                Projede bu daire dışında başka bağımsız bölüm bulunamadı.
                            </div>
                        </div>
                    }
                    else
                    {
                        var groupedUnits = projectUnits.GroupBy(u => u.Building?.BlockName ?? "Ana Blok").OrderBy(g => g.Key);
                        foreach (var group in groupedUnits)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="card border bg-white shadow-sm h-100">
                                    <div class="card-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-building me-1"></i>@group.Key</h6>
                                        <div class="form-check m-0">
                                            <input class="form-check-input select-all-block-clone" type="checkbox" data-block-name="@group.Key" id="chk_block_@group.Key.Replace(" ", "")">
                                            <label class="form-check-label small fw-bold" for="chk_block_@group.Key.Replace(" ", "")">Tümü</label>
                                        </div>
                                    </div>
                                    <div class="card-body p-2 d-flex flex-column gap-1" style="max-height: 220px; overflow-y: auto;">
                                        @foreach (var tu in group.OrderByDescending(x => x.FloorLevel).ThenBy(x => x.DoorNumber))
                                        {
                                            string chkId = $"chk_clone_u_{tu.Id}";
                                            <div class="form-check d-flex align-items-center justify-content-between px-2 py-1 rounded hover-bg">
                                                <div>
                                                    <input class="form-check-input chk-clone-unit me-2" type="checkbox" value="@tu.Id" 
                                                           data-block="@tu.BuildingId" 
                                                           data-block-name="@group.Key"
                                                           data-facade="@tu.FacadeDirection" 
                                                           data-layout="@tu.RoomLayout" 
                                                           id="@chkId">
                                                    <label class="form-check-label small fw-bold" for="@chkId">
                                                        Kat @tu.FloorLevel - No: @tu.DoorNumber
                                                    </label>
                                                </div>
                                                <div class="d-flex gap-1 align-items-center">
                                                    @if(!string.IsNullOrEmpty(tu.RoomLayout) && tu.RoomLayout != "-")
                                                    {
                                                        <span class="badge bg-light text-dark border small">@tu.RoomLayout</span>
                                                    }
                                                    @if(!string.IsNullOrEmpty(tu.FacadeDirection) && tu.FacadeDirection != "-")
                                                    {
                                                        <span class="badge bg-light text-muted border small">@tu.FacadeDirection</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer border-top-0 bg-light rounded-bottom-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="btnSubmitCloneUnits">
                    <i class="bi bi-copy me-1"></i> Seçili Dairelere Klonla
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Manage Material Options Modal -->
<div class="modal fade" id="manageOptionsModal" tabindex="-1" aria-labelledby="manageOptionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-gradient text-white border-0 py-3 rounded-top-4" style="background: linear-gradient(135deg, #0d6efd, #0dcaf0);">
                <h5 class="modal-title fw-bold" id="manageOptionsModalLabel">
                    <i class="bi bi-palette me-2"></i>Malzeme & Renk Opsiyonları
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="optFixtureId" />
                
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div>
                        <span class="text-muted small">Seçili Demirbaş / Ürün:</span>
                        <h5 class="fw-bold text-dark mb-0" id="optFixtureTitle">Ürün Adı</h5>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill small">
                        <i class="bi bi-phone me-1"></i>SMS Doğrulama Desteği
                    </span>
                </div>

                <!-- Existing Options List -->
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-list-check text-primary me-1"></i>Tanımlı Seçenekler & Renkler</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-hover align-middle border rounded">
                        <thead class="table-light">
                            <tr>
                                <th>Görsel</th>
                                <th>Seçenek / Renk / Model</th>
                                <th>Fiyat Farkı</th>
                                <th>Durum</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="optionsTableBody">
                            <tr><td colspan="5" class="text-center text-muted py-3">Henüz opsiyon eklenmemiş.</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Add New Option Card -->
                <div class="card border rounded-3 bg-light shadow-sm mb-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle text-success me-1"></i>Yeni Seçenek / Renk Ekle</h6>
                        <form id="addOptionForm" enctype="multipart/form-data">
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold mb-1">Seçenek Adı</label>
                                    <input type="text" class="form-control form-control-sm" id="newOptName" placeholder="Örn: Masif Meşe, Mat Siyah, Granit" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Fiyat Farkı (TL) <span class="text-muted fw-normal">(Opsiyonel)</span></label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" id="newOptPriceDiff" placeholder="Talep gelince fiyatlandır">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-1">Renk / Doku Görseli</label>
                                    <input type="file" class="form-control form-control-sm" id="newOptImage" accept="image/*">
                                </div>
                                <div class="col-12 mt-2 d-flex justify-content-between align-items-center">
                                    <div class="form-check m-0">
                                        <input class="form-check-input" type="checkbox" id="newOptIsStandard">
                                        <label class="form-check-label small fw-bold text-dark" for="newOptIsStandard">
                                            Müteahhit Standart Seçeneği (Fiyat Farkı Yok)
                                        </label>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" id="btnSubmitNewOption">
                                        <i class="bi bi-plus-lg me-1"></i> Seçeneği Kaydet
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>Hatasız İmalat & SMS Güvencesi:</strong> Müşteri bu daireyi satın aldığında veya kiraladığında burada tanımlı seçeneklerden tercihini yapar. Seçim listesi alıcının telefonuna SMS OTP kodu ile onaylatılarak kayıt altına alınır; şantiyedeki usta doğrudan bu onaylı seçimi imal eder.
                </div>
            </div>
            <div class="modal-footer border-top-0 bg-light rounded-bottom-4 py-2">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSpaceId = 0;
        let currentSpaceName = '';
        let currentSpaceType = '';

        
        var currentView = 'measurements';

        function switchView(view) {
            currentView = view;
            if(currentView === 'fixtures') {
                $('#btnTabFixtures').addClass('active btn-primary').removeClass('btn-outline-primary');
                $('#btnTabMeasurements').removeClass('active btn-primary').addClass('btn-outline-primary');
                $('#viewTitle').html('<i class="bi bi-box"></i> Demirbaşlar');
                $('#fixturesView').show();
                $('#measurementsView').hide();
            } else {
                $('#btnTabMeasurements').addClass('active btn-primary').removeClass('btn-outline-primary');
                $('#btnTabFixtures').removeClass('active btn-primary').addClass('btn-outline-primary');
                $('#viewTitle').html('<i class="bi bi-rulers"></i> Ölçüler');
                $('#fixturesView').hide();
                $('#measurementsView').show();
            }
        }

        function applyCommonFixturesTemplate(templateType) {
            if (!currentSpaceId) {
                alert("Lütfen önce bir mahal seçin.");
                return;
            }
            if (!confirm(templateType + ' için önerilen donanım ve demirbaşlar bu mahale eklensin mi?')) return;

            $.post('/ConstructionProject/AddCommonFixturesTemplate', {
                spaceId: currentSpaceId,
                templateType: templateType,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }).done(function(res) {
                if (res.success) {
                    alert(res.count + ' adet donanım başarıyla yüklendi.');
                    loadSpace(currentSpaceId, currentSpaceName, currentSpaceType, 'fixtures');
                } else {
                    alert('Şablon yüklenirken bir sorun oluştu.');
                }
            }).fail(function() {
                alert('Sunucu hatası: Şablon yüklenemedi.');
            });
        }

        function showFixtureSpec(name, brand, model, qty, unit, loc, supplier, warranty, maintenance) {
            let msg = '📋 MALZEME VE İMALAT ŞARTNAMESİ / FİYAT TALEBİ\n\n' +
                      '• Ürün: ' + name + '\n' +
                      '• Standart Marka / Model: ' + (brand ? brand + ' ' + (model || '') : 'Standart Belirtilmedi') + '\n' +
                      '• Miktar: ' + qty + ' ' + unit + '\n' +
                      '• Şantiye Depo / İmalat Konumu: ' + (loc || 'Belirtilmedi') + '\n' +
                      '• Tercih Edilen Tedarikçi: ' + (supplier || 'Piyasa Araştırması Yapılacak (Fiyat Açık)') + '\n';
            if (warranty) msg += '• Garanti Bitiş Tarihi: ' + warranty + '\n';
            if (maintenance) msg += '• Periyodik Bakım / Servis: ' + maintenance + '\n';
            alert(msg);
        }

        function loadSpace(spaceId, spaceName, spaceType, view = null) {
            var isSameRoom = (currentSpaceId === spaceId);
            
            currentSpaceId = spaceId;
            currentSpaceName = spaceName;
            currentSpaceType = spaceType;
            
            $('#rightPanelEmpty').addClass('d-none');
            $('#rightPanelContent').removeClass('d-none');
            $('#spaceTitle').text(spaceName);

            // Show common area template loader if facility room or common area
            var sLower = (spaceName || '').toLowerCase();
            var isFacility = (spaceType === 'OrtakAlan' || spaceType === 'Tesisat' || spaceType === 'Depo' || 
                              sLower.indexOf('depo') !== -1 || sLower.indexOf('su') !== -1 || 
                              sLower.indexOf('sığınak') !== -1 || sLower.indexOf('siginak') !== -1 || 
                              sLower.indexOf('jeneratör') !== -1 || sLower.indexOf('jenerator') !== -1 || 
                              sLower.indexOf('kazan') !== -1 || @(isCommonArea ? "true" : "false"));
            if (isFacility) {
                $('#commonAreaTemplatesGroup').show();
            } else {
                $('#commonAreaTemplatesGroup').hide();
            }
            
            switchView(view ? view : 'measurements');
            
            if (isSameRoom && view != null) {
                // Sadece tab değiştir, veriyi tekrar çekme
                return;
            }
            
            // 1. Load Fixtures
            $('#fixturesTableBody').html('<tr><td colspan="6" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>');
            $.ajax({
                  url: '/ConstructionProject/GetSpaceFixtures',
                  type: 'GET',
                  dataType: 'json',
                  data: { spaceId: spaceId, t: new Date().getTime() },
                  cache: false
              })
              .done(function(data) {
                  try {
                      fixturesCount = data.length;
                      if(data.length === 0) {
                          $('#fixturesTableBody').html('<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Bu mahalde henüz ürün yok.</td></tr>');
                      } else {
                          let html = '';
                          data.forEach(function(f) {
                              let brandModel = '';
                              if(f.standardBrand || f.standardModel) {
                                  brandModel = `<div class="small text-muted"><i class="bi bi-tag-fill me-1 text-primary"></i>${f.standardBrand || ''} ${f.standardModel ? '- ' + f.standardModel : ''}</div>`;
                              }
                              let shelfCode = '';
                              if(f.maintenanceNotes) {
                                  shelfCode = `<div class="small text-secondary" title="Şantiye Depo / Raf"><i class="bi bi-geo-alt me-1 text-danger"></i>${f.maintenanceNotes}</div>`;
                              }
                              let estPrice = '';
                              if(f.estimatedPrice) {
                                  estPrice = `<div class="small fw-bold text-success mt-1">${Number(f.estimatedPrice).toLocaleString('tr-TR')} ₺</div>`;
                              }

                              let optsHtml = '';
                              let optList = f.options || [];
                              if(optList.length > 0) {
                                  optsHtml = `<button class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3 fw-bold shadow-sm" onclick="openOptionsModal(${f.id || f.Id}, '${(f.itemName || f.ItemName).replace(/'/g, "\\'")}', ${encodeURIComponent(JSON.stringify(optList))})"><i class="bi bi-palette me-1"></i>${optList.length} Opsiyon</button>`;
                              } else {
                                  optsHtml = `<button class="btn btn-sm btn-light border text-muted rounded-pill py-1 px-3" onclick="openOptionsModal(${f.id || f.Id}, '${(f.itemName || f.ItemName).replace(/'/g, "\\'")}', [])"><i class="bi bi-plus-circle me-1"></i>Opsiyon Ekle</button>`;
                              }

                              let warrantyBadge = '';
                              if (f.warrantyExpiryDate) {
                                  warrantyBadge = `<div class="small text-success mt-1" title="Garanti Bitiş Tarihi"><i class="bi bi-shield-check me-1"></i>Garanti: ${f.warrantyExpiryDate}</div>`;
                              }
                              let maintenanceBadge = '';
                              if (f.nextMaintenanceDate) {
                                  maintenanceBadge = `<div class="small text-warning-emphasis mt-1" title="Periyodik Bakım / Servis Tarihi"><i class="bi bi-calendar-event me-1"></i>Bakım: ${f.nextMaintenanceDate}</div>`;
                              }

                              html += `<tr>
                                  <td class="fw-bold text-dark">
                                      ${!f.isCustomizable ? '<i class="bi bi-lock-fill text-danger me-1" title="Müşteri Değiştiremez"></i>' : ''}
                                      ${f.itemName || f.ItemName}
                                      ${brandModel}
                                      ${shelfCode}
                                  </td>
                                  <td><span class="badge bg-light text-dark border">${f.category || f.Category}</span></td>
                                  <td>
                                      <div class="input-group input-group-sm" style="width: 120px;">
                                          <input type="number" step="0.01" class="form-control fw-bold text-primary" value="${f.quantity || f.Quantity}" onchange="updateFixtureQty(${f.id || f.Id}, this.value)" />
                                          <span class="input-group-text bg-light">${f.unit || f.Unit}</span>
                                      </div>
                                      ${estPrice}
                                  </td>
                                  <td>${optsHtml}</td>
                                  <td>
                                      <div>${f.supplierName ? f.supplierName : '<span class="text-muted small">-</span>'}</div>
                                      <div class="small text-muted">${f.technicalServiceName ? '<i class="bi bi-tools me-1"></i>' + f.technicalServiceName : ''}</div>
                                      ${warrantyBadge}
                                      ${maintenanceBadge}
                                  </td>
                                  <td class="text-end">
                                      <div class="btn-group">
                                          <button class="btn btn-sm btn-outline-success fw-bold rounded-pill px-2 py-1 me-1 shadow-sm" onclick="showFixtureSpec('${(f.itemName || '').replace(/'/g, "\\'")}', '${(f.standardBrand || '').replace(/'/g, "\\'")}', '${(f.standardModel || '').replace(/'/g, "\\'")}', ${f.quantity || 1}, '${f.unit || 'Adet'}', '${(f.maintenanceNotes || '').replace(/'/g, "\\'")}', '${(f.supplierName || '').replace(/'/g, "\\'")}', '${f.warrantyExpiryDate || ''}', '${f.nextMaintenanceDate || ''}')" title="Tedarikçi / İhale Şartnamesi Hazırla"><i class="bi bi-file-earmark-text me-1"></i>Şartname</button>
                                          <button class="btn btn-sm btn-light text-danger rounded-circle p-1" style="width:28px;height:28px;" onclick="deleteFixture(${f.id || f.Id})" title="Sil"><i class="bi bi-trash"></i></button>
                                      </div>
                                  </td>
                              </tr>`;
                          });
                          $('#fixturesTableBody').html(html);
                      }
                  } catch(e) {
                      $('#fixturesTableBody').html('<tr><td colspan="6" class="text-danger text-center">JS Hatası: ' + e.message + '</td></tr>');
                  }
              })
              .fail(function(jqXHR, textStatus, errorThrown) {
                  $('#fixturesTableBody').html('<tr><td colspan="6" class="text-danger text-center">Sunucu Yanıt Hatası: Oturumunuz kapanmış olabilir. Lütfen sayfayı yenileyin.</td></tr>');
              });

            // 2. Load Measurements
            $('#measurementsTableBody').html('<tr><td colspan="4" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>');
            $.ajax({
                  url: '/ConstructionProject/GetSpaceMeasurements',
                  type: 'GET',
                  dataType: 'json',
                  data: { spaceId: spaceId, t: new Date().getTime() },
                  cache: false
              })
              .done(function(data) {
                  try {
                      measurementsCount = data.length;
                      if(data.length === 0) {
                          $('#measurementsTableBody').html('<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-rulers fs-4 d-block mb-2"></i>Bu mahalde henüz ölçü yok.</td></tr>');
                      } else {
                          let html = '';
                          data.forEach(function(m) {
                              html += `<tr>
                                  <td class="text-muted small">${m.category || m.Category || "-"}</td>
                                  <td class="fw-bold text-dark">${m.description || m.Description || "-"}</td>
                                  <td>
                                      <div class="input-group input-group-sm" style="width: 170px;">
                                          <input type="number" step="0.01" class="form-control text-center" placeholder="En" value="${m.width || ''}" id="w_${m.id || m.Id}" onchange="updateMeasurementQty(${m.id || m.Id})" onkeydown="if(event.key==='Enter') this.blur();" />
                                          <span class="input-group-text px-1">x</span>
                                          <input type="number" step="0.01" class="form-control text-center" placeholder="Boy" value="${m.length || ''}" id="l_${m.id || m.Id}" onchange="updateMeasurementQty(${m.id || m.Id})" onkeydown="if(event.key==='Enter') this.blur();" />
                                      </div>
                                  </td>
                                  <td>
                                      <div class="input-group input-group-sm" style="width: 130px;">
                                          <input type="number" step="0.01" class="form-control fw-bold text-primary" value="${m.quantity || m.Quantity || 0}" id="q_${m.id || m.Id}" onchange="updateMeasurementQty(${m.id || m.Id})" />
                                          <span class="input-group-text bg-light">${m.unit || m.Unit || ""}</span>
                                      </div>
                                  </td>
                                  <td>
                                      <button class="btn btn-sm btn-light text-danger" onclick="deleteMeasurement(${m.id || m.Id})"><i class="bi bi-trash"></i></button>
                                  </td>
                              </tr>`;
                          });
                          $('#measurementsTableBody').html(html);
                      }
                  } catch(e) {
                      $('#measurementsTableBody').html('<tr><td colspan="5" class="text-danger text-center">JS Hatası: ' + e.message + '</td></tr>');
                  }
              })
              .fail(function(jqXHR, textStatus, errorThrown) {
                  $('#measurementsTableBody').html('<tr><td colspan="5" class="text-danger text-center">Sunucu Yanıt Hatası: Oturumunuz kapanmış olabilir. Lütfen F5 ile sayfayı yenileyin.</td></tr>');
              });
        }

        
        function openSmartTemplateModal() {
            if(currentSpaceId === 0) return;
            $('#templateSpaceId').val(currentSpaceId);
            $('#templateSpaceType').text(currentSpaceType);
            
            $('#smartTemplateFields').html('<div class="text-center py-4"><div class="spinner-border text-warning" role="status"></div></div>');
            $('#smartTemplateModal').modal('show');
            
            $.get('/ConstructionProject/GetSmartTemplate', { spaceType: currentSpaceType }, function(data) {
                let html = '';
                if(data.length === 0) {
                    html = '<div class="alert alert-info">Bu mahal türü için henüz akıllı şablon tanımlanmamış.</div>';
                } else {
                    data.forEach(function(item, index) {
                        html += `
                            <div class="row mb-2 align-items-center bg-white p-2 rounded shadow-sm">
                                <div class="col-md-5">
                                    <input type="hidden" name="Types[${index}]" value="${item.type}" />
                                    <input type="hidden" name="Categories[${index}]" value="${item.category}" />
                                    <input type="hidden" name="Names[${index}]" value="${item.name}" />
                                    <input type="hidden" name="Units[${index}]" value="${item.unit}" />
                                    <div class="fw-bold text-dark">${item.name}</div>
                                    <div class="small text-muted">${item.type === 'Fixture' ? 'Demirbaş' : 'Ölçü'} - ${item.category}</div>
                                </div>
                                <div class="col-md-7">
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" name="Quantities[${index}]" class="form-control" placeholder="Miktar / Ölçü" value="0" />
                                        <span class="input-group-text">${item.unit}</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                }
                $('#smartTemplateFields').html(html);
            });
        }

        
        
        function updateFixtureQty(id, qty) {
            $.post('/ConstructionProject/UpdateSpaceFixture', { id: id, quantity: qty, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
            .done(function() {
                toastr.success('Miktar güncellendi');
            }).fail(function() {
                toastr.error('Güncelleme başarısız');
            });
        }
        function updateMeasurementQty(id) {
            var q = $('#q_'+id).val() || 0;
            var w = $('#w_'+id).val() || '';
            var l = $('#l_'+id).val() || '';
            var h = '';
            
            $.post('/ConstructionProject/UpdateSpaceMeasurement', { 
                id: id, 
                quantity: q, 
                width: w, 
                length: l, 
                height: h, 
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
            })
            .done(function(resp) {
                toastr.success('Metraj güncellendi');
                // Tabloyu yenileyelim ki otomatik hesaplanan alanlar (Zemin -> Tavan veya En -> Denizlik) görünsün
                loadSpace(currentSpaceId, currentSpaceName, currentSpaceType);
            }).fail(function() {
                toastr.error('Güncelleme başarısız');
            });
        }

        function deleteFixture(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu demirbaş kaydı tamamen silinecektir!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/ConstructionProject/DeleteSpaceFixture', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function() {
                        loadSpace(currentSpaceId, currentSpaceName, currentSpaceType);
                    }).fail(function() {
                        Swal.fire('Hata', 'Silme işlemi başarısız oldu.', 'error');
                    });
                }
            });
        }

        function deleteMeasurement(id) {
            if (confirm('Bu metraj kaydı tamamen silinecektir! Emin misiniz?')) {
                $.post('/ConstructionProject/DeleteSpaceMeasurement', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function() {
                    loadSpace(currentSpaceId, currentSpaceName, currentSpaceType);
                }).fail(function() {
                    alert('Hata: Silme işlemi başarısız oldu.');
                });
            }
        }

        
        function deleteUnitSpace(id) {
            if (confirm('Bu mahal ve içindeki tüm ürün/ölçüler tamamen silinecektir! Emin misiniz?')) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/ConstructionProject/DeleteUnitSpace/' + id;
                
                var token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = $('input[name="__RequestVerificationToken"]').val();
                form.appendChild(token);
                
                document.body.appendChild(form);
                form.submit();
            }
        }

        function cleanEmptyMeasurements() {
            if(confirm('Miktarı 0 olan tüm boş metraj kalemleri temizlenecektir. Emin misiniz?')) {
                $.post('/ConstructionProject/CleanEmptyMeasurements', { spaceId: currentSpaceId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                .done(function(res) {
                    toastr.success(res.deletedCount + ' adet boş kayıt silindi.');
                    loadSpace(currentSpaceId, currentSpaceName, currentSpaceType);
                }).fail(function() {
                    toastr.error('Hata oluştu');
                });
            }
        }
        
        
        function submitMeasurementForm(e) {
            e.preventDefault();
            var form = $('#addMeasurementForm');
            $.post('/ConstructionProject/AddSpaceMeasurement', form.serialize())
            .done(function() {
                $('#addMeasurementModal').modal('hide');
                form[0].reset();
                toastr.success('Ölçü eklendi');
                loadSpace(currentSpaceId, currentSpaceName, currentSpaceType, currentView);
            }).fail(function() {
                toastr.error('Ölçü eklenirken hata oluştu');
            });
        }

        function openAddMeasurementModal() {
            if(currentSpaceId === 0) return;
            $('#measurementSpaceId').val(currentSpaceId);
            $('#addMeasurementModal').modal('show');
        }

        function openAddFixtureModal() {
            if(currentSpaceId === 0) return;
            $('#fixtureSpaceId').val(currentSpaceId);
            $('#addFixtureModal').modal('show');
        }

        // Clone Unit Selection & Filter Logic
        function updateSelectedCloneCount() {
            var count = $('.chk-clone-unit:checked').length;
            $('#selectedCloneCount').text(count);
        }

        $(document).on('change', '.chk-clone-unit', function() {
            updateSelectedCloneCount();
        });

        $(document).on('change', '.select-all-block-clone', function() {
            var blockName = $(this).data('block-name');
            var isChecked = $(this).is(':checked');
            $('.chk-clone-unit[data-block-name="' + blockName + '"]').prop('checked', isChecked);
            updateSelectedCloneCount();
        });

        $(document).on('click', '.btn-clone-filter', function(e) {
            e.preventDefault();
            var filter = $(this).data('filter');
            if (filter === 'all') {
                $('.chk-clone-unit').prop('checked', true);
                $('.select-all-block-clone').prop('checked', true);
            } else if (filter === 'facade') {
                var sourceFacade = '@(Model.FacadeDirection ?? "")';
                $('.chk-clone-unit').prop('checked', false);
                $('.select-all-block-clone').prop('checked', false);
                if (sourceFacade && sourceFacade !== '-') {
                    $('.chk-clone-unit[data-facade="' + sourceFacade + '"]').prop('checked', true);
                }
            } else if (filter === 'layout') {
                var sourceLayout = '@(Model.RoomLayout ?? "")';
                $('.chk-clone-unit').prop('checked', false);
                $('.select-all-block-clone').prop('checked', false);
                if (sourceLayout && sourceLayout !== '-') {
                    $('.chk-clone-unit[data-layout="' + sourceLayout + '"]').prop('checked', true);
                }
            } else if (filter === 'sameblock') {
                var sourceBlockId = '@Model.BuildingId';
                $('.chk-clone-unit').prop('checked', false);
                $('.select-all-block-clone').prop('checked', false);
                $('.chk-clone-unit[data-block="' + sourceBlockId + '"]').prop('checked', true);
            } else if (filter === 'clear') {
                $('.chk-clone-unit').prop('checked', false);
                $('.select-all-block-clone').prop('checked', false);
            }
            updateSelectedCloneCount();
        });

        $(document).on('click', '#btnSubmitCloneUnits', function() {
            var selectedUnitIds = [];
            $('.chk-clone-unit:checked').each(function() {
                selectedUnitIds.push(parseInt($(this).val()));
            });

            if (selectedUnitIds.length === 0) {
                alert("Lütfen kopyalamak istediğiniz en az bir hedef daire seçin!");
                return;
            }

            var overwrite = $('#chkCloneOverwrite').is(':checked');
            var btn = $(this);
            var oldText = btn.html();
            btn.html('<i class="spinner-border spinner-border-sm me-1"></i> Klonlanıyor...').prop('disabled', true);

            $.ajax({
                url: '/ConstructionProject/CloneUnitSpaces',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    sourceUnitId: @Model.Id,
                    targetUnitIds: selectedUnitIds,
                    overwrite: overwrite
                },
                traditional: true,
                success: function(res) {
                    btn.html(oldText).prop('disabled', false);
                    if (res.success) {
                        alert(res.message);
                        var modalEl = document.getElementById('cloneUnitModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    } else {
                        alert(res.message || 'Klonlama işlemi sırasında bir hata oluştu.');
                    }
                },
                error: function(xhr, status, error) {
                    btn.html(oldText).prop('disabled', false);
                    alert('HTTP Hatası: ' + xhr.status + ' - ' + error);
                }
            });
        });

        // MATERIAL OPTIONS LOGIC
        let activeFixtureOptions = [];

        function openOptionsModal(fixtureId, fixtureTitle, optList) {
            $('#optFixtureId').val(fixtureId);
            $('#optFixtureTitle').text(fixtureTitle);
            
            if (typeof optList === 'string') {
                try {
                    optList = JSON.parse(decodeURIComponent(optList));
                } catch(e) {
                    optList = [];
                }
            }
            activeFixtureOptions = optList || [];
            renderOptionsTable(activeFixtureOptions);
            
            // Reset new option inputs
            $('#newOptName').val('');
            $('#newOptPriceDiff').val('0');
            $('#newOptIsStandard').prop('checked', false);
            $('#newOptImage').val('');

            var modal = new bootstrap.Modal(document.getElementById('manageOptionsModal'));
            modal.show();
        }

        function renderOptionsTable(options) {
            if(!options || options.length === 0) {
                $('#optionsTableBody').html('<tr><td colspan="5" class="text-center text-muted py-3">Henüz opsiyon tanımlanmamış. Aşağıdaki formdan ilk seçeneği ekleyebilirsiniz.</td></tr>');
                return;
            }

            let html = '';
            options.forEach(function(o) {
                let imgHtml = o.imageUrl 
                    ? `<a href="${o.imageUrl}" target="_blank"><img src="${o.imageUrl}" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" /></a>` 
                    : '<div class="bg-light text-muted rounded d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;"><i class="bi bi-image small"></i></div>';

                let priceHtml = '';
                if (o.isStandard) {
                    priceHtml = '<span class="badge bg-light text-muted border">Standart (Fark Yok)</span>';
                } else if (o.priceDifference !== null && o.priceDifference !== undefined && Number(o.priceDifference) > 0) {
                    priceHtml = `<span class="badge bg-warning bg-opacity-10 text-dark border border-warning fw-bold">+${Number(o.priceDifference).toLocaleString('tr-TR')} ₺</span>`;
                } else {
                    priceHtml = '<span class="badge bg-secondary-subtle text-secondary border"><i class="bi bi-hourglass-split me-1"></i>Fiyat Belirlenecek</span>';
                }

                let statusBadge = o.isStandard 
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle fw-bold"><i class="bi bi-check-circle me-1"></i>Standart</span>' 
                    : '<span class="badge bg-primary-subtle text-primary border border-primary-subtle">Opsiyonel</span>';

                html += `<tr>
                    <td>${imgHtml}</td>
                    <td class="fw-bold text-dark">${o.optionName}</td>
                    <td>${priceHtml}</td>
                    <td>${statusBadge}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-light text-danger rounded-circle p-1" style="width: 28px; height: 28px;" onclick="deleteOption(${o.id})" title="Seçeneği Sil">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;
            });
            $('#optionsTableBody').html(html);
        }

        $(document).on('click', '#btnSubmitNewOption', function() {
            var fId = $('#optFixtureId').val();
            var name = $('#newOptName').val().trim();
            var price = $('#newOptPriceDiff').val() || 0;
            var isStd = $('#newOptIsStandard').is(':checked');
            var imgFile = $('#newOptImage')[0].files[0];

            if(!name) {
                alert("Lütfen seçenek adını girin (Örn: Masif Meşe, Mat Siyah)");
                return;
            }

            var formData = new FormData();
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
            formData.append('fixtureId', fId);
            formData.append('optionName', name);
            formData.append('priceDifference', price);
            formData.append('isStandard', isStd);
            if(imgFile) {
                formData.append('optionImage', imgFile);
            }

            var btn = $(this);
            var oldText = btn.html();
            btn.html('<i class="spinner-border spinner-border-sm me-1"></i> Kaydediliyor...').prop('disabled', true);

            $.ajax({
                url: '/ConstructionProject/AddFixtureOption',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    btn.html(oldText).prop('disabled', false);
                    if(res.success) {
                        // Reload space to refresh state
                        if(currentSpaceId) {
                            loadSpace(currentSpaceId, currentSpaceName, currentSpaceType, 'fixtures');
                        }
                        var modalEl = document.getElementById('manageOptionsModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if(modal) modal.hide();
                    } else {
                        alert(res.message || 'Hata oluştu');
                    }
                },
                error: function(xhr, status, error) {
                    btn.html(oldText).prop('disabled', false);
                    alert('Hata: ' + xhr.status + ' - ' + error);
                }
            });
        });

        function deleteOption(optionId) {
            if(!confirm("Bu seçeneği silmek istediğinize emin misiniz?")) return;

            $.ajax({
                url: '/ConstructionProject/DeleteFixtureOption',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    optionId: optionId
                },
                success: function(res) {
                    if(res.success) {
                        if(currentSpaceId) {
                            loadSpace(currentSpaceId, currentSpaceName, currentSpaceType, 'fixtures');
                        }
                        var modalEl = document.getElementById('manageOptionsModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if(modal) modal.hide();
                    } else {
                        alert(res.message || 'Silinemedi');
                    }
                }
            });
        }
    </script>
}
