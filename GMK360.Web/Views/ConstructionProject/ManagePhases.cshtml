                        let badge = c.approvalStatus === 'Onaylandı' ? 'bg-success' : (c.approvalStatus === 'Onay Bekliyor' ? 'bg-warning text-dark' : 'bg-secondary');
                        costHtml += `<tr>
                            <td><span class="badge bg-light text-dark border">${c.categoryName}</span></td>
                            <td class="fw-bold">${c.title} <br>
<small class="text-muted fw-normal">
    ${c.quantity ? `<span class="badge bg-light text-dark border me-1">${c.quantity} ${c.unit} İstenen</span>` : ''} 
    ${c.deliveredQuantity ? `<span class="badge bg-success text-white me-1">${c.deliveredQuantity} ${c.unit} Gelen</span>` : ''} 
    ${c.supplier || ''}
</small></td>
                            <td class="text-danger fw-bold">₺${c.amount.toLocaleString('tr-TR')}</td>
                            <td><span class="badge ${badge}">${c.approvalStatus}</span></td>
                            <td><button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button></td>
                        </tr>`;
                    });
                    $('#budget tbody').html(costHtml);
                }
                
                // Sohbet
                if(data.messages.length === 0) {
                    $('#chatBox').html('<div class="text-center text-muted mt-5">Henüz mesaj yok.</div>');
                } else {
                    let msgHtml = '';
                    data.messages.forEach(m => {
                        msgHtml += `<div class="d-flex mb-3">
                                <div class="bg-white border rounded p-2 shadow-sm w-75">
                                    <div class="d-flex justify-content-between">
                                        <strong class="text-primary small">${m.sender || 'Bilinmiyor'}</strong>
                                        <small class="text-muted">${m.date} ${m.time}</small>
                                    </div>
                                    <p class="mb-0 mt-1 small">${m.message}</p>
                                </div>
                            </div>`;
                    });
                    $('#chatBox').html(msgHtml);
                    // Scroll to bottom
                    var chatBox = document.getElementById("chatBox");
                    chatBox.scrollTop = chatBox.scrollHeight;
                }
            });
        }

        function openNewCostModal() {
            if(!$('#selectedTaskId').val()) { alert('Önce bir görev seçin.'); return; }
            $('#newCostModal').modal('show');
        }

        function saveCost() {
            var data = {
                taskId: $('#selectedTaskId').val(),
                title: $('#costTitle').val(),
                amount: $('#costAmount').val(), quantity: $('#costQuantity').val(), deliveredQuantity: $('#costDelivered').val(), unit: $('#costUnit').val(),
                supplier: $('#costSupplier').val()
            };
            $.post('/ConstructionProject/AddTaskCost', data, function(res) {
                if(res.success) { 
                    $('#newCostModal').modal('hide');
                    $('#newCostForm')[0].reset();
                    reloadTaskDetails();
                }
            });
        }

        function sendChatMessage() {
            var input = $('#chatMessageInput');
            var msg = input.val();
            var taskId = $('#selectedTaskId').val();
            if(!msg || !taskId) return;

            $.post('/ConstructionProject/AddTaskMessage', { taskId: taskId, message: msg }, function(res) {
                if(res.success) {
                    input.val('');
                    reloadTaskDetails();
                }
            });
        }

        };
                    $('#budget tbody').html(costHtml);
                }
                
                // Sohbet
                if(data.messages.length === 0) {
                    $('#chatBox').html('<div class="text-center text-muted mt-5">Henüz mesaj yok.</div>');
                } else {
                    let msgHtml = '';
                    data.messages.forEach(m => {
                        msgHtml += `<div class="d-flex mb-3">
                                <div class="bg-white border rounded p-2 shadow-sm w-75">
                                    <div class="d-flex justify-content-between">
                                        <strong class="text-primary small">${m.sender || 'Bilinmiyor'}</strong>
                                        <small class="text-muted">${m.date} ${m.time}</small>
                                    </div>
                                    <p class="mb-0 mt-1 small">${m.message}</p>
                                </div>
                            </div>`;
                    });
                    $('#chatBox').html(msgHtml);
                }
            });
        }
    </script>
}
