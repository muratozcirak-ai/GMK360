@model GMK360.Web.Models.Dashboard.ResidentDashboardViewModel
@{
    ViewData["Title"] = "GMK360 - Yaşam Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-2 px-md-4 bg-light min-vh-100">
    @if (Model == null || Model.MyUnits == null || !Model.MyUnits.Any())
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-center mt-5" style="min-height: 50vh;">
            <i class="ph ph-house text-muted opacity-25" style="font-size: 8rem;"></i>
            <h2 class="fw-bold mt-4 text-dark">Herhangi Bir Daireye Kayıtlı Değilsiniz</h2>
            <p class="text-muted w-50">Şu an GMK360 sisteminde kiracı veya ev sahibi olarak tanımlı olduğunuz bir daire bulunmuyor. Bina yöneticinizin sizi sisteme davet etmesini bekleyin veya yöneticinize haber verin.</p>
            <button class="btn btn-outline-secondary btn-lg rounded-pill px-5 mt-3" disabled>
                Davet Bekleniyor...
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-1 fw-bold text-dark">👋 Merhaba, Hoş Geldiniz</h4>
                <p class="text-muted mb-0"><i class="ph ph-map-pin text-danger me-1"></i> @Model.MyUnits.First().Building.Name - Daire: @Model.MyUnits.First().DoorNumber</p>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <a href="/ResidentPortal/Tickets" class="btn btn-outline-secondary shadow-sm rounded-pill px-4 me-2">
                    <i class="ph ph-headset me-2"></i>Taleplerim
                </a>
                <a href="/ResidentPortal/Meetings" class="btn btn-outline-primary shadow-sm rounded-pill px-4">
                    <i class="ph ph-book-open me-2"></i>Karar Defteri
                </a>
            </div>
        </div>

        @if (Model.UnpaidDebts != null && Model.UnpaidDebts.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-danger text-white overflow-hidden position-relative">
                <i class="ph ph-credit-card position-absolute opacity-25" style="font-size: 8rem; right: -20px; top: -10px;"></i>
                <div class="card-body p-4 position-relative z-index-1">
                    <h5 class="fw-bold mb-3 opacity-75">💳 Ödenmemiş Borcunuz Var</h5>
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div>
                            <h2 class="fw-bold mb-0">@Model.UnpaidDebts.Sum(d => d.Amount).ToString("C2")</h2>
                            <p class="mb-2 mb-md-0 opacity-75">Gecikmiş veya yaklaşan aidat borçları</p>
                        </div>
                        <button class="btn btn-light text-danger fw-bold rounded-pill px-4 py-2 shadow-sm">
                            Hemen Öde
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-success text-white overflow-hidden position-relative">
                <i class="ph ph-check-circle position-absolute opacity-25" style="font-size: 8rem; right: -20px; top: -10px;"></i>
                <div class="card-body p-4 position-relative z-index-1">
                    <h5 class="fw-bold mb-0">Tebrikler! Hiç borcunuz yok.</h5>
                </div>
            </div>
        }
        
        <h5 class="fw-bold mb-3 text-dark">🛠️ Hızlı İşlemler</h5>
        <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center bg-white text-dark py-3 cursor-pointer">
                    <div class="card-body p-2">
                        <i class="ph ph-wrench fs-2 text-warning mb-2"></i>
                        <h6 class="fw-bold mb-0">Arıza Bildir</h6>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center bg-white text-dark py-3 cursor-pointer">
                    <div class="card-body p-2">
                        <i class="ph ph-chats fs-2 text-primary mb-2"></i>
                        <h6 class="fw-bold mb-0">Yöneticiye Mesaj</h6>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
