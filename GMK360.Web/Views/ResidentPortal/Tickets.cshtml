@model IEnumerable<GMK360.Core.Entities.SupportTicket>
@{
    ViewData["Title"] = "Arıza & Bakım Taleplerim";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <a href="/ResidentPortal/Index" class="text-decoration-none text-muted small mb-2 d-inline-block"><i class="bi bi-arrow-left me-1"></i> Panele Dön</a>
            <h3 class="fw-bold mb-1 text-navy"><i class="bi bi-tools text-primary me-2"></i>Evim - Arıza & Talep Bildirimi</h3>
            <p class="text-muted mb-0">Evle ilgili onarımları, arızaları veya şikayetleri buradan mülk sahibine bildirebilirsiniz.</p>
        </div>
        <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#newTicketModal">
            <i class="bi bi-plus-lg me-2"></i>Yeni Talep / Bildirim
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Simülasyon: Kullanıcının bahsettiği musluk değişimi hikayesi -->
    <div class="row g-4">
        <!-- Aktif Talep / Örnek -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm border border-light-subtle rounded-4 h-100 position-relative hover-elevate">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-clock-history me-1"></i> Mal Sahibi Onayı Bekleniyor</span>
                        <span class="text-muted small fw-bold">Bugün, 10:30</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Mutfak Musluğu Değişimi</h5>
                    <p class="text-secondary small mb-3">"Merhaba, mutfak bataryası su sızdırıyordu. Tesisatçı çağırıp yeni ECA batarya taktırdım. Faturayı ve takılmış halinin fotoğrafını ekte iletiyorum, kiradan düşebilir miyiz?"</p>
                    
                    <div class="bg-light p-2 rounded-3 mb-3 d-flex align-items-center">
                        <div class="bg-primary text-white p-2 rounded-2 me-2"><i class="bi bi-image"></i></div>
                        <div>
                            <small class="d-block fw-bold text-dark">musluk_fatura.jpg</small>
                            <small class="text-muted" style="font-size: 0.7rem;">(Otomatik Olarak Mal Sahibinin Arşivine İletildi)</small>
                        </div>
                    </div>

                    <hr class="border-light-subtle" />
                    
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="bi bi-tag me-1"></i>Tesisat & Bakım</span>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3">Mesajı Aç</button>
                    </div>
                </div>
            </div>
        </div>

        @if (Model != null)
        {
            @foreach (var ticket in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm border border-light-subtle rounded-4 h-100 position-relative hover-elevate">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge @(ticket.Status == "Open" ? "bg-info text-dark" : ticket.Status == "Resolved" ? "bg-success" : "bg-secondary") px-3 py-2 rounded-pill">
                                    @(ticket.Status == "Open" ? "İşlemde" : ticket.Status == "Resolved" ? "Çözüldü" : ticket.Status)
                                </span>
                                <span class="text-muted small">@ticket.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                            <h5 class="fw-bold mb-2">@ticket.Title</h5>
                            <p class="text-secondary small mb-3">@ticket.Description</p>
                            
                            <hr class="border-light-subtle" />
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small"><i class="bi bi-tag me-1"></i>@ticket.Category</span>
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Mesajı Aç</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Yeni Talep / Arıza Modal -->
<div class="modal fade" id="newTicketModal" tabindex="-1" aria-labelledby="newTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <form method="post" action="/ResidentPortal/CreateTicket" enctype="multipart/form-data">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-navy" id="newTicketModalLabel"><i class="bi bi-tools text-primary me-2"></i>Yeni Arıza veya Talep Bildir</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4">
                    <p class="text-muted small mb-4">Mal sahibine veya yönetime iletmek istediğiniz konuyu detaylandırın. Tesisat, beyaz eşya onarımı veya komşu şikayeti gibi durumları bildirebilirsiniz.</p>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label text-muted small fw-bold">Konu Başlığı</label>
                            <input type="text" class="form-control premium-input" name="title" required placeholder="Örn: Kombi su akıtıyor, Musluğu değiştirdim">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Kategori</label>
                            <select class="form-select premium-input" name="category" required>
                                <option value="Su Tesisatı">Su Tesisatı</option>
                                <option value="Elektrik & Beyaz Eşya">Elektrik & Beyaz Eşya</option>
                                <option value="Çatı & Bina İçi">Çatı & Dış Cephe</option>
                                <option value="Menkul Masrafları / Fatura">Menkul Masrafları / Fatura (Kiradan Düşülecek)</option>
                                <option value="Şikayet">Komşu Şikayeti</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Açıklama & Mesajınız</label>
                        <textarea class="form-control premium-input" name="description" rows="4" required placeholder="Detayları yazın. Eğer bir onarım yaptırdıysanız fatura tutarını veya talebinizi belirtin..."></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-muted small fw-bold">Belge & Fotoğraf Yükle (Fatura, Hasar Görseli)</label>
                        <div class="border border-2 border-dashed border-primary rounded-3 bg-primary-subtle p-4 text-center cursor-pointer" onclick="document.getElementById('ticketAttachment').click()">
                            <i class="bi bi-cloud-arrow-up fs-2 text-primary mb-2"></i>
                            <h6 class="fw-bold text-dark mb-1">Fotoğraf veya PDF Seçin</h6>
                            <p class="text-muted small mb-0">Örn: Değişen musluğun faturası veya su basan bölgenin fotoğrafı</p>
                            <input type="file" id="ticketAttachment" name="attachment" class="d-none" multiple accept="image/*,.pdf" />
                        </div>
                        <div class="mt-2 text-info small">
                            <i class="bi bi-info-circle me-1"></i> Yüklediğiniz belgeler otomatik olarak Mal Sahibinin <strong>"Dijital Kasası'na"</strong> kalıcı olarak arşivlenir.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">Bildirimi Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>
