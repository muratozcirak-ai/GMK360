@model IEnumerable<GMK360.Core.Entities.SystemMeeting>
@{
    ViewData["Title"] = "Karar Defteri (Sakin Görünümü)";
    Layout = "~/Views/Shared/_FacilityLayout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/ResidentPortal/Index" class="text-decoration-none text-muted small mb-2 d-inline-block"><i class="bi bi-arrow-left me-1"></i> Panele Dön</a>
            <h2 class="fw-bold mb-1"><i class="bi bi-book text-primary me-2"></i>Dijital Karar Defteri</h2>
            <p class="text-muted mb-0">Binanızla ilgili alınan tüm kararları şeffaf bir şekilde görüntüleyin.</p>
        </div>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                    <div class="card-body">
                        <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
                        <h5>Henüz yayınlanmış bir karar bulunmuyor</h5>
                        <p class="text-muted mb-0">Yönetim tarafından yeni kararlar alındığında burada listelenecektir.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var meeting in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-1">@meeting.AgendaTitle</h5>
                                <span class="badge bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-check-circle me-1"></i>Kesinleşti
                                </span>
                                <span class="text-muted ms-2 small"><i class="bi bi-calendar3 me-1"></i> @meeting.MeetingDate.ToString("dd MMMM yyyy HH:mm")</span>
                                <span class="text-muted ms-2 small"><i class="bi bi-building me-1"></i> Bina: @meeting.ContextId</span>
                            </div>
                        </div>
                        <div class="card-body p-4 bg-light">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-list-check me-2 text-primary"></i>Alınan Kararlar</h6>
                            
                            @if (!meeting.Decisions.Any())
                            {
                                <p class="text-muted fst-italic">Toplantıda kayıt altına alınmış bir karar maddesi bulunmuyor.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush shadow-sm rounded">
                                    @foreach (var decision in meeting.Decisions)
                                    {
                                        <div class="list-group-item list-group-item-action d-flex align-items-start p-3 bg-white">
                                            <div class="ms-2 me-auto">
                                                <div class="fw-bold text-dark mb-1">Madde @decision.Id</div>
                                                <div class="text-secondary">@decision.DecisionText</div>
                                            </div>
                                            <span class="badge bg-light text-muted border">Kayıt: @decision.CreatedAt.ToString("HH:mm")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
