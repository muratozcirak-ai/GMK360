@model IEnumerable<GMK360.Core.Entities.Construction.Workflows.WorkGroupDefinition>
@{
    ViewData["Title"] = "Ýþ Grubu ve Branþ Tanýmlamalarý";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-people text-primary me-2"></i>Ýþ Grubu / Taþeron Branþý Tanýmlamalarý</h3>
            <p class="text-muted small mt-1 mb-0">Sistemde yer alacak ustalarýn, taþeronlarýn ve ofis satýn alma departmanlarýnýn branþlarýný buradan yönetin.</p>
        </div>
        <div>
            <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#newWorkGroupModal">
                <i class="bi bi-plus-lg me-2"></i> Yeni Branþ Ekle
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">BRANÞ ADI</th>
                        <th>AÇIKLAMA</th>
                        <th>TÝPÝ (KÝM ÝLGÝLENÝR?)</th>
                        <th>DURUM</th>
                        <th class="text-end pe-4">ÝÞLEM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td class="text-muted small">@item.Description</td>
                            <td>
                                @if(item.IsProcurementOnly)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-building me-1"></i> Satýn Alma Departmaný (Ofis)</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-tools me-1"></i> Þantiye / Taþeron / Usta</span>
                                }
                            </td>
                            <td>
                                @if(item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light text-primary"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newWorkGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/WorkGroup/Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Yeni Ýþ Grubu Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Branþ Adý (Örn: Kalýpçý, Asansörcü)</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Açýklama</label>
                        <textarea name="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsProcurementOnly" value="true" id="procurementSwitch">
                        <label class="form-check-label fw-bold text-warning" for="procurementSwitch">
                            <i class="bi bi-building me-1"></i> Bu Sadece "Satýn Alma" Ýþidir (Ýhaleye Çýkmaz, Ofise Düþer)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ýptal</button>
                    <button type="submit" class="btn btn-primary fw-bold">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
