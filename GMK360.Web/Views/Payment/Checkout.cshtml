@{
    ViewData["Title"] = "Güvenli Ödeme";
    decimal amount = ViewBag.Amount ?? 0m;
    decimal walletBalance = ViewBag.WalletBalance ?? 0m;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary text-white p-4 text-center">
                    <h3 class="fw-bold m-0"><i class="ph-bold ph-credit-card me-2"></i> Güvenli Ödeme (İyzico)</h3>
                    <p class="mb-0 mt-2 opacity-75">Hizmet bedeli veya kapora ödemenizi güvenle yapın.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    
                    @if(TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3 border">
                        <div>
                            <div class="text-muted small fw-bold">Ödenecek Tutar</div>
                            <div class="fs-4 fw-bold text-dark">@amount.ToString("N2") ₺</div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small fw-bold">Açıklama</div>
                            <div class="fw-bold">@ViewBag.Description</div>
                        </div>
                    </div>

                    <form method="post" action="/Payment/ProcessCheckout" id="paymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="amount" value="@amount" />
                        <input type="hidden" name="subMerchantKey" value="@ViewBag.SubMerchantKey" />

                        @if(walletBalance > 0)
                        {
                            <div class="alert alert-info rounded-3 p-3 mb-4 border border-info">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="fw-bold"><i class="ph-bold ph-wallet"></i> GMK Cüzdan Bakiyeniz</div>
                                    <div class="fs-5 fw-bold text-info">@walletBalance.ToString("N2") ₺</div>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="useWalletCheckbox" name="useWallet" value="true" onchange="toggleWalletUsage()">
                                    <label class="form-check-label fw-bold" for="useWalletCheckbox">Ödemede cüzdan bakiyemi kullan</label>
                                </div>
                            </div>
                        }

                        <div id="creditCardSection">
                            <h5 class="fw-bold mb-3">Kart Bilgileri</h5>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Kart Üzerindeki İsim</label>
                                <input type="text" class="form-control form-control-lg rounded-3 cc-input" name="cardHolderName" required placeholder="Ad Soyad">
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Kart Numarası</label>
                                <input type="text" class="form-control form-control-lg rounded-3 cc-input" name="cardNumber" required placeholder="XXXX XXXX XXXX XXXX" maxlength="19">
                            </div>
                            
                            <div class="row mb-4">
                                <div class="col-4">
                                    <label class="form-label fw-bold small text-muted">Ay</label>
                                    <input type="text" class="form-control form-control-lg rounded-3 cc-input" name="expireMonth" required placeholder="MM" maxlength="2">
                                </div>
                                <div class="col-4">
                                    <label class="form-label fw-bold small text-muted">Yıl</label>
                                    <input type="text" class="form-control form-control-lg rounded-3 cc-input" name="expireYear" required placeholder="YY" maxlength="2">
                                </div>
                                <div class="col-4">
                                    <label class="form-label fw-bold small text-muted">CVC</label>
                                    <input type="text" class="form-control form-control-lg rounded-3 cc-input" name="cvc" required placeholder="CVC" maxlength="4">
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm" id="payButton">
                            <i class="ph-bold ph-lock-key me-2"></i> <span id="payBtnText">@amount.ToString("N2") ₺ Öde</span>
                        </button>
                        
                        <div class="text-center mt-3 text-muted small" id="secureText">
                            <i class="bi bi-shield-lock-fill text-success"></i> 256-bit SSL ve İyzico güvencesiyle korunmaktadır.
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleWalletUsage() {
            var useWallet = document.getElementById('useWalletCheckbox').checked;
            var ccSection = document.getElementById('creditCardSection');
            var payBtnText = document.getElementById('payBtnText');
            var secureText = document.getElementById('secureText');
            var ccInputs = document.querySelectorAll('.cc-input');
            
            var totalAmount = parseFloat('@amount'.replace(',', '.'));
            var walletBalance = parseFloat('@walletBalance'.replace(',', '.'));
            
            if(useWallet) {
                if(walletBalance >= totalAmount) {
                    // Tam ödeme cüzdandan
                    ccSection.style.display = 'none';
                    payBtnText.innerText = "Cüzdan Bakiyemle Öde";
                    secureText.innerHTML = "<i class='bi bi-wallet2 text-info'></i> Ödeme cüzdanınızdan düşülecektir.";
                    ccInputs.forEach(inp => inp.removeAttribute('required'));
                } else {
                    // Kısmi ödeme
                    var remaining = totalAmount - walletBalance;
                    ccSection.style.display = 'block';
                    payBtnText.innerText = "Cüzdandan " + walletBalance.toFixed(2) + " ₺ + Karttan " + remaining.toFixed(2) + " ₺ Öde";
                    secureText.innerHTML = "<i class='bi bi-shield-lock-fill text-success'></i> Kalan tutar İyzico güvencesiyle tahsil edilecektir.";
                    ccInputs.forEach(inp => inp.setAttribute('required', 'required'));
                }
            } else {
                ccSection.style.display = 'block';
                payBtnText.innerText = totalAmount.toFixed(2) + " ₺ Öde";
                secureText.innerHTML = "<i class='bi bi-shield-lock-fill text-success'></i> 256-bit SSL ve İyzico güvencesiyle korunmaktadır.";
                ccInputs.forEach(inp => inp.setAttribute('required', 'required'));
            }
        }
    </script>
}
