@{
    ViewData["Title"] = "Ödeme Başarılı";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle" style="width: 100px; height: 100px;">
                        <i class="ph-bold ph-check-circle" style="font-size: 3rem;"></i>
                    </div>
                </div>
                
                <h2 class="fw-bold text-dark mb-3">Ödeme İşlemi Başarılı!</h2>
                <p class="text-muted fs-5 mb-4">İşleminiz başarıyla tamamlandı. İlgili tutar satıcıya güvenli bir şekilde aktarılmak üzere İyzico havuzuna alındı.</p>

                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                    <a href="/" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">Ana Sayfaya Dön</a>
                    <a href="/Dashboard" class="btn btn-outline-secondary btn-lg rounded-pill px-5 fw-bold">Kontrol Paneli</a>
                </div>
            </div>
        </div>
    </div>
</div>
