@model GMK360.Web.Models.ProjectShowcaseIndexViewModel
@{
    ViewData["Title"] = "Bölgenizdeki Projeler - Ön Bilgilendirme Kataloğu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO ŞERİDİ -->
<div class="bg-navy text-white py-5" style="background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 100%);">
    <div class="container py-4 text-center">
        <span class="badge bg-primary bg-opacity-25 border border-primary text-light rounded-pill px-4 py-2 mb-3">
            <i class="ph-bold ph-compass me-1"></i> Mimari Tanıtım & Ön Talep Kataloğu
        </span>
        <h1 class="display-5 fw-bold mb-3">Bölgenizdeki Yeni Yaşam Projeleri</h1>
        <p class="lead opacity-75 mx-auto" style="max-width: 750px;">
            Yasal güvence ve mimari şeffaflık: Piyasaya ve ilana çıkmadan önce kat planlarını inceleyin, lansman öncesi avantajlı ön görüşme randevunuzu şimdiden ayırtın.
        </p>
    </div>
</div>

<div class="container py-5">
    @if (TempData["ProjectSuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm p-4 mb-5 d-flex align-items-center">
            <i class="ph-fill ph-check-circle fs-3 me-3 text-success"></i>
            <div>
                <h5 class="fw-bold mb-1">Ön Bilgilendirme Talebiniz Alındı!</h5>
                <p class="mb-0 small">@TempData["ProjectSuccessMessage"]</p>
            </div>
        </div>
    }

    <!-- PROJELER LİSTESİ -->
    <div class="row g-5">
        @foreach(var proj in Model.Projects)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="row g-0">
                        <div class="col-lg-5 bg-light position-relative p-5 text-center d-flex flex-column justify-content-center border-end">
                            <i class="ph-fill ph-buildings text-primary opacity-50" style="font-size: 7rem;"></i>
                            <div class="position-absolute top-0 start-0 m-3 badge bg-primary rounded-pill px-3 py-2 fw-bold">
                                <i class="ph-bold ph-calendar me-1"></i> Teslimat: @proj.EstimatedCompletionDate
                            </div>
                            <div class="position-absolute bottom-0 start-0 m-3 badge bg-dark bg-opacity-75 rounded-pill px-3 py-2">
                                @proj.TotalBlocks Blok • @proj.TotalUnits Bağımsız Bölüm
                            </div>
                        </div>
                        <div class="col-lg-7 p-4 p-xl-5">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                                    <i class="ph-bold ph-shield-check me-1"></i> @proj.RealtorAuthorityModel
                                </span>
                                <span class="text-muted small"><i class="ph-bold ph-users me-1"></i>@proj.PreDemandCount Kişi Ön Görüşme İstedi</span>
                            </div>

                            <h3 class="fw-bold text-navy mb-1">@proj.ProjectName</h3>
                            <p class="text-muted small mb-3">
                                <strong>Müteahhit Firma:</strong> @proj.ConstructionCompany • <i class="ph-bold ph-map-pin text-danger me-1"></i>@proj.Location
                            </p>

                            <p class="text-dark mb-4">@proj.ArchitecturalConcept</p>

                            <!-- MİMARİ VE YAPI DETAYLARI -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 small">
                                        <div class="text-muted mb-1">Daire Tipleri:</div>
                                        <strong class="text-navy">@proj.UnitTypes</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 small">
                                        <div class="text-muted mb-1">Yapı & Deprem Güvenliği:</div>
                                        <strong class="text-success"><i class="ph-bold ph-shield-check me-1"></i>@proj.StructuralSafety</strong>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 small">
                                        <div class="text-muted mb-1">Sosyal Yaşam Alanları & Donatılar:</div>
                                        <span class="text-dark">@proj.SocialFacilities</span>
                                    </div>
                                </div>
                            </div>

                            <!-- AKSİYON VE TALEP BUTONU -->
                            <div class="d-flex flex-wrap gap-3 align-items-center pt-3 border-top">
                                <button class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="openPreDemandModal(@proj.Id, '@proj.ProjectName')">
                                    <i class="ph-bold ph-file-text me-1"></i> Lansman Öncesi Bilgi Al & Ön Talep Bırak
                                </button>
                                <a href="/Realtor" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold small">
                                    <i class="ph-bold ph-handshake me-1"></i> Emlakçı Satış Ortaklığı Talebi
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL: ÖN TALEP & GÖRÜŞME FORMU -->
<div class="modal fade" id="preDemandModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form action="/Emlak/Projeler/TalepKaydet" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjectId" id="modalProjectId" />
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-navy" id="modalProjectTitle">Ön Bilgilendirme Talebi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small">İlan ve piyasa lansmanından önce kat planlarını incelemek ve özel görüşme randevusu almak için bilgilerinizi bırakın:</p>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Adınız Soyadınız</label>
                        <input type="text" name="FullName" class="form-control rounded-3" placeholder="Ad Soyad" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Telefon Numaranız</label>
                            <input type="text" name="Phone" class="form-control rounded-3" placeholder="0532..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">E-Posta Adresiniz</label>
                            <input type="email" name="Email" class="form-control rounded-3" placeholder="ornek@mail.com" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">İlgilendiğiniz Tip</label>
                            <select name="InterestedUnitType" class="form-select rounded-3">
                                <option value="2+1 Bahçe Dubleksi">2+1 Bahçe Dubleksi</option>
                                <option value="3+1 Standart Ara Kat" selected>3+1 Standart Ara Kat</option>
                                <option value="4+1 Çatı Dubleksi">4+1 Çatı Dubleksi</option>
                                <option value="Müstakil Villa">Müstakil Villa</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Ödeme Tercihiniz</label>
                            <select name="PaymentPreference" class="form-select rounded-3">
                                <option value="Peşin / Erken Rezervasyon İndirimi">Peşin / Erken Rezervasyon</option>
                                <option value="İnşaat Firması İçi Vade">Şirket İçi Vade</option>
                                <option value="Banka Konut Kredisi">Banka Kredisi</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Notunuz veya Sorunuz (Opsiyonel)</label>
                        <textarea name="Notes" class="form-control rounded-3" rows="2" placeholder="Örn: 2. kat güney cephe ile ilgileniyorum..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Talebi Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openPreDemandModal(id, title) {
        document.getElementById('modalProjectId').value = id;
        document.getElementById('modalProjectTitle').innerText = title + ' - Ön Talep & Bilgilendirme';
        new bootstrap.Modal(document.getElementById('preDemandModal')).show();
    }
</script>
