@model GMK360.Core.Entities.Property
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5">
    <h2>@Model.Title</h2>
    <h4>@Model.Price.ToString("N0") @Model.Currency</h4>
    <p>Oda: @Model.RoomCount | m2: @Model.GrossArea</p>
    <p>@Model.Description</p>
    <!-- Detay resimleri ve iletişim formu buraya gelecek -->
</div>
