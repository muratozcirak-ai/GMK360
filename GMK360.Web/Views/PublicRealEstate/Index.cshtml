@model IEnumerable<GMK360.Core.Entities.Property>
@{
    ViewData["Title"] = "Emlak Arama - Kiralık ve Satılık İlanlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Bu sayfa tamamen dış kullanıcılara (sörfçülere) açıktır. ERP tasarımı değil, Emlak portalı tasarımıdır.
}

<!-- HERO ARAMA ALANI -->
<div class="bg-primary text-white py-5" style="background: linear-gradient(135deg, var(--bs-primary) 0%, #1a237e 100%);">
    <div class="container py-5 text-center">
        <h1 class="display-5 fw-bold mb-3">Hayalinizdeki Evi Hemen Bulun</h1>
        <p class="lead mb-4 opacity-75">Emlak, Tadilat, Hizmet ve Malzeme Tedariği Tek Çatıda.</p>
        
        <!-- PAZARYERİ KANCALARI (MARKETPLACE HOOKS) -->
        <div class="row justify-content-center mb-4 g-3">
            <div class="col-auto">
                <a href="#emlak" class="btn btn-outline-light rounded-pill px-4 active fw-bold">🏠 Ev Arıyorum</a>
            </div>
            <div class="col-auto">
                <a href="/Usta/TalepAc" class="btn btn-outline-warning rounded-pill px-4 fw-bold">🛠️ Usta/Firma Arıyorum</a>
            </div>
            <div class="col-auto">
                <a href="/Usta/Basvuru" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow">Hizmet/Malzeme Sağlayıcıyım</a>
            </div>
        </div>
        
        <div class="card p-3 border-0 shadow-lg mx-auto rounded-4" style="max-width: 800px;">
            <form asp-action="Search" method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-lg rounded-3 border-0 bg-light">
                        <option value="satilik">Satılık</option>
                        <option value="kiralik">Kiralık</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-geo-alt"></i></span>
                        <input type="text" name="locationSlug" class="form-control border-0 bg-light" placeholder="İl, İlçe veya Mahalle (Örn: Istanbul-Kadikoy)">
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-warning btn-lg w-100 rounded-3 fw-bold text-dark">
                        <i class="bi bi-search me-2"></i> Ara
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <!-- SOL REKLAM/CROSS-SELL ALANI -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 shadow-sm rounded-4 bg-gradient-info text-white mb-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-white rounded-circle p-3 d-inline-block mb-3 shadow">
                        <i class="bi bi-house-check text-info fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Ev Sahibi misiniz?</h5>
                    <p class="small opacity-75 mb-3">Kiracılarınızı takip edin, aidatlarınızı yönetin. Tamamen ücretsiz.</p>
                    <a href="/Landlord/Dashboard" class="btn btn-light btn-sm rounded-pill fw-bold text-info w-100 shadow-sm">Kayıt Ol</a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-gradient-warning text-dark">
                <div class="card-body p-4 text-center">
                    <div class="bg-white rounded-circle p-3 d-inline-block mb-3 shadow">
                        <i class="bi bi-tools text-warning fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Usta mı Arıyorsunuz?</h5>
                    <p class="small opacity-75 mb-3">Evinizdeki tadilatlar için güvenilir ustalardan anında teklif alın.</p>
                    <a href="#" class="btn btn-dark btn-sm rounded-pill fw-bold text-warning w-100 shadow-sm">Usta Bul</a>
                </div>
            </div>
        </div>

        <!-- İLAN LİSTESİ -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0 text-dark">Günün Fırsat İlanları</h4>
                <a href="#" class="btn btn-outline-primary btn-sm rounded-pill">Tümünü Gör</a>
            </div>

            <div class="row g-4">
                @if(!Model.Any())
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-house-exclamation fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted">Şu an vitrinde ilan bulunmuyor.</h5>
                    </div>
                }
                @foreach (var prop in Model)
                {
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm hover-shadow rounded-4 overflow-hidden">
                            <div class="position-relative bg-light text-center" style="height: 200px;">
                                <!-- İleride PropertyImage üzerinden fotoğraf gelecek -->
                                <i class="bi bi-image text-muted opacity-25" style="font-size: 5rem; line-height: 200px;"></i>
                                <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill px-3 py-2 fs-6 shadow-sm">
                                    @prop.Price.ToString("N0") @prop.Currency
                                </span>
                            </div>
                            <div class="card-body p-4">
                                <p class="text-primary fw-bold small mb-1"><i class="bi bi-geo-alt-fill me-1"></i> @prop.BlockName</p>
                                <h5 class="fw-bold text-dark mb-2">@prop.Title</h5>
                                <div class="d-flex gap-3 text-muted small fw-bold mt-3">
                                    <span><i class="bi bi-door-open"></i> @prop.RoomCount</span>
                                    <span><i class="bi bi-rulers"></i> @prop.GrossArea m²</span>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0 p-4 pt-0">
                                <a href="/Emlak/Detay/@prop.Id" class="btn btn-primary w-100 rounded-pill fw-bold">İlanı İncele</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-info { background: linear-gradient(135deg, #0dcaf0 0%, #055160 100%); }
    .bg-gradient-warning { background: linear-gradient(135deg, #ffc107 0%, #cc9a06 100%); }
    .hover-shadow { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .hover-shadow:hover { transform: translateY(-5px); box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important; }
</style>
