@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/tr.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('miniCalendar');
            if (calendarEl) {
                var eventDates = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(eventDates.Select(d => d.ToString("yyyy-MM-dd"))));
                var initialDate = '@selectedDate.ToString("yyyy-MM-dd")';

                var calendarEvents = [];
                @foreach (var d in eventDates)
                {
                    var count = allRecords.Count(r => r.EventDate.Date == d.Date);
                    <text>
                    calendarEvents.push({
                        start: '@d.ToString("yyyy-MM-dd")',
                        title: '🔴 @count Randevu',
                        color: '#ef4444',
                        textColor: '#ffffff',
                        display: 'block'
                    });
                    </text>
                }

                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    initialDate: initialDate,
                    locale: 'tr',
                    height: 'auto',
                    contentHeight: 280,
                    headerToolbar: {
                        left: 'prev,next',
                        center: 'title',
                        right: 'today'
                    },
                    events: calendarEvents,
                    dayCellDidMount: function(arg) {
                        var y = arg.date.getFullYear();
                        var m = String(arg.date.getMonth() + 1).padStart(2, '0');
                        var d = String(arg.date.getDate()).padStart(2, '0');
                        var key = y + '-' + m + '-' + d;

                        if (eventDates.includes(key)) {
                            arg.el.classList.add('has-agenda-event');
                        }
                    },
                    dateClick: function(info) {
                        window.location.href = '/Agenda/Index?selectedDate=' + info.dateStr + '&viewMode=@viewMode@(projectId.HasValue ? $"&projectId={projectId.Value}" : "")';
                    }
                });

                calendar.render();
            }

            // Yıldız Puanlama Etkileşimi
            const stars = document.querySelectorAll('#starContainer i');
            const ratingValueInput = document.getElementById('starRatingValue');
            const ratingText = document.getElementById('ratingText');
            const labels = ["", "(1/5 Yetersiz)", "(2/5 Geliştirilmeli)", "(3/5 Orta)", "(4/5 İyi)", "(5/5 Çok İyi)"];

            stars.forEach(star => {
                star.addEventListener('click', function() {
                    const val = parseInt(this.getAttribute('data-val'));
                    ratingValueInput.value = val;
                    ratingText.innerText = labels[val];
                    stars.forEach(s => {
                        const sVal = parseInt(s.getAttribute('data-val'));
                        if (sVal <= val) {
                            s.classList.add('active');
                            s.classList.replace('bi-star', 'bi-star-fill');
                        } else {
                            s.classList.remove('active');
                            s.classList.replace('bi-star-fill', 'bi-star');
                        }
                    });
                });
            });
        });

        // 🎤 SES TANIMA / DİKTE (Web Speech API)
        function toggleSpeechRecognition(targetInputId, micButtonId) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert('Tarayıcınız ses tanımayı desteklemiyor. Klavyenizdeki mikrofon tuşunu kullanarak konuşabilirsiniz.');
                return;
            }

            const micBtn = document.getElementById(micButtonId);
            const targetInput = document.getElementById(targetInputId);

            const recognition = new SpeechRecognition();
            recognition.lang = 'tr-TR';
            recognition.continuous = false;
            recognition.interimResults = false;

            if (micBtn) {
                micBtn.innerHTML = '<i class="bi bi-record-circle-fill text-danger"></i> <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span> Dinleniyor...';
                micBtn.classList.add('speech-listening');
            }

            recognition.onresult = function(event) {
                const transcript = event.results[0][0].transcript;
                if (targetInput) {
                    targetInput.value = (targetInput.value ? targetInput.value + ' ' : '') + transcript;
                }
            };

            recognition.onerror = function(event) {
                console.error('Ses tanıma hatası:', event.error);
                resetMicBtn(micBtn);
            };

            recognition.onend = function() {
                resetMicBtn(micBtn);
            };

            recognition.start();
        }

        function resetMicBtn(micBtn) {
            if (micBtn) {
                micBtn.innerHTML = '<i class="bi bi-mic-fill text-danger me-1"></i> 🎤 Bas & Konuş';
                micBtn.classList.remove('speech-listening');
            }
        }

        // Görev Atama Modalı
        function openAssignModal(recordId, title, staffName, staffPhone, taskNote) {
            document.getElementById('assignRecordId').value = recordId;
            document.getElementById('assignRecordTitle').innerText = title;
            document.getElementById('assignStaffName').value = staffName || '';
            document.getElementById('assignStaffPhone').value = staffPhone || '';
            document.getElementById('assignTaskNote').value = taskNote || '';

            var select = document.getElementById('assignStaffSelect');
            var matched = false;
            if (staffName) {
                for (var i = 0; i < select.options.length; i++) {
                    if (select.options[i].getAttribute('data-name') === staffName) {
                        select.selectedIndex = i;
                        matched = true;
                        break;
                    }
                }
            }

            if (!matched) {
                if (staffName) {
                    select.value = 'custom';
                    document.getElementById('customStaffDiv').style.display = 'flex';
                } else {
                    select.selectedIndex = 0;
                    document.getElementById('customStaffDiv').style.display = 'none';
                }
            } else {
                document.getElementById('customStaffDiv').style.display = 'none';
            }

            var modal = new bootstrap.Modal(document.getElementById('assignTaskModal'));
            modal.show();
        }

        function handleStaffSelectChange(select) {
            var customDiv = document.getElementById('customStaffDiv');
            var nameInput = document.getElementById('assignStaffName');
            var phoneInput = document.getElementById('assignStaffPhone');
            if (select.value === 'custom') {
                customDiv.style.display = 'flex';
                nameInput.value = '';
                phoneInput.value = '';
                nameInput.focus();
            } else {
                customDiv.style.display = 'none';
                var opt = select.options[select.selectedIndex];
                nameInput.value = opt.getAttribute('data-name') || '';
                phoneInput.value = opt.getAttribute('data-phone') || '';
            }
        }

        // Keşif Tamamlama Modalı
        function openCompleteInspectionModal(recordId, title) {
            document.getElementById('completeRecordId').value = recordId;
            document.getElementById('completeRecordTitle').innerText = title;
            document.getElementById('completeSiteNotes').value = '';
            var modal = new bootstrap.Modal(document.getElementById('completeInspectionModal'));
            modal.show();
        }

        // Medya Önizleme Lightbox
        function previewMedia(url) {
            document.getElementById('mediaPreviewImg').src = url;
            var modal = new bootstrap.Modal(document.getElementById('mediaPreviewModal'));
            modal.show();
        }

        // Görevliye Tek Tıkla SMS Gönder
        function sendSmsToStaff(recordId, phone, name, dateTime, supplier) {
            if (!confirm(name + ' personeline SMS göndermek istiyor musunuz?')) return;
            var msg = 'Sayın ' + name + ', ' + dateTime + ' randevusunda ' + supplier + ' karsilama goreviniz bulunmaktadir.';
            $.post('/Agenda/SendStaffSms', { recordId: recordId, phone: phone, message: msg }, function(res) {
                if (res.success) {
                    alert('SMS başarıyla iletildi: ' + phone);
                } else {
                    alert('SMS gönderilemedi: ' + (res.message || 'Bilinmeyen hata'));
                }
            }).fail(function() {
                alert('SMS servisine ulaşılamadı.');
            });
        }

        function updateStatus(id, statusId) {
            $.post('/Agenda/UpdateStatus', { id: id, statusId: statusId }, function(res) {
                window.location.reload();
            }).fail(function() {
                alert('Durum güncellenirken bir hata oluştu.');
            });
        }

        function loadDetailsModal(id) {
            const modal = new bootstrap.Modal(document.getElementById('agendaDetailModal'));
            modal.show();
            $('#modalDetailContent').html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>');
            $.get('/Agenda/GetDetails/' + id, function(data) {
                $('#modalDetailContent').html(data);
            }).fail(function() {
                $('#modalDetailContent').html('<div class="alert alert-danger">Kayıt detayları yüklenemedi.</div>');
            });
        }
    </script>
}
