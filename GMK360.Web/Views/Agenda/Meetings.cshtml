@model IEnumerable<GMK360.Core.Entities.Construction.AgendaRecord>
@{
    ViewData["Title"] = "Toplantı & Karar Masası";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";

    var projects = ViewBag.Projects as List<GMK360.Core.Entities.Construction.ConstructionProject> ?? new List<GMK360.Core.Entities.Construction.ConstructionProject>();
    int? selectedProjectId = ViewBag.SelectedProjectId as int?;
    byte selectedStatusId = (ViewBag.SelectedStatusId as byte?) ?? GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi;
    byte? selectedRecordTypeId = ViewBag.SelectedRecordTypeId as byte?;
    var phonebooks = ViewBag.Phonebook as List<GMK360.Core.Entities.Construction.AgencyPhonebook> ?? new List<GMK360.Core.Entities.Construction.AgencyPhonebook>();

    var allList = Model?.ToList() ?? new List<GMK360.Core.Entities.Construction.AgendaRecord>();
    var today = DateTime.Today;

    // Kronolojik Akış: Önce tamamlanmamışlar (tarihe göre artan), en altta tamamlananlar
    var sortedList = allList
        .OrderBy(x => x.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi ? 1 : 0)
        .ThenBy(x => x.EventDate)
        .ToList();

    int overdueCount = (ViewBag.OverdueCount as int?) ?? allList.Count(x => x.EventDate.Date < today && x.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
    int todayCount = (ViewBag.TodayCount as int?) ?? allList.Count(x => x.EventDate.Date == today && x.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
    int upcomingCount = (ViewBag.UpcomingCount as int?) ?? allList.Count(x => x.EventDate.Date > today && x.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
    int completedCount = (ViewBag.CompletedCount as int?) ?? allList.Count(x => x.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
    int activeTotalCount = (ViewBag.ActiveTotalCount as int?) ?? (overdueCount + todayCount + upcomingCount);
    bool isArchiveView = selectedStatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
}

<div class="container-fluid py-2 px-2 px-md-3">

    <!-- KOMPAKT & MOBİL UYUMLU BAŞLIK ŞERİDİ -->
    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning bg-opacity-25 text-dark rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                <i class="bi bi-people-fill text-warning fs-5"></i>
            </span>
            <div>
                <h5 class="fw-bold text-dark mb-0 fs-6 fs-md-5">Toplantı, Şirket İçi Yazışma & Dijital Evrak Çantası</h5>
                <div class="d-flex align-items-center gap-1 mt-1 flex-wrap" style="font-size: 0.72rem;">
                    @if (overdueCount > 0)
                    {
                        <span class="badge bg-danger text-white px-2 py-0 rounded-pill">
                            ⚠️ Gidilemedi / Bekleyen: <b>@overdueCount</b>
                        </span>
                    }
                    <span class="badge @(todayCount > 0 ? "bg-danger text-white" : "bg-light text-muted border") px-2 py-0 rounded-pill">
                        🔴 Bugün: <b>@todayCount</b>
                    </span>
                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-0 rounded-pill">
                        🟡 Planlı: <b>@upcomingCount</b>
                    </span>
                    <span class="badge bg-success bg-opacity-15 text-success border border-success px-2 py-0 rounded-pill">
                        🗄️ Arşivde (Karara Bağlanan): <b>@completedCount</b>
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-1.5 flex-wrap">
            <button type="button" class="btn btn-outline-dark rounded-pill px-2.5 py-1 fw-bold shadow-xs btn-sm d-flex align-items-center gap-1" style="font-size: 0.78rem;" onclick="openQuickAgendaModal(4)">
                <i class="bi bi-chat-left-text-fill text-primary"></i>
                <span>+ Şirket İçi Yazışma / İş Planım</span>
            </button>
            <button type="button" class="btn btn-outline-danger rounded-pill px-2.5 py-1 fw-bold shadow-xs btn-sm d-flex align-items-center gap-1" style="font-size: 0.78rem;" onclick="openQuickAgendaModal(5)">
                <i class="bi bi-briefcase-fill"></i>
                <span>+ Dış Firma / Kurum Ziyareti (Çanta)</span>
            </button>
            <button type="button" class="btn btn-warning text-dark border border-warning rounded-pill px-3 py-1 fw-bold shadow-xs btn-sm d-flex align-items-center gap-1" style="font-size: 0.80rem;" onclick="openQuickAgendaModal(1)">
                <i class="bi bi-plus-circle-fill"></i>
                <span>+ Yeni Toplantı / Başlık Aç</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-xs py-2 px-3 mb-2 small" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-xs py-2 px-3 mb-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <!-- AÇIK BAŞLIKLAR VS ARŞİV HIZLI GEÇİŞ SEKMELERİ -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="d-flex gap-1.5 flex-wrap">
            <a href="/Agenda/Meetings?statusId=@GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi@(selectedProjectId.HasValue ? $"&projectId={selectedProjectId}" : "")@(selectedRecordTypeId.HasValue ? $"&recordTypeId={selectedRecordTypeId}" : "")"
               class="btn btn-sm rounded-pill px-3 py-1 fw-bold @(selectedStatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi ? "btn-primary shadow-xs" : "btn-light border text-dark")" style="font-size: 0.78rem;">
                <i class="bi bi-broadcast me-1"></i>Açık Başlıklar & Devam Edenler (@activeTotalCount)
            </a>
            <a href="/Agenda/Meetings?statusId=@GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi@(selectedProjectId.HasValue ? $"&projectId={selectedProjectId}" : "")@(selectedRecordTypeId.HasValue ? $"&recordTypeId={selectedRecordTypeId}" : "")"
               class="btn btn-sm rounded-pill px-3 py-1 fw-bold @(isArchiveView ? "btn-success text-white shadow-xs" : "btn-light border text-dark")" style="font-size: 0.78rem;">
                <i class="bi bi-archive-fill me-1"></i>Arşiv / Karara Bağlananlar (@completedCount)
            </a>
        </div>
        <small class="text-muted" style="font-size: 0.73rem;">
            <i class="bi bi-info-circle text-primary me-1"></i><strong>Kural:</strong> Konular <b>"Toplantı Bitti / Karara Bağla"</b> denilene kadar açık başlık olarak kalır; karara bağlandığı an aktif ekrandan düşer ve <b>Arşivde</b> saklanır.
        </small>
    </div>

    <!-- TEK VE KİBAR DİV: FİLTRE + MASTER AJANDA ÇİZELGESİ -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-3">
        
        <!-- FİLTRE ŞERİDİ (TEK SATIR KOMPAKT) -->
        <div class="card-header bg-light bg-opacity-75 py-2 px-3 border-bottom">
            <form method="get" action="/Agenda/Meetings" class="row g-2 align-items-center">
                <div class="col-md-4 col-12">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-tag text-primary"></i></span>
                        <select name="recordTypeId" class="form-select border-start-0 fw-semibold" onchange="this.form.submit()" style="font-size: 0.80rem;">
                            <option value="">Tüm Kayıt Türleri (Toplantı, İç Yazışma & Ziyaret)</option>
                            <option value="4" selected="@(selectedRecordTypeId == 4)">💬 Şirket İçi Yazışma / Ortak & İş Planım</option>
                            <option value="5" selected="@(selectedRecordTypeId == 5)">🎒 Dış Firma Ziyareti / Resmi Kurum & Maliye</option>
                            <option value="1" selected="@(selectedRecordTypeId == 1)">🤝 Arsa Sahibi / Temsilci / Müşteri Toplantısı</option>
                            <option value="2" selected="@(selectedRecordTypeId == 2)">🛠️ Taşeron / Teknik & Saha Konusu</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4 col-12">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-buildings text-primary"></i></span>
                        <select name="projectId" class="form-select border-start-0 fw-semibold" onchange="this.form.submit()" style="font-size: 0.80rem;">
                            <option value="">Tüm Projeler & Kişisel Ajandam (@projects.Count Proje)</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.Id" selected="@(selectedProjectId == p.Id)">@p.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-3 col-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-funnel text-warning"></i></span>
                        <select name="statusId" class="form-select border-start-0" onchange="this.form.submit()" style="font-size: 0.80rem;">
                            <option value="@GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi" selected="@(selectedStatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi)">🟢 Açık Başlıklar (Aktif Ekran)</option>
                            <option value="@GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi" selected="@(selectedStatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi)">🗄️ Arşiv (Karara Bağlananlar)</option>
                            <option value="99" selected="@(selectedStatusId == 99)">📋 Tümünü Birlikte Göster</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-1 col-4 text-end">
                    @if (selectedProjectId.HasValue || selectedRecordTypeId.HasValue || selectedStatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi)
                    {
                        <a href="/Agenda/Meetings" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-0 text-nowrap" style="font-size: 0.72rem;">
                            <i class="bi bi-x-circle me-1"></i>Sıfırla
                        </a>
                    }
                </div>
            </form>
        </div>

        @if (!sortedList.Any())
        {
            <div class="p-4 text-center text-muted">
                <i class="bi @(isArchiveView ? "bi-archive" : "bi-calendar-check") fs-2 d-block mb-1 text-muted"></i>
                <span class="small fw-semibold">
                    @(isArchiveView ? "Henüz karara bağlanıp arşive kaldırılmış bir toplantı veya yazışma bulunmuyor." : "Şu an açık bir toplantı, şirket içi yazışma veya dış görüşme başlığı bulunmuyor.")
                </span>
                <div class="mt-2 d-flex justify-content-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-dark rounded-pill px-3 py-1 btn-sm fw-bold" onclick="openQuickAgendaModal(4)">
                        <i class="bi bi-chat-left-text me-1"></i>+ Şirket İçi Yazışma / İş Planı Aç
                    </button>
                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-1 btn-sm fw-bold" onclick="openQuickAgendaModal(5)">
                        <i class="bi bi-briefcase me-1"></i>+ Dış Firma / Kurum Ziyareti Hazırla
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-3 py-1 btn-sm fw-bold" onclick="openQuickAgendaModal(1)">
                        <i class="bi bi-plus-circle me-1"></i>+ Yeni Toplantı Başlat
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- A. LAPTOP & DESKTOP TABLOSU (d-none d-md-block) -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                    <thead class="table-light text-secondary border-bottom">
                        <tr style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.3px;">
                            <th class="py-2 ps-3" style="width: 155px;">Tarih & Saat</th>
                            <th class="py-2" style="width: 195px;">Tür & Kapsam</th>
                            <th class="py-2" style="width: 175px;">Muhatap / Kurum</th>
                            <th class="py-2">Konu, İş Planı & Sonuç Notu</th>
                            <th class="py-2 text-center" style="width: 135px;">Durum</th>
                            <th class="py-2 text-end pe-3" style="width: 280px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in sortedList)
                        {
                            bool isDone = m.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
                            bool isToday = m.EventDate.Date == today && !isDone;
                            bool isOverdue = m.EventDate.Date < today && !isDone;
                            var pToken = m.Participants?.FirstOrDefault(p => !string.IsNullOrEmpty(p.AccessToken))?.AccessToken;
                            var guestUrl = !string.IsNullOrEmpty(pToken) ? $"{Context.Request.Scheme}://{Context.Request.Host}/Agenda/Guest?token={pToken}" : "";

                            string rowClass = isToday ? "table-warning bg-warning bg-opacity-10 border-start border-4 border-danger" :
                                              isOverdue ? "border-start border-4 border-warning bg-warning bg-opacity-10" :
                                              isDone ? "table-light text-muted opacity-75" : "";

                            string typeBadgeHtml = m.RecordTypeId == 5
                                ? "<span class='badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-0.5 rounded-pill fw-bold' style='font-size:0.70rem;'>🏛️ Resmi Kurum / Maliye</span>"
                                : m.RecordTypeId == 4
                                ? "<span class='badge bg-dark bg-opacity-10 text-dark border border-secondary-subtle px-2 py-0.5 rounded-pill fw-bold' style='font-size:0.70rem;'>📌 İş Planım / Ortak</span>"
                                : m.RecordTypeId == 2
                                ? "<span class='badge bg-info bg-opacity-10 text-dark border border-info px-2 py-0.5 rounded-pill fw-bold' style='font-size:0.70rem;'>🛠️ Taşeron / Teknik</span>"
                                : m.RecordTypeId == 3
                                ? "<span class='badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-0.5 rounded-pill fw-bold' style='font-size:0.70rem;'>🚨 Saha / Vukuat</span>"
                                : "<span class='badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-0.5 rounded-pill fw-bold' style='font-size:0.70rem;'>🤝 Toplantı / Malik</span>";

                            <tr class="@rowClass">
                                <!-- TARİH / SAAT -->
                                <td class="ps-3">
                                    @if (isToday)
                                    {
                                        <div class="fw-bold text-danger d-flex align-items-center gap-1">
                                            <span class="spinner-grow spinner-grow-sm text-danger" style="width: 8px; height: 8px;"></span>
                                            <span>BUGÜN @m.EventDate.ToString("HH:mm")</span>
                                        </div>
                                        <small class="text-danger fw-semibold" style="font-size: 0.68rem;">Bugünkü Plan</small>
                                    }
                                    else if (isOverdue)
                                    {
                                        <div class="fw-bold text-danger">@m.EventDate.ToString("dd.MM.yyyy") — @m.EventDate.ToString("HH:mm")</div>
                                        <span class="badge bg-danger text-white rounded-pill px-2 py-0" style="font-size: 0.64rem;">⚠️ Gidilemedi / Bekliyor</span>
                                    }
                                    else if (m.EventDate.Date == today.AddDays(1) && !isDone)
                                    {
                                        <div class="fw-bold text-dark">YARIN @m.EventDate.ToString("HH:mm")</div>
                                        <small class="text-muted" style="font-size: 0.68rem;">@m.EventDate.ToString("dd.MM.yyyy")</small>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">@m.EventDate.ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted" style="font-size: 0.68rem;"><i class="bi bi-clock me-1"></i>@m.EventDate.ToString("dddd, HH:mm")</small>
                                    }
                                </td>

                                <!-- TÜR & PROJE -->
                                <td>
                                    <div class="mb-0.5">@Html.Raw(typeBadgeHtml)</div>
                                    <div class="text-truncate small text-muted fw-semibold" style="max-width: 185px; font-size: 0.72rem;" title="@(m.Project?.Name ?? "Kişisel / Şirket Genel")">
                                        <i class="bi @(m.Project != null ? "bi-building text-primary" : "bi-person-workspace text-secondary") me-1"></i>@(m.Project?.Name ?? "Kişisel / Şirket Genel")
                                    </div>
                                </td>

                                <!-- MUHATAP -->
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 170px;" title="@(m.Phonebook?.Name ?? (m.RecordTypeId == 5 ? "Resmi Kurum / Daire" : "Kişisel Plan / İç Görüşme"))">
                                        <i class="bi @(m.RecordTypeId == 5 ? "bi-bank text-danger" : "bi-person text-secondary") me-1"></i>@(m.Phonebook?.Name ?? (m.RecordTypeId == 5 ? "Resmi Kurum / Daire" : "Kişisel Plan"))
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(m.Phonebook?.PhoneNumber))
                                    {
                                        <small class="text-muted" style="font-size: 0.70rem;">@m.Phonebook.PhoneNumber</small>
                                    }
                                </td>

                                <!-- GÜNDEM BAŞLIĞI & NOTLAR -->
                                <td>
                                    <a href="/Agenda/MeetingRoom/@m.Id" class="fw-bold text-dark text-decoration-none d-block text-truncate" style="max-width: 360px;" title="@m.Title">
                                        @m.Title
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(m.Notes))
                                    {
                                        <small class="text-secondary d-block text-truncate" style="max-width: 360px; font-size: 0.71rem;" title="@m.Notes">@m.Notes</small>
                                    }
                                    @if ((m.Items?.Count ?? 0) > 0)
                                    {
                                        <span class="badge bg-light text-secondary border px-1.5 py-0 rounded-pill" style="font-size: 0.65rem;">
                                            <i class="bi bi-paperclip me-0.5"></i>@(m.Items?.Count ?? 0) Not / Evrak Satırı
                                        </span>
                                    }
                                </td>

                                <!-- DURUM -->
                                <td class="text-center">
                                    @if (isToday)
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1 rounded-pill fw-bold small">
                                            🔴 Bugün Sırada
                                        </span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge bg-warning text-dark border border-danger px-2 py-1 rounded-pill fw-bold small">
                                            ⏳ Bekliyor (Ertele)
                                        </span>
                                    }
                                    else if (isDone)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill small fw-bold">
                                            <i class="bi bi-check2-all me-1"></i>Sonuçlandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-dark border border-warning px-2 py-1 rounded-pill small">
                                            Planlandı
                                        </span>
                                    }
                                </td>

                                <!-- AKSİYONLAR -->
                                <td class="text-end pe-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        @if (!isDone)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning text-dark border-warning rounded-pill px-2 py-0.5 fw-bold shadow-2xs text-nowrap" style="font-size: 0.73rem;"
                                                    onclick="openRescheduleModal(@m.Id, '@Html.Raw((m.Title ?? "").Replace("'", "\\'"))', '@m.EventDate.ToString("yyyy-MM-dd")', '@m.EventDate.ToString("HH:mm")')"
                                                    title="Gidilemediyse veya başka iş çıktıysa yeni tarihe ertele">
                                                <i class="bi bi-calendar-plus me-0.5"></i>Ertele
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0.5 fw-bold shadow-2xs text-nowrap" style="font-size: 0.73rem;"
                                                    onclick="openQuickConcludeModal(@m.Id, '@Html.Raw((m.Title ?? "").Replace("'", "\\'"))')"
                                                    title="Toplantıyı / yazışmayı karara bağla, aktif ekrandan düşürüp arşive kaldır">
                                                <i class="bi bi-check2-circle me-0.5"></i>Toplantı Bitti / Karara Bağla
                                            </button>
                                        }

                                        <a href="/Agenda/MeetingRoom/@m.Id" class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fw-bold shadow-xs text-nowrap" style="font-size: 0.75rem;" title="Alt konu açmak, evrak yüklemek veya yazışmak için masayı aç">
                                            <span>Masaya Gir ➔</span>
                                        </a>

                                        @if (!string.IsNullOrWhiteSpace(m.Phonebook?.PhoneNumber))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" onclick="sendWhatsAppReminder('@m.Phonebook.PhoneNumber', '@Html.Raw((m.Phonebook.Name ?? "").Replace("'", "\\'"))', '@Html.Raw((m.Project?.Name ?? "GMK360").Replace("'", "\\'"))', '@Html.Raw((m.Title ?? "").Replace("'", "\\'"))', '@m.EventDate.ToString("dd.MM.yyyy HH:mm")', '@guestUrl')" title="Karşı tarafa WhatsApp'tan Canlı Gündem & Evrak Çantası Bağlantısı Gönder">
                                                <i class="bi bi-whatsapp" style="font-size: 0.75rem;"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- B. TABLET & MOBİL GÖRÜNÜMÜ (d-block d-md-none - BAŞPARMAK DOKUNMATİK LİSTE) -->
            <div class="d-block d-md-none p-2">
                <div class="d-flex flex-column gap-2">
                    @foreach (var m in sortedList)
                    {
                        bool isDone = m.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
                        bool isToday = m.EventDate.Date == today && !isDone;
                        bool isOverdue = m.EventDate.Date < today && !isDone;
                        var pToken = m.Participants?.FirstOrDefault(p => !string.IsNullOrEmpty(p.AccessToken))?.AccessToken;
                        var guestUrl = !string.IsNullOrEmpty(pToken) ? $"{Context.Request.Scheme}://{Context.Request.Host}/Agenda/Guest?token={pToken}" : "";

                        <div class="card border rounded-3 p-3 shadow-xs bg-white border-start border-4 @(isToday || isOverdue ? "border-danger bg-warning bg-opacity-10" : isDone ? "border-success opacity-75" : "border-warning")">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <span class="badge @(isToday ? "bg-danger text-white" : isOverdue ? "bg-danger text-white" : isDone ? "bg-success text-white" : "bg-warning text-dark") px-2 py-0 rounded-pill small fw-bold">
                                    @(isToday ? "🔴 BUGÜN " + m.EventDate.ToString("HH:mm") : isOverdue ? "⚠️ GECİKTİ: " + m.EventDate.ToString("dd.MM HH:mm") : m.EventDate.ToString("dd.MM.yyyy HH:mm"))
                                </span>
                                <span class="badge bg-light text-primary border border-primary px-2 py-0 rounded-pill small text-truncate" style="max-width: 140px;">
                                    @(m.Project?.Name ?? "Kişisel / Genel")
                                </span>
                            </div>

                            <h6 class="fw-bold text-dark mb-1 fs-6">@m.Title</h6>

                            @if (!string.IsNullOrWhiteSpace(m.Notes))
                            {
                                <div class="small text-secondary mb-1 text-truncate">@m.Notes</div>
                            }

                            <div class="d-flex align-items-center gap-1 mt-2 pt-2 border-top flex-wrap">
                                @if (!isDone)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark border-warning rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;" onclick="openRescheduleModal(@m.Id, '@Html.Raw((m.Title ?? "").Replace("'", "\\'"))', '@m.EventDate.ToString("yyyy-MM-dd")', '@m.EventDate.ToString("HH:mm")')">
                                        <i class="bi bi-calendar-plus me-1"></i>Ertele
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;" onclick="openQuickConcludeModal(@m.Id, '@Html.Raw((m.Title ?? "").Replace("'", "\\'"))')">
                                        <i class="bi bi-check2-circle me-1"></i>Karara Bağla
                                    </button>
                                }
                                <a href="/Agenda/MeetingRoom/@m.Id" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold flex-fill" style="font-size: 0.78rem;">
                                    <span>Masaya Gir ➔</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>

</div>

<!-- MODAL 1: HIZLI TOPLANTI / ŞİRKET İÇİ YAZIŞMA / DIŞ ZİYARET EVRAK ÇANTASI AÇ -->
