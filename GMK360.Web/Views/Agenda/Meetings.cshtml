@model IEnumerable<GMK360.Core.Entities.Construction.AgendaRecord>
@{
    ViewData["Title"] = "Toplantı & Karar Masası";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";

    var projects = ViewBag.Projects as List<GMK360.Core.Entities.Construction.ConstructionProject> ?? new List<GMK360.Core.Entities.Construction.ConstructionProject>();
    int? selectedProjectId = ViewBag.SelectedProjectId as int?;
    byte? selectedStatusId = ViewBag.SelectedStatusId as byte?;

    var allList = Model?.ToList() ?? new List<GMK360.Core.Entities.Construction.AgendaRecord>();
    var today = DateTime.Today;

    // Kronolojik Akış: Önce tamamlanmamışlar (tarihe göre artan), en altta tamamlananlar
    var sortedList = allList
        .OrderBy(x => x.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi ? 1 : 0)
        .ThenBy(x => x.EventDate)
        .ToList();

    int todayCount = allList.Count(x => x.EventDate.Date == today && x.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
    int upcomingCount = allList.Count(x => x.EventDate.Date > today && x.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
    int completedCount = allList.Count(x => x.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi);
}

<div class="container-fluid py-2 px-2 px-md-3">

    <!-- KOMPAKT & MOBİL UYUMLU BAŞLIK ŞERİDİ -->
    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning bg-opacity-25 text-dark rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                <i class="bi bi-people-fill text-warning fs-5"></i>
            </span>
            <div>
                <h5 class="fw-bold text-dark mb-0 fs-6 fs-md-5">Toplantı & Karar Masası</h5>
                <div class="d-flex align-items-center gap-1 mt-1 flex-wrap" style="font-size: 0.72rem;">
                    <span class="badge @(todayCount > 0 ? "bg-danger text-white" : "bg-light text-muted border") px-2 py-0 rounded-pill">
                        🔴 Bugün: <b>@todayCount</b>
                    </span>
                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-0 rounded-pill">
                        🟡 Planlı: <b>@upcomingCount</b>
                    </span>
                    <span class="badge bg-success bg-opacity-15 text-success border border-success px-2 py-0 rounded-pill">
                        🟢 Karara Bağlanan: <b>@completedCount</b>
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="/Agenda/Create" class="btn btn-warning text-dark border border-warning rounded-pill px-3 py-1 fw-bold shadow-xs btn-sm d-flex align-items-center gap-1" style="font-size: 0.82rem;">
                <i class="bi bi-plus-circle-fill"></i>
                <span>+ Yeni Toplantı Başlat</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-xs py-2 px-3 mb-2 small" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <!-- TEK VE KİBAR DİV: FİLTRE + MASTER AJANDA ÇİZELGESİ -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-3">
        
        <!-- FİLTRE ŞERİDİ (TEK SATIR KOMPAKT) -->
        <div class="card-header bg-light bg-opacity-75 py-2 px-3 border-bottom">
            <form method="get" action="/Agenda/Meetings" class="row g-2 align-items-center">
                <div class="col-md-5 col-12">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-buildings text-primary"></i></span>
                        <select name="projectId" class="form-select border-start-0 fw-semibold" onchange="this.form.submit()" style="font-size: 0.80rem;">
                            <option value="">Tüm Projeler & Şantiyeler (@projects.Count)</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.Id" selected="@(selectedProjectId == p.Id)">@p.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-5 col-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-funnel text-warning"></i></span>
                        <select name="statusId" class="form-select border-start-0" onchange="this.form.submit()" style="font-size: 0.80rem;">
                            <option value="">Tüm Durumlar (Canlı, Planlı & Tamamlanan)</option>
                            <option value="@GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi" selected="@(selectedStatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi)">Devam Eden / Planlananlar</option>
                            <option value="@GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi" selected="@(selectedStatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi)">Karara Bağlananlar</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-2 col-4 text-end">
                    @if (selectedProjectId.HasValue || selectedStatusId.HasValue)
                    {
                        <a href="/Agenda/Meetings" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-0 text-nowrap" style="font-size: 0.72rem;">
                            <i class="bi bi-x-circle me-1"></i>Temizle
                        </a>
                    }
                </div>
            </form>
        </div>

        @if (!sortedList.Any())
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-calendar-check fs-2 d-block mb-1 text-muted"></i>
                <span class="small fw-semibold">Kayıtlı toplantı bulunmuyor.</span>
                <div class="mt-2">
                    <a href="/Agenda/Create" class="btn btn-primary rounded-pill px-3 py-1 btn-sm fw-bold">
                        <i class="bi bi-plus-circle me-1"></i>İlk Toplantıyı Başlat
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- A. LAPTOP & DESKTOP TABLOSU (d-none d-md-block) -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                    <thead class="table-light text-secondary border-bottom">
                        <tr style="font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.3px;">
                            <th class="py-2 ps-3" style="width: 140px;">Tarih / Sıra</th>
                            <th class="py-2" style="width: 180px;">Şantiye (Proje)</th>
                            <th class="py-2" style="width: 200px;">Muhatap (Kiminle?)</th>
                            <th class="py-2">Gündem / Müzakere Konusu</th>
                            <th class="py-2 text-center" style="width: 80px;">Konular</th>
                            <th class="py-2 text-center" style="width: 130px;">Durum</th>
                            <th class="py-2 text-end pe-3" style="width: 240px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in sortedList)
                        {
                            bool isToday = m.EventDate.Date == today && m.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
                            bool isDone = m.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
                            var pToken = m.Participants?.FirstOrDefault(p => !string.IsNullOrEmpty(p.AccessToken))?.AccessToken;
                            var guestUrl = !string.IsNullOrEmpty(pToken) ? $"{Context.Request.Scheme}://{Context.Request.Host}/Agenda/Guest?token={pToken}" : "";

                            string rowClass = isToday ? "table-warning bg-warning bg-opacity-10 border-start border-4 border-danger" :
                                              isDone ? "table-light text-muted opacity-75" : "";

                            <tr class="@rowClass">
                                <!-- TARİH / SAAT -->
                                <td class="ps-3">
                                    @if (isToday)
                                    {
                                        <div class="fw-bold text-danger d-flex align-items-center gap-1">
                                            <span class="spinner-grow spinner-grow-sm text-danger" style="width: 8px; height: 8px;"></span>
                                            <span>BUGÜN @m.EventDate.ToString("HH:mm")</span>
                                        </div>
                                        <small class="text-danger fw-semibold" style="font-size: 0.68rem;">Sıradaki Oturum</small>
                                    }
                                    else if (m.EventDate.Date == today.AddDays(1) && !isDone)
                                    {
                                        <div class="fw-bold text-dark">YARIN @m.EventDate.ToString("HH:mm")</div>
                                        <small class="text-muted" style="font-size: 0.68rem;">@m.EventDate.ToString("dd MMMM")</small>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">@m.EventDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted" style="font-size: 0.68rem;"><i class="bi bi-clock me-1"></i>@m.EventDate.ToString("dddd, HH:mm")</small>
                                    }
                                </td>

                                <!-- ŞANTİYE / PROJE -->
                                <td>
                                    <span class="badge bg-light text-primary border border-primary border-opacity-50 px-2 py-1 rounded-pill fw-bold text-truncate d-inline-block" style="max-width: 170px;" title="@(m.Project?.Name ?? "Bağımsız")">
                                        <i class="bi bi-building me-1"></i>@(m.Project?.Name ?? "Bağımsız Proje")
                                    </span>
                                </td>

                                <!-- MUHATAP -->
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 190px;" title="@(m.Phonebook?.Name ?? "Belirtilmedi")">
                                        <i class="bi bi-person text-secondary me-1"></i>@(m.Phonebook?.Name ?? "Belirtilmedi")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(m.Phonebook?.PhoneNumber))
                                    {
                                        <small class="text-muted" style="font-size: 0.70rem;">@m.Phonebook.PhoneNumber</small>
                                    }
                                </td>

                                <!-- GÜNDEM BAŞLIĞI -->
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 320px;" title="@m.Title">@m.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(m.Notes))
                                    {
                                        <small class="text-secondary d-block text-truncate" style="max-width: 320px; font-size: 0.70rem;" title="@m.Notes">@m.Notes</small>
                                    }
                                </td>

                                <!-- KONU SAYISI -->
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-0 rounded-pill small">
                                        <b>@(m.Items?.Count ?? 0)</b>
                                    </span>
                                </td>

                                <!-- DURUM -->
                                <td class="text-center">
                                    @if (isToday)
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1 rounded-pill fw-bold small">
                                            🔴 Canlı / Sırada
                                        </span>
                                    }
                                    else if (isDone)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill small fw-bold">
                                            <i class="bi bi-check2-all me-1"></i>Karara Bağlandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-dark border border-warning px-2 py-1 rounded-pill small">
                                            Planlandı
                                        </span>
                                    }
                                </td>

                                <!-- AKSİYONLAR -->
                                <td class="text-end pe-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <a href="/Agenda/MeetingRoom/@m.Id" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs text-nowrap" style="font-size: 0.78rem;">
                                            <span>Masaya Gir ➔</span>
                                        </a>

                                        @if (!string.IsNullOrWhiteSpace(m.Phonebook?.PhoneNumber))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" onclick="sendWhatsAppReminder('@m.Phonebook.PhoneNumber', '@m.Phonebook.Name', '@(m.Project?.Name ?? "GMK360")', '@m.Title', '@m.EventDate.ToString("dd.MM.yyyy HH:mm")', '@guestUrl')" title="WhatsApp ile Hatırlat">
                                                <i class="bi bi-whatsapp"></i>
                                            </button>
                                        }

                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" onclick="openRescheduleModal(@m.Id, '@m.Title', '@m.EventDate.ToString("yyyy-MM-ddTHH:mm")')" title="Sonraki Devam Oturumunu Belirle">
                                            <i class="bi bi-calendar-plus"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- B. TABLET & MOBİL GÖRÜNÜMÜ (d-block d-md-none - BAŞPARMAK DOKUNMATİK LİSTE) -->
            <div class="d-block d-md-none p-2">
                <div class="d-flex flex-column gap-2">
                    @foreach (var m in sortedList)
                    {
                        bool isToday = m.EventDate.Date == today && m.StatusId != GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
                        bool isDone = m.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi;
                        var pToken = m.Participants?.FirstOrDefault(p => !string.IsNullOrEmpty(p.AccessToken))?.AccessToken;
                        var guestUrl = !string.IsNullOrEmpty(pToken) ? $"{Context.Request.Scheme}://{Context.Request.Host}/Agenda/Guest?token={pToken}" : "";

                        <div class="card border rounded-3 p-3 shadow-xs bg-white border-start border-4 @(isToday ? "border-danger bg-warning bg-opacity-10" : isDone ? "border-success opacity-75" : "border-warning")">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge @(isToday ? "bg-danger text-white" : isDone ? "bg-success text-white" : "bg-warning text-dark") px-2 py-0 rounded-pill small fw-bold">
                                    @(isToday ? "🔴 BUGÜN " + m.EventDate.ToString("HH:mm") : m.EventDate.ToString("dd MMM HH:mm"))
                                </span>
                                <span class="badge bg-light text-primary border border-primary px-2 py-0 rounded-pill small text-truncate" style="max-width: 140px;">
                                    @(m.Project?.Name ?? "Bağımsız")
                                </span>
                            </div>

                            <h6 class="fw-bold text-dark mb-1 fs-6">@m.Title</h6>

                            @if (m.Phonebook != null)
                            {
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-person me-1"></i>Muhatap: <b class="text-dark">@m.Phonebook.Name</b>
                                </div>
                            }

                            <div class="d-flex align-items-center gap-1 mt-2 pt-2 border-top">
                                <a href="/Agenda/MeetingRoom/@m.Id" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold flex-fill" style="font-size: 0.80rem;">
                                    <span>Müzakere Masasına Gir ➔</span>
                                </a>

                                @if (!string.IsNullOrWhiteSpace(m.Phonebook?.PhoneNumber))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1" onclick="sendWhatsAppReminder('@m.Phonebook.PhoneNumber', '@m.Phonebook.Name', '@(m.Project?.Name ?? "GMK360")', '@m.Title', '@m.EventDate.ToString("dd.MM.yyyy HH:mm")', '@guestUrl')" title="WhatsApp">
                                        <i class="bi bi-whatsapp"></i>
                                    </button>
                                }

                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" onclick="openRescheduleModal(@m.Id, '@m.Title', '@m.EventDate.ToString("yyyy-MM-ddTHH:mm")')" title="Devam Oturumu">
                                    <i class="bi bi-calendar-plus"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>

</div>

<!-- MODAL: SONRAKİ DEVAM OTURUMUNU BELİRLE -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="ScheduleNextSession" asp-controller="Agenda" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recordId" id="modalRescheduleRecordId" value="" />

                <div class="modal-header border-bottom py-2 bg-warning text-dark">
                    <h6 class="modal-title fw-bold mb-0" style="font-size: 0.90rem;">
                        <i class="bi bi-calendar-plus me-1"></i>Sonraki Devam Oturumunu Belirle
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small text-muted fw-bold mb-1">Mevcut Oturum</label>
                        <input type="text" class="form-control form-control-sm bg-light rounded-3 fw-bold" id="modalRescheduleTitle" readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-dark mb-1">Yeni Oturum Tarihi ve Saati <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="nextSessionDate" id="modalRescheduleDate" class="form-control form-control-sm rounded-3 fw-bold" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-dark mb-1">Devam Notu / Kararlaştırılan Hazırlık</label>
                        <textarea name="nextSessionNote" class="form-control form-control-sm rounded-3" rows="2" placeholder="Örn: 2. Oturumda mimari kat planlarının kesinleşmesi müzakere edilecek..."></textarea>
                    </div>

                    <div class="form-check p-2 rounded-3 bg-light border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" name="createNewSession" value="true" id="chkCreateNewSession" checked>
                        <label class="form-check-label small fw-bold text-dark" for="chkCreateNewSession" style="font-size: 0.78rem;">
                            Mevcut oturumu tamamla ve <b>"2. Devam Oturumu"</b> olarak yeni seans aç
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-top py-2 d-flex justify-content-between">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-xs btn-sm">
                        <i class="bi bi-check2-circle me-1"></i>Ajandaya Kaydet & Devam Et
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Sonraki Oturum Modalını Aç
    function openRescheduleModal(recordId, title, currentDatetime) {
        document.getElementById('modalRescheduleRecordId').value = recordId;
        document.getElementById('modalRescheduleTitle').value = title;
        document.getElementById('modalRescheduleDate').value = currentDatetime;
        var modal = new bootstrap.Modal(document.getElementById('rescheduleModal'));
        modal.show();
    }

    // WhatsApp Otomatik Hatırlatıcı Gönder
    function sendWhatsAppReminder(phone, clientName, projectName, meetingTitle, dateStr, guestUrl) {
        if (!phone) {
            alert('Muhatabın telefon numarası bulunamadı.');
            return;
        }
        var cleanPhone = phone.replace(/[^0-9]/g, '');
        if (cleanPhone.startsWith('0')) cleanPhone = '90' + cleanPhone.substring(1);
        else if (!cleanPhone.startsWith('90')) cleanPhone = '90' + cleanPhone;

        var msg = 'Sayın ' + (clientName || 'Yetkili') + ',\n\n' +
                  '🏢 *' + projectName + '* projemiz kapsamında;\n' +
                  '📋 *' + meetingTitle + '* müzakere oturumumuz *' + dateStr + '* tarihinde gerçekleştirilecektir.\n\n';

        if (guestUrl) {
            msg += '📱 Toplantı gündem maddelerini incelemek ve canlı notları takip etmek için katılım bağlantınız:\n' + guestUrl + '\n\n';
        }

        msg += 'Görüşmek üzere, iyi çalışmalar dileriz.';

        var waUrl = 'https://api.whatsapp.com/send?phone=' + cleanPhone + '&text=' + encodeURIComponent(msg);
        window.open(waUrl, '_blank');
    }
</script>
