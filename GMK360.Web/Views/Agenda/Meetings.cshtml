<script>
    function isGenericFileNameJS(nameWithoutExt) {
        if (!nameWithoutExt) return true;
        var s = nameWithoutExt.trim().toLowerCase();
        if (s.length < 3) return true;
        if (/^(img|dsc|dscn|scan|image|photo|resim|belge|document|ekran|screenshot|whatsapp|wa|video|vid)[_\-\s0-9]/.test(s)) return true;
        if (/^[0-9_\-\s()]+$/.test(s)) return true;
        return false;
    }

    function handleAgendaFileSubject(fileInput, titleInputId, hintId, starId) {
        var titleInp = document.getElementById(titleInputId);
        var hintEl = document.getElementById(hintId);
        var starEl = document.getElementById(starId || 'reqStarQuickDoc');
        if (!titleInp) return;

        if (!fileInput.files || fileInput.files.length === 0) {
            titleInp.required = false;
            if (starEl) starEl.style.display = 'none';
            return;
        }

        titleInp.required = true;
        if (starEl) starEl.style.display = 'inline';

        var rawFileName = fileInput.files[0].name || '';
        var lastDot = rawFileName.lastIndexOf('.');
        var baseName = lastDot > 0 ? rawFileName.substring(0, lastDot) : rawFileName;

        if (isGenericFileNameJS(baseName)) {
            titleInp.value = '';
            titleInp.classList.add('border-danger');
            if (hintEl) {
                hintEl.className = 'd-block mt-1 text-danger fw-bold';
                hintEl.innerHTML = '⚠️ Seçilen dosyanın adı rastgele görünüyor (' + rawFileName + '). Lütfen arşivde kolay bulunması için belgenin konusunu yazın!';
            }
            setTimeout(function () { titleInp.focus(); }, 100);
        } else {
            if (!titleInp.value.trim()) {
                titleInp.value = baseName.replace(/[_-]+/g, ' ').trim();
            }
            titleInp.classList.remove('border-danger');
            titleInp.classList.add('border-success');
            if (hintEl) {
                hintEl.className = 'd-block mt-1 text-success fw-semibold';
                hintEl.innerHTML = '✅ Dosya adı anlamlı görünüyor ve konu olarak aktarıldı; isterseniz düzenleyebilirsiniz.';
            }
        }
    }

    function openQuickAgendaModal(typeId) {
        selectQuickAgendaType(typeId || 4);
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('quickAgendaModal'));
        modal.show();
        setTimeout(function() {
            var inp = document.getElementById('inpQuickAgendaTitle');
            if (inp) inp.focus();
        }, 250);
    }

    function selectQuickAgendaType(typeId) {
        document.getElementById('inpQuickAgendaType').value = typeId;
        document.querySelectorAll('.agenda-type-btn').forEach(function(b) {
            b.className = 'btn btn-sm w-100 rounded-3 py-1.5 px-2 fw-bold text-start border agenda-type-btn bg-white text-dark';
        });
        var activeBtn = document.getElementById('btnType' + typeId);
        if (activeBtn) {
            activeBtn.className = 'btn btn-sm w-100 rounded-3 py-1.5 px-2 fw-bold text-start border border-dark agenda-type-btn bg-warning bg-opacity-25 text-dark shadow-xs';
        }
        var titleInp = document.getElementById('inpQuickAgendaTitle');
        var chkRoom = document.getElementById('chkQuickOpenRoom');
        if (titleInp) {
            if (typeId === 4) {
                titleInp.placeholder = 'Örn: Ortakla arsa payı ve ödeme planı şirket içi yazışması...';
                if (chkRoom) chkRoom.checked = false;
            } else if (typeId === 5) {
                titleInp.placeholder = 'Örn: X Firması Ziyareti / Belediye İmar Müdürlüğü Görüşmesi...';
                if (chkRoom) chkRoom.checked = true;
            } else if (typeId === 1) {
                titleInp.placeholder = 'Örn: Bina Temsilcisi ve Maliklerle Sözleşme Toplantısı...';
                if (chkRoom) chkRoom.checked = true;
            } else {
                titleInp.placeholder = 'Örn: Kaba İnşaat Kalıp / Demir Ekibi Saha Kararları...';
                if (chkRoom) chkRoom.checked = true;
            }
        }
    }

    function setQuickCreateDate(addDays) {
        var d = new Date();
        d.setDate(d.getDate() + addDays);
        var yyyy = d.getFullYear();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        document.getElementById('inpQuickAgendaDate').value = yyyy + '-' + mm + '-' + dd;
    }

    function openRescheduleModal(recordId, title, currentDateStr, currentTimeStr) {
        document.getElementById('modalRescheduleRecordId').value = recordId;
        document.getElementById('modalRescheduleTitle').value = title;
        document.getElementById('modalRescheduleDate').value = currentDateStr || '';
        document.getElementById('modalRescheduleTime').value = currentTimeStr || '11:00';
        var chk = document.getElementById('chkCreateNewSession');
        if (chk) chk.checked = false;
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('rescheduleModal'));
        modal.show();
    }

    function shiftRescheduleDate(daysToAdd) {
        var d = new Date();
        d.setDate(d.getDate() + daysToAdd);
        var yyyy = d.getFullYear();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        document.getElementById('modalRescheduleDate').value = yyyy + '-' + mm + '-' + dd;
    }

    function openQuickConcludeModal(recordId, title) {
        document.getElementById('modalConcludeRecordId').value = recordId;
        document.getElementById('modalConcludeTitle').value = title;
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('quickConcludeModal'));
        modal.show();
    }

    // WhatsApp Otomatik Hatırlatıcı & Canlı Evrak Çantası Gönder
    function sendWhatsAppReminder(phone, clientName, projectName, meetingTitle, dateStr, guestUrl) {
        if (!phone) {
            alert('Muhatabın telefon numarası bulunamadı.');
            return;
        }
        var cleanPhone = phone.replace(/[^0-9]/g, '');
        if (cleanPhone.startsWith('0')) cleanPhone = '90' + cleanPhone.substring(1);
        else if (!cleanPhone.startsWith('90')) cleanPhone = '90' + cleanPhone;

        var msg = 'Sayın ' + (clientName || 'Yetkili') + ',\n\n' +
                  '🏢 *' + projectName + '* kapsamında;\n' +
                  '📋 *' + meetingTitle + '* görüşmemiz *' + dateStr + '* tarihinde gerçekleştirilecektir.\n\n';

        if (guestUrl) {
            msg += '📱 Görüşülecek konu başlıklarını ve yüklenen belgeleri (üye olmadan) canlı incelemek için bağlantınız:\n' + guestUrl + '\n\n';
        }

        msg += 'Görüşmek üzere, iyi çalışmalar dileriz.';

        var waUrl = 'https://api.whatsapp.com/send?phone=' + cleanPhone + '&text=' + encodeURIComponent(msg);
        window.open(waUrl, '_blank');
    }
</script>
