@model GMK360.Core.Entities.Construction.AgendaRecord
@using GMK360.Core.Entities
@using GMK360.Core.Entities.Construction
@{
    ViewData["Title"] = "Canlı Konu & Dijital Evrak Masası: " + Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int participantId = ViewBag.ParticipantId ?? 0;
    string participantToken = ViewBag.ParticipantToken as string ?? Context.Request.Query["token"].ToString() ?? "";
    var participantContact = ViewBag.ParticipantContact as AgencyPhonebook;
    string participantName = participantContact?.Name ?? "Katılımcı / Muhatap";
    string participantRole = participantContact?.Tags ?? "Davetli";
    string participantNotes = ViewBag.ParticipantNotes ?? "";
    var topicDocs = ViewBag.TopicDocuments as List<DocumentArchive> ?? new List<DocumentArchive>();
    var sentDocs = topicDocs.Where(d => d.Category == "Gönderilen Belge").ToList();
    var receivedDocs = topicDocs.Where(d => d.Category != "Gönderilen Belge").ToList();
    var items = Model.Items?.OrderBy(i => i.OrderNo).ToList() ?? new List<AgendaItem>();
}

<div class="container py-3 px-2 px-md-3" style="max-width: 860px;">

    @if (TempData["GuestSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 py-2 px-3 mb-3 shadow-xs small fw-semibold" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["GuestSuccess"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["GuestError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-3 shadow-xs small fw-semibold" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["GuestError"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. ÜST KÜNYE & PWA GÖLGE KULLANICI KARTI -->
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-3 border-top border-4 border-primary">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
            <div class="d-flex align-items-center gap-1.5 flex-wrap" style="font-size: 0.76rem;">
                @if (Model.Project != null)
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2.5 py-1 rounded-pill fw-bold">
                        <i class="bi bi-building me-1"></i>@Model.Project.Name
                    </span>
                }
                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2.5 py-1 rounded-pill fw-bold">
                    <i class="bi bi-calendar3 me-1"></i>@Model.EventDate.ToString("dd.MM.yyyy")
                    <i class="bi bi-clock ms-1 me-1"></i>@Model.EventDate.ToString("HH:mm")
                </span>
                @if (Model.RecordTypeId == 3)
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-bold">
                        <i class="bi bi-camera-video-fill me-1"></i>Saha Olay / Denetim Masası
                    </span>
                }
                else
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-bold">
                        <i class="bi bi-broadcast me-1"></i>Canlı Konu & Dijital Çanta
                    </span>
                }
            </div>

            <div class="badge bg-light text-dark border px-2.5 py-1 rounded-pill" style="font-size: 0.74rem;">
                <i class="bi bi-person-badge-fill text-primary me-1"></i>@participantName <span class="text-muted">(@participantRole)</span>
            </div>
        </div>

        <h4 class="fw-bold text-dark mb-1 fs-5 fs-md-4">@Model.Title</h4>
        <small class="text-muted d-block mb-2" style="font-size: 0.76rem;">
            Bu özel bağlantı üzerinden paylaşılan evrakları, saha fotoğraf/videolarını inceleyebilir; sorularınızı, yanıtlarınızı veya 2. randevu talebinizi doğrudan iletebilirsiniz.
        </small>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="p-2.5 rounded-3 bg-light border text-dark small mt-1" style="white-space: pre-wrap; line-height: 1.5; font-size: 0.82rem;">
                <strong class="text-primary d-block mb-0.5"><i class="bi bi-journal-bookmark-fill me-1"></i>Konu Özeti & Karar Notları:</strong>@Model.Notes
            </div>
        }
    </div>

    <!-- 2. DİJİTAL EVRAK, FOTOĞRAF & VİDEO ÇANTASI (KAYBOLMAYAN ARŞİV) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom flex-wrap gap-2">
            <div>
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5" style="font-size: 0.90rem;">
                    <i class="bi bi-folder2-open text-warning fs-5"></i>
                    <span>Dijital Evrak, Fotoğraf & Video Çantası</span>
                </h6>
                <small class="text-muted" style="font-size: 0.72rem;">Toplantıda size sunulan belgeler ve bu konuya eklenen tüm fotoğraf, video ve resmi evraklar</small>
            </div>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.74rem;">
                Toplam @topicDocs.Count Belge / Medya
            </span>
        </div>

        @if (!topicDocs.Any())
        {
            <div class="text-center py-3 px-2 bg-light rounded-3 border border-dashed text-muted small" style="font-size: 0.78rem;">
                <i class="bi bi-file-earmark-medical fs-4 d-block mb-1 text-secondary"></i>
                Bu konuda henüz paylaşılmış bir evrak veya medya kaydı bulunmuyor. Aşağıdaki formdan siz de belge veya fotoğraf ekleyebilirsiniz.
            </div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var doc in topicDocs)
                {
                    string ext = (doc.FileExtension ?? "").ToLowerInvariant();
                    bool isVideo = ext == ".mp4" || ext == ".mov" || ext == ".webm" || ext == ".avi";
                    bool isImage = ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".webp";
                    bool isPdf = ext == ".pdf";
                    bool isSentByFirm = doc.Category == "Gönderilen Belge";
                    string cleanDocTitle = !string.IsNullOrWhiteSpace(doc.Title) ? doc.Title : doc.FileName;

                    <div class="col-md-6">
                        <div class="border rounded-3 p-2.5 h-100 d-flex flex-column justify-content-between @(isSentByFirm ? "bg-primary bg-opacity-10 border-primary-subtle" : "bg-light")">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                    <span class="badge @(isSentByFirm ? "bg-primary text-white" : "bg-dark text-white") rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                        @(isSentByFirm ? "🏢 Firma Tarafından Sunulan" : "📥 Alınan / Saha Kanıtı")
                                    </span>
                                    <small class="text-muted" style="font-size: 0.68rem;">@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div class="fw-bold text-dark mb-1.5" style="font-size: 0.84rem;">
                                    <i class="bi @(isVideo ? "bi-camera-video-fill text-danger" : (isImage ? "bi-image-fill text-info" : (isPdf ? "bi-file-earmark-pdf-fill text-danger" : "bi-file-earmark-text-fill text-primary"))) me-1"></i>
                                    @cleanDocTitle
                                </div>

                                @if (isVideo)
                                {
                                    <div class="mb-2">
                                        <video controls playsinline class="w-100 rounded-2 border bg-black" style="max-height: 190px;">
                                            <source src="@doc.DocumentUrl" />
                                            Tarayıcınız video oynatmayı desteklemiyor.
                                        </video>
                                    </div>
                                }
                                else if (isImage)
                                {
                                    <div class="mb-2 text-center bg-white rounded-2 border p-1">
                                        <a href="@doc.DocumentUrl" target="_blank">
                                            <img src="@doc.DocumentUrl" class="img-fluid rounded-2" style="max-height: 140px; object-fit: cover;" alt="@cleanDocTitle" />
                                        </a>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                                <small class="text-muted text-truncate" style="font-size: 0.68rem; max-width: 160px;">@doc.FileName</small>
                                <a href="@doc.DocumentUrl" target="_blank" download class="btn btn-sm btn-primary rounded-pill px-3 py-0.5 fw-bold shadow-xs" style="font-size: 0.72rem;">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Aç / İndir
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 3. CANLI KONU AKIŞI, SORU-CEVAP & MÜZAKERE GEÇMİŞİ (SOHBET GİBİ) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
            <div>
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5" style="font-size: 0.90rem;">
                    <i class="bi bi-chat-dots-fill text-primary fs-5"></i>
                    <span>Canlı Konu Akışı, Sorular & Firma Cevapları</span>
                </h6>
                <small class="text-muted" style="font-size: 0.72rem;">Komşuların soruları, saha tespitleri ve firma yetkilisinin yanıtları</small>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 0.72rem;" onclick="window.location.reload();">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
        </div>

        <!-- DİYALOG ZAMAN TÜNELİ -->
        <div class="d-flex flex-column gap-2 mb-3 p-2 rounded-3 bg-light border" style="max-height: 420px; overflow-y: auto;">
            @if (!items.Any())
            {
                <div class="text-center py-4 text-muted small">
                    Henüz yazılı bir diyalog veya soru kaydı girilmedi. İlk soruyu veya açıklamayı aşağıdan gönderebilirsiniz.
                </div>
            }
            else
            {
                @foreach (var item in items)
                {
                    bool isFirm = item.TopicTitle != null && item.TopicTitle.Trim().Equals("Biz", StringComparison.OrdinalIgnoreCase);
                    var rowDocs = topicDocs.Where(d => d.SourceRecordId == item.Id).ToList();
                    string msgContent = !string.IsNullOrWhiteSpace(item.PresentationText) ? item.PresentationText : item.TopicTitle;
                    if (string.IsNullOrWhiteSpace(msgContent) && !rowDocs.Any()) continue;

                    <div class="d-flex @(isFirm ? "justify-content-start" : "justify-content-end")">
                        <div class="p-2.5 rounded-3 shadow-xs border @(isFirm ? "bg-white border-primary-subtle" : "bg-primary bg-opacity-10 border-primary")" style="max-width: 88%; min-width: 220px;">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-1 pb-0.5 border-bottom">
                                <span class="fw-bold @(isFirm ? "text-primary" : "text-dark")" style="font-size: 0.74rem;">
                                    @(isFirm ? "🏢 Firma Yetkilisi / Merkez" : $"👤 {participantName}")
                                </span>
                                <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.64rem;">#@item.OrderNo</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(msgContent) && msgContent != "Katılımcı" && msgContent != "Biz")
                            {
                                <div class="text-dark" style="white-space: pre-wrap; font-size: 0.83rem; line-height: 1.45;">@msgContent</div>
                            }

                            @if (rowDocs.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mt-1.5 pt-1 border-top">
                                    @foreach (var rDoc in rowDocs)
                                    {
                                        string rTitle = !string.IsNullOrWhiteSpace(rDoc.Title) ? rDoc.Title : rDoc.FileName;
                                        <a href="@rDoc.DocumentUrl" target="_blank" class="badge bg-white text-primary border border-primary-subtle rounded-pill px-2 py-1 text-decoration-none fw-bold" style="font-size: 0.70rem;">
                                            <i class="bi bi-paperclip me-1"></i>@rTitle
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- YENİ SORU / YANIT / FOTOĞRAF / VİDEO EKLEME FORMU -->
        <form asp-action="GuestAddEntry" asp-controller="Agenda" method="post" enctype="multipart/form-data" class="p-2.5 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@participantToken" />

            <label class="form-label fw-bold text-dark small mb-1" style="font-size: 0.80rem;">
                <i class="bi bi-reply-fill text-primary me-1"></i>Soru Sor, Açıklama Yaz veya Fotoğraf/Video/Belge Ekle
            </label>
            <textarea name="messageText" class="form-control form-control-sm rounded-3 mb-2" rows="2"
                      placeholder="Komşularınızla konuşurken çıkan soruları, şantiye açıklamanızı veya notunuzu buraya yazın..."></textarea>

            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="docTitle" class="form-control form-control-sm rounded-pill"
                           placeholder="Dosya ekliyorsanız adı (Örn: Tapu, Şaft Fotoğrafı)" style="font-size: 0.76rem;" />
                </div>
                <div class="col-md-4">
                    <input type="file" name="mediaFile" class="form-control form-control-sm rounded-pill"
                           accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx" style="font-size: 0.74rem;" />
                </div>
                <div class="col-md-3 text-end">
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold shadow-xs py-1.5" style="font-size: 0.78rem;">
                        <i class="bi bi-send-fill me-1"></i>Masaya Gönder
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- 4. İKİNCİ RANDEVU / DEVAM GÖRÜŞMESİ TALEP ET KARTI (TARİH VE SAAT AYRI INPUT) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3 border-start border-4 border-warning">
        <div class="d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#collapseRequestSession">
            <div>
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5" style="font-size: 0.88rem;">
                    <i class="bi bi-calendar-plus-fill text-warning fs-5"></i>
                    <span>2. Randevu / Devam Görüşmesi Talep Et</span>
                </h6>
                <small class="text-muted" style="font-size: 0.72rem;">Diğer maliklerle veya ekiple uygun olduğunuz tarihi ve saati firmaya iletin</small>
            </div>
            <span class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 py-0.5" style="font-size: 0.74rem;">
                Tarih Seç <i class="bi bi-chevron-down ms-1"></i>
            </span>
        </div>

        <div id="collapseRequestSession" class="collapse mt-3 pt-2 border-top">
            <form asp-action="GuestRequestNextSession" asp-controller="Agenda" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@participantToken" />
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-4">
                        <label class="form-label small fw-bold text-dark mb-1" style="font-size: 0.75rem;">Talep Edilen Tarih <span class="text-danger">*</span></label>
                        <input type="date" name="requestedDate" class="form-control form-control-sm rounded-pill fw-bold" value="@DateTime.Today.AddDays(2).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1" style="font-size: 0.75rem;">Saat <span class="text-danger">*</span></label>
                        <input type="time" name="requestedTime" class="form-control form-control-sm rounded-pill fw-bold" value="14:00" required />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label small fw-bold text-dark mb-1" style="font-size: 0.75rem;">Randevu Notu / Katılacak Kişiler</label>
                        <input type="text" name="requestNote" class="form-control form-control-sm rounded-pill" placeholder="Örn: Diğer 4 kat malikiyle birlikte geleceğiz..." />
                    </div>
                    <div class="col-12 text-end mt-2">
                        <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4 py-1 btn-sm shadow-xs">
                            <i class="bi bi-calendar-check-fill me-1"></i>2. Randevu Talebini Firmaya İlet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 5. KİŞİSEL HATIRLATMA NOT KARTI (CANLI OTO-KAYIT) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-1.5 pb-1 border-bottom">
            <span class="fw-bold text-dark small" style="font-size: 0.82rem;">
                <i class="bi bi-pencil-square text-primary me-1"></i>Özel Not Defteriniz (Otomatik Kaydedilir)
            </span>
            <span id="saveStatus" class="badge bg-success bg-opacity-15 text-success border border-success px-2 py-0 small fw-bold" style="display:none; font-size: 0.68rem;">
                <i class="bi bi-check-circle-fill me-1"></i>Kaydedildi
            </span>
        </div>
        <textarea id="participantNotes" class="form-control rounded-3" rows="2" placeholder="Kendiniz için tutmak istediğiniz özel notları buraya yazabilirsiniz..." style="font-size: 0.82rem;">@participantNotes</textarea>
    </div>

</div>

@section Scripts {
    <script>
        let timeout = null;
        document.getElementById('participantNotes').addEventListener('input', function() {
            clearTimeout(timeout);
            const notes = this.value;
            timeout = setTimeout(function() {
                const formData = new FormData();
                formData.append('participantId', @participantId);
                formData.append('notes', notes);
                
                fetch('@Url.Action("SaveParticipantNotes", "Agenda")', {
                    method: 'POST',
                    body: formData
                }).then(response => {
                    if(response.ok) {
                        const status = document.getElementById('saveStatus');
                        status.style.display = 'inline-block';
                        setTimeout(() => { status.style.display = 'none'; }, 2500);
                    }
                });
            }, 700);
        });
    </script>
}