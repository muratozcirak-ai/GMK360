@model GMK360.Core.Entities.Construction.AgendaRecord
@{
    ViewData["Title"] = "Toplantı Gündemi: " + Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int participantId = ViewBag.ParticipantId;
    string participantNotes = ViewBag.ParticipantNotes ?? "";
}

<div class="container py-3 px-2 px-md-3" style="max-width: 800px;">

    <!-- ÜST KÜNYE KARTI -->
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-3">
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap" style="font-size: 0.78rem;">
            @if (Model.Project != null)
            {
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1 rounded-pill fw-bold">
                    <i class="bi bi-building me-1"></i>@Model.Project.Name
                </span>
            }
            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-1 rounded-pill fw-bold">
                <i class="bi bi-calendar-event me-1"></i>@Model.EventDate.ToString("dd MMMM yyyy HH:mm")
            </span>
        </div>

        <h4 class="fw-bold text-dark mb-2 fs-5 fs-md-4">@Model.Title</h4>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="p-3 rounded-3 bg-light border text-secondary small" style="white-space: pre-wrap; line-height: 1.5; font-size: 0.84rem;">
                @Model.Notes
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mt-3 text-center">
                <a href="@Model.ImageUrl" target="_blank" title="Büyütmek için tıklayın">
                    <img src="@Model.ImageUrl" class="img-fluid rounded-3 border shadow-xs" style="max-height: 220px; object-fit: cover;" alt="Genel Toplantı Görseli" />
                </a>
            </div>
        }
    </div>

    <!-- GÜNDEM MADDELERİ AKORDEONU -->
    <div class="d-flex align-items-center justify-content-between mb-2 px-1">
        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1" style="font-size: 0.88rem;">
            <i class="bi bi-list-task text-primary"></i>
            <span>Gündem Maddeleri & Sunumlar</span>
        </h6>
        <span class="badge bg-light text-dark border px-2 py-0 rounded-pill small">
            @(Model.Items?.Count ?? 0) Madde
        </span>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="accordion mb-3" id="agendaAccordion">
            @foreach (var item in Model.Items.OrderBy(i => i.OrderNo))
            {
                <div class="accordion-item border rounded-3 mb-2 overflow-hidden shadow-xs">
                    <h2 class="accordion-header" id="heading_@item.Id">
                        <button class="accordion-button collapsed py-2 px-3 fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@item.Id" aria-expanded="false" aria-controls="collapse_@item.Id" style="font-size: 0.86rem;">
                            <span class="badge bg-primary text-white rounded-circle p-1 me-2 d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 0.72rem;">
                                @item.OrderNo
                            </span>
                            <span>@item.TopicTitle</span>
                        </button>
                    </h2>
                    <div id="collapse_@item.Id" class="accordion-collapse collapse" aria-labelledby="heading_@item.Id" data-bs-parent="#agendaAccordion">
                        <div class="accordion-body p-3 bg-light bg-opacity-50">
                            <div class="row g-2">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <div class="col-md-5 text-center">
                                        <a href="@item.ImageUrl" target="_blank" title="Büyüt">
                                            <img src="@item.ImageUrl" class="img-fluid rounded-3 border shadow-xs" style="max-height: 160px; object-fit: cover;" />
                                        </a>
                                    </div>
                                }
                                <div class="col-md-@(!string.IsNullOrEmpty(item.ImageUrl) ? "7" : "12")">
                                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.72rem;">SUNUM & DETAY:</small>
                                    <div class="text-secondary small" style="white-space: pre-wrap; line-height: 1.45; font-size: 0.82rem;">
                                        @(string.IsNullOrWhiteSpace(item.PresentationText) ? "Bu konu için sunum metni girilmedi." : item.PresentationText)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info rounded-3 p-3 small mb-3">Bu toplantı için henüz alt konu maddesi açılmadı.</div>
    }

    <!-- KİŞİSEL NOT KARTI (CANLI OTO-KAYIT) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
            <span class="fw-bold text-dark small" style="font-size: 0.82rem;">
                <i class="bi bi-pencil-square text-primary me-1"></i>Kişisel Notunuz & Sorularınız
            </span>
            <span id="saveStatus" class="badge bg-success bg-opacity-15 text-success border border-success px-2 py-0 small fw-bold" style="display:none; font-size: 0.68rem;">
                <i class="bi bi-check-circle-fill me-1"></i>Otomatik Kaydedildi
            </span>
        </div>
        <p class="text-muted mb-2" style="font-size: 0.74rem;">
            Buraya alacağınız notlar sadece toplantı yöneticisi ve sizin tarafınızdan görülebilir.
        </p>
        <textarea id="participantNotes" class="form-control rounded-3 font-monospace" rows="4" placeholder="Toplantı sırasında sormak istediğiniz soruları veya kendi notlarınızı buraya yazın..." style="font-size: 0.84rem; line-height: 1.45;">@participantNotes</textarea>
    </div>

</div>

@section Scripts {
    <script>
        let timeout = null;
        document.getElementById('participantNotes').addEventListener('input', function() {
            clearTimeout(timeout);
            const notes = this.value;
            timeout = setTimeout(function() {
                const formData = new FormData();
                formData.append('participantId', @participantId);
                formData.append('notes', notes);
                
                fetch('@Url.Action("SaveParticipantNotes", "Agenda")', {
                    method: 'POST',
                    body: formData
                }).then(response => {
                    if(response.ok) {
                        const status = document.getElementById('saveStatus');
                        status.style.display = 'inline-block';
                        setTimeout(() => { status.style.display = 'none'; }, 2500);
                    }
                });
            }, 700);
        });
    </script>
}