@model GMK360.Core.Entities.Construction.AgendaRecord
@{
    ViewData["Title"] = "Toplantı Gündemi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int participantId = ViewBag.ParticipantId;
    string participantNotes = ViewBag.ParticipantNotes ?? "";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3 class="card-title text-primary">@Model.Title</h3>
            <p class="text-muted"><i class="bi bi-calendar"></i> @Model.EventDate.ToString("dd.MM.yyyy HH:mm")</p>
            <hr />
            <p style="white-space:pre-wrap;">@Model.Notes</p>
            
            @if(!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-3 text-center">
                    <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height: 300px;" alt="Genel Toplantı Görseli" />
                </div>
            }
        </div>
    </div>

    <h4>Gündem Maddeleri / Alt Konular</h4>
    
    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="accordion" id="agendaAccordion">
            @foreach (var item in Model.Items.OrderBy(i => i.OrderNo))
            {
                <div class="accordion-item mb-2 border">
                    <h2 class="accordion-header" id="heading_@item.Id">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@item.Id" aria-expanded="false" aria-controls="collapse_@item.Id">
                            <strong>#@item.OrderNo - @item.TopicTitle</strong>
                        </button>
                    </h2>
                    <div id="collapse_@item.Id" class="accordion-collapse collapse" aria-labelledby="heading_@item.Id" data-bs-parent="#agendaAccordion">
                        <div class="accordion-body">
                            <div class="row">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <div class="col-md-4 text-center mb-3">
                                        <img src="@item.ImageUrl" class="img-fluid rounded" style="max-height: 200px;" />
                                    </div>
                                }
                                <div class="col-md-@(!string.IsNullOrEmpty(item.ImageUrl) ? "8" : "12")">
                                    <h6 class="text-secondary">Sunum / Hazırlık:</h6>
                                    <p style="white-space:pre-wrap;">@item.PresentationText</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">Bu toplantı için henüz bir alt konu başlığı eklenmemiştir.</div>
    }

    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-light">
            <strong><i class="bi bi-pencil-square"></i> Kendi Notunuz / Yorumunuz</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small">Buraya yazacağınız notlar sadece toplantı yöneticisine ve size görünür. Yazdığınız anda otomatik kaydedilir.</p>
            <textarea id="participantNotes" class="form-control" rows="4" placeholder="Notunuzu buraya yazın...">@participantNotes</textarea>
            <div id="saveStatus" class="mt-2 text-success small" style="display:none;"><i class="bi bi-check-circle"></i> Kaydedildi</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timeout = null;
        document.getElementById('participantNotes').addEventListener('input', function() {
            clearTimeout(timeout);
            const notes = this.value;
            timeout = setTimeout(function() {
                const formData = new FormData();
                formData.append('participantId', @participantId);
                formData.append('notes', notes);
                
                fetch('@Url.Action("SaveParticipantNotes", "Agenda")', {
                    method: 'POST',
                    body: formData
                }).then(response => {
                    if(response.ok) {
                        const status = document.getElementById('saveStatus');
                        status.style.display = 'block';
                        setTimeout(() => { status.style.display = 'none'; }, 2000);
                    }
                });
            }, 1000); // 1 saniye debounce
        });
    </script>
}
