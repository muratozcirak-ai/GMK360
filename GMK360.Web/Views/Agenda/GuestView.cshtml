</div>

@section Scripts {
    <script>
        // 1. PWA Service Worker Kaydı & Telefona İndirme (beforeinstallprompt)
        let deferredPwaPrompt = null;
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(function(err) {
                console.log('SW register info:', err);
            });
        }

        window.addEventListener('beforeinstallprompt', function(e) {
            e.preventDefault();
            deferredPwaPrompt = e;
            const btn = document.getElementById('btnInstallPwaGuest');
            if (btn) {
                btn.classList.add('btn-warning');
            }
        });

        function triggerGuestPwaInstall() {
            if (deferredPwaPrompt) {
                deferredPwaPrompt.prompt();
                deferredPwaPrompt.userChoice.then(function() {
                    deferredPwaPrompt = null;
                });
            } else {
                const guide = document.getElementById('pwaManualGuideBox');
                if (guide) {
                    guide.style.display = (guide.style.display === 'none') ? 'block' : 'none';
                }
            }
        }

        // 2. Gölge Kullanıcının Katıldığı Konuları Telefon Hafızasında (localStorage) Tutma
        (function syncGuestTopicMemory() {
            try {
                const currentToken = '@Html.Raw(participantToken)';
                const currentTitle = '@Html.Raw((Model.Title ?? "Toplantı / Konu").Replace("'", "\\'"))';
                const currentProject = '@Html.Raw((Model.Project?.Name ?? "Genel").Replace("'", "\\'"))';
                const currentDate = '@Model.EventDate.ToString("dd.MM.yyyy HH:mm")';

                let saved = JSON.parse(localStorage.getItem('gmk360_guest_topics') || '[]');
                if (currentToken) {
                    localStorage.setItem('gmk360_last_guest_token', currentToken);
                    saved = saved.filter(x => x.token !== currentToken);
                    saved.unshift({
                        token: currentToken,
                        title: currentTitle,
                        project: currentProject,
                        date: currentDate
                    });
                    if (saved.length > 15) saved = saved.slice(0, 15);
                    localStorage.setItem('gmk360_guest_topics', JSON.stringify(saved));
                }

                const badge = document.getElementById('savedTopicsCountBadge');
                if (badge) badge.innerText = saved.length;

                const container = document.getElementById('savedTopicsListContainer');
                if (container) {
                    container.innerHTML = saved.map(function(item) {
                        const isCurrent = item.token === currentToken;
                        return `<a href="/Agenda/Guest?token=${item.token}" class="badge ${isCurrent ? 'bg-warning text-dark' : 'bg-white text-dark'} text-decoration-none px-2.5 py-1.5 rounded-pill d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <i class="bi ${isCurrent ? 'bi-broadcast-pin' : 'bi-folder2-open text-primary'}"></i>
                            <span><b>${item.project}:</b> ${item.title}</span>
                        </a>`;
                    }).join('');
                }
            } catch (e) {
                console.warn('Guest memory error:', e);
            }
        })();

        // 3. Kişisel Not Otomatik Kayıt
        let timeout = null;
        document.getElementById('participantNotes').addEventListener('input', function() {
            clearTimeout(timeout);
            const notes = this.value;
            timeout = setTimeout(function() {
                const formData = new FormData();
                formData.append('participantId', @participantId);
                formData.append('notes', notes);
                
                fetch('@Url.Action("SaveParticipantNotes", "Agenda")', {
                    method: 'POST',
                    body: formData
                }).then(response => {
                    if(response.ok) {
                        const status = document.getElementById('saveStatus');
                        status.style.display = 'inline-block';
                        setTimeout(() => { status.style.display = 'none'; }, 2500);
                    }
                });
            }, 700);
        });
    </script>
}