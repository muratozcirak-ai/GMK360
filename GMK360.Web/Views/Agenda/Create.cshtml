@model GMK360.Core.Entities.Construction.AgendaRecord
@{
    ViewData["Title"] = "Yeni Toplantı & Müzakere Masası Başlat";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="container-fluid py-2 px-2 px-md-3">

    <!-- KOMPAKT BAŞLIK VE GERİ BUTONU -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-2 p-md-3 mb-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning bg-opacity-25 text-dark rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-people-fill text-warning fs-6"></i>
                </span>
                <div>
                    <h5 class="mb-0 fw-bold text-dark fs-6 fs-md-5">Yeni Toplantı & Müzakere Başlat</h5>
                    <small class="text-muted" style="font-size: 0.72rem;">Toplantı konusu, katılımcılar ve tartışılacak ilk gündem maddeleri</small>
                </div>
            </div>
            <a href="/Agenda/Meetings" class="btn btn-outline-secondary rounded-pill px-3 py-1 btn-sm" style="font-size: 0.80rem;">
                <i class="bi bi-arrow-left me-1"></i>Listeye Dön
            </a>
        </div>
    </div>

    <!-- FORM KARTI -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-2 p-md-3">
        <form asp-action="Create" enctype="multipart/form-data" id="agendaForm">
            @Html.AntiForgeryToken()
            <div class="row g-2 g-md-3">
                <!-- Sol Kolon: Temel Bilgiler -->
                <div class="col-lg-8">
                    <div class="mb-2">
                        <label class="form-label fw-bold text-dark small mb-1">Toplantı Konusu / Müzakere Başlığı <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-sm rounded-2 fw-bold" placeholder="Örn: Malikler ile 1. Kentsel Dönüşüm İstişare Toplantısı" required />
                    </div>
                    
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small mb-1">Tarih ve Saat <span class="text-danger">*</span></label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control form-control-sm rounded-2 fw-bold" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small mb-1">Toplantı & Oturum Türü</label>
                            <select asp-for="RecordTypeId" class="form-select form-select-sm rounded-2">
                                <option value="1">Malik İstişare Toplantısı</option>
                                <option value="2">Taşeron Pazarlığı & İhale Masası</option>
                                <option value="3">Ortaklar & Mühendislik Koordinasyon</option>
                                <option value="4" selected>Genel Şantiye & Müzakere Masası</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">Genel Toplantı Amacı / Ön Bilgi Notu</label>
                        <textarea asp-for="Notes" class="form-control form-control-sm rounded-2" rows="2" placeholder="Toplantının ana amacı, tarafların ön beklentileri veya masada çözülmesi gereken kritik hususlar..."></textarea>
                    </div>
                    
                    <hr class="my-2" />
                    
                    <!-- ALT GÜNDEM MADDELERİ ALANI -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <span class="fw-bold text-dark small d-flex align-items-center gap-1">
                                <i class="bi bi-list-task text-primary"></i>
                                <span>Gündem Maddeleri & Tartışma Konuları</span>
                            </span>
                            <small class="text-muted d-block" style="font-size: 0.70rem;">Toplantı anında da yeni konu ekleyebilirsiniz</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0 fw-bold shadow-xs" onclick="addAgendaItem()" style="font-size: 0.76rem;">
                            <i class="bi bi-plus-circle me-1"></i>+ Yeni Konu
                        </button>
                    </div>
                    
                    <div id="agendaItemsContainer" class="d-flex flex-column gap-2">
                        <!-- JS ile eklenecek -->
                    </div>
                    
                    <div class="text-center py-3 bg-light rounded-3 border border-dashed mt-1" id="noItemsMsg">
                        <i class="bi bi-inbox text-muted fs-4"></i>
                        <p class="text-muted small mb-0 mt-1" style="font-size: 0.76rem;">Henüz alt konu eklenmedi. Masayı açtıktan sonra canlı olarak da ekleyebilirsiniz.</p>
                    </div>

                </div>

                <!-- Sağ Kolon: Bağlantılar ve Medya -->
                <div class="col-lg-4">
                    <div class="card bg-light border-0 rounded-3 p-2 mb-2">
                        <span class="fw-bold text-dark small mb-2 pb-1 border-bottom d-block" style="font-size: 0.80rem;">
                            <i class="bi bi-link-45deg text-primary me-1"></i>İlişkili Proje & Katılımcılar
                        </span>
                        
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-dark mb-1" style="font-size: 0.75rem;">Şantiye (Proje)</label>
                            <select asp-for="ProjectId" class="form-select form-select-sm rounded-2 select2" asp-items="ViewBag.ProjectId">
                                <option value="">-- Bağımsız İstişare --</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-dark mb-1" style="font-size: 0.75rem;">Görüşülecek Muhatap (Firma / Malik / Usta)</label>
                            <select asp-for="PhonebookId" class="form-select form-select-sm rounded-2 select2" asp-items="ViewBag.PhonebookId">
                                <option value="">-- Bağımsız Muhatap --</option>
                            </select>
                        </div>

                        <div class="mb-1">
                            <label class="form-label small fw-bold text-dark mb-1" style="font-size: 0.75rem;">Ek Katılımcılar (Çoklu Seçim)</label>
                            <select name="selectedParticipants" class="form-select form-select-sm rounded-2 select2" asp-items="ViewBag.ParticipantsList" multiple="multiple" data-placeholder="Katılımcıları seçin...">
                            </select>
                            <small class="text-muted mt-1 d-block" style="font-size: 0.68rem;">
                                Katılımcılara cep telefonundan canlı izleme bağlantısı sağlanır.
                            </small>
                        </div>
                    </div>

                    <div class="card bg-light border-0 rounded-3 p-2">
                        <span class="fw-bold text-dark small mb-1 pb-1 border-bottom d-block" style="font-size: 0.80rem;">
                            <i class="bi bi-image text-primary me-1"></i>Kapak / Belge Görseli (Opsiyonel)
                        </span>
                        <input type="file" name="imageFile" class="form-control form-control-sm rounded-2" accept="image/*" />
                        <small class="text-muted d-block mt-1" style="font-size: 0.68rem;">Vaziyet planı veya ön proje resmi.</small>
                    </div>
                </div>
            </div>

            <hr class="my-3" />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <a href="/Agenda/Meetings" class="btn btn-light rounded-pill px-3 btn-sm">İptal</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-1 fw-bold shadow-xs btn-sm d-flex align-items-center gap-1" style="font-size: 0.82rem;">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Toplantıyı Başlat & Masaya Gir ➔</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.select2) {
                $('.select2').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: 'Seçim yapınız...'
                });
            }
        });

        let itemIndex = 0;

        function addAgendaItem() {
            $('#noItemsMsg').hide();
            
            let html = `
                <div class="card border rounded-3 p-2 bg-white shadow-xs agenda-item-card position-relative" id="item-${itemIndex}">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-1 rounded-circle p-0 d-flex align-items-center justify-content-center" onclick="removeItem(${itemIndex})" style="width: 22px; height: 22px;" title="Kaldır">
                        <i class="bi bi-x" style="font-size: 0.80rem;"></i>
                    </button>
                    
                    <span class="fw-bold text-primary mb-1 d-block" style="font-size: 0.80rem;">#${itemIndex + 1}. Gündem Maddesi</span>
                    
                    <div class="row g-1">
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-dark mb-0" style="font-size: 0.72rem;">Konu Başlığı <span class="text-danger">*</span></label>
                            <input type="text" name="itemTopicTitle" class="form-control form-control-sm rounded-2" placeholder="Örn: 1. Konu (Avan Mimari ve Daire Dağılımı)" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-dark mb-0" style="font-size: 0.72rem;">Sunum / Açıklama Metni</label>
                            <textarea name="itemPresentationText" class="form-control form-control-sm rounded-2" rows="2" placeholder="Konuyla ilgili açıklama ve müzakere edilecek maddeler..."></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-dark mb-0" style="font-size: 0.72rem;">Konuya Özel Çizim / Belge</label>
                            <input type="file" name="itemImage_${itemIndex}" class="form-control form-control-sm rounded-2" accept="image/*" />
                        </div>
                    </div>
                </div>
            `;
            
            $('#agendaItemsContainer').append(html);
            itemIndex++;
        }

        function removeItem(id) {
            $('#item-' + id).remove();
            if($('.agenda-item-card').length === 0) {
                $('#noItemsMsg').show();
            }
        }
    </script>
}