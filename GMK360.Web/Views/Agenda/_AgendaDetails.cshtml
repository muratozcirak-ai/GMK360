@using GMK360.Core.Entities.Construction
@model AgendaRecord

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h4 class="mb-0 text-primary">@Model.Title</h4>
        <p class="text-muted small mb-0"><i class="bi bi-clock"></i> @Model.EventDate.ToString("dd MMMM yyyy HH:mm")</p>
    </div>
    <div class="card-body">
        
        <div class="mb-4">
            <h6 class="text-secondary fw-bold text-uppercase" style="font-size:0.85rem;">Genel Toplantı Notu / Konusu</h6>
            <p style="white-space: pre-wrap;">@Model.Notes</p>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <h6 class="text-secondary fw-bold text-uppercase mb-3" style="font-size:0.85rem;">Toplantı Gündem Maddeleri (Slaytlar)</h6>
            
            <div class="accordion" id="agendaAccordion">
                @foreach (var item in Model.Items.OrderBy(i => i.OrderNo))
                {
                    var headingId = "heading" + item.Id;
                    var collapseId = "collapse" + item.Id;
                    
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed rounded fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" style="background-color: #f8f9fa;">
                                @item.OrderNo. @item.TopicTitle
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#agendaAccordion">
                            <div class="accordion-body bg-white">
                                <div class="row">
                                    <div class="col-md-7">
                                        <h6 class="text-muted"><i class="bi bi-file-earmark-text"></i> Sunum Metni</h6>
                                        <p style="white-space: pre-wrap;">@item.PresentationText</p>
                                    </div>
                                    <div class="col-md-5 text-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <a href="@item.ImageUrl" data-lightbox="agenda-gallery-@item.Id" data-title="@item.TopicTitle">
                                                <img src="@item.ImageUrl" alt="@item.TopicTitle" class="img-fluid rounded shadow-sm" style="max-height: 200px; object-fit: cover; cursor: zoom-in;" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded p-4 text-muted border border-dashed">
                                                <i class="bi bi-image fs-1"></i>
                                                <br />Görsel Yok
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                <hr class="my-4" />
                                
                                <h6 class="text-danger fw-bold"><i class="bi bi-mic"></i> Toplantı Cevapları / Alınan Kararlar</h6>
                                <p class="small text-muted mb-2">Bu alana yazılan notlar toplantı anında anlık olarak kaydedilir.</p>
                                <textarea class="form-control live-note-input" data-item-id="@item.Id" rows="4" placeholder="Masada alınan kararları buraya yazın...">@item.LiveMeetingNotes</textarea>
                                <div class="text-end mt-1">
                                    <small class="text-success save-status" id="status-@item.Id" style="display:none;"><i class="bi bi-check-circle"></i> Kaydedildi</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center border-dashed p-4">
                <i class="bi bi-inbox fs-2 text-muted"></i>
                <p class="mb-0 mt-2 text-muted">Bu toplantı için henüz bir alt gündem / slayt maddesi eklenmemiş.</p>
            </div>
        }

    </div>
</div>
