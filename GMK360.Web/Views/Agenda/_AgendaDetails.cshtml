@using GMK360.Core.Entities.Construction
@model AgendaRecord

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            @{
                string badgeClass = Model.StatusId == AgendaConstants.StatusTamamlandi ? "bg-success" : 
                                    Model.StatusId == AgendaConstants.StatusIptal ? "bg-danger" : "bg-primary";
                string statusText = Model.StatusId == AgendaConstants.StatusTamamlandi ? "Tamamlandı / Karşılandı" : 
                                    Model.StatusId == AgendaConstants.StatusIptal ? "İptal Edildi" : "Planlandı (Bekliyor)";
            }
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge @badgeClass rounded-pill px-3 py-1 fw-bold" id="detailStatusBadge">@statusText</span>
                @if (Model.Title != null && Model.Title.Contains("Saha Keşfi"))
                {
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-calendar2-check me-1"></i>Keşif Randevusu</span>
                }
                else if (Model.Title != null && (Model.Title.Contains("Teslimat") || Model.Title.Contains("İmalat")))
                {
                    <span class="badge bg-info text-dark rounded-pill px-3 py-1"><i class="bi bi-truck me-1"></i>Saha Teslimat Takibi</span>
                }
            </div>
            <h4 class="mb-0 text-dark fw-bold">@Model.Title</h4>
            <p class="text-muted small mb-0 mt-1"><i class="bi bi-clock"></i> @Model.EventDate.ToString("dd MMMM yyyy HH:mm")</p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.StatusId != AgendaConstants.StatusTamamlandi)
            {
                <button type="button" class="btn btn-success fw-bold btn-sm shadow-sm" onclick="updateAgendaStatus(@Model.Id, @AgendaConstants.StatusTamamlandi)">
                    <i class="bi bi-check2-circle me-1"></i> Sahada Karşılandı / Tamamla
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="updateAgendaStatus(@Model.Id, @AgendaConstants.StatusPlanlandi)">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Geri Al (Planlandı)
                </button>
            }
        </div>
    </div>
    <div class="card-body">

        <!-- Proje & Firma Kartları (Varsa) -->
        @if (Model.Project != null || Model.Phonebook != null)
        {
            <div class="row g-3 mb-4">
                @if (Model.Project != null)
                {
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light border h-100">
                            <span class="text-muted small text-uppercase fw-bold"><i class="bi bi-building me-1"></i> Şantiye / Proje</span>
                            <h6 class="fw-bold mb-1 mt-1 text-primary">@Model.Project.Name</h6>
                            <p class="small text-muted mb-0"><i class="bi bi-geo-alt"></i> @(string.IsNullOrEmpty(Model.Project.Address) ? "Adres Girilmemiş" : Model.Project.Address)</p>
                        </div>
                    </div>
                }
                @if (Model.Phonebook != null)
                {
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light border h-100">
                            <span class="text-muted small text-uppercase fw-bold"><i class="bi bi-person-lines-fill me-1"></i> Tedarikçi / Usta Bilgisi</span>
                            <h6 class="fw-bold mb-1 mt-1 text-dark">@Model.Phonebook.Name</h6>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="small text-muted"><i class="bi bi-person"></i> @(Model.Phonebook.AuthorizedPerson ?? "Yetkili")</span>
                                @if (!string.IsNullOrEmpty(Model.Phonebook.PhoneNumber))
                                {
                                    var cleanNum = Model.Phonebook.PhoneNumber.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "");
                                    if (cleanNum.StartsWith("0")) cleanNum = "90" + cleanNum.Substring(1);
                                    else if (!cleanNum.StartsWith("90")) cleanNum = "90" + cleanNum;
                                    <div>
                                        <a href="tel:@Model.Phonebook.PhoneNumber" class="btn btn-xs btn-primary rounded-pill px-2 py-1 small fw-bold me-1">
                                            <i class="bi bi-telephone-fill"></i> Ara
                                        </a>
                                        <a href="https://wa.me/@cleanNum" target="_blank" class="btn btn-xs btn-success rounded-pill px-2 py-1 small fw-bold">
                                            <i class="bi bi-whatsapp"></i> WhatsApp
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="mb-4">
            <h6 class="text-secondary fw-bold text-uppercase" style="font-size:0.85rem;"><i class="bi bi-card-text me-1"></i> Görev / Randevu / Toplantı Detayları</h6>
            <div class="p-3 bg-white border rounded-3 shadow-xs" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">@Model.Notes</div>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <h6 class="text-secondary fw-bold text-uppercase mb-3" style="font-size:0.85rem;">Toplantı Gündem Maddeleri (Slaytlar)</h6>
            
            <div class="accordion" id="agendaAccordion">
                @foreach (var item in Model.Items.OrderBy(i => i.OrderNo))
                {
                    var headingId = "heading" + item.Id;
                    var collapseId = "collapse" + item.Id;
                    
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed rounded fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" style="background-color: #f8f9fa;">
                                @item.OrderNo. @item.TopicTitle
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#agendaAccordion">
                            <div class="accordion-body bg-white">
                                <div class="row">
                                    <div class="col-md-7">
                                        <h6 class="text-muted"><i class="bi bi-file-earmark-text"></i> Sunum Metni</h6>
                                        <p style="white-space: pre-wrap;">@item.PresentationText</p>
                                    </div>
                                    <div class="col-md-5 text-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <a href="@item.ImageUrl" data-lightbox="agenda-gallery-@item.Id" data-title="@item.TopicTitle">
                                                <img src="@item.ImageUrl" alt="@item.TopicTitle" class="img-fluid rounded shadow-sm" style="max-height: 200px; object-fit: cover; cursor: zoom-in;" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded p-4 text-muted border border-dashed">
                                                <i class="bi bi-image fs-1"></i>
                                                <br />Görsel Yok
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                <hr class="my-4" />
                                
                                <h6 class="text-danger fw-bold"><i class="bi bi-mic"></i> Toplantı Cevapları / Alınan Kararlar</h6>
                                <p class="small text-muted mb-2">Bu alana yazılan notlar toplantı anında anlık olarak kaydedilir.</p>
                                <textarea class="form-control live-note-input" data-item-id="@item.Id" rows="4" placeholder="Masada alınan kararları buraya yazın...">@item.LiveMeetingNotes</textarea>
                                <div class="text-end mt-1">
                                    <small class="text-success save-status" id="status-@item.Id" style="display:none;"><i class="bi bi-check-circle"></i> Kaydedildi</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center border-dashed p-4">
                <i class="bi bi-inbox fs-2 text-muted"></i>
                <p class="mb-0 mt-2 text-muted">Bu toplantı için henüz bir alt gündem / slayt maddesi eklenmemiş.</p>
            </div>
        }

    </div>
</div>
