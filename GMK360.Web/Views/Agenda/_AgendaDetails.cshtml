@model GMK360.Core.Entities.Construction.AgendaRecord

<div>
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">@Model.Title</h4>
            <div class="text-muted">
                <i class="far fa-calendar-alt me-1"></i> @Model.EventDate.ToString("dd MMMM yyyy, HH:mm")
            </div>
        </div>
        <div>
            @if(Model.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusPlanlandi) { <span class="badge bg-primary fs-6">Planlandı</span> }
            @if(Model.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusTamamlandi) { <span class="badge bg-success fs-6">Tamamlandı</span> }
            @if(Model.StatusId == GMK360.Core.Entities.Construction.AgendaConstants.StatusIptal) { <span class="badge bg-danger fs-6">İptal Edildi</span> }
        </div>
    </div>

    <div class="row mb-4">
        @if(Model.Project != null)
        {
            <div class="col-md-6">
                <div class="p-3 bg-light rounded border">
                    <small class="text-muted d-block text-uppercase fw-bold mb-1">İlgili Şantiye</small>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-building text-primary fs-4 me-3"></i>
                        <span class="fw-bold">@Model.Project.Name</span>
                    </div>
                </div>
            </div>
        }
        @if(Model.Phonebook != null)
        {
            <div class="col-md-6">
                <div class="p-3 bg-light rounded border">
                    <small class="text-muted d-block text-uppercase fw-bold mb-1">Görüşülen Kişi / Firma</small>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-tie text-success fs-4 me-3"></i>
                        <div>
                            <span class="fw-bold d-block">@Model.Phonebook.Name</span>
                            
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mb-4">
        <h6 class="border-bottom pb-2 mb-3 fw-bold"><i class="fas fa-pen-nib me-2 text-warning"></i> Toplantı Notları & Kararlar</h6>
        <div class="p-4 bg-light rounded border" style="white-space: pre-line; font-size: 1.05rem; line-height: 1.6;">
            @if(string.IsNullOrEmpty(Model.Notes)){ 
                <em class="text-muted">Not girilmemiş.</em> 
            } else { 
                @Model.Notes 
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="mb-4">
            <h6 class="border-bottom pb-2 mb-3 fw-bold"><i class="fas fa-image me-2 text-info"></i> Sunum / Belge Görseli</h6>
            <a href="@Model.ImageUrl" data-lightbox="agenda-img" data-title="@Model.Title">
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm border" style="max-height: 400px; cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'" />
            </a>
            <small class="d-block text-muted mt-2"><i class="fas fa-search-plus"></i> Tam ekran (Lightbox) için resme tıklayın.</small>
        </div>
    }
</div>

<!-- Lightbox2 -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
