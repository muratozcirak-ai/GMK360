@model IEnumerable<GMK360.Core.Entities.ContactMessage>
@{
    ViewData["Title"] = "Ýletiþim & Talepler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy mb-1"><i class="ph ph-envelope-open me-2 text-orange"></i>Ýletiþim & Talepler</h2>
        <p class="text-muted">Sitedeki Ýletiþim Formundan gelen tüm mesajlarý buradan takip edin.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center bg-light rounded-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-white shadow-sm rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="ph ph-envelope-open text-secondary" style="font-size: 40px;"></i>
                </div>
                <h5 class="fw-bold text-dark">Mesaj Kutusu Boþ</h5>
                <p class="text-muted mb-0">Henüz web sitesinden gönderilmiþ bir iletiþim mesajý bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Gönderen</th>
                            <th>Konu</th>
                            <th>Mesaj</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">Ýþlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@msg.SentAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-bold text-dark">@msg.Name</div>
                                    <div class="text-muted small">@msg.Email <br/> @msg.Phone</div>
                                </td>
                                <td><span class="fw-medium">@msg.Subject</span></td>
                                <td>
                                    <span class="d-inline-block text-truncate" style="max-width: 250px;" title="@msg.Message">
                                        @msg.Message
                                    </span>
                                </td>
                                <td>
                                    @if(msg.IsReplied)
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Cevaplandý</span>
                                    }
                                    else if(msg.IsRead)
                                    {
                                        <span class="badge bg-primary rounded-pill px-3">Okundu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">Yeni Mesaj</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-navy rounded-pill">Oku & Cevapla</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
