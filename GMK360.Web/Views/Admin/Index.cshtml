@{
    ViewData["Title"] = "Gelişmiş Süper Yönetici Merkezi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row mb-5 text-center">
        <div class="col-12">
            <h1 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #1e3a8a, #f97316); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 3rem; letter-spacing:-1px;">
                GMK360 Sistem Komuta Merkezi
            </h1>
            <p class="text-muted fs-5">Sistem Sahibi Modu: Finans, Yetkiler, Abonelikler ve Kritik Raporlar.</p>
        </div>
    </div>

    <!-- CORE ADMIN MODULES -->
    <div class="row g-4 mb-5">
        
        <!-- Kullanıcılar & CRM -->
        <div class="col-md-4">
            <a href="/AdminCRM/Index" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-users-three text-primary" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 fw-bold text-dark">Kullanıcılar & CRM</h4>
                        <p class="text-muted small">Sisteme kayıtlı tüm kullanıcıları, apartman yöneticilerini, ev sahiplerini inceleyin ve yönetin.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Ekip ve Yetkiler -->
        <div class="col-md-4">
            <a href="/AdminTeam/Index" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-bottom: 4px solid #f97316 !important;">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-shield-star text-orange" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 fw-bold text-navy">Ekip ve Yetkiler</h4>
                        <p class="text-muted small">Personelinize (Muhasebe, Teknik Servis, İçerik) özel yetkiler verin, kuralları belirleyin.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Finans ve Cüzdan Merkezi -->
        <div class="col-md-4">
            <a href="/Admin/Finances" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-bottom: 4px solid #10b981 !important;">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-wallet text-success" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 fw-bold text-dark">Muhasebe & Cüzdan</h4>
                        <p class="text-muted small">Kullanıcı bakiyeleri, binaların cüzdan havuzları, nakit çekim talepleri, gelirler.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Paket ve Fiyatlandırma -->
        <div class="col-md-4">
            <a href="/Admin/Packages" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-bottom: 4px solid #8b5cf6 !important;">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-tag" style="font-size: 4rem; color: #8b5cf6;"></i>
                        <h4 class="mt-3 fw-bold text-dark">Abonelik & Paketler</h4>
                        <p class="text-muted small">SaaS modüllerinin aylık/yıllık fiyatlarını, komisyon oranlarını ve kampanyalarını yönetin.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Kataloglar ve Tanımlamalar -->
        <div class="col-md-4">
            <a href="/Definition/Index" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-bottom: 4px solid #3b82f6 !important;">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-squares-four text-info" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 fw-bold text-dark">Genel Tanımlamalar</h4>
                        <p class="text-muted small">Eşya listeleri, bina tipleri, lokasyon veritabanı ve DASK/Vergi oran tanımlamaları.</p>
                    </div>
                </div>
            </a>
        </div>
        
        <!-- B2B Pazar Yeri (Yeni B2B Marketplace Alanı) -->
        <div class="col-md-4">
            <a href="/Admin/B2bMarketplace" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-bottom: 4px solid #14b8a6 !important;">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-storefront" style="font-size: 4rem; color: #14b8a6;"></i>
                        <h4 class="mt-3 fw-bold text-dark">B2B Pazar Yeri</h4>
                        <p class="text-muted small">Şantiyeniz için aradığınız ustayı, malzemeyi ve taşeron firmayı bulun.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Talepler ve CRM -->
        <div class="col-md-4">
            <a href="/AdminRequests/Index" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card p-4 hover-lift" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); border-bottom: 4px solid #ef4444 !important;">
                    <div class="card-body text-center">
                        <i class="ph-fill ph-headset text-danger" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 fw-bold text-dark">Gelen Talepler (Helpdesk)</h4>
                        <p class="text-muted small">Dışarıdan gelen formlar, müşteri destek mesajları ve şikayet bildirimleri.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .admin-card { transition: all 0.25s ease-in-out; border-radius: 1.25rem; }
    .hover-lift:hover { transform: translateY(-7px); box-shadow: 0 1rem 3rem rgba(0,0,0,.15) !important; }
    .text-navy { color: #1e3a8a !important; }
    .text-orange { color: #f97316 !important; }
</style>

