</div>

<style>
    .admin-card { transition: all 0.25s ease-in-out; border-radius: 1.25rem; }
    .hover-lift:hover { transform: translateY(-7px); box-shadow: 0 1rem 3rem rgba(0,0,0,.15) !important; }
    .text-navy { color: #1e3a8a !important; }
    .text-orange { color: #f97316 !important; }
</style>

