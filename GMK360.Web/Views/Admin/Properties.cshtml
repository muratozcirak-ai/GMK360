@{
    ViewData["Title"] = "İlan ve Portföy Merkezi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">İlan & Portföy Merkezi</h2>
            <p class="text-muted">Sistemdeki tüm satılık, kiralık ve taslak ilanları yönetin.</p>
        </div>
        <a href="/Admin" class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i> Yönetici Merkezine Dön</a>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-3">
                    <select class="form-select border-0 bg-light rounded-pill">
                        <option>Tüm Durumlar (Statü)</option>
                        <option>Yayında (Active)</option>
                        <option>Taslak (Draft)</option>
                        <option>Süresi Doldu (Expired)</option>
                        <option>Engellendi (Revoked)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-0 bg-light rounded-pill">
                        <option>EİDS Durumu</option>
                        <option>Doğrulandı</option>
                        <option>Beklemede / Hatalı</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control border-0 bg-light rounded-pill" placeholder="İlan No, Başlık, Danışman veya Mülk Sahibi Ara...">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100 rounded-pill"><i class="bi bi-search me-2"></i> Filtrele</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4">İlan ID</th>
                            <th>Başlık</th>
                            <th>Danışman / Ofis</th>
                            <th>Gerçek Mülk Sahibi</th>
                            <th>EİDS Yetki Bitiş</th>
                            <th>Statü</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Mock Data Row 1 -->
                        <tr>
                            <td class="ps-4 fw-bold">#10294</td>
                            <td>
                                <strong>Kadıköy Merkezde 3+1</strong><br />
                                <small class="text-muted">Kiralık - Daire (35.000 ₺)</small>
                            </td>
                            <td>
                                Ahmet Yılmaz <br />
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">GMK360 Merkez Şube</span>
                            </td>
                            <td>
                                Ayşe Demir (OwnerUserId)<br />
                                <small class="text-muted">TC: 12345***</small>
                            </td>
                            <td>
                                <span class="text-success"><i class="bi bi-shield-check"></i> Onaylı</span><br />
                                <small class="text-muted">30 Ekim 2026</small>
                            </td>
                            <td><span class="badge bg-success rounded-pill">Yayında</span></td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light text-primary rounded-circle me-1"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-sm btn-light text-danger rounded-circle"><i class="bi bi-ban"></i></button>
                            </td>
                        </tr>

                        <!-- Mock Data Row 2 -->
                        <tr>
                            <td class="ps-4 fw-bold">#10295</td>
                            <td>
                                <strong>Beşiktaş Sahilde Lüks Ofis</strong><br />
                                <small class="text-muted">Satılık - Ofis (12.000.000 ₺)</small>
                            </td>
                            <td>
                                Bireysel Kullanıcı <br />
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">Sahibinden</span>
                            </td>
                            <td>
                                Mehmet Kaya (OwnerUserId)<br />
                                <small class="text-muted">TC: 98765***</small>
                            </td>
                            <td>
                                <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Süresi Bitti</span><br />
                                <small class="text-muted">Dün Sona Erdi</small>
                            </td>
                            <td><span class="badge bg-warning rounded-pill text-dark">Süresi Doldu (Expired)</span></td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-light text-primary rounded-circle me-1"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-sm btn-light text-danger rounded-circle"><i class="bi bi-ban"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 text-center">
            <small class="text-muted">Toplam 245 ilan listeleniyor.</small>
        </div>
    </div>
</div>
