@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "EAV Özellik Yönetimi";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2><i class="ph ph-list-dashes"></i> Dinamik Özellik (EAV) Yönetimi</h2>
    <button class="btn" style="padding: 0.5rem 1rem; background: var(--admin-primary); color: white; border: none; border-radius: 8px; font-weight:600;">
        <i class="ph ph-plus"></i> Yeni Özellik (Kategori) Ekle
    </button>
</div>

<!-- EAV Example Card -->
<div class="glass-card" style="margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="color: var(--admin-primary);">Isıtma Tipi (IsitmaTipi)</h3>
        <div>
            <button style="padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid #cbd5e1; background: white; cursor: pointer;"><i class="ph ph-pencil-simple"></i></button>
            <button style="padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid #ef4444; color: #ef4444; background: white; cursor: pointer;"><i class="ph ph-trash"></i></button>
        </div>
    </div>
    
    <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">Alt Seçenekler (Values):</p>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Doğalgaz (Kombi)</span>
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Merkezi Sistem</span>
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Klima</span>
        <span style="background: white; border: 1px dashed #cbd5e1; color: #64748b; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; cursor: pointer;">+ Seçenek Ekle</span>
    </div>
</div>

<div class="glass-card" style="margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="color: var(--admin-primary);">Cephe (Cephe)</h3>
        <div>
            <button style="padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid #cbd5e1; background: white; cursor: pointer;"><i class="ph ph-pencil-simple"></i></button>
            <button style="padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid #ef4444; color: #ef4444; background: white; cursor: pointer;"><i class="ph ph-trash"></i></button>
        </div>
    </div>
    
    <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">Alt Seçenekler (Values):</p>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Kuzey</span>
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Güney</span>
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Doğu</span>
        <span style="background: #f1f5f9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; border: 1px solid #e2e8f0;">Batı</span>
        <span style="background: white; border: 1px dashed #cbd5e1; color: #64748b; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; cursor: pointer;">+ Seçenek Ekle</span>
    </div>
</div>

<div class="glass-card" style="background: #f8fafc; text-align: center; border: 1px dashed #cbd5e1;">
    <p style="color: #64748b; font-size: 0.95rem;">Bu ekranda tanımlanan özellikler (EAV), Acente ilan ekleme sayfasında otomatik olarak form alanlarına (Dropdown, Checkbox) dönüşecektir.</p>
</div>
