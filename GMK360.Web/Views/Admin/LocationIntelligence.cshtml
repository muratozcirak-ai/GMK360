@{
    ViewData["Title"] = "Bölge Zekası ve Entegrasyonlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #02aab0, #00cdac); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Bölge Zekası (POI) & Entegrasyonlar
            </h2>
            <p class="text-muted">Google/Mapbox API maliyetlerini düşürmek için n8n ile çekilen mahalle verilerini yönetin.</p>
        </div>
        <a href="/Admin" class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i> Yönetici Merkezine Dön</a>
    </div>

    <!-- Active Integrations -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);">
                <div class="card-body p-4 text-white d-flex align-items-center">
                    <i class="bi bi-robot fs-1 me-4 opacity-75"></i>
                    <div>
                        <h5 class="fw-bold mb-1">n8n Webhook Durumu</h5>
                        <p class="mb-2 small opacity-75">Tetiklenen Son İşlem: 12 dk önce (Kadıköy/Moda Okul Taraması)</p>
                        <span class="badge bg-white text-success rounded-pill px-3">Sistem Aktif ve Dinliyor</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(90deg, #4b6cb7 0%, #182848 100%);">
                <div class="card-body p-4 text-white d-flex align-items-center">
                    <i class="bi bi-database-check fs-1 me-4 opacity-75"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Önbellek (Cache) Tasarrufu</h5>
                        <p class="mb-2 small opacity-75">Veritabanından okunan POI sayısı. (Google API'ye gidilmedi)</p>
                        <h4 class="fw-bold mb-0">14.500 Sorgu <small class="fs-6 opacity-75">≈ 280$ Tasarruf</small></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Neighborhood POI Manager -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Mahalle Veritabanı (POI)</h5>
            <button class="btn btn-sm btn-dark rounded-pill"><i class="bi bi-cloud-download me-1"></i> n8n ile Yeni Mahalle Çek</button>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-3">İl / İlçe / Mahalle</th>
                            <th>Hastane & Sağlık</th>
                            <th>Okul & Eğitim</th>
                            <th>Park & Sosyal</th>
                            <th>Son Güncelleme</th>
                            <th class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-3 fw-bold">İstanbul / Kadıköy / Caferağa</td>
                            <td><span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">12 Kayıt</span></td>
                            <td><span class="badge bg-info bg-opacity-10 text-info rounded-pill">8 Kayıt</span></td>
                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill">24 Kayıt</span></td>
                            <td><small class="text-muted">3 Gün Önce (n8n)</small></td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-light text-primary rounded-circle me-1" title="Verileri İncele"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-sm btn-light text-warning rounded-circle" title="Tekrar Tara"><i class="bi bi-arrow-repeat"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="ps-3 fw-bold">İstanbul / Beşiktaş / Etiler</td>
                            <td><span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">5 Kayıt</span></td>
                            <td><span class="badge bg-info bg-opacity-10 text-info rounded-pill">14 Kayıt</span></td>
                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill">8 Kayıt</span></td>
                            <td><small class="text-muted">1 Ay Önce (n8n)</small></td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-light text-primary rounded-circle me-1" title="Verileri İncele"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-sm btn-light text-warning rounded-circle" title="Tekrar Tara"><i class="bi bi-arrow-repeat"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
