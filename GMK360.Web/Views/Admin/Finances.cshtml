@{
    ViewData["Title"] = "Finans ve Cüzdan Merkezi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #11998e, #38ef7d); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Finans ve Cüzdan Merkezi
            </h2>
            <p class="text-muted">Kullanıcı bakiyeleri, paket gelirleri ve Nakit Çekim (Withdrawal) talepleri.</p>
        </div>
        <a href="/Admin" class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i> Yönetici Merkezine Dön</a>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-success bg-opacity-10">
                <div class="card-body p-4 text-center">
                    <h6 class="text-success mb-2">Bugünkü Ciro</h6>
                    <h2 class="fw-bold text-success mb-0">0 ₺</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary bg-opacity-10">
                <div class="card-body p-4 text-center">
                    <h6 class="text-primary mb-2">Bekleyen Çekim Talebi</h6>
                    <h2 class="fw-bold text-primary mb-0">0 Adet</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-warning bg-opacity-10">
                <div class="card-body p-4 text-center">
                    <h6 class="text-warning text-dark mb-2">Toplam Dağıtılan Hediye</h6>
                    <h2 class="fw-bold text-dark mb-0">0 ₺</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white">
                <div class="card-body p-4 text-center">
                    <h6 class="text-white-50 mb-2">Sistemdeki Toplam Bakiye</h6>
                    <h2 class="fw-bold text-white mb-0">0 ₺</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Withdrawal Requests Table -->
    <h4 class="fw-bold mb-3">Nakit Çekim (Withdrawal) Talepleri</h4>
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Kullanıcı / Rol</th>
                            <th>IBAN Bilgisi</th>
                            <th>Tutar</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Henüz nakit çekim (Withdrawal) talebi bulunmuyor.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
