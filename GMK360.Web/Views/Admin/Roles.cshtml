@{
    ViewData["Title"] = "Rol ve Yetkiler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy mb-1"><i class="ph ph-shield-check me-2 text-orange"></i>Rol ve Yetkiler</h2>
        <p class="text-muted">Muhasebeci, Pazarlamacı gibi personel rolleri ve yetki sınırlarını belirleyin.</p>
    </div>
    <button class="btn btn-orange fw-bold rounded-pill px-4"><i class="ph ph-plus fw-bold me-1"></i> Yeni Ekle</button>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="p-5 text-center bg-light rounded-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-white shadow-sm rounded-circle mb-3" style="width: 80px; height: 80px;">
                <i class="ph ph-shield-check text-secondary" style="font-size: 40px;"></i>
            </div>
            <h5 class="fw-bold text-dark">Henüz Kayıt Yok</h5>
            <p class="text-muted mb-4">Sistemde şu an hiçbir rol ve yetkiler bulunmuyor. Gerçek veri odaklı yaklaşımımız gereği sahte veriler eklenmemiştir.</p>
            <button class="btn btn-outline-navy fw-bold rounded-pill px-4">İlk Kaydı Oluştur</button>
        </div>
    </div>
</div>
