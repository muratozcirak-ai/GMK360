@{
    ViewData["Title"] = "Destek ve Müdahale Merkezi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #ff416c, #ff4b2b); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Destek ve Müdahale Merkezi
            </h2>
            <p class="text-muted">Müşterinin şifresini istemeden sorunlarına (İlan takılması, EİDS onayı) doğrudan müdahale edin.</p>
        </div>
        <a href="/Admin" class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i> Yönetici Merkezine Dön</a>
    </div>

    <!-- Search User/Listing -->
    <div class="card border-0 shadow-sm rounded-4 mb-5" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-search me-2 text-danger"></i> Kullanıcı veya İlan Ara</h5>
            <div class="row g-3">
                <div class="col-md-8">
                    <input type="text" class="form-control form-control-lg rounded-pill border-0 shadow-sm" placeholder="Müşteri Adı, Telefonu, TC No veya İlan ID'si yazın...">
                </div>
                <div class="col-md-4">
                    <button class="btn btn-danger btn-lg w-100 rounded-pill shadow-sm fw-bold">Profili / İlanı Getir</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Result / Impersonation Panel -->
    <h4 class="fw-bold mb-3">Bulunan Kayıt: Ahmet Yılmaz (Bireysel Kullanıcı)</h4>
    <div class="row g-4">
        <!-- User Details -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="bi bi-person-circle fs-1 text-secondary"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Ahmet Yılmaz</h5>
                    <p class="text-muted small mb-3">555 123 45 67<br/>ahmet@gmail.com</p>
                    
                    <button class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-2"><i class="bi bi-box-arrow-in-right me-1"></i> Onun Adına Giriş Yap</button>
                    <button class="btn btn-outline-success btn-sm w-100 rounded-pill"><i class="bi bi-wallet2 me-1"></i> Cüzdanına Kredi Yükle</button>
                </div>
            </div>
        </div>

        <!-- Problematic Listings / Assets -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold"><i class="bi bi-exclamation-triangle text-warning me-2"></i> Sorunlu / Taslak İlanları</h6>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-light border shadow-sm rounded-3 d-flex justify-content-between align-items-center mb-0">
                        <div>
                            <span class="badge bg-secondary mb-1">Taslak</span>
                            <h6 class="fw-bold mb-0">Kadıköy 3+1 Kiralık (#10550)</h6>
                            <small class="text-danger"><i class="bi bi-info-circle"></i> EİDS doğrulaması başarısız olduğu için yayına alınamadı.</small>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-sm btn-dark rounded-pill mb-1 d-block w-100">İlanı Düzenle</button>
                            <button class="btn btn-sm btn-success rounded-pill d-block w-100 fw-bold">Zorla Yayına Al (Bypass)</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
