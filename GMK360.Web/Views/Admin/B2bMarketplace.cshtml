@{
    ViewData["Title"] = "GMK360 - B2B Pazar Yeri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <!-- Başlık ve Tanıtım -->
    <div class="row mb-5 justify-content-center">
        <div class="col-lg-8 text-center">
            <h1 class="fw-bold text-dark display-5 mb-3">
                <i class="ph-fill ph-storefront text-primary me-2"></i> B2B Pazar Yeri
            </h1>
            <p class="text-muted fs-5">
                Şantiyeniz için aradığınız profesyonel çözümü seçin. İhtiyacınıza en uygun usta, firma veya tedarikçiyi global havuzdan anında bulun.
            </p>
        </div>
    </div>

    <!-- Ne Arıyorsun? Kartları -->
    <div class="row justify-content-center g-4">
        
        <!-- 1. Usta & Taşeron -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-scale" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s; cursor:pointer;" onclick="location.href='@Url.Action("B2bList", "Admin", new { type = "usta" })'">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 rounded-circle" style="width: 100px; height: 100px;">
                            <i class="ph-fill ph-helmet text-warning" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-3">Usta & Taşeron Ekip</h3>
                    <p class="text-muted mb-0">
                        Boyacı, Sıvacı, Kalıpçı, Tesisatçı ve bireysel taşeron ekiplere ulaşın. Sadece isim, telefon ve ustalık alanıyla en hızlı çözüm.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <span class="btn btn-warning rounded-pill px-4 fw-bold text-dark">Ustaları Gör <i class="ph ph-arrow-right ms-1"></i></span>
                </div>
            </div>
        </div>

        <!-- 2. Kurumsal Hizmet Firması -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-scale" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s; cursor:pointer;" onclick="location.href='@Url.Action("B2bList", "Admin", new { type = "firma" })'">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle" style="width: 100px; height: 100px;">
                            <i class="ph-fill ph-buildings text-primary" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-3">Kurumsal Hizmet Firması</h3>
                    <p class="text-muted mb-0">
                        Mimarlık Ofisleri, Zemin Etüdü Firmaları, İSG Uzmanları ve Resmi Kurumsal Taahhüt firmalarını inceleyin.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <span class="btn btn-primary rounded-pill px-4 fw-bold">Firmaları Gör <i class="ph ph-arrow-right ms-1"></i></span>
                </div>
            </div>
        </div>

        <!-- 3. Tedarikçi & Nalbur -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-scale" style="border-radius: 20px; transition: transform 0.3s, box-shadow 0.3s; cursor:pointer;" onclick="location.href='@Url.Action("B2bList", "Admin", new { type = "tedarikci" })'">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle" style="width: 100px; height: 100px;">
                            <i class="ph-fill ph-truck text-success" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-3">Malzeme & Tedarikçi</h3>
                    <p class="text-muted mb-0">
                        Hazır Beton santralleri, Demir-Çelik toptancıları ve acil ihtiyaçlar için karma stoklu Nalburları keşfedin.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-4">
                    <span class="btn btn-success rounded-pill px-4 fw-bold">Tedarikçileri Gör <i class="ph ph-arrow-right ms-1"></i></span>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .hover-scale:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
    }
</style>
