@model IEnumerable<GMK360.Core.Entities.Construction.AgencyPhonebook>

@{
    ViewData["Title"] = "Firma & Usta Rehberi";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    byte activeFilter = ViewBag.ActiveFilter ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-book text-primary me-2"></i> Firma & Usta Rehberi</h2>
    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addContactModal">
        <i class="bi bi-person-plus-fill me-2"></i> Yeni Kişi/Firma Ekle
    </button>
</div>

<div class="d-flex gap-2 overflow-auto pb-3 mb-2" style="white-space: nowrap;">
    <a href="@Url.Action("Index", new { type = "" })" class="btn rounded-pill @(activeFilter == 0 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Tümü
    </a>
    <a href="@Url.Action("Index", new { type = 1 })" class="btn rounded-pill @(activeFilter == 1 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Ustalar (Mavi Yaka)
    </a>
    <a href="@Url.Action("Index", new { type = 2 })" class="btn rounded-pill @(activeFilter == 2 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Taşeronlar
    </a>
    <a href="@Url.Action("Index", new { type = 3 })" class="btn rounded-pill @(activeFilter == 3 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Malzeme Tedarik
    </a>
    <a href="@Url.Action("Index", new { type = 4 })" class="btn rounded-pill @(activeFilter == 4 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Mimar & Mühendis
    </a>
    <a href="@Url.Action("Index", new { type = 5 })" class="btn rounded-pill @(activeFilter == 5 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Makine Kiralama
    </a>
    <a href="@Url.Action("Index", new { type = 6 })" class="btn rounded-pill @(activeFilter == 6 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Kurum / Belediye
    </a>
    <a href="@Url.Action("Index", new { type = 7 })" class="btn rounded-pill @(activeFilter == 7 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Müşteri & Kat Maliki
    </a>
    <a href="@Url.Action("Index", new { type = 8 })" class="btn rounded-pill @(activeFilter == 8 ? "btn-primary shadow-sm" : "btn-outline-secondary border-0 bg-white")">
        Test Laboratuvarı / OSGB
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Kişi / Firma Adı</th>
                        <th>Kategori / Branş</th>
                        <th>İletişim & Yetkili</th>
                        <th>Lokasyon</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                Rehberinizde henüz kayıt yok. Sağ üstten yeni firma ekleyebilirsiniz.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold fs-6">@item.Name</div>
                                @if(!string.IsNullOrEmpty(item.TaxNumber)) {
                                    <div class="small text-muted"><i class="bi bi-receipt me-1"></i>VN: @item.TaxNumber</div>
                                }
                                <div class="small text-muted">@item.Notes</div>
                            </td>
                            <td>
                                @if(item.ContactType == 1) { <span class="badge bg-info text-dark me-1"><i class="bi bi-tools"></i> Usta</span> }
                                else if(item.ContactType == 2) { <span class="badge bg-primary me-1"><i class="bi bi-bricks"></i> Taşeron</span> }
                                else if(item.ContactType == 3) { <span class="badge bg-success me-1"><i class="bi bi-truck"></i> Tedarikçi</span> }
                                else if(item.ContactType == 4) { <span class="badge bg-danger me-1"><i class="bi bi-rulers"></i> Teknik</span> }
                                else if(item.ContactType == 5) { <span class="badge bg-warning text-dark me-1"><i class="bi bi-truck-flatbed"></i> Makine</span> }
                                else if(item.ContactType == 6) { <span class="badge bg-secondary me-1"><i class="bi bi-building"></i> Kurum</span> }
                                else if(item.ContactType == 7) { <span class="badge bg-dark me-1"><i class="bi bi-person-badge"></i> Müşteri</span> }
                                else if(item.ContactType == 8) { <span class="badge bg-indigo me-1" style="background-color: #6610f2;"><i class="bi bi-clipboard-data"></i> Lab/OSGB</span> }
                                
                                @if(!string.IsNullOrEmpty(item.Tags))
                                {
                                    <div class="mt-1">
                                    @foreach(var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@tag.Trim()</span>
                                    }
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</div>
                                @if(!string.IsNullOrEmpty(item.AuthorizedPerson)) {
                                    <div class="small text-muted"><i class="bi bi-person me-1"></i>@item.AuthorizedPerson @(!string.IsNullOrEmpty(item.AuthorizedPersonRole) ? $"({item.AuthorizedPersonRole})" : "")</div>
                                }
                                @if(!string.IsNullOrEmpty(item.Email)) {
                                    <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@item.Email</div>
                                }
                            </td>
                            <td>
                                @if(!string.IsNullOrEmpty(item.City) || !string.IsNullOrEmpty(item.District))
                                {
                                    <span class="text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(item.District), @(item.City)</span>
                                }
                                else { <span class="text-muted small">Belirtilmedi</span> }
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Details", "AgencyPhonebook", new { id = item.Id })" class="btn btn-sm btn-outline-primary rounded-pill me-1" title="Kurumsal Detaylar (Şubeler/Kişiler)">
                                    <i class="bi bi-building-gear"></i> Detaylar
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Contact Modal (Enhanced) -->
<div class="modal fade" id="addContactModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light border-0 rounded-top-4">
                <h5 class="modal-title fw-bold">Yepyeni Bir Kayıt Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    
                    <ul class="nav nav-pills mb-4 gap-2" id="pills-tab" role="tablist">
                      <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-4" id="pills-genel-tab" data-bs-toggle="pill" data-bs-target="#pills-genel" type="button" role="tab">Genel Bilgiler</button>
                      </li>
                      <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4" id="pills-kurumsal-tab" data-bs-toggle="pill" data-bs-target="#pills-kurumsal" type="button" role="tab">Kurumsal (Vergi & İletişim)</button>
                      </li>
                      <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4" id="pills-adres-tab" data-bs-toggle="pill" data-bs-target="#pills-adres" type="button" role="tab">Adres Bilgileri</button>
                      </li>
                    </ul>

                    <div class="tab-content" id="pills-tabContent">
                      <!-- GENEL BILGILER -->
                      <div class="tab-pane fade show active" id="pills-genel" role="tabpanel">
                          <div class="row g-3">
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Kategori / Tipi</label>
                                  <select name="ContactType" class="form-select" required>
                                      <option value="1">Usta / Mavi Yaka</option>
                                      <option value="2">Taşeron Firma</option>
                                      <option value="3">Malzeme Tedarikçisi</option>
                                      <option value="4">Mimar & Mühendis (Teknik)</option>
                                      <option value="5">Makine & Ekipman Kiralama</option>
                                      <option value="6">Kurum / Belediye Yetkilisi</option>
                                      <option value="7">Müşteri / Kat Maliki</option>
                                      <option value="8">Test Laboratuvarı / OSGB</option>
                                  </select>
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Ad Soyad / Firma Adı *</label>
                                  <input type="text" name="Name" class="form-control" required />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Ana Telefon *</label>
                                  <input type="text" name="PhoneNumber" class="form-control" required />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">E-Posta Adresi</label>
                                  <input type="email" name="Email" class="form-control" />
                              </div>
                              <div class="col-12">
                                  <label class="form-label fw-bold">Etiketler / Branş (Virgülle ayırın)</label>
                                  <input type="text" name="Tags" class="form-control" placeholder="Örn: Karot, Zemin, İş Güvenliği" />
                              </div>
                          </div>
                      </div>

                      <!-- KURUMSAL -->
                      <div class="tab-pane fade" id="pills-kurumsal" role="tabpanel">
                          <div class="row g-3">
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Yetkili Kişi (Ad Soyad)</label>
                                  <input type="text" name="AuthorizedPerson" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Yetkili Unvanı</label>
                                  <input type="text" name="AuthorizedPersonRole" class="form-control" placeholder="Örn: Laboratuvar Müdürü" />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Vergi Dairesi</label>
                                  <input type="text" name="TaxOffice" class="form-control" />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Vergi Numarası</label>
                                  <input type="text" name="TaxNumber" class="form-control" />
                              </div>
                              <div class="col-md-12">
                                  <label class="form-label fw-bold">IBAN Numarası</label>
                                  <input type="text" name="Iban" class="form-control" placeholder="TR..." />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Sabit Hat</label>
                                  <input type="text" name="LandlinePhone" class="form-control" />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">Dahili / İkinci Cep</label>
                                  <input type="text" name="ExtensionNumber" class="form-control" />
                              </div>
                          </div>
                      </div>

                      <!-- ADRES -->
                      <div class="tab-pane fade" id="pills-adres" role="tabpanel">
                           <div class="row g-3">
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">İl</label>
                                  <input type="text" name="City" class="form-control" placeholder="Örn: İstanbul" />
                              </div>
                              <div class="col-md-6">
                                  <label class="form-label fw-bold">İlçe</label>
                                  <input type="text" name="District" class="form-control" placeholder="Örn: Kadıköy" />
                              </div>
                              <div class="col-12">
                                  <label class="form-label fw-bold">Açık Adres / Merkez Bina</label>
                                  <textarea name="Address" class="form-control" rows="2"></textarea>
                              </div>
                              <div class="col-12">
                                  <label class="form-label fw-bold">Web Sitesi veya Harita Linki</label>
                                  <input type="text" name="WebsiteUrl" class="form-control" placeholder="https://" />
                              </div>
                          </div>
                      </div>
                    </div>

                </div>
                <div class="modal-footer border-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm"><i class="bi bi-save me-2"></i>Firma Kaydını Tamamla</button>
                </div>
            </form>
        </div>
    </div>
</div>
