@model IEnumerable<GMK360.Core.Entities.Construction.Warehouse>
@{
    ViewData["Title"] = "Merkez Depo ve Demirbaşlar";
    Layout = ViewData["ProjectId"] != null ? "~/Views/Shared/_ProjectLayout.cshtml" : "~/Views/Shared/_ConstructionLayout.cshtml"; 
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam text-warning me-2"></i>Merkez Depo (Öz Varlık) & Şantiye Envanteri</h4>
        <p class="text-muted small mb-0">Şirket öz varlık demirbaşları, sarf malzemeleri ve kesinleşmiş aktif şantiyelerin depoları</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("MaterialCatalog")" class="btn btn-outline-info rounded-pill px-3 fw-bold shadow-xs">
            <i class="bi bi-journal-text me-1"></i> Şirket Malzeme Kataloğu
        </a>
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addDevirModal">
            <i class="bi bi-tools me-1"></i> + Yeni Demirbaş (Devir)
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ŞİRKET GENELİ TOPLAM STOK ÖZETİ -->
<div class="card shadow-sm mb-4 border-primary">
    <div class="card-header bg-primary text-white py-2.5 px-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold"><i class="bi bi-bar-chart-fill me-2"></i> Şirket Geneli Toplam Öz Varlık & Stok Özeti (Merkez + Aktif Şantiyeler)</h6>
        <span class="badge bg-white text-primary rounded-pill">Not: Şantiye depoları sadece proje Aktif Şantiye olunca açılır</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th class="ps-3">Malzeme / Demirbaş Adı</th>
                        <th>Kategori</th>
                        <th>Şirket İçi Toplam Miktar</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var allItems = Model.SelectMany(w => w.Items ?? new List<GMK360.Core.Entities.Construction.InventoryItem>()).Where(i => i.Quantity > 0).ToList();
                        var summary = allItems.GroupBy(i => (i.Name ?? "").Trim().ToLower())
                            .Select(g => new { 
                                Name = g.First().Name, 
                                Type = g.First().ItemType, 
                                Total = g.Sum(i => i.Quantity), 
                                Unit = g.First().Unit 
                            }).OrderBy(x => x.Name).ToList();

                        if (!summary.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">Şirket genelinde henüz kayıtlı demirbaş veya stok bulunmamaktadır.</td></tr>
                        }
                        else
                        {
                            foreach (var sum in summary)
                            {
                                <tr>
                                    <td class="fw-bold ps-3">@sum.Name</td>
                                    <td>@(sum.Type == GMK360.Core.Entities.Construction.InventoryItemType.Demirbas ? "Demirbaş (Öz Varlık)" : "Sarf Malzeme")</td>
                                    <td><span class="text-success fw-bold">@sum.Total.ToString("0.##") @sum.Unit</span></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="text-center py-5 text-muted bg-white rounded shadow-sm border">
                <i class="bi bi-boxes fs-1 d-block mb-3 text-secondary"></i>
                <h5>Henüz Depo veya Aktif Şantiye Bulunmuyor</h5>
                <p>Envanter takibi için Merkez Depo otomatik oluşturulur; şantiye depoları ise projeler Aktif Şantiye aşamasına geçtiğinde açılır.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var warehouse in Model)
        {
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                        <h5 class="mb-0 fw-bold">
                            @if(warehouse.Type == GMK360.Core.Entities.Construction.WarehouseType.Merkez){
                                <i class="bi bi-building-fill text-primary me-2"></i> 
                            } else {
                                <i class="bi bi-cone-striped text-warning me-2"></i> 
                            }
                            @warehouse.Name
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-danger rounded-pill fw-bold px-3 shadow-sm" onclick="openUrgentRequestModal('@warehouse.Id', '@warehouse.Name')">
                                <i class="bi bi-lightning-fill"></i> Acil Talep
                            </button>
                            <span class="fw-bold text-dark border px-2 py-1 rounded">
                                @(warehouse.Items?.Count ?? 0) Ürün
                            </span>
                        </div>
                    </div>
                    
                    <div class="card-body p-0">
                        @if(warehouse.Items != null && warehouse.Items.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Malzeme / Demirbaş Adı</th>
                                            <th>Tip & Giriş</th>
                                            <th>Marka / Seri No</th>
                                            <th>Zimmetli Sorumlu / Usta</th>
                                            <th>Durum</th>
                                            <th class="text-end">Miktar</th>
                                            <th class="text-end pe-4">Sevk, Zimmet & Zayi İşlemi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in warehouse.Items.OrderByDescending(i => i.CreatedAt))
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <strong>@item.Name</strong>
                                                    @if(!string.IsNullOrEmpty(item.SupplierName)){
                                                        <div class="small text-muted">Kaynak: @item.SupplierName</div>
                                                    }
                                                </td>
                                                <td>
                                                    @if(item.ItemType == GMK360.Core.Entities.Construction.InventoryItemType.Demirbas){
                                                        <span class="badge bg-dark text-warning">Demirbaş (Öz Varlık)</span>
                                                    } else {
                                                        <span class="badge bg-info-subtle text-info-emphasis border">Sarf Malzeme</span>
                                                    }
                                                    <div class="small mt-1">
                                                        @if(item.EntryMethod == GMK360.Core.Entities.Construction.InventoryEntryMethod.Devir){
                                                            <span class="text-warning-emphasis fw-semibold"><i class="bi bi-arrow-repeat"></i> Devir</span>
                                                        } else {
                                                            <span class="text-success fw-semibold"><i class="bi bi-cart"></i> Satın Alma</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>@(string.IsNullOrEmpty(item.Brand) ? "-" : item.Brand) @(string.IsNullOrEmpty(item.Model) ? "" : item.Model)</div>
                                                    @if(!string.IsNullOrEmpty(item.SerialNumber)){
                                                        <div class="small text-muted font-monospace">SN: @item.SerialNumber</div>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.ServiceContact))
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                                                            <i class="bi bi-person-check-fill me-1"></i>@item.ServiceContact
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Depo Sorumlusunda</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if(item.CurrentStatus == "Depoda"){
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Depoda Hazır</span>
                                                    } else if (item.CurrentStatus == "Şantiyede" || item.CurrentStatus == "Zimmetli (Sahada)") {
                                                        <span class="badge bg-primary text-white">Sahada / Zimmetli</span>
                                                    } else if (item.CurrentStatus == "Tamirde" || item.CurrentStatus == "Arızalı/Serviste") {
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-wrench"></i> Tamirde / Serviste</span>
                                                    } else if (item.CurrentStatus == "İmha Edildi" || item.CurrentStatus == "Zayi") {
                                                        <span class="badge bg-danger"><i class="bi bi-trash"></i> Zayi / Kayıp</span>
                                                    } else {
                                                        <span class="badge bg-secondary">@item.CurrentStatus</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold">
                                                    @item.Quantity.ToString("0.##") @item.Unit
                                                </td>
                                                <td class="text-end pe-4">
                                                    <div class="d-inline-flex gap-1">
                                                        @if (Model.Count() > 1 && item.Quantity > 0)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 fw-semibold"
                                                                    onclick="openTransferModal('@item.Id', '@Html.Raw((item.Name ?? "").Replace("'", "\\'"))', '@item.Quantity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)', '@warehouse.Id')">
                                                                <i class="bi bi-truck me-1"></i> Şantiyeye/Depoya Sevk
                                                            </button>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-2 py-1 fw-semibold"
                                                                onclick="openCustodyModal('@item.Id', '@Html.Raw((item.Name ?? "").Replace("'", "\\'"))', '@item.CurrentStatus', '@Html.Raw((item.ServiceContact ?? "").Replace("'", "\\'"))', '@item.Quantity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)', '@item.Unit')">
                                                            <i class="bi bi-person-badge me-1"></i> Zimmet / Zayi
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                Bu depoda henüz bir malzeme veya demirbaş bulunmuyor.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Add Devir Modal -->
<div class="modal fade" id="addDevirModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-tools me-2"></i> Yeni Demirbaş (Geçmiş Devir) Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Inventory/AddDevir">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 bg-light">
                    
                    <div class="alert alert-info border-info small mb-4">
                        <i class="bi bi-info-circle me-1"></i> Faturasız veya geçmişten kalan demirbaş/sarf malzemelerinizi <strong>"Devir"</strong> yöntemiyle sisteme tanımlayabilirsiniz. Alınan yer zorunlu değildir.
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Malzeme / Demirbaş Adı <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" placeholder="Örn: Hilti Kırıcı Delici, İskele Takımı, Jeneratör..." required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Hangi Depoda? <span class="text-danger">*</span></label>
                            <select name="warehouseId" class="form-select" required>
                                <option value="">Depo / Şantiye Seçin...</option>
                                @foreach(var w in Model) {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tip <span class="text-danger">*</span></label>
                            <select name="itemType" class="form-select" required>
                                <option value="2">Demirbaş (Öz Varlık / Gezici, İade Edilir)</option>
                                <option value="1">Sarf Malzeme (Tüketilir)</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Miktar <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" name="quantity" class="form-control" required value="1" />
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Birim</label>
                            <select name="unit" class="form-select">
                                <option value="Adet">Adet</option>
                                <option value="Takım">Takım</option>
                                <option value="Mt">Metre</option>
                                <option value="Kg">Kg</option>
                                <option value="Ton">Ton</option>
                            </select>
                        </div>
                    </div>
                    
                    <hr class="my-4 text-muted" />
                    <h6 class="fw-bold text-muted mb-3">İsteğe Bağlı Detaylar (Esnek Alanlar)</h6>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Marka</label>
                            <input type="text" name="brand" class="form-control" placeholder="Örn: Bosch" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Model</label>
                            <input type="text" name="model" class="form-control" placeholder="Örn: GBH 2-28" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Seri / Barkod No</label>
                            <input type="text" name="serialNumber" class="form-control" placeholder="SN123456" />
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kimden Alındı? (Devir Eden / Tedarikçi)</label>
                            <input type="text" name="supplierName" class="form-control" placeholder="Örn: Yıldız Hırdavat (İkinci El)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teknik Servis / Usta İletişim</label>
                            <input type="text" name="serviceContact" class="form-control" placeholder="Örn: Ahmet Usta 0555..." />
                        </div>
                    </div>
                    
                </div>
                <div class="modal-footer bg-white border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i> Devir Olarak Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- TRANSFER (SEVK) MODAL -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-truck me-2"></i> Şantiyeye Sevk Et (Transfer)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="TransferItem" method="post">
                <div class="modal-body bg-light">
                    <input type="hidden" name="sourceItemId" id="transferSourceItemId" />
                    
                    <div class="alert alert-info">
                        <strong>Malzeme:</strong> <span id="transferItemName" class="fw-bold"></span><br />
                        <strong>Mevcut Miktar:</strong> <span id="transferMaxQty" class="text-primary fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sevk Edilecek Miktar <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="quantity" id="transferQuantity" class="form-control form-control-lg" required min="0.01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hedef Şantiye / Depo <span class="text-danger">*</span></label>
                        <select name="targetWarehouseId" class="form-select form-select-lg shadow-sm" id="transferTargetWarehouseId" required>
                            <option value="">-- Hedef Seçin --</option>
                            @foreach (var wh in Model)
                            {
                                <option value="@wh.Id">@wh.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send-check me-1"></i> Sevk İşlemini Başlat</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openTransferModal(itemId, itemName, maxQty, sourceWarehouseId) {
        document.getElementById('transferSourceItemId').value = itemId;
        document.getElementById('transferItemName').innerText = itemName;
        document.getElementById('transferMaxQty').innerText = maxQty;
        
        var qtyInput = document.getElementById('transferQuantity');
        qtyInput.max = maxQty;
        qtyInput.value = '';

        var targetSelect = document.getElementById('transferTargetWarehouseId');
        for (var i = 0; i < targetSelect.options.length; i++) {
            if (targetSelect.options[i].value == sourceWarehouseId) {
                targetSelect.options[i].style.display = 'none';
            } else {
                targetSelect.options[i].style.display = '';
            }
        }
        targetSelect.value = '';

        var myModal = new bootstrap.Modal(document.getElementById('transferModal'));
        myModal.show();
    }

    function openCustodyModal(itemId, itemName, currentStatus, custodianName, maxQty, unit) {
        document.getElementById('custodyItemId').value = itemId;
        document.getElementById('custodyItemName').innerText = itemName + ' (' + maxQty + ' ' + unit + ')';
        document.getElementById('custodyStatusSelect').value = currentStatus || 'Depoda';
        document.getElementById('custodyPersonInput').value = custodianName || '';
        document.getElementById('custodyLostQty').max = maxQty;
        document.getElementById('custodyLostQty').value = '';
        var modal = new bootstrap.Modal(document.getElementById('custodyModal'));
        modal.show();
    }
</script>

<!-- ZİMMET / DURUM / ZAYİ TUTANAĞI MODAL -->
<div class="modal fade" id="custodyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-badge text-warning me-2"></i>Demirbaş Zimmet, Tamir & Şantiye Sonu Zayi Mutabakatı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateItemCustodyAndStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="itemId" id="custodyItemId" />
                <div class="modal-body p-4">
                    <div class="alert alert-secondary border-0 small mb-3">
                        <strong>Seçili Envanter:</strong> <span id="custodyItemName" class="fw-bold text-dark"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Envanter Durumu *</label>
                        <select name="currentStatus" id="custodyStatusSelect" class="form-select fw-semibold">
                            <option value="Depoda">📦 Depoda Hazır</option>
                            <option value="Zimmetli (Sahada)">👷 Personele / Ustaya Zimmetli (Sahada)</option>
                            <option value="Şantiyede">🏗️ Şantiyede Aktif Kullanımda</option>
                            <option value="Tamirde">🔧 Tamirde / Teknik Serviste</option>
                            <option value="Zayi">⚠️ Zayi / Kayıp / Hurda</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Zimmetli Personel / Şantiye Şefi / Usta</label>
                        <input type="text" name="custodianName" id="custodyPersonInput" list="custodyPeopleList" class="form-control" placeholder="Listeden seçin veya isim yazın..." />
                        <datalist id="custodyPeopleList">
                            @if (ViewBag.CustodyPeople != null)
                            {
                                foreach (var person in (List<string>)ViewBag.CustodyPeople)
                                {
                                    <option value="@person"></option>
                                }
                            }
                        </datalist>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-danger">Varsa Eksilen / Zayi / Tüketilen Miktar (Stoktan Düşülür)</label>
                        <input type="number" step="0.01" min="0" name="lostOrConsumedQty" id="custodyLostQty" class="form-control" placeholder="Sadece zayi veya sarf düşümü varsa girin (Örn: 2)" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Zimmet / İade / Zayi Tutanak Notu</label>
                        <input type="text" name="notes" class="form-control" placeholder="Örn: Şantiye kapanış sayımında 2 adet iskele kalası zayi..." />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Zimmet & Durumu Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>




