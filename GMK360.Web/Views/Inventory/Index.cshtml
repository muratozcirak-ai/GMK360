@model IEnumerable<GMK360.Core.Entities.Construction.Warehouse>
@{
    ViewData["Title"] = "Merkez Depo ve Demirbalar";
    Layout = ViewData["ProjectId"] != null ? "~/Views/Shared/_ProjectLayout.cshtml" : "~/Views/Shared/_ConstructionLayout.cshtml"; 
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam text-warning me-2"></i>Merkez Depo & Envanter</h3>
        <p class="text-muted small mb-0">Tm demirbalarnz, sarf malzemeleriniz ve antiye depolarnz</p>
    </div>
    <div>
        <!-- Yeni Devir Ekle Modal Butonu -->
        <a href="@Url.Action("MaterialCatalog")" class="btn btn-outline-info shadow-sm me-2">
            <i class="bi bi-journal-text me-1"></i> irket Malzeme Katalou
        </a>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addDevirModal">
            <i class="bi bi-tools me-1"></i> Yeni Demirba (Devir)
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- RKET GENEL TOPLAM STOK ZET -->
<div class="card shadow-sm mb-4 border-primary">
    <div class="card-header bg-primary text-white py-3">
        <h6 class="m-0 font-weight-bold"><i class="bi bi-bar-chart-fill me-2"></i> irket Geneli Toplam Stok zeti (Tm Depolar)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th>Malzeme Ad</th>
                        <th>Kategori</th>
                        <th>irket i Toplam Miktar</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var allItems = Model.SelectMany(w => w.Items ?? new List<GMK360.Core.Entities.Construction.InventoryItem>()).Where(i => i.Quantity > 0).ToList();
                        var summary = allItems.GroupBy(i => (i.Name ?? "").Trim().ToLower())
                            .Select(g => new { 
                                Name = g.First().Name, 
                                Type = g.First().ItemType, 
                                Total = g.Sum(i => i.Quantity), 
                                Unit = g.First().Unit 
                            }).OrderBy(x => x.Name).ToList();

                        if (!summary.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">irket genelinde henz stok bulunmamaktadr.</td></tr>
                        }
                        else
                        {
                            foreach (var sum in summary)
                            {
                                <tr>
                                    <td class="fw-bold">@sum.Name</td>
                                    <td>@(sum.Type == GMK360.Core.Entities.Construction.InventoryItemType.Demirbas ? "Demirba" : "Sarf Malzeme")</td>
                                    <td><span class="text-success fw-bold">@sum.Total.ToString("0.##") @sum.Unit</span></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="text-center py-5 text-muted bg-white rounded shadow-sm border">
                <i class="bi bi-boxes fs-1 d-block mb-3 text-secondary"></i>
                <h5>Henz Depo veya antiye Eklenmemi</h5>
                <p>Envanter takibi yapmak iin nce proje tanmlayp bir depo oluturmalsnz.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var warehouse in Model)
        {
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                        <h5 class="mb-0 fw-bold">
                            @if(warehouse.Type == GMK360.Core.Entities.Construction.WarehouseType.Merkez){
                                <i class="bi bi-building-fill text-primary me-2"></i> 
                            } else {
                                <i class="bi bi-cone-striped text-warning me-2"></i> 
                            }
                            @warehouse.Name
                        </h5>
                        <span class="fw-bold text-dark border p-1 rounded">
                            @(warehouse.Items?.Count ?? 0) rn
                        </span>
                    </div>
                    
                    <div class="card-body p-0">
                        @if(warehouse.Items != null && warehouse.Items.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Malzeme Ad</th>
                                            <th>Tip</th>
                                            <th>Giri Yntemi</th>
                                            <th>Marka/Model</th>
                                            <th>Durum</th>
                                            <th class="text-end pe-4">Miktar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in warehouse.Items.OrderByDescending(i => i.CreatedAt))
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <strong>@item.Name</strong>
                                                    @if(!string.IsNullOrEmpty(item.SerialNumber)){
                                                        <div class="small text-muted">Seri No: @item.SerialNumber</div>
                                                    }
                                                </td>
                                                <td>
                                                    @if(item.ItemType == GMK360.Core.Entities.Construction.InventoryItemType.Demirbas){
                                                        <span class="text-secondary fw-bold">Demirba</span>
                                                    } else {
                                                        <span class="text-info fw-bold">Sarf Malzeme</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if(item.EntryMethod == GMK360.Core.Entities.Construction.InventoryEntryMethod.Devir){
                                                        <span class="text-warning fw-bold"><i class="bi bi-arrow-repeat"></i> Devir</span>
                                                    } else {
                                                        <span class="text-success fw-bold"><i class="bi bi-cart"></i> Satn Alma</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div>@(string.IsNullOrEmpty(item.Brand) ? "-" : item.Brand)</div>
                                                    <div class="small text-muted">@(string.IsNullOrEmpty(item.Model) ? "" : item.Model)</div>
                                                </td>
                                                <td>
                                                    @if(item.CurrentStatus == "Depoda"){
                                                        <span class="text-success fw-bold">Depoda Hazr</span>
                                                    } else if (item.CurrentStatus == "antiyede") {
                                                        <span class="text-primary fw-bold">Sahada</span>
                                                    } else if (item.CurrentStatus == "Tamirde" || item.CurrentStatus == "Arzal/Serviste") {
                                                        <span class="text-warning fw-bold"><i class="bi bi-wrench"></i> Tamirde</span>
                                                    } else if (item.CurrentStatus == "mha Edildi" || item.CurrentStatus == "Zayi") {
                                                        <span class="text-danger fw-bold"><i class="bi bi-trash"></i> Zayi / mha</span>
                                                    } else {
                                                        <span class="text-secondary fw-bold">@item.CurrentStatus</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-4 fw-bold">
                                                    @item.Quantity.ToString("0.##") @item.Unit
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                Bu depoda henz bir malzeme bulunmuyor.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Add Devir Modal -->
<div class="modal fade" id="addDevirModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-tools me-2"></i> Yeni Demirba (Gemi Devir) Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Inventory/AddDevir">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 bg-light">
                    
                    <div class="alert alert-info border-info small mb-4">
                        <i class="bi bi-info-circle me-1"></i> Faturasz veya gemiten kalan demirba/sarf malzemelerinizi <strong>"Devir"</strong> yntemiyle sisteme tanmlayabilirsiniz. Alnan yer zorunlu deildir.
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Malzeme (Katalogdan Sein) <span class="text-danger">*</span></label>
                            <select name="materialCatalogId" class="form-select" required>
                                <option value="">-- Listeden Sein --</option>
                                @if (ViewBag.Catalogs != null)
                                {
                                    foreach(var cat in (IEnumerable<GMK360.Core.Entities.Construction.MaterialCatalog>)ViewBag.Catalogs)
                                    {
                                        <option value="@cat.Id">@cat.Name (@(cat.Type == GMK360.Core.Entities.Construction.InventoryItemType.Demirbas ? "Demirba" : "Sarf"))</option>
                                    }
                                }
                            </select>
                            <div class="form-text">Listede yoksa yukardan "irket Malzeme Katalou"na ekleyin.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Hangi Depoda? <span class="text-danger">*</span></label>
                            <select name="warehouseId" class="form-select" required>
                                <option value="">Depo / antiye Sein...</option>
                                @foreach(var w in Model) {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tip <span class="text-danger">*</span></label>
                            <select name="itemType" class="form-select" required>
                                <option value="2">Demirba (Gezici, ade Edilir)</option>
                                <option value="1">Sarf Malzeme (Tketilir)</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Miktar <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" name="quantity" class="form-control" required value="1" />
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Birim</label>
                            <select name="unit" class="form-select">
                                <option value="Adet">Adet</option>
                                <option value="Takm">Takm</option>
                                <option value="Mt">Metre</option>
                                <option value="Kg">Kg</option>
                                <option value="Ton">Ton</option>
                            </select>
                        </div>
                    </div>
                    
                    <hr class="my-4 text-muted" />
                    <h6 class="fw-bold text-muted mb-3">stee Bal Detaylar (Esnek Alanlar)</h6>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Marka</label>
                            <input type="text" name="brand" class="form-control" placeholder="rn: Bosch" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Model</label>
                            <input type="text" name="model" class="form-control" placeholder="rn: GBH 2-28" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Seri / Barkod No</label>
                            <input type="text" name="serialNumber" class="form-control" placeholder="SN123456" />
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kimden Alnd? (Devir Eden/Tedariki)</label>
                            <input type="text" name="supplierName" class="form-control" placeholder="rn: Yldz Hrdavat (kinci El)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teknik Servis / Usta letiim</label>
                            <input type="text" name="serviceContact" class="form-control" placeholder="rn: Ahmet Usta 0555..." />
                        </div>
                    </div>
                    
                </div>
                <div class="modal-footer bg-white border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ptal</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i> Devir Olarak Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- TRANSFER (SEVK) MODAL -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-truck me-2"></i> antiyeye Sevk Et (Transfer)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="TransferItem" method="post">
                <div class="modal-body bg-light">
                    <input type="hidden" name="sourceItemId" id="transferSourceItemId" />
                    
                    <div class="alert alert-info">
                        <strong>Malzeme:</strong> <span id="transferItemName" class="fw-bold"></span><br />
                        <strong>Mevcut Miktar:</strong> <span id="transferMaxQty" class="text-primary fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sevk Edilecek Miktar <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="quantity" id="transferQuantity" class="form-control form-control-lg" required min="0.01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hedef antiye / Depo <span class="text-danger">*</span></label>
                        <select name="targetWarehouseId" class="form-select form-select-lg shadow-sm" id="transferTargetWarehouseId" required>
                            <option value="">-- Hedef Sein --</option>
                            @foreach (var wh in Model)
                            {
                                <option value="@wh.Id">@wh.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ptal</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send-check me-1"></i> Sevk lemini Balat</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openTransferModal(itemId, itemName, maxQty, sourceWarehouseId) {
        document.getElementById('transferSourceItemId').value = itemId;
        document.getElementById('transferItemName').innerText = itemName;
        document.getElementById('transferMaxQty').innerText = maxQty;
        
        var qtyInput = document.getElementById('transferQuantity');
        qtyInput.max = maxQty;
        qtyInput.value = '';

        var targetSelect = document.getElementById('transferTargetWarehouseId');
        // Kendi deposunu seemesin diye gizle
        for (var i = 0; i < targetSelect.options.length; i++) {
            if (targetSelect.options[i].value == sourceWarehouseId) {
                targetSelect.options[i].style.display = 'none';
            } else {
                targetSelect.options[i].style.display = '';
            }
        }
        targetSelect.value = '';

        var myModal = new bootstrap.Modal(document.getElementById('transferModal'));
        myModal.show();
    }
</script>




