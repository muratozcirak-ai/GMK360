@model GMK360.Core.Entities.Identity.ApplicationUser
@{
    ViewData["Title"] = "Referans Kazançlarım";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var referredUsers = ViewBag.ReferredUsers as IEnumerable<dynamic>;
    decimal potentialEarnings = ViewBag.PotentialEarnings ?? 0m;
    string refCode = ViewBag.ReferralCode;
}

<div class="container mt-5 pt-4">
    <!-- Üst Başlık -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <a href="/CustomerDashboard/Index" class="text-decoration-none text-muted small mb-2 d-inline-block"><i class="ph ph-arrow-left me-1"></i> Dashboard'a Dön</a>
            <h2 class="fw-bold mb-0"><i class="ph ph-users text-primary me-2"></i> Davet Et, Kazan!</h2>
            <p class="text-muted mt-1 mb-0">GMK360 platformuna davet ettiğiniz her yeni aboneden %25 komisyon kazanın.</p>
        </div>
        <div class="text-end bg-success bg-opacity-10 p-3 rounded-4">
            <span class="d-block small text-success fw-bold">Gelecek Yenilemelerden Potansiyel Kazanç</span>
            <span class="fs-3 fw-bold text-success">@potentialEarnings.ToString("C2")</span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Referans Kodu Alanı -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100 bg-primary text-white">
                <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                    <h5 class="fw-bold mb-3">Sizin Referans Kodunuz</h5>
                    <div class="bg-white text-primary p-3 rounded-3 mb-4 font-monospace fs-4 fw-bold">
                        @refCode
                    </div>
                    <p class="small text-white-50 mb-4">
                        Bu kodu arkadaşlarınızla paylaşın. Onlar sisteme kayıt olup paralı bir pakete geçtiklerinde 
                        hem ilk alışlarında hem de sonraki yıllardaki yenilemelerinde pasif gelir elde edersiniz!
                    </p>
                    <button class="btn btn-light text-primary fw-bold px-4 py-2 mx-auto rounded-pill" onclick="navigator.clipboard.writeText('@refCode'); alert('Kopyalandı!');">
                        <i class="ph ph-copy me-2"></i>Kodu Kopyala
                    </button>
                </div>
            </div>
        </div>

        <!-- Üye Listesi -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-dark mb-0">Davet Ettiğiniz Kullanıcılar</h5>
                </div>
                <div class="card-body">
                    @if (referredUsers != null && referredUsers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th class="text-muted small">İsim Soyisim</th>
                                        <th class="text-muted small">Durum</th>
                                        <th class="text-end text-muted small">Tahmini Komisyon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rUser in referredUsers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">
                                                    @{
                                                        // Maskeleme örneği
                                                        string name = rUser.FullName;
                                                        if (name.Length > 4) {
                                                            name = name.Substring(0, 3) + "***";
                                                        }
                                                    }
                                                    @name
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-success bg-opacity-10 text-success">Aktif</span>
                                            </td>
                                            <td class="text-end fw-bold text-primary">
                                                Hesaplanıyor...
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="ph ph-user-plus fs-1 d-block mb-3 text-light"></i>
                            Henüz kimseyi davet etmemişsiniz. Referans kodunuzu hemen paylaşın!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
