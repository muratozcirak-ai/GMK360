@{
    ViewData["Title"] = "Daire Opsiyonlarm (nce ler)";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Daire Opsiyon Seimlerim</h2>
            <p class="text-muted">A Blok - Daire 14 iin ince iilik seimlerinizi aadan ynetebilirsiniz.</p>
        </div>
        <div>
            <span class="badge bg-success fs-6 p-2"><i class="bi bi-check-circle me-1"></i> Seimler Onayland</span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Zemin Kaplama -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Zemin Kaplama</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-light border">
                        <small class="text-muted d-block mb-1">Mteahhit Standart (cretsiz)</small>
                        <div class="fw-bold">Standart Seri Laminant Parke</div>
                    </div>
                    
                    <div class="alert alert-success border-success mt-3 position-relative">
                        <span class="position-absolute top-0 end-0 translate-middle p-2 bg-success border border-light rounded-circle" title="Seildi"></span>
                        <small class="text-success d-block mb-1">Sizin Seiminiz (+85.000 TL Fark)</small>
                        <div class="fw-bold text-dark">Doal Mee Ahap Parke (VitrA Premium)</div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 pb-4">
                    <button class="btn btn-outline-secondary w-100 rounded-pill" disabled>Deiim Sresi Doldu</button>
                </div>
            </div>
        </div>

        <!-- Mutfak Dolaplar -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary"><i class="bi bi-cup-hot-fill me-2"></i>Mutfak Mobilyas</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-primary border-primary position-relative">
                        <span class="position-absolute top-0 end-0 translate-middle p-2 bg-primary border border-light rounded-circle" title="Seildi"></span>
                        <small class="text-primary d-block mb-1">Mteahhit Standart (cretsiz - Sizin Seiminiz)</small>
                        <div class="fw-bold text-dark">MDF Lam (Beyaz / Gri Tonlar)</div>
                    </div>
                    
                    <div class="alert alert-light border mt-3 text-muted">
                        <small class="d-block mb-1">Opsiyon 2 (+120.000 TL)</small>
                        <div>Akrilik Parlak / Ada Mutfak Konsepti</div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 pb-4">
                    <button class="btn btn-outline-primary w-100 rounded-pill">Seimi Deitir</button>
                </div>
            </div>
        </div>
        
        <!-- Banyo Seramikleri -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary"><i class="bi bi-droplet-fill me-2"></i>Banyo Seramikleri</h5>
                </div>
                <div class="card-body text-center py-5">
                    <i class="bi bi-clock-history display-4 text-warning mb-3"></i>
                    <h5 class="fw-bold">Seim Bekleniyor</h5>
                    <p class="text-muted small">Banyo seramik seimleriniz iin son tarih: <strong>15.11.2026</strong></p>
                </div>
                <div class="card-footer bg-white border-top-0 pb-4">
                    <button class="btn btn-primary w-100 rounded-pill fw-bold">Opsiyonlar Gr & Se</button>
                </div>
            </div>
        </div>

    </div>

    <!-- zet Tablosu -->
    <div class="card border-0 shadow-sm rounded-4 mt-5">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-4">Finansal zet</h5>
            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-2">
                <span class="text-muted">Daire Satn Alma Bedeli:</span>
                <span class="fw-bold">12.500.000 TL</span>
            </div>
            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-2">
                <span class="text-muted">Opsiyonlu nce lik Farklar Toplam:</span>
                <span class="fw-bold text-success">+ 85.000 TL</span>
            </div>
            <div class="d-flex justify-content-between align-items-center p-3 bg-navy text-white rounded-3 mt-3 shadow">
                <span class="fw-bold fs-5">Gncel Toplam Bor:</span>
                <span class="fw-bold fs-5">12.585.000 TL</span>
            </div>
        </div>
    </div>
</div>