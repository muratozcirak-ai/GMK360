@model GMK360.Web.Models.SetupCorporateProfileViewModel

@{
    ViewData["Title"] = "Kurumsal Profilinizi Oluşturun";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ya da _Layout.cshtml hangisi kullanılıyorsa
}

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            
            <div class="text-center mb-5">
                <i class="ph ph-buildings text-orange mb-3" style="font-size: 4rem;"></i>
                <h2 class="fw-bold text-navy">İnşaat Paneline Hoş Geldiniz!</h2>
                <p class="text-muted fs-5">Şantiye modülünü kullanmaya başlamadan önce firmanızı tanımlayalım.</p>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <form asp-action="SetupCorporateProfile" asp-controller="CustomerDashboard" method="post" enctype="multipart/form-data">
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                        <div class="mb-4">
                            <label asp-for="CompanyName" class="form-label fw-bold">Firma Adı</label>
                            <input asp-for="CompanyName" class="form-control form-control-lg rounded-3" placeholder="Örn: Öztürk İnşaat A.Ş." />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TaxNumber" class="form-label fw-bold">Vergi Numarası</label>
                            <input asp-for="TaxNumber" class="form-control form-control-lg rounded-3" placeholder="Örn: 1234567890" />
                            <span asp-validation-for="TaxNumber" class="text-danger small"></span>
                        </div>


                                                <div class="mb-4">
                            <label asp-for="LogoFile" class="form-label fw-bold">Firma Logosu</label>
                            <input asp-for="LogoFile" type="file" class="form-control form-control-lg rounded-3" accept="image/jpeg,image/png" />
                            <div class="form-text">Firmanızın logosunu bilgisayarınızdan seçin (JPG/PNG).</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Subdomain" class="form-label fw-bold">Size Özel Alt Alan Adı (Subdomain)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-muted fw-bold">https://</span>
                                <input asp-for="Subdomain" class="form-control border-start-0 border-end-0" placeholder="firmaniz" />
                                <span class="input-group-text bg-light text-muted fw-bold">.gmk360.com</span>
                            </div>
                            <span asp-validation-for="Subdomain" class="text-danger small"></span>
                            <div class="form-text text-muted">Şantiye panelinize ileride bu adresten direkt giriş yapabileceksiniz. Müşterileriniz de bu adresi görecek.</div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">İletişim Numarası</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg rounded-3" placeholder="0555..." />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-orange btn-lg rounded-pill fw-bold">
                                Profili Kaydet ve İnşaat Paneline Geç <i class="ph ph-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/CustomerDashboard" class="text-muted text-decoration-none"><i class="ph ph-arrow-left me-1"></i> Müşteri Paneline Dön</a>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .text-orange { color: #f97316 !important; }
        .text-navy { color: #1e3a8a !important; }
        .btn-orange { background-color: #f97316; color: white; border: none; }
        .btn-orange:hover { background-color: #ea580c; color: white; }
    </style>
}
