@model List<GMK360.Web.Models.ExpertSearchViewModel>
@{
    ViewData["Title"] = "Uzman Ara (Usta, Firma, Emlak Danışmanı)";
    var cities = ViewBag.Cities as List<GMK360.Core.Entities.City>;
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark mb-1">
                <i class="ph-fill ph-users-three text-primary me-2"></i> Uzman Arama Motoru
            </h2>
            <p class="text-muted">Emlak danışmanları, ustalar ve inşaat firmaları tek bir adreste. İhtiyacınıza uygun uzmanı anında bulun.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sol Filtre Sütunu -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px; z-index: 10;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Filtrele</h5>
                    <form action="/Service/Search" method="get">
                        
                        <!-- Uzman Tipi -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">Kimi Arıyorsunuz?</label>
                            <select name="type" class="form-select form-select-sm rounded-3">
                                <option value="All" selected="@(ViewBag.CurrentType == "All" ? "selected" : null)">Tümü</option>
                                <option value="Emlak Danışmanı" selected="@(ViewBag.CurrentType == "Emlak Danışmanı" ? "selected" : null)">Emlak Danışmanı</option>
                                <option value="Usta" selected="@(ViewBag.CurrentType == "Usta" ? "selected" : null)">Bağımsız Usta</option>
                                <option value="Firma" selected="@(ViewBag.CurrentType == "Firma" ? "selected" : null)">Kurumsal Firma</option>
                            </select>
                        </div>

                        <!-- Şehir -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">Şehir</label>
                            <select name="cityId" class="form-select form-select-sm rounded-3">
                                <option value="">Tüm Türkiye</option>
                                @if (cities != null)
                                {
                                    foreach (var c in cities)
                                    {
                                        <option value="@c.Id" selected="@(ViewBag.CurrentCity == c.Id ? "selected" : null)">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Anahtar Kelime -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">İsim / İşletme Adı</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="ph ph-magnifying-glass text-muted"></i></span>
                                <input type="text" name="q" class="form-control border-start-0" placeholder="Örn: Ahmet Usta..." value="@ViewBag.CurrentQ">
                            </div>
                        </div>

                        <!-- Onaylı Profiller -->
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="verifiedOnly" name="verifiedOnly" value="true" @(ViewBag.VerifiedOnly ? "checked" : "")>
                                <label class="form-check-label small fw-bold" for="verifiedOnly">
                                    <i class="bi bi-patch-check-fill text-primary"></i> Sadece Onaylı Profiller
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Sonuçları Göster</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sağ Sonuç Sütunu -->
        <div class="col-lg-9">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold m-0">@Model.Count Uzman Bulundu</h5>
                <select class="form-select form-select-sm w-auto rounded-3 bg-light border-0">
                    <option value="">Önerilen (Puana Göre)</option>
                    <option value="">En Çok Yorum Alanlar</option>
                </select>
            </div>

            @if(Model.Any())
            {
                <div class="row g-4">
                    @foreach(var expert in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card border-0 shadow-sm rounded-4 h-100 expert-card overflow-hidden" style="transition: transform 0.2s, box-shadow 0.2s;">
                                
                                <!-- Card Header (Gradient Background based on Type) -->
                                @{
                                    var bgGradient = "linear-gradient(135deg, #1e3a8a, #3b82f6)"; // Emlak Danışmanı (Mavi)
                                    var iconClass = "ph-user-focus";
                                    if(expert.Type == "Usta") { bgGradient = "linear-gradient(135deg, #ea580c, #f59e0b)"; iconClass="ph-hammer"; } // Usta (Turuncu)
                                    else if(expert.Type == "Firma") { bgGradient = "linear-gradient(135deg, #0f766e, #14b8a6)"; iconClass="ph-buildings"; } // Firma (Yeşil)
                                }
                                <div style="height: 80px; background: @bgGradient;" class="position-relative">
                                    <div class="position-absolute top-0 end-0 p-2 text-white opacity-50">
                                        <i class="ph-fill @iconClass fs-3"></i>
                                    </div>
                                    @if(expert.IsVerified)
                                    {
                                        <span class="position-absolute top-0 start-0 m-2 badge bg-white text-primary rounded-pill fw-bold shadow-sm" style="font-size:0.7rem;">
                                            <i class="bi bi-patch-check-fill me-1"></i> Onaylı @expert.Type
                                        </span>
                                    }
                                </div>
                                
                                <div class="card-body text-center pt-0 position-relative">
                                    <!-- Avatar -->
                                    <div class="avatar-container d-inline-block p-1 bg-white rounded-circle shadow-sm" style="margin-top: -40px; margin-bottom: 15px;">
                                        <img src="@expert.AvatarUrl" class="rounded-circle object-fit-cover" style="width: 80px; height: 80px;" alt="@expert.Name">
                                    </div>
                                    
                                    <h5 class="fw-bold mb-1 text-truncate" title="@expert.Name">@expert.Name</h5>
                                    <p class="text-muted small mb-2"><i class="ph-fill ph-map-pin text-danger"></i> @expert.Location</p>
                                    
                                    <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                                        <div class="text-warning">
                                            @for(int i=0; i<5; i++)
                                            {
                                                if(i < Math.Floor(expert.AverageRating)) { <i class="bi bi-star-fill"></i> }
                                                else if(i < expert.AverageRating) { <i class="bi bi-star-half"></i> }
                                                else { <i class="bi bi-star"></i> }
                                            }
                                        </div>
                                        <span class="fw-bold">@expert.AverageRating.ToString("0.0")</span>
                                        <span class="text-muted small">(@expert.ReviewCount)</span>
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
                                        @foreach(var cat in expert.Categories.Take(3))
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">@cat</span>
                                        }
                                        @if(expert.Categories.Length > 3)
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">+@(expert.Categories.Length - 3)</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-top-0 p-3 pt-0 d-flex gap-2">
                                    <a href="@expert.ProfileUrl" class="btn btn-outline-primary w-50 fw-bold rounded-pill" style="font-size:0.9rem;">Profili Gör</a>
                                    <button class="btn btn-primary w-50 fw-bold rounded-pill d-flex align-items-center justify-content-center gap-1" style="font-size:0.9rem;" onclick="alert('Teklif isteme modülü açılacak.')">
                                        <i class="ph-bold ph-paper-plane-tilt"></i> İletişim
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="120" class="opacity-50 mb-3" />
                    <h5 class="fw-bold text-muted">Aramanıza Uygun Uzman Bulunamadı</h5>
                    <p class="text-muted small">Filtreleri genişleterek tekrar deneyebilirsiniz.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .expert-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }
</style>
