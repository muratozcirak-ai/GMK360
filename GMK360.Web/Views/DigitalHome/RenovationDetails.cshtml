@model GMK360.Core.Entities.RenovationRequest

@{
    ViewData["Title"] = Model.Title + " - İhale Detayı";
}

<div class="container mt-4">
    <div class="row">
        <!-- Sol Panel: İhale Detayı -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Talep Detayları</h5>
                </div>
                <div class="card-body">
                    <h4 class="fw-bold text-primary">@Model.Title</h4>
                    <p class="text-muted small mb-3">Tarih: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                    
                    <div class="mb-3">
                        <h6>Açıklama:</h6>
                        <p class="bg-light p-3 rounded">@Model.Description</p>
                    </div>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Durum
                            @if(Model.Status == GMK360.Core.Entities.RenovationStatus.Open)
                            {
                                <span class="badge bg-success rounded-pill">Tekliflere Açık</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill">Kapalı</span>
                            }
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            İhale Tipi
                            <span class="badge bg-secondary rounded-pill">@(Model.BiddingType == GMK360.Core.Entities.RenovationBiddingType.OpenBidding ? "Açık İhale" : "Özel Davet")</span>
                        </li>
                    </ul>
                    
                    <a asp-action="Renovations" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left"></i> Geri Dön</a>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Gelen Teklifler ve Dışarıdan Teklif Ekleme -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-wallet2"></i> Gelen Teklifler Kıyaslama</h5>
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addExternalOfferModal">
                        <i class="bi bi-plus-lg"></i> Manuel Teklif Ekle (Sistem Dışı)
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Usta/Firma Adı</th>
                                    <th>Tutar</th>
                                    <th>Notlar</th>
                                    <th>Durum</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Offers.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            Henüz bu talebe teklif verilmedi.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var offer in Model.Offers.OrderBy(o => o.Price))
                                    {
                                        <tr>
                                            <td>
                                                @if(offer.ServiceProvider != null)
                                                {
                                                    <span class="fw-bold text-primary"><i class="bi bi-patch-check-fill text-success"></i> Sistem Ustası</span>
                                                    <br />
                                                    <small class="text-muted">ID: @offer.ServiceProviderId</small>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold">@offer.ExternalProviderName</span>
                                                    <br />
                                                    <span class="badge bg-secondary" style="font-size: 0.65rem;">Sistem Dışı / Manuel</span>
                                                }
                                            </td>
                                            <td class="fw-bold text-success">@offer.Price.ToString("C")</td>
                                            <td><small>@offer.Notes</small></td>
                                            <td>
                                                @if(offer.Status == GMK360.Core.Entities.RenovationOfferStatus.Pending)
                                                {
                                                    <span class="badge bg-warning text-dark">Bekliyor</span>
                                                }
                                                else if(offer.Status == GMK360.Core.Entities.RenovationOfferStatus.Accepted)
                                                {
                                                    <span class="badge bg-success">Onaylandı</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Reddedildi</span>
                                                }
                                            </td>
                                            <td>
                                                @if(offer.Status == GMK360.Core.Entities.RenovationOfferStatus.Pending)
                                                {
                                                    <button class="btn btn-sm btn-success" title="Teklifi Kabul Et"><i class="bi bi-check-lg"></i></button>
                                                    <button class="btn btn-sm btn-danger" title="Teklifi Reddet"><i class="bi bi-x-lg"></i></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-warning">
                <i class="bi bi-lightbulb"></i> <strong>İpucu:</strong> Çevrenizdeki ustalardan (mahalle nalburu vb.) aldığınız fiyatları "Manuel Teklif Ekle" butonu ile buraya girebilir, GMK360 içindeki ustaların verdikleri online fiyatlarla tek bir ekranda kıyaslayabilirsiniz!
            </div>
        </div>
    </div>
</div>

<!-- Dışarıdan / Manuel Teklif Ekleme Modalı -->
<div class="modal fade" id="addExternalOfferModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="AddExternalOffer" method="post">
        <input type="hidden" name="requestId" value="@Model.Id" />
        <div class="modal-header">
          <h5 class="modal-title">Manuel Teklif Ekle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Usta/Firma Adı</label>
                <input type="text" name="providerName" class="form-control" placeholder="Örn: Mahalle Nalburu Ahmet Usta" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Teklif Tutarı (TL)</label>
                <input type="number" step="0.01" name="price" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Notlar / Şartlar</label>
                <textarea name="notes" class="form-control" rows="2" placeholder="Örn: Malzeme hariç sadece işçilik"></textarea>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary">Teklifi Kaydet</button>
        </div>
      </form>
    </div>
  </div>
</div>
