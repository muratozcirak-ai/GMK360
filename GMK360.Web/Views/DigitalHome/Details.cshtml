<script src=""https://cdn.jsdelivr.net/npm/marked/marked.min.js""></script>
<script>
    let aiInsightLoaded = false;
    function loadAiInsight() {
        if(aiInsightLoaded) return;
        aiInsightLoaded = true;
        
        fetch(/DigitalHome/GetNeighborhoodAnalysis?propertyId=@Model.Id)
            .then(res => res.json())
            .then(data => {
                document.getElementById('aiInsightLoading').classList.add('d-none');
                if(data.success && data.report) {
                    const contentDiv = document.getElementById('aiInsightContent');
                    contentDiv.innerHTML = marked.parse(data.report);
                    contentDiv.classList.remove('d-none');
                    if(data.updatedAt) {
                        document.getElementById('aiInsightDate').innerText = 'Son Güncelleme: ' + data.updatedAt;
                    }
                } else {
                    document.getElementById('aiInsightError').classList.remove('d-none');
                    document.getElementById('aiInsightErrorText').innerText = data.message || 'Bilinmeyen bir hata.';
                }
            })
            .catch(err => {
                document.getElementById('aiInsightLoading').classList.add('d-none');
                document.getElementById('aiInsightError').classList.remove('d-none');
                document.getElementById('aiInsightErrorText').innerText = 'Ağ hatası oluştu.';
            });
    }
</script>



