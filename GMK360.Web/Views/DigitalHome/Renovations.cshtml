@model IEnumerable<GMK360.Core.Entities.RenovationRequest>

@{
    ViewData["Title"] = "Tadilat ve İhale (Marketplace)";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-tools text-primary"></i> Tadilat Taleplerim</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRenovationModal">
            <i class="bi bi-plus-lg"></i> Yeni Talep Oluştur
        </button>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted mt-5">
                <i class="bi bi-hammer" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Henüz bir tadilat talebiniz bulunmuyor.</h5>
                <p>Usta ihtiyaçlarınız için hemen bir ilan oluşturun ve teklifleri toplayın.</p>
            </div>
        }
        else
        {
            @foreach (var request in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@request.Title</h5>
                            <p class="card-text text-truncate">@request.Description</p>
                            
                            <ul class="list-unstyled mb-3">
                                <li>
                                    <i class="bi bi-tag text-muted"></i> 
                                    @if(request.BiddingType == GMK360.Core.Entities.RenovationBiddingType.OpenBidding)
                                    {
                                        <span class="badge bg-secondary">Açık İhale</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">Özel Davet</span>
                                    }
                                </li>
                                <li>
                                    <i class="bi bi-check-circle text-muted"></i> 
                                    @if(request.Status == GMK360.Core.Entities.RenovationStatus.Open)
                                    {
                                        <span class="badge bg-success">Tekliflere Açık</span>
                                    }
                                    else if(request.Status == GMK360.Core.Entities.RenovationStatus.Closed)
                                    {
                                        <span class="badge bg-danger">Kapalı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@request.Status</span>
                                    }
                                </li>
                                <li class="mt-2">
                                    <i class="bi bi-envelope-paper"></i> <strong>@request.Offers.Count()</strong> Teklif Alındı
                                </li>
                            </ul>
                            
                            <a asp-action="RenovationDetails" asp-route-id="@request.Id" class="btn btn-outline-primary w-100">
                                Detaylar ve Teklifler
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Yeni Talep Ekleme Modalı -->
<div class="modal fade" id="addRenovationModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="CreateRenovation" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Yeni Tadilat Talebi</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input type="text" name="title" class="form-control" placeholder="Örn: Mutfak dolapları boyanacak" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Detaylı Açıklama</label>
                <textarea name="description" class="form-control" rows="3" placeholder="İşin detaylarını, metrekareyi vs. belirtin" required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">İhale Tipi</label>
                <select name="biddingType" class="form-select" required>
                    <option value="1">Açık İhale (Bölgedeki tüm ustalara gider)</option>
                    <option value="2">Özel Davet (Sadece seçtiğim ustalara gider)</option>
                </select>
            </div>
            <div class="alert alert-info py-2">
                <small><i class="bi bi-info-circle"></i> İlanınız yayına girdikten sonra teklifleri "Detaylar" ekranından kıyaslayabilirsiniz.</small>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary">İlan Ver</button>
        </div>
      </form>
    </div>
  </div>
</div>
