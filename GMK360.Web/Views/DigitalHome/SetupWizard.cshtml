@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
        // Adım Değiştirme (Asenkron - Kaydederek)
        async function nextStep(targetStep) {
            var targetPaneId = 'pane-' + targetStep;
            var form = document.getElementById('wizardForm');
            var formData = new FormData(form);
            var propertyId = document.getElementById('draftPropertyId')?.value;

            // Eğer pane-1'den pane-2'ye geçiliyorsa (Step 1 -> 2)
            if (targetPaneId === 'pane-2') {
                // Form validasyon kontrolü (Adres vb. dolu mu)
                if (!document.getElementById('propertyTypeSelect').value || !document.getElementById('citySelect').value) {
                    alert('Lütfen zorunlu adres alanlarını doldurun.');
                    return;
                }

                // isComplex && globalSiteSelect manuel eklemeleri
                var isComplex = document.getElementById('isComplexCheck').checked;
                var globalSiteSelect = $('#globalSiteSearch').val();
                
                if (isComplex && globalSiteSelect && globalSiteSelect !== 'NEW') {
                    formData.append('streetId', $('#hiddenStreetId').val());
                    formData.append('city', $('#hiddenCity').val());
                    formData.append('district', $('#hiddenDistrict').val());
                    formData.append('neighborhood', $('#hiddenNeighborhood').val());
                    formData.append('selectedComplexName', $('#hiddenComplexName').val());
                } else if (isComplex && globalSiteSelect === 'NEW') {
                    formData.append('selectedComplexName', 'NEW');
                }

                // AJAX isteği
                try {
                    let response = await fetch('/DigitalHome/SaveWizardStep1', {
                        method: 'POST',
                        body: formData
                    });
                    
                    if (!response.ok) {
                        let errorText = await response.text();
                        alert('Kayıt Başarısız (Hata Kodu: ' + response.status + '): ' + errorText);
                        return;
                    }
                    
                    let result = await response.json();
                    
                    if (result.success) {
                        document.getElementById('draftPropertyId').value = result.propertyId; // Sonraki adımlar için kaydet
                    } else {
                        if (result.requiresPro) {
                            var proModal = new bootstrap.Modal(document.getElementById('proRequiredModal'));
                            document.getElementById('proRequiredMessage').innerText = result.message;
                            proModal.show();
                            return; // Geçişi durdur
                        }
                        alert('Adres kaydedilirken bir hata oluştu: ' + (result.message || 'Bilinmeyen hata'));
                        return;
                    }
                } catch(e) {
                    console.error(e);
                    alert('Sunucuya bağlanılamadı.');
                    return;
                }
            }

            // Eğer pane-2'den pane-3'e geçiliyorsa (Step 2 -> 3) (Mülk Özellikleri kaydediliyor)
            if (targetPaneId === 'pane-3') {
                var formDataStep2 = new FormData(form);
                formDataStep2.append('propertyId', propertyId);
                
                try {
                    let response = await fetch('/DigitalHome/SaveWizardStep2', {
                        method: 'POST',
                        body: formDataStep2
                    });
                    
                    if (!response.ok) {
                        let errorText = await response.text();
                        alert('Mülk özellikleri kaydedilemedi: ' + errorText);
                        return;
                    }
                    
                    let result = await response.json();
                    if (!result.success) {
                        alert('Özellikler kaydedilirken bir hata oluştu.');
                        return;
                    }
                } catch(e) {
                    console.error(e);
                    alert('Sunucuya bağlanılamadı.');
                    return;
                }
            }

            // Eğer pane-3'ten pane-4'e geçiliyorsa (Step 3 -> 4) (Rol kaydediliyor)
            if (targetPaneId === 'pane-4') {
                var role = document.getElementById('userRoleInput').value;
                if (!role) {
                    alert('Lütfen bir rol seçin.');
                    return;
                }
                
                var data = new FormData();
                data.append('propertyId', propertyId);
                data.append('userRole', role);
                data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                try {
                    let response = await fetch('/DigitalHome/SaveWizardStep3', {
                        method: 'POST',
                        body: data
                    });
                    let result = await response.json();
                    
                    if (!result.success) {
                        alert('Rol kaydedilirken bir hata oluştu.');
                        return;
                    }
                } catch(e) {
                    console.error(e);
                    alert('Sunucuya bağlanılamadı.');
                    return;
                }
            }

            // UI Geçişi
            document.querySelectorAll('.wizard-pane').forEach(p => p.classList.add('d-none'));
            document.querySelectorAll('.wizard-pane').forEach(p => p.classList.remove('active'));
            
            var targetPane = document.getElementById(targetPaneId);
            if(targetPane) {
                targetPane.classList.remove('d-none');
                targetPane.classList.add('active');
            }

            // Finans form alanlarını role göre göster/gizle
            if (targetStep === 4) {
                var role = document.getElementById('userRoleInput').value;
                applyRoleUI(role);
            }

            updateProgressTracker(targetStep);
        }

        // Form Submit Handler (Step 3 Finalize)
        document.getElementById('wizardForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            var propertyId = document.getElementById('draftPropertyId')?.value;
            if(!propertyId) {
                alert("Önceki adımlar eksik, lütfen baştan başlayın.");
                return;
            }

            var formData = new FormData(this);
            formData.append('propertyId', propertyId);

            try {
                let response = await fetch('/DigitalHome/SaveWizardStep4', {
                    method: 'POST',
                    body: formData
                });
                let result = await response.json();
                
                if(result.success) {
                    window.location.href = result.redirectUrl;
                } else {
                    alert('Kayıt tamamlanırken bir hata oluştu: ' + (result.message || 'Bilinmeyen hata'));
                }
            } catch(e) {
                console.error(e);
                alert('Sunucuya bağlanırken veya işlem sırasında kritik bir hata oluştu.\nDetay: ' + e.message);
            }
        });

        function prevStep(step) {
            document.querySelectorAll('.wizard-pane').forEach(p => p.classList.add('d-none'));
            document.querySelectorAll('.wizard-pane').forEach(p => p.classList.remove('active'));
            
            var targetPane = document.getElementById('pane-' + step);
            if(targetPane) {
                targetPane.classList.remove('d-none');
                targetPane.classList.add('active');
            }
            updateProgressTracker(step);
        }

        function updateProgressTracker(step) {
            // İlerici bar ve simgelerin güncellenmesi
            let totalSteps = 4;
            let progress = ((step - 1) / totalSteps) * 100;
            if (step === 5) progress = 100;
            document.getElementById('wizardProgressBar').style.width = progress + '%';
            
            for (let i = 1; i <= 5; i++) {
                let icon = document.getElementById('icon-step-' + i);
                let text = document.getElementById('text-step-' + i);
                
                if (!icon) continue;

                if (i < step) {
                    // Geçmiş adımlar
                    icon.className = "rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-2 step-icon";
                    text.className = "fw-bold text-success small d-block step-text";
                } else if (i === step) {
                    // Mevcut adım
                    icon.className = "rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-2 shadow step-icon";
                    text.className = "fw-bold text-primary small d-block step-text";
                } else {
                    // Gelecek adımlar
                    icon.className = "rounded-circle bg-light text-secondary d-flex align-items-center justify-content-center mx-auto mb-2 step-icon";
                    text.className = "text-muted small d-block step-text";
                }
            }
        }

        function selectRole(roleName) {
            document.getElementById('userRoleInput').value = roleName;
            
            // Tüm kartlardan active class'ını kaldır
            document.querySelectorAll('.module-card').forEach(c => c.classList.remove('border-primary', 'bg-primary', 'bg-opacity-10'));
            
            // Seçili karta active class ekle
            var selectedRadio = document.querySelector('input[name="roleRadio"]:checked');
            if (selectedRadio) {
                var label = selectedRadio.closest('label');
                label.classList.add('border-primary', 'bg-primary', 'bg-opacity-10');
            }
            
            // Sonraki adım butonunu aktifleştir
            document.getElementById('btnStep3Next').disabled = false;
        }

        // UI Güncelleme Fonksiyonu
        function updateUI() {
            var propertyType = document.getElementById('propertyTypeSelect').value;
            var isComplexWrapper = document.getElementById('isComplexWrapper');
            
            // Daire(1), Villa(3), İş Yeri(4) için Site İçi butonu gösterilebilir
            if (propertyType === '1' || propertyType === '3' || propertyType === '4') {
                isComplexWrapper.style.setProperty('display', 'flex', 'important');
            } else {
                isComplexWrapper.style.setProperty('display', 'none', 'important');
                document.getElementById('isComplexCheck').checked = false;
            }

            var isComplex = document.getElementById('isComplexCheck').checked;
            var globalSiteSelect = $('#globalSiteSearch').val();
            
            var isNewBuilding = document.getElementById('buildingSelect').value === 'NEW';
            
            var normalBuildingNameArea = document.getElementById('normalBuildingNameArea');
            var normalBuildingNoArea = document.getElementById('normalBuildingNoArea');
            var complexNameArea = document.getElementById('complexNameArea');
            var complexBlockArea = document.getElementById('complexBlockArea');
            var newBuildingTitle = document.getElementById('newBuildingTitle');
            
            var buildingSelectArea = document.getElementById('buildingSelectArea');
            var complexSelectArea = document.getElementById('complexSelectArea');
            var newBuildingArea = document.getElementById('newBuildingArea');
            var doorNumberArea = document.getElementById('doorNumberArea');
            
            var locationSelectionArea = document.getElementById('locationSelectionArea');
            var globalSiteSearchArea = document.getElementById('globalSiteSearchArea');

            // Default
            document.getElementById('streetSelectArea').style.display = 'block';
            document.getElementById('citySelect').required = true;
            document.getElementById('streetSelect').required = true;
            
            if (isComplex) {
                // SİTE İÇİ AÇIK (GLOBAL ARAMA)
                globalSiteSearchArea.style.display = 'block';
                buildingSelectArea.style.display = 'none';
                document.getElementById('buildingSelect').required = false;
                
                normalBuildingNameArea.classList.add('d-none');
                
                if (globalSiteSelect === 'NEW') {
                    // YENİ SİTE
                    locationSelectionArea.style.display = 'flex'; // İl ilçe seçimi ZORUNLU
                    document.getElementById('streetSelect').required = true;
                    
                    newBuildingArea.classList.remove('d-none');
                    complexNameArea.classList.remove('d-none');
                    complexBlockArea.classList.remove('d-none');
                    normalBuildingNoArea.classList.remove('d-none'); // Dış kapı no lazım
                    
                    document.getElementById('complexNameInput').required = true;
                    document.getElementById('complexBlockInput').required = true;
                    document.getElementById('newBuildingNo').required = true;
                    newBuildingTitle.innerHTML = '<i class="ph-fill ph-buildings me-1"></i> Yeni Site & Blok Ekle';
                    doorNumberArea.classList.remove('d-none');
                    
                    // Geleneksel site seçimi kapalı
                    complexSelectArea.style.display = 'none';
                    document.getElementById('complexSelect').required = false;
                } else if (globalSiteSelect) {
                    // MEVCUT SİTE SEÇİLDİ (Global)
                    locationSelectionArea.style.display = 'none'; // İl ilçe gizli, çünkü siteden otomatik geldi
                    document.getElementById('citySelect').required = false;
                    document.getElementById('districtSelect').required = false;
                    document.getElementById('neighborhoodSelect').required = false;
                    document.getElementById('streetSelect').required = false;
                    
                    newBuildingArea.classList.remove('d-none');
                    complexNameArea.classList.add('d-none');
                    complexBlockArea.classList.remove('d-none');
                    normalBuildingNoArea.classList.add('d-none'); // Mevcut sitenin dış kapı no'su zaten var
                    
                    document.getElementById('complexNameInput').required = false;
                    document.getElementById('complexBlockInput').required = true;
                    document.getElementById('newBuildingNo').required = false;
                    newBuildingTitle.innerHTML = '<i class="ph-fill ph-buildings me-1"></i> Hangi Blok?';
                    doorNumberArea.classList.remove('d-none');
                    
                    complexSelectArea.style.display = 'none';
                    document.getElementById('complexSelect').required = false;
                } else {
                    // Henüz site seçilmedi
                    locationSelectionArea.style.display = 'none';
                    document.getElementById('citySelect').required = false;
                    document.getElementById('streetSelect').required = false;
                    newBuildingArea.classList.add('d-none');
                    doorNumberArea.classList.add('d-none');
                    complexSelectArea.style.display = 'none';
                }
            } else {
                // NORMAL BİNA AÇIK (Klasik İl/İlçe/Sokak hiyerarşisi)
                globalSiteSearchArea.style.display = 'none';
                locationSelectionArea.style.display = 'flex';
                
                complexSelectArea.style.display = 'none';
                buildingSelectArea.style.display = 'block';
                document.getElementById('buildingSelect').required = true;
                document.getElementById('complexSelect').required = false;

                complexNameArea.classList.add('d-none');
                complexBlockArea.classList.add('d-none');
                document.getElementById('complexNameInput').required = false;
                document.getElementById('complexBlockInput').required = false;

                if (isNewBuilding) {
                    // YENİ BİNA
                    newBuildingArea.classList.remove('d-none');
                    normalBuildingNameArea.classList.remove('d-none');
                    normalBuildingNoArea.classList.remove('d-none');
                    
                    document.getElementById('newBuildingNo').required = true;
                    newBuildingTitle.innerHTML = '<i class="ph-fill ph-buildings me-1"></i> Yeni Bina Ekle';
                    doorNumberArea.classList.remove('d-none');
                } else if (document.getElementById('buildingSelect').value) {
                    // MEVCUT BİNA
                    newBuildingArea.classList.add('d-none');
                    doorNumberArea.classList.remove('d-none');
                } else {
                    newBuildingArea.classList.add('d-none');
                    doorNumberArea.classList.add('d-none');
                }
            }
        }

        document.getElementById('propertyTypeSelect').addEventListener('change', updateUI);
        document.getElementById('isComplexCheck').addEventListener('change', updateUI);

        $(document).ready(function() {
            $('#globalSiteSearch').select2({
                theme: 'bootstrap-5',
                placeholder: 'Lütfen sitenizin adını yazın...',
                minimumInputLength: 3,
                language: {
                    inputTooShort: function() { return "En az 3 karakter girmelisiniz"; },
                    noResults: function() { return "Site bulunamadı."; },
                    searching: function() { return "Aranıyor..."; }
                },
                ajax: {
                    url: '/api/LocationApi/complexes/search',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term };
                    },
                    processResults: function (data, params) {
                        var searchTerm = params.term || '';
                        var results = data.map(function(item) {
                            return {
                                id: item.id,
                                text: item.text,
                                data: item
                            };
                        });
                        results.push({ id: 'NEW', text: '+ Listede Yok (Yeni Site Ekle)', data: null, searchTerm: searchTerm.toLocaleUpperCase('tr-TR') });
                        return { results: results };
                    },
                    cache: true
                }
            });

            $('#globalSiteSearch').on('select2:select', function (e) {
                var data = e.params.data;
                if(data.id !== 'NEW' && data.data) {
                    // Populate hidden inputs for the backend
                    $('#hiddenCity').val(data.data.cityName);
                    $('#hiddenDistrict').val(data.data.districtName);
                    $('#hiddenNeighborhood').val(data.data.neighborhoodName);
                    $('#hiddenStreetId').val(data.data.streetId);
                    $('#hiddenComplexName').val(data.data.name);
                    
                    $('#complexNameInput').val(data.data.name);
                } else if (data.id === 'NEW' && data.searchTerm) {
                    $('#complexNameInput').val(data.searchTerm);
                }
                updateUI();
            });


            var modalMap = null;
            var modalMarker = null;

            var mapModalEl = document.getElementById('mapModal');
            if (mapModalEl) {
                mapModalEl.addEventListener('shown.bs.modal', function () {
                    var lat = 41.0082;
                    var lng = 28.9784; // Default İstanbul
                    
                    var initMap = function(latitude, longitude, zoomLevel) {
                        if (!modalMap) {
                            modalMap = L.map('modalMap').setView([latitude, longitude], zoomLevel);
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                maxZoom: 19
                            }).addTo(modalMap);

                            modalMarker = L.marker([latitude, longitude], { draggable: true }).addTo(modalMap);
                            
                            document.getElementById('ncLat').value = latitude.toFixed(6);
                            document.getElementById('ncLng').value = longitude.toFixed(6);

                            modalMarker.on('dragend', function (e) {
                                var position = modalMarker.getLatLng();
                                document.getElementById('ncLat').value = position.lat.toFixed(6);
                                document.getElementById('ncLng').value = position.lng.toFixed(6);
                            });

                            modalMap.on('click', function(e) {
                                modalMarker.setLatLng(e.latlng);
                                document.getElementById('ncLat').value = e.latlng.lat.toFixed(6);
                                document.getElementById('ncLng').value = e.latlng.lng.toFixed(6);
                            });
                        } else {
                            setTimeout(function() {
                                modalMap.invalidateSize();
                                modalMap.setView([latitude, longitude], zoomLevel);
                                modalMarker.setLatLng([latitude, longitude]);
                                document.getElementById('ncLat').value = latitude.toFixed(6);
                                document.getElementById('ncLng').value = longitude.toFixed(6);
                            }, 100);
                        }
                    };
                    
                    // Eğer formda seçili il/ilçe/mahalle/sokak varsa onun koordinatını getirelim
                    var citySelect = document.getElementById('citySelect');
                    var distSelect = document.getElementById('districtSelect');
                    var neighSelect = document.getElementById('neighborhoodSelect');
                    var streetSelect = document.getElementById('streetSelect');
                    
                    var cityName = citySelect.options[citySelect.selectedIndex]?.text || '';
                    var distName = distSelect.options[distSelect.selectedIndex]?.text || '';
                    var neighName = neighSelect.options[neighSelect.selectedIndex]?.text || '';
                    var streetName = streetSelect.options[streetSelect.selectedIndex]?.text || '';
                    
                    if(cityName && distName && !cityName.includes('Seçiniz') && !distName.includes('Seçiniz')) {
                        var queryParts = [];
                        if (streetName && !streetName.includes('Seçiniz')) queryParts.push(streetName.replace('(Sokak)', '').replace('(Cadde)', '').trim());
                        if (neighName && !neighName.includes('Seçiniz')) queryParts.push(neighName.replace('MAHALLESİ', 'Mahallesi').trim());
                        queryParts.push(distName);
                        queryParts.push(cityName);
                        queryParts.push("Turkey");
                        
                        var query = queryParts.join(", ");
                        
                        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`)
                            .then(res => res.json())
                            .then(data => {
                                if(data && data.length > 0) {
                                    // Sokak/mahalle bazlı bulduğunda daha yakından (zoom 17) başlasın
                                    initMap(parseFloat(data[0].lat), parseFloat(data[0].lon), 17);
                                } else {
                                    // Eğer bu detaylı arama sonuç vermezse, sadece İlçe ve Şehir ile tekrar ara
                                    var fallbackQuery = `${distName}, ${cityName}, Turkey`;
                                    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(fallbackQuery)}&limit=1`)
                                        .then(res2 => res2.json())
                                        .then(data2 => {
                                            if(data2 && data2.length > 0) {
                                                initMap(parseFloat(data2[0].lat), parseFloat(data2[0].lon), 14);
                                            } else {
                                                initMap(lat, lng, 13);
                                            }
                                        }).catch(err => { initMap(lat, lng, 13); });
                                }
                            })
                            .catch(err => {
                                initMap(lat, lng, 13);
                            });
                    } else {
                        initMap(lat, lng, 13);
                    }
                });
            }

            
            updateUI();
        });

        // Initial state logic for drafts
        document.addEventListener('DOMContentLoaded', function() {
            var initialStep = parseInt(document.getElementById('initialDraftStep')?.value || '0');
            if (initialStep > 0) {
                var targetStep = initialStep + 1;
                
                document.querySelectorAll('.wizard-pane').forEach(p => p.classList.add('d-none'));
                document.querySelectorAll('.wizard-pane').forEach(p => p.classList.remove('active'));
                
                var targetPane = document.getElementById('pane-' + targetStep);
                if(targetPane) {
                    targetPane.classList.remove('d-none');
                    targetPane.classList.add('active');
                }
                
                // Eğer sayfa yenilendiğinde 3. adımdaysak, UI'ı role göre ayarla
                if (targetStep === 3) {
                    var role = document.getElementById('userRoleInput').value;
                    if (role) {
                        applyRoleUI(role);
                    }
                }
            }
        });

        function applyRoleUI(role) {
            var duesItem = document.getElementById('duesAreaItem');
            var rentItem = document.getElementById('rentAreaItem');
            var tenantPayeeDiv = document.getElementById('tenantPayeeDiv');
            var ownerTenantInfoDiv = document.getElementById('ownerTenantInfoDiv');
            
            if (role === 'Tenant') {
                duesItem.classList.remove('d-none');
                rentItem.classList.remove('d-none');
                
                document.getElementById('collapseDues').classList.add('show');
                document.getElementById('collapseRent').classList.remove('show');
                document.getElementById('btnCollapseRent').classList.add('collapsed');
                
                tenantPayeeDiv.classList.remove('d-none');
                ownerTenantInfoDiv.classList.add('d-none');
            } else if (role === 'OwnerLiving') {
                duesItem.classList.remove('d-none');
                rentItem.classList.add('d-none');
                
                document.getElementById('collapseDues').classList.add('show');
                
            } else if (role === 'OwnerInvestment') {
                duesItem.classList.add('d-none');
                rentItem.classList.remove('d-none');
                
                document.getElementById('collapseDues').classList.remove('show');
                document.getElementById('collapseRent').classList.add('show');
                document.getElementById('btnCollapseRent').classList.remove('collapsed');
                
                tenantPayeeDiv.classList.add('d-none');
                ownerTenantInfoDiv.classList.remove('d-none');
            }
        }

        // Ajax İlçe Yükleme
        document.getElementById('citySelect').addEventListener('change', function() {
            var cityId = this.options[this.selectedIndex].getAttribute('data-id');
            var districtSelect = document.getElementById('districtSelect');
            var neighborhoodSelect = document.getElementById('neighborhoodSelect');
            
            districtSelect.innerHTML = '<option value="">Yükleniyor...</option>';
            districtSelect.disabled = true;
            neighborhoodSelect.innerHTML = '<option value="">Önce İlçe Seçiniz</option>';
            neighborhoodSelect.disabled = true;

            if(!cityId) return;

            fetch('/api/LocationApi/districts/' + cityId)
                .then(response => response.json())
                .then(data => {
                    districtSelect.innerHTML = '<option value="">İlçe Seçiniz</option>';
                    data.forEach(item => {
                        districtSelect.innerHTML += `<option value="${item.name}" data-id="${item.id}">${item.name}</option>`;
                    });
                    districtSelect.disabled = false;
                });
        });

        // Ajax Mahalle Yükleme
        document.getElementById('districtSelect').addEventListener('change', function() {
            var districtId = this.options[this.selectedIndex].getAttribute('data-id');
            var neighborhoodSelect = document.getElementById('neighborhoodSelect');
            var streetSelect = document.getElementById('streetSelect');
            
            neighborhoodSelect.innerHTML = '<option value="">Yükleniyor...</option>';
            neighborhoodSelect.disabled = true;
            streetSelect.innerHTML = '<option value="">Önce Mahalle Seçiniz</option>';
            streetSelect.disabled = true;

            if(!districtId) return;

            fetch('/api/LocationApi/neighborhoods/' + districtId)
                .then(response => response.json())
                .then(data => {
                    neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçiniz</option>';
                    data.forEach(item => {
                        neighborhoodSelect.innerHTML += `<option value="${item.name}" data-id="${item.id}">${item.name}</option>`;
                    });
                    neighborhoodSelect.disabled = false;
                });
        });

        // Ajax Sokak Yükleme
        document.getElementById('neighborhoodSelect').addEventListener('change', function() {
            var neighborhoodId = this.options[this.selectedIndex].getAttribute('data-id');
            var streetSelect = document.getElementById('streetSelect');
            
            streetSelect.innerHTML = '<option value="">Yükleniyor...</option>';
            streetSelect.disabled = true;
            
            if(!neighborhoodId) return;

            fetch('/api/LocationApi/streets/' + neighborhoodId)
                .then(response => response.json())
                .then(data => {
                    streetSelect.innerHTML = '<option value="">Sokak Seçiniz</option>';
                    data.forEach(item => {
                        streetSelect.innerHTML += `<option value="${item.id}" data-id="${item.id}">${item.name}</option>`;
                    });
                    streetSelect.disabled = false;
                });
        });

        // Ajax Bina Yükleme (Sokağa göre - Klasik Akış)
        document.getElementById('streetSelect').addEventListener('change', function() {
            var streetId = this.options[this.selectedIndex].getAttribute('data-id');
            var isComplex = document.getElementById('isComplexCheck').checked;
            
            if(!streetId || isComplex) return; // Site içiyse artık burası çalışmaz (Globalden seçiyor)

            var buildingSelect = document.getElementById('buildingSelect');
            buildingSelect.innerHTML = '<option value="">Yükleniyor...</option>';
            buildingSelect.disabled = true;
            
            fetch('/api/LocationApi/buildings/' + streetId)
                .then(response => response.json())
                .then(data => {
                    buildingSelect.innerHTML = '<option value="">Bina Seçiniz</option>';
                    data.forEach(item => {
                        var buildingLabel = item.name;
                        if (item.buildingNumber) buildingLabel += ` (No: ${item.buildingNumber})`;
                        if (item.blockName) buildingLabel += ` (${item.blockName} Blok)`;
                        buildingSelect.innerHTML += `<option value="${item.id}" data-id="${item.id}">${buildingLabel}</option>`;
                    });
                    buildingSelect.innerHTML += `<option value="NEW" class="fw-bold text-primary">+ Listede Yok (Yeni Ekle)</option>`;
                    buildingSelect.disabled = false;
                    updateUI();
                });
        });

        document.getElementById('buildingSelect').addEventListener('change', updateUI);

        // UPPERCASE Event Listener
        document.querySelectorAll('.uppercase-input').forEach(function(input) {
            input.addEventListener('input', function() {
                this.value = this.value.toLocaleUpperCase('tr-TR');
            });
        });
        
        document.getElementById('buildingSelect').addEventListener('change', function() {
            var val = this.value;
            var newBuildingArea = document.getElementById('newBuildingArea');
            
            if(val === 'NEW') {
                newBuildingArea.classList.remove('d-none');
            } else {
                newBuildingArea.classList.add('d-none');
                document.getElementById('newBuildingName').value = "";
                document.getElementById('newBuildingNo').value = "";
                document.getElementById('complexNameInput').value = "";
                document.getElementById('complexBlockInput').value = "";
            }
            updateUI();
        });
    </script>
