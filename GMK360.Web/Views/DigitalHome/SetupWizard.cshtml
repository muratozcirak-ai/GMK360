@model GMK360.Core.Entities.Property
@{
    ViewData["Title"] = "Dijital Evim - Adım 1: Adres Seçimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int draftStep = Model?.DraftStep ?? 0;
}



<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<div class="container py-5" style="margin-top: 2rem;">
    
    <!-- Wizard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-1">Dijital Evinizi Kuralım</h2>
            <p class="text-muted">Ev yönetimi, aidat ve vergi takibi için adresinizi belirleyin.</p>
        </div>
        <a href="/CustomerDashboard" class="btn btn-light text-secondary rounded-pill px-4 fw-medium border shadow-sm hover-bg-light">
            Şimdilik Atla <i class="ph ph-arrow-right ms-1"></i>
        </a>
    </div>

    <!-- PRO Upgrade Modal -->
    <div class="modal fade" id="proRequiredModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-0 bg-warning bg-opacity-10 pb-0 pt-4 px-4 position-relative">
                    <div class="position-absolute top-0 end-0 p-3">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="text-center w-100">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning text-white rounded-circle shadow-sm mb-3" style="width: 70px; height: 70px;">
                            <i class="ph-fill ph-crown" style="font-size: 2.5rem;"></i>
                        </div>
                        <h4 class="modal-title fw-bold text-dark mb-2">PRO Sınırına Ulaştınız</h4>
                    </div>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="text-muted mb-4 fs-6" id="proRequiredMessage">
                        Ücretsiz planda sadece tek bir bina/lokasyonda mülk yönetebilirsiniz. Kat karşılığı edindiğiniz veya farklı bölgelerdeki diğer mülklerinizi tek ekrandan yönetmek için PRO pakete geçiş yapmanız gerekmektedir.
                    </p>
                    <div class="bg-light rounded-3 p-3 mb-4 text-start">
                        <h6 class="fw-bold text-dark mb-3"><i class="ph-fill ph-check-circle text-success me-2"></i>PRO Paket Avantajları:</h6>
                        <ul class="list-unstyled mb-0 small text-muted">
                            <li class="mb-2"><i class="ph ph-check text-primary me-2 fw-bold"></i>Sınırsız farklı lokasyonda mülk ekleme</li>
                            <li class="mb-2"><i class="ph ph-check text-primary me-2 fw-bold"></i>Toplu finansal raporlama</li>
                            <li class="mb-0"><i class="ph ph-check text-primary me-2 fw-bold"></i>Öncelikli destek ve yasal asistan</li>
                        </ul>
                    </div>
                    <a href="/Subscription/Upgrade" class="btn btn-warning w-100 py-3 rounded-pill fw-bold text-dark shadow-sm hover-lift">
                        Hemen PRO'ya Geç
                    </a>
                    <button type="button" class="btn btn-link text-muted text-decoration-none mt-2 w-100" data-bs-dismiss="modal">
                        Belki Daha Sonra
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Sayfa sonu için boşluk -->
    <div style="height: 100px;"></div>

    <!-- Progress Tracker -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between position-relative">
                <div class="progress position-absolute w-100" style="height: 4px; z-index: 0; top: 50%; transform: translateY(-50%);">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 20%;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100" id="wizardProgressBar"></div>
                </div>
                
                <div class="position-relative z-1 text-center bg-white px-2">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-2 shadow step-icon" id="icon-step-1" style="width: 40px; height: 40px; border: 4px solid #fff;">
                        <i class="ph-fill ph-map-pin"></i>
                    </div>
                    <span class="fw-bold text-primary small d-block step-text" id="text-step-1">1. Adres</span>
                </div>
                
                <div class="position-relative z-1 text-center bg-white px-2">
                    <div class="rounded-circle bg-light text-secondary d-flex align-items-center justify-content-center mx-auto mb-2 step-icon" id="icon-step-2" style="width: 40px; height: 40px; border: 4px solid #fff;">
                        <i class="ph ph-house"></i>
                    </div>
                    <span class="text-muted small d-block step-text" id="text-step-2">2. Özellikler</span>
                </div>

                <div class="position-relative z-1 text-center bg-white px-2">
                    <div class="rounded-circle bg-light text-secondary d-flex align-items-center justify-content-center mx-auto mb-2 step-icon" id="icon-step-3" style="width: 40px; height: 40px; border: 4px solid #fff;">
                        <i class="ph ph-user-circle"></i>
                    </div>
                    <span class="text-muted small d-block step-text" id="text-step-3">3. Rol</span>
                </div>
                
                <div class="position-relative z-1 text-center bg-white px-2">
                    <div class="rounded-circle bg-light text-secondary d-flex align-items-center justify-content-center mx-auto mb-2 step-icon" id="icon-step-4" style="width: 40px; height: 40px; border: 4px solid #fff;">
                        <i class="ph ph-receipt"></i>
                    </div>
                    <span class="text-muted small d-block step-text" id="text-step-4">4. Finans</span>
                </div>
                
                <div class="position-relative z-1 text-center bg-white px-2">
                    <div class="rounded-circle bg-light text-secondary d-flex align-items-center justify-content-center mx-auto mb-2 step-icon" id="icon-step-5" style="width: 40px; height: 40px; border: 4px solid #fff;">
                        <i class="ph ph-check-circle"></i>
                    </div>
                    <span class="text-muted small d-block step-text" id="text-step-5">Bitti</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="row g-0 justify-content-center">
            <!-- Form Alanı -->
            <div class="col-lg-8">
                <div class="p-5">
                    <form id="wizardForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="draftPropertyId" name="propertyId" value="@(Model?.Id)" />
                        <input type="hidden" id="initialDraftStep" value="@draftStep" />
                        
                        <!-- PANE 1: ADRES -->
                        <div class="wizard-pane active" id="pane-1">
                            <h4 class="fw-bold mb-4">Mülk ve Adres Bilgileri</h4>
                            <div class="row g-3 mb-4">
                                <div class="col-md-8">
                                    <label class="form-label text-muted small fw-bold">Mülk Türü</label>
                                    <select name="propertySubTypeId" id="propertyTypeSelect" class="form-select form-select-lg premium-input" required>
                                        <option value="">Seçiniz</option>
                                        <option value="1">Daire / Apartman Dairesi</option>
                                        <option value="2">Müstakil Ev</option>
                                        <option value="3">Villa</option>
                                        <option value="4">İş Yeri / Ofis</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end" id="isComplexWrapper" style="display: none !important;">
                                    <div class="form-check form-switch mb-2 w-100 p-3 bg-light rounded-3 border text-center">
                                        <input class="form-check-input float-none ms-0 me-2" type="checkbox" name="isComplex" id="isComplexCheck" value="true">
                                        <label class="form-check-label text-primary fw-bold" style="cursor:pointer;" for="isComplexCheck">
                                            🏢 Site İçi Mi?
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mb-4" id="globalSiteSearchArea" style="display: none;">
                                <div class="col-md-12">
                                    <label class="form-label text-primary fw-bold"><i class="ph-fill ph-magnifying-glass"></i> Site Arama</label>
                                    <select id="globalSiteSearch" class="form-select form-select-lg premium-input border-primary">
                                        <option value="">Lütfen sitenizin adını yazın...</option>
                                    </select>
                                    <small class="text-muted mt-1 d-block">Siteniz listede çıkmazsa "Yeni Site Ekle" diyebilirsiniz.</small>
                                </div>
                            </div>

                            <div class="row g-3" id="locationSelectionArea">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold">İl</label>
                                    <select name="city" id="citySelect" class="form-select form-select-lg premium-input" required>
                                        <option value="">İl Seçiniz</option>
                                        @if(ViewBag.Cities != null)
                                        {
                                            foreach(var city in ViewBag.Cities)
                                            {
                                                <option value="@city.Name" data-id="@city.Id">@city.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold">İlçe</label>
                                    <select name="district" id="districtSelect" class="form-select form-select-lg premium-input" disabled required>
                                        <option value="">Önce İl Seçiniz</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-12">
                                    <label class="form-label text-muted small fw-bold">Mahalle / Köy</label>
                                    <select name="neighborhood" id="neighborhoodSelect" class="form-select form-select-lg premium-input" disabled required>
                                        <option value="">Önce İlçe Seçiniz</option>
                                    </select>
                                </div>
                                
                                

                                <div class="col-md-12" id="streetSelectArea">
                                    <label class="form-label text-muted small fw-bold">Cadde / Sokak</label>
                                    <select name="streetId" id="streetSelect" class="form-select form-select-lg premium-input" disabled required>
                                        <option value="">Önce Mahalle Seçiniz</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-12" id="buildingSelectArea">
                                    <label class="form-label text-muted small fw-bold">Bina Seçimi</label>
                                    <select name="buildingId" id="buildingSelect" class="form-select form-select-lg premium-input" disabled required>
                                        <option value="">Önce Sokak Seçiniz</option>
                                    </select>
                                </div>

                                <div class="col-md-12 mt-2" id="complexSelectArea" style="display:none;">
                                    <label class="form-label text-primary small fw-bold">Site Seçimi</label>
                                    <select name="selectedComplexName" id="complexSelect" class="form-select form-select-lg premium-input border-primary">
                                        <option value="">Önce Sokak Seçiniz</option>
                                    </select>
                                </div>

                                
                                <input type="hidden" name="hiddenCity" id="hiddenCity" />
                                <input type="hidden" name="hiddenDistrict" id="hiddenDistrict" />
                                <input type="hidden" name="hiddenNeighborhood" id="hiddenNeighborhood" />
                                <input type="hidden" name="hiddenStreetId" id="hiddenStreetId" />
                                <input type="hidden" name="hiddenComplexName" id="hiddenComplexName" />

                                <!-- YENİ BİNA EKLEME ALANI (GİZLİ) -->
                                <div class="col-md-12 d-none mt-3" id="newBuildingArea">
                                    <div class="p-4 bg-light rounded-4 border">
                                        <h6 class="fw-bold mb-3 text-primary" id="newBuildingTitle"><i class="ph-fill ph-plus-circle me-2"></i>Yeni Bina / Site Tanımlama</h6>
                                        <div class="row g-3">
                                            <div class="col-md-8" id="normalBuildingNameArea">
                                                <label class="form-label text-muted small fw-bold">Bina Adı (Eğer Yoksa)</label>
                                                <input type="text" name="newBuildingName" id="newBuildingName" class="form-control premium-input uppercase-input" placeholder="Örn: YAŞAR BEY APARTMANI">
                                            </div>
                                            <div class="col-md-4" id="normalBuildingNoArea">
                                                <label class="form-label text-muted small fw-bold">Dış Kapı No</label>
                                                <input type="text" name="newBuildingNo" id="newBuildingNo" class="form-control premium-input uppercase-input" placeholder="Örn: 16">
                                            </div>
                                            
                                            <!-- Düz Bina İçin Blok Seçeneği -->
                                            <div class="col-md-12 mt-2" id="normalBuildingBlockCheckboxArea">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="normalBuildingHasBlockCheck" onchange="toggleNormalBuildingBlock()">
                                                    <label class="form-check-label text-muted small fw-bold" for="normalBuildingHasBlockCheck">Bu binanın girişi/bloğu var mı? (Örn: A Blok)</label>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6 d-none" id="normalBuildingBlockNameArea">
                                                <label class="form-label text-muted small fw-bold">Blok Adı</label>
                                                <input type="text" name="normalBuildingBlockName" id="normalBuildingBlockName" class="form-control premium-input uppercase-input" placeholder="Örn: A">
                                            </div>

                                            <!-- Site Seçilmiş Ama Yeni Ekle Denmişse Çıkacak Alanlar -->
                                            <div class="col-md-8 d-none" id="complexNameArea">
                                                <label class="form-label text-muted small fw-bold">Yeni Site Adı</label>
                                                <input type="text" name="complexName" id="complexNameInput" class="form-control premium-input uppercase-input" placeholder="Örn: HUZUR SİTESİ">
                                            </div>
                                            <div class="col-md-4 d-none" id="complexBlockArea">
                                                <label class="form-label text-muted small fw-bold">Blok Adı</label>
                                                <input type="text" name="complexBlock" id="complexBlockInput" class="form-control premium-input uppercase-input" placeholder="Örn: A">
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <script>
                                        function toggleNormalBuildingBlock() {
                                            var isChecked = document.getElementById('normalBuildingHasBlockCheck').checked;
                                            var blockNameArea = document.getElementById('normalBuildingBlockNameArea');
                                            
                                            if (isChecked) {
                                                blockNameArea.classList.remove('d-none');
                                            } else {
                                                blockNameArea.classList.add('d-none');
                                                document.getElementById('normalBuildingBlockName').value = '';
                                            }
                                        }
                                    </script>
                                </div>
                                
                                <div class="col-md-6 mt-3 d-none" id="doorNumberArea">
                                    <label class="form-label text-muted small fw-bold">İç Kapı / Daire No</label>
                                    <input type="text" name="doorNumber" class="form-control form-control-lg premium-input uppercase-input" placeholder="Örn: 5">
                                </div>

                                <!-- Koordinat Alanı -->
                                <div class="col-md-12 mt-3">
                                    <label class="form-label text-muted small fw-bold">Binanın Konumu (Haritadan İşaretleyin - İsteğe Bağlı)</label>
                                    <div class="d-flex gap-2 align-items-center">
                                        <button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#mapModal">
                                            <i class="ph-fill ph-map-pin me-1"></i> Haritadan Seç
                                        </button>
                                        <input type="text" name="lat" id="ncLat" class="form-control premium-input bg-light text-muted" placeholder="Enlem" readonly />
                                        <input type="text" name="lng" id="ncLng" class="form-control premium-input bg-light text-muted" placeholder="Boylam" readonly />
                                    </div>
                                    <div class="form-text text-muted small mt-1"><i class="ph ph-info"></i> Haritadan seçtiğiniz konum buraya otomatik yansır.</div>
                                </div>

                            <div class="mt-5 d-flex justify-content-between align-items-center">
                                <a href="/CustomerDashboard" class="text-muted text-decoration-none hover-primary fw-medium">İptal</a>
                                <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow" onclick="nextStep(2)">Sonraki Adım <i class="ph ph-caret-right ms-2"></i></button>
                            </div>
                        </div>
                        <!-- pane-1 kapanışı -->
                        </div>

                        <!-- PANE 2: MÜLK ÖZELLİKLERİ -->
                        <div class="wizard-pane d-none" id="pane-2">
                            <h4 class="fw-bold mb-4">Mülk Özellikleri</h4>
                            <p class="text-muted mb-4">Mülkünüzün temel detaylarını ve donanımlarını girerek yapay zeka destekli değerleme için profilinizi oluşturun.</p>
                            
                            <div class="row g-4">
                                <div class="col-md-12">
                                    <label class="form-label text-muted small fw-bold">Mülkünüzün Özel Adı (Sizin için bir isim)</label>
                                    <input type="text" name="title" id="propTitle" class="form-control form-control-lg premium-input" placeholder="Örn: Kadıköy Dükkan, Beylikdüzü Daire" value="@Model?.Title">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold">Brüt Metrekare</label>
                                    <div class="input-group">
                                        <input type="number" name="grossArea" id="grossArea" class="form-control form-control-lg premium-input border-end-0" placeholder="0" value="@Model?.GrossArea">
                                        <span class="input-group-text bg-white text-muted border-start-0">m²</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold">Net Metrekare</label>
                                    <div class="input-group">
                                        <input type="number" name="netArea" id="netArea" class="form-control form-control-lg premium-input border-end-0" placeholder="0" value="@Model?.NetArea">
                                        <span class="input-group-text bg-white text-muted border-start-0">m²</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold">Oda Sayısı</label>
                                    <select name="roomCount" id="roomCount" class="form-select form-select-lg premium-input">
                                        <option value="">Seçiniz</option>
                                        <option value="1+0">1+0 (Stüdyo)</option>
                                        <option value="1+1">1+1</option>
                                        <option value="2+1">2+1</option>
                                        <option value="3+1">3+1</option>
                                        <option value="4+1">4+1</option>
                                        <option value="5+1">5+1 ve üzeri</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold">Banyo Sayısı</label>
                                    <input type="number" name="bathroomCount" id="bathroomCount" class="form-control form-control-lg premium-input" placeholder="1" value="@Model?.BathroomCount">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold">Bulunduğu Kat</label>
                                    <input type="number" name="floorNumber" id="floorNumber" class="form-control form-control-lg premium-input" placeholder="0" value="@Model?.FloorNumber">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label text-muted small fw-bold">Bina Yaşı</label>
                                    <select name="buildingAge" id="buildingAge" class="form-select form-select-lg premium-input">
                                        <option value="">Seçiniz</option>
                                        <option value="0">0 (Yeni)</option>
                                        <option value="1-5">1-5 Yaş</option>
                                        <option value="6-10">6-10 Yaş</option>
                                        <option value="11-20">11-20 Yaş</option>
                                        <option value="21+">21+ Yaş</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-12 mt-4">
                                    <label class="form-label text-primary small fw-bold"><i class="ph-fill ph-star me-1"></i> İlave Özellikler</label>
                                    <div class="row g-3">
                                        <div class="col-6 col-md-3">
                                            <div class="form-check form-switch bg-light p-3 rounded-3 border">
                                                <input class="form-check-input float-none ms-0 me-2" type="checkbox" name="hasParking" id="hasParking" value="true">
                                                <label class="form-check-label fw-bold text-muted" style="cursor:pointer;" for="hasParking">Kapalı Otopark</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="form-check form-switch bg-light p-3 rounded-3 border">
                                                <input class="form-check-input float-none ms-0 me-2" type="checkbox" name="hasElevator" id="hasElevator" value="true">
                                                <label class="form-check-label fw-bold text-muted" style="cursor:pointer;" for="hasElevator">Asansör</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="form-check form-switch bg-light p-3 rounded-3 border">
                                                <input class="form-check-input float-none ms-0 me-2" type="checkbox" name="hasShowerCabin" id="hasShowerCabin" value="true">
                                                <label class="form-check-label fw-bold text-muted" style="cursor:pointer;" for="hasShowerCabin">Duşakabin</label>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="form-check form-switch bg-light p-3 rounded-3 border">
                                                <input class="form-check-input float-none ms-0 me-2" type="checkbox" name="isFurnished" id="isFurnished" value="true">
                                                <label class="form-check-label fw-bold text-muted" style="cursor:pointer;" for="isFurnished">Eşyalı</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-5 d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-light fw-medium rounded-pill px-4" onclick="prevStep(1)"><i class="ph ph-caret-left me-2"></i> Geri</button>
                                <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow" onclick="nextStep(3)">Sonraki Adım <i class="ph ph-caret-right ms-2"></i></button>
                            </div>
                        </div>

                        <!-- PANE 3: ROL SEÇİMİ -->
                        <div class="wizard-pane d-none" id="pane-3">
                            <h4 class="fw-bold mb-4">Bu Adresteki Durumunuz</h4>
                            <p class="text-muted mb-4">Sistem özelliklerini size göre ayarlamamız için bu evdeki rolünüzü seçin.</p>
                            
                            <input type="hidden" name="userRole" id="userRoleInput" value="@(Model?.ManagementRole != null ? (Model.ManagementRole == GMK360.Core.Entities.ManagementRole.Owner && Model.IsResident == false ? "OwnerInvestment" : (Model.ManagementRole == GMK360.Core.Entities.ManagementRole.Owner ? "OwnerLiving" : "Tenant")) : "")" />
                            
                            <div class="row g-3">
                                <!-- Kiracı -->
                                <div class="col-12">
                                    <label class="module-card border rounded p-4 d-block position-relative cursor-pointer hover-lift" for="role-tenant" onclick="selectRole('Tenant')">
                                        <input type="radio" name="roleRadio" id="role-tenant" class="d-none">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="bg-light p-3 rounded-circle text-primary">
                                                <i class="ph-fill ph-keys fs-2"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-navy mb-1">Kiracıyım</h5>
                                                <p class="text-muted small mb-0">Bu evde kiracı olarak yaşıyorum. Kira ve aidat takibi yapmak istiyorum.</p>
                                            </div>
