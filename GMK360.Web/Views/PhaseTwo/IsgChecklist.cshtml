@model IEnumerable<GMK360.Core.Entities.Construction.Workflows.MasterIsgQuestion>
@{
    ViewData["Title"] = "İSG ve Günlük Kontrol";
    Layout = "~/Views/Shared/_ProjectLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="fas fa-hard-hat text-warning me-2"></i>İSG ve Günlük Kontrol (Checklist)</h3>
            <p class="text-muted small mt-1 mb-0">Şefin sabah şantiyeyi açtığında kalıp veya beton başlamadan önce onaylaması gereken kritik iş güvenliği kilidi.</p>
        </div>
        <button class="btn btn-success fw-bold rounded-pill shadow-sm px-4"><i class="fas fa-check-double me-2"></i>Tümünü Onayla ve Şantiyeyi Aç</button>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4 border-top border-4 border-danger">
        <div class="card-header bg-transparent border-0 pt-4 pb-2">
            <h5 class="fw-bold text-danger mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Kırmızı Kodlu (Kritik) Sorular</h5>
            <p class="small text-muted mb-0">Bu sorular 'Evet' olarak işaretlenmeden hakediş veya üretim başlatılamaz.</p>
        </div>
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @if(!Model.Any())
                {
                    <li class="list-group-item p-4 text-center text-muted">Sistemde (Seed Data'da) İSG sorusu bulunamadı.</li>
                }
                @foreach(var q in Model.OrderByDescending(x => x.IsCritical))
                {
                    <li class="list-group-item p-4 d-flex justify-content-between align-items-center">
                        <div>
                            @if(q.IsCritical)
                            {
                                <span class="badge bg-danger mb-2">Kritik Kilit</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mb-2">Genel Kontrol</span>
                            }
                            <h6 class="fw-bold mb-1">@q.QuestionText</h6>
                            <span class="small text-muted"><i class="fas fa-tag me-1"></i> Faz: @q.PhaseCategory</span>
                        </div>
                        <div>
                            <div class="btn-group shadow-sm" role="group">
                                <input type="radio" class="btn-check" name="isg_@q.Id" id="isg_y_@q.Id" autocomplete="off">
                                <label class="btn btn-outline-success px-4" for="isg_y_@q.Id">Evet (Uygun)</label>

                                <input type="radio" class="btn-check" name="isg_@q.Id" id="isg_n_@q.Id" autocomplete="off">
                                <label class="btn btn-outline-danger px-4" for="isg_n_@q.Id">Hayır (Durdur)</label>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
