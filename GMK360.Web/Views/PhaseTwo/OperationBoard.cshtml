@model IEnumerable<GMK360.Core.Entities.Construction.Workflows.ProjectScheduleTask>
@{
    ViewData["Title"] = "Operasyon Planlama Panosu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int projectId = (int)ViewData["ProjectId"];
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="fas fa-calendar-alt text-primary me-2"></i> Operasyon Planlama Panosu</h4>
            <p class="text-muted mb-0">Þantiye þefinin süreleri belirlediði, alt görevlerin ve mühendislik bütçelerinin yönetildiði merkez.</p>
        </div>
        <div>
            <button class="btn btn-outline-primary fw-bold me-2" data-bs-toggle="modal" data-bs-target="#generateTasksModal">
                <i class="fas fa-magic me-1"></i> Bina Katlarýndan Ýþ Zinciri Üret
            </button>
            <button class="btn btn-outline-info fw-bold me-2">
                <i class="fas fa-cubes me-1"></i> DXF Malzemelerini Plana Daðýt
            </button>
            <button class="btn btn-primary fw-bold px-4">
                <i class="fas fa-save me-1"></i> Planý Kaydet
            </button>
        </div>
    </div>

    <!-- Modal for Generation -->
    <div class="modal fade" id="generateTasksModal" tabindex="-1" aria-labelledby="generateTasksModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="modal-header bg-primary text-white border-0 py-3">
            <h5 class="modal-title fw-bold" id="generateTasksModalLabel"><i class="fas fa-cogs me-2"></i>Ýþ Zinciri Üretim Ayarlarý</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4 bg-light">
<div class="alert alert-info border-0 small">
<i class="fas fa-info-circle me-1"></i> Faz 0'dan gelen kat sayisina gore standart is akisi olusturulacaktir.
</div>
</div>
<div class="modal-footer bg-white border-0">
<button type="button" class="btn btn-light fw-bold rounded-pill" data-bs-dismiss="modal">Iptal</button>
<a href="/PhaseTwo/GenerateOperationTasks/@projectId" class="btn btn-primary fw-bold rounded-pill px-4"><i class="fas fa-magic me-1"></i> Zinciri Uret</a>
</div>
        </div>
      </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 rounded-4 shadow-sm border-top border-4 border-info">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h6 class="fw-bold text-info mb-0"><i class="fas fa-project-diagram me-2"></i>Ana Ýþ Programý (Savaþ Planý)</h6>
                    <p class="small text-muted mb-0 mt-1">Bu ekran sadece planlama içindir. Sistem sýrayý belirler, þef hedeflenen gün sayýsýný girer.</p>
                </div>
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="list-group list-group-flush rounded-bottom" id="sortableTasks">
                            @foreach (var task in Model.Where(t => !t.IsCancelled).OrderBy(t => t.OrderIndex))
                            {
                                <div class="list-group-item p-3 bg-light border-bottom border-start border-4 border-secondary shadow-sm my-2 mx-3 rounded" data-task-id="@task.Id">
                                    <div class="row align-items-center">
                                        <div class="col-md-9"><i class="fas fa-grip-vertical text-muted me-2" style="cursor: grab;"></i>
                                            <span class="badge bg-secondary text-white mb-1">@task.FloorOrZone</span>
                                            <h5 class="fw-bold mb-0 text-dark" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#taskDetails-@task.Id">@task.TaskName <i class="fas fa-chevron-down ms-2 fs-6 text-muted"></i></h5>
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <div class="d-flex align-items-center justify-content-end mb-1">
                                                <small class="text-muted fw-bold me-2">Baþlangýç:</small>
                                                <input type="date" class="form-control form-control-sm w-auto d-inline border-info text-muted auto-save-input task-date" style="font-size:0.75rem;" title="Baþlangýç Tarihi" value="@(task.PlannedStartDate?.ToString("yyyy-MM-dd"))">
                                            </div>
                                            <div class="input-group input-group-sm float-end mb-1" style="width: 150px;">
                                                <span class="input-group-text bg-light border-0 fw-bold text-muted small">Süre:</span>
                                                <input type="number" class="form-control text-center fw-bold border-info auto-save-input task-duration" placeholder="0" value="@task.PlannedDurationDays">
                                                <span class="input-group-text bg-white fw-bold">Gün</span>
                                            </div>
                                            <div class="text-end mt-1">
                                                <span class="badge bg-success d-none save-badge"></span>
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1 ms-2" onclick="addNewTask(this)" title="Araya Ýþ Ekle"><i class="fas fa-plus"></i> Ekle</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="taskDetails-@task.Id" class="collapse mt-3 border-top pt-3">
                                        <ul class="nav nav-pills nav-sm mb-3" role="tablist">
                                            <li class="nav-item"><a class="nav-link active fw-bold small py-1 px-2 border" data-bs-toggle="tab" href="#prep-@task.Id"><i class="fas fa-clipboard-check me-1 text-secondary"></i>Ön Hazýrlýk</a></li>
                                            <li class="nav-item ms-1"><a class="nav-link fw-bold small py-1 px-2 border" data-bs-toggle="tab" href="#isg-@task.Id"><i class="fas fa-hard-hat me-1 text-warning"></i>ÝSG Kontrol</a></li>
                                            <li class="nav-item ms-1"><a class="nav-link fw-bold small py-1 px-2 border" data-bs-toggle="tab" href="#reserve-@task.Id"><i class="fas fa-star me-1 text-info"></i>Þef Notlarý (Yedek)</a></li>
                                            <li class="nav-item ms-1"><a class="nav-link fw-bold small py-1 px-2 border text-primary" data-bs-toggle="tab" href="#material-@task.Id"><i class="fas fa-cubes me-1"></i>Malzeme Hattý</a></li>
                                            <li class="nav-item ms-1"><a class="nav-link fw-bold small py-1 px-2 border text-success" data-bs-toggle="tab" href="#labor-@task.Id"><i class="fas fa-users me-1"></i>Ýþçilik & Puantaj</a></li>
                                        </ul>
                                        <div class="tab-content p-3 bg-white rounded border">
                                            <div class="tab-pane fade show active" id="prep-@task.Id">
                                                <small class="text-muted"><i class="fas fa-info-circle me-1"></i> Bu iþ baþlamadan önce þantiyede yapýlmasý gereken hazýrlýklar (Kalýp yaðý, paspayý vb.) burada listelenecek.</small>
                                            </div>
                                            <div class="tab-pane fade" id="isg-@task.Id">
                                                <small class="text-muted"><i class="fas fa-exclamation-triangle text-warning me-1"></i> Yüksekte çalýþma, korkuluk, baret gibi bu iþe özel güvenlik uyarýlarý ve checklist.</small>
                                            </div>
                                            <div class="tab-pane fade" id="reserve-@task.Id">
                                                <small class="text-muted"><i class="fas fa-star text-info me-1"></i> Kalite Kontrol Onaylarý ve Þefin bu imalatla ilgili tutacaðý loglar.</small>
                                            </div>
                                            <div class="tab-pane fade" id="material-@task.Id">
                                                <small class="text-muted"><i class="fas fa-cubes text-primary me-1"></i> DXF 5. Motor Baðlantýsý: Bu iþ için þantiyeye inmesi gereken demir/beton metrajý durumu.</small>
                                            </div>
                                            <div class="tab-pane fade" id="labor-@task.Id">
                                                <small class="text-muted"><i class="fas fa-users text-success me-1"></i> Puantaj Baðlantýsý: Bu görevde bugün hangi yevmiyeli usta çalýþtý, kaç adam/saat harcandý?</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <i class="fas fa-project-diagram fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Henüz iþ programý oluþturulmamýþ</h5>
                            <button class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#generateTasksModal">Ýþ Zinciri Üret</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('sortableTasks');
            if(el) {
                var sortable = Sortable.create(el, {
                    animation: 150,
                    handle: '.fa-grip-vertical',
                    onEnd: function (evt) {
                        var orderedIds = [];
                        el.querySelectorAll('.list-group-item').forEach(function(item) {
                            orderedIds.push(item.getAttribute('data-task-id'));
                        });
                        
                        fetch('/PhaseTwo/UpdateTaskOrder', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(orderedIds)
                        });
                    }
                });
            }

            document.querySelectorAll('.auto-save-input').forEach(function(input) {
                input.addEventListener('change', function() {
                    var container = this.closest('.list-group-item');
                    var taskId = container.getAttribute('data-task-id');
                    var dateVal = container.querySelector('.task-date').value;
                    var durVal = container.querySelector('.task-duration').value;
                    
                    fetch('/PhaseTwo/AutoSaveTask', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ TaskId: parseInt(taskId), StartDate: dateVal ? dateVal : null, Duration: durVal ? parseInt(durVal) : 0 })
                    }).then(res => {
                        if(res.ok) {
                            var badge = container.querySelector('.save-badge');
                            badge.textContent = 'Kaydedildi';
                            badge.classList.remove('d-none');
                            setTimeout(() => badge.classList.add('d-none'), 2000);
                        }
                    });
                });
            });
        });
        
        function addNewTask(btn) {
            var container = btn.closest('.list-group-item');
            var projectId = @projectId;
            var taskName = prompt("Yeni isin adini girin:");
            if(!taskName) return;
            
            var floor = prompt("Hangi kot/kat (orn: Zemin Kat):", "Saha Genel");
            var orderIndex = Array.from(document.getElementById('sortableTasks').children).indexOf(container) + 1;
            
            fetch('/PhaseTwo/AddNewTask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ProjectId: projectId, TaskName: taskName, FloorOrZone: floor, OrderIndex: orderIndex })
            }).then(res => res.json()).then(data => {
                location.reload();
            });
        }
    </script>
}

