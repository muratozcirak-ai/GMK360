@{
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    
    // Bağlama göre dinamik Layout ve Başlık
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    string pageTitle = "Evrak ve Belge Arşivi";
    string icon = "bi-folder-fill";
    string description = "Tüm sözleşme ve evraklarınızı buradan yönetebilirsiniz.";

    if (ctx == "construction")
    {
        layoutName = "~/Views/Shared/_ConstructionLayout.cshtml";
        pageTitle = "Şantiye Arşivi & Tutanaklar";
        icon = "bi-cone-striped";
        description = "Şantiye toplantı tutanakları, iskan belgeleri ve taşeron sözleşmeleri.";
    }
    else if (ctx == "realestate")
    {
        layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
        pageTitle = "Yetki ve Kira Sözleşmeleri";
        icon = "bi-file-earmark-text";
        description = "Mülk yetki belgeleri, imzalı sözleşmeler ve tapu fotokopileri.";
    }
    else if (ctx == "facility")
    {
        layoutName = "~/Views/Shared/_FacilityLayout.cshtml";
        pageTitle = "Karar Defteri ve Resmi Belgeler";
        icon = "bi-journal-bookmark";
        description = "Yönetim kurulu kararları, SGK belgeleri ve periyodik asansör bakım tutanakları.";
    }
    else if (ctx == "owner")
    {
        layoutName = "~/Views/Shared/_PropertyOwnerLayout.cshtml";
        pageTitle = "Kira Sözleşmelerim (Arşiv)";
        icon = "bi-house-add";
        description = "Kiracılarınızla yaptığınız sözleşmeler ve tahliye taahhütnameleri.";
    }

    Layout = layoutName;
    ViewData["Title"] = pageTitle;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi @icon"></i> @pageTitle</h5>
        <button class="btn btn-sm btn-primary"><i class="bi bi-cloud-arrow-up"></i> Yeni Belge Yükle</button>
    </div>
    <div class="card-body">
        
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> <strong>Bu Bölüme Özel:</strong> @description
        </div>

        <div class="row g-4 mt-2">
            <!-- Mock Folders -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center py-4 bg-light hover-shadow">
                    <i class="bi bi-folder-fill text-warning" style="font-size: 4rem;"></i>
                    <h6 class="mt-3 fw-bold">2026 Arşivi</h6>
                    <small class="text-muted">12 Belge</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center py-4 bg-light hover-shadow">
                    <i class="bi bi-folder-fill text-warning" style="font-size: 4rem;"></i>
                    <h6 class="mt-3 fw-bold">2025 Arşivi</h6>
                    <small class="text-muted">45 Belge</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center py-4 bg-light hover-shadow">
                    <i class="bi bi-folder-fill text-info" style="font-size: 4rem;"></i>
                    <h6 class="mt-3 fw-bold">Sözleşmeler (Aktif)</h6>
                    <small class="text-muted">8 Belge</small>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .hover-shadow { transition: transform 0.2s ease; cursor: pointer; }
    .hover-shadow:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>
