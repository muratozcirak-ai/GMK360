@{
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    
    // Bağlama göre dinamik Layout ve Başlık
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    string pageTitle = "Ajandam (Randevular)";
    string icon = "bi-calendar-check";
    string description = "Genel randevularınızı buradan takip edebilirsiniz.";

    if (ctx == "construction")
    {
        layoutName = "~/Views/Shared/_ConstructionLayout.cshtml";
        pageTitle = "Şantiye Toplantı Ajandası";
        icon = "bi-cone-striped";
        description = "Taşeron görüşmeleri, malzeme teslimatları ve şantiye toplantıları.";
    }
    else if (ctx == "realestate")
    {
        layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
        pageTitle = "Yer Gösterme ve Müşteri Takvimi";
        icon = "bi-house-heart";
        description = "Portföy sunumları, tapu randevuları ve müşteri görüşmeleri.";
    }
    else if (ctx == "facility")
    {
        layoutName = "~/Views/Shared/_FacilityLayout.cshtml";
        pageTitle = "Bina Yönetim Takvimi";
        icon = "bi-building-gear";
        description = "Genel kurul toplantıları, aidat son ödeme günleri ve bakım periyotları.";
    }
    else if (ctx == "service")
    {
        layoutName = "~/Views/Shared/_ServiceProviderLayout.cshtml";
        pageTitle = "Usta / Hizmet Keşif Takvimi";
        icon = "bi-tools";
        description = "Müşterilere verilecek fiyat teklifleri ve tamirat/keşif randevuları.";
    }
    else if (ctx == "supplier")
    {
        layoutName = "~/Views/Shared/_SupplierLayout.cshtml";
        pageTitle = "Tedarik & Sevkiyat Ajandası";
        icon = "bi-truck";
        description = "Şantiyelere yapılacak malzeme sevkiyatları ve ödeme takvimi.";
    }

    Layout = layoutName;
    ViewData["Title"] = pageTitle;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi @icon"></i> @pageTitle</h5>
        <button class="btn btn-sm btn-primary"><i class="bi bi-plus"></i> Yeni Kayıt Ekle</button>
    </div>
    <div class="card-body">
        
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> <strong>Bu Bölüme Özel:</strong> @description
        </div>

        <!-- FullCalendar (Mockup) -->
        <div id="calendar" style="min-height: 500px; background-color: #f8f9fa; border: 1px dashed #ccc; display: flex; align-items: center; justify-content: center;">
            <div class="text-center text-muted">
                <i class="bi bi-calendar3 display-4"></i>
                <p class="mt-2 fw-bold mb-0">Takvim Yükleniyor...</p>
                <small>(Sadece '@pageTitle' kapsamındaki randevular listelenir)</small>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        console.log("Ajanda yüklendi. Aktif Bağlam (Context): @ctx");
    </script>
}
