@{
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    
    // Bağlama göre dinamik Layout ve Başlık
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    string pageTitle = "Müşteri Talep Takibi";
    string icon = "bi-chat-left-text";
    
    string card1Title = "Aktif Talepler";
    string card2Title = "Eşleşen İlanlar";
    string card3Title = "Bekleyen Takipler";
    
    string thDetail = "Talep Detayı";
    string thBudget = "Bütçe Aralığı";
    
    string sampleName = "Ahmet Yılmaz";
    string sampleDetail = "Kadıköy, Moda civarı 3+1 deniz manzaralı";
    string sampleBudget = "4.000.000 ₺ - 5.500.000 ₺";
    string sampleAction = "Eşleşenler";
    string sampleActionIcon = "bi-house-door";

    if (ctx == "construction")
    {
        layoutName = "~/Views/Shared/_ConstructionLayout.cshtml";
        pageTitle = "Şantiye & Taşeron Talepleri";
        icon = "bi-cone-striped";
        card1Title = "Açık Talepler";
        card2Title = "Alınan Teklifler";
        card3Title = "Onay Bekleyenler";
        thDetail = "İş/Malzeme Talebi";
        thBudget = "Yaklaşık Maliyet";
        sampleName = "Ahmet Usta (Seramik)";
        sampleDetail = "C Blok banyo fayansları için ekstra yapıştırıcı lazım.";
        sampleBudget = "5.000 ₺";
        sampleAction = "Siparişe Çevir";
        sampleActionIcon = "bi-cart-check";
    }
    else if (ctx == "realestate")
    {
        layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
        pageTitle = "Alıcı / Müşteri Talepleri";
        icon = "bi-house-heart";
    }
    else if (ctx == "facility")
    {
        layoutName = "~/Views/Shared/_FacilityLayout.cshtml";
        pageTitle = "Sakin Şikayet ve Talepleri";
        icon = "bi-building-gear";
        card1Title = "Açık Şikayetler";
        card2Title = "Çözülenler";
        card3Title = "Yönetim Onayında";
        thDetail = "Şikayet / Talep Konusu";
        thBudget = "Daire";
        sampleName = "Ayşe Demir";
        sampleDetail = "B Blok 4. kat koridor lambası yanmıyor.";
        sampleBudget = "B Blok D:12";
        sampleAction = "Teknik Ekibe İlet";
        sampleActionIcon = "bi-tools";
    }
    else if (ctx == "service")
    {
        layoutName = "~/Views/Shared/_ServiceProviderLayout.cshtml";
        pageTitle = "Gelen İş Talepleri (Keşif)";
        icon = "bi-tools";
        card1Title = "Yeni Talepler";
        card2Title = "Verilen Teklifler";
        card3Title = "Kabul Edilenler";
        thDetail = "Arıza / İstek Tanımı";
        thBudget = "Müşteri Bütçesi";
        sampleName = "Mehmet Bey";
        sampleDetail = "Mutfak su sızdırıyor, alt kata damlıyor acil.";
        sampleBudget = "Acil (Belirsiz)";
        sampleAction = "Keşif Randevusu Ver";
        sampleActionIcon = "bi-calendar-check";
    }
    else if (ctx == "supplier")
    {
        layoutName = "~/Views/Shared/_SupplierLayout.cshtml";
        pageTitle = "Toptan Malzeme Talepleri";
        icon = "bi-truck";
        card1Title = "Yeni Siparişler";
        card2Title = "Hazırlananlar";
        card3Title = "Sevkiyat Bekleyen";
        thDetail = "İstenen Malzemeler";
        thBudget = "Tahmini Tutar";
        sampleName = "Vadi Konakları Şantiyesi";
        sampleDetail = "10 Palet Çimento, 500 Adet Tuğla";
        sampleBudget = "35.000 ₺";
        sampleAction = "Fatura Kes";
        sampleActionIcon = "bi-receipt";
    }

    Layout = layoutName;
    ViewData["Title"] = pageTitle;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi @icon"></i> @pageTitle</h5>
        <button class="btn btn-sm btn-light text-secondary"><i class="bi bi-plus-circle"></i> Yeni Kayıt</button>
    </div>
    <div class="card-body">
        
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body text-center">
                        <h3 class="text-primary">12</h3>
                        <span class="text-muted">@card1Title</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body text-center">
                        <h3 class="text-success">5</h3>
                        <span class="text-muted">@card2Title</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body text-center">
                        <h3 class="text-warning">3</h3>
                        <span class="text-muted">@card3Title</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Müşteri / Kaynak</th>
                        <th>@thDetail</th>
                        <th>@thBudget</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@sampleName</td>
                        <td>@sampleDetail</td>
                        <td>@sampleBudget</td>
                        <td><span class="badge bg-warning text-dark">Beklemede</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" title="İşlem Yap"><i class="bi @sampleActionIcon"></i> @sampleAction</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>
