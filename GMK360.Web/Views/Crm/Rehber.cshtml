@{
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    
    // Bağlama göre dinamik Layout ve Başlık
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    string pageTitle = "Müşteri Rehberim";
    string icon = "bi-person-lines-fill";
    string description = "Kişi listeniz.";
    
    // Örnek veriler de bağlama göre değişmeli
    string tableTypeHeader = "Tip";
    string sampleName1 = "Ahmet Yılmaz";
    string sampleType1 = "Alıcı";
    string sampleNote1 = "Kadıköy'de 3+1 arıyor. (Bütçe: 5M ₺)";
    string sampleName2 = "Ayşe Demir";
    string sampleType2 = "Ev Sahibi";
    string sampleNote2 = "Ataşehir'deki dairesini kiraya vermek istiyor.";

    if (ctx == "construction")
    {
        layoutName = "~/Views/Shared/_ConstructionLayout.cshtml";
        pageTitle = "Şantiye Müşteri & Taşeron Rehberi";
        icon = "bi-cone-striped";
        description = "Şantiyeye ait müşteriler (Daire alanlar) ve taşeron firmalar.";
        tableTypeHeader = "Firma/Görev";
        sampleType1 = "Taşeron (Seramik)";
        sampleNote1 = "B Blok fayans işleri için anlaşıldı.";
        sampleType2 = "Müşteri (Daire Alan)";
        sampleNote2 = "C Blok 12 No'lu daireyi peşin aldı. Mutfak dolabı rengi seçecek.";
    }
    else if (ctx == "realestate")
    {
        layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
        pageTitle = "Emlak Müşteri Rehberi";
        icon = "bi-house-heart";
        description = "Ev arayan alıcılar ve portföy/mülk sahipleri.";
    }
    else if (ctx == "facility")
    {
        layoutName = "~/Views/Shared/_FacilityLayout.cshtml";
        pageTitle = "Bina Sakinleri Rehberi";
        icon = "bi-building-gear";
        description = "Site veya binada oturan kat malikleri ve kiracılar.";
        tableTypeHeader = "Daire No / Konum";
        sampleType1 = "A Blok D:15 (Kiracı)";
        sampleNote1 = "Aidat ödemesinde düzenli.";
        sampleType2 = "B Blok D:3 (Ev Sahibi)";
        sampleNote2 = "Yönetim kurulu üyesi.";
    }
    else if (ctx == "service")
    {
        layoutName = "~/Views/Shared/_ServiceProviderLayout.cshtml";
        pageTitle = "Hizmet Müşterileri";
        icon = "bi-tools";
        description = "Daha önce tamirat/keşif yaptığınız müşteriler.";
        tableTypeHeader = "Hizmet Tipi";
        sampleType1 = "Boya Badana";
        sampleNote1 = "Geçen ay salon boyandı. Memnun kaldı.";
        sampleType2 = "Su Tesisatı";
        sampleNote2 = "Kaçak tespiti yapıldı. İleride petek temizliği isteyebilir.";
    }
    else if (ctx == "supplier")
    {
        layoutName = "~/Views/Shared/_SupplierLayout.cshtml";
        pageTitle = "Şantiye ve Usta Rehberi";
        icon = "bi-truck";
        description = "Malzeme sattığınız şantiyeler ve sürekli müşteriniz olan ustalar.";
        tableTypeHeader = "Müşteri Tipi";
        sampleType1 = "Şantiye Şefi";
        sampleNote1 = "Denge İnşaat A.Ş. - Sürekli çimento alıyor.";
        sampleType2 = "Seramik Ustası";
        sampleNote2 = "Veresiye çalışıyor, ay sonu kapatıyor.";
    }

    Layout = layoutName;
    ViewData["Title"] = pageTitle;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi @icon"></i> @pageTitle</h5>
        <button class="btn btn-sm btn-light text-dark"><i class="bi bi-person-plus-fill"></i> Yeni Ekle</button>
    </div>
    <div class="card-body">
        
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> <strong>Bu Bölüme Özel:</strong> @description
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad / Firma</th>
                        <th>Telefon</th>
                        <th>@tableTypeHeader</th>
                        <th>Talepler / Notlar</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@sampleName1</td>
                        <td>0555 123 4567</td>
                        <td><span class="badge bg-secondary">@sampleType1</span></td>
                        <td>@sampleNote1</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" title="Randevu Ekle"><i class="bi bi-calendar-plus"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>@sampleName2</td>
                        <td>0532 987 6543</td>
                        <td><span class="badge bg-secondary">@sampleType2</span></td>
                        <td>@sampleNote2</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" title="Randevu Ekle"><i class="bi bi-calendar-plus"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>
