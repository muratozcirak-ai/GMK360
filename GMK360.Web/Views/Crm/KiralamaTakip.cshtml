@{
    ViewData["Title"] = "Kiralama ve Ödeme Takip";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-building"></i> Kiralama ve Ödeme Takip Sistemi</h5>
        <button class="btn btn-sm btn-light text-success"><i class="bi bi-plus-circle"></i> Yeni Sözleşme</button>
    </div>
    <div class="card-body">
        
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-success text-white border-0 h-100">
                    <div class="card-body text-center">
                        <h3 class="mb-0">18</h3>
                        <small>Aktif Kira Sözleşmesi</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white border-0 h-100">
                    <div class="card-body text-center">
                        <h3 class="mb-0">2</h3>
                        <small>Geciken Ödeme</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark border-0 h-100">
                    <div class="card-body text-center">
                        <h3 class="mb-0">4</h3>
                        <small>Yakında Bitiyor (< 30 Gün)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white border-0 h-100">
                    <div class="card-body text-center">
                        <h3 class="mb-0">45.000 ₺</h3>
                        <small>Bu Ayki Tahsilat Beklentisi</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mülk Adresi / İlan</th>
                        <th>Kiracı (Tenant)</th>
                        <th>Ev Sahibi (Landlord)</th>
                        <th>Aylık Kira</th>
                        <th>Ödeme Günü</th>
                        <th>Bitiş Tarihi</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Ataşehir Varyap Meridian 2+1</td>
                        <td>Ali Veli (Kiracı)</td>
                        <td>Ayşe Demir (Ev Sahibi)</td>
                        <td>25.000 ₺</td>
                        <td>Her Ayın 5'i</td>
                        <td>01.09.2027</td>
                        <td><span class="badge bg-success">Ödendi</span></td>
                    </tr>
                    <tr>
                        <td>Kadıköy Moda 3+1</td>
                        <td>Mehmet Yılmaz</td>
                        <td>Hasan Kaya</td>
                        <td>35.000 ₺</td>
                        <td>Her Ayın 15'i</td>
                        <td>15.10.2026</td>
                        <td><span class="badge bg-danger">Gecikti</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>
