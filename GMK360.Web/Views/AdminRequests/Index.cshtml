@{
    ViewData["Title"] = "Gelen Talepler (Helpdesk)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Gelen Talepler (Helpdesk)</h2>
            <p class="text-muted">Kullanıcılardan gelen destek talepleri, vergi asistanı soruları ve yasal evrak uyuşmazlıkları.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Bekleyen Talepler</h6>
                    <h3 class="fw-bold mb-0">12</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Acil (Yasal/Vergi)</h6>
                    <h3 class="fw-bold mb-0">3</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Ticket Listesi</h5>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width: auto;">
                    <option>Tüm Kategoriler</option>
                    <option>Teknik Hata (Bug)</option>
                    <option>Vergi / Mevzuat Sorunu</option>
                    <option>Ödeme İtirazı</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Talep No</th>
                        <th>Kullanıcı / Firma</th>
                        <th>Kategori</th>
                        <th>Konu</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th class="text-end pe-4">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 text-muted">#TK-1042</td>
                        <td>
                            <div class="fw-bold">Dengehan İnşaat</div>
                            <small class="text-muted">Şantiye Modülü</small>
                        </td>
                        <td><span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Vergi Mevzuatı</span></td>
                        <td>SGK Stopaj Kesintisi Hk.</td>
                        <td><span class="badge bg-warning text-dark">Bekliyor</span></td>
                        <td>Bugün, 10:45</td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-primary">Yanıtla</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 text-muted">#TK-1041</td>
                        <td>
                            <div class="fw-bold">Ahmet Yılmaz</div>
                            <small class="text-muted">Bireysel Üye</small>
                        </td>
                        <td><span class="badge bg-info bg-opacity-10 text-info border border-info">Teknik Hata</span></td>
                        <td>IBAN kaydederken hata alıyorum</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success border border-success">Çözüldü</span></td>
                        <td>Dün, 15:30</td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-secondary">Görüntüle</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>