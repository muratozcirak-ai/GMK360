@model IEnumerable<GMK360.Core.Entities.Finance.SupplierCurrentAccount>

@{
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    ViewData["Title"] = "Tedarikçi Cari Hesapları";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-0"><i class="bi bi-wallet2 text-danger me-2"></i>Firma İçi Tedarikçi & Taşeron Carileri (SRM)</h4>
            <p class="text-muted small mb-0">Firmanızın tedarikçi ve taşeron açık hesap bakiyeleri, faturalar ve vadesi yaklaşan ödemeler</p>
        </div>
    </div>
    <ul class="nav nav-tabs mb-3 border-bottom">
        <li class="nav-item">
            <a href="/B2BPurchasing/Index" class="nav-link fw-semibold text-secondary">
                <i class="bi bi-cart4 text-primary me-1"></i>🛒 Satın Alma, Teklif & Siparişler
            </a>
        </li>
        <li class="nav-item">
            <a href="/SubcontractorContract/Index" class="nav-link fw-semibold text-secondary">
                <i class="bi bi-file-earmark-ruled text-success me-1"></i>🤝 Taşeron Sözleşmeleri & Hakedişler
            </a>
        </li>
        <li class="nav-item">
            <a href="/AgencyPhonebook/Index" class="nav-link fw-semibold text-secondary">
                <i class="bi bi-journal-bookmark-fill text-info me-1"></i>📒 Firma, Taşeron & Tedarikçi Rehberi
            </a>
        </li>
        <li class="nav-item">
            <a href="/SupplierCurrentAccount/Index" class="nav-link active fw-bold text-dark">
                <i class="bi bi-wallet2 text-danger me-1"></i>📊 Tedarikçi & Taşeron Carileri
            </a>
        </li>
    </ul>
    <div class="d-none justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Tedarikçi / Taşeron Cari Hesapları</h2>
            <p class="text-muted mb-0">Tüm açık hesap, ödeme ve fatura işlemlerini buradan takip edebilirsiniz.</p>
        </div>
    </div>

    @if (ViewBag.UpcomingPayments != null)
    {
        var upcoming = ViewBag.UpcomingPayments as IEnumerable<dynamic>;
        if (upcoming != null && upcoming.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #fff7ed, #ffedd5); border-left: 5px solid #ea580c !important;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-alarm text-danger fs-3 me-2"></i>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Vadesi Yaklaşan Ödemeler (Ödeme Takvimi)</h5>
                            <small class="text-muted">Ödeme vadesi yaklaşan tedarikçi ve taşeron borçlarınız aşağıda listelenmiştir.</small>
                        </div>
                    </div>
                    <div class="row g-2">
                        @foreach(var item in upcoming)
                        {
                            var days = (int)item.DaysLeft;
                            string badgeClass = days <= 3 ? "bg-danger" : (days <= 7 ? "bg-warning text-dark" : "bg-primary");
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 shadow-sm border d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">@item.SupplierName</div>
                                        <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>Vade: @item.Payment.DueDate?.ToString("dd.MM.yyyy")</small>
                                        <div class="mt-1">
                                            <span class="badge @badgeClass rounded-pill">
                                                @(days < 0 ? $"{Math.Abs(days)} Gün Gecikti!" : (days == 0 ? "Bugün Son Gün!" : $"{days} Gün Kaldı"))
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-danger fs-6">@item.Payment.Amount.ToString("N2") ₺</div>
                                        <a href="/SupplierCurrentAccount/Details/@item.Payment.SupplierCurrentAccountId" class="btn btn-sm btn-outline-dark rounded-pill px-2 py-0 mt-1">Öde</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @{
        var allContracts = ViewBag.SupplierContracts as List<GMK360.Web.Services.SupplierContractPackageDto> ?? new List<GMK360.Web.Services.SupplierContractPackageDto>();
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Firma/Kişi Adı</th>
                            <th class="py-3">Telefon</th>
                            <th class="py-3">Anlaşma Taahhüdü (Beklenen Çıkış)</th>
                            <th class="py-3">Kesinleşen Cari Bakiye (Borcumuz)</th>
                            <th class="text-end pe-4 py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var accContracts = allContracts.Where(c => c.SupplierCurrentAccountId == item.Id || c.PhonebookContactId == item.PhonebookContactId).ToList();
                            decimal totalAgreed = accContracts.Sum(c => c.TotalAgreedAmount);
                            decimal remainingCommitment = accContracts.Sum(c => c.RemainingUnorderedAmount);
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                            <i class="bi bi-building fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@(item.PhonebookContact?.Name ?? "Bilinmeyen Tedarikçi")</h6>
                                            <small class="text-muted">@(item.PhonebookContact?.Tags ?? "Tedarikçi/Taşeron")</small>
                                            @if (accContracts.Any())
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-info bg-opacity-10 text-primary border border-info">
                                                        <i class="bi bi-file-earmark-check me-1"></i>@accContracts.Count Aktif Paket Anlaşması (@accContracts.Sum(c => c.Items.Count) Kalem Birim Fiyatlı)
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@(item.PhonebookContact?.PhoneNumber ?? "-")</td>
                                <td>
                                    @if (totalAgreed > 0)
                                    {
                                        <div class="fw-bold text-dark">@totalAgreed.ToString("N2") ₺ <span class="badge bg-warning text-dark ms-1">Toplu Anlaşma</span></div>
                                        <small class="text-muted">Beklenen (Sipariş Edilmemiş): <strong class="text-warning" style="color:#d97706 !important;">@remainingCommitment.ToString("N2") ₺</strong></small>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if(item.CurrentBalance > 0)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger fs-6 px-3 py-2">
                                            @item.CurrentBalance.ToString("N2") ₺ Borcumuz Var
                                        </span>
                                    }
                                    else if(item.CurrentBalance < 0)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fs-6 px-3 py-2">
                                            @Math.Abs(item.CurrentBalance).ToString("N2") ₺ Avans/Alacak
                                        </span>
                                    }
                                    else if (totalAgreed > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-15 text-dark border border-warning px-3 py-2">
                                            0,00 ₺ (Sipariş Bekliyor)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary fs-6 px-3 py-2">
                                            0.00 ₺ (Kapalı)
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-xs">
                                        <i class="bi bi-cart-check me-1"></i> @(accContracts.Any() ? "Anlaşma, Sipariş & Cari" : "Ekstre Gör")
                                    </a>
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
                                    Kayıtlı cari hesap bulunamadı. Lütfen önce Rehberden bir firmayı Tedarikçi olarak ekleyin.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
