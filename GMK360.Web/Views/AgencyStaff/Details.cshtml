@model GMK360.Core.Entities.AgencyConsultant
@using GMK360.Web.Helpers
@{
    ViewData["Title"] = "Personel Özlük, Yetki & Basit PDKS - " + Model.User?.FirstName + " " + Model.User?.LastName;
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";

    var payrolls = ViewBag.Payrolls as IEnumerable<GMK360.Core.Entities.Finance.AgencyStaffPayroll>;
    var advances = ViewBag.Advances as IEnumerable<GMK360.Core.Entities.Finance.AgencyStaffAdvance>;
    var staffDocs = ViewBag.StaffDocuments as IEnumerable<GMK360.Core.Entities.DocumentArchive> ?? Enumerable.Empty<GMK360.Core.Entities.DocumentArchive>();
    var hrDossier = ViewBag.HrDossier as StaffHrDossier ?? new StaffHrDossier();
    var effectivePerms = StaffPermissionHelper.GetEffectivePermissions(Model.Role, Model.User?.ActiveModules);

    decimal baseSalary = Model.MonthlySalary;
    decimal dailyWage = baseSalary > 0 ? Math.Round(baseSalary / 30m, 2) : 0m;
    decimal approvedUnpaidAdvances = advances != null
        ? advances.Where(a => a.Status == GMK360.Core.Entities.Finance.AdvanceStatus.Approved && a.DeductedFromPayrollId == null).Sum(a => a.Amount)
        : 0m;

    var requiredDocTypes = new[]
    {
        "Kimlik Fotokopisi",
        "İkametgah Belgesi",
        "Adli Sicil Kaydı",
        "Sağlık Raporu",
        "İSG Eğitim Sertifikası",
        "İş Sözleşmesi",
        "Diploma / Mesleki Belge"
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <a href="/AgencyStaff/Index" class="text-decoration-none small fw-bold mb-1 d-inline-block"><i class="bi bi-arrow-left me-1"></i> Personel Listesine Dön</a>
        <h4 class="fw-bold mb-0">
            @Model.User?.FirstName @Model.User?.LastName
            <span class="badge bg-dark ms-2 rounded-pill" style="font-size: 0.75rem;">
                @(!string.IsNullOrWhiteSpace(hrDossier.TitleOrPosition) ? hrDossier.TitleOrPosition : StaffPermissionHelper.GetFriendlyRoleBadge(Model.Role))
            </span>
        </h4>
        <p class="text-muted small mb-0">
            <i class="bi bi-envelope me-1"></i>@Model.User?.Email
            @if (!string.IsNullOrWhiteSpace(Model.User?.PhoneNumber))
            {
                <span class="ms-2"><i class="bi bi-telephone me-1"></i>@Model.User.PhoneNumber</span>
            }
            @if (!string.IsNullOrWhiteSpace(hrDossier.Address) || !string.IsNullOrWhiteSpace(hrDossier.City))
            {
                <span class="ms-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(hrDossier.Address) ? $"{hrDossier.District} / {hrDossier.City}" : hrDossier.Address)</span>
            }
            | Durum: <strong>@(Model.IsActive ? "Aktif" : "Ayrıldı")</strong>
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <div class="bg-white border rounded-3 px-3 py-1.5 shadow-xs text-end">
            <div class="text-muted" style="font-size: 0.68rem;">AYLIK NET MAAŞ / GÜNLÜK YEVMİYE</div>
            <div class="fw-bold text-success small">₺@baseSalary.ToString("N2") <span class="text-dark fw-normal">(Günlük: ₺@dailyWage.ToString("N2"))</span></div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-xs py-2 px-3 small rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white border-bottom pt-3 pb-0">
        <ul class="nav nav-tabs card-header-tabs" id="staffTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active fw-bold text-primary" id="permissions-tab" data-bs-toggle="tab" href="#permissions" role="tab" aria-controls="permissions" aria-selected="true">
                    <i class="bi bi-sliders me-1"></i> 1. Sol Menü & Ekran Yetkileri ("Hakimiyet Bende")
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="finance-tab" data-bs-toggle="tab" href="#finance" role="tab" aria-controls="finance" aria-selected="false">
                    <i class="bi bi-calendar2-Week-fill me-1 text-success"></i> 2. Basit PDKS, Çalışma Ajandası & Bayram Çift Yevmiye
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="hrdocs-tab" data-bs-toggle="tab" href="#hrdocs" role="tab" aria-controls="hrdocs" aria-selected="false">
                    <i class="bi bi-folder-check me-1 text-warning"></i> 3. Özlük Evrakları Dosyası (@staffDocs.Count())
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold text-dark" id="profile-tab" data-bs-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">
                    <i class="bi bi-house-heart-fill me-1 text-danger"></i> 4. Kimlik, İkametgah Adresi & Acil Durum
                </a>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="staffTabsContent">

            <!-- 1. SEKME: SOL MENÜ LİNKLERİ & EKRAN YETKİLERİ -->
            <div class="tab-pane fade show active" id="permissions" role="tabpanel" aria-labelledby="permissions-tab">
                <form asp-action="UpdateRoleAndPermissions" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="row g-3 align-items-end mb-3 pb-3 border-bottom">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Şirket İçi Görev Şablonu</label>
                            <select name="role" id="detailRoleSelect" class="form-select fw-bold border-primary" onchange="applyDetailRolePreset(this.value)">
                                <optgroup label="1. YÖNETİM KADROSU (TAM YETKİ)">
                                    <option value="Owner" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Owner ? "selected" : null)">👑 Firma Sahibi / Yönetim Kurulu (Tüm Menüler Açık)</option>
                                    <option value="Manager" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Manager ? "selected" : null)">👔 Genel Müdür / Firma Yetkilisi (Tüm Menüler Açık)</option>
                                </optgroup>
                                <optgroup label="2. TEKNİK OFİS & MUHASEBE KADROSU">
                                    <option value="Engineer" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Engineer ? "selected" : null)">📐 Teknik Ofis & Saha Mühendisi</option>
                                    <option value="Architect" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Architect ? "selected" : null)">📐 Proje Mimarı & Çizim Sorumlusu</option>
                                    <option value="Purchasing" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Purchasing ? "selected" : null)">🛒 Satın Alma & İhale Sorumlusu</option>
                                    <option value="Accountant" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Accountant ? "selected" : null)">💼 Ön Muhasebe & Finans Sorumlusu</option>
                                </optgroup>
                                <optgroup label="3. ŞANTİYE SAHA & LOJİSTİK KADROSU">
                                    <option value="SiteManager" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.SiteManager ? "selected" : null)">👷 Şantiye Şefi / Saha Formeni</option>
                                    <option value="Driver" selected="@(Model.Role == GMK360.Core.Entities.AgencyRole.Driver ? "selected" : null)">🚛 Araç & Saha Lojistik Sorumlusu</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex gap-2 justify-content-md-end flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold" onclick="toggleDetailPerms(true)">
                                <i class="bi bi-check-all me-1"></i>Tüm Menüleri Aç (Tam Yetki)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" onclick="applyDetailRolePreset('Engineer')">
                                <i class="bi bi-compass me-1"></i>Teknik Ofis (Finans & Web Gizli)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" onclick="applyDetailRolePreset('SiteManager')">
                                <i class="bi bi-cone-striped me-1"></i>Sadece Saha & Demirbaş
                            </button>
                        </div>
                    </div>

                    <!-- Sabit Açık Olan 3 Temel Ekran -->
                    <div class="alert alert-light border rounded-3 py-2.5 px-3 mb-3">
                        <div class="fw-bold text-dark small mb-1.5">
                            <i class="bi bi-pin-angle-fill text-success me-1"></i>Sabit Açık Ekranlar (Her Personelde Standart Olarak Açık Kalır):
                        </div>
                        <div class="row g-2">
                            @foreach (var fix in StaffPermissionHelper.FixedMenuDefinitions)
                            {
                                <div class="col-md-4">
                                    <div class="d-flex align-items-start gap-2 bg-white border rounded-3 p-2 h-100">
                                        <i class="bi bi-check-circle-fill text-success mt-0.5"></i>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 0.76rem;"><i class="bi @fix.Icon me-1"></i>@fix.Title</div>
                                            <div class="text-muted" style="font-size: 0.70rem;">@fix.Description</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-2">
                        <h6 class="fw-bold text-dark mb-1">
                            <i class="bi bi-ui-checks-grid text-primary me-1"></i>Sol Menü Linklerini Tek Tek Seçin ("Hakimiyet Bende")
                        </h6>
                        <p class="text-muted small mb-3" style="font-size: 0.76rem;">
                            Bu personelin sol menüde hangi başlıkları görebileceğini aşağıdan tek tek işaretleyin. İşaretini kaldırdığınız menü başlığı (örneğin <b>Kurumsal Web & Domain</b> veya <b>Finans & Cari</b>) o personelin ekranından anında gizlenir.
                        </p>
                    </div>

                    <div class="row g-2.5 mb-4">
                        @foreach (var perm in StaffPermissionHelper.AllPermissionDefinitions)
                        {
                            bool isChecked = effectivePerms.Contains(perm.Code);
                            <div class="col-md-6">
                                <label class="card border shadow-xs rounded-3 p-3 h-100 cursor-pointer d-flex flex-row align-items-start gap-2.5 @(isChecked ? "border-primary bg-primary bg-opacity-10" : "bg-light")">
                                    <input type="checkbox" name="selectedPermissions" value="@perm.Code" class="form-check-input mt-1 detail-perm-cb" data-code="@perm.Code" @(isChecked ? "checked" : "") />
                                    <div>
                                        <div class="fw-bold text-dark small"><i class="bi @perm.Icon me-1"></i>@perm.Title</div>
                                        <div class="text-muted" style="font-size: 0.73rem;">@perm.Description</div>
                                    </div>
                                </label>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-save me-1"></i>Görev Unvanını ve Sol Menü Yetkilerini Kaydet
                        </button>
                    </div>
                </form>
            </div>

            <!-- 2. SEKME: BASİT PDKS, ÇALIŞMA AJANDASI, BAYRAM ÇİFT YEVMİYE VE MAAŞ BORDROSU -->
            <div class="tab-pane fade" id="finance" role="tabpanel" aria-labelledby="finance-tab">
                <form asp-action="SavePdksMonthlyPayroll" method="post" class="card border border-success border-opacity-25 bg-light rounded-4 p-3.5 mb-4 shadow-xs">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="calendarSummary" id="pdksCalendarSummaryInput" value="" />

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-calendar2-heart-fill text-success me-1"></i>Basit PDKS: Aylık Çalışma Ajandası, Resmi Tatil / Bayram Çift Yevmiye (2x) & Maaş Hesaplayıcı
                            </h6>
                            <small class="text-muted" style="font-size: 0.74rem;">
                                Aşağıdaki takvimden personelin çalıştığı bayram/resmi tatil günlerini (<b>Çift Yevmiye - 2x</b>), fazla mesailerini veya izinlerini işaretleyin; ay sonu net hakedişi otomatik hesaplansın.
                            </small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="small fw-bold text-dark mb-0">Dönem:</label>
                            <input type="month" name="period" id="pdksPeriodInput" class="form-control form-control-sm fw-bold border-success" style="width: 155px;" value="@DateTime.Now.ToString("yyyy-MM")" required />
                        </div>
                    </div>

                    <!-- Resmi Tatiller ve Bayramlarda Çift Yevmiye Hızlı Seçim Şeridi -->
                    <div class="bg-white border rounded-3 p-2.5 mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <span class="small fw-bold text-dark">
                                <i class="bi bi-stars text-warning me-1"></i>Yıllık Resmi Tatil & Bayram Rehberi (Çalışılan Bayram Günleri 2x Çift Yevmiye Sayılır):
                            </span>
                            <div class="d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill px-2.5 py-0.5 small fw-bold" onclick="addHolidayDoubleDays(1)">+1 Gün Resmi Tatil (2x)</button>
                                <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill px-2.5 py-0.5 small fw-bold" onclick="addHolidayDoubleDays(3)">+3 Gün Ramazan Bayramı (2x)</button>
                                <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill px-2.5 py-0.5 small fw-bold" onclick="addHolidayDoubleDays(4)">+4 Gün Kurban Bayramı (2x)</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-0.5 small" onclick="resetPdksCalendar()">Takvimi Sıfırla (30 Tam Gün)</button>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1.5" style="font-size: 0.71rem;">
                            <span class="badge bg-light text-dark border">📅 1 Ocak Yılbaşı (1 Gün)</span>
                            <span class="badge bg-warning bg-opacity-15 text-dark border border-warning-subtle">🌙 Ramazan Bayramı (3.5 Gün)</span>
                            <span class="badge bg-light text-dark border">🇹🇷 23 Nisan (1 Gün)</span>
                            <span class="badge bg-light text-dark border">🛠️ 1 Mayıs Emek ve Dayanışma (1 Gün)</span>
                            <span class="badge bg-light text-dark border">🇹🇷 19 Mayıs (1 Gün)</span>
                            <span class="badge bg-warning bg-opacity-15 text-dark border border-warning-subtle">🌙 Kurban Bayramı (4.5 Gün)</span>
                            <span class="badge bg-light text-dark border">🇹🇷 15 Temmuz (1 Gün)</span>
                            <span class="badge bg-light text-dark border">🇹🇷 30 Ağustos Zafer Bayramı (1 Gün)</span>
                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning">🇹🇷 29 Ekim Cumhuriyet Bayramı (1.5 Gün)</span>
                        </div>
                    </div>

                    <!-- 30 Günlük Tıklanabilir Basit PDKS Çalışma Ajandası -->
                    <div class="bg-white border rounded-3 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <span class="small fw-bold text-dark"><i class="bi bi-grid-3x3-gap-fill text-primary me-1"></i>30 Günlük Çalışma Ajandası (Günün Üzerine Tıklayarak Durumu Değiştirin):</span>
                            <div class="d-flex flex-wrap gap-2" style="font-size: 0.72rem;">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">✅ Normal Çalıştı (1x)</span>
                                <span class="badge bg-warning text-dark">🎉 Bayram / Resmi Tatil Çalıştı (Çift Yevmiye 2x)</span>
                                <span class="badge bg-primary text-white">⏱️ Pazar / Fazla Mesai (+0.5 Yevmiye)</span>
                                <span class="badge bg-info bg-opacity-15 text-dark border">🏖️ Ücretli İzin / Rapor</span>
                                <span class="badge bg-danger text-white">❌ Gelmedi / Ücretsiz İzin (-1 Yevmiye)</span>
                            </div>
                        </div>
                        <div class="row g-1.5" id="pdks30DayGrid">
                            @for (int d = 1; d <= 30; d++)
                            {
                                <div class="col-2 col-sm-2 col-md-1">
                                    <button type="button"
                                            class="btn btn-sm w-100 py-1.5 px-1 rounded-2 border fw-bold pdks-day-btn bg-success bg-opacity-10 text-success border-success-subtle"
                                            data-day="@d"
                                            data-state="normal"
                                            onclick="cyclePdksDay(this)"
                                            style="font-size: 0.72rem;">
                                        <div>@d. Gün</div>
                                        <div class="pdks-day-label" style="font-size: 0.63rem;">Normal</div>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Otomatik Maaş, Günlük Yevmiye ve Çift Yevmiye Hesap Özeti -->
                    <div class="row g-2.5 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">Aylık Kök Maaş (₺)</label>
                            <input type="number" step="0.01" name="baseSalary" id="pdksBaseSalary" class="form-control form-control-sm fw-bold" value="@baseSalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcPdksSummary()" required />
                            <small class="text-muted" id="pdksDailyWageText" style="font-size: 0.68rem;">1 Yevmiye: ₺@dailyWage.ToString("N2")</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1 text-success">Normal Gün (1x)</label>
                            <input type="number" name="normalDays" id="pdksNormalDays" class="form-control form-control-sm fw-bold" value="30" min="0" max="31" oninput="recalcPdksSummary()" />
                            <small class="text-muted" style="font-size: 0.68rem;">Maaşa dahil gün</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1 text-warning-emphasis">🎉 Bayram / Tatil (2x)</label>
                            <input type="number" name="holidayDoubleDays" id="pdksHolidayDays" class="form-control form-control-sm fw-bold border-warning bg-warning bg-opacity-10" value="0" min="0" max="15" oninput="recalcPdksSummary()" />
                            <small class="text-success fw-bold" id="pdksHolidayExtraText" style="font-size: 0.68rem;">Çift Yevmiye Farkı: +₺0,00</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1 text-primary">⏱️ Fazla Mesai / Prim (₺)</label>
                            <input type="number" step="0.01" name="overtimeDaysOrHoursPay" id="pdksOvertimePay" class="form-control form-control-sm fw-bold" value="0" oninput="recalcPdksSummary()" />
                            <small class="text-muted" style="font-size: 0.68rem;">Mesai / ek prim tutarı</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1 text-danger">❌ Gelmedi (Gün)</label>
                            <input type="number" name="unpaidLeaveDays" id="pdksUnpaidDays" class="form-control form-control-sm fw-bold" value="0" min="0" max="30" oninput="recalcPdksSummary()" />
                            <small class="text-danger" id="pdksUnpaidDeductionText" style="font-size: 0.68rem;">Kesinti: -₺0,00</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1 text-danger">Avans Kesintisi (₺)</label>
                            <input type="number" step="0.01" name="advanceDeduction" id="pdksAdvanceDeduction" class="form-control form-control-sm fw-bold" value="@approvedUnpaidAdvances.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" oninput="recalcPdksSummary()" />
                            <small class="text-muted" style="font-size: 0.68rem;">Onaylı avans toplamı</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="bg-white border border-success rounded-3 px-3 py-1.5">
                                <span class="text-muted small">Ay Sonu Net Ödenecek Hakediş:</span>
                                <span class="fs-5 fw-bold text-success ms-1" id="pdksNetPayableDisplay">₺@((baseSalary - approvedUnpaidAdvances).ToString("N2"))</span>
                            </div>
                            <small class="text-muted" style="font-size: 0.73rem;">
                                Formül: <b>Baz Maaş</b> + <b>Bayram Çift Yevmiye İlavesi (+1x)</b> + <b>Mesai/Prim</b> - <b>Devamsızlık & Avans</b>
                            </small>
                        </div>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i>PDKS & Bayram Çift Yevmiye Bordrosunu Kaydet
                        </button>
                    </div>
                </form>

                <div class="row">
                    <!-- AVANS GECMISI -->
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-cash-stack text-primary me-1"></i>Avans Geçmişi</h6>
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#advanceModal">
                                <i class="bi bi-plus-circle me-1"></i> Yeni Avans Talebi
                            </button>
                        </div>

                        @if (advances != null && advances.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover border align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tarih</th>
                                            <th>Tutar</th>
                                            <th>Durum</th>
                                            <th>İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var adv in advances)
                                        {
                                            <tr>
                                                <td>@adv.RequestDate.ToString("dd.MM.yyyy")</td>
                                                <td class="fw-bold">₺ @adv.Amount.ToString("N2")</td>
                                                <td>
                                                    @if (adv.Status == GMK360.Core.Entities.Finance.AdvanceStatus.Pending)
                                                    {
                                                        <span class="badge bg-warning text-dark">Bekliyor</span>
                                                    }
                                                    else if (adv.Status == GMK360.Core.Entities.Finance.AdvanceStatus.Approved)
                                                    {
                                                        <span class="badge bg-primary">Onaylandı</span>
                                                    }
                                                    else if (adv.Status == GMK360.Core.Entities.Finance.AdvanceStatus.Paid)
                                                    {
                                                        <span class="badge bg-success">Maaştan Kesildi</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Red</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (adv.Status == GMK360.Core.Entities.Finance.AdvanceStatus.Pending)
                                                    {
                                                        <form action="/AgencyStaffFinance/ApproveAdvance" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="advanceId" value="@adv.Id" />
                                                            <button type="submit" class="btn btn-xs btn-success py-0 px-2" style="font-size: 0.7rem;">Onayla</button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary small text-center py-2">Henüz avans kaydı bulunmuyor.</div>
                        }
                    </div>

                    <!-- MAAS BORDROLARI -->
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff text-success me-1"></i>Kayıtlı PDKS & Maaş Bordroları</h6>
                            <button class="btn btn-sm btn-outline-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#payrollModal">
                                <i class="bi bi-gear-fill me-1"></i> Toplu Maaş Tahakkuku
                            </button>
                        </div>

                        @if (payrolls != null && payrolls.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover border align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Dönem & PDKS Özeti</th>
                                            <th>Net Ödenecek</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pay in payrolls)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold"><i class="bi bi-calendar-event me-1 text-muted"></i> @pay.Period</div>
                                                    @if (!string.IsNullOrWhiteSpace(pay.Notes))
                                                    {
                                                        <div class="text-muted" style="font-size: 0.70rem;">@(pay.Notes.Split("||")[0])</div>
                                                    }
                                                </td>
                                                <td class="fw-bold text-success">
                                                    ₺ @pay.NetPayableAmount.ToString("N2")
                                                    @if (pay.BonusAmount > 0)
                                                    {
                                                        <br /><small class="text-primary fw-normal">(+ ₺@pay.BonusAmount.ToString("N2") Bayram 2x / Mesai)</small>
                                                    }
                                                    @if (pay.DeductionAmount > 0)
                                                    {
                                                        <br /><small class="text-danger fw-normal">(- ₺@pay.DeductionAmount.ToString("N2") Kesinti/Avans)</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (pay.IsPaid)
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-check"></i> Ödendi</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Ödeme Bekliyor</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary small text-center py-2">Henüz maaş/PDKS bordrosu oluşturulmamış.</div>
                        }
                    </div>
                </div>
            </div>

            <!-- 3. SEKME: PERSONEL ÖZLÜK EVRAKLARI DOSYASI -->
            <div class="tab-pane fade" id="hrdocs" role="tabpanel" aria-labelledby="hrdocs-tab">
                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="card border rounded-4 p-3.5 bg-light h-100">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="bi bi-cloud-arrow-up-fill text-primary me-1"></i>Personel Özlük Belgesi Yükle
                            </h6>
                            <p class="text-muted small mb-3" style="font-size: 0.74rem;">
                                Yüklediğiniz belgeler hem bu personelin özlük dosyasında saklanır hem de otomatik olarak <b>Merkez Evrak & Dosya Arşivi (Merkez Personel & İK)</b> klasörüne işlenir.
                            </p>
                            <form asp-action="UploadStaffDocument" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-2.5">
                                    <label class="form-label small fw-bold">Belge Türü <span class="text-danger">*</span></label>
                                    <select name="documentType" class="form-select form-select-sm rounded-3 fw-semibold" required>
                                        @foreach (var dt in requiredDocTypes)
                                        {
                                            <option value="@dt">@dt</option>
                                        }
                                        <option value="Diğer Özlük Belgesi">Diğer Özlük Belgesi</option>
                                    </select>
                                </div>
                                <div class="mb-2.5">
                                    <label class="form-label small fw-bold">Dosya Seçin (PDF, JPG, PNG, Word) <span class="text-danger">*</span></label>
                                    <input type="file" name="file" class="form-control form-control-sm rounded-3" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Açıklama / Geçerlilik Notu</label>
                                    <input type="text" name="notes" class="form-control form-control-sm rounded-3" placeholder="Örn: 2026 İSG Yüksekte Çalışma Belgesi" />
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold w-100 shadow-xs">
                                    <i class="bi bi-upload me-1"></i>Belgeyi Özlük Dosyasına Kaydet
                                </button>
                            </form>

                            <hr class="my-3" />
                            <div class="small fw-bold text-dark mb-2">📋 Özlük Dosyası Evrak Kontrol Listesi:</div>
                            <div class="d-flex flex-column gap-1.5">
                                @foreach (var reqDoc in requiredDocTypes)
                                {
                                    bool exists = staffDocs.Any(d => d.Title != null && d.Title.Contains(reqDoc, StringComparison.OrdinalIgnoreCase));
                                    <div class="d-flex justify-content-between align-items-center bg-white border rounded-2 px-2.5 py-1 small">
                                        <span>@reqDoc</span>
                                        @if (exists)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill">✅ Yüklendi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-15 text-dark rounded-pill">⏳ Eksik</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-files text-warning me-1"></i>Yüklü Özlük Evrakları (@staffDocs.Count())
                        </h6>
                        @if (staffDocs.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover border align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Belge Başlığı</th>
                                            <th>Tarih</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in staffDocs)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold small text-dark">@doc.Title</div>
                                                    <div class="text-muted" style="font-size: 0.70rem;">@doc.FileName</div>
                                                </td>
                                                <td class="small text-muted">@doc.UploadDate.ToString("dd.MM.yyyy")</td>
                                                <td class="text-end">
                                                    <a href="@doc.DocumentUrl" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-0.5 me-1" style="font-size: 0.72rem;">
                                                        <i class="bi bi-eye me-1"></i>Görüntüle
                                                    </a>
                                                    <form asp-action="DeleteStaffDocument" method="post" class="d-inline" onsubmit="return confirm('Bu belgeyi silmek istediğinize emin misiniz?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@Model.Id" />
                                                        <input type="hidden" name="docId" value="@doc.Id" />
                                                        <button type="submit" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border text-center py-4 text-muted small">
                                <i class="bi bi-folder2-open fs-3 d-block mb-2 text-secondary"></i>
                                Bu personel için henüz yüklenmiş özlük evrakı (Kimlik, İkametgah, İSG vb.) bulunmuyor. Sol taraftaki formdan hemen yükleyebilirsiniz.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 4. SEKME: KİMLİK, İKAMETGAH ADRESİ VE ACİL DURUM BİLGİLERİ -->
