<script>
    function applyDetailRolePreset(role) {
        var presets = {
            'Manager': ['cand', 'dna', 'site', 'fin', 'pur', 'doc', 'crm', 'staff', 'inv', 'web', 'strategy'],
            'Owner': ['cand', 'dna', 'site', 'fin', 'pur', 'doc', 'crm', 'staff', 'inv', 'web', 'strategy'],
            'Engineer': ['dna', 'site', 'pur', 'doc', 'inv'],
            'Architect': ['dna', 'site', 'pur', 'doc'],
            'Purchasing': ['dna', 'site', 'pur', 'doc', 'inv'],
            'Accountant': ['fin', 'pur', 'doc', 'staff'],
            'SiteManager': ['site', 'inv'],
            'Driver': ['site', 'inv']
        };
        var active = presets[role] || ['site', 'inv'];
        document.querySelectorAll('.detail-perm-cb').forEach(function(cb) {
            cb.checked = active.indexOf(cb.getAttribute('data-code')) !== -1;
        });
    }

    function toggleDetailPerms(state) {
        document.querySelectorAll('.detail-perm-cb').forEach(function(cb) {
            cb.checked = state;
        });
    }

    // Basit PDKS 30 Günlük Çalışma Ajandası ve Bayram Çift Yevmiye Hesaplayıcı
    var pdksStates = [
        { key: 'normal', label: 'Normal', cls: 'bg-success bg-opacity-10 text-success border-success-subtle' },
        { key: 'holiday2x', label: 'Bayram 2x', cls: 'bg-warning text-dark border-warning' },
        { key: 'overtime', label: 'Mesai +0.5', cls: 'bg-primary text-white border-primary' },
        { key: 'paidleave', label: 'İzin/Rapor', cls: 'bg-info bg-opacity-15 text-dark border-info' },
        { key: 'absent', label: 'Gelmedi', cls: 'bg-danger text-white border-danger' }
    ];

    function cyclePdksDay(btn) {
        var cur = btn.getAttribute('data-state') || 'normal';
        var idx = pdksStates.findIndex(function(s) { return s.key === cur; });
        var next = pdksStates[(idx + 1) % pdksStates.length];
        setPdksDayButtonState(btn, next);
        syncGridToInputs();
    }

    function setPdksDayButtonState(btn, stateObj) {
        btn.setAttribute('data-state', stateObj.key);
        btn.className = 'btn btn-sm w-100 py-1.5 px-1 rounded-2 border fw-bold pdks-day-btn ' + stateObj.cls;
        var lbl = btn.querySelector('.pdks-day-label');
        if (lbl) lbl.innerText = stateObj.label;
    }

    function addHolidayDoubleDays(count) {
        var buttons = Array.from(document.querySelectorAll('.pdks-day-btn'));
        var added = 0;
        for (var i = 0; i < buttons.length && added < count; i++) {
            if (buttons[i].getAttribute('data-state') === 'normal') {
                setPdksDayButtonState(buttons[i], pdksStates[1]); // holiday2x
                added++;
            }
        }
        syncGridToInputs();
    }

    function resetPdksCalendar() {
        document.querySelectorAll('.pdks-day-btn').forEach(function(btn) {
            setPdksDayButtonState(btn, pdksStates[0]);
        });
        document.getElementById('pdksOvertimePay').value = '0';
        syncGridToInputs();
    }

    function syncGridToInputs() {
        var normalCount = 0;
        var holidayCount = 0;
        var overtimeHalfDays = 0;
        var paidLeaveCount = 0;
        var absentCount = 0;

        document.querySelectorAll('.pdks-day-btn').forEach(function(btn) {
            var st = btn.getAttribute('data-state');
            if (st === 'normal') normalCount++;
            else if (st === 'holiday2x') holidayCount++;
            else if (st === 'overtime') { normalCount++; overtimeHalfDays++; }
            else if (st === 'paidleave') paidLeaveCount++;
            else if (st === 'absent') absentCount++;
        });

        var baseSalary = parseFloat(document.getElementById('pdksBaseSalary').value) || 0;
        var dailyWage = baseSalary / 30.0;

        document.getElementById('pdksNormalDays').value = normalCount + paidLeaveCount;
        document.getElementById('pdksHolidayDays').value = holidayCount;
        document.getElementById('pdksUnpaidDays').value = absentCount;
        if (overtimeHalfDays > 0) {
            document.getElementById('pdksOvertimePay').value = (overtimeHalfDays * 0.5 * dailyWage).toFixed(2);
        }

        document.getElementById('pdksCalendarSummaryInput').value =
            'Normal:' + normalCount + ', Bayram2x:' + holidayCount + ', Mesai:' + overtimeHalfDays + ', İzin:' + paidLeaveCount + ', Gelmedi:' + absentCount;

        recalcPdksSummary();
    }

    function recalcPdksSummary() {
        var baseSalary = parseFloat(document.getElementById('pdksBaseSalary').value) || 0;
        var dailyWage = baseSalary / 30.0;
        var holidayDays = parseInt(document.getElementById('pdksHolidayDays').value) || 0;
        var overtimePay = parseFloat(document.getElementById('pdksOvertimePay').value) || 0;
        var unpaidDays = parseInt(document.getElementById('pdksUnpaidDays').value) || 0;
        var advanceDed = parseFloat(document.getElementById('pdksAdvanceDeduction').value) || 0;

        var holidayExtra = holidayDays * dailyWage;
        var unpaidDed = unpaidDays * dailyWage;
        var netPayable = baseSalary + holidayExtra + overtimePay - unpaidDed - advanceDed;

        document.getElementById('pdksDailyWageText').innerText = '1 Yevmiye: ₺' + dailyWage.toFixed(2);
        document.getElementById('pdksHolidayExtraText').innerText = 'Çift Yevmiye Farkı: +₺' + holidayExtra.toFixed(2);
        document.getElementById('pdksUnpaidDeductionText').innerText = 'Kesinti: -₺' + unpaidDed.toFixed(2);
        document.getElementById('pdksNetPayableDisplay').innerText = '₺' + netPayable.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
</script>
