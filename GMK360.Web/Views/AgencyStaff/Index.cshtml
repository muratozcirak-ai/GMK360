@model IEnumerable<GMK360.Core.Entities.AgencyConsultant>
@{
    ViewData["Title"] = "Şirket Kullanıcıları (Beyaz Yaka)";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-person-badge text-primary me-2"></i>Şirket Kullanıcıları</h2>
            <p class="text-muted mb-0">Şantiye Şefi, Mimar, Muhasebeci gibi sisteme giriş yapabilen (Beyaz Yaka) personelleriniz.</p>
        </div>
        <a href="/AgencyStaff/Invite" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Yeni Kullanıcı Davet Et
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">Personel</th>
                        <th class="py-3">Rol / Yetki</th>
                        <th class="py-3">Katılım Tarihi</th>
                        <th class="py-3">Durum</th>
                        <th class="py-3 text-end pe-4">Aksiyon</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var user in Model)
                    {
                        <tr>
                            <td class="px-4">
                                <strong>@user.User.FirstName @user.User.LastName</strong><br />
                                <small class="text-muted">@user.User.Email</small>
                            </td>
                            <td>
                                <span class="badge bg-dark">@user.Role</span>
                            </td>
                            <td>@user.StartDate.ToShortDateString()</td>
                            <td>
                                @if(user.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger">Pasif</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="/AgencyStaff/Details/@user.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-person-lines-fill me-1"></i> Detay & Maaş
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
