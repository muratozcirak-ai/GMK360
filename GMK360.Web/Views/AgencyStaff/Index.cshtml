@model IEnumerable<GMK360.Core.Entities.AgencyConsultant>
@using GMK360.Web.Helpers
@{
    ViewData["Title"] = "Personel, Özlük Dosyası & Menü Yetkileri Yönetimi";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold mb-0"><i class="bi bi-people text-info me-2"></i>Personel, Özlük Dosyaları & Menü Yetkileri</h4>
            <p class="text-muted small mb-0">Şirket içi personellerinizin sol menü erişim yetkilerini, özlük evraklarını, ikametgah adreslerini ve <b>Basit PDKS (Maaş & Bayram Çift Yevmiye)</b> hesaplarını yönetin.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/AgencyStaff/Invite" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> + Yeni Personel Ekle & Yetkilendir
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 small shadow-xs rounded-3 mb-3">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Personel & Ekipler Üst Sekme Barı -->
    <ul class="nav nav-tabs mb-3 border-bottom">
        <li class="nav-item">
            <a href="/AgencyStaff/Index" class="nav-link active fw-bold text-dark">
                <i class="bi bi-shield-lock-fill text-primary me-1"></i>👔 1. Şirket Personeli, Özlük & Menü Yetkileri
            </a>
        </li>
        <li class="nav-item">
            <a href="/AgencyWorkers/Index" class="nav-link fw-semibold text-secondary">
                <i class="bi bi-person-workspace text-warning me-1"></i>👷 2. Mavi Yaka (Şantiye Ustaları)
            </a>
        </li>
        <li class="nav-item">
            <a href="/DailyTimesheets/Index" class="nav-link fw-semibold text-secondary">
                <i class="bi bi-calendar2-check text-success me-1"></i>⏱️ 3. Şantiye Günlük Puantaj
            </a>
        </li>
        <li class="nav-item">
            <a href="/AgencyPhonebook/Index" class="nav-link fw-semibold text-secondary">
                <i class="bi bi-journal-bookmark-fill text-info me-1"></i>📒 4. Firma, Taşeron & Ekip Rehberi (Arşiv & 360° Cari Dashboard)
            </a>
        </li>
    </ul>

    <!-- KURUMSAL PERSONEL & İK MİMARİSİ HIZLI ÖZET KARTLARI -->
    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-xs rounded-3 h-100 border-start border-4 border-dark bg-white">
                <div class="card-body p-2.5 px-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark small">👑 1. Firma Sahibi / Genel Müdür</span>
                        <span class="badge bg-dark rounded-pill" style="font-size: 0.68rem;">Tam Yetki</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.73rem;">
                        Ana kasa, çekler, sözleşmeler, kurumsal web sitesi ve tüm menü başlıklarında tam hakimiyet.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-xs rounded-3 h-100 border-start border-4 border-primary bg-white">
                <div class="card-body p-2.5 px-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-primary small">📐 2. Teknik Ofis & Mühendislik</span>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill" style="font-size: 0.68rem;">Proje & Metraj</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.73rem;">
                        Çizim arşivi, DNA metrajı ve satın alma masasını yönetir. Yönetici izin vermedikçe <b>Finans ve Kurumsal Web'i göremez</b>.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-xs rounded-3 h-100 border-start border-4 border-warning bg-white">
                <div class="card-body p-2.5 px-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark small">👷 3. Şantiye Şefi & Saha Formeni</span>
                        <span class="badge bg-danger text-white rounded-pill" style="font-size: 0.68rem;">Saha & Zimmet</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.73rem;">
                        Aktif şantiye ilerlemesi, irsaliye kabulü, garaj yakıt fişi ve saha puantajını girer; şirket kasasını göremez.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-xs rounded-3 h-100 border-start border-4 border-success bg-white">
                <div class="card-body p-2.5 px-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-success small">🗓️ 4. Özlük Dosyası & Basit PDKS</span>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill" style="font-size: 0.68rem;">Çift Yevmiye (2x)</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.73rem;">
                        Personel ikametgah adresi, özlük evrakları (İSG, Kimlik, Adli Sicil) ve <b>bayram/resmi tatil çift yevmiye</b> maaş ajandası.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PERSONEL LİSTESİ, ÖZLÜK & MENÜ LİNK YETKİLERİ TABLOSU -->
    <div class="card shadow-sm border-0 rounded-4 mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3">Personel & İletişim</th>
                            <th class="py-3">Görev Unvanı</th>
                            <th class="py-3">Açık Sol Menü Linkleri (Hakimiyet Sizde)</th>
                            <th class="py-3">Maaş & Günlük Yevmiye</th>
                            <th class="py-3">Durum</th>
                            <th class="py-3 text-end pe-4">Özlük, Yetki & PDKS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var perms = StaffPermissionHelper.GetEffectivePermissions(user.Role, user.User?.ActiveModules);
                            var dossier = StaffPermissionHelper.GetHrDossier(user.User?.RecoveryAnswer);
                            bool hasCustom = user.User?.ActiveModules != null && user.User.ActiveModules.Contains("custom_perms", StringComparison.OrdinalIgnoreCase);
                            decimal dailyWage = user.MonthlySalary > 0 ? Math.Round(user.MonthlySalary / 30m, 2) : 0;
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center gap-1.5">
                                        <strong>@user.User?.FirstName @user.User?.LastName</strong>
                                        @if (hasCustom)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill" style="font-size: 0.65rem;" title="Sol menü linkleri yönetici tarafından özel seçildi">Özel Menü Seçimi</span>
                                        }
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-envelope me-1"></i>@user.User?.Email
                                        @if (!string.IsNullOrWhiteSpace(user.User?.PhoneNumber))
                                        {
                                            <span class="ms-2"><i class="bi bi-telephone me-1"></i>@user.User.PhoneNumber</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(dossier.Address) || !string.IsNullOrWhiteSpace(dossier.City))
                                    {
                                        <div class="text-muted" style="font-size: 0.72rem;">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(dossier.Address) ? $"{dossier.District} / {dossier.City}" : dossier.Address)
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-dark px-2.5 py-1.5 rounded-pill" style="font-size: 0.73rem;">
                                        @(!string.IsNullOrWhiteSpace(dossier.TitleOrPosition) ? dossier.TitleOrPosition : StaffPermissionHelper.GetFriendlyRoleBadge(user.Role))
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 440px;">
                                        <span class="badge bg-light text-secondary border rounded-pill" title="Sabit Açık Ekranlar">📌 Özetim, Toplantı & Garaj (Sabit)</span>

                                        @if (perms.Contains(StaffPermissionHelper.PermFinance))
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill">💰 Finans & Cari Açık</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill">🔒 Finans Gizli</span>
                                        }

                                        @if (perms.Contains(StaffPermissionHelper.PermWebsite))
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill">🌐 Kurumsal Web Açık</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill">🚫 Kurumsal Web Gizli</span>
                                        }

                                        @if (perms.Contains(StaffPermissionHelper.PermDna))
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-dark border border-info-subtle rounded-pill">📐 2. Evre DNA</span>
                                        }
                                        @if (perms.Contains(StaffPermissionHelper.PermSite))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning-subtle rounded-pill">👷 3. Evre Saha</span>
                                        }
                                        @if (perms.Contains(StaffPermissionHelper.PermPurchasing))
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">🛒 Satın Alma</span>
                                        }
                                        @if (perms.Contains(StaffPermissionHelper.PermArchive))
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">📁 Evrak Arşivi</span>
                                        }
                                        @if (perms.Contains(StaffPermissionHelper.PermInventory))
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill">🛠️ Demirbaş</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (user.MonthlySalary > 0)
                                    {
                                        <div class="fw-bold text-dark small">₺@user.MonthlySalary.ToString("N2") <span class="text-muted fw-normal">/ Ay</span></div>
                                        <div class="text-success" style="font-size: 0.72rem;">Günlük Yevmiye: <b>₺@dailyWage.ToString("N2")</b></div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Maaş Girilmedi</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">Ayrıldı</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/AgencyStaff/Details/@user.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-xs">
                                        <i class="bi bi-folder2-open me-1"></i> Menü Yetkileri, Özlük & PDKS
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- FİRMA, TAŞERON VE TEDARİKÇİ REHBERİ BİLGİLENDİRME ŞERİDİ -->
    <div class="alert alert-light border rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2 py-2 px-3 small text-muted mb-0">
        <div>
            <i class="bi bi-info-circle-fill text-primary me-1"></i>
            <strong>Not:</strong> Bu sayfa yalnızca şirket bünyesindeki <b>kendi personelleriniz</b> içindir. Dışarıdan çalıştığınız taşeron firmalar, malzeme tedarikçileri ve telefon/adres rehberi <b>Finans & Cari</b> ile <b>Satın Alma & Taşeron</b> menüsü altındadır.
        </div>
        <div class="d-flex gap-2">
            <a href="/AgencyPhonebook/Index" class="btn btn-xs btn-outline-primary rounded-pill px-3 py-1 fw-bold" style="font-size: 0.74rem;">
                <i class="bi bi-journal-bookmark-fill me-1"></i>📒 Firma, Taşeron & Adres Rehberine Git
            </a>
            <a href="/SupplierCurrentAccount/Index" class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 fw-bold" style="font-size: 0.74rem;">
                <i class="bi bi-wallet2 me-1"></i>📊 Taşeron & Tedarikçi Carileri
            </a>
        </div>
    </div>
</div>
