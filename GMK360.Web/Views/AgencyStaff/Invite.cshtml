@{
    ViewData["Title"] = "Yeni Kullanýcý Davet Et";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle p-2 me-3">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-0">Yeni Personel (Beyaz Yaka) Davet Et</h2>
            <p class="text-muted mb-0">Þirketinizin ERP sistemine yeni bir þantiye þefi, mimar veya yönetici ekleyin.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form asp-action="Invite" method="post">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Adý <span class="text-danger">*</span></label>
                                <input name="firstName" type="text" class="form-control form-control-lg rounded-3" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Soyadý <span class="text-danger">*</span></label>
                                <input name="lastName" type="text" class="form-control form-control-lg rounded-3" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">E-Posta Adresi (Giriþ için kullanýlacak) <span class="text-danger">*</span></label>
                                <input name="email" type="email" class="form-control form-control-lg rounded-3" required />
                                <div class="form-text">Sisteme bu e-posta adresi ile giriþ yapacaktýr. Geçici þifre: <b>TempPass123!*</b></div>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Telefon Numarasý</label>
                                <input name="phoneNumber" type="tel" class="form-control form-control-lg rounded-3" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Þirket Ýçi Görevi (Rolü) <span class="text-danger">*</span></label>
                                <select name="role" class="form-select form-select-lg rounded-3" required>
                                    <option value="">-- Rol Seçiniz --</option>
                                    <option value="SiteManager">Þantiye Þefi</option>
                                    <option value="Architect">Mimar / Ýç Mimar</option>
                                    <option value="Engineer">Ýnþaat / Makine Mühendisi</option>
                                    <option value="Purchasing">Satýn Alma Sorumlusu</option>
                                    <option value="Accountant">Ön Muhasebe / Finans</option>
                                    <option value="Manager">Yönetici / Ortak</option>
                                </select>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 bg-primary bg-opacity-10 mt-4 rounded-3 d-flex align-items-center">
                            <i class="bi bi-shield-lock-fill text-primary fs-3 me-3"></i>
                            <div>
                                <strong>Yetkilendirme:</strong> Bu kullanýcý otomatik olarak <b>"Ýnþaat Firmasý"</b> sistem yetkisine sahip olacak ve bu ERP menülerine eriþebilecektir. Daha detaylý kýsýtlamalar eklenecektir.
                            </div>
                        </div>

                        <hr class="my-5" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg rounded-pill px-4">Ýptal</a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">Kullanýcýyý Kaydet ve Yetkilendir</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

