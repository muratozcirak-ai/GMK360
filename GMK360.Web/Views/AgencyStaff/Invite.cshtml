@using GMK360.Web.Helpers
@{
    ViewData["Title"] = "Yeni Personel Ekle, Özlük & Menü Yetkilerini Tanımla";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-light rounded-circle p-2 me-3 border shadow-xs">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">Yeni Personel Ekle, Özlük Dosyası Aç & Sol Menü Yetkilerini Seç</h4>
            <p class="text-muted small mb-0">Personelin iletişim/ikametgah adresini, maaş/günlük yevmiye bilgisini girin ve <b>sol menüde hangi ekranları görüp göremeyeceğini</b> tek tek belirleyin.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form asp-action="Invite" method="post">
                        @Html.AntiForgeryToken()

                        <!-- 1. BÖLÜM: KİMLİK, İLETİŞİM, İKAMETGAH ADRESİ VE MAAŞ -->
                        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                            <i class="bi bi-person-vcard-fill text-primary me-1"></i>1. Personel Kimlik, İletişim, İkametgah Adresi & Maaş Bilgileri
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Adı <span class="text-danger">*</span></label>
                                <input name="firstName" type="text" class="form-control form-control-sm rounded-3" placeholder="Örn: Ahmet" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Soyadı <span class="text-danger">*</span></label>
                                <input name="lastName" type="text" class="form-control form-control-sm rounded-3" placeholder="Örn: Yılmaz" required />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold small">TC Kimlik No</label>
                                <input name="identityNumber" type="text" maxlength="11" class="form-control form-control-sm rounded-3" placeholder="11 Haneli TC No" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Cep Telefonu (WhatsApp)</label>
                                <input name="phoneNumber" type="tel" class="form-control form-control-sm rounded-3" placeholder="05XX XXX XX XX" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small">E-Posta Adresi (Giriş İçin) <span class="text-danger">*</span></label>
                                <input name="email" type="email" class="form-control form-control-sm rounded-3" placeholder="ornek@firma.com" required />
                                <div class="form-text" style="font-size: 0.70rem;">İlk giriş şifresi otomatik: <b>TempPass123!*</b></div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Şirket İçi Görev Şablonu <span class="text-danger">*</span></label>
                                <select name="role" id="roleSelect" class="form-select form-select-sm rounded-3 fw-bold border-primary" onchange="applyRolePreset(this.value)" required>
                                    <optgroup label="1. YÖNETİM KADROSU (TAM YETKİ)">
                                        <option value="Manager">👔 Genel Müdür / Firma Yetkilisi (Tüm Menüler Açık)</option>
                                    </optgroup>
                                    <optgroup label="2. TEKNİK OFİS & MUHASEBE KADROSU">
                                        <option value="Engineer" selected>📐 Teknik Ofis & Saha Mühendisi</option>
                                        <option value="Architect">📐 Proje Mimarı & Çizim Sorumlusu</option>
                                        <option value="Purchasing">🛒 Satın Alma & İhale Sorumlusu</option>
                                        <option value="Accountant">💼 Ön Muhasebe & Finans Sorumlusu</option>
                                    </optgroup>
                                    <optgroup label="3. ŞANTİYE SAHA & LOJİSTİK KADROSU">
                                        <option value="SiteManager">👷 Şantiye Şefi / Saha Formeni</option>
                                        <option value="Driver">🚛 Araç & Saha Lojistik Sorumlusu</option>
                                    </optgroup>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Özel Görev Unvanı (İsteğe Bağlı)</label>
                                <input name="titleOrPosition" type="text" class="form-control form-control-sm rounded-3" placeholder="Örn: Kıdemli Şantiye Şefi / İSG Uzmanı" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-success">Aylık Net Maaş (₺)</label>
                                <input name="monthlySalary" id="inviteMonthlySalary" type="number" step="0.01" class="form-control form-control-sm rounded-3 border-success" placeholder="Örn: 45000" oninput="updateInviteDailyWage()" />
                                <div class="form-text text-success fw-semibold" id="inviteDailyWageHint" style="font-size: 0.70rem;">Günlük Yevmiye: ₺0,00 (Bayram 2x hesabı için)</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Banka IBAN Numarası</label>
                                <input name="iban" type="text" class="form-control form-control-sm rounded-3" placeholder="TR00 0000 ..." />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label fw-bold small">Kan Grubu</label>
                                <select name="bloodGroup" class="form-select form-select-sm rounded-3">
                                    <option value="">Seçiniz</option>
                                    <option value="A Rh(+)">A Rh(+)</option>
                                    <option value="A Rh(-)">A Rh(-)</option>
                                    <option value="B Rh(+)">B Rh(+)</option>
                                    <option value="B Rh(-)">B Rh(-)</option>
                                    <option value="AB Rh(+)">AB Rh(+)</option>
                                    <option value="AB Rh(-)">AB Rh(-)</option>
                                    <option value="0 Rh(+)">0 Rh(+)</option>
                                    <option value="0 Rh(-)">0 Rh(-)</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Acil Durum Yakını & Tel</label>
                                <input name="emergencyContactPhone" type="text" class="form-control form-control-sm rounded-3" placeholder="Örn: Eşi - 0532..." />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold small">İkamet İl / İlçe</label>
                                <div class="input-group input-group-sm">
                                    <input name="city" type="text" class="form-control" placeholder="İl (İstanbul)" />
                                    <input name="district" type="text" class="form-control" placeholder="İlçe (Ataşehir)" />
                                </div>
                            </div>

                            <div class="col-md-9">
                                <label class="form-label fw-bold small">Personel İkametgah / Açık Ev Adresi (Özlük Dosyası İçin)</label>
                                <input name="address" type="text" class="form-control form-control-sm rounded-3" placeholder="Mahalle, Cadde/Sokak, Bina ve Daire No" />
                            </div>
                        </div>

                        <!-- 2. BÖLÜM: SOL MENÜ LİNKLERİ VE EKRAN YETKİLERİ (HAKİMİYET SİZDE) -->
                        <div class="mt-4 p-3 rounded-4 border border-primary border-opacity-25 bg-light">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="bi bi-sliders text-primary me-1"></i>2. Sol Menü Linkleri & Ekran Yetkileri ("Hakimiyet Bende" Seçimi)
                                    </h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        Bu personelin sol menüde hangi başlıkları görebileceğini tek tek işaretleyin. Örneğin <b>"Kurumsal Web & Domain"</b> veya <b>"Finans & Cari"</b> kutusunu kapatırsanız o menüyü kesinlikle göremez.
                                    </small>
                                </div>
                                <div class="d-flex gap-1.5 flex-wrap">
                                    <button type="button" class="btn btn-xs btn-outline-dark rounded-pill px-2.5 py-1 small fw-bold" onclick="toggleAllPerms(true)">Tüm Menüleri Aç (Tam Yetki)</button>
                                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 small fw-bold" onclick="applyRolePreset('Engineer')">Teknik Ofis (Finans & Web Gizli)</button>
                                    <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2.5 py-1 small fw-bold" onclick="applyRolePreset('SiteManager')">Sadece Saha & Demirbaş</button>
                                </div>
                            </div>

                            <!-- Sabit Açık Olan 3 Temel Ekran -->
                            <div class="alert alert-white bg-white border rounded-3 py-2 px-3 mb-2.5 shadow-xs">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-pin-angle-fill text-success me-1"></i>Sabit Açık Ekranlar (Her Personelde Standart Açık Kalır):</div>
                                <div class="row g-2">
                                    @foreach (var fix in StaffPermissionHelper.FixedMenuDefinitions)
                                    {
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-start gap-2 small">
                                                <i class="bi bi-check-circle-fill text-success mt-0.5"></i>
                                                <div>
                                                    <div class="fw-bold text-dark" style="font-size: 0.76rem;"><i class="bi @fix.Icon me-1"></i>@fix.Title</div>
                                                    <div class="text-muted" style="font-size: 0.69rem;">@fix.Description</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Yönetici Tarafından Tek Tek Seçilebilen Sol Menü Linkleri -->
                            <div class="row g-2 mt-1">
                                @foreach (var perm in StaffPermissionHelper.AllPermissionDefinitions)
                                {
                                    bool defaultChecked = perm.Code == StaffPermissionHelper.PermDna
                                                       || perm.Code == StaffPermissionHelper.PermSite
                                                       || perm.Code == StaffPermissionHelper.PermPurchasing
                                                       || perm.Code == StaffPermissionHelper.PermArchive
                                                       || perm.Code == StaffPermissionHelper.PermInventory;
                                    <div class="col-md-6">
                                        <label class="card border shadow-xs rounded-3 p-2.5 h-100 cursor-pointer d-flex flex-row align-items-start gap-2 bg-white">
                                            <input type="checkbox" name="selectedPermissions" value="@perm.Code" class="form-check-input mt-1 perm-checkbox" data-code="@perm.Code" @(defaultChecked ? "checked" : "") />
                                            <div>
                                                <div class="fw-bold text-dark small"><i class="bi @perm.Icon me-1"></i>@perm.Title</div>
                                                <div class="text-muted" style="font-size: 0.72rem;">@perm.Description</div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">İptal</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i>Personeli Kaydet, Özlük Dosyası Aç ve Yetkilendir
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function applyRolePreset(role) {
        var presets = {
            'Manager': ['cand', 'dna', 'site', 'fin', 'pur', 'doc', 'crm', 'staff', 'inv', 'web', 'strategy'],
            'Owner': ['cand', 'dna', 'site', 'fin', 'pur', 'doc', 'crm', 'staff', 'inv', 'web', 'strategy'],
            'Engineer': ['dna', 'site', 'pur', 'doc', 'inv'],
            'Architect': ['dna', 'site', 'pur', 'doc'],
            'Purchasing': ['dna', 'site', 'pur', 'doc', 'inv'],
            'Accountant': ['fin', 'pur', 'doc', 'staff'],
            'SiteManager': ['site', 'inv'],
            'Driver': ['site', 'inv']
        };
        var active = presets[role] || ['site', 'inv'];
        document.querySelectorAll('.perm-checkbox').forEach(function(cb) {
            cb.checked = active.indexOf(cb.getAttribute('data-code')) !== -1;
        });
    }

    function toggleAllPerms(state) {
        document.querySelectorAll('.perm-checkbox').forEach(function(cb) {
            cb.checked = state;
        });
    }

    function updateInviteDailyWage() {
        var val = parseFloat(document.getElementById('inviteMonthlySalary').value) || 0;
        var daily = (val / 30).toFixed(2);
        document.getElementById('inviteDailyWageHint').innerText = 'Günlük Yevmiye: ₺' + daily + ' (Bayram 2x Çift Yevmiye: ₺' + (val / 15).toFixed(2) + ')';
    }
</script>
