@model GMK360.Core.Entities.Identity.ApplicationUser
@{
    ViewData["Title"] = "Profilim ve Hesap Ayarları";
    // We assume the user has a layout. Let's use the default layout or an account layout if they have one.
    // We will use standard layout for front-end users.
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<div class="container py-5 mt-5">
    <div class="row">
        <!-- Sidebar Menu -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    <div class="bg-primary p-4 text-center text-white">
                        <div class="avatar-circle mb-2 mx-auto d-flex align-items-center justify-content-center bg-white text-primary fw-bold rounded-circle shadow" style="width: 80px; height: 80px; font-size: 32px;">
                            @(Model.FirstName?.Substring(0, 1))@(Model.LastName?.Substring(0, 1))
                        </div>
                        <h5 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h5>
                        <p class="small text-white-50 mb-0">@Model.Email</p>
                    </div>
                    <div class="list-group list-group-flush border-0" id="profileTabs" role="tablist">
                        <a class="list-group-item list-group-item-action active fw-bold py-3 border-0" id="nav-account-tab" data-bs-toggle="list" href="#nav-account" role="tab">
                            <i class="ph ph-user me-2 fs-5 align-middle text-primary"></i> Hesabım
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-security-tab" data-bs-toggle="list" href="#nav-security" role="tab">
                            <i class="ph ph-shield-check me-2 fs-5 align-middle text-success"></i> Güvenlik & Doğrulama
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-subscription-tab" data-bs-toggle="list" href="#nav-subscription" role="tab">
                            <i class="ph ph-crown me-2 fs-5 align-middle text-warning"></i> Abonelik (Paketler)
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-billing-tab" data-bs-toggle="list" href="#nav-billing" role="tab">
                            <i class="ph ph-credit-card me-2 fs-5 align-middle text-info"></i> Ödeme Yöntemleri
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-shadow-tab" data-bs-toggle="list" href="#nav-shadow" role="tab">
                            <i class="ph ph-users-three me-2 fs-5 align-middle text-secondary"></i> Alt Kullanıcılar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-md-9">
            <div class="tab-content" id="nav-tabContent">
                
                <!-- 1. HESABIM -->
                <div class="tab-pane fade show active" id="nav-account" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0">
                            <h4 class="fw-bold"><i class="ph ph-user text-primary me-2"></i>Kişisel Bilgiler</h4>
                            <p class="text-muted small">Hesabınıza ait temel bilgileri buradan güncelleyebilirsiniz.</p>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Ad</label>
                                        <input type="text" class="form-control rounded-3" value="@Model.FirstName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Soyad</label>
                                        <input type="text" class="form-control rounded-3" value="@Model.LastName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">T.C. Kimlik No</label>
                                        <input type="text" class="form-control rounded-3" value="@Model.TcIdentityNo" readonly />
                                        <div class="form-text text-success"><i class="bi bi-check-circle-fill"></i> E-Devlet onaylı kimlik numarası</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Doğum Yılı</label>
                                        <input type="text" class="form-control rounded-3" value="@Model.BirthYear" readonly />
                                    </div>
                                    <div class="col-12 mt-4 text-end">
                                        <button type="button" class="btn btn-primary rounded-pill px-4">Bilgileri Güncelle</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 2. GÜVENLİK VE DOĞRULAMA -->
                <div class="tab-pane fade" id="nav-security" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
                                <div>
                                    <h5 class="fw-bold mb-1">E-Posta Doğrulaması</h5>
                                    <p class="text-muted small mb-0">Hesap kurtarma ve bildirimler için e-posta adresinizi doğrulayın.</p>
                                    <p class="mb-0 mt-2 fw-bold">@Model.Email</p>
                                </div>
                                <div>
                                    @if(Model.EmailConfirmed) {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success p-2 px-3 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Doğrulandı
                                        </span>
                                    } else {
                                        <button class="btn btn-warning rounded-pill px-4">Doğrulama E-postası Gönder</button>
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
                                <div>
                                    <h5 class="fw-bold mb-1">Telefon (SMS) Doğrulaması</h5>
                                    <p class="text-muted small mb-0">İlan verebilmek ve güvenliğinizi artırmak için telefonunuzu doğrulayın.</p>
                                    <p class="mb-0 mt-2 fw-bold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Telefon numarası eklenmemiş" : Model.PhoneNumber)</p>
                                </div>
                                <div>
                                    @if(Model.PhoneNumberConfirmed) {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success p-2 px-3 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Doğrulandı
                                        </span>
                                    } else {
                                        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#smsModal">Telefon Doğrula</button>
                                    }
                                </div>
                            </div>
                            
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                <div>
                                    <h5 class="fw-bold mb-1">Şifre Değiştir</h5>
                                    <p class="text-muted small mb-0">Hesap güvenliğiniz için düzenli olarak şifrenizi güncelleyin.</p>
                                </div>
                                <div>
                                    <button class="btn btn-outline-secondary rounded-pill px-4">Şifremi Güncelle</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. ABONELİK -->
                <div class="tab-pane fade" id="nav-subscription" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                        <i class="ph ph-crown text-warning mb-3" style="font-size: 4rem;"></i>
                        <h4 class="fw-bold">Abonelik Paketleri</h4>
                        <p class="text-muted">Ücretsiz Bireysel plan kullanıyorsunuz. Daha fazla ilan yayınlamak veya vitrin özelliklerinden yararlanmak için planınızı yükseltin.</p>
                        <div class="mt-4">
                            <button class="btn btn-warning btn-lg rounded-pill px-5 fw-bold text-dark shadow-sm">Planları Görüntüle</button>
                        </div>
                    </div>
                </div>

                <!-- 4. FİNANS / IYZICO KARTLAR -->
                <div class="tab-pane fade" id="nav-billing" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold"><i class="ph ph-credit-card text-info me-2"></i>Kayıtlı Kartlarım</h4>
                                <p class="text-muted small">Iyzico güvencesiyle saklanan ödeme yöntemleriniz.</p>
                            </div>
                            <button class="btn btn-outline-info rounded-pill" data-bs-toggle="modal" data-bs-target="#addCardModal"><i class="bi bi-plus-lg me-1"></i> Yeni Kart Ekle</button>
                        </div>
                        <div class="card-body text-center p-5">
                            <div class="bg-light p-4 rounded-4 d-inline-block mb-3">
                                <i class="ph ph-wallet text-secondary" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="fw-bold">Henüz Kayıtlı Kartınız Yok</h5>
                            <p class="text-muted small">Hızlı ödeme yapabilmek için kredi kartınızı güvenle ekleyebilirsiniz.</p>
                        </div>
                    </div>
                </div>

                <!-- 5. GÖLGE KULLANICILAR -->
                <div class="tab-pane fade" id="nav-shadow" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold"><i class="ph ph-users-three text-secondary me-2"></i>Alt Kullanıcılar (Gölge Hesap)</h4>
                                <p class="text-muted small">Sizin adınıza ilan girebilecek veya yönetebilecek ekip üyeleri ekleyin.</p>
                            </div>
                            <button class="btn btn-primary rounded-pill"><i class="bi bi-person-plus me-1"></i> Kullanıcı Davet Et</button>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-primary bg-primary bg-opacity-10 border-0 rounded-3 d-flex align-items-center">
                                <i class="ph ph-info me-3 fs-3 text-primary"></i>
                                <div>
                                    <strong>Gölge Kullanıcı Nedir?</strong><br/>
                                    Emlak ofisinizdeki danışmanlara veya asistanınıza sizin hesap limitlerinizle işlem yapma yetkisi verebilirsiniz. Onlar kendi mail/şifreleri ile girerler, ancak sizin alt hesabınız olurlar.
                                </div>
                            </div>
                            
                            <div class="text-center p-5">
                                <h6 class="text-muted">Şu anda kayıtlı alt kullanıcınız bulunmuyor.</h6>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- SMS Doğrulama Modalı -->
<div class="modal fade" id="smsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Telefon Doğrulama</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <i class="ph ph-device-mobile text-primary mb-3" style="font-size: 4rem;"></i>
                <p class="text-muted mb-4">Lütfen telefon numaranızı girin. Size 6 haneli bir doğrulama kodu (OTP) göndereceğiz.</p>
                
                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text bg-light border-end-0 text-muted">+90</span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="5XX XXX XX XX">
                </div>
                
                <button type="button" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold">Kodu Gönder</button>
            </div>
        </div>
    </div>
</div>

<!-- Kart Ekleme Modalı (Iyzico) -->
<div class="modal fade" id="addCardModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Yeni Kredi Kartı Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small text-muted">Kart Üzerindeki İsim</label>
                    <input type="text" class="form-control rounded-3">
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Kart Numarası</label>
                    <input type="text" class="form-control rounded-3" placeholder="**** **** **** ****">
                </div>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label small text-muted">Son K. Tarihi</label>
                        <input type="text" class="form-control rounded-3" placeholder="AA/YY">
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">CVV</label>
                        <input type="text" class="form-control rounded-3" placeholder="***">
                    </div>
                </div>
                
                <div class="d-flex align-items-center mt-4">
                    <i class="bi bi-shield-lock-fill text-success fs-3 me-2"></i>
                    <small class="text-muted">Kart bilgileriniz Iyzico (PCI-DSS uyumlu) altyapısında güvenle saklanmaktadır. Sunucularımızda kart bilgileriniz tutulmaz.</small>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-info text-white rounded-pill px-4 fw-bold">Kartı Güvenle Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tab styling adjustments
        $('.list-group-item').on('click', function() {
            $('.list-group-item').removeClass('bg-light border-start border-4 border-primary');
            $(this).addClass('bg-light border-start border-4 border-primary');
        });
        
        // Trigger style on load
        $('.list-group-item.active').addClass('bg-light border-start border-4 border-primary');
    </script>
}

