@model GMK360.Core.Entities.Identity.ApplicationUser
@{
    ViewData["Title"] = "Profilim ve Hesap Ayarları";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var subSummary = ViewBag.SubscriptionSummary as GMK360.Web.Services.SubscriptionStatusSummary;
    var linkedUnits = ViewBag.LinkedUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
}

<div class="container py-5 mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["EmailVerifyLink"] != null)
    {
        <div class="alert alert-info rounded-4 border-0 shadow-sm mb-3 small">
            <strong>Doğrulama Bağlantısı (E-posta servisi test modu için):</strong>
            <a href="@TempData["EmailVerifyLink"]" class="fw-bold ms-1">E-postamı Şimdi Doğrula →</a>
        </div>
    }
    <div class="row">
        <!-- Sidebar Menu -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    <div class="bg-primary p-4 text-center text-white">
                        <div class="avatar-circle mb-2 mx-auto d-flex align-items-center justify-content-center bg-white text-primary fw-bold rounded-circle shadow" style="width: 80px; height: 80px; font-size: 32px;">
                            @(Model.FirstName?.Substring(0, 1))@(Model.LastName?.Substring(0, 1))
                        </div>
                        <h5 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h5>
                        <p class="small text-white-50 mb-0">@Model.Email</p>
                    </div>
                    <div class="list-group list-group-flush border-0" id="profileTabs" role="tablist">
                        <a class="list-group-item list-group-item-action active fw-bold py-3 border-0" id="nav-account-tab" data-bs-toggle="list" href="#nav-account" role="tab">
                            <i class="ph ph-user me-2 fs-5 align-middle text-primary"></i> Hesabım
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-security-tab" data-bs-toggle="list" href="#nav-security" role="tab">
                            <i class="ph ph-shield-check me-2 fs-5 align-middle text-success"></i> Güvenlik & Doğrulama
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-subscription-tab" data-bs-toggle="list" href="#nav-subscription" role="tab">
                            <i class="ph ph-crown me-2 fs-5 align-middle text-warning"></i> Abonelik (Paketler)
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-billing-tab" data-bs-toggle="list" href="#nav-billing" role="tab">
                            <i class="ph ph-credit-card me-2 fs-5 align-middle text-info"></i> Ödeme Yöntemleri
                        </a>
                        <a class="list-group-item list-group-item-action fw-bold py-3 border-0" id="nav-shadow-tab" data-bs-toggle="list" href="#nav-shadow" role="tab">
                            <i class="ph ph-users-three me-2 fs-5 align-middle text-secondary"></i> Alt Kullanıcılar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-md-9">
            <div class="tab-content" id="nav-tabContent">
                
                <!-- 1. HESABIM -->
                <div class="tab-pane fade show active" id="nav-account" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0">
                            <h4 class="fw-bold"><i class="ph ph-user text-primary me-2"></i>Kişisel Bilgiler</h4>
                            <p class="text-muted small">Hesabınıza ait temel bilgileri buradan güncelleyebilirsiniz.</p>
                        </div>
                        <div class="card-body">
                            @if (linkedUnits.Any())
                            {
                                <div class="alert alert-light border rounded-3 small mb-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <strong>Hesabınıza Bağlı Bağımsız Bölümler:</strong>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a href="/FacilityPortal/Index" class="btn btn-xs btn-success rounded-pill px-3 fw-semibold">Bina / Daire Portalım (Arıza &amp; Toplantı) &rarr;</a>
                                            @if (linkedUnits.Any(lu => lu.OwnerUserId == Model.Id))
                                            {
                                                <a href="/Landlord/Dashboard" class="btn btn-xs btn-outline-primary rounded-pill px-3 fw-semibold">Mülk Sahibi Kokpitim &rarr;</a>
                                            }
                                        </div>
                                    </div>
                                    <div class="mt-1 d-flex flex-wrap gap-1">
                                        @foreach (var lu in linkedUnits)
                                        {
                                            <a href="/FacilityPortal/Index?buildingId=@lu.BuildingId" class="badge bg-success-subtle text-success border border-success-subtle text-decoration-none">
                                                @(lu.Building?.Name ?? "Bina") • No:@lu.DoorNumber (@(lu.OwnerUserId == Model.Id ? "Malik" : "Kiracı"))
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            <form asp-controller="Profile" asp-action="UpdateBasicInfo" method="post">
                                @Html.AntiForgeryToken()
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Ad</label>
                                        <input type="text" name="firstName" class="form-control rounded-3" value="@Model.FirstName" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Soyad</label>
                                        <input type="text" name="lastName" class="form-control rounded-3" value="@Model.LastName" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">E-Posta Adresi</label>
                                        <input type="email" name="email" class="form-control rounded-3" value="@Model.Email" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Telefon Numarası</label>
                                        <input type="text" name="phoneNumber" class="form-control rounded-3" value="@Model.PhoneNumber" placeholder="05XX XXX XX XX" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">T.C. Kimlik No</label>
                                        @if (string.IsNullOrWhiteSpace(Model.TcIdentityNo))
                                        {
                                            <input type="text" inputmode="numeric" maxlength="11" name="tcIdentityNo" class="form-control rounded-3" placeholder="11 haneli T.C. Kimlik No (Tekil kimlik kilidi)" />
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control rounded-3 bg-light" value="@Model.TcIdentityNo" readonly />
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small">Doğum Yılı</label>
                                        @if (!Model.BirthYear.HasValue)
                                        {
                                            <input type="number" min="1920" max="2012" name="birthYear" class="form-control rounded-3" placeholder="Örn: 1985" />
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control rounded-3 bg-light" value="@Model.BirthYear" readonly />
                                        }
                                    </div>
                                    <div class="col-12 border-top pt-3">
                                        <label class="form-label fw-bold small text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Yapılandırılmış İkametgah Adresi (Gerçek İl / İlçe / Mahalle / Bina No)</label>
                                        @{
                                            var addrVd = new ViewDataDictionary(ViewData)
                                            {
                                                ["AddressPrefix"] = "prof",
                                                ["AddressRequired"] = false,
                                                ["AddressCityId"] = Model.AddressCityId,
                                                ["AddressDistrictId"] = Model.AddressDistrictId,
                                                ["AddressNeighborhoodId"] = Model.AddressNeighborhoodId,
                                                ["AddressStreetId"] = Model.AddressStreetId,
                                                ["AddressStreetName"] = Model.AddressStreetName,
                                                ["AddressBuildingNo"] = Model.AddressBuildingNo,
                                                ["AddressApartmentNo"] = Model.AddressApartmentNo,
                                                ["AddressFormatted"] = Model.Address
                                            };
                                        }
                                        @await Html.PartialAsync("_StructuredAddressPartial", null, addrVd)
                                    </div>
                                    <div class="col-12 mt-4 text-end">
                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Bilgileri Güncelle</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 2. GÜVENLİK VE DOĞRULAMA -->
                <div class="tab-pane fade" id="nav-security" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
                                <div>
                                    <h5 class="fw-bold mb-1">E-Posta Doğrulaması</h5>
                                    <p class="text-muted small mb-0">Hesap kurtarma, karar bildirimleri ve davetler için e-postanızı doğrulayın.</p>
                                    <p class="mb-0 mt-2 fw-bold">@Model.Email</p>
                                </div>
                                <div>
                                    @if (Model.EmailConfirmed)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success p-2 px-3 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Doğrulandı
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-controller="Profile" asp-action="RequestEmailVerify" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Doğrulama E-postası Gönder</button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
                                <div>
                                    <h5 class="fw-bold mb-1">Telefon (SMS) Doğrulaması</h5>
                                    <p class="text-muted small mb-0">SMS servisi aktif olduğunda OTP koduyla teyit edilir. Şu an numaranızı beyan olarak kaydedebilirsiniz.</p>
                                    <p class="mb-0 mt-2 fw-bold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Telefon numarası eklenmemiş" : Model.PhoneNumber)</p>
                                </div>
                                <div>
                                    @if (Model.PhoneNumberConfirmed)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success p-2 px-3 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> SMS İle Doğrulandı
                                        </span>
                                    }
                                    else if (Model.PhoneVerifiedAt.HasValue)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle p-2 px-3 rounded-pill me-2">
                                            ⏳ SMS Bekleniyor (Beyan: @Model.PhoneVerifiedAt.Value.ToString("dd.MM.yyyy"))
                                        </span>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#smsModal">Numara Güncelle</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#smsModal">Telefon Kaydet / Doğrula</button>
                                    }
                                </div>
                            </div>

                            <!-- KİŞİSEL GİZLİ ONAY & PWA PIN -->
                            <div class="p-3 rounded-4 bg-warning bg-opacity-10 border border-warning-subtle mb-4">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                    <div>
                                        <h5 class="fw-bold mb-1"><i class="bi bi-key-fill text-warning me-2"></i>Kişisel Onay &amp; Mobil Giriş PIN'i</h5>
                                        <p class="text-muted small mb-0">Yalnızca sizin bildiğiniz, yöneticilerin göremediği 4-6 haneli onay ve <code>/FacilityPortal</code> hızlı giriş şifreniz.</p>
                                    </div>
                                    <span class="badge @(Model.IsTransactionPinSet ? "bg-success" : "bg-danger") rounded-pill px-3 py-2">
                                        @(Model.IsTransactionPinSet ? "🔐 Kişisel PIN Aktif" : "⏳ PIN Henüz Belirlenmedi")
                                    </span>
                                </div>
                                <form asp-controller="Profile" asp-action="SetPersonalPin" method="post" class="row g-2 align-items-center mt-2">
                                    @Html.AntiForgeryToken()
                                    <div class="col-md-5">
                                        <input type="password" inputmode="numeric" pattern="[0-9]{4,6}" maxlength="6" name="personalPin" class="form-control" required placeholder="Yeni 4-6 haneli PIN (Örn: 4821)" />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">Kişisel PIN'imi Kaydet</button>
                                    </div>
                                </form>
                            </div>

                            <!-- ŞİFRE DEĞİŞTİRME -->
                            <div>
                                <h5 class="fw-bold mb-1">Giriş Şifresi @(Model.MustChangePassword ? "(İlk Şifre Değişikliği Önerilir)" : "Değiştir")</h5>
                                <p class="text-muted small mb-3">Hesap güvenliğiniz için şifrenizi kendiniz belirleyin ve güncel tutun.</p>
                                <form asp-controller="Profile" asp-action="ChangeOwnPassword" method="post" class="row g-2">
                                    @Html.AntiForgeryToken()
                                    @if (!Model.MustChangePassword && !Model.IsShadowAccount)
                                    {
                                        <div class="col-md-4">
                                            <input type="password" name="currentPassword" class="form-control" placeholder="Mevcut Şifreniz" required />
                                        </div>
                                    }
                                    <div class="col-md-3">
                                        <input type="password" name="newPassword" class="form-control" placeholder="Yeni Şifre (8+ krk)" required minlength="8" />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="password" name="confirmPassword" class="form-control" placeholder="Yeni Şifre Tekrar" required minlength="8" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-outline-dark fw-bold rounded-pill w-100">Güncelle</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. ABONELİK -->
                <div class="tab-pane fade" id="nav-subscription" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h4 class="fw-bold mb-0"><i class="ph ph-crown text-warning me-2"></i>Abonelik &amp; 15 Günlük Deneme Durumu</h4>
                            @if (subSummary != null && subSummary.HasSubscription)
                            {
                                <span class="badge @(subSummary.PaymentStatus == "Paid" ? "bg-success" : subSummary.IsExpired ? "bg-danger" : "bg-warning text-dark") rounded-pill px-3 py-2">
                                    @subSummary.PaymentStatus
                                </span>
                            }
                        </div>
                        @if (subSummary != null && subSummary.HasSubscription)
                        {
                            <div class="p-3 rounded-4 bg-light border">
                                <div class="fw-bold fs-5 text-dark">@subSummary.PackageName</div>
                                <div class="small text-muted mt-1">
                                    Başlangıç: <strong>@(subSummary.StartDate?.ToString("dd.MM.yyyy") ?? "-")</strong> •
                                    Ödeme / Bitiş Tarihi: <strong>@(subSummary.EndDate?.ToString("dd.MM.yyyy") ?? "Süresiz")</strong>
                                    @if (subSummary.DaysRemaining.HasValue && subSummary.PaymentStatus != "Paid")
                                    {
                                        <span class="badge bg-dark ms-2">Kalan: @subSummary.DaysRemaining.Value gün</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(subSummary.CampaignName))
                                {
                                    <div class="mt-2"><span class="badge bg-primary">🎁 Kampanya: @subSummary.CampaignName (%@subSummary.DiscountPercentage.ToString("0"))</span></div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Şu anda ücretsiz / standart üye statüsündesiniz.</p>
                        }
                    </div>
                </div>

                <!-- 4. FİNANS / IYZICO KARTLAR -->
                <div class="tab-pane fade" id="nav-billing" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold"><i class="ph ph-credit-card text-info me-2"></i>Kayıtlı Kartlarım</h4>
                                <p class="text-muted small">Iyzico güvencesiyle saklanan ödeme yöntemleriniz.</p>
                            </div>
                            <button class="btn btn-outline-info rounded-pill" data-bs-toggle="modal" data-bs-target="#addCardModal"><i class="bi bi-plus-lg me-1"></i> Yeni Kart Ekle</button>
                        </div>
                        <div class="card-body text-center p-5">
                            <div class="bg-light p-4 rounded-4 d-inline-block mb-3">
                                <i class="ph ph-wallet text-secondary" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="fw-bold">Henüz Kayıtlı Kartınız Yok</h5>
                            <p class="text-muted small">Hızlı ödeme yapabilmek için kredi kartınızı güvenle ekleyebilirsiniz.</p>
                        </div>
                    </div>
                </div>

                <!-- 5. GÖLGE KULLANICILAR -->
                <div class="tab-pane fade" id="nav-shadow" role="tabpanel">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold"><i class="ph ph-users-three text-secondary me-2"></i>Alt Kullanıcılar (Gölge Hesap)</h4>
                                <p class="text-muted small">Sizin adınıza ilan girebilecek veya yönetebilecek ekip üyeleri ekleyin.</p>
                            </div>
                            <button class="btn btn-primary rounded-pill"><i class="bi bi-person-plus me-1"></i> Kullanıcı Davet Et</button>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-primary bg-primary bg-opacity-10 border-0 rounded-3 d-flex align-items-center">
                                <i class="ph ph-info me-3 fs-3 text-primary"></i>
                                <div>
                                    <strong>Gölge Kullanıcı Nedir?</strong><br/>
                                    Emlak ofisinizdeki danışmanlara veya asistanınıza sizin hesap limitlerinizle işlem yapma yetkisi verebilirsiniz. Onlar kendi mail/şifreleri ile girerler, ancak sizin alt hesabınız olurlar.
                                </div>
                            </div>
                            
                            <div class="text-center p-5">
                                <h6 class="text-muted">Şu anda kayıtlı alt kullanıcınız bulunmuyor.</h6>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- SMS Doğrulama Modalı -->
<div class="modal fade" id="smsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Telefon Doğrulama</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Profile" asp-action="ConfirmPhoneNumberManual" method="post" class="modal-body text-center p-4">
                @Html.AntiForgeryToken()
                <i class="ph ph-device-mobile text-primary mb-3" style="font-size: 4rem;"></i>
                <p class="text-muted mb-3">SMS doğrulama servisi henüz aktif değildir; şimdilik cep telefonunuzu profilinize kaydedebilirsiniz.</p>
                
                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text bg-light border-end-0 text-muted">+90</span>
                    <input type="text" name="phoneNumber" class="form-control border-start-0 ps-0" value="@Model.PhoneNumber" placeholder="5XX XXX XX XX" required />
                </div>
                
                <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold">Numaramı Kaydet</button>
            </form>
        </div>
    </div>
</div>

<!-- Kart Ekleme Modalı (Iyzico) -->
<div class="modal fade" id="addCardModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Yeni Kredi Kartı Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small text-muted">Kart Üzerindeki İsim</label>
                    <input type="text" class="form-control rounded-3">
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Kart Numarası</label>
                    <input type="text" class="form-control rounded-3" placeholder="**** **** **** ****">
                </div>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label small text-muted">Son K. Tarihi</label>
                        <input type="text" class="form-control rounded-3" placeholder="AA/YY">
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">CVV</label>
                        <input type="text" class="form-control rounded-3" placeholder="***">
                    </div>
                </div>
                
                <div class="d-flex align-items-center mt-4">
                    <i class="bi bi-shield-lock-fill text-success fs-3 me-2"></i>
                    <small class="text-muted">Kart bilgileriniz Iyzico (PCI-DSS uyumlu) altyapısında güvenle saklanmaktadır. Sunucularımızda kart bilgileriniz tutulmaz.</small>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-info text-white rounded-pill px-4 fw-bold">Kartı Güvenle Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tab styling adjustments
        $('.list-group-item').on('click', function() {
            $('.list-group-item').removeClass('bg-light border-start border-4 border-primary');
            $(this).addClass('bg-light border-start border-4 border-primary');
        });
        
        // Trigger style on load
        $('.list-group-item.active').addClass('bg-light border-start border-4 border-primary');
    </script>
}

