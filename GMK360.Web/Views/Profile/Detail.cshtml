@model GMK360.Web.Models.PublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.DisplayName} - Profil";
}

<!-- Hero Section -->
<div class="profile-hero bg-light position-relative" style="height: 250px;">
    <!-- İleride kullanıcının seçtiği bir kapak fotoğrafı eklenebilir -->
    <div class="position-absolute w-100 h-100" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%); opacity: 0.1;"></div>
</div>

<div class="container" style="margin-top: -100px; position: relative; z-index: 10;">
    <div class="row">
        <!-- Sol Kolon: Profil Kartı -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" class="rounded-circle border border-4 border-white shadow-sm" style="width: 150px; height: 150px; object-fit: cover;" alt="@Model.DisplayName">
                    }
                    else
                    {
                        <div class="rounded-circle border border-4 border-white shadow-sm bg-primary text-white d-flex align-items-center justify-content-center mx-auto" style="width: 150px; height: 150px; font-size: 3rem;">
                            @Model.DisplayName.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <h3 class="fw-bold mb-1">
                    @Model.DisplayName
                    @if (Model.IsVerifiedUser)
                    {
                        <i class="ph-fill ph-seal-check text-primary fs-4 align-middle" title="Kimlik Doğrulamalı Kullanıcı"></i>
                    }
                </h3>
                
                @if (!string.IsNullOrEmpty(Model.BusinessName))
                {
                    <p class="text-muted mb-2"><i class="ph ph-buildings me-1"></i> @Model.BusinessName</p>
                }
                
                <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
                    @if (Model.IsCorporateVerified)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                            <i class="ph ph-shield-check me-1"></i> Kurumsal Onaylı
                        </span>
                    }
                    @if (Model.IsEmergencyModeActive)
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                            <i class="ph-fill ph-siren me-1"></i> 7/24 Acil Usta
                        </span>
                    }
                    @if (Model.UserType == GMK360.Core.Entities.Identity.UserType.ServiceProvider)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                            <i class="ph-fill ph-star me-1"></i> @Model.ReliabilityScore Güven Puanı
                        </span>
                    }
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary rounded-pill"><i class="ph ph-chat-circle-text me-2"></i> Mesaj Gönder</button>
                    <!-- Telefon numarası güvenlik gereği tıklayınca veya teklif isteyince gösterilmeli -->
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Detaylar ve İçerik -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Hakkında</h5>
                    <p class="text-muted">@Model.Bio</p>
                </div>
            </div>

            <!-- Tab Navigation -->
            <ul class="nav nav-pills nav-fill bg-white shadow-sm rounded-pill p-1 mb-4" id="profileTabs" role="tablist">
                @if (Model.UserType == GMK360.Core.Entities.Identity.UserType.ServiceProvider)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-medium" id="services-tab" data-bs-toggle="tab" data-bs-target="#services" type="button" role="tab"><i class="ph ph-wrench me-1"></i> Hizmetler</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-medium" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab"><i class="ph ph-star me-1"></i> Yorumlar (@Model.TotalRatings)</button>
                    </li>
                }
                else if (Model.UserType == GMK360.Core.Entities.Identity.UserType.Consultant || Model.UserType == GMK360.Core.Entities.Identity.UserType.Corporate)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-medium" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings" type="button" role="tab"><i class="ph ph-house me-1"></i> Aktif İlanlar</button>
                    </li>
                }
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="profileTabsContent">
                @if (Model.UserType == GMK360.Core.Entities.Identity.UserType.ServiceProvider)
                {
                    <div class="tab-pane fade show active" id="services" role="tabpanel">
                        <div class="row g-3">
                            @if (Model.ProviderServices.Any())
                            {
                                foreach (var service in Model.ProviderServices)
                                {
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light rounded-3 h-100">
                                            <div class="card-body">
                                                <h6 class="fw-bold mb-2">@service.ServiceCategory.Name</h6>
                                                <div class="d-flex justify-content-between align-items-center mt-3">
                                                    <span class="text-primary fw-bold">@service.StartingPrice.ToString("C0")'den başlayan</span>
                                                    <button class="btn btn-sm btn-outline-primary rounded-pill">Teklif İste</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center py-5">
                                    <i class="ph ph-folder-open text-muted fs-1 mb-3"></i>
                                    <p class="text-muted">Henüz hizmet bilgisi eklenmemiş.</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="tab-pane fade" id="reviews" role="tabpanel">
                        <!-- Yorumlar listesi -->
                        <div class="text-center py-5">
                            <h2 class="display-4 fw-bold text-warning mb-0">@Model.AverageRating.ToString("0.0")</h2>
                            <div class="text-warning mb-2 fs-5">
                                @for(int i=1; i<=5; i++)
                                {
                                    if(i <= Math.Round(Model.AverageRating)) { <i class="ph-fill ph-star"></i> }
                                    else { <i class="ph ph-star"></i> }
                                }
                            </div>
                            <p class="text-muted">@Model.TotalRatings değerlendirme</p>
                        </div>
                    </div>
                }
                else if (Model.UserType == GMK360.Core.Entities.Identity.UserType.Consultant || Model.UserType == GMK360.Core.Entities.Identity.UserType.Corporate)
                {
                    <div class="tab-pane fade show active" id="listings" role="tabpanel">
                        <div class="row g-3">
                            @if (Model.ActiveListings.Any())
                            {
                                foreach (var listing in Model.ActiveListings)
                                {
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                                            <img src="/img/placeholder-property.jpg" class="card-img-top" alt="İlan Resmi" style="height: 160px; object-fit: cover;">
                                            <div class="card-body">
                                                <h6 class="card-title fw-bold text-truncate" title="@listing.Title">@listing.Title</h6>
                                                <p class="text-primary fw-bold mb-0">@listing.Price.ToString("C0")</p>
                                            </div>
                                            <div class="card-footer bg-white border-0 pt-0 pb-3">
                                                <a href="/Property/Detail/@listing.Id" class="btn btn-sm btn-light w-100 rounded-pill text-primary fw-medium">İlanı İncele</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center py-5">
                                    <i class="ph ph-house text-muted fs-1 mb-3"></i>
                                    <p class="text-muted">Aktif ilan bulunmamaktadır.</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
