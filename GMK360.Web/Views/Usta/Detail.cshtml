@model GMK360.Core.Entities.ServiceProvider
@{
    var ustaDistrict = Model.Areas?.FirstOrDefault()?.District?.Name ?? "Türkiye";
    ViewData["Title"] = $"{Model.BusinessName} - {ustaDistrict} Ustası";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    string safeDesc = $"{Model.BusinessName}, {ustaDistrict} bölgesinde profesyonel hizmet vermektedir. Yorumlarını okuyun ve hemen teklif alın.";
    ViewData["MetaDescription"] = safeDesc;
    ViewData["MetaKeywords"] = $"{ustaDistrict} usta, {Model.BusinessName}, tadilat, tesisat, boyacı";
}

@section SEO {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "LocalBusiness",
      "name": "@Html.Raw(Model.BusinessName)",
      "description": "@Html.Raw(safeDesc)",
      "url": "@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path",
      "telephone": "@(Model.User?.PhoneNumber ?? "")",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "@Html.Raw(ustaDistrict)",
        "addressRegion": "İstanbul",
        "addressCountry": "TR"
      },
      "aggregateRating": {
        "@@type": "AggregateRating",
        "ratingValue": "@Model.AverageRating.ToString(System.Globalization.CultureInfo.InvariantCulture)",
        "reviewCount": "@(Model.TotalRatings > 0 ? Model.TotalRatings : 1)"
      }
    }
    </script>
}

<div class="container my-5">
    <div class="card shadow-sm border-0 p-4">
        <div class="d-flex align-items-center mb-4">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-4 shadow" style="width: 80px; height: 80px; font-size: 32px; font-weight: bold;">
                @(Model.BusinessName.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h1 class="h2 fw-bold mb-1">
                    @Model.BusinessName
                    @if(Model.IsVerified)
                    {
                        <i class="bi bi-patch-check-fill text-primary ms-1" title="Onaylı Usta"></i>
                    }
                </h1>
                <p class="text-muted mb-0"><i class="bi bi-geo-alt-fill text-danger"></i> @ustaDistrict / İstanbul</p>
                <div class="mt-2">
                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> @Model.AverageRating (@Model.TotalRatings Değerlendirme)</span>
                </div>
            </div>
        </div>

        <hr />

        <div class="row mt-4">
            <div class="col-md-8">
                <h4 class="fw-bold mb-3">Hakkında</h4>
                <p>@safeDesc</p>

                @if(Model.Services != null && Model.Services.Any())
                {
                    <h5 class="fw-bold mt-4 mb-3">Verilen Hizmetler ve Taban Fiyatlar</h5>
                    <ul class="list-group mb-4">
                        @foreach(var svc in Model.Services)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-tools text-muted me-2"></i> @(svc.ServiceCategory?.Name ?? "Hizmet")</span>
                                <span class="badge bg-light text-dark border">@svc.StartingPrice.ToString("C0") 'den başlayan</span>
                            </li>
                        }
                    </ul>
                }
                
                <h4 class="fw-bold mt-5 mb-3">Müşteri Yorumları</h4>
                <div class="alert alert-light border">
                    <i class="bi bi-quote fs-4 text-muted"></i>
                    Henüz yorum yapılmamış. İlk yorumu siz yapın!
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-primary mb-3 shadow-sm">
                    <div class="card-header bg-primary text-white fw-bold text-center">
                        Hızlı Randevu & Teklif İste
                    </div>
                    <div class="card-body">
                        <form id="appointmentForm">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Randevu Tarihi</label>
                                <input type="date" class="form-control" id="appointmentDate" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Sorununuz (Örn: Priz yandı)</label>
                                <textarea class="form-control" rows="2" id="appointmentDesc" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Fotoğraf Yükle <small class="text-muted">(Opsiyonel)</small></label>
                                <input class="form-control form-control-sm" type="file" id="appointmentFile">
                            </div>
                            <button type="button" class="btn btn-primary w-100 fw-bold" onclick="alert('Randevu talebiniz başarıyla alındı! Usta en kısa sürede SMS ile bilgilendirilecek ve onay verecektir.')">
                                <i class="bi bi-calendar-check"></i> Randevu Talep Et
                            </button>
                        </form>
                        <hr />
                        <p class="text-center text-muted mb-2 small">Veya doğrudan arayın:</p>
                        <a href="tel:@Model.User?.PhoneNumber" class="btn btn-outline-success w-100 fw-bold"><i class="bi bi-telephone-fill"></i> @(Model.User?.PhoneNumber ?? "Telefon Gizli")</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
