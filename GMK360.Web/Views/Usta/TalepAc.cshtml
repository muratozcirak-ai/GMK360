@{
    ViewData["Title"] = "Usta, Hizmet veya Malzeme Talebi Aç";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-tools me-2"></i> Ne Arıyorsunuz? Bize Anlatın</h3>
                    <p class="mb-0 mt-2 opacity-75">Talebinizi ister detaylı yazın, ister tek cümleyle özetleyin. Yapay zekamız (Ajan) onu en doğru usta ve tedarikçilerle eşleştirecektir.</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="TalepAc" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">İhtiyacınız Nedir?</label>
                            <input type="text" name="Title" class="form-control form-control-lg bg-light border-0" placeholder="Örn: 10 Kova Beyaz Filli Boya, Çatı İzolasyonu, Beko Kombi Tamiri...">
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Detaylar (İsteğe Bağlı)</label>
                            <textarea name="Description" class="form-control bg-light border-0" rows="5" placeholder="Marka, ölçü veya özel bir isteğiniz varsa doğal dilinizle buraya yazabilirsiniz."></textarea>
                            <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle text-primary"></i> Yapay Zeka destekli sistemimiz yazdıklarınızı anlayıp, marka ve modellere göre tedarikçi havuzundan teklif toplayacaktır.</small>
                        </div>
                        
                        <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold rounded-pill text-dark shadow-sm">
                            Hemen Teklif Topla <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
