@model GMK360.Web.Models.UstaJobCardViewModel
@{
    Layout = null;
    var usta = ViewBag.Usta as GMK360.Web.Models.UstaDashboardViewModel;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resmi Mutabakat Fişi - @Model.JobTitle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1e293b;
        }
        .page {
            width: 210mm;
            min-height: 297mm;
            padding: 20mm;
            margin: 10mm auto;
            background: white;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            position: relative;
        }
        .header-box {
            border-bottom: 2px solid #0f766e;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .shield-box {
            background-color: #fefce8;
            border: 2px solid #facc15;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
            margin-bottom: 25px;
        }
        .signature-box {
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            height: 120px;
            padding: 10px;
            background: #fafafa;
        }
        @@media print {
            body {
                background: white;
                margin: 0;
            }
            .page {
                box-shadow: none;
                margin: 0;
                width: 100%;
                height: 100%;
                padding: 10mm;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- YAZDIR BUTONU (EKRANDA GÖRÜNÜR, YAZDIRILIRKEN GİZLENİR) -->
    <div class="text-center py-3 no-print bg-dark text-white d-flex justify-content-center gap-3 align-items-center">
        <span>Resmî Usta & İşveren / Yönetici Mutabakat Fişi</span>
        <button onclick="window.print()" class="btn btn-warning fw-bold px-4 rounded-pill">
            <i class="bi bi-printer-fill me-1"></i> Sayfayı Yazdır (A4 / PDF)
        </button>
        <button onclick="window.close()" class="btn btn-outline-light rounded-pill px-3">
            Kapat
        </button>
    </div>

    <div class="page">
        <!-- BAŞLIK & LOGO -->
        <div class="header-box d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-success mb-0" style="color: #0f766e !important;">GMK360 &bull; USTA MUTABAKAT PROTOKOLÜ</h3>
                <small class="text-muted text-uppercase tracking-wider">Hizmet Sözleşmesi & Stopaj / Vergi Mutabakat Tutanağı</small>
            </div>
            <div class="text-end">
                <span class="badge bg-dark px-3 py-2 fs-6">Protokol No: GMK-UST-@Model.Id</span>
                <small class="d-block text-muted mt-1">Tarih: @Model.CreatedDate.ToString("dd.MM.yyyy")</small>
            </div>
        </div>

        <!-- TARAFLAR BİLGİSİ -->
        <div class="row g-4 mb-4">
            <!-- Hizmet Veren Usta -->
            <div class="col-6">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <h6 class="fw-bold text-uppercase border-bottom pb-2 mb-2 text-dark">
                        <i class="bi bi-tools text-primary me-1"></i> Hizmet Veren (Usta)
                    </h6>
                    <div class="mb-1"><strong>Adı Soyadı:</strong> @usta?.FullName</div>
                    <div class="mb-1"><strong>Meslek Unvanı:</strong> @usta?.TradeTitle</div>
                    <div class="mb-1"><strong>İletişim Tel:</strong> @usta?.PhoneNumber</div>
                    <div class="mb-1"><strong>Yetki / Belge:</strong> MYK Seviye 4 & MEB Onaylı</div>
                    <div><strong>Bölge:</strong> @usta?.DistrictName, @usta?.NeighborhoodName</div>
                </div>
            </div>

            <!-- Hizmet Alan Müşteri / Apartman Yönetimi -->
            <div class="col-6">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <h6 class="fw-bold text-uppercase border-bottom pb-2 mb-2 text-dark">
                        <i class="bi bi-person-fill text-success me-1"></i> Hizmet Alan (İşveren / Yönetim)
                    </h6>
                    <div class="mb-1"><strong>Müşteri / Yönetici:</strong> @Model.CustomerName</div>
                    <div class="mb-1"><strong>İletişim Tel:</strong> @Model.CustomerPhone</div>
                    <div class="mb-1"><strong>İş Adresi:</strong> @Model.LocationAddress</div>
                    <div><strong>İş Durumu:</strong> @Model.Status</div>
                </div>
            </div>
        </div>

        <!-- YAPILACAK İŞ VE MALİ ŞARTLAR -->
        <h6 class="fw-bold text-uppercase text-dark mb-2">1. İşin Konusu ve Kapsamı</h6>
        <div class="p-3 border rounded-3 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-2">@Model.JobTitle</h5>
            <p class="mb-0 text-muted">@(!string.IsNullOrEmpty(Model.Notes) ? Model.Notes : "Taraflarca mahallinde mutabık kalınan teknik iş ve uygulama.")</p>
        </div>

        <h6 class="fw-bold text-uppercase text-dark mb-2">2. Mali Şartlar ve Ödeme Mutabakatı</h6>
        <table class="table table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th>Hizmet Bedeli Tanımı</th>
                    <th>Malzeme Durumu</th>
                    <th>Ödeme Planı</th>
                    <th class="text-end">Ustanın Net Hakedişi</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold text-dark">@Model.TaxShieldBadgeText</td>
                    <td>@(Model.IsMaterialIncluded ? "Malzeme Fiyata Dahildir" : "Malzeme Hariçtir (Sadece Ustalık)")</td>
                    <td>@Model.PaymentMethod</td>
                    <td class="text-end fw-bold text-success fs-5">@Model.AgreedAmount.ToString("N0") TL</td>
                </tr>
            </tbody>
        </table>

        <!-- 3. YASAL STOPAJ VE VERGİ KALKANI (GVK & KMK UYARINCA) -->
        <div class="shield-box">
            <h6 class="fw-bold text-dark mb-2 d-flex align-items-center">
                <i class="bi bi-shield-shaded text-warning fs-5 me-2"></i>
                3. Resmî Vergi & Stopaj Hükmü (GVK ve KMK Uyarınca Bağlayıcı Şart)
            </h6>
            <p class="small mb-2 text-dark" style="line-height: 1.6;">
                İşbu mutabakat protokolünde kararlaştırılan <strong>@Model.AgreedAmount.ToString("N0") TL</strong> tutar, hizmet veren ustanın <strong>NET ELE GEÇECEK HAKEDİŞİDİR</strong>. 
                193 Sayılı Gelir Vergisi Kanunu (GVK) Md. 9 ve Kat Mülkiyeti Kanunu (KMK) Md. 32 hükümleri uyarınca; 
                apartman yönetimi veya işveren tarafından esnaf muaflığı kapsamında gider pusulası tanzim edilmesi halinde doğabilecek <strong>gelir vergisi stopajı, yasal fonlar ve sair kesintiler münhasıran bina yönetimine / işverene aittir</strong>. 
                Ustanın eline geçecek net tutardan herhangi bir ad altında tevkifat, kesinti veya komisyon düşülemez.
            </p>
            <div class="small text-muted fst-italic">
                Malzeme harcamaları nalbur açık hesabı veya müşteri tarafından müstakilen karşılanır.
            </div>
        </div>

        <!-- İMZA ALANLARI -->
        <div class="row g-4 mt-4 pt-3">
            <div class="col-6">
                <div class="signature-box d-flex flex-column justify-content-between text-center">
                    <span class="small fw-bold text-muted">Hizmet Veren Usta Kaşe / İmza</span>
                    <strong class="text-dark">@usta?.FullName</strong>
                </div>
            </div>
            <div class="col-6">
                <div class="signature-box d-flex flex-column justify-content-between text-center">
                    <span class="small fw-bold text-muted">Hizmet Alan Müşteri / Yönetici İmza</span>
                    <strong class="text-dark">@Model.CustomerName</strong>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 pt-4 border-top text-muted small">
            Bu belge GMK360 Dijital Ekosistemi &bull; Usta İş Masası altyapısı ile oluşturulmuştur.
        </div>
    </div>

</body>
</html>
