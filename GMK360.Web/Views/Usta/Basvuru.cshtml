@{
    ViewData["Title"] = "Tedarikçi ve Usta Başvurusu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-6 mb-5 mb-lg-0">
            <h1 class="display-5 fw-bold text-dark mb-4">Usta mısın?<br/>Tedarikçi misin?<br/><span class="text-warning">Doğru Yerdesin!</span></h1>
            <p class="lead text-muted mb-4">Sisteme bir kere kayıt ol. 50 sayfalık ürün katalogları doldurmana gerek yok! Tekliflere cevap ver, gerisini yapay zekamız halletsin. Hafriyat, yıkım, malzeme tedariği veya ustalık... Tüm iş fırsatları tek ekranda.</p>
            
            <div class="d-flex gap-3 mb-4">
                <div class="bg-light p-3 rounded-3 flex-fill text-center border-start border-4 border-primary shadow-sm">
                    <i class="bi bi-truck fs-1 text-primary mb-2"></i>
                    <h6 class="fw-bold">Ağır Sanayi</h6>
                    <small class="text-muted">Hafriyat & Yıkım</small>
                </div>
                <div class="bg-light p-3 rounded-3 flex-fill text-center border-start border-4 border-warning shadow-sm">
                    <i class="bi bi-box-seam fs-1 text-warning mb-2"></i>
                    <h6 class="fw-bold">Tedarikçi</h6>
                    <small class="text-muted">Malzeme & Marka</small>
                </div>
                <div class="bg-light p-3 rounded-3 flex-fill text-center border-start border-4 border-success shadow-sm">
                    <i class="bi bi-tools fs-1 text-success mb-2"></i>
                    <h6 class="fw-bold">Hizmet</h6>
                    <small class="text-muted">Usta & Taşeron</small>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <h4 class="fw-bold mb-4">Havuza Katılın</h4>
                    <form asp-action="Basvuru" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Firma / Usta Adı</label>
                            <input type="text" class="form-control bg-light border-0" placeholder="İşletmenizin adı">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Faaliyet Alanınız</label>
                            <select class="form-select bg-light border-0">
                                <option>Malzeme Satışı (Nalburiye vb.)</option>
                                <option>Hafriyat & Yıkım & Kepçe</option>
                                <option>İnşaat Taahhüt & Taşeron</option>
                                <option>Bireysel Usta (Boya, Tesisat vb.)</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Telefon Numaranız</label>
                            <input type="tel" class="form-control bg-light border-0" placeholder="05XX XXX XX XX">
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm">
                            Havuza Katıl <i class="bi bi-person-check-fill ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
