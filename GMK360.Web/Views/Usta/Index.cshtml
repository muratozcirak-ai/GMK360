@{
    ViewData["Title"] = "Usta ve Çözüm Ortakları";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Public Layout
}

<!-- Hero Section -->
<div class="bg-primary text-white py-5 mb-5 text-center shadow-sm">
    <div class="container">
        <h1 class="display-4 fw-bold">Bölgenizdeki En İyi Ustaları Bulun</h1>
        <p class="lead">Boya, tesisat, temizlik ve nakliye gibi tüm ev ihtiyaçlarınız için güvenilir çözüm ortaklarımız.</p>
        
        <div class="card p-2 mt-4 mx-auto shadow" style="max-width: 800px;">
            <div class="row g-2">
                <div class="col-md-4">
                    <select class="form-select form-select-lg border-0">
                        <option selected>İl Seçin</option>
                        <option>İstanbul</option>
                        <option>Ankara</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-lg border-0 border-start">
                        <option selected>Hizmet Kategorisi</option>
                        <option>Boya & Badana</option>
                        <option>Elektrik Tesisatı</option>
                        <option>Su Tesisatı</option>
                        <option>Evden Eve Nakliyat</option>
                    </select>
                </div>
                <div class="col-md-4 d-grid">
                    <button class="btn btn-warning btn-lg fw-bold"><i class="bi bi-search"></i> Usta Bul</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h4 class="mb-0">Öne Çıkan Ustalarımız</h4>
        </div>
        <div class="col-auto">
            <span class="text-muted">Toplam 142 usta bulundu</span>
        </div>
    </div>

    <div class="row g-4">
        
        <!-- Örnek Usta Kartı 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="d-flex align-items-center mb-3">
                    <img src="https://via.placeholder.com/64" class="rounded-circle me-3" alt="Usta Profil">
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Hasan Usta (Akboya)</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill text-danger"></i> İstanbul, Kadıköy</p>
                    </div>
                </div>
                <div class="mb-3">
                    <span class="badge bg-primary rounded-pill px-3 py-2 me-1">Boya & Badana</span>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2"><i class="bi bi-star-fill text-warning"></i> 4.8 (24 Yorum)</span>
                </div>
                <p class="card-text text-muted small">Ev ve ofis boya işleriniz temiz ve titizlikle yapılır. Ücretsiz keşif hizmetimiz vardır.</p>
                <div class="mt-auto d-grid">
                    <button class="btn btn-outline-success"><i class="bi bi-telephone-fill"></i> Numarayı Göster</button>
                </div>
            </div>
        </div>

        <!-- Örnek Usta Kartı 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-secondary rounded-circle text-white d-flex align-items-center justify-content-center me-3" style="width: 64px; height: 64px; font-size: 24px;">
                        ET
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Eren Tesisat</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill text-danger"></i> Ankara, Çankaya</p>
                    </div>
                </div>
                <div class="mb-3">
                    <span class="badge bg-info rounded-pill px-3 py-2 me-1 text-white">Su Tesisatı</span>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2"><i class="bi bi-star-fill text-warning"></i> 4.5 (12 Yorum)</span>
                </div>
                <p class="card-text text-muted small">7/24 Acil su kaçağı tespiti, tıkanıklık açma ve petek temizliği hizmetleri.</p>
                <div class="mt-auto d-grid">
                    <button class="btn btn-outline-success"><i class="bi bi-telephone-fill"></i> Numarayı Göster</button>
                </div>
            </div>
        </div>

    </div>
    
    <!-- Daha Fazla Yükle -->
    <div class="text-center mt-5">
        <button class="btn btn-outline-primary px-5 rounded-pill">Daha Fazla Usta Göster</button>
    </div>

</div>
