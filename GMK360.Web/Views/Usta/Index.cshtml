@model GMK360.Web.Models.UstaDashboardViewModel
@{
    ViewData["Title"] = Model.FullName + " - Usta Mobil Masası & İş Kokpiti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --usta-primary: #0f766e;
        --usta-secondary: #0d9488;
        --usta-accent: #f59e0b;
        --usta-dark: #0f172a;
        --usta-light: #f8fafc;
        --whatsapp-green: #25D366;
        --whatsapp-dark: #128C7E;
    }
    
    body {
        background-color: #f1f5f9;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    
    .usta-hero {
        background: linear-gradient(135deg, #042f2e 0%, #0f766e 60%, #134e4a 100%);
        color: white;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 25px -5px rgba(15, 118, 110, 0.3);
    }
    
    .card-modern {
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
        background: #ffffff;
    }
    
    .card-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
    }

    .stat-pill {
        border-radius: 1rem;
        padding: 1.25rem;
        position: relative;
        overflow: hidden;
    }

    .badge-shield {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
        font-weight: 700;
        padding: 0.5rem 0.85rem;
        border-radius: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    
    .badge-freemium {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
        font-weight: 700;
        border-radius: 9999px;
        padding: 0.4rem 0.9rem;
    }

    .btn-whatsapp {
        background-color: var(--whatsapp-green);
        color: white;
        font-weight: 700;
        border-radius: 0.85rem;
        border: none;
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
        transition: all 0.2s;
    }

    .btn-whatsapp:hover {
        background-color: var(--whatsapp-dark);
        color: white;
        transform: translateY(-1px);
    }

    .btn-action-lg {
        padding: 0.85rem 1.5rem;
        font-size: 1.05rem;
        font-weight: 700;
        border-radius: 1rem;
    }

    .nav-pills-usta .nav-link {
        color: #475569;
        font-weight: 700;
        border-radius: 1rem;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s;
    }

    .nav-pills-usta .nav-link.active {
        background: var(--usta-primary);
        color: white;
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.25);
    }

    .table-veresiye tbody tr td {
        vertical-align: middle;
        padding: 1rem 0.75rem;
    }

    @@media (max-width: 768px) {
        .usta-hero {
            border-radius: 0 0 1.25rem 1.25rem;
        }
        .btn-action-lg {
            width: 100%;
        }
    }
</style>

<div class="container-fluid p-0 mb-5">
    
    <!-- ÜST BİLDİRİM MESAJLARI -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- USTA HERO SECTION (PWA & KOKPİT ÜST KART) -->
    <div class="usta-hero pt-4 pb-5 px-3 px-md-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=160&h=160&fit=crop&crop=faces" 
                             alt="@Model.FullName" 
                             class="rounded-circle border border-3 border-warning shadow" 
                             style="width: 82px; height: 82px; object-fit: cover;">
                        @if (Model.IsVerified)
                        {
                            <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm" 
                                  title="MYK & Onaylı Usta" style="width: 26px; height: 26px;">
                                <i class="bi bi-patch-check-fill" style="font-size: 14px;"></i>
                            </span>
                        }
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <h2 class="fw-bold mb-0 text-white">@Model.FullName</h2>
                            <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1">
                                <i class="bi bi-star-fill text-dark me-1"></i> @Model.AverageRating (@Model.TotalReviewsCount Değerlendirme)
                            </span>
                        </div>
                        <p class="text-white-50 mb-1 fs-6">
                            <i class="bi bi-tools text-warning me-1"></i> @Model.TradeTitle 
                            &bull; <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.DistrictName, @Model.NeighborhoodName
                        </p>
                        <div class="d-flex flex-wrap gap-2 pt-1">
                            <span class="badge-freemium">
                                <i class="bi bi-house-check-fill me-1"></i> Kendi Mahallenizde: <strong>%100 ÜCRETSİZ YAYIN</strong> (0 TL Komisyon)
                            </span>
                            @if (Model.IsCityWideSubscriptionActive)
                            {
                                <span class="badge bg-info text-dark fw-bold rounded-pill px-3 py-1">
                                    <i class="bi bi-broadcast me-1"></i> Tüm Şehir & Yan İlçeler Yayında (250 TL/Ay)
                                </span>
                            }
                            else
                            {
                                <form asp-action="ToggleCityWideSubscription" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-bold">
                                        <i class="bi bi-arrow-up-right-circle me-1"></i> Yan İlçelerde Görün (Tek Aidat: 250 TL/ay)
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>

                <!-- Hızlı Aksiyon Butonları -->
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-warning text-dark fw-bold rounded-4 px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#newJobModal">
                        <i class="bi bi-plus-circle-fill me-1"></i> Yeni Fiyat / İş Aç
                    </button>
                    <button class="btn btn-outline-light fw-bold rounded-4 px-3 py-2" data-bs-toggle="modal" data-bs-target="#documentsModal">
                        <i class="bi bi-award-fill me-1"></i> Diplomalarım (@Model.Documents.Count)
                    </button>
                    <a asp-action="AddSampleUsta" class="btn btn-sm btn-outline-warning text-white rounded-4 px-3 py-2" title="Demo Verileri Yenile">
                        <i class="bi bi-arrow-clockwise me-1"></i> Demo Yükle
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ANA İÇERİK KONTEYNERİ -->
    <div class="container" style="margin-top: -1.75rem;">

        <!-- 1. USTANIN NET KÂR PUSULASI (CEBİME KALAN REEL PARA) -->
        <div class="card-modern p-3 p-md-4 mb-4 border border-light">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-compass text-teal me-2" style="color: var(--usta-primary);"></i> Ustanın Net Kâr Pusulası (Cebimdeki Para)
                    </h5>
                    <p class="text-muted small mb-0">İş gelirinizden malzeme, çırak ve yemek masrafları düşülmüş <strong>net elinizde kalan kazanç</strong>.</p>
                </div>
                <div class="mt-2 mt-md-0">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold">
                        <i class="bi bi-calendar3 me-1"></i> Güncel Dönem Analizi
                    </span>
                </div>
            </div>

            <div class="row g-3">
                <!-- Toplam İş Geliri -->
                <div class="col-6 col-lg-3">
                    <div class="stat-pill bg-light border">
                        <small class="text-muted fw-bold text-uppercase d-block mb-1">Toplam İş Geliri</small>
                        <h4 class="fw-bold text-dark mb-0">@Model.TotalAgreedRevenue.ToString("N0") <span class="fs-6">TL</span></h4>
                        <small class="text-success fw-bold"><i class="bi bi-check2"></i> @Model.TotalJobsCount İş Anlaşması</small>
                    </div>
                </div>

                <!-- Nalbur Malzeme Masrafı -->
                <div class="col-6 col-lg-3">
                    <div class="stat-pill bg-light border border-start border-3 border-danger">
                        <small class="text-muted fw-bold text-uppercase d-block mb-1">Nalbur Malzeme Gideri</small>
                        <h4 class="fw-bold text-danger mb-0">-@Model.TotalMaterialExpense.ToString("N0") <span class="fs-6">TL</span></h4>
                        <small class="text-muted"><i class="bi bi-receipt"></i> Açık Hesap / Peşin</small>
                    </div>
                </div>

                <!-- Çırak / Kalfa Yevmiyesi -->
                <div class="col-6 col-lg-3">
                    <div class="stat-pill bg-light border border-start border-3 border-warning">
                        <small class="text-muted fw-bold text-uppercase d-block mb-1">Çırak & Kalfa Yevmiyesi</small>
                        <h4 class="fw-bold text-warning mb-0">-@Model.TotalAssistantExpense.ToString("N0") <span class="fs-6">TL</span></h4>
                        <small class="text-muted"><i class="bi bi-people-fill"></i> @Model.Assistants.Count Yardımcı</small>
                    </div>
                </div>

                <!-- CEBİNE KALAN NET KÂR -->
                <div class="col-6 col-lg-3">
                    <div class="stat-pill text-white" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                        <small class="text-white-50 fw-bold text-uppercase d-block mb-1">Cebine Kalan Net Kâr</small>
                        <h3 class="fw-bold text-white mb-0">+@Model.TotalNetProfit.ToString("N0") <span class="fs-6">TL</span></h3>
                        <small class="text-white fw-bold"><i class="bi bi-graph-up-arrow"></i> % @Model.NetProfitMarginPercent.ToString("N0") Net Kâr Marjı</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. PWA SEKMELERİ -->
        <ul class="nav nav-pills nav-pills-usta mb-4 gap-2" id="ustaTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="jobs-tab" data-bs-toggle="pill" data-bs-target="#jobs-pane" type="button" role="tab">
                    <i class="bi bi-clipboard-check-fill me-1"></i> İş Masam & Stopaj Kalkanı (@Model.Jobs.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="nalbur-tab" data-bs-toggle="pill" data-bs-target="#nalbur-pane" type="button" role="tab">
                    <i class="bi bi-shop me-1"></i> Nalbur Açık Hesap (Cari)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="materials-tab" data-bs-toggle="pill" data-bs-target="#materials-pane" type="button" role="tab">
                    <i class="bi bi-search me-1"></i> Malzeme Fiyat Araştırma
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="assistants-tab" data-bs-toggle="pill" data-bs-target="#assistants-pane" type="button" role="tab">
                    <i class="bi bi-person-badge-fill me-1"></i> Çırak / Kalfa Ekibim (@Model.Assistants.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="portfolio-tab" data-bs-toggle="pill" data-bs-target="#portfolio-pane" type="button" role="tab">
                    <i class="bi bi-images me-1"></i> Referans İşlerim (@Model.Portfolios.Count)
                </button>
            </li>
        </ul>

        <!-- SEKME İÇERİKLERİ -->
        <div class="tab-content" id="ustaTabsContent">

            <!-- 1. SEKME: İŞLERİM & FİYAT MASASI (FATURA / STOPAJ KALKANI) -->
            <div class="tab-pane fade show active" id="jobs-pane" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-briefcase-fill text-primary me-2"></i>Aktif ve Geçmiş İşlerim</h5>
                        <p class="text-muted small mb-0">Teklif verirken stopaj kalkanınızı seçin, tek tıkla WhatsApp onay metnini müşteriye iletin.</p>
                    </div>
                    <button class="btn btn-success fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#newJobModal">
                        <i class="bi bi-plus-lg me-1"></i> Yeni İş Ekle
                    </button>
                </div>

                <div class="row g-3">
                    @foreach (var job in Model.Jobs)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="card-modern p-4 h-100 border-start border-4 @(job.Status == "Devam Ediyor" ? "border-primary" : (job.Status == "Tamamlandı" ? "border-success" : "border-warning"))">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge @(job.Status == "Devam Ediyor" ? "bg-primary" : (job.Status == "Tamamlandı" ? "bg-success" : "bg-warning text-dark")) rounded-pill px-3 py-1 mb-2">
                                            @job.Status
                                        </span>
                                        <h5 class="fw-bold text-dark mb-1">@job.JobTitle</h5>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-person-fill text-secondary me-1"></i> @job.CustomerName 
                                            &bull; <i class="bi bi-telephone-fill text-success me-1"></i> @job.CustomerPhone
                                        </p>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @job.LocationAddress
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">Net Hakediş</small>
                                        <span class="fs-4 fw-bold text-success">@job.AgreedAmount.ToString("N0") TL</span>
                                    </div>
                                </div>

                                <!-- STOPAJ KALKANI ROZETİ (ÇAKAL YÖNETİCİLERE KARŞI) -->
                                <div class="badge-shield mb-3 w-100">
                                    <i class="bi bi-shield-shaded text-warning fs-5"></i>
                                    <div>
                                        <div class="fw-bold text-dark">@job.TaxShieldBadgeText</div>
                                        <div class="text-muted" style="font-size: 0.8rem; font-weight: normal;">@job.TaxShieldDescription</div>
                                    </div>
                                </div>

                                <!-- MALZEME & ÖDEME KOŞULLARI -->
                                <div class="bg-light p-3 rounded-3 mb-3 d-flex flex-wrap justify-content-between gap-2 small">
                                    <div>
                                        <strong class="text-dark">Malzeme:</strong> 
                                        @(job.IsMaterialIncluded ? "Fiyata Dahil" : "Hariç (İşçilik)")
                                    </div>
                                    <div>
                                        <strong class="text-dark">Ödeme:</strong> @job.PaymentMethod
                                    </div>
                                </div>

                                <!-- HARCAMA & NET KÂR DAĞILIMI -->
                                <div class="row g-2 mb-3 text-center small">
                                    <div class="col-4">
                                        <div class="p-2 border rounded-3 bg-white">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Nalbur Malzeme</span>
                                            <strong class="text-danger">@job.MaterialCost.ToString("N0") TL</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 border rounded-3 bg-white">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Çırak Yevmiye</span>
                                            <strong class="text-warning">@job.AssistantCost.ToString("N0") TL</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 border rounded-3" style="background: #ecfdf5;">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">Net Cebine Kalan</span>
                                            <strong class="text-success">@job.NetProfit.ToString("N0") TL</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- AKSİYON BUTONLARI (WHATSAPP, RESMİ FİŞ, MASRAF) -->
                                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                    <!-- WhatsApp Mutabakatı Gönder Butonu -->
                                    <a href="@job.WhatsAppUrl" target="_blank" class="btn btn-whatsapp btn-sm px-3 flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-whatsapp"></i> WhatsApp Onay Metni At
                                    </a>

                                    <!-- A4 Resmi Fiş Yazdır -->
                                    <a asp-action="PrintJobSheet" asp-route-id="@job.Id" target="_blank" class="btn btn-outline-secondary btn-sm px-3" title="Resmi A4 Mutabakat ve İmzalı Fiş">
                                        <i class="bi bi-printer-fill me-1"></i> Fiş Yazdır
                                    </a>

                                    <!-- Masraf Ekle Butonu -->
                                    <button class="btn btn-outline-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#expenseModal-@job.Id">
                                        <i class="bi bi-cash-coin me-1"></i> Masraf Ekle
                                    </button>

                                    <!-- Durum Değiştir -->
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Durum
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li>
                                                <form asp-action="UpdateJobStatus" method="post">
                                                    <input type="hidden" name="jobId" value="@job.Id" />
                                                    <input type="hidden" name="status" value="Devam Ediyor" />
                                                    <button type="submit" class="dropdown-item">Devam Ediyor</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="UpdateJobStatus" method="post">
                                                    <input type="hidden" name="jobId" value="@job.Id" />
                                                    <input type="hidden" name="status" value="Tamamlandı" />
                                                    <button type="submit" class="dropdown-item text-success fw-bold">Tamamlandı</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- MASRAF EKLEME MODAL (HER İŞ İÇİN) -->
                        <div class="modal fade" id="expenseModal-@job.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0">
                                    <div class="modal-header bg-light">
                                        <h5 class="modal-title fw-bold"><i class="bi bi-cash-stack text-primary me-2"></i>Masraf Ekle: @job.JobTitle</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="AddJobExpense" method="post">
                                        <input type="hidden" name="jobId" value="@job.Id" />
                                        <div class="modal-body p-4">
                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted">Masraf Türü</label>
                                                <select name="expenseType" class="form-select form-select-lg rounded-3">
                                                    <option value="Material">Nalbur / Sarf Malzeme</option>
                                                    <option value="Assistant">Çırak / Kalfa Yevmiyesi</option>
                                                    <option value="RoadFood">Yol, Yemek & Benzin</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted">Tutar (TL)</label>
                                                <input type="number" step="any" name="amount" class="form-control form-control-lg rounded-3" placeholder="Örn: 450" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted">Açıklama</label>
                                                <input type="text" name="description" class="form-control rounded-3" placeholder="Örn: 2 top bant ve buat klemensi" />
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light">
                                            <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Masrafı Kaydet</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. SEKME: NALBUR AÇIK HESAP (CARİ DEFTERİ) -->
            <div class="tab-pane fade" id="nalbur-pane" role="tabpanel">
                <div class="row g-4">
                    <!-- Sol: Nalbur Kartı ve Açık Hesap Özeti -->
                    <div class="col-12 col-md-4">
                        <div class="card-modern p-4 text-center border-top border-4 border-warning">
                            <div class="rounded-circle bg-warning-subtle text-warning d-inline-flex p-3 mb-3">
                                <i class="bi bi-shop fs-1"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-1">@Model.NalburAccount.NalburName</h4>
                            <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.NalburAccount.District</p>

                            <div class="bg-light p-3 rounded-4 mb-3 border">
                                <small class="text-muted text-uppercase fw-bold d-block">Nalbura Olan Açık Hesap Borcu</small>
                                <h2 class="fw-bold text-danger mb-0">@Model.NalburAccount.CurrentDebtBalance.ToString("N0") <span class="fs-5">TL</span></h2>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mt-2">
                                    <i class="bi bi-check-circle-fill me-1"></i> @Model.NalburAccount.Status
                                </span>
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-danger fw-bold rounded-pill py-2" data-bs-toggle="modal" data-bs-target="#nalburDebitModal">
                                    <i class="bi bi-cart-plus me-1"></i> Malzeme Çek (+Borç Ekle)
                                </button>
                                <button class="btn btn-success fw-bold rounded-pill py-2" data-bs-toggle="modal" data-bs-target="#nalburPaymentModal">
                                    <i class="bi bi-cash-coin me-1"></i> Nalbura Öde (-Borç Düş)
                                </button>
                                <a href="tel:@Model.NalburAccount.PhoneNumber" class="btn btn-outline-secondary rounded-pill py-2">
                                    <i class="bi bi-telephone-fill me-1"></i> Nalburu Ara (@Model.NalburAccount.ContactPerson)
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Sağ: Açık Hesap Hareket Defteri -->
                    <div class="col-12 col-md-8">
                        <div class="card-modern p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-text text-primary me-2"></i>Açık Hesap (Veresiye) Defterim</h5>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Son @Model.NalburTransactions.Count Hareket</span>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-veresiye mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-muted text-uppercase">
                                            <th>Tarih</th>
                                            <th>İşlem Türü</th>
                                            <th>Açıklama / İlgili İş</th>
                                            <th class="text-end">Tutar</th>
                                            <th class="text-end">Kalan Borç</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var trans in Model.NalburTransactions)
                                        {
                                            <tr>
                                                <td class="small text-muted">@trans.TransactionDate.ToString("dd MMM yyyy")</td>
                                                <td>
                                                    @if (trans.TransactionType.Contains("Malzeme") || trans.TransactionType.Contains("Borç"))
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">
                                                            <i class="bi bi-box-arrow-in-down me-1"></i> Malzeme Çekildi
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                                            <i class="bi bi-wallet2 me-1"></i> Ödeme Yapıldı
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-dark">@trans.Description</div>
                                                    @if (!string.IsNullOrEmpty(trans.RelatedJobTitle))
                                                    {
                                                        <small class="text-primary"><i class="bi bi-link-45deg"></i> @trans.RelatedJobTitle</small>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold @(trans.TransactionType.Contains("Malzeme") ? "text-danger" : "text-success")">
                                                    @(trans.TransactionType.Contains("Malzeme") ? "+" : "-")@trans.Amount.ToString("N0") TL
                                                </td>
                                                <td class="text-end fw-semibold text-muted">
                                                    @trans.BalanceAfter.ToString("N0") TL
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. SEKME: MALZEME FİYAT ARAŞTIRMA KATALOĞU -->
            <div class="tab-pane fade" id="materials-pane" role="tabpanel">
                <div class="card-modern p-4 mb-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">
                                <i class="bi bi-search text-warning me-2"></i> Tedarikçi Malzeme Fiyat Araştırma Konsolu
                            </h5>
                            <p class="text-muted small mb-0">Teklif hazırlamadan önce piyasa ve tedarikçi birim fiyatlarını kontrol edin, zarar etmeyin.</p>
                        </div>
                        <div class="input-group" style="max-width: 350px;">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="materialSearchInput" class="form-control border-start-0" placeholder="Malzeme ara (Örn: Kablo, Boya, Sigorta)..." />
                        </div>
                    </div>

                    <div class="row g-3" id="materialsGrid">
                        @foreach (var mat in Model.MaterialCatalog)
                        {
                            <div class="col-12 col-md-6 col-lg-4 material-card" data-title="@mat.MaterialName.ToLower()" data-cat="@mat.Category.ToLower()">
                                <div class="p-3 border rounded-4 h-100 bg-white shadow-sm d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">@mat.Category</span>
                                            <span class="text-muted small">@mat.Unit</span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-2">@mat.MaterialName</h6>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-shop text-primary me-1"></i> @mat.SupplierName (@mat.Location)
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <div>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">Piyasa Fiyatı</small>
                                            <span class="fs-5 fw-bold text-success">@mat.AveragePrice.ToString("N0") TL</span>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="copyPriceToQuote('@mat.MaterialName', '@mat.AveragePrice')">
                                            <i class="bi bi-plus me-1"></i> Teklife Ekle
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 4. SEKME: ÇIRAK / KALFA EKİBİ (ORGANİK AĞIN BÜYÜMESİ) -->
            <div class="tab-pane fade" id="assistants-pane" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-warning me-2"></i>Çırak & Kalfa Ekibim</h5>
                        <p class="text-muted small mb-0">Yanınızda çalışan yardımcıların yevmiyesini takip edin; sistem onları <strong>Geleceğin Ustası</strong> olarak kaydeder.</p>
                    </div>
                    <button class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#newAssistantModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Yeni Çırak / Kalfa Ekle
                    </button>
                </div>

                <div class="row g-3">
                    @foreach (var ast in Model.Assistants)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card-modern p-4 h-100 border-top border-4 border-warning">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 24px;">
                                        <i class="bi bi-person-badge"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">@ast.FullName</h5>
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@ast.Role</span>
                                    </div>
                                </div>

                                <div class="bg-light p-3 rounded-4 mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Günlük Standart Yevmiye:</span>
                                        <strong class="text-dark">@ast.DailyWage.ToString("N0") TL</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Çalıştığı Toplam Gün:</span>
                                        <strong class="text-dark">@ast.DaysWorkedTotal Gün</strong>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-1">
                                        <span class="text-muted small fw-bold">Toplam Ödenen Yevmiye:</span>
                                        <strong class="text-danger">@ast.TotalWagesPaid.ToString("N0") TL</strong>
                                    </div>
                                </div>

                                <!-- GMK360 ADAY USTA ROZETİ (VİRÜTİK ORGANİK BÜYÜME) -->
                                <div class="badge-freemium mb-3 w-100 text-center" style="font-size: 0.8rem;">
                                    <i class="bi bi-award-fill me-1 text-success"></i> GMK360 Aday Usta Havuzuna Kaydedildi
                                </div>

                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary btn-sm rounded-pill px-3 flex-grow-1" data-bs-toggle="modal" data-bs-target="#wageModal-@ast.Id">
                                        <i class="bi bi-calendar-plus me-1"></i> İşe Yevmiye Yaz
                                    </button>
                                    <a href="tel:@ast.PhoneNumber" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        <i class="bi bi-telephone-fill"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- ÇIRAĞA YEVMİYE YAZMA MODAL -->
                        <div class="modal fade" id="wageModal-@ast.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0">
                                    <div class="modal-header bg-light">
                                        <h5 class="modal-title fw-bold"><i class="bi bi-cash me-2"></i>@ast.FullName İle Çalışılan Günü İşle</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="AddAssistantDailyWage" method="post">
                                        <input type="hidden" name="assistantId" value="@ast.Id" />
                                        <div class="modal-body p-4">
                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted">Hangi İşe Gidildi?</label>
                                                <select name="jobId" class="form-select form-select-lg rounded-3" required>
                                                    @foreach (var j in Model.Jobs)
                                                    {
                                                        <option value="@j.Id">@j.JobTitle (@j.CustomerName)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted">Kaç Gün Çalıştı?</label>
                                                <input type="number" name="daysCount" value="1" min="1" max="30" class="form-control form-control-lg rounded-3" required />
                                            </div>
                                            <div class="p-3 bg-light rounded-3 small">
                                                <i class="bi bi-info-circle text-primary me-1"></i> Günlük yevmiye <strong>@ast.DailyWage.ToString("N0") TL</strong> üzerinden hesaplanacak ve seçtiğiniz işin işçilik masrafına eklenecektir.
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light">
                                            <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Yevmiyeyi İşe İşle</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 5. SEKME: REFERANS İŞLERİM -->
            <div class="tab-pane fade" id="portfolio-pane" role="tabpanel">
                <div class="row g-4">
                    @foreach (var port in Model.Portfolios)
                    {
                        <div class="col-12 col-md-6">
                            <div class="card-modern overflow-hidden">
                                <div class="row g-0">
                                    <div class="col-6">
                                        <div class="position-relative">
                                            <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=300&fit=crop" class="img-fluid w-100" style="height: 180px; object-fit: cover;" alt="Önce">
                                            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2">Öncesi</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="position-relative">
                                            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?w=400&h=300&fit=crop" class="img-fluid w-100" style="height: 180px; object-fit: cover;" alt="Sonra">
                                            <span class="badge bg-success position-absolute top-0 start-0 m-2">Biten İş</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold text-dark mb-0">@port.Title</h6>
                                        <span class="badge bg-light text-dark border small">@port.Location</span>
                                    </div>
                                    <p class="text-muted small mb-2">@port.Description</p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                                        <span class="text-muted"><i class="bi bi-person-check text-success me-1"></i> Referans: @port.ClientReference</span>
                                        <span class="text-success fw-bold"><i class="bi bi-patch-check-fill"></i> Doğrulanmış İş</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ================= MODALLAR ================= -->

<!-- 1. YENİ İŞ / FİYAT TEKLİFİ MODALI (FATURA & STOPAJ KALKANI TİKLİ SEÇENEKLERİ DAHİL) -->
<div class="modal fade" id="newJobModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white p-4">
                <div>
                    <h5 class="modal-title fw-bold text-white mb-0">
                        <i class="bi bi-shield-check text-warning me-2"></i> Yeni İş Aç & Fiyat Teklifi Ver
                    </h5>
                    <small class="text-white-50">Stopaj kalkanını seçin, iş bitiminde çakal yöneticilere karşı haklarınızı koruyun.</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateJobQuote" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-bold small text-muted">Yapılacak İş Başlığı</label>
                            <input type="text" name="jobTitle" class="form-control form-control-lg rounded-3" placeholder="Örn: Orkide Apt. Daire 8 - Ana Pano & Sigorta Yenileme" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold small text-muted">Anlaşılan / Teklif Tutarı (TL)</label>
                            <input type="number" step="any" name="agreedAmount" class="form-control form-control-lg rounded-3 fw-bold text-success" placeholder="Örn: 10000" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-muted">Müşteri / Bina Yöneticisi Adı</label>
                            <input type="text" name="customerName" class="form-control rounded-3" placeholder="Örn: Mehmet Bey (Apartman Yöneticisi)" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-muted">Müşteri Telefon Numarası (WhatsApp İçin)</label>
                            <input type="text" name="customerPhone" class="form-control rounded-3" placeholder="Örn: 0532 555 12 34" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">İş Yeri / Daire Adresi</label>
                            <input type="text" name="locationAddress" class="form-control rounded-3" placeholder="Örn: Kadıköy / Fenerbahçe Mah. Orkide Sok. No: 8" required />
                        </div>

                        <!-- ÖNEMLİ: TİKLİ FATURA VE STOPAJ KALKANI SEÇENEKLERİ -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark d-block mb-2">
                                <i class="bi bi-shield-shaded text-warning me-1"></i> Fatura & Stopaj Kalkanı (Nasıl Anlaşıldı?)
                            </label>
                            
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="taxShield" id="shield1" value="NetAgreed_TaxOnClient" checked>
                                    <label class="form-check-label fw-bold text-dark" for="shield1">
                                        🟢 NET ELE GEÇECEK TUTAR (Tavsiye Edilen - Stopaj & Kesinti Yönetime / Müşteriye Aittir)
                                    </label>
                                    <div class="text-muted small ms-4">
                                        Apartman yönetimi iş bitiminde 'gider pusulası kestik, %10-20 stopaj kestik' diyemez! Yasal vergi işverene aittir, ustanın cebine net anlaşılan tutar girer.
                                    </div>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="taxShield" id="shield2" value="WithholdingByClient">
                                    <label class="form-check-label fw-bold text-dark" for="shield2">
                                        📄 Faturasız / Stopaj Müşteriden (Müşteri Gider Pusulası Keserse Stopajı Kendi Karşılar)
                                    </label>
                                    <div class="text-muted small ms-4">
                                        Yönetim vergi dairesine beyan edecekse stopaj vergisini kendi bütçesinden öder, usta bedelinden kesinti yapılamaz.
                                    </div>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="taxShield" id="shield3" value="InvoiceWithVat">
                                    <label class="form-check-label fw-bold text-dark" for="shield3">
                                        🧾 Faturalı İşlem (+ %20 KDV İlave Edilir)
                                    </label>
                                    <div class="text-muted small ms-4">
                                        Ustanın şahıs/limited şirketi üzerinden resmi e-fatura kesilir.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- MALZEME VE ÖDEME SEÇENEKLERİ -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-muted">Malzeme Durumu</label>
                            <div class="p-3 border rounded-3 bg-white">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="isMaterialIncluded" value="true" id="matIncluded">
                                    <label class="form-check-label fw-bold text-dark" for="matIncluded">
                                        Malzeme Dahildir
                                    </label>
                                    <small class="text-muted d-block">Tik işareti yoksa teklif <strong>'Sadece Ustalık / Malzeme Hariç'</strong> olarak hesaplanır.</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-muted">Ödeme Şekli</label>
                            <select name="paymentMethod" class="form-select rounded-3">
                                <option value="İş Bitimi Peşin / Havale" selected>İş Bitimi Peşin / Havale</option>
                                <option value="%50 Avans + %50 İş Bitimi">%50 Avans + %50 İş Bitimi</option>
                                <option value="Kredi Kartı ile Tek Çekim">Kredi Kartı ile Tek Çekim</option>
                                <option value="Kredi Kartına 2-3 Taksit">Kredi Kartına 2-3 Taksit</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">Notlar / Yapılacaklar Listesi</label>
                            <textarea name="notes" rows="2" class="form-control rounded-3" placeholder="Örn: 4 adet Siemens sigorta takılacak, buatlar yenilenecek..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success fw-bold rounded-pill px-5">
                        <i class="bi bi-whatsapp me-1"></i> İşi Oluştur & WhatsApp Metni Hazırla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. NALBUR BORÇ EKLEME MODAL (MALZEME ÇEKİLDİ) -->
<div class="modal fade" id="nalburDebitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-cart-plus me-2"></i>Nalburdan Malzeme Çek (+Açık Hesap Borcu)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddNalburTransaction" method="post">
                <input type="hidden" name="transactionType" value="Malzeme Çekildi (+Borç)" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Hangi İş İçin Malzeme Çekildi?</label>
                        <select name="relatedJobId" class="form-select rounded-3">
                            <option value="">İşten Bağımsız Genel Stok</option>
                            @foreach (var j in Model.Jobs)
                            {
                                <option value="@j.Id">@j.JobTitle (@j.CustomerName)</option>
                            }
                        </select>
                        <small class="text-muted">Bir iş seçerseniz tutar otomatik olarak o işin malzeme maliyetine yazılır.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Çekilen Malzeme Tutarı (TL)</label>
                        <input type="number" step="any" name="amount" class="form-control form-control-lg rounded-3 fw-bold text-danger" placeholder="Örn: 2400" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Malzeme Detayları</label>
                        <input type="text" name="description" class="form-control rounded-3" placeholder="Örn: 100m 3x2.5 kablo + 4 adet sigorta" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Veresiye Defterine Yaz</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. NALBUR BORÇ ÖDEME MODAL -->
<div class="modal fade" id="nalburPaymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-cash-coin me-2"></i>Nalbura Ödeme Yap (-Borç Düş)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddNalburTransaction" method="post">
                <input type="hidden" name="transactionType" value="Ödeme Yapıldı (-Borç)" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Ödenen Tutar (TL)</label>
                        <input type="number" step="any" name="amount" class="form-control form-control-lg rounded-3 fw-bold text-success" placeholder="Örn: 2000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Açıklama / Dekont Notu</label>
                        <input type="text" name="description" class="form-control rounded-3" value="Müşteriden tahsilat yapıldı, nalbura elden/havale ödendi." required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Ödemeyi Düş</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 4. YENİ ÇIRAK / KALFA MODALI -->
<div class="modal fade" id="newAssistantModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Yeni Çırak / Kalfa Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddAssistant" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Çırak / Kalfa Adı Soyadı</label>
                        <input type="text" name="fullName" class="form-control form-control-lg rounded-3" placeholder="Örn: Murat Can" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Telefon Numarası</label>
                        <input type="text" name="phoneNumber" class="form-control rounded-3" placeholder="Örn: 0544 111 22 33" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Seviye / Uzmanlık</label>
                        <input type="text" name="role" class="form-control rounded-3" placeholder="Örn: Elektrik Kalfası" value="Elektrik Kalfası" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Günlük Standart Yevmiyesi (TL)</label>
                        <input type="number" step="any" name="dailyWage" class="form-control form-control-lg rounded-3 fw-bold text-dark" placeholder="Örn: 1200" value="1200" required />
                    </div>
                    <div class="p-3 bg-light rounded-3 small">
                        <i class="bi bi-shield-check text-success me-1"></i> Bu kişi sisteme kaydedilerek geleceğin onaylı usta adayı havuzuna alınacaktır.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 5. DİPLOMA VE SERTİFİKALAR MODALI -->
<div class="modal fade" id="documentsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-award-fill text-warning me-2"></i>Mesleki Belgelerim & Diplomalarım</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex flex-column gap-3">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="p-3 border rounded-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-dark">@doc.Title</strong>
                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check2"></i> Onaylı</span>
                            </div>
                            <div class="text-muted small">Kurum: @doc.Issuer</div>
                            <div class="text-muted small">Belge No: <code>@doc.DocumentNumber</code> &bull; Yıl: @doc.Year</div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- JAVASCRIPT: CANLI ARAMA VE FİYAT KOPYALAMA -->
@section Scripts {
<script>
    // Malzeme Arama Filtresi
    document.getElementById('materialSearchInput')?.addEventListener('keyup', function() {
        const query = this.value.toLowerCase();
        const cards = document.querySelectorAll('.material-card');
        cards.forEach(card => {
            const title = card.getAttribute('data-title');
            const cat = card.getAttribute('data-cat');
            if (title.includes(query) || cat.includes(query)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    });

    function copyPriceToQuote(name, price) {
        // Yeni iş modalını aç ve açıklamaya ekle
        const modal = new bootstrap.Modal(document.getElementById('newJobModal'));
        modal.show();
        const notes = document.querySelector('textarea[name="notes"]');
        if (notes) {
            notes.value += `\n- ${name} (Birim Fiyat: ${price} TL)`;
        }
    }
</script>
}
