@model IEnumerable<GMK360.Core.Entities.SystemNotificationLog>

@{
    ViewData["Title"] = "Giden Bildirimler (Mock Inbox)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark"><i class="ph ph-envelope-open me-2"></i> Sistem Bildirim Logları (Test)</h3>
        <p class="text-muted mb-0">Son 100 bildirim listelenmektedir.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tarih</th>
                            <th>Tip</th>
                            <th>Alıcı (Telefon / E-posta)</th>
                            <th>Konu / Başlık</th>
                            <th>Mesaj İçeriği</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@log.SentAt.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@log.SentAt.ToString("HH:mm:ss")</small>
                                </td>
                                <td>
                                    @if(log.Type == GMK360.Core.Entities.NotificationType.Sms)
                                    {
                                        <span class="badge bg-primary px-3 py-2"><i class="ph ph-device-mobile"></i> SMS</span>
                                    }
                                    else if(log.Type == GMK360.Core.Entities.NotificationType.Email)
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2"><i class="ph ph-envelope"></i> E-posta</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2"><i class="ph ph-bell"></i> Push</span>
                                    }
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(log.PhoneNumber)) { <div>@log.PhoneNumber</div> }
                                    @if(!string.IsNullOrEmpty(log.EmailAddress)) { <div class="text-muted small">@log.EmailAddress</div> }
                                </td>
                                <td class="fw-bold text-dark">
                                    @log.Subject
                                </td>
                                <td>
                                    <div style="max-width:300px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="@log.MessageBody">
                                        @log.MessageBody
                                    </div>
                                </td>
                                <td>
                                    @if(log.IsDelivered)
                                    {
                                        <span class="text-success"><i class="ph ph-check-circle-fill"></i> Gönderildi</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="ph ph-x-circle-fill"></i> Hata</span>
                                    }
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="ph ph-tray fs-1 d-block mb-3"></i>
                                    Henüz hiç bildirim logu yok.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
