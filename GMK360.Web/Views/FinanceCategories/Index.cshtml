@model IEnumerable<GMK360.Core.Entities.Finance.FinanceCategory>
@{
    ViewData["Title"] = "Finans Kalemleri (Gelir / Gider Tanýmlarý)";
    Layout = "_ConstructionLayout";
}

<div class=""container-fluid px-4 py-5"">
    <div class=""d-flex justify-content-between align-items-center mb-4"">
        <div>
            <h2 class=""fw-bold text-dark mb-0""><i class=""bi bi-tags text-primary me-2""></i>Finans Kalemleri</h2>
            <p class=""text-muted"">Þirketinizin Gelir ve Gider / Alacak ve Borç tanýmlamalarý</p>
        </div>
        <button class=""btn btn-primary rounded-pill px-4"" data-bs-toggle=""modal"" data-bs-target=""#addCategoryModal"">
            <i class=""bi bi-plus-lg me-2""></i>Yeni Kalem Ekle
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class=""alert alert-success rounded-4 border-0 shadow-sm"">
            <i class=""bi bi-check-circle-fill me-2""></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class=""row g-4"">
        <!-- Gelir Kalemleri -->
        <div class=""col-md-6"">
            <div class=""card border-0 shadow-sm rounded-4 h-100"">
                <div class=""card-header bg-success bg-opacity-10 border-0 p-4"">
                    <h5 class=""fw-bold text-success mb-0""><i class=""bi bi-arrow-down-left-circle me-2""></i>Gelir / Tahsilat Kalemleri</h5>
                </div>
                <div class=""card-body p-0"">
                    <ul class=""list-group list-group-flush"">
                        @foreach(var item in Model.Where(m => m.Type == GMK360.Core.Entities.Finance.FinanceCategoryType.Income))
                        {
                            <li class=""list-group-item p-3 d-flex justify-content-between align-items-center"">
                                <div>
                                    <span class=""fw-bold"">@item.Name</span>
                                    @if(!string.IsNullOrEmpty(item.Code)){ <small class=""text-muted ms-2"">(Kod: @item.Code)</small> }
                                </div>
                                <form action=""/FinanceCategories/Delete"" method=""post"" onsubmit=""return confirm('Silmek istediðinize emin misiniz?');"">
                                    <input type=""hidden"" name=""id"" value=""@item.Id"" />
                                    <button type=""submit"" class=""btn btn-sm btn-outline-danger border-0""><i class=""bi bi-trash""></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Gider Kalemleri -->
        <div class=""col-md-6"">
            <div class=""card border-0 shadow-sm rounded-4 h-100"">
                <div class=""card-header bg-danger bg-opacity-10 border-0 p-4"">
                    <h5 class=""fw-bold text-danger mb-0""><i class=""bi bi-arrow-up-right-circle me-2""></i>Gider / Ödeme Kalemleri</h5>
                </div>
                <div class=""card-body p-0"">
                    <ul class=""list-group list-group-flush"">
                        @foreach(var item in Model.Where(m => m.Type == GMK360.Core.Entities.Finance.FinanceCategoryType.Expense))
                        {
                            <li class=""list-group-item p-3 d-flex justify-content-between align-items-center"">
                                <div>
                                    <span class=""fw-bold"">@item.Name</span>
                                    @if(!string.IsNullOrEmpty(item.Code)){ <small class=""text-muted ms-2"">(Kod: @item.Code)</small> }
                                    @if(item.IsDefaultForMaterialReceipt){ <span class=""badge bg-secondary ms-2"">Mal Kabul Varsayýlaný</span> }
                                    @if(item.IsDefaultForSubcontractor){ <span class=""badge bg-secondary ms-2"">Hakediþ Varsayýlaný</span> }
                                </div>
                                <form action=""/FinanceCategories/Delete"" method=""post"" onsubmit=""return confirm('Silmek istediðinize emin misiniz?');"">
                                    <input type=""hidden"" name=""id"" value=""@item.Id"" />
                                    <button type=""submit"" class=""btn btn-sm btn-outline-danger border-0""><i class=""bi bi-trash""></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class=""modal fade"" id=""addCategoryModal"" tabindex=""-1"">
    <div class=""modal-dialog"">
        <div class=""modal-content rounded-4 border-0 shadow"">
            <div class=""modal-header border-0 bg-light rounded-top-4"">
                <h5 class=""modal-title fw-bold"">Yeni Kalem Ekle</h5>
                <button type=""button"" class=""btn-close"" data-bs-dismiss=""modal""></button>
            </div>
            <form action=""/FinanceCategories/Create"" method=""post"">
                <div class=""modal-body"">
                    <div class=""mb-3"">
                        <label class=""form-label fw-bold small"">Tür</label>
                        <select name=""type"" class=""form-select"" required>
                            <option value=""Income"">Gelir / Tahsilat (Örn: Katýlým Payý)</option>
                            <option value=""Expense"">Gider / Borç (Örn: Taþeron Hakediþ)</option>
                        </select>
                    </div>
                    <div class=""mb-3"">
                        <label class=""form-label fw-bold small"">Kalem Adý <span class=""text-danger"">*</span></label>
                        <input type=""text"" name=""name"" class=""form-control"" placeholder=""Örn: Hurda Satýþ Geliri"" required />
                    </div>
                    <div class=""mb-3"">
                        <label class=""form-label fw-bold small"">Muhasebe Kodu (Opsiyonel)</label>
                        <input type=""text"" name=""code"" class=""form-control"" placeholder=""Örn: 600.01"" />
                    </div>
                    
                    <div class=""form-check mb-2 mt-4"">
                        <input class=""form-check-input"" type=""checkbox"" name=""isDefaultForMaterialReceipt"" value=""true"" id=""chk1"">
                        <label class=""form-check-label"" for=""chk1"">
                            Mal Kabul formlarýnda otomatik varsayýlan seçilsin
                        </label>
                    </div>
                    <div class=""form-check"">
                        <input class=""form-check-input"" type=""checkbox"" name=""isDefaultForSubcontractor"" value=""true"" id=""chk2"">
                        <label class=""form-check-label"" for=""chk2"">
                            Taþeron Hakediþlerinde otomatik varsayýlan seçilsin
                        </label>
                    </div>
                </div>
                <div class=""modal-footer border-0"">
                    <button type=""button"" class=""btn btn-light"" data-bs-dismiss=""modal"">Ýptal</button>
                    <button type=""submit"" class=""btn btn-primary"">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

