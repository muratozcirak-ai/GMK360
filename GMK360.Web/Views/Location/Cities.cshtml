@model IEnumerable<GMK360.Core.Entities.City>
@{
    var country = ViewBag.Country as GMK360.Core.Entities.Country;
    ViewData["Title"] = $"{country?.Name} - Şehirler";
}

<div class="container mt-5">
    <h2>@country?.Name Ülkesine Ait Şehirler</h2>
    <hr />

    <form asp-action="AddCity" method="post" class="mb-4">
        <input type="hidden" name="countryId" value="@country?.Id" />
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <input type="text" name="name" class="form-control" placeholder="Şehir Adı" required />
            </div>
            <div class="col-auto">
                <input type="text" name="plateCode" class="form-control" placeholder="Plaka Kodu" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Ekle</button>
                <a href="/Location/Index" class="btn btn-secondary">
                    <i class="ph ph-arrow-left"></i> Ülkelere Dön
                </a>
            </div>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Plaka</th>
                <th>Şehir Adı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var city in Model)
            {
                <tr>
                    <td>@city.PlateCode</td>
                    <td>@city.Name</td>
                    <td>
                        <a asp-action="Districts" asp-route-cityId="@city.Id" class="btn btn-sm btn-info">İlçeleri Gör</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
