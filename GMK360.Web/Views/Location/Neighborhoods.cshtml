@model IEnumerable<GMK360.Core.Entities.Neighborhood>
@{
    var district = ViewBag.District as GMK360.Core.Entities.District;
    ViewData["Title"] = $"{district?.Name} - Mahalleler";
}

<div class="container mt-5">
    <h2>@district?.City?.Name - @district?.Name İlçesine Ait Mahalleler</h2>
    <a asp-action="Districts" asp-route-cityId="@district?.CityId" class="btn btn-secondary mb-3">&larr; İlçelere Dön</a>
    <hr />

    <form asp-action="AddNeighborhood" method="post" class="mb-4">
        <input type="hidden" name="districtId" value="@district?.Id" />
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <input type="text" name="name" class="form-control" placeholder="Mahalle Adı" required />
            </div>
            <div class="col-auto">
                <input type="text" name="zipCode" class="form-control" placeholder="Posta Kodu" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Ekle</button>
            </div>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Posta Kodu</th>
                <th>Mahalle Adı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var neighborhood in Model)
            {
                <tr>
                    <td>@neighborhood.ZipCode</td>
                    <td>@neighborhood.Name</td>
                    <td>
                        <a asp-action="ComplexesAndStreets" asp-route-neighborhoodId="@neighborhood.Id" class="btn btn-sm btn-info">Sokak & Siteleri Gör</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
