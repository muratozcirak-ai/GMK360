@model IEnumerable<GMK360.Core.Entities.District>
@{
    var city = ViewBag.City as GMK360.Core.Entities.City;
    ViewData["Title"] = $"{city?.Name} - İlçeler";
}

<div class="container mt-5">
    <h2>@city?.Name Şehrine Ait İlçeler</h2>
    <a asp-action="Index" class="btn btn-secondary mb-3">&larr; Şehirlere Dön</a>
    <hr />

    <form asp-action="AddDistrict" method="post" class="mb-4">
        <input type="hidden" name="cityId" value="@city?.Id" />
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <input type="text" name="name" class="form-control" placeholder="İlçe Adı" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Ekle</button>
            </div>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>İlçe Adı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var district in Model)
            {
                <tr>
                    <td>@district.Name</td>
                    <td>
                        <a asp-action="Neighborhoods" asp-route-districtId="@district.Id" class="btn btn-sm btn-info">Mahalleleri Gör</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
