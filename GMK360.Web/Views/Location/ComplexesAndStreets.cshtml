@model IEnumerable<GMK360.Core.Entities.Street>
@{
    var neighborhood = ViewBag.Neighborhood as GMK360.Core.Entities.Neighborhood;
    var complexes = ViewBag.Complexes as IEnumerable<GMK360.Core.Entities.Complex>;
    ViewData["Title"] = $"{neighborhood?.Name} - Sokak ve Siteler";
}

<div class="container mt-5">
    <h2>@neighborhood?.District?.City?.Name - @neighborhood?.District?.Name - @neighborhood?.Name</h2>
    <a asp-action="Neighborhoods" asp-route-districtId="@neighborhood?.DistrictId" class="btn btn-secondary mb-3">&larr; Mahallelere Dön</a>
    <hr />

    <div class="row">
        <!-- Sokaklar -->
        <div class="col-md-6 border-end">
            <h4>Sokaklar</h4>
            <form asp-action="AddStreet" method="post" class="mb-3">
                <input type="hidden" name="neighborhoodId" value="@neighborhood?.Id" />
                <div class="input-group">
                    <input type="text" name="name" class="form-control" placeholder="Sokak Adı" required />
                    <button type="submit" class="btn btn-primary">Ekle</button>
                </div>
            </form>
            <ul class="list-group">
                @foreach (var street in Model)
                {
                    <li class="list-group-item">@street.Name</li>
                }
            </ul>
        </div>

        <!-- Siteler -->
        <div class="col-md-6">
            <h4>Siteler / Projeler</h4>
            <form asp-action="AddComplex" method="post" class="mb-3">
                <input type="hidden" name="neighborhoodId" value="@neighborhood?.Id" />
                <div class="input-group">
                    <input type="text" name="name" class="form-control" placeholder="Site Adı" required />
                    <button type="submit" class="btn btn-primary">Ekle</button>
                </div>
            </form>
            <ul class="list-group">
                @if (complexes != null)
                {
                    foreach (var complex in complexes)
                    {
                        <li class="list-group-item">@complex.Name</li>
                    }
                }
            </ul>
        </div>
    </div>
</div>
