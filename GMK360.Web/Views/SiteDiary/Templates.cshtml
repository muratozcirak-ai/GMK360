@{
    ViewData["Title"] = "Þablon ve Kural Motoru (Fabrika Ayarlarý)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark">
            <i class="fas fa-cogs text-secondary me-2"></i> Fabrika Ayarlarý (Þablonlar)
        </h3>
        <a href="/SiteDiary" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-1"></i> Ýcraat Ekranýna Dön
        </a>
    </div>

    <div class="alert alert-info border-0 shadow-sm">
        <i class="fas fa-info-circle me-2"></i> 
        <strong>Kural 1: Hardcode Yasak!</strong> Sistemdeki tüm iþ kurallarý, zaman ofsetleri (T- / T+) ve checklist maddeleri buradan tanýmlanýr.
    </div>

    <div class="row">
        <!-- 1. ANA ÝÞ PAKETLERÝ -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fas fa-cubes me-2"></i> Ana Ýþ Paketleri</h6>
                </div>
                <div class="card-body">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Yeni Ýþ Paketi (Örn: Kat Betonu)" />
                        <button class="btn btn-success"><i class="fas fa-plus"></i> Ekle</button>
                    </div>
                    
                    <div class="list-group">
                        <button class="list-group-item list-group-item-action active d-flex justify-content-between align-items-center">
                            Kat Betonu Dökülmesi
                            <span class="badge bg-light text-dark rounded-pill">2 Kural</span>
                        </button>
                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Dýþ Cephe Ýskelesi Kurulumu
                            <span class="badge bg-secondary rounded-pill">0 Kural</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. AKSÝYONLAR VE OFSETLER -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i> Tetiklenen Aksiyonlar (T-/T+)</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Seçili paket: <strong>Kat Betonu Dökülmesi</strong></p>
                    <form class="mb-3 bg-light p-3 rounded">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Görev Tanýmý</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Örn: Beton randevusu al" />
                        </div>
                        <div class="row mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold">Zaman Ofseti</label>
                                <input type="number" class="form-control form-control-sm" placeholder="Örn: -2" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Hedef Rol</label>
                                <input type="text" class="form-control form-control-sm" placeholder="Örn: Satýn Alma" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary w-100"><i class="fas fa-plus"></i> Aksiyon Ekle</button>
                    </form>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item small px-0">
                            <i class="fas fa-arrow-right text-primary me-2"></i> <strong>T-2:</strong> Beton santralinden randevu al <span class="text-muted">(Satýn Alma)</span>
                        </li>
                        <li class="list-group-item small px-0">
                            <i class="fas fa-arrow-right text-primary me-2"></i> <strong>T+7:</strong> 7 günlük numune kýrým raporunu al <span class="text-muted">(Þef)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- 3. PASÝF KONTROLLER (CHECKLIST) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="fas fa-check-square me-2"></i> Pasif Kontroller (Checklist)</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Seçili paket: <strong>Kat Betonu Dökülmesi</strong></p>
                    <form class="mb-3 bg-light p-3 rounded">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Kontrol Maddesi</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Örn: Paspaylarý kontrol edildi mi?" />
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="fotoCheck">
                            <label class="form-check-label small" for="fotoCheck">Fotoðraf Zorunlu</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="engelCheck">
                            <label class="form-check-label small text-danger" for="engelCheck">Ýþe Engel (Bloke eder)</label>
                        </div>
                        <button type="button" class="btn btn-sm btn-warning w-100"><i class="fas fa-plus"></i> Madde Ekle</button>
                    </form>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item small px-0 d-flex justify-content-between">
                            <span><i class="far fa-square me-2"></i> Paspaylarý kondu mu?</span>
                            <span class="badge bg-danger rounded-pill" title="Ýþe Engel"><i class="fas fa-ban"></i></span>
                        </li>
                        <li class="list-group-item small px-0 d-flex justify-content-between">
                            <span><i class="far fa-square me-2"></i> Kalýp yaðý sürüldü mü?</span>
                            <span class="badge bg-info rounded-pill" title="Fotoðraf Zorunlu"><i class="fas fa-camera"></i></span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

