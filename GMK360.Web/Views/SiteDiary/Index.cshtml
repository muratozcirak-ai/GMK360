@{
    ViewData["Title"] = "Þantiye Yönetim Hafýzasý";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary">
            <i class="fas fa-memory me-2"></i> Þantiye Yönetim Hafýzasý
        </h3>
        <a href="/SiteDiary/Templates" class="btn btn-outline-secondary">
            <i class="fas fa-cog me-1"></i> Kural & Þablon Motoru
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-dark"><i class="fas fa-calendar-day text-primary me-2"></i> Bugünün Saha Görevleri</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Tarihi gelmiþ aktif aksiyonlar ve atanan personeller burada listelenecek.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-dark"><i class="fas fa-camera text-warning me-2"></i> Onay Bekleyen Fotoðraflar</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Taþeron veya alt ekiplerin yüklediði pasif kontroller (Checklist) onayý.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-dark"><i class="fas fa-bolt text-danger me-2"></i> Yaklaþan Sinyaller (T-Ofset)</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">T-3, T-2 gibi sistemin arkadan tetiklediði hatýrlatma sinyalleri.</p>
                </div>
            </div>
        </div>
    </div>
</div>
