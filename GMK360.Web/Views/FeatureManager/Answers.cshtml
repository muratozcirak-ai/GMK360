@model IEnumerable<GMK360.Core.Entities.DefinitionValue>
@{
    var question = ViewBag.Question as GMK360.Core.Entities.DefinitionCategory;
    var group = question?.ParentCategory;
    ViewData["Title"] = $"{question?.Name} Şıkları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a asp-action="Questions" asp-route-groupId="@group?.Id" class="btn btn-sm btn-link text-muted px-0 mb-2">
        <i class="ph ph-arrow-left"></i> @group?.Name Sorularına Dön
    </a>
    <h4 class="mb-1">
        <i class="ph ph-question text-info me-2"></i> @question?.Name
        <span class="text-muted fw-normal">/ Cevap Şıkları</span>
    </h4>
    <p class="text-muted">Bu soruya verilebilecek cevapları (şıkları) ekleyin.</p>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h6 class="mb-3 text-primary"><i class="ph ph-list-numbers"></i> Yeni Şık Ekle</h6>
        <form asp-action="AddAnswer" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="questionId" value="@question?.Id" />
            
            <div class="col-md-5">
                <label class="form-label fw-bold">Şık Adı</label>
                <input type="text" name="name" class="form-control" placeholder="Örn: Yok, 1 Adet, Ebeveyn Banyosu" required />
            </div>
            
            <div class="col-md-2">
                <label class="form-label fw-bold">Sıra No</label>
                <input type="number" name="order" class="form-control" value="1" required />
            </div>

            <div class="col-md-3">
                <div class="form-check form-switch mt-4 pt-1">
                    <input class="form-check-input" type="checkbox" name="requiresTextInput" id="requiresTextInput" value="true">
                    <label class="form-check-label fw-bold" for="requiresTextInput">Metin Kutusu Açılsın</label>
                    <small class="d-block text-muted" style="font-size: 0.75rem;">Seçilirse yanına not yazılabilir.</small>
                </div>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Şık Ekle</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3" style="width: 80px;">Sıra</th>
                        <th class="py-3">Şık / Cevap</th>
                        <th class="py-3">Metin Kutusu (Özel Not)</th>
                        <th class="px-4 py-3 text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 text-muted fw-bold">
                                #@item.Order
                            </td>
                            <td class="fw-bold">
                                @if(question.IsMultiSelect) {
                                    <i class="ph ph-square text-muted me-2"></i> 
                                } else {
                                    <i class="ph ph-circle text-muted me-2"></i> 
                                }
                                @item.Name
                            </td>
                            <td>
                                @if(item.RequiresTextInput) {
                                    <span class="badge bg-warning bg-opacity-10 text-warning"><i class="ph ph-textbox"></i> Evet, Metin İstenecek</span>
                                } else {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                <form asp-action="DeleteAnswer" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="questionId" value="@question.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="ph ph-trash"></i> Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="ph ph-list-dashes d-block mb-2" style="font-size: 32px;"></i>
                                Bu soruya henüz şık eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
