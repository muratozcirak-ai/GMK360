@model IEnumerable<GMK360.Core.Entities.DefinitionCategory>
@{
    ViewData["Title"] = "Özellik Grupları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1"><i class="ph ph-folder-open text-primary"></i> İlan Özellik Grupları</h4>
        <p class="text-muted mb-0">İlan detaylarında gösterilecek özellik gruplarını yönetin (Örn: İç Özellikler, Dış Özellikler).</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h6 class="mb-3 text-primary"><i class="ph ph-plus-circle"></i> Yeni Grup Ekle</h6>
        <form asp-action="AddGroup" method="post" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold">Grup Adı</label>
                <input type="text" name="name" class="form-control" placeholder="Örn: İç Özellikler" required />
            </div>
            <div class="col-md-5">
                <label class="form-label fw-bold">Sistem Kodu (İsteğe Bağlı)</label>
                <input type="text" name="systemCode" class="form-control" placeholder="Otomatik oluşturulur" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Ekle</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">Grup Adı</th>
                        <th class="py-3">Sistem Kodu</th>
                        <th class="px-4 py-3 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 fw-bold">
                                <i class="ph ph-folder text-warning me-2"></i> @item.Name
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">@item.SystemCode</span>
                            </td>
                            <td class="px-4 text-end">
                                <a asp-action="Questions" asp-route-groupId="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="ph ph-list-dashes"></i> Soruları (Özellikleri) Yönet
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="ph ph-folder-open d-block mb-2" style="font-size: 32px;"></i>
                                Henüz grup eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
