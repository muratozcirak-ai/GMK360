@{
    ViewData["Title"] = "Ýletiþim";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center mb-5">
            <h1 class="fw-bold text-navy">Bize Ulaþýn</h1>
            <p class="text-muted lead">Soru, görüþ ve önerileriniz için aþaðýdaki formu doldurarak veya iletiþim bilgilerimizden bize ulaþabilirsiniz.</p>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-light">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4">Ýletiþim Bilgileri</h4>
                    
                    <div class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="ph ph-map-pin fs-4"></i>
                            </div>
                        </div>
                        <div class="ms-3">
                            <h6 class="fw-bold mb-1">Adres</h6>
                            <p class="text-muted mb-0">Türkiye</p>
                        </div>
                    </div>
                    
                    <div class="d-flex mb-4">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="ph ph-envelope-simple fs-4"></i>
                            </div>
                        </div>
                        <div class="ms-3">
                            <h6 class="fw-bold mb-1">E-Posta</h6>
                            <p class="text-muted mb-0">info@gmk360.com</p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="ph ph-phone fs-4"></i>
                            </div>
                        </div>
                        <div class="ms-3">
                            <h6 class="fw-bold mb-1">Telefon</h6>
                            <p class="text-muted mb-0">+90 850 XXX XX XX</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                            <i class="ph ph-check-circle fs-4 me-2"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="ph ph-warning-circle fs-4 me-2"></i>
                            <div>@TempData["ErrorMessage"]</div>
                        </div>
                    }

                    <form asp-controller="Contact" asp-action="Send" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Adýnýz Soyadýnýz <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control form-control-lg bg-light border-0" required placeholder="Ad Soyad">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">E-Posta Adresiniz <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control form-control-lg bg-light border-0" required placeholder="ornek@mail.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Telefon Numaranýz</label>
                                <input type="tel" name="phone" class="form-control form-control-lg bg-light border-0" placeholder="05XX XXX XX XX">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Konu</label>
                                <input type="text" name="subject" class="form-control form-control-lg bg-light border-0" placeholder="Hangi konuda yazýyorsunuz?">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Mesajýnýz <span class="text-danger">*</span></label>
                                <textarea name="message" class="form-control form-control-lg bg-light border-0" rows="5" required placeholder="Mesajýnýzý buraya yazýn..."></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill">
                                    <i class="ph ph-paper-plane-tilt me-2"></i> Mesajý Gönder
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
