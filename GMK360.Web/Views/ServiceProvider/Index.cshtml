@{
    ViewData["Title"] = "GMK360 - Usta & Hizmet Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-2 px-md-4 bg-light min-vh-100">
    <div class="d-flex flex-column justify-content-center align-items-center text-center mt-5" style="min-height: 50vh;">
        <i class="ph ph-wrench text-muted opacity-25" style="font-size: 8rem;"></i>
        <h2 class="fw-bold mt-4 text-dark">Hizmet Sağlayıcı Profiliniz Yok</h2>
        <p class="text-muted w-50">Henüz GMK360 platformunda bir usta veya hizmet sağlayıcı (temizlik, nakliye vb.) profili oluşturmadınız. Profilinizi oluşturarak bölgenizdeki iş fırsatlarına anında teklif verin.</p>
        <button class="btn btn-primary btn-lg rounded-pill px-5 mt-3 shadow-sm">
            <i class="ph ph-user-circle-plus me-2"></i>Hizmet Profili Oluştur
        </button>
    </div>
</div>
