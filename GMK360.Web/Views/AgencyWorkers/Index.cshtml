@model IEnumerable<GMK360.Core.Entities.Construction.AgencyWorker>
@{
    ViewData["Title"] = "Mavi Yaka / Şantiye Personeli";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Mavi Yaka Personel Listesi</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWorkerModal">
            <i class="bi bi-person-plus"></i> Yeni Personel/Usta Ekle
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">Ad Soyad</th>
                            <th class="border-0">Uzmanlık / Rol</th>
                            <th class="border-0">Günlük Yevmiye</th>
                            <th class="border-0">Sistem (PRO) Kaydı</th>
                            <th class="border-0">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var worker in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-primary text-white rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                            @worker.FirstName.Substring(0, 1)@worker.LastName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@worker.FullName</h6>
                                            <small class="text-muted">@worker.PhoneNumber</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="text-dark fw-medium">@worker.Profession</span></td>
                                <td>@worker.DefaultDailyWage.ToString("C2")</td>
                                <td>
                                    @if (worker.UserId != null)
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Ana Sisteme Bağlı</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="bi bi-exclamation-triangle-fill"></i> Sadece Yerel Kayıt</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary">Düzenle</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Ekleme Modalı -->
<div class="modal fade" id="addWorkerModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Şantiye Personeli Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i> Eklenen personel aynı zamanda global sisteme davet edilerek PRO ağına dahil edilecektir.
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Ad</label>
                        <input type="text" name="firstName" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Soyad</label>
                        <input type="text" name="lastName" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Telefon Numarası</label>
                        <input type="text" name="phoneNumber" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Uzmanlık (Demirci vb.)</label>
                        <input type="text" name="profession" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Günlük Yevmiye Ücreti</label>
                        <input type="number" step="0.01" name="dailyWage" class="form-control" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="btn btn-primary">Kaydet ve PRO'ya Bağla</button>
            </div>
        </form>
    </div>
</div>