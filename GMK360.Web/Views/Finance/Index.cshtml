@{
    ViewData["Title"] = "Finans & Cari Yönetimi";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid mt-4">
    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-cash-coin text-success me-2"></i> Finans & Cari Yönetimi</h3>
            <p class="text-muted mb-0 small">Nakit akışı, cari hesaplar, hakedişler ve şirket giderlerinin genel yönetim merkezi.</p>
        </div>
    </div>

    <!-- Üst Başlıklar ve Modül Linkleri (Yanyana) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
            <a href="/SupplierCurrentAccount/Index" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-shop"></i> Tedarikçi (Açık Hesap)
            </a>
            <a href="/SubcontractorContract/Index" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-file-earmark-ruled"></i> Taşeron Hakedişleri
            </a>
            <a href="/Timesheet/PendingAdvances" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-cash-stack"></i> Personel Maaş & Avans
            </a>
            <a href="/Finance/Cashflow" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-wallet2"></i> Ortak Kasa
            </a>
            <a href="/Finance/UpcomingPayments" class="btn btn-outline-warning text-dark rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-calendar-event"></i> Vadesi Yaklaşanlar
            </a>
            <a href="/ConstructionProjectExpenses/Index" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-receipt"></i> Şirket Genel Giderleri
            </a>
        </div>
    </div>

    <!-- Boş Çalışma Alanı (Master Page Alanı) -->
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted" style="min-height: 400px; background-color: #fafbfc; border: 2px dashed #cbd5e1 !important;">
        <div class="my-auto">
            <i class="bi bi-wallet2 fs-1 text-secondary opacity-50 mb-3 d-block"></i>
            <h5 class="fw-bold text-secondary">Finans & Cari Çalışma Alanı</h5>
            <p class="small text-muted mb-0">Yukarıdaki başlıklardan işlem yapmak istediğiniz finans modülünü seçebilirsiniz.</p>
        </div>
    </div>
</div>
