@{
    ViewData["Title"] = "Şirket Genel Giderleri (Projeden Bağımsız)";
    Layout = "_ConstructionLayout";

    int vehicleCount = ViewBag.VehicleCount != null ? (int)ViewBag.VehicleCount : 0;
    decimal totalFleetExpense = ViewBag.TotalFleetExpense != null ? (decimal)ViewBag.TotalFleetExpense : 0m;
    int rentalCount = ViewBag.RentalCount != null ? (int)ViewBag.RentalCount : 0;
    decimal totalRentalExpense = ViewBag.TotalRentalExpense != null ? (decimal)ViewBag.TotalRentalExpense : 0m;
}

<div class="container-fluid mt-3 pb-4">
    <!-- Üst Başlık ve Geri Dönüş -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-building-gear text-primary me-2"></i>Şirket Genel Giderleri & Merkez Masrafları
            </h4>
            <p class="text-muted mb-0 small">
                Herhangi bir şantiyeye/projeye bağlı olmayan şirket merkez giderleri, sabit faturalar, vergi/SGK ve araç filosu harcamaları.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Finance/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Proje Finans & Çıkış Radarına Dön
            </a>
        </div>
    </div>

    <!-- 1. BÖLÜM: ŞİRKET GARAJI ÖZMAL & KİRALIK ARAÇ/MAKİNE GİDER ÖZETİ (CANLI BAĞLANTI) -->
    <div class="card border border-light-subtle shadow-xs rounded-3 mb-3 bg-white">
        <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-warning bg-opacity-15 text-dark rounded-circle p-2.5 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                    <i class="bi bi-truck-flatbed fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Şirket Garajı, Özmal Araç & Kiralık Makine Giderleri</h6>
                    <span class="text-muted small">Garaj modülünde işlenen bakım, yakıt, sigorta ve günlük/saatlik kiralık makine (Vinç, JCB, Forklift) toplamları:</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="border rounded-3 px-3 py-1.5 bg-light">
                    <span class="text-muted d-block" style="font-size: 0.70rem;">ÖZMAL ARAÇ MASRAFI (@vehicleCount Araç)</span>
                    <strong class="text-danger font-monospace fs-6">@totalFleetExpense.ToString("N2") ₺</strong>
                </div>
                <div class="border border-warning rounded-3 px-3 py-1.5 bg-warning bg-opacity-10">
                    <span class="text-dark d-block" style="font-size: 0.70rem;">KİRALIK MAKİNE (@rentalCount İşlem)</span>
                    <strong class="text-dark font-monospace fs-6">@totalRentalExpense.ToString("N2") ₺</strong>
                </div>
                <a href="/CompanyGarage/Index" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold">
                    Garaj & Makine Detayına Git <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- 2. BÖLÜM: PROJEDEN BAĞIMSIZ ŞİRKET GENEL GİDERLERİ (TASARIM AŞAMASINDA) -->
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center" style="min-height: 360px; background-color: #fafbfc; border: 2px dashed #cbd5e1 !important;">
        <div class="my-auto">
            <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5 fw-bold mb-3 shadow-xs">
                <i class="bi bi-tools me-1"></i> 🚧 TASARIM AŞAMASINDA
            </span>
            <h4 class="fw-bold text-dark mb-2">Şirket Merkez & Genel Giderler Masası</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 620px; font-size: 0.90rem;">
                Şantiye finanstaki yapı netleştikten sonra, projelere bağlı olmayan <strong>Merkez Ofis ve Şirket Genel Giderleri</strong> bu ekranda devreye alınacaktır.
            </p>

            <!-- Planlanan Alt Başlık Kutuları -->
            <div class="row g-3 justify-content-center text-start mx-auto" style="max-width: 880px;">
                <div class="col-md-3 col-6">
                    <div class="card border border-light-subtle rounded-3 p-3 bg-white h-100 shadow-xs">
                        <div class="fw-bold text-dark small mb-1"><i class="bi bi-building text-primary me-1"></i>1. Merkez Ofis & Kira</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Ofis kirası, elektrik, su, internet, mutfak ve idari sarf giderleri.</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border border-light-subtle rounded-3 p-3 bg-white h-100 shadow-xs">
                        <div class="fw-bold text-dark small mb-1"><i class="bi bi-bank text-danger me-1"></i>2. Vergi, SGK & Resmi</div>
                        <div class="text-muted" style="font-size: 0.75rem;">KDV, Kurumlar Vergisi, SGK primleri, mali müşavir ve noter ödemeleri.</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border border-light-subtle rounded-3 p-3 bg-white h-100 shadow-xs">
                        <div class="fw-bold text-dark small mb-1"><i class="bi bi-people text-success me-1"></i>3. Merkez Personel</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Merkez ofis kadrosu maaş, avans ve yemek/yol ödemeleri.</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card border border-light-subtle rounded-3 p-3 bg-white h-100 shadow-xs">
                        <div class="fw-bold text-dark small mb-1"><i class="bi bi-wallet2 text-warning me-1"></i>4. Ortak Kasa & Cari</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Ortakların merkez kasaya giriş/çıkışları ve açık hesap mahsuplaşmaları.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
