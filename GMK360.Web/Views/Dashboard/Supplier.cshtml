@{
    ViewData["Title"] = "Esnaf ve Tedarikçi Özeti";
    Layout = "~/Views/Shared/_SupplierLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Demirci Yapı Market</h2>
        <p class="text-muted">Son giriş: Bugün 10:20 - Mağazanız açık ve sipariş almaya hazır.</p>
    </div>
    <div>
        <button class="btn btn-primary rounded-pill fw-bold"><i class="bi bi-box-arrow-up me-1"></i> Yeni Ürün Ekle</button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Bekleyen Siparişler</h6>
                    <i class="bi bi-box-seam fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">12</h2>
                <small class="opacity-75">Şantiyelere gönderilecekler</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Aylık Ciro</h6>
                    <i class="bi bi-graph-up-arrow fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">₺145K</h2>
                <small class="opacity-75">Bu ayki toplam satış</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-info text-dark border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Aktif Teklifler</h6>
                    <i class="bi bi-file-earmark-text fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">8</h2>
                <small class="opacity-75">Şantiyelerin dönüşü bekleniyor</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-warning text-dark border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Stoktaki Ürün</h6>
                    <i class="bi bi-tags fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">450</h2>
                <small class="opacity-75">Toplam sergilenen ürün çeşidi</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold"><i class="bi bi-exclamation-circle text-danger me-2"></i> Malzeme İhtiyaç Talepleri (İhale/Teklif)</h5>
        <a href="/Crm/Talepler?context=supplier" class="btn btn-sm btn-outline-secondary rounded-pill">Tüm Talepleri Gör</a>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-4">Sistemdeki şantiyelerden ve ustalardan gelen toptan alım taleplerine fiyat teklifi verin.</p>
        
        <div class="list-group">
            <div class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1 fw-bold">Kaba İnşaat Malzemesi (10 Ton Çimento, 5 Ton Demir)</h6>
                    <small class="text-muted"><i class="bi bi-building"></i> Güneşli Plaza Şantiyesi | Teslimat: 3 Gün İçinde</small>
                </div>
                <button class="btn btn-sm btn-primary rounded-pill">Fiyat Ver (Teklif Gönder)</button>
            </div>
            <div class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center bg-light">
                <div>
                    <h6 class="mb-1 fw-bold text-muted">Boya Malzemesi (15 Kova Silikonlu İç Cephe)</h6>
                    <small class="text-muted"><i class="bi bi-person"></i> Ahmet Usta | Teslimat: Haftaya</small>
                </div>
                <span class="badge bg-success rounded-pill px-3 py-2">Teklifiniz Onaylandı (Sipariş)</span>
            </div>
        </div>
    </div>
</div>
