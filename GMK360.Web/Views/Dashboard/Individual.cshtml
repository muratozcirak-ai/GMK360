@{
    ViewData["Title"] = "Bireysel Kullanıcı Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #11998e, #38ef7d); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Hoş Geldiniz, [Kullanıcı Adı]
            </h2>
            <p class="text-muted">Buradan favori ilanlarınızı görebilir, yeni aramalar oluşturabilir veya kendi evinizi (Sahibinden) satabilirsiniz.</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Property/Create" class="btn btn-primary rounded-pill shadow-sm px-4">
                <i class="bi bi-plus-lg me-2"></i> Ücretsiz İlan Ver (EİDS)
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Favori İlanlarım</h6>
                            <h2 class="fw-bold mb-0">12</h2>
                        </div>
                        <div class="bg-white p-3 rounded-circle shadow-sm">
                            <i class="bi bi-heart-fill text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Kayıtlı Aramalar</h6>
                            <h2 class="fw-bold mb-0">3</h2>
                        </div>
                        <div class="bg-white p-3 rounded-circle shadow-sm">
                            <i class="bi bi-bell-fill text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4" style="background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Aktif İlanlarım</h6>
                            <h2 class="fw-bold mb-0">1</h2>
                        </div>
                        <div class="bg-white p-3 rounded-circle shadow-sm">
                            <i class="bi bi-house-door-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Role Upgrade Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-8 p-5" style="background: rgba(255,255,255,0.9); backdrop-filter: blur(10px);">
                <h3 class="fw-bold text-dark">Yatırımcı mısınız? Eviniz mi var?</h3>
                <p class="text-muted">Kendi mülklerinizi yönetmek, aidat ve vergi takibi yapmak veya eviniz için usta çağırmak istiyorsanız profilinizi <strong>Mülk Sahibi (Yatırımcı)</strong> rolüne saniyeler içinde ücretsiz yükseltebilirsiniz.</p>
                <button class="btn btn-dark rounded-pill px-4 mt-3">Mülk Yönetimine Geç</button>
            </div>
            <div class="col-md-4 d-none d-md-block" style="background: url('/images/premium-invest.jpg') center/cover;">
                <!-- Decorative Image Background -->
                <div style="background: linear-gradient(90deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 100%); width: 100%; height: 100%;"></div>
            </div>
        </div>
    </div>
</div>
