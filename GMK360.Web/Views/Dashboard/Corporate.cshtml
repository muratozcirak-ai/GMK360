@{
    ViewData["Title"] = "Kurumsal Yönetim Paneli";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #0f2027, #203a43, #2c5364); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Kurumsal Emlak Ofisi
            </h2>
            <p class="text-muted">Danışmanlarınızı, ilan sınırlarınızı, EİDS yetki belgelerinizi ve ofis cüzdanınızı buradan yönetin.</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Property/Create" class="btn btn-dark rounded-pill shadow-sm px-4">
                <i class="bi bi-plus-lg me-2"></i> Yeni İlan (EİDS)
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left: 5px solid #203a43 !important;">
                <div class="card-body p-4 text-center">
                    <h1 class="fw-bold text-dark mb-0">145</h1>
                    <p class="text-muted small">Aktif İlan</p>
                    <div class="progress mt-3" style="height: 5px;">
                        <div class="progress-bar bg-dark" role="progressbar" style="width: 70%;" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <p class="text-muted small mt-2 mb-0">Paket Limiti: 200</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left: 5px solid #0052D4 !important;">
                <div class="card-body p-4 text-center">
                    <h1 class="fw-bold text-primary mb-0">8</h1>
                    <p class="text-muted small">Bağlı Danışman</p>
                    <a href="/Dashboard/Ekibim" class="btn btn-sm btn-outline-primary rounded-pill mt-2">Ekibi Yönet</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left: 5px solid #f2994a !important;">
                <div class="card-body p-4 text-center">
                    <h1 class="fw-bold text-warning mb-0">3</h1>
                    <p class="text-muted small">Süresi Biten (Yetki)</p>
                    <button class="btn btn-sm btn-outline-warning rounded-pill mt-2">Kontrol Et</button>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="card-body p-4 text-center text-white">
                    <h6 class="mb-2 opacity-75">Ofis Cüzdanı (Bakiye)</h6>
                    <h2 class="fw-bold mb-3">12.500 ₺</h2>
                    <a href="/Dashboard/Cuzdanim" class="btn btn-light btn-sm rounded-pill text-success fw-bold px-4">Doping/Vitrin Al</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row g-4">
        <div class="col-md-4">
            <a href="/Dashboard/Portfoyum" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="bi bi-houses text-dark fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Tüm Portföy</h5>
                            <p class="text-muted small mb-0">Danışmanların girdiği ilanlar</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="#" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="bi bi-file-earmark-check text-success fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">EİDS Yetki Belgeleri</h5>
                            <p class="text-muted small mb-0">Bakanlık doğrulama logları</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="#" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="bi bi-bar-chart text-primary fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Abonelik & Fatura</h5>
                            <p class="text-muted small mb-0">Paket yenileme ve ofis giderleri</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <!-- Kurumsal Kimlik & Tema Ayarları -->
        <div class="col-md-4 mt-4">
            <a href="/Dashboard/ThemeSettings" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s; border-left: 5px solid #8e44ad !important;">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-light p-3 rounded-circle me-3">
                            <i class="bi bi-palette text-purple fs-4" style="color: #8e44ad;"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Kurumsal Kimlik & Tema</h5>
                            <p class="text-muted small mb-0">Özel alan adı, logo, renk ve font ayarları</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
    }
</style>
