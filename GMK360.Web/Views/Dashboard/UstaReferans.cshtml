@{
    ViewData["Title"] = "Referans ve Bağlantı (Usta)";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 text-primary fw-bold">Referans Emlakçınız</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Eğer sizi sisteme bir Emlakçı/Danışman davet ettiyse, onun kodunu girerek hesabınızı ona bağlayabilirsiniz.</p>
        
        <form class="row g-3 align-items-end mt-2">
            <div class="col-md-6">
                <label class="form-label">Danışman Referans Kodu</label>
                <input type="text" class="form-control" placeholder="Örn: REF-123456">
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-primary w-100"><i class="bi bi-link-45deg"></i> Bağla</button>
            </div>
        </form>

        <hr class="my-5" />

        <h6 class="fw-bold">Mevcut Bağlantınız</h6>
        <div class="alert alert-secondary mt-3">
            Şu anda herhangi bir danışmana bağlı değilsiniz.
        </div>
    </div>
</div>
