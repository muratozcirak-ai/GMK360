                                <div class="fw-bold fs-5 text-warning">@adayProjeler.Count</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2.5 rounded-3 bg-light border text-center">
                                <div class="text-muted small" style="font-size: 0.72rem;">Aktif Şantiyeler</div>
                                <div class="fw-bold fs-5 text-primary">@activeProjects</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2.5 rounded-3 bg-light border text-center">
                                <div class="text-muted small" style="font-size: 0.72rem;">@(isManager ? "Bu Ay Onaylı Hakediş" : "Geciken İş Kalemi")</div>
                                <div class="fw-bold fs-5 text-dark">@(isManager ? $"₺ {totalPayments:N0}" : $"{delayedPhases}")</div>
                            </div>
                        </div>
                    </div>

                    @if (!isManager)
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <a href="/DailyTimesheets/Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                <i class="bi bi-people me-1"></i>Günlük Puantaj Gir
                            </a>
                            <a href="/SiteDiary" class="btn btn-outline-dark btn-sm rounded-pill px-3">
