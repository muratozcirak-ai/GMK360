                                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(s.Address) ? "-" : s.Address)</td>
                                            <td class="text-end">
                                                <a href="/ConstructionProject/Details/@s.Id" class="btn btn-outline-primary btn-sm rounded-pill py-0.5 px-2.5 fw-bold" style="font-size: 0.74rem;">
                                                    Şantiyeye Gir ➔
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3 text-muted small">
                            <i class="bi bi-building-add fs-4 d-block mb-1 opacity-50"></i>
