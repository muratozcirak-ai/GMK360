                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- SAĞ KOLON (4. DIV: KİŞİSEL PROFİLİM, ONAY PIN & ŞİFRE YENİLEME) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-2.5 px-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-shield-lock text-primary me-1.5"></i>Profilim, Onay PIN & Güvenlik
                    </h6>
                    <small class="text-muted" style="font-size: 0.74rem;">Kişisel iletişim, 4 haneli işlem onay PIN'i ve şifre ayarları</small>
                </div>
                <div class="card-body p-3">
                    <!-- KİŞİSEL BİLGİ & ONAY PIN FORMU -->
                    <form asp-action="UpdatePersonalProfileAndPin" asp-controller="Dashboard" method="post" class="mb-3 pb-3 border-bottom">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted mb-1" style="font-size: 0.74rem;">Ad</label>
                                <input type="text" name="firstName" value="@curUser?.FirstName" class="form-control form-control-sm rounded-2" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted mb-1" style="font-size: 0.74rem;">Soyad</label>
                                <input type="text" name="lastName" value="@curUser?.LastName" class="form-control form-control-sm rounded-2" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-muted mb-1" style="font-size: 0.74rem;">Cep Telefonu (WhatsApp & Bildirim)</label>
                            <input type="tel" name="phoneNumber" value="@curUser?.PhoneNumber" class="form-control form-control-sm rounded-2" placeholder="05XX XXX XX XX" />
                        </div>

                        <div class="mb-2.5 p-2 rounded-2 bg-light border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold text-dark mb-0" style="font-size: 0.75rem;">
                                    <i class="bi bi-key-fill text-warning me-1"></i>İşlem Onay PIN Kodu (4 Hane)
                                </label>
                                @if (hasPin)
                                {
                                    <span class="badge bg-success rounded-pill" style="font-size: 0.65rem;">Tanımlı</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill" style="font-size: 0.65rem;">Tanımsız</span>
                                }
                            </div>
                            <input type="password" name="approvalPin" maxlength="6" inputmode="numeric" class="form-control form-control-sm rounded-2" placeholder="@(hasPin ? "•••• (Değiştirmek için yeni PIN yazın)" : "Örn: 1453 (Hakediş & Teklif onayı için)")" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i>Bilgileri & Onay PIN'ini Kaydet
                        </button>
                    </form>

                    <!-- ŞİFRE YENİLEME FORMU -->
                    <form asp-action="ChangePersonalPassword" asp-controller="Dashboard" method="post">
                        @Html.AntiForgeryToken()
                        <div class="fw-bold small text-dark mb-2" style="font-size: 0.78rem;">
                            <i class="bi bi-lock text-secondary me-1"></i>Giriş Şifresini Yenile
                        </div>
                        <div class="mb-2">
                            <input type="password" name="currentPassword" class="form-control form-control-sm rounded-2" placeholder="Mevcut Şifreniz" required />
                        </div>
                        <div class="mb-2.5">
                            <input type="password" name="newPassword" class="form-control form-control-sm rounded-2" placeholder="Yeni Şifreniz (En az 8 karakter)" required />
                        </div>
                        <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill w-100 fw-bold">
                            <i class="bi bi-arrow-repeat me-1"></i>Şifremi Güncelle
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

