@{
    ViewData["Title"] = "Şantiye ve İnşaat Yönetimi";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Şantiye ERP Özeti</h2>
        <p class="text-muted mb-0">Aktif şantiyeleriniz, taşeron ödemeleri ve yaklaşan fazlar.</p>
    </div>
    <a href="/ConstructionProject/Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i> Yeni Şantiye Başlat
    </a>
</div>

<!-- Özet Kartları -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4">
            <h1 class="display-5 fw-bold text-primary mb-0">3</h1>
            <p class="text-muted fw-bold mb-0 mt-2">Devam Eden Şantiye</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4">
            <h1 class="display-5 fw-bold text-warning mb-0">12</h1>
            <p class="text-muted fw-bold mb-0 mt-2">Gecikmiş İmalat Fazı</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-primary text-white">
            <h3 class="fw-bold mb-0 mt-2">₺ 1.450.000</h3>
            <p class="mb-0 mt-2 opacity-75">Bu Ayki Taşeron Ödemesi</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Yaklaşan Şantiye Aşamaları</h5>
            </div>
            <div class="card-body p-4">
                <div class="list-group list-group-flush">
                    <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Denge Towers - Kaba İnşaat (C Blok)</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-calendar-event me-1"></i> Başlangıç: 15 Ekim 2026</p>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill">3 Gün Kaldı</span>
                    </div>
                    <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Vadi Konakları - İnce İşçilik (Seramik)</h6>
                            <p class="text-muted small mb-0"><i class="bi bi-calendar-event me-1"></i> Başlangıç: 20 Ekim 2026</p>
                        </div>
                        <span class="badge bg-primary rounded-pill">Planlandı</span>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a href="/ConstructionProject/Index" class="btn btn-sm btn-outline-primary rounded-pill">Tüm Şantiyeleri Gör</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-4 h-100 bg-light">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                <i class="bi bi-folder-check display-3 text-muted opacity-50 mb-3"></i>
                <h5 class="fw-bold">Belge Arşivi (Aidiyetli)</h5>
                <p class="text-muted small mb-4">Şantiyelere ait CAD planları, sözleşmeler ve tutanaklar projeleriniz altında güvende.</p>
                <a href="/DocumentArchive/Index?context=construction" class="btn btn-dark rounded-pill">Arşivi Aç</a>
            </div>
        </div>
    </div>
</div>
