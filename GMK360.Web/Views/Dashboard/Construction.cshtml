                        <small class="text-muted" style="font-size: 0.74rem;">
                            @(isManager ? "Aday projeler, aktif şantiyeler ve bekleyen onaylar" : "Günlük saha raporu, puantaj ve aktif şantiye geçişleri")
                        </small>
                    </div>
