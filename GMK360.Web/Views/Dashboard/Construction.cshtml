    <div class="row g-4">
        <!-- TEKLİF & GÖRÜŞÜLEN PROJELER -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-megaphone me-2 text-warning"></i> Aday / Görüşmesi Süren Projeler</h5>
                    <a href="/ConstructionProject/Index?status=teklif" class="btn btn-sm btn-outline-secondary rounded-pill">Tümünü Gör</a>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.TeklifProjeler != null && ((IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>)ViewBag.TeklifProjeler).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Proje Adı</th>
                                        <th>Lokasyon</th>
                                        <th>Tarih</th>
                                        <th>Durum</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var teklif in (IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>)ViewBag.TeklifProjeler)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@teklif.Name</td>
                                            <td class="text-muted small">
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @(string.IsNullOrEmpty(teklif.Address) ? "Belirtilmedi" : (teklif.Address.Length > 20 ? teklif.Address.Substring(0,20)+"..." : teklif.Address))
                                            </td>
                                            <td class="small">@teklif.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td><span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Sözleşme Bekliyor</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted bg-light rounded-3">
                            <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                            <p class="mb-0">Şu an görüşmesi (teklif) devam eden bir proje bulunmuyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- HIZLI ERİŞİM KARTLARI -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 bg-light text-center p-5 h-100 d-flex flex-column justify-content-center">
                <i class="bi bi-folder-check display-4 text-muted mb-3 opacity-50"></i>
                <h5 class="fw-bold">Belge Arşivi</h5>
                <p class="text-muted small mb-4">Tüm şantiyelerinize ait CAD planları, sözleşmeler ve iskan belgeleri tek bir yerde güvende.</p>
                <a href="/DocumentArchive/Index?context=construction" class="btn btn-dark rounded-pill shadow-sm px-4">Arşivi Aç</a>
            </div>
        </div>
    </div>
</div>
