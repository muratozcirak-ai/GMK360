                <div class="card-header bg-white border-bottom py-2.5 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-buildings text-primary me-1.5"></i>@(isManager ? "Projeler & Şantiye Özeti (Yönetici Görünümü)" : "Sorumlu Olduğum Şantiye & Saha İşlemleri")
