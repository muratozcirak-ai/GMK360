                            <table class="table table-hover align-middle table-sm mb-0" style="font-size: 0.82rem;">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th>Proje / Yapı Adı</th>
                                        <th>Aşama</th>
                                        <th>Konum / Adres</th>
                                        <th class="text-end">Geçiş</th>
                                    </tr>
