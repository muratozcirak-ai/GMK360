                                            <td class="text-end">
                                                <a href="/ConstructionProject/Workspace/@p.Id" class="btn btn-outline-warning text-dark btn-sm rounded-pill py-0.5 px-2.5 fw-bold" style="font-size: 0.74rem;">
                                                    Aday Masası ➔
                                                </a>
