@{
    ViewData["Title"] = "Danışman Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #1c92d2, #f2fcfe); -webkit-background-clip: text; -webkit-text-fill-color: #1c92d2;">
                Danışman Paneli
            </h2>
            <p class="text-muted">Kendi portföyünüzü, müşteri görüşmelerinizi ve ofis içi hedeflerinizi yönetin.</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Property/Create" class="btn btn-primary rounded-pill shadow-sm px-4">
                <i class="bi bi-plus-lg me-2"></i> İlan Ekle
            </a>
        </div>
    </div>

    <!-- Connected Agency Info -->
    <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center" role="alert" style="background: rgba(28, 146, 210, 0.1);">
        <i class="bi bi-building fs-3 me-3 text-primary"></i>
        <div>
            <h6 class="alert-heading fw-bold mb-1 text-primary">Bağlı Olduğunuz Ofis: GMK360 Merkez Şube</h6>
            <p class="mb-0 small text-muted">Tüm ilanlarınız EİDS kapsamında bu ofisin Yetki Belgesi üzerinden yayınlanmaktadır.</p>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <h1 class="fw-bold text-dark mb-0">12</h1>
                    <p class="text-muted small">Aktif Portföyüm</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <h1 class="fw-bold text-success mb-0">5</h1>
                    <p class="text-muted small">Yaklaşan Randevu</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <h1 class="fw-bold text-warning mb-0">1</h1>
                    <p class="text-muted small">Süresi Yaklaşan İlan</p>
                    <small class="text-danger">7 gün kaldı!</small>
                </div>
            </div>
        </div>
    </div>
</div>
