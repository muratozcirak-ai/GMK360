@model GMK360.Web.Models.Dashboard.PropertyOwnerDashboardViewModel

@{
    ViewData["Title"] = "Dijital Evim (Mülk Yönetim Merkezi)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #11998e, #38ef7d); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                <i class="bi bi-house-heart"></i> Dijital Evim (Mülk Yönetim Merkezi)
            </h2>
            <p class="text-muted">Sahibi olduğunuz veya kiraladığınız gayrimenkullerin aidat, vergi, kira ve tadilat süreçlerini tek ekrandan yönetin.</p>
        </div>
        <div class="col-md-4 text-end">
            <!-- DigitalHomeController'daki "Yeni Mülk Ekle" sayfasına veya modalını barındıran index'e yönlendiriyoruz -->
            <a href="/DigitalHome/Index" class="btn btn-primary rounded-pill shadow-sm px-4">
                <i class="bi bi-plus-lg me-2"></i> Yeni Mülk Ekle / Git
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-buildings text-primary fs-3"></i>
                    </div>
                    <h2 class="fw-bold mb-1">@Model.TotalProperties</h2>
                    <p class="text-muted mb-0 small">Kayıtlı Mülk</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-wallet2 text-success fs-3"></i>
                    </div>
                    <h2 class="fw-bold mb-1 text-success">@Model.TotalMonthlyIncome.ToString("C0")</h2>
                    <p class="text-muted mb-0 small">Tahmini Aylık Gelir</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-file-earmark-text text-danger fs-3"></i>
                    </div>
                    <h2 class="fw-bold mb-1 text-danger">@Model.PendingInvoices</h2>
                    <p class="text-muted mb-0 small">Bekleyen Fatura/Vergi</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-tools text-warning fs-3"></i>
                    </div>
                    <h2 class="fw-bold mb-1 text-warning">@Model.ActiveRenovationRequests</h2>
                    <p class="text-muted mb-0 small">Aktif Usta Talebi</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark"><i class="bi bi-calculator text-primary me-2"></i> Mülk Muhasebesi</h5>
                    <p class="text-muted small mb-4">Emlak vergisi, çöp vergisi, DASK, aidat ve bakım onarım giderlerinizi dijital dekontlarla takip edin.</p>
                    <a href="/DigitalHome/Index" class="btn btn-light rounded-pill px-4 shadow-sm text-primary fw-bold">Giderleri Yönet</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark"><i class="bi bi-hammer text-danger me-2"></i> Usta / Servis Çağır</h5>
                    <p class="text-muted small mb-4">Evinizin boyası, tesisat arızası veya temizliği için çevrenizdeki ustalardan hemen fiyat teklifi alın.</p>
                    <a href="/DigitalHome/Renovations" class="btn btn-light rounded-pill px-4 shadow-sm text-dark fw-bold">Talep Oluştur</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Eklenen Mülkler -->
    <div class="row mb-5">
        <div class="col-12">
            <h4 class="fw-bold mb-3"><i class="bi bi-clock-history text-secondary"></i> Son Kayıtlı Mülklerim</h4>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3">Mülk Adı</th>
                                    <th class="py-3">Rol</th>
                                    <th class="py-3">Eklenme Tarihi</th>
                                    <th class="pe-4 py-3 text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(Model.RecentProperties == null || !Model.RecentProperties.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            Henüz mülk eklemediniz. Hemen sağ üstteki butondan ilk evinizi ekleyin!
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach(var prop in Model.RecentProperties)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3 fw-bold">@prop.Title</td>
                                            <td class="py-3">
                                                @if(prop.ManagementRole == GMK360.Core.Entities.ManagementRole.Owner)
                                                {
                                                    <span class="badge bg-success">Ev Sahibi</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">Kiracı</span>
                                                }
                                            </td>
                                            <td class="py-3">@prop.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td class="pe-4 py-3 text-end">
                                                <a href="/DigitalHome/Details/@prop.Id" class="btn btn-sm btn-outline-primary">Detay / Gider Ekle</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
