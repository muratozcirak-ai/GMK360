@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "İnşaat Projelerim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">İnşaat Projelerim</h2>
    <a href="#" class="btn btn-primary"><i class="ph ph-plus"></i> Yeni Proje Ekle</a>
</div>

<div class="row">
    <!-- Örnek Proje Kartı -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Denge Towers Kadıköy</h5>
                        <p class="text-muted small"><i class="ph ph-map-pin"></i> Kadıköy, İstanbul</p>
                    </div>
                    <span class="badge bg-primary">Devam Ediyor</span>
                </div>
                
                <div class="mb-3">
                    <p class="mb-1 fw-bold small">İlerleme Durumu (%65)</p>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 65%;" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="row text-center mb-3">
                    <div class="col-4">
                        <h6 class="fw-bold mb-0">24</h6>
                        <small class="text-muted">Daire</small>
                    </div>
                    <div class="col-4 border-start border-end">
                        <h6 class="fw-bold mb-0">12</h6>
                        <small class="text-muted">Kat Sahibi</small>
                    </div>
                    <div class="col-4">
                        <h6 class="fw-bold mb-0 text-primary">5</h6>
                        <small class="text-muted">Aktif İş</small>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a href="#" class="btn btn-outline-primary btn-sm"><i class="ph ph-list-dashes"></i> İş Emirleri ve Usta Takibi</a>
                    <a href="#" class="btn btn-outline-secondary btn-sm"><i class="ph ph-swatches"></i> Malzeme Kataloğu</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Örnek Proje Kartı 2 -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Denge Life Çamlıca</h5>
                        <p class="text-muted small"><i class="ph ph-map-pin"></i> Üsküdar, İstanbul</p>
                    </div>
                    <span class="badge bg-warning text-dark">Başlayacak</span>
                </div>
                
                <div class="mb-3">
                    <p class="mb-1 fw-bold small">İlerleme Durumu (%0)</p>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar bg-secondary" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="alert alert-info py-2 small mb-3">
                    <i class="ph ph-info"></i> Kat sahiplerinin fayans ve dolap seçimleri bekleniyor. Son Tarih: 15 Eylül.
                </div>

                <div class="d-grid gap-2 mt-auto">
                    <a href="#" class="btn btn-outline-secondary btn-sm"><i class="ph ph-swatches"></i> Malzeme Kataloğu Belirle</a>
                </div>
            </div>
        </div>
    </div>
</div>
