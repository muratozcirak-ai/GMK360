@{
    ViewData["Title"] = "Kurum ve KBS Ayarları";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-gear-fill"></i> Kurum Ayarları ve API Entegrasyonları</h5>
    </div>
    <div class="card-body p-4">
        <form>
            <h6 class="text-primary mb-3"><i class="bi bi-briefcase"></i> Vergi ve Yetki Belgeleri</h6>
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Vergi Kimlik Numarası (VKN)</label>
                    <input type="text" class="form-control" value="1234567890" disabled />
                    <small class="text-success"><i class="bi bi-check-circle"></i> GİB Tarafından Doğrulandı</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">TTBS Yetki Belgesi</label>
                    <input type="text" class="form-control" value="3400012" disabled />
                    <small class="text-success"><i class="bi bi-check-circle"></i> Ticaret Bakanlığı Onaylı</small>
                </div>
            </div>

            <hr />

            <h6 class="text-danger mb-3 mt-4"><i class="bi bi-shield-lock"></i> Emniyet KBS Ayarları (Günübirlik Ev İşletmeleri İçin)</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tesis Kodu</label>
                    <input type="text" class="form-control" placeholder="EGM'den alınan tesis kodunu giriniz" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Emniyet Şifresi (Parola)</label>
                    <div class="input-group">
                        <input type="password" class="form-control" placeholder="Şifre (AES-256 ile şifrelenerek saklanır)" id="kbsPassword" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()"><i class="bi bi-eye"></i></button>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-warning mt-3">
                <i class="bi bi-exclamation-triangle-fill"></i> <strong>Uyarı:</strong> Bu alana gireceğiniz şifre, günlük kiralama bildirimlerinizin Emniyet sistemine arka planda otomatik gönderilmesi için kullanılır. Sisteme şifrelenerek (Encrypted) kaydedilir. Tesis yöneticisi dışında kimse göremez.
            </div>

            <button type="button" class="btn btn-primary mt-3"><i class="bi bi-save"></i> Ayarları Güncelle</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword() {
            var input = document.getElementById("kbsPassword");
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }
    </script>
}
