@{
    ViewData["Title"] = "Cari Hesap Özeti";
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    if (ctx == "service") layoutName = "~/Views/Shared/_ServiceProviderLayout.cshtml";
    else if (ctx == "supplier") layoutName = "~/Views/Shared/_SupplierLayout.cshtml";
    else if (ctx == "realestate") layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
    else if (ctx == "hotel") layoutName = "~/Views/Shared/_CommercialRenterLayout.cshtml";
    Layout = layoutName;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 text-primary fw-bold">Cari Hesap Özeti</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Tüm finansal işlemleriniz (komisyonlar, çekimler, paket alımları) cari hesap şeklinde aşağıda listelenmektedir.</p>

        <div class="row text-center mt-4 mb-4">
            <div class="col-sm-4">
                <div class="border rounded p-3">
                    <small class="text-muted fw-bold text-uppercase">Toplam Alacak</small>
                    <h4 class="text-success mt-2">0,00 TL</h4>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="border rounded p-3">
                    <small class="text-muted fw-bold text-uppercase">Toplam Borç</small>
                    <h4 class="text-danger mt-2">0,00 TL</h4>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="border rounded p-3 bg-light">
                    <small class="text-muted fw-bold text-uppercase">Bakiye</small>
                    <h4 class="text-primary mt-2">0,00 TL</h4>
                </div>
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>İşlem (Açıklama)</th>
                        <th class="text-end">Borç</th>
                        <th class="text-end">Alacak</th>
                        <th class="text-end">Bakiye</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Herhangi bir cari hareket bulunamadı.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
