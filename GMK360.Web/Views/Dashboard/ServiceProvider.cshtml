@{
    ViewData["Title"] = "Usta ve Hizmet Paneli Özeti";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Hoş Geldiniz, Ahmet Usta</h2>
        <p class="text-muted">Son giriş: Bugün 09:15 - Genel durumunuz harika!</p>
    </div>
    <div>
        <a href="/Dashboard/UstaProfilim" class="btn btn-outline-primary rounded-pill fw-bold"><i class="bi bi-pencil me-1"></i> Profili Düzenle</a>
    </div>
</div>

<!-- Özet Kartları -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Yeni İş Talebi</h6>
                    <i class="bi bi-bell fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">5</h2>
                <small class="opacity-75">Cevap bekleyen keşif isteği</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Tamamlanan İşler</h6>
                    <i class="bi bi-check2-circle fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">128</h2>
                <small class="opacity-75">Bu ay 12 iş teslim edildi</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-warning text-dark border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Profil Görüntülenmesi</h6>
                    <i class="bi bi-eye fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">1.4K</h2>
                <small class="opacity-75">+24% geçen haftaya göre</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-info text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Aktif Paket</h6>
                    <i class="bi bi-star-fill fs-4 opacity-75"></i>
                </div>
                <h3 class="mb-1 mt-1">Lokal Paket</h3>
                <small class="opacity-75">Sadece 3 mahallede görünür</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold"><i class="bi bi-calendar-event text-primary me-2"></i> Yaklaşan Keşif Randevuları</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-bottom">
                        <div class="d-flex align-items-center">
                            <div class="bg-light text-primary fw-bold rounded px-3 py-2 me-3 text-center">
                                <div class="fs-4 lh-1">15</div><small>Ağu</small>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold">Su Tesisatı Kaçağı Tespiti</h6>
                                <p class="mb-0 text-muted small"><i class="bi bi-geo-alt"></i> Ataşehir, İstanbul</p>
                            </div>
                        </div>
                        <a href="/Crm/Ajanda?context=service" class="btn btn-sm btn-outline-primary rounded-pill">Detay</a>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-bottom">
                        <div class="d-flex align-items-center">
                            <div class="bg-light text-primary fw-bold rounded px-3 py-2 me-3 text-center">
                                <div class="fs-4 lh-1">16</div><small>Ağu</small>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold">Mutfak Dolabı Yenileme (Ölçü)</h6>
                                <p class="mb-0 text-muted small"><i class="bi bi-geo-alt"></i> Kadıköy, İstanbul</p>
                            </div>
                        </div>
                        <a href="/Crm/Ajanda?context=service" class="btn btn-sm btn-outline-primary rounded-pill">Detay</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 bg-light">
            <div class="card-body text-center p-5 d-flex flex-column justify-content-center">
                <i class="bi bi-rocket-takeoff text-primary mb-3" style="font-size: 3rem;"></i>
                <h4 class="fw-bold">Global Pakete Geçin!</h4>
                <p class="text-muted">Şu an sadece yerel bölgenizde (3 mahalle) hizmet veriyorsunuz. Tüm ilde iş almak için Global Pakete yükseltin.</p>
                <a href="/Dashboard/PaketYonetimi" class="btn btn-primary rounded-pill fw-bold mt-2">Paketleri İncele</a>
            </div>
        </div>
    </div>
</div>
