@{
    ViewData["Title"] = "Portföyüm / İlan Yönetimi";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary fw-bold">Portföyüm</h5>
            <a href="/Property/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Yeni İlan Ekle</a>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted">Bu ekranda aktif, pasif ve onay bekleyen ilanlarınızı yönetebilirsiniz.</p>
        
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Görsel</th>
                        <th>İlan Başlığı</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Henüz ilanınız bulunmamaktadır.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
