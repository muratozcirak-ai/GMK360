@{
    ViewData["Title"] = "Hizmet Profilim";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <!-- Profil Header / Banner -->
    <div class="bg-primary" style="height: 120px;"></div>
    <div class="card-body px-5 position-relative">
        <div class="position-absolute" style="top: -60px;">
            <img src="https://ui-avatars.com/api/?name=Ahmet+Usta&background=fff&color=0d6efd&size=120" class="rounded-circle border border-4 border-white shadow-sm" alt="Usta Foto">
        </div>
        
        <div class="d-flex justify-content-between align-items-end mb-4" style="margin-top: 60px;">
            <div>
                <h3 class="fw-bold mb-1">Ahmet Yılmaz (Usta) <i class="bi bi-patch-check-fill text-primary" title="Onaylı Usta"></i></h3>
                <p class="text-muted mb-0"><i class="bi bi-tools me-1"></i> Su Tesisatı & Boya Badana Uzmanı</p>
            </div>
            <div>
                <button class="btn btn-primary rounded-pill px-4"><i class="bi bi-save me-1"></i> Değişiklikleri Kaydet</button>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-8">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Hizmet Detayları</h5>
                <form>
                    <div class="mb-3">
                        <label class="form-label text-muted fw-bold small">Hakkımda (Müşterilerin Gördüğü Metin)</label>
                        <textarea class="form-control bg-light border-0" rows="4">15 yıllık tecrübemle İstanbul Anadolu yakasında su tesisatı, tıkanıklık açma ve boya badana işlerinizi titizlikle yapıyorum. Ücretsiz keşif için ulaşabilirsiniz.</textarea>
                    </div>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted fw-bold small">Uzmanlık Alanları</label>
                            <input type="text" class="form-control bg-light border-0" value="Su Tesisatı, Boya, Alçıpan" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted fw-bold small">Deneyim Yılı</label>
                            <input type="number" class="form-control bg-light border-0" value="15" />
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-light border-0 rounded-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Hizmet Bölgeleri (Lokal Paket)</h6>
                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item bg-transparent px-0 border-bottom-0"><i class="bi bi-check-circle-fill text-success me-2"></i> Ataşehir</li>
                            <li class="list-group-item bg-transparent px-0 border-bottom-0"><i class="bi bi-check-circle-fill text-success me-2"></i> Kadıköy</li>
                            <li class="list-group-item bg-transparent px-0 border-bottom-0"><i class="bi bi-check-circle-fill text-success me-2"></i> Ümraniye</li>
                        </ul>
                        <a href="/Dashboard/PaketYonetimi" class="btn btn-sm btn-outline-primary w-100 rounded-pill">Daha Fazla Bölge Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
