@{
    ViewData["Title"] = "Paket & Görünürlük Yönetimi";
    Layout = "~/Views/Shared/_ServiceProviderLayout.cshtml";
}

<div class="text-center mb-5 mt-3">
    <h2 class="fw-bold">Görünürlüğünüzü Artırın, Daha Çok İş Alın</h2>
    <p class="text-muted fs-5">Size uygun paketi seçin ve müşteri ağınızı genişletin.</p>
</div>

<div class="row justify-content-center g-4">
    <!-- Lokal Paket -->
    <div class="col-md-5">
        <div class="card h-100 border-2 border-primary rounded-4 shadow-sm position-relative">
            <div class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-primary px-3 py-2">
                ŞU ANKİ PAKETİNİZ
            </div>
            <div class="card-body p-5 text-center mt-3">
                <i class="bi bi-geo text-primary display-3 mb-3"></i>
                <h3 class="fw-bold text-dark">Lokal Paket</h3>
                <h4 class="text-muted mb-4">Sembolik Tek Seferlik Ücret</h4>
                
                <ul class="list-unstyled text-start mb-5">
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> Bulunduğunuz Mahallede Görünme</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> Komşu 3 Mahallede Listelenme</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> Randevu ve Keşif Sistemi</li>
                    <li class="mb-3 text-muted"><i class="bi bi-x-circle text-danger me-2"></i> Tüm Şehirde Görünme Yok</li>
                </ul>
                
                <button class="btn btn-outline-primary w-100 rounded-pill fw-bold" disabled>Aktif Kullanılıyor</button>
            </div>
        </div>
    </div>

    <!-- Global Paket -->
    <div class="col-md-5">
        <div class="card h-100 border-0 rounded-4 shadow" style="background: linear-gradient(145deg, #1e3c72 0%, #2a5298 100%); color: white;">
            <div class="card-body p-5 text-center">
                <i class="bi bi-globe-europe-africa text-warning display-3 mb-3"></i>
                <h3 class="fw-bold">Global Paket</h3>
                <h4 class="text-white-50 mb-4">Aylık Profesyonel Abonelik</h4>
                
                <ul class="list-unstyled text-start mb-5">
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-warning me-2"></i> Tüm Şehirde (İl Geneli) Görünme</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-warning me-2"></i> Arama Sonuçlarında Üst Sıralar</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-warning me-2"></i> Şantiyelere Teklif Verebilme Yetkisi</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-warning me-2"></i> Sınırsız Mesajlaşma & Müşteri CRM</li>
                </ul>
                
                <button class="btn btn-warning w-100 rounded-pill fw-bold fs-5">Hemen Yükselt (₺499/Ay)</button>
            </div>
        </div>
    </div>
</div>
