@{
    ViewData["Title"] = "Dashboard - Yönlendirici";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adminler için özel layout olabilir
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12 text-center mb-5">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #2b5876, #4e4376); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Yönetici Test Merkezi (Admin Hub)
            </h2>
            <p class="text-muted">Aşağıdaki panellerden herhangi birine tıklayarak tasarımını ve işlevlerini doğrudan test edebilirsiniz.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Bireysel -->
        <div class="col-md-4">
            <a href="/Dashboard/Individual" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-person text-primary" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Bireysel Üye</h4>
                        <p class="text-muted small">Ev arayanlar ve sahibinden ilan verenler.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Mülk Sahibi -->
        <div class="col-md-4">
            <a href="/Dashboard/PropertyOwner" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-building text-success" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Mülk Sahibi</h4>
                        <p class="text-muted small">Vergi, aidat ve bakım giderlerini yöneten yatırımcılar.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Kurumsal -->
        <div class="col-md-4">
            <a href="/Dashboard/Corporate" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-briefcase text-danger" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Kurumsal (Ofis)</h4>
                        <p class="text-muted small">Emlak ofisleri, danışman yönetimi ve yüksek hacim.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Danışman -->
        <div class="col-md-4">
            <a href="/Dashboard/Consultant" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-headset text-info" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Danışman</h4>
                        <p class="text-muted small">Bir emlak ofisine bağlı çalışan satış temsilcileri.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Hizmet Veren (Usta) -->
        <div class="col-md-4">
            <a href="/Dashboard/ServiceProvider" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-tools text-warning" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Usta / Hizmet Veren</h4>
                        <p class="text-muted small">Boyacı, tesisatçı, nakliyeci vb. hizmet veren ustalar.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Esnaf (Tedarikçi) -->
        <div class="col-md-4">
            <a href="/Dashboard/Supplier" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-shop text-danger" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Esnaf / Tedarikçi</h4>
                        <p class="text-muted small">Nalbur, yapı market, mobilyacı vb. (B2B Teklif Sistemi).</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Ticari Kiralayan -->
        <div class="col-md-4">
            <a href="/Dashboard/CommercialRenter" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); transition: transform 0.3s; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-calendar-check text-secondary" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 text-dark">Ticari Kiralayan</h4>
                        <p class="text-muted small">Günlük/Tatil amaçlı kiralama (KBS Emniyet Modülü).</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important;
    }
</style>
