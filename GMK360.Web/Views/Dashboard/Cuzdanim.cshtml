@{
    ViewData["Title"] = "Dijital Cüzdanım";
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    if (ctx == "service") layoutName = "~/Views/Shared/_ServiceProviderLayout.cshtml";
    else if (ctx == "supplier") layoutName = "~/Views/Shared/_SupplierLayout.cshtml";
    else if (ctx == "realestate") layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
    else if (ctx == "hotel") layoutName = "~/Views/Shared/_CommercialRenterLayout.cshtml";
    Layout = layoutName;
}

<div class="row">
    <!-- Bakiye Kartı -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body d-flex flex-column justify-content-center align-items-center py-5">
                <i class="bi bi-wallet2 mb-3" style="font-size: 3rem;"></i>
                <h6 class="text-white-50 text-uppercase fw-bold">Toplam Bakiyeniz</h6>
                <h2 class="fw-bold mb-0">0,00 TL</h2>
            </div>
        </div>
    </div>
    
    <!-- İşlemler -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white pb-0 border-0">
                <h5 class="mb-0 fw-bold">Cüzdan İşlemleri</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <button class="btn btn-outline-success w-100 py-3 d-flex flex-column align-items-center" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                            <i class="bi bi-cash-coin mb-2" style="font-size: 2rem;"></i>
                            <span class="fw-bold">Nakit Çekim Talebi</span>
                        </button>
                    </div>
                    <div class="col-sm-6">
                        <a href="/Dashboard/PaketYonetimi" class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center">
                            <i class="bi bi-cart mb-2" style="font-size: 2rem;"></i>
                            <span class="fw-bold">Paket/Hizmet Satın Al</span>
                        </a>
                    </div>
                </div>
                <div class="alert alert-warning mt-4 mb-0">
                    <i class="bi bi-info-circle me-2"></i> Nakit çekim işlemi yapabilmeniz için bakiyenizin en az <strong>2.000 TL</strong> olması gerekmektedir.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hesap Hareketleri -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 fw-bold">Hesap Hareketleri</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>İşlem Tipi</th>
                        <th>Açıklama</th>
                        <th>Tutar</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Henüz bir hesap hareketiniz bulunmamaktadır.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Çekim Talebi Modal -->
<div class="modal fade" id="withdrawModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Nakit Çekim Talebi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Cüzdan bakiyenizi banka hesabınıza aktarabilirsiniz. Alt limit 2.000 TL'dir.</p>
                <form>
                    <div class="mb-3">
                        <label class="form-label">Çekilecek Tutar (TL)</label>
                        <input type="number" class="form-control" placeholder="Örn: 2500">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">IBAN Bilgisi</label>
                        <input type="text" class="form-control" placeholder="TR..." value="TR12 3456 7890 1234 5678 9012 34">
                        <div class="form-text">Profil ayarlarınızdaki kayıtlı IBAN numaranız.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success">Talep Oluştur</button>
            </div>
        </div>
    </div>
</div>
