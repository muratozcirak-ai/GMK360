@{
    ViewData["Title"] = "Referans Kodum";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 text-primary fw-bold">Referans Kodum</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Bu referans kodunu kullanarak platforma Usta/Esnaf davet edebilir ve kayıt olduklarında cüzdanınıza komisyon kazanabilirsiniz.</p>
        
        <div class="row align-items-center mt-4">
            <div class="col-md-6">
                <div class="input-group mb-3">
                    <span class="input-group-text bg-light"><i class="bi bi-share"></i></span>
                    <input type="text" class="form-control" id="refCodeInput" value="REF-123456" readonly>
                    <button class="btn btn-primary" type="button" onclick="copyRefCode()"><i class="bi bi-clipboard"></i> Kopyala</button>
                </div>
            </div>
        </div>
        
        <h6 class="mt-4 fw-bold">Referans İle Gelenler</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Usta/Esnaf Adı</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kazancınız</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Henüz referansınızla kayıt olan bulunmamaktadır.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyRefCode() {
            var copyText = document.getElementById("refCodeInput");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);
            alert("Referans kodu kopyalandı!");
        }
    </script>
}
