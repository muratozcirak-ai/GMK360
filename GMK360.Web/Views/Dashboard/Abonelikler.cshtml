@{
    ViewData["Title"] = "Abonelik Seçimi";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="text-center mb-5">
    <h2>Size En Uygun Paketi Seçin</h2>
    <p class="text-muted">Esnek paketlerimizle satışlarınızı ve kazancınızı artırın.</p>
</div>

<div class="row justify-content-center">
    <!-- Bölgesel Paket -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 position-relative">
            <div class="card-body p-4 text-center">
                <h4 class="card-title fw-bold">Bölgesel Paket</h4>
                <h5 class="text-muted mb-4">Aylık Sözleşme</h5>
                <h1 class="display-4 fw-bold text-primary mb-4">500<span style="font-size: 1.5rem">₺</span></h1>
                
                <ul class="list-unstyled text-start mb-4">
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Sadece kendi şehrinizdeki ilanlar</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Max 50 İlan Hakkı</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>E-Fatura Kesme İmkanı</li>
                    <li class="mb-3"><i class="bi bi-x-circle-fill text-danger me-2"></i>Emniyet KBS Entegrasyonu Yok</li>
                </ul>
                
                <button class="btn btn-outline-primary w-100 py-2 fw-bold">Seç ve İlerle</button>
            </div>
        </div>
    </div>

    <!-- Ulusal Paket -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow border-primary position-relative" style="transform: scale(1.05);">
            <div class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-danger fs-6 px-3 py-2">
                En Çok Tercih Edilen
            </div>
            <div class="card-body p-4 text-center">
                <h4 class="card-title fw-bold">Ulusal Paket</h4>
                <h5 class="text-muted mb-4">Yıllık Sözleşme</h5>
                <h1 class="display-4 fw-bold text-primary mb-4">1200<span style="font-size: 1.5rem">₺</span></h1>
                
                <ul class="list-unstyled text-start mb-4">
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Tüm Türkiye'deki ilanlara erişim</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Sınırsız İlan Hakkı</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Sınırsız E-Fatura</li>
                    <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Emniyet KBS Tam Entegrasyon</li>
                </ul>
                
                <button class="btn btn-primary w-100 py-2 fw-bold">Seç ve İlerle</button>
            </div>
        </div>
    </div>
</div>
