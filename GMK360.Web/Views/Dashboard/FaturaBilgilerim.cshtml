@{
    ViewData["Title"] = "Fatura Bilgilerim";
    var ctx = Context.Request.Query["context"].ToString()?.ToLower();
    string layoutName = "~/Views/Shared/_DashboardLayout.cshtml";
    if (ctx == "service") layoutName = "~/Views/Shared/_ServiceProviderLayout.cshtml";
    else if (ctx == "supplier") layoutName = "~/Views/Shared/_SupplierLayout.cshtml";
    else if (ctx == "realestate") layoutName = "~/Views/Shared/_RealEstateLayout.cshtml";
    else if (ctx == "hotel") layoutName = "~/Views/Shared/_CommercialRenterLayout.cshtml";
    Layout = layoutName;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 text-primary fw-bold">Fatura (Banka / Şirket) Bilgilerim</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Cüzdan bakiyenizi banka hesabınıza çekerken veya size e-fatura kesilirken kullanılacak yasal bilgileriniz.</p>
        
        <form>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label">Şirket Ünvanı / Ad Soyad</label>
                    <input type="text" class="form-control" placeholder="Resmi ünvanınız">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Vergi Dairesi</label>
                    <input type="text" class="form-control" placeholder="Örn: Kadıköy V.D.">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Vergi Numarası / T.C. Kimlik No</label>
                    <input type="text" class="form-control">
                </div>
                <div class="col-md-6">
                    <label class="form-label">IBAN Numaranız (TR ile başlar)</label>
                    <input type="text" class="form-control" placeholder="TR...">
                    <div class="form-text">Para çekim talepleriniz bu hesaba gönderilir. Hesap sizin adınıza olmalıdır.</div>
                </div>
                <div class="col-12">
                    <label class="form-label">Fatura Adresi</label>
                    <textarea class="form-control" rows="3" placeholder="Açık adresiniz"></textarea>
                </div>
                <div class="col-12 text-end mt-4">
                    <button type="button" class="btn btn-primary"><i class="bi bi-save"></i> Bilgileri Güncelle</button>
                </div>
            </div>
        </form>
    </div>
</div>
