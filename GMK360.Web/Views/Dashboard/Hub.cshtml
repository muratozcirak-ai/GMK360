@{
    ViewData["Title"] = "Uygulama Merkezi (Hub)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string activeModules = ViewBag.ActiveModules as string ?? "";
    int residentUnitCount = ViewBag.ResidentUnitCount is int ruc ? ruc : 0;
    int ownerUnitCount = ViewBag.OwnerUnitCount is int ouc ? ouc : 0;
    int boardCount = ViewBag.BoardMembershipCount is int bmc ? bmc : 0;
    var portalBuildingLinks = ViewBag.PortalBuildingLinks as List<GMK360.Web.Controllers.PortalBuildingLink> ?? new List<GMK360.Web.Controllers.PortalBuildingLink>();
    var managedSiteLinks = ViewBag.ManagedSiteLinks as List<GMK360.Web.Controllers.ManagedSiteLink> ?? new List<GMK360.Web.Controllers.ManagedSiteLink>();
    var quotaSummary = ViewBag.QuotaSummary as GMK360.Web.Services.SingleUnitQuotaResult ?? new GMK360.Web.Services.SingleUnitQuotaResult();
    string? agencyCompanyName = ViewBag.AgencyCompanyName as string;
    bool hasCompletedAgency = ViewBag.HasCompletedAgency is bool hca && hca;
    bool hasResidentPortal = residentUnitCount > 0 || boardCount > 0 || portalBuildingLinks.Any() || User.IsInRole("Sakin") || User.IsInRole("Personel");
    // Her üye (Site Yöneticisi, Müteahhit, Usta veya Sakin) kişisel Evim & Mülk Kokpiti alanını görür (İsteğe Bağlı 15 Gün Demo -> Tek/Çoklu Mülk)
    bool hasLandlordPortal = true;
    bool hasFacilityAccess = activeModules.Contains("facility") || managedSiteLinks.Any() || User.IsInRole("BinaYoneticisi");
    bool hasModules = !string.IsNullOrEmpty(activeModules) || hasResidentPortal || hasFacilityAccess || hasLandlordPortal;
}

<div class="container py-5 mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- COMPACT MERKEZİ AJANDA ÖZETİ (Kart tekrarı yapmadan canlı özet) -->
    <div class="card border-0 shadow-sm rounded-4 bg-light mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar2-check text-primary me-2"></i>Merkezi Ajanda Özeti
                </h5>
                <button class="btn btn-sm btn-outline-dark rounded-pill px-3" onclick="new bootstrap.Modal(document.getElementById('moduleModal')).show()">
                    <i class="bi bi-sliders me-1"></i> İş Modüllerimi Yönet
                </button>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (managedSiteLinks.Any())
                {
                    foreach (var ms in managedSiteLinks)
                    {
                        <a href="/BuildingManager/Index" class="badge bg-white text-dark border border-success border-opacity-50 rounded-pill px-3 py-2 text-decoration-none shadow-xs">
                            <i class="bi bi-building-check text-success me-1"></i>
                            <strong>@ms.SiteName:</strong> @(ms.OpenTicketCount > 0 ? $"{ms.OpenTicketCount} Bekleyen İşlem" : "Yönetim Aktif")
                        </a>
                    }
                }
                else if (hasFacilityAccess)
                {
                    <a href="/BuildingManager/Index" class="badge bg-white text-dark border border-success border-opacity-50 rounded-pill px-3 py-2 text-decoration-none">
                        <i class="bi bi-building text-success me-1"></i> Site Kurulumu Hazır
                    </a>
                }

                @if (portalBuildingLinks.Any())
                {
                    <span class="badge bg-white text-dark border border-info border-opacity-50 rounded-pill px-3 py-2">
                        <i class="bi bi-house-heart text-info me-1"></i>
                        <strong>Sakin / Kurul Üyeliği:</strong> @portalBuildingLinks.Count aktif kayıt
                    </span>
                }

                @if (activeModules.Contains("construction"))
                {
                    <a href="/Dashboard/Construction" class="badge bg-white text-dark border border-primary border-opacity-50 rounded-pill px-3 py-2 text-decoration-none">
                        <i class="bi bi-cone-striped text-primary me-1"></i>
                        <strong>@(string.IsNullOrWhiteSpace(agencyCompanyName) ? "İnşaat ERP:" : $"{agencyCompanyName}:")</strong>
                        @(hasCompletedAgency ? "Şantiye ERP Aktif" : "Kurulum Hazır")
                    </a>
                }

                <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                    <i class="bi bi-person-workspace text-warning-emphasis me-1"></i>
                    <strong>Evim &amp; Mülk Kokpiti:</strong> @quotaSummary.PropertyPlanStatusLabel
                </span>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <h2 class="fw-bold h3 mb-1">Çalışma Alanınızı Seçin</h2>
        <p class="text-muted mb-0">Yetkili olduğunuz kurumlar, üyesi olduğunuz siteler ve kişisel mülk alanınız.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- 1. YÖNETTİĞİM SİTELER / BİNALAR (Site / Bina bazında tekil, bloklara parçalanmaz) -->
        @if (managedSiteLinks.Any())
        {
            foreach (var ms in managedSiteLinks)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="/BuildingManager/Index" class="text-decoration-none">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card border-top border-4 border-success">
                            <div class="bg-success text-white p-4 text-center">
                                <i class="bi bi-buildings-fill display-5"></i>
                            </div>
                            <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                                <div>
                                    <span class="badge bg-success-subtle text-success rounded-pill mb-2">Site / Bina Yöneticisi</span>
                                    <h5 class="fw-bold text-dark mb-1">@ms.SiteName</h5>
                                    <p class="text-muted small mb-2">@ms.BlocksSummary • Aidat, kasa, karar defteri ve operasyon yönetimi.</p>
                                </div>
                                <div class="pt-2">
                                    <span class="btn btn-sm btn-success rounded-pill px-4 fw-semibold">
                                        @ms.SiteName Panelini Aç &rarr;
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else if (hasFacilityAccess)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/BuildingManager/Index" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card border-top border-4 border-success">
                        <div class="bg-success text-white p-4 text-center"><i class="bi bi-building-add display-5"></i></div>
                        <div class="card-body p-4 text-center">
                            <span class="badge bg-warning text-dark rounded-pill mb-2">İlk Kurulum</span>
                            <h5 class="fw-bold text-dark mb-1">Site / Apartman Kur</h5>
                            <p class="text-muted small mb-0">Sitenizi bağımsız kimliğiyle tanımlayın, blokları ve sakinleri ekleyin.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 2. ŞANTİYE & İNŞAAT FİRMASI -->
        @if (activeModules.Contains("construction"))
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Dashboard/Construction" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card border-top border-4 border-primary">
                        <div class="bg-primary text-white p-4 text-center"><i class="bi bi-cone-striped display-5"></i></div>
                        <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                            <div>
                                @if (!hasCompletedAgency)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill mb-2">Profil Eksik (Tamamla)</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary rounded-pill mb-2">İnşaat &amp; Şantiye ERP</span>
                                }
                                <h5 class="fw-bold text-dark mb-1">@(string.IsNullOrWhiteSpace(agencyCompanyName) ? "İnşaat Firmam" : agencyCompanyName)</h5>
                                <p class="text-muted small mb-2">Projeler, bloklar, CAD metrajları, hakediş ve taşeron.</p>
                            </div>
                            <div class="pt-2">
                                <span class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold">Şantiye Paneline Gir &rarr;</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 3. ÜYE OLUNAN SİTE SAKİN / KURUL PORTALLARI (Sadece Malik/Kiracı/Aza/Denetçi — Yönetici bloklarını listelemez) -->
        @foreach (var pb in portalBuildingLinks)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/FacilityPortal/Index?buildingId=@pb.BuildingId" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card border-top border-4 border-info">
                        <div class="bg-info bg-gradient text-white p-4 text-center"><i class="bi bi-house-heart-fill display-5"></i></div>
                        <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-info-subtle text-info-emphasis rounded-pill mb-2">@pb.RoleSummary</span>
                                <h5 class="fw-bold text-dark mb-1">@pb.BuildingName @(!string.IsNullOrWhiteSpace(pb.BlockName) ? $"({pb.BlockName})" : "")</h5>
                                <p class="text-muted small mb-2">@pb.DoorsSummary — Arıza bildirimi, toplantı, karar ve aidatlar.</p>
                            </div>
                            <div class="pt-2">
                                <span class="btn btn-sm btn-outline-info rounded-pill px-4 fw-semibold text-dark">Portala Gir &rarr;</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 4. KİŞİSEL EVİM & MÜLK KOKPİTİ (Tüm kullanıcılar için standart; isteğe bağlı 15 gün demo -> Tek/Çoklu Mülk) -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card border-top border-4 border-dark">
                <div class="bg-dark text-white p-4 text-center"><i class="bi bi-person-workspace display-5 text-warning"></i></div>
                <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge @(quotaSummary.HasPaidPropertyPlan ? "bg-success" : (quotaSummary.IsPropertyDemoActive ? "bg-primary" : (quotaSummary.IsPropertyDemoExpired ? "bg-danger" : "bg-warning text-dark"))) rounded-pill mb-2">
                            @quotaSummary.PropertyPlanStatusLabel
                        </span>
                        <h5 class="fw-bold text-dark mb-1">Evim &amp; Mülk Kokpiti</h5>
                        <p class="text-muted small mb-3">
                            Sabit faturalar, daire içi foto/demirbaş, bölge analizi ve ilan.
                            @if (!quotaSummary.HasPropertySubscriptionStarted)
                            {
                                <span class="d-block text-dark fw-semibold mt-1">Sunucu kotası için 15 günlük demoyu istediğiniz zaman başlatabilirsiniz.</span>
                            }
                        </p>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @if (!quotaSummary.HasPropertySubscriptionStarted)
                        {
                            <form asp-action="StartPropertyDemo" asp-controller="Dashboard" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill w-100">
                                    ⏳ 15 Gün Ücretsiz Demo Başlat
                                </button>
                            </form>
                        }
                        <div class="d-flex gap-2">
                            <a href="/DigitalHome/Index" class="btn btn-sm btn-outline-dark rounded-pill flex-fill fw-semibold">
                                <i class="bi bi-receipt me-1"></i> Faturalarım
                            </a>
                            <a href="/Landlord/Dashboard" class="btn btn-sm btn-dark rounded-pill flex-fill fw-semibold">
                                <i class="bi bi-house-gear me-1"></i> Dairem &amp; İlan
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. DİĞER AKTİF İŞ MODÜLLERİ -->
        @if (activeModules.Contains("realestate"))
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Dashboard/Corporate" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-warning text-white p-4 text-center"><i class="bi bi-briefcase display-5"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Kurumsal Emlak</h5>
                            <p class="text-muted small mb-0">Ofis yönetimi, danışmanlar, EIDS ve portföy takibi.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (activeModules.Contains("hotel"))
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Dashboard/CommercialRenter" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-danger text-white p-4 text-center"><i class="bi bi-calendar-range display-5"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Otel &amp; Günübirlik</h5>
                            <p class="text-muted small mb-0">KBS bildirimleri, rezervasyon takvimi.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (activeModules.Contains("service"))
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Dashboard/ServiceProvider" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-info text-white p-4 text-center"><i class="bi bi-tools display-5"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Usta &amp; Hizmet</h5>
                            <p class="text-muted small mb-0">Gelen iş talepleri, randevular ve teklifler.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (activeModules.Contains("supplier"))
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Dashboard/Supplier" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-secondary text-white p-4 text-center"><i class="bi bi-shop display-5"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Esnaf &amp; Tedarikçi</h5>
                            <p class="text-muted small mb-0">Malzeme satışları ve şantiye toptan siparişleri.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (activeModules.Contains("seeker"))
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Dashboard/Individual" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card bg-light">
                        <div class="p-4 text-center border-bottom"><i class="bi bi-search-heart display-5 text-danger"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Ev Arayan</h5>
                            <p class="text-muted small mb-0">Favori ilanlar, randevular ve mesajlar.</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- İş Modülleri Modalı -->
<div class="modal fade" id="moduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 bg-primary text-white rounded-top-4 p-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-grid-fill me-2"></i> Kurumsal &amp; İş Modüllerim</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-light border rounded-3 small mb-3">
                    <i class="bi bi-info-circle-fill text-primary me-1"></i>
                    <strong>Evim &amp; Mülk Kokpiti (15 Gün Demo)</strong> tüm üyelerimizde zaten açıktır. Buradan yalnızca profesyonel/iş modüllerinizi seçin.
                </div>

                <form id="moduleForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="construction" id="mod1" @(activeModules.Contains("construction") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod1">
                                    <i class="bi bi-cone-striped text-primary me-1"></i> İnşaat &amp; Şantiye Firmasıyım
                                    <small class="text-muted d-block fw-normal mt-1">Projeler, bloklar, CAD metraj, taşeron.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="facility" id="mod2" @(activeModules.Contains("facility") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod2">
                                    <i class="bi bi-building text-success me-1"></i> Site / Bina Yöneticisiyim
                                    <small class="text-muted d-block fw-normal mt-1">Bağımsız site veya yönetim firması paneli.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="realestate" id="mod3" @(activeModules.Contains("realestate") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod3">
                                    <i class="bi bi-briefcase text-warning me-1"></i> Kurumsal Emlak Ofisiyim
                                    <small class="text-muted d-block fw-normal mt-1">İlan portföyü, danışman yönetimi, CRM.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="service" id="mod4" @(activeModules.Contains("service") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod4">
                                    <i class="bi bi-tools text-info me-1"></i> Usta veya Hizmet Verenim
                                    <small class="text-muted d-block fw-normal mt-1">Gelen tamirat ve iş talepleri, keşif ajandası.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="supplier" id="mod5" @(activeModules.Contains("supplier") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod5">
                                    <i class="bi bi-shop text-secondary me-1"></i> Esnaf / Malzeme Tedarikçisiyim
                                    <small class="text-muted d-block fw-normal mt-1">Şantiyelere malzeme satışı ve toptan sipariş.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="hotel" id="mod6" @(activeModules.Contains("hotel") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod6">
                                    <i class="bi bi-calendar-range text-danger me-1"></i> Otel / Günlük Kiralayanım
                                    <small class="text-muted d-block fw-normal mt-1">Gecelik rezervasyon ajandası ve KBS bildirimi.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm bg-light h-100">
                                <input class="form-check-input ms-1 me-3 fs-5" type="checkbox" name="modules" value="seeker" id="mod8" @(activeModules.Contains("seeker") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod8">
                                    <i class="bi bi-search-heart text-dark me-1"></i> Sadece Ev / Hizmet Arayanım
                                    <small class="text-muted d-block fw-normal mt-1">Favori ilanlar, randevular ve mesajlar.</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-primary rounded-pill px-5 fw-bold" onclick="saveModules()">
                            Seçimlerimi Kaydet <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .hub-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hub-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
</style>

@section Scripts {
    <script>
        function saveModules() {
            const checkboxes = document.querySelectorAll('input[name="modules"]:checked');
            let selected = [];
            checkboxes.forEach((cb) => selected.push(cb.value));

            fetch('/Dashboard/UpdateModules', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(selected)
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Hata! Lütfen tekrar deneyin.');
                }
            });
        }
    </script>
}
