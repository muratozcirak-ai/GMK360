@{
    ViewData["Title"] = "Uygulama Merkezi (Hub)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string activeModules = ViewBag.ActiveModules as string ?? "";
    bool hasModules = !string.IsNullOrEmpty(activeModules);
}

<div class="container py-5 mt-4">
    <!-- MERKEZİ AJANDA (GLOBAL DASHBOARD) -->
    @if (hasModules)
    {
        <div class="row mb-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 bg-light">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-event me-2"></i> Merkezi Ajanda (Tüm Rollerim)</h5>
                            <button class="btn btn-sm btn-outline-dark rounded-pill" onclick="new bootstrap.Modal(document.getElementById('moduleModal')).show()">
                                <i class="bi bi-sliders me-1"></i> Modüllerimi Yönet
                            </button>
                        </div>
                        <div class="row g-3">
                            <!-- Örnek birleşik takvim verileri -->
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-warning">
                                    <small class="text-muted d-block mb-1">Emlak Portföyü</small>
                                    <strong>14:00</strong> - Kadıköy 3+1 Daire Gösterimi
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-primary">
                                    <small class="text-muted d-block mb-1">Şantiye ERP</small>
                                    <strong>16:30</strong> - Denge Towers Seramik Sipariş Onayı
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded shadow-sm border-start border-4 border-info">
                                    <small class="text-muted d-block mb-1">Usta Paneli</small>
                                    <strong>Yarın 10:00</strong> - Ataşehir Su Tesisatı Keşfi
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="text-center mb-4">
        <h2 class="fw-bold display-6 mb-2">Çalışma Alanınızı Seçin</h2>
        <p class="text-muted fs-5">Sadece aktif kullandığınız modülleri görüyorsunuz.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- 1. İnşaat -->
        @if (activeModules.Contains("construction"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/Construction" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-primary text-white p-4 text-center"><i class="bi bi-cone-striped display-4"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Şantiye & İnşaat</h5>
                            <p class="text-muted small mb-0">Bloklar, daireler, CAD planları, imalat ve taşeron.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 2. Bina Yönetimi -->
        @if (activeModules.Contains("facility"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/BuildingManager/Index" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-success text-white p-4 text-center"><i class="bi bi-building display-4"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Site Yönetimi</h5>
                            <p class="text-muted small mb-0">Aidat takibi, giderler, güvenlik, sakin duyuruları.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 3. Emlak -->
        @if (activeModules.Contains("realestate"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/Corporate" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-warning text-white p-4 text-center"><i class="bi bi-briefcase display-4"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Kurumsal Emlak</h5>
                            <p class="text-muted small mb-0">Ofis yönetimi, danışmanlar, EIDS ve portföy takibi.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 4. Otel -->
        @if (activeModules.Contains("hotel"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/CommercialRenter" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-danger text-white p-4 text-center"><i class="bi bi-calendar-range display-4"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Otel & Günübirlik</h5>
                            <p class="text-muted small mb-0">KBS bildirimleri, rezervasyon takvimi.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 5. Usta -->
        @if (activeModules.Contains("service"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/ServiceProvider" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-info text-white p-4 text-center"><i class="bi bi-tools display-4"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Usta & Hizmet</h5>
                            <p class="text-muted small mb-0">Gelen iş talepleri, randevular ve teklifler.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 6. Esnaf -->
        @if (activeModules.Contains("supplier"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/Supplier" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card">
                        <div class="bg-secondary text-white p-4 text-center"><i class="bi bi-shop display-4"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Esnaf & Tedarikçi</h5>
                            <p class="text-muted small mb-0">Malzeme satışları ve şantiye toptan siparişleri.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 7. Bireysel Satıcı -->
        @if (activeModules.Contains("owner"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/PropertyOwner" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card bg-light">
                        <div class="p-4 text-center border-bottom"><i class="bi bi-house-add display-4 text-primary"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Bireysel Satıcı</h5>
                            <p class="text-muted small mb-0">Sahibinden ilan verme, kira sözleşmeleri.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- 8. Ev Arayan -->
        @if (activeModules.Contains("seeker"))
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Dashboard/Individual" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hub-card bg-light">
                        <div class="p-4 text-center border-bottom"><i class="bi bi-search-heart display-4 text-danger"></i></div>
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark mb-2">Ev Arayan</h5>
                            <p class="text-muted small mb-0">Favori ilanlar, randevular ve mesajlar.</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        
        @if (!hasModules)
        {
            <div class="col-12 text-center mt-5">
                <h4 class="text-muted">Henüz hiçbir modül seçmediniz.</h4>
                <button class="btn btn-primary rounded-pill px-5 py-3 fw-bold mt-3" onclick="new bootstrap.Modal(document.getElementById('moduleModal')).show()">
                    <i class="bi bi-plus-circle me-2"></i> Modüllerimi Seç
                </button>
            </div>
        }
    </div>
</div>

<!-- Modül Seçim Modal'ı -->
<div class="modal fade" id="moduleModal"  tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 bg-primary text-white rounded-top-4 p-4">
                <h4 class="modal-title fw-bold"><i class="bi bi-grid-fill me-2"></i> GMK360'ı Hangi Amaçlarla Kullanacaksınız?</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted fs-5 mb-4">Size özel temiz bir yönetim paneli sunabilmemiz için sadece kullanacağınız modülleri işaretleyin. (Sonradan değiştirebilirsiniz)</p>
                
                <form id="moduleForm">
                    <div class="row g-3">
                        <!-- Seçenekler -->
                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="construction" id="mod1" @(activeModules.Contains("construction") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod1">
                                    <i class="bi bi-cone-striped text-primary me-1"></i> İnşaat & Şantiye Firmasıyım
                                    <small class="text-muted d-block fw-normal mt-1">Projeler, bloklar, daire imalat seçimleri, taşeron.</small>
                                </label>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="facility" id="mod2" @(activeModules.Contains("facility") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod2">
                                    <i class="bi bi-building text-success me-1"></i> Site / Bina Yöneticisiyim
                                    <small class="text-muted d-block fw-normal mt-1">Aidat takibi, giderler, karar defterleri, arıza takibi.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="realestate" id="mod3" @(activeModules.Contains("realestate") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod3">
                                    <i class="bi bi-briefcase text-warning me-1"></i> Kurumsal Emlak Ofisiyim / Danışmanım
                                    <small class="text-muted d-block fw-normal mt-1">İlan portföyü, danışman yönetimi, müşteri (CRM) ajandası.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="service" id="mod4" @(activeModules.Contains("service") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod4">
                                    <i class="bi bi-tools text-info me-1"></i> Usta veya Hizmet Verenim
                                    <small class="text-muted d-block fw-normal mt-1">Gelen tamirat ve iş talepleri, keşif ajandası, vitrin.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="supplier" id="mod5" @(activeModules.Contains("supplier") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod5">
                                    <i class="bi bi-shop text-secondary me-1"></i> Esnaf veya Malzeme Tedarikçisiyim
                                    <small class="text-muted d-block fw-normal mt-1">Şantiyelere malzeme satışı, katalog ve toptan sipariş.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="hotel" id="mod6" @(activeModules.Contains("hotel") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod6">
                                    <i class="bi bi-calendar-range text-danger me-1"></i> Otel veya Günlük Kiralayanım
                                    <small class="text-muted d-block fw-normal mt-1">Gecelik rezervasyon ajandası ve KBS emniyet bildirimi.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm bg-light">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="owner" id="mod7" @(activeModules.Contains("owner") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod7">
                                    <i class="bi bi-house-add text-dark me-1"></i> Bireysel Ev/Mülk Sahibiyim
                                    <small class="text-muted d-block fw-normal mt-1">Sahibinden ilan verme, kira gelirlerimi takip etme.</small>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded shadow-sm bg-light">
                                <input class="form-check-input ms-1 me-3 fs-4" type="checkbox" name="modules" value="seeker" id="mod8" @(activeModules.Contains("seeker") ? "checked" : "")>
                                <label class="form-check-label fw-bold d-block" for="mod8">
                                    <i class="bi bi-search-heart text-dark me-1"></i> Sadece Ev/Hizmet Arayanım
                                    <small class="text-muted d-block fw-normal mt-1">Favori ilanlar, emlakçılarla randevular, usta bulma.</small>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-end mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-primary rounded-pill px-5 fw-bold" onclick="saveModules()">
                            Seçimlerimi Kaydet ve Başla <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .hub-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }
    .hub-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var hasModules = '@hasModules' === 'True';
            if (!hasModules) {
                var modal = new bootstrap.Modal(document.getElementById('moduleModal'));
                modal.show();
            }
        });

        function saveModules() {
            const checkboxes = document.querySelectorAll('input[name="modules"]:checked');
            let selected = [];
            checkboxes.forEach((cb) => {
                selected.push(cb.value);
            });

            if(selected.length === 0) {
                alert("Lütfen en az bir modül seçiniz!");
                return;
            }
            if (confirm('Seçtiğiniz ek modüller ücrete tabidir. Ödeme altyapısı (Iyzico) entegrasyonu test aşamasındadır.\n\nTest Modu: Ücretsiz Onaylamak istiyor musunuz?')) {
                fetch('/Dashboard/UpdateModules', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(selected)
                })
                .then(response => {
                    if(response.ok) {
                        alert('Başarılı! Modüller aktif edildi.');
                        window.location.reload();
                    } else {
                        alert('Hata! Bir hata oluştu, lütfen tekrar deneyin.');
                    }
                });
            }
        }
    </script>
}





