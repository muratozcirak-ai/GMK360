@{
    ViewData["Title"] = "Müşteri Değerlendirmeleri";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 text-primary fw-bold">Müşteri Değerlendirmeleri</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Müşterilerinizden gelen geri bildirimleri ve anket puanlarını burada görebilirsiniz.</p>
        
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> Puanınız ve yorumlarınız vitrin profilinizde gösterilir. Yüksek puan, daha fazla müşteri demektir!
        </div>

        <div class="text-center py-5">
            <i class="bi bi-star text-warning" style="font-size: 3rem;"></i>
            <h3 class="mt-3">Henüz Değerlendirme Yok</h3>
            <p class="text-muted">Müşterileriniz sizinle çalıştıkça puan ve yorum bırakabilirler.</p>
        </div>
    </div>
</div>
