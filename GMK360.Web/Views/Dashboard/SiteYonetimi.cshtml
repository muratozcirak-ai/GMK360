@model IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>
@{
    ViewData["Title"] = "Kurumsal Web Sitem (CMS)";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    var agencyName = ViewBag.AgencyName?.ToString() ?? "Firmam";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-layout-text-window text-primary me-2"></i>Kurumsal Web Sitem (CMS)</h2>
        <p class="text-muted mb-0"><b>@agencyName</b> kurumsal web sitenizin içeriklerini ve vitrin projelerinizi buradan yönetin.</p>
    </div>
    <a href="#" class="btn btn-outline-primary rounded-pill px-4 shadow-sm" onclick="alert('Demo: Web siteniz çok yakında bu butondan canlı yayına girecek!')">
        <i class="bi bi-box-arrow-up-right me-2"></i> Canlı Siteyi Görüntüle
    </a>
</div>

<div class="row g-4 mb-5">
    <!-- Genel Ayarlar -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-gear-fill text-primary fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Genel Ayarlar & İletişim</h5>
                </div>
                <p class="text-muted small mb-4">Logo, iletişim bilgileri, adres, sosyal medya linkleri ve hakkımızda yazılarınızı güncelleyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-dark border shadow-sm">Ayarları Düzenle</button>
            </div>
        </div>
    </div>

    <!-- Fotoğraf ve Medya Galerisi -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-images text-success fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Slayt ve Galeri Yönetimi</h5>
                </div>
                <p class="text-muted small mb-4">Web sitenizin ana sayfa banner görsellerini (Slider), ofis fotoğraflarını ve kurumsal medya varlıklarını ekleyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-success border shadow-sm">Galeriye Git</button>
            </div>
        </div>
    </div>
</div>

<!-- Vitrin Projeler (Showcase) -->
<h4 class="fw-bold mb-3"><i class="bi bi-buildings-fill text-orange me-2"></i> Vitrin Projeleri Yönetimi</h4>
<p class="text-muted mb-4">
    Web sitenizde sergilenmesini istediğiniz projeleri seçin. Müşterileriniz (B2C) seçtiğiniz vitrin projelerinize web sitenizden ulaşabilecektir.
</p>

<div class="row g-4">
    @if(!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-light border border-dashed rounded-4 text-center p-5">
                <i class="bi bi-building fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold">Henüz hiç projeniz yok</h5>
                <p class="text-muted">Proje oluşturduktan sonra web sitenizde sergilemek üzere buradan seçebilirsiniz.</p>
            </div>
        </div>
    }
    
    @foreach(var project in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                
                @if(project.Status == GMK360.Core.Entities.Construction.ProjectStatus.Tamamlandi_Teslim)
                {
                    <div class="position-absolute top-0 start-0 m-3 badge bg-success shadow" style="z-index: 10;">
                        <i class="bi bi-check-circle-fill me-1"></i> Tamamlandı
                    </div>
                }
                else if(project.Status == GMK360.Core.Entities.Construction.ProjectStatus.Satista_Topraktan)
                {
                    <div class="position-absolute top-0 start-0 m-3 badge bg-orange shadow text-white" style="z-index: 10;">
                        <i class="bi bi-megaphone-fill me-1"></i> Satışta
                    </div>
                }

                <img src="@(!string.IsNullOrEmpty(project.CoverImageUrl) ? project.CoverImageUrl : "/images/placeholder-building.jpg")" class="card-img-top" style="height: 180px; object-fit: cover;" alt="Proje Resmi">
                
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="card-title fw-bold">@project.Name</h5>
                    <p class="card-text small text-muted mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @(string.IsNullOrEmpty(project.Description) ? "Bu proje için henüz açıklama girilmedi." : project.Description)
                    </p>
                    
                    <div class="mt-auto pt-3 border-top">
                        <div class="form-check form-switch form-switch-lg d-flex align-items-center mb-0 p-0">
                            <input class="form-check-input ms-0 me-3 toggle-publish" type="checkbox" role="switch" style="width: 3rem; height: 1.5rem;" data-id="@project.Id" @(project.IsPublishedOnWeb ? "checked" : "")>
                            <label class="form-check-label fw-bold @(project.IsPublishedOnWeb ? "text-primary" : "text-muted")" id="lbl-@project.Id">
                                @(project.IsPublishedOnWeb ? "Web Sitemde Yayında" : "Sitede Gizli")
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.toggle-publish').change(function () {
                var isChecked = $(this).is(':checked');
                var projectId = $(this).data('id');
                var label = $('#lbl-' + projectId);
                
                // UI update
                if (isChecked) {
                    label.text("Web Sitemde Yayında");
                    label.removeClass("text-muted").addClass("text-primary");
                } else {
                    label.text("Sitede Gizli");
                    label.removeClass("text-primary").addClass("text-muted");
                }
                
                // AJAX isteği
                $.post('/Dashboard/ToggleWebPublish', { projectId: projectId, isPublished: isChecked }, function (res) {
                    if (!res.success) {
                        alert("İşlem sırasında bir hata oluştu. Lütfen tekrar deneyin.");
                    }
                });
            });
        });
    </script>
}
