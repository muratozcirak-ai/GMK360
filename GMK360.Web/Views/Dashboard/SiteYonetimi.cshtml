@model IEnumerable<GMK360.Core.Entities.Construction.ConstructionProject>
@{
    ViewData["Title"] = "Kurumsal Web Sitem (CMS)";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    var agencyName = ViewBag.AgencyName?.ToString() ?? "Firmam";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-globe2 text-primary me-2"></i>Kurumsal Web Sitem (CMS)</h2>
        <p class="text-muted mb-0"><b>@agencyName</b> kurumsal web sitenizin içeriklerini, domain ayarlarını ve vitrin projelerinizi buradan yönetin.</p>
    </div>
    <a href="#" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold hover-scale" onclick="alert('Demo: Web siteniz yakında yayına girecek!')">
        <i class="bi bi-box-arrow-up-right me-2"></i> Canlı Siteyi Görüntüle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success shadow-sm rounded-4 mb-4 border-0 border-start border-success border-5">
        <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
        <strong>@TempData["SuccessMessage"]</strong>
    </div>
}

<div class="row g-4 mb-5">
    <!-- Genel Ayarlar -->
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 border-top border-primary border-4 hover-shadow">
            <div class="card-body p-4 text-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-building-gear text-primary fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Kurumsal Kimlik</h5>
                <p class="text-muted small mb-4">Logo, Hakkımızda, Misyon ve iletişim bilgileri.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#kimlikModal">Ayarları Düzenle</button>
            </div>
        </div>
    </div>

    <!-- Fotoğraf ve Medya Galerisi -->
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 border-top border-success border-4 hover-shadow">
            <div class="card-body p-4 text-center">
                <div class="bg-success bg-opacity-10 p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-images text-success fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Slayt & Galeri</h5>
                <p class="text-muted small mb-4">Ana sayfa banner (Slider) ve kurumsal fotoğraflar.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-success shadow-sm" onclick="alert('Galeri modülü hazırlanıyor.')">Galeriye Git</button>
            </div>
        </div>
    </div>

    <!-- Domain & SEO (YENİ EKLENDİ) -->
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 border-top border-warning border-4 hover-shadow">
            <div class="card-body p-4 text-center">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-search text-warning fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Alan Adı & SEO</h5>
                <p class="text-muted small mb-4">www.firmaniz.com bağlama ve Google arama ayarları.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-warning shadow-sm" data-bs-toggle="modal" data-bs-target="#seoModal">SEO & Domain</button>
            </div>
        </div>
    </div>

    <!-- Ekibimiz & Kadro (YENİ EKLENDİ) -->
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 border-top border-info border-4 hover-shadow">
            <div class="card-body p-4 text-center">
                <div class="bg-info bg-opacity-10 p-3 rounded-circle d-inline-block mb-3">
                    <i class="bi bi-people-fill text-info fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Kadro (Ekibimiz)</h5>
                <p class="text-muted small mb-4">Mimar, mühendis ve yöneticilerinizi sitede sergileyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-info shadow-sm" onclick="alert('Personel vitrini yakında!')">Ekibi Yönet</button>
            </div>
        </div>
    </div>
</div>

<!-- Vitrin Projeler (Showcase) -->
<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-buildings-fill text-orange me-2"></i> Vitrin Projeleri (Portföy)</h4>
        <p class="text-muted mb-0">Hangi projelerinizin web sitenizde müşterilere sergileneceğini seçin.</p>
    </div>
</div>

<div class="row g-4">
    @if(!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-light border border-dashed rounded-4 text-center p-5">
                <i class="bi bi-building fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold">Henüz hiç projeniz yok</h5>
                <p class="text-muted">Faz 0 veya Faz 1 aşamasında proje oluşturduktan sonra web sitenizde sergilemek üzere buradan seçebilirsiniz.</p>
            </div>
        </div>
    }
    
    @foreach(var project in Model)
    {
        <div class="col-xl-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-shadow">
                
                @if(project.Status == GMK360.Core.Entities.Construction.ProjectStatus.Tamamlandi_Teslim)
                {
                    <div class="position-absolute top-0 start-0 m-3 badge bg-success shadow fs-6" style="z-index: 10;">
                        <i class="bi bi-check-circle-fill me-1"></i> Tamamlandı (Referans)
                    </div>
                }
                else if(project.Status == GMK360.Core.Entities.Construction.ProjectStatus.Satista_Topraktan)
                {
                    <div class="position-absolute top-0 start-0 m-3 badge bg-orange shadow text-white fs-6" style="z-index: 10;">
                        <i class="bi bi-megaphone-fill me-1"></i> Satışta
                    </div>
                }
                else if(project.Status == GMK360.Core.Entities.Construction.ProjectStatus.On_Gorusme_Talep)
                {
                    <div class="position-absolute top-0 start-0 m-3 badge bg-secondary shadow text-white fs-6" style="z-index: 10;">
                        <i class="bi bi-file-earmark-text me-1"></i> Görüşmeler Devam Ediyor
                    </div>
                }

                <img src="@(!string.IsNullOrEmpty(project.CoverImageUrl) ? project.CoverImageUrl : "/images/placeholder-building.jpg")" class="card-img-top bg-light" style="height: 220px; object-fit: cover;" alt="Proje Resmi">
                
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="card-title fw-bold text-dark mb-2">@project.Name</h5>
                    <p class="card-text small text-muted mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @(string.IsNullOrEmpty(project.Description) ? "Bu proje için henüz bir tanıtım yazısı veya açıklama girilmedi." : project.Description)
                    </p>
                    
                    <div class="mt-auto bg-light rounded-4 p-3 d-flex justify-content-between align-items-center">
                        <div class="form-check form-switch form-switch-lg mb-0 p-0 d-flex align-items-center">
                            <input class="form-check-input ms-0 me-3 toggle-publish border-secondary" type="checkbox" role="switch" style="width: 3rem; height: 1.5rem; cursor:pointer;" data-id="@project.Id" @(project.IsPublishedOnWeb ? "checked" : "")>
                            <label class="form-check-label fw-bold @(project.IsPublishedOnWeb ? "text-primary" : "text-muted")" id="lbl-@project.Id" style="cursor:pointer;">
                                @(project.IsPublishedOnWeb ? "Web Sitemde Yayında" : "Sitede Gizli")
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODALS -->

<!-- Kurumsal Kimlik Modal -->
<div class="modal fade" id="kimlikModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-building-gear text-primary me-2"></i> Kurumsal Kimlik Ayarları</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <form>
                    <div class="mb-4 text-center">
                        <img src="/images/placeholder-logo.png" class="rounded-3 shadow-sm bg-white p-2 mb-3" style="width: 150px; height: 150px; object-fit: contain;">
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-upload me-1"></i> Yeni Logo Yükle</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold form-label">Firma Sloganı</label>
                        <input type="text" class="form-control rounded-3" value="Geleceği Sağlam Temeller Üzerine İnşa Ediyoruz" />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold form-label">Hakkımızda (Kısa Yazı)</label>
                        <textarea class="form-control rounded-3" rows="4">1998'den beri güvenle...</textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="fw-bold form-label">WhatsApp İletişim</label>
                            <input type="text" class="form-control rounded-3" placeholder="+90 5XX XXX XX XX" />
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold form-label">E-Posta</label>
                            <input type="email" class="form-control rounded-3" placeholder="bilgi@firmaniz.com" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('Kurumsal kimlik güncellendi!')">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- SEO & Domain Modal -->
<div class="modal fade" id="seoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-search text-warning me-2"></i> Alan Adı ve SEO Yapılandırması</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <form>
                    <div class="mb-3">
                        <label class="fw-bold form-label">Özel Alan Adı (Domain)</label>
                        <div class="input-group mb-2 shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-secondary">www.</span>
                            <input type="text" class="form-control border-secondary" placeholder="dengehaninsaat.com" />
                        </div>
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Alan adınızı bağlamak için DNS ayarlarından A kaydını sistemimize yönlendirmelisiniz.</small>
                    </div>
                    <hr class="my-4 opacity-25">
                    <div class="mb-3">
                        <label class="fw-bold form-label">Google Analytics (G-Tag)</label>
                        <input type="text" class="form-control rounded-3" placeholder="G-XXXXXXXXXX" />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold form-label">SEO Başlığı (Meta Title)</label>
                        <input type="text" class="form-control rounded-3" value="Dengehan İnşaat | Kalite ve Güven" />
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-warning fw-bold rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('SEO ayarları kaydedildi!')">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow { transition: box-shadow 0.3s ease, transform 0.3s ease; }
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: scale(1.05); }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.toggle-publish').change(function () {
                var isChecked = $(this).is(':checked');
                var projectId = $(this).data('id');
                var label = $('#lbl-' + projectId);
                
                // UI update
                if (isChecked) {
                    label.text("Web Sitemde Yayında");
                    label.removeClass("text-muted").addClass("text-primary");
                } else {
                    label.text("Sitede Gizli");
                    label.removeClass("text-primary").addClass("text-muted");
                }
                
                // AJAX isteği
                $.post('/Dashboard/ToggleWebPublish', { projectId: projectId, isPublished: isChecked }, function (res) {
                    if (!res.success) {
                        alert("İşlem sırasında bir hata oluştu. Lütfen tekrar deneyin.");
                    }
                });
            });
        });
    </script>
}
