@{
    ViewData["Title"] = "Site Yönetimi (CMS)";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-layout-text-window text-primary me-2"></i>Site Yönetimi (CMS)</h2>
        <p class="text-muted mb-0">Alt alan adınızdaki (subdomain) kurumsal web sitenizin içeriklerini buradan yönetin.</p>
    </div>
    <a href="https://dengegrup.localhost:7109/" target="_blank" class="btn btn-outline-primary rounded-pill px-4">
        <i class="bi bi-box-arrow-up-right me-2"></i> Sitemi Görüntüle
    </a>
</div>

<div class="row g-4">
    <!-- Genel Ayarlar -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-gear-fill text-primary fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Genel Ayarlar</h5>
                </div>
                <p class="text-muted small mb-4">Logo, iletişim bilgileri, sosyal medya linkleri ve SEO ayarlarınızı güncelleyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-dark border">Ayarları Düzenle</button>
            </div>
        </div>
    </div>

    <!-- Fotoğraf ve Medya Galerisi -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-images text-success fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Fotoğraf ve Vitrin</h5>
                </div>
                <p class="text-muted small mb-4">Ana sayfa banner görsellerini (Slider), ofis fotoğraflarını ve vizyon/misyon görsellerini ekleyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-success border">Galeriye Git</button>
            </div>
        </div>
    </div>

    <!-- Belge Arşivi -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-folder-fill text-warning fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Belge Arşivi</h5>
                </div>
                <p class="text-muted small mb-4">Müşterilerinizle veya ekibinizle paylaşacağınız teknik şartnameler, kat planları (PDF) ve sözleşmeleri yükleyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-warning border">Arşivi Yönet</button>
            </div>
        </div>
    </div>

    <!-- Dinamik Tanımlamalar -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-tags-fill text-info fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Tanımlamalar (Veritabanı)</h5>
                </div>
                <p class="text-muted small mb-4">Sitenizde kullanılacak malzeme tipleri, proje özellikleri gibi dinamik kategorileri (Definition) ekleyin.</p>
                <button class="btn btn-light w-100 rounded-pill fw-bold text-info border">Tanımlara Git</button>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-primary mt-5 rounded-4 border-0 d-flex align-items-center p-4">
    <i class="bi bi-megaphone-fill fs-2 me-4"></i>
    <div>
        <h5 class="fw-bold mb-1">Toplantı & Ajanda Modülü Çok Yakında!</h5>
        <p class="mb-0 small">B2B CRM altyapısı ile müşterileriniz ve tedarikçileriniz ile toplantılarınızı (Ajanda) buradan organize edebileceksiniz.</p>
    </div>
</div>
