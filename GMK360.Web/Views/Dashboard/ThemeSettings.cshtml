@model GMK360.Web.ViewModels.ThemeSettingsViewModel
@{
    ViewData["Title"] = "Kurumsal Kimlik & Tema Ayarları";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold" style="background: -webkit-linear-gradient(45deg, #8e44ad, #3498db); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Kurumsal Kimlik & Tema Ayarları
            </h2>
            <p class="text-muted">Ofisinizin alt alan adı (subdomain), özel alan adı ve görsel ayarlarını buradan yapılandırın.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <form asp-action="ThemeSettings" method="post">
                        <input type="hidden" asp-for="AgencyId" />

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Alan Adı Ayarları (DNS)</h5>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Subdomain" class="form-label fw-semibold text-muted small">Alt Alan Adı (Subdomain)</label>
                                <div class="input-group">
                                    <input asp-for="Subdomain" class="form-control bg-light border-0" placeholder="Örn: remax-yildiz" />
                                    <span class="input-group-text bg-light border-0 text-muted">.gmk360.com</span>
                                </div>
                                <span asp-validation-for="Subdomain" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CustomDomain" class="form-label fw-semibold text-muted small">Özel Alan Adı (Custom Domain)</label>
                                <input asp-for="CustomDomain" class="form-control bg-light border-0" placeholder="Örn: www.ofisiniz.com" />
                                <span asp-validation-for="CustomDomain" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2 mt-4">Renk ve Tipografi</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ThemePrimaryColor" class="form-label fw-semibold text-muted small">Ana Renk</label>
                                <div class="d-flex align-items-center">
                                    <input type="color" asp-for="ThemePrimaryColor" class="form-control form-control-color bg-light border-0 me-2" title="Ana Renk Seçin">
                                    <input type="text" asp-for="ThemePrimaryColor" class="form-control bg-light border-0" placeholder="#000000">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ThemeSecondaryColor" class="form-label fw-semibold text-muted small">İkincil Renk</label>
                                <div class="d-flex align-items-center">
                                    <input type="color" asp-for="ThemeSecondaryColor" class="form-control form-control-color bg-light border-0 me-2" title="İkincil Renk Seçin">
                                    <input type="text" asp-for="ThemeSecondaryColor" class="form-control bg-light border-0" placeholder="#FFFFFF">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ThemeAccentColor" class="form-label fw-semibold text-muted small">Vurgu Rengi</label>
                                <div class="d-flex align-items-center">
                                    <input type="color" asp-for="ThemeAccentColor" class="form-control form-control-color bg-light border-0 me-2" title="Vurgu Rengi Seçin">
                                    <input type="text" asp-for="ThemeAccentColor" class="form-control bg-light border-0" placeholder="#FFC107">
                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="FontFamily" class="form-label fw-semibold text-muted small">Font Ailesi</label>
                                <select asp-for="FontFamily" class="form-select bg-light border-0">
                                    <option value="'Inter', sans-serif">Inter (Modern & Temiz)</option>
                                    <option value="'Roboto', sans-serif">Roboto (Klasik & Okunabilir)</option>
                                    <option value="'Outfit', sans-serif">Outfit (Geometrik & Şık)</option>
                                    <option value="'Playfair Display', serif">Playfair Display (Lüks & Kurumsal)</option>
                                    <option value="'Montserrat', sans-serif">Montserrat (Dinamik)</option>
                                </select>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2 mt-4">Logo ve Görseller</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label asp-for="LogoUrl" class="form-label fw-semibold text-muted small">Ana Logo (Header) URL</label>
                                <input asp-for="LogoUrl" class="form-control bg-light border-0" placeholder="https://..." />
                            </div>
                            <div class="col-md-12">
                                <label asp-for="FooterLogoUrl" class="form-label fw-semibold text-muted small">Footer Logo URL (Opsiyonel, karanlık tema için)</label>
                                <input asp-for="FooterLogoUrl" class="form-control bg-light border-0" placeholder="https://..." />
                            </div>
                            <div class="col-md-12">
                                <label asp-for="FaviconUrl" class="form-label fw-semibold text-muted small">Favicon URL (Tarayıcı sekme ikonu)</label>
                                <input asp-for="FaviconUrl" class="form-control bg-light border-0" placeholder="https://..." />
                            </div>
                        </div>

                        <div class="text-end mt-4">
                            <a href="/Dashboard/Corporate" class="btn btn-light rounded-pill px-4 me-2">İptal</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #8e44ad, #3498db); border: none;">
                                Ayarları Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-dark text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-info"></i> DNS Bilgilendirmesi</h5>
                    <p class="small text-light opacity-75">Özel alan adınızı (Custom Domain) sistemimizde kullanabilmeniz için alan adınızın DNS yönetim panelinden aşağıdaki CNAME kaydını eklemeniz gerekmektedir:</p>
                    
                    <div class="bg-black p-3 rounded-3 mb-3">
                        <code class="text-success">CNAME: gmk360.com</code>
                    </div>
                    
                    <p class="small text-light opacity-75 mb-0">DNS yönlendirmeleri 24 saate kadar sürebilir. Yönlendirme tamamlandıktan sonra sistemimiz otomatik olarak SSL sertifikasını (Let's Encrypt) tanımlayacaktır.</p>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-palette text-muted fs-1 opacity-50"></i>
                    </div>
                    <h6 class="fw-bold text-dark">Canlı Önizleme</h6>
                    <p class="small text-muted mb-3">Tema ayarlarınız "Kurumsal Mağaza" görünümünüze anında yansır.</p>
                    <a href="/?context=store" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-4">Mağazayı Görüntüle</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Renk seçici senkronizasyonu
    document.querySelectorAll('input[type="color"]').forEach(colorInput => {
        colorInput.addEventListener('input', function() {
            this.nextElementSibling.value = this.value;
        });
    });
    
    document.querySelectorAll('input[type="text"]').forEach(textInput => {
        if(textInput.previousElementSibling && textInput.previousElementSibling.type === 'color') {
            textInput.addEventListener('input', function() {
                if(/^#[0-9A-F]{6}$/i.test(this.value)) {
                    this.previousElementSibling.value = this.value;
                }
            });
        }
    });
</script>
