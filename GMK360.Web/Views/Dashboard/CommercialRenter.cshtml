@{
    ViewData["Title"] = "Otel / Günlük Kiralama Özeti";
    Layout = "~/Views/Shared/_CommercialRenterLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Palas Butik Otel</h2>
        <p class="text-muted">Toplam 45 Oda - Genel doluluk oranı: %75</p>
    </div>
    <div>
        <a href="/DailyRentalAgenda/Index" class="btn btn-primary rounded-pill fw-bold"><i class="bi bi-calendar-plus me-1"></i> Manuel Rezervasyon Gir</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Bugün Giriş Yapacaklar</h6>
                    <i class="bi bi-door-open fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">8 Oda</h2>
                <small class="opacity-75">Saat 14:00'ten itibaren check-in</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card bg-danger text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">Bugün Çıkış Yapacaklar</h6>
                    <i class="bi bi-door-closed fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">5 Oda</h2>
                <small class="opacity-75">Saat 12:00 check-out saati</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0 fw-bold">KBS Kimlik Bildirimi</h6>
                    <i class="bi bi-shield-check fs-4 opacity-75"></i>
                </div>
                <h2 class="mb-0">Eksik Yok</h2>
                <small class="opacity-75">Tüm aktif konaklayanlar emniyete bildirildi</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <h5 class="fw-bold"><i class="bi bi-house-check text-primary me-2"></i> Yaklaşan Rezervasyonlar</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Misafir</th>
                        <th>Oda Tipi / No</th>
                        <th>Giriş Tarihi</th>
                        <th>Çıkış Tarihi</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>Ayşe Yılmaz</strong><br/>
                            <small class="text-muted">Booking.com</small>
                        </td>
                        <td>Standart Oda (101)</td>
                        <td>Bugün, 14:00</td>
                        <td>3 Gün Sonra</td>
                        <td><span class="badge bg-warning text-dark">Bekleniyor</span></td>
                        <td><button class="btn btn-sm btn-outline-primary rounded-pill">Check-in Yap</button></td>
                    </tr>
                    <tr>
                        <td>
                            <strong>John Doe</strong><br/>
                            <small class="text-muted">Airbnb</small>
                        </td>
                        <td>Suit Oda (205)</td>
                        <td>Yarın, 14:00</td>
                        <td>1 Hafta Sonra</td>
                        <td><span class="badge bg-info text-dark">Onaylı</span></td>
                        <td><button class="btn btn-sm btn-outline-secondary rounded-pill">Detay</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
