@model GMK360.Web.Models.DailyRentalWorkspaceViewModel
@{
    ViewData["Title"] = "Otel / Günlük Kiralama Masası";
    Layout = "~/Views/Shared/_CommercialRenterLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div class="fw-bold">@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.HasFacility)
{
    <!-- DURUM 1: SIFIR MOCKUP - HENÜZ KAYITLI TESİS YOK (ONBOARDING) -->
    <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5 bg-white mb-4">
        <div class="mb-3">
            <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center p-4" style="width: 90px; height: 90px;">
                <i class="bi bi-houses-fill text-danger" style="font-size: 2.8rem;"></i>
            </div>
        </div>

        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 rounded-pill fw-bold mb-3 d-inline-block mx-auto">
            <i class="bi bi-shield-check me-1"></i> Emniyet KBS Uyumlu Konaklama
        </span>

        <h3 class="fw-bold text-dark mb-2">Henüz Kayıtlı Bir Tesis veya Daireniz Bulunmuyor</h3>
        
        <p class="text-muted mx-auto mb-4" style="max-width: 620px;">
            Sistemde sahte/mockup veri yerine kendi gerçek varlıklarınızı yönetirsiniz. 
            Apart, pansiyon, müstakil villa veya kiralık dairelerinizi doğal işleyiş sırasıyla tanımlayın:
        </p>

        <!-- Adım Sıralaması -->
        <div class="row g-3 text-start mb-4">
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <span class="badge bg-primary mb-2">1. ADIM</span>
                    <h6 class="fw-bold text-dark mb-1">Varlık / Yeri Gir</h6>
                    <p class="text-muted small mb-0">İşletmenizin adını, türünü ve konumunu tanımlayın.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <span class="badge bg-success mb-2">2. ADIM</span>
                    <h6 class="fw-bold text-dark mb-1">Oda / Daireleri Ekle</h6>
                    <p class="text-muted small mb-0">Birimlerinizi (1+1, Suit, Oda 101 vb.), kapasite ve gecelik fiyatını belirleyin.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light h-100">
                    <span class="badge bg-danger mb-2">3. ADIM</span>
                    <h6 class="fw-bold text-dark mb-1">Gör ve Yönet</h6>
                    <p class="text-muted small mb-0">Gerçek odalarınızı görün, takvimde rezervasyon alın ve KBS bildirimini yapın.</p>
                </div>
            </div>
        </div>

        <div>
            <a href="/DailyRental/SetupWizard" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm">
                <i class="bi bi-magic me-2"></i> 0'dan Tesis & Oda Kurulum Sihirbazını Başlat &rarr;
            </a>
        </div>
    </div>
}
else
{
    <!-- DURUM 2: GERÇEK TESİS VE GERÇEK BİRİMLER (CANLI YÖNETİM) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 rounded-pill fw-bold">
                    @Model.FacilityType
                </span>
                @if (!string.IsNullOrEmpty(Model.KbsFacilityCode))
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill fw-bold">
                        <i class="bi bi-shield-check me-1"></i> KBS: @Model.KbsFacilityCode
                    </span>
                }
            </div>
            <h2 class="fw-bold mb-0 mt-1">@Model.FacilityName</h2>
            <p class="text-muted mb-0 small">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Address &nbsp;|&nbsp;
                Toplam @Model.TotalUnitsCount Birim &nbsp;|&nbsp;
                Doluluk: %@Model.OccupancyRate.ToString("0")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/DailyRentalAgenda/Index" class="btn btn-primary rounded-pill fw-bold">
                <i class="bi bi-calendar-plus me-1"></i> Rezervasyon Ajandası
            </a>
            <a href="/DailyRental/Index" class="btn btn-outline-secondary rounded-pill fw-bold">
                <i class="bi bi-grid me-1"></i> Oda Masası
            </a>
        </div>
    </div>

    <!-- Gerçek Metrik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="mb-0 fw-bold">Bugün Girişler</h6>
                        <i class="bi bi-door-open fs-4 opacity-75"></i>
                    </div>
                    <h2 class="mb-0">@Model.TodayCheckInsCount Birim</h2>
                    <small class="opacity-75">Saat @Model.CheckInTime'den itibaren check-in</small>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card bg-danger text-white border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="mb-0 fw-bold">Bugün Çıkışlar</h6>
                        <i class="bi bi-door-closed fs-4 opacity-75"></i>
                    </div>
                    <h2 class="mb-0">@Model.TodayCheckOutsCount Birim</h2>
                    <small class="opacity-75">Saat @Model.CheckOutTime check-out saati</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="mb-0 fw-bold">Müsait Odalar</h6>
                        <i class="bi bi-check2-circle fs-4 opacity-75"></i>
                    </div>
                    <h2 class="mb-0">@Model.AvailableUnitsCount / @Model.TotalUnitsCount</h2>
                    <small class="opacity-75">Hemen rezerve edilebilir birim</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tanımlı Birimler Tablosu / Grid -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold"><i class="bi bi-houses text-primary me-2"></i> Tanımlı Birimleriniz (@Model.Units.Count)</h5>
            <a href="/DailyRental/Index" class="btn btn-sm btn-outline-primary rounded-pill">Tümünü Yönet</a>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var unit in Model.Units)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="p-3 border rounded-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-dark">@unit.UnitName</strong>
                                <span class="badge @unit.StatusBadgeClass rounded-pill">@unit.StatusText</span>
                            </div>
                            <div class="small text-muted mb-2">
                                @unit.RoomLayout • @unit.Capacity Kişilik
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark">@unit.DailyRate.ToString("N0") ₺ / Gece</span>
                                <a href="/DailyRental/Index" class="btn btn-sm btn-outline-primary rounded-pill">İşlem</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Yaklaşan Gerçek Rezervasyonlar Tablosu -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i> Rezervasyon Kayıtları</h5>
            <a href="/DailyRentalAgenda/Index" class="btn btn-sm btn-outline-secondary rounded-pill">Takvimi Aç</a>
        </div>
        <div class="card-body">
            @if (Model.Reservations == null || !Model.Reservations.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-calendar-x fs-2 d-block mb-2 opacity-50"></i>
                    <span>Henüz aktif bir rezervasyon bulunmuyor.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Misafir</th>
                                <th>Oda / Daire</th>
                                <th>Giriş Tarihi</th>
                                <th>Çıkış Tarihi</th>
                                <th>Tutar</th>
                                <th>KBS</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.Reservations)
                            {
                                <tr>
                                    <td>
                                        <strong>@res.GuestName</strong><br/>
                                        <small class="text-muted">@res.GuestPhone</small>
                                    </td>
                                    <td>@res.UnitName</td>
                                    <td>@res.StartDate.ToString("dd.MM.yyyy")</td>
                                    <td>@res.EndDate.ToString("dd.MM.yyyy")</td>
                                    <td class="fw-bold text-success">@res.TotalPrice.ToString("N0") ₺</td>
                                    <td>
                                        @if (res.IsKbsReported)
                                        {
                                            <span class="badge bg-success rounded-pill">Bildirildi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill">Bekliyor</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-info text-dark rounded-pill">@res.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
