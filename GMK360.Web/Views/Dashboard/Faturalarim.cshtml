@{
    ViewData["Title"] = "Faturalarım";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 border-0">
        <h5 class="mb-0 text-primary fw-bold">E-Faturalarım</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Platform üzerinden satın aldığınız paketler veya tarafınıza yansıtılan komisyon faturaları burada listelenir.</p>

        <div class="table-responsive mt-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>Fatura No</th>
                        <th>Açıklama</th>
                        <th>Tutar</th>
                        <th>KDV</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>15.07.2026</td>
                        <td>EBL-20260715-001</td>
                        <td>Yıllık Global Paket Hizmet Bedeli</td>
                        <td>10.000,00 TL</td>
                        <td>2.000,00 TL</td>
                        <td><span class="badge bg-success">Kesildi</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" title="PDF İndir"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                        </td>
                    </tr>
                    <!-- Örnek boş satır (Eğer hiç fatura yoksa üstteki tr yerine bu gösterilir)
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Henüz adınıza kesilmiş bir fatura bulunmamaktadır.</td>
                    </tr>
                    -->
                </tbody>
            </table>
        </div>
    </div>
</div>
