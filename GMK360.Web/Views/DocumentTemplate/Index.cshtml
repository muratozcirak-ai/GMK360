@model IEnumerable<GMK360.Core.Entities.Construction.DocumentTemplate>
@{
    ViewData["Title"] = "Sözleşme ve Belge Şablonları";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-richtext text-primary me-2"></i> Belge & Sözleşme Şablonları</h3>
        <p class="text-muted mb-0">Sistem içinden yazdırılacak sözleşmelerin taslak (HTML) kütüphanesi.</p>
    </div>
    <a href="/DocumentTemplate/Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Yeni Şablon Ekle
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Kategori</th>
                        <th>Şablon Adı</th>
                        <th>Oluşturulma</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-x fs-1 d-block mb-3"></i>
                                Henüz hiç şablon oluşturulmamış.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td class="ps-4"><span class="badge bg-secondary">@item.Category</span></td>
                            <td class="fw-bold text-primary">@item.TemplateName</td>
                            <td><small class="text-muted">@item.CreatedAt.ToString("dd.MM.yyyy")</small></td>
                            <td class="text-end pe-4">
                                <a href="/DocumentTemplate/Edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" onclick="deleteTemplate(@item.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteTemplate(id) {
            if(confirm('Bu şablonu silmek istediğinize emin misiniz?')) {
                $.post('/DocumentTemplate/Delete', { id: id }, function() {
                    $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                });
            }
        }
    </script>
}
