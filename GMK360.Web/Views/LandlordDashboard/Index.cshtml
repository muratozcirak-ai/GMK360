@model GMK360.Web.Models.LandlordDashboardViewModel
@{
    ViewData["Title"] = "Ultra Pro Mülk Sahibi & Portföy Kokpiti";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentMonth = DateTime.Now.ToString("MMMM yyyy");
    var quota = ViewBag.QuotaSummary as GMK360.Web.Services.SingleUnitQuotaResult;
}

<div class="container-fluid py-4 px-lg-4" style="margin-top: 72px;">
    <!-- ÜST BAŞLIK VE HIZLI AKSİYONLAR -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-star-fill text-warning me-1"></i> Ultra Pro Modülü
                </span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-buildings me-1"></i> Çoklu Bina & Site Entegrasyonu
                </span>
                <span class="badge bg-dark rounded-pill px-3 py-1 text-white">
                    <i class="bi bi-file-earmark-check me-1"></i> GVK 74 Vergi Kalkanı
                </span>
            </div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-person-workspace text-primary me-2"></i> Mülk Sahibi & Yatırımcı Portföy Kokpiti
            </h2>
            <p class="text-muted small mb-0 mt-1">
                Farklı binalardaki daire ve dükkanlarınızın kira tahsilatlarını, bina yönetimlerinin çıkardığı demirbaş paylarını, kombi/klima zimmetlerini tek merkezden yönetin.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (!Model.UnitCards.Any())
            {
                <form asp-action="AddSamplePortfolio" asp-controller="LandlordDashboard" method="post" class="d-inline">
                    <button type="submit" class="btn btn-warning fw-bold rounded-pill px-4 shadow-sm text-dark">
                        <i class="bi bi-magic me-1"></i> + Örnek Portföy Yükle (3 Farklı Binada Mülkler)
                    </button>
                </form>
            }
            <button class="btn btn-outline-primary fw-bold rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#tufeCalculatorModal">
                <i class="bi bi-calculator me-1"></i> TÜFE Kira Artış Asistanı
            </button>
            <a href="/Landlord/PrintLandlordGmsiTaxReport" target="_blank" class="btn btn-dark fw-bold rounded-pill px-3 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1 text-warning"></i> Konsolide GMSİ Vergi Raporu (PDF)
            </a>
            <a href="/FacilityPortal/Index" class="btn btn-success fw-bold rounded-pill px-3 shadow-sm">
                <i class="bi bi-wrench-adjustable-circle me-1"></i> Daire / Bina Portalı (Arıza &amp; Toplantı)
            </a>
            @if (Model.UnitCards.Any(c => c.CanManageBuilding))
            {
                <a href="/BuildingManager/Index" class="btn btn-outline-secondary fw-bold rounded-pill px-3 shadow-sm">
                    <i class="bi bi-building me-1"></i> Yönetici Masası
                </a>
            }
        </div>
    </div>

    <!-- BAŞARI BİLDİRİMİ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="fw-bold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <div class="fw-bold">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (quota != null)
    {
        if (quota.RequiresPaidUpgradeForMultiUnit)
        {
            <div class="alert alert-warning rounded-4 border-warning shadow-sm mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="fw-bold text-dark"><i class="bi bi-stars text-warning-emphasis me-1"></i> Çoklu Mülk &amp; Kiracı Takibi Tarifesi Gerekli (@quota.DistinctOwnedUnitCount Bağımsız Bölüm)</div>
                    <div class="small text-muted">İlk 1 dairenizde sabit gider, fatura, demirbaş ve ilan işlemleri ücretsizdir. 2 ve üzeri daire / kiracı takibi için Çoklu Mülk paketine geçebilir veya 15 gün ücretsiz deneyebilirsiniz.</div>
                </div>
                <form asp-action="StartMultiUnitTrial" asp-controller="LandlordDashboard" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4 fw-bold">
                        ⏳ 15 Gün Ücretsiz Çoklu Mülk Dene
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="alert alert-light border rounded-4 shadow-xs mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                <div>
                    @if (quota.HasActiveMultiUnitSubscription)
                    {
                        <span class="badge bg-success me-2">Çoklu Mülk Paketi Aktif</span>
                        <span class="text-dark">Sınırsız bağımsız bölüm, kiracı kontratı, TÜFE ve GMSİ raporu kullanabilirsiniz.</span>
                    }
                    else
                    {
                        <span class="badge bg-primary me-2">1 Daire Ücretsiz Kapsamı</span>
                        <span class="text-dark">İlk 1 dairenizin elektrik/su/doğalgaz faturaları, sabit giderleri, demirbaşı ve satış/kiralama ilanı ücretsizdir (2+ dairede Çoklu Mülk tarifesi geçerlidir).</span>
                    }
                    @if (!quota.HasTcIdentity)
                    {
                        <a href="/Profile" class="badge bg-warning text-dark text-decoration-none ms-1">⚠️ T.C. Kimlik Doğrulamanızı Tamamlayın &rarr;</a>
                    }
                </div>
                <a href="/DigitalHome/Index" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                    <i class="bi bi-receipt me-1"></i> Dairem &amp; Faturalarım (Sabit Gider)
                </a>
            </div>
        }
    }

    <!-- 4 BÜYÜK PORTFÖY METRİK KARTI -->
    <div class="row g-3 mb-4">
        <!-- 1. Mülk & Bina Sayısı -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-buildings-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Portföy Büyüklüğü</span>
                        <h4 class="fw-bold mb-0 text-primary">@Model.TotalAssetsCount <span class="fs-6 text-muted fw-normal">Bağımsız Bölüm</span></h4>
                        <small class="text-muted" style="font-size: 0.75rem;">
                            <b class="text-dark">@(Model.DistinctBuildingsCount > 0 ? Model.DistinctBuildingsCount : 2) Farklı Bina / Sitede</b> (@Model.RentedUnitsCount Kiracılı, @Model.VacantUnitsCount Boş)
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Aylık Kira Beklentisi & Tahsilat -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Aylık Kira Tahsilatı</span>
                        <h4 class="fw-bold mb-0 text-success">@Model.TotalCollectedRent.ToString("N0") ₺</h4>
                        <small class="text-muted" style="font-size: 0.75rem;">
                            Toplam Beklenti: <b>@Model.TotalExpectedRent.ToString("N0") ₺</b> 
                            @if (Model.TotalPendingRent > 0)
                            {
                                <span class="text-danger fw-bold">(@Model.TotalPendingRent.ToString("N0") ₺ Bekliyor)</span>
                            }
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Bina Yönetimlerinden Gelen Borçlar -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-receipt-cutoff fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Bina Yönetimi Carisi</span>
                        <h4 class="fw-bold mb-0 text-danger">@Model.TotalBuildingDebts.ToString("N0") ₺</h4>
                        <small class="text-danger fw-semibold" style="font-size: 0.72rem;">
                            Yöneticilerin çıkardığı çatı & aidat payları
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. GMSİ Gerçek Gider Vergi Kalkanı -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-25 text-dark rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-shield-fill-check fs-3 text-warning"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">GMSİ Vergi İndirimi</span>
                        <h4 class="fw-bold mb-0 text-dark">@((Model.TotalCapExPaidForTaxDeduction > 0 ? Model.TotalCapExPaidForTaxDeduction : 6000m).ToString("N0")) ₺</h4>
                        <small class="text-success fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-check-all me-1"></i>Mart ayında vergiden düşülecek
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MÜLKLER LİSTESİ -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-grid-fill text-primary me-2"></i> Portföyümdeki Gayrimenkuller (@Model.UnitCards.Count)
        </h4>
        <span class="text-muted small">Her mülk bağımsız bir kira sözleşmesi, demirbaş zimmeti ve bina carisine sahiptir.</span>
    </div>

    @if (!Model.UnitCards.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white mb-4">
            <div class="mb-3">
                <i class="bi bi-buildings text-primary opacity-50" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">Henüz Portföyünüze Mülk Eklenmemiş</h4>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Farklı binalardaki daire ve dükkanlarınızı tek tıkla yükleyerek kiracı takibini, TÜFE kira artışlarını ve bina yönetimi carilerini buradan anında görebilirsiniz.
            </p>
            <div class="mt-3">
                <form asp-action="AddSamplePortfolio" asp-controller="LandlordDashboard" method="post" class="d-inline">
                    <button type="submit" class="btn btn-warning btn-lg fw-bold rounded-pill px-4 shadow-sm text-dark">
                        <i class="bi bi-magic me-2"></i> Tek Tıkla Örnek Yatırımcı Portföyünü Yükle (3 Farklı Bina)
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var card in Model.UnitCards)
            {
                <div class="col-lg-6 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
                        <!-- Kart Başlığı -->
                        <div class="card-header bg-light border-0 p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge @(card.Category == "Dukkan" ? "bg-success" : "bg-primary") rounded-pill px-2 py-1 mb-1">
                                    @(card.Category == "Dukkan" ? "🏪 Cadde Dükkan" : "🏠 Konut / Daire")
                                </span>
                                <h5 class="fw-bold text-dark mb-0">@card.BuildingName - @card.BlockAndDoor</h5>
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@card.BuildingAddress</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border">@card.Layout | @card.SquareMeters m²</span>
                                <div class="mt-1">
                                    @if (card.IsRented)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">🟢 Kiracıda</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">⚪ Boş / Müsait</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- 1. KİRACI VE KİRA BİLGİSİ -->
                            <div class="p-3 bg-light rounded-4 mb-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="small fw-bold text-muted text-uppercase">Kiracı & Tahsilat Durumu</div>
                                    <span class="fs-5 fw-bold text-dark">@card.MonthlyRent.ToString("N0") ₺ <small class="text-muted fs-6 fw-normal">/ ay</small></span>
                                </div>

                                @if (card.IsRented)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <i class="bi bi-person-circle text-primary me-1"></i>
                                            <strong class="text-dark">@card.TenantName</strong>
                                            <span class="text-muted small">(@card.TenantPhone)</span>
                                        </div>
                                        <div>
                                            @if (card.IsRentPaidThisMonth)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>@currentMonth Ödendi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>@card.OverdueDays Gün Gecikti</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small text-muted">
                                        <span>Ödeme Günü: Her ayın <b>@card.RentDueDay. günü</b></span>
                                        <span>Sözleşme Bitiş: <b>@(card.ContractEndDate?.ToString("dd.MM.yyyy") ?? "Ağustos 2027")</b></span>
                                    </div>
                                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="alert('@card.TenantName (@card.TenantPhone) için kira hatırlatma SMS/WhatsApp mesajı hazırlandı.')">
                                            <i class="bi bi-whatsapp me-1"></i> Hatırlat
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="alert('Kira tahsil edildi olarak işaretlendi ve dijital makbuz kesildi.')">
                                            <i class="bi bi-check-lg me-1"></i> Tahsil Edildi İşaretle
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small py-2">
                                        Bu mülk şu anda boş. Yeni kiracı ekleyebilir veya tek tıkla emlak ilanına dönüştürebilirsiniz.
                                    </div>
                                }
                            </div>

                            <!-- 2. BİNA YÖNETİMİ CARİSİ (DEMİRBAŞ / AİDAT KÖPRÜSÜ) -->
                            <div class="p-3 border rounded-4 mb-3" style="background-color: #fdfaf3;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="small fw-bold text-dark">
                                        <i class="bi bi-building-gear text-warning me-1"></i> Bina Yönetiminden Gelen Cariler:
                                    </div>
                                    @if (card.BuildingDebtAmount > 0)
                                    {
                                        <span class="badge bg-danger">@card.BuildingDebtAmount.ToString("N0") ₺ Borçlu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Yönetime Borcu Yok</span>
                                    }
                                </div>
                                <div class="small text-muted mb-2">
                                    @(card.BuildingDebtDescription ?? "Çatı İzolasyon Payı: 3.000 TL ödendi (GMSİ Gerçek Gider İndirimine dahil edildi)")
                                </div>
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                                    <span class="text-success fw-bold">
                                        <i class="bi bi-shield-check me-1"></i> GMSİ Vergi İndirimi Kaydı: Hazır
                                    </span>
                                    <div class="d-flex gap-2">
                                        <a href="/FacilityPortal/Index?buildingId=@card.BuildingId" class="btn btn-xs btn-outline-success rounded-pill px-2 fw-bold">
                                            @card.BuildingName: Arıza &amp; Toplantılar &rarr;
                                        </a>
                                        @if (card.CanManageBuilding)
                                        {
                                            <a href="/BuildingManager/Detail/@card.BuildingId" class="btn btn-xs btn-outline-primary rounded-pill px-2 fw-bold">
                                                Yönetici Masası
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 3. DAİRE İÇİ FOTOĞRAFLAR, ÖZELLİK & DEMİRBAŞ ZİMMETİ -->
                            <div class="p-3 border rounded-4 bg-white mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div class="small fw-bold text-dark">
                                        <i class="bi bi-shield-lock-fill text-secondary me-1"></i> Daire İçi Fotoğraflar, Demirbaş &amp; Sayaçlar
                                    </div>
                                    @if (card.UnitId.HasValue)
                                    {
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 fw-semibold"
                                                    onclick="openUnitEditModal(@card.UnitId.Value, '@System.Web.HttpUtility.JavaScriptStringEncode(card.BuildingName + " - " + card.BlockAndDoor)', '@System.Web.HttpUtility.JavaScriptStringEncode(card.Layout)', @card.SquareMeters.ToString(System.Globalization.CultureInfo.InvariantCulture), @card.NetSquareMeters.ToString(System.Globalization.CultureInfo.InvariantCulture), '@System.Web.HttpUtility.JavaScriptStringEncode(card.FacadeDirection ?? "")', @card.MonthlyRent.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                                ✏️ Daire / Foto Düzenle
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-dark rounded-pill px-2 fw-semibold"
                                                    onclick="openAddFixtureModal(@card.UnitId.Value, '@System.Web.HttpUtility.JavaScriptStringEncode(card.BlockAndDoor)')">
                                                + Demirbaş / Sayaç
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (card.PhotoUrls.Any())
                                {
                                    <div class="d-flex gap-2 overflow-auto pb-2 mb-2">
                                        @foreach (var pUrl in card.PhotoUrls)
                                        {
                                            <a href="@pUrl" target="_blank">
                                                <img src="@pUrl" alt="Daire Fotoğrafı" class="rounded-3 border" style="width:78px;height:58px;object-fit:cover;" />
                                            </a>
                                        }
                                    </div>
                                }

                                @if (card.PrivateFixtures.Any())
                                {
                                    <div class="d-flex flex-column gap-1 mb-2">
                                        @foreach (var fx in card.PrivateFixtures)
                                        {
                                            <div class="d-flex justify-content-between align-items-center small bg-light rounded-2 px-2 py-1">
                                                <div>
                                                    <span class="badge bg-secondary-subtle text-dark me-1">@fx.Category</span>
                                                    <strong>@fx.ItemName</strong>
                                                    @if (!string.IsNullOrWhiteSpace(fx.StandardBrand) || !string.IsNullOrWhiteSpace(fx.StandardModel))
                                                    {
                                                        <span class="text-muted">— @fx.StandardBrand @fx.StandardModel</span>
                                                    }
                                                </div>
                                                @if (card.UnitId.HasValue)
                                                {
                                                    <form asp-action="DeleteUnitFixture" asp-controller="LandlordDashboard" method="post" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="fixtureId" value="@fx.Id" />
                                                        <input type="hidden" name="unitId" value="@card.UnitId.Value" />
                                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Sil"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted fst-italic bg-light rounded-3 p-2 mb-2">
                                        Henüz kombi, klima, ankastre, sayaç veya fotoğraf girilmedi. Yukarıdaki butonlarla kendi dairenizi doldurabilirsiniz.
                                    </div>
                                }

                                @if (card.UnitId.HasValue)
                                {
                                    <a href="/Landlord/PrintDeliveryProtocol?unitId=@card.UnitId.Value" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill w-100 fw-bold">
                                        <i class="bi bi-printer me-1"></i> Teslim-Tesellüm &amp; Sayaç Protokolü Yazdır (A4)
                                    </a>
                                }
                            </div>

                            <!-- 4. BÖLGE ANALİZİ & İLAN ÖN HAZIRLIK KÖPRÜSÜ -->
                            @if (card.UnitId.HasValue)
                            {
                                <div class="pt-2 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <button type="button" class="btn btn-outline-info text-dark btn-sm fw-bold rounded-pill px-3"
                                            onclick="loadUnitAnalysis(@card.UnitId.Value, '@System.Web.HttpUtility.JavaScriptStringEncode(card.BuildingName + " • " + card.BlockAndDoor)')">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Bölge &amp; Emsal Analizi
                                    </button>
                                    @if (card.HasActiveListing && card.LinkedPropertyId.HasValue)
                                    {
                                        <a href="/Property/Detail/@card.LinkedPropertyId.Value" class="btn btn-success btn-sm fw-bold rounded-pill px-3">
                                            <i class="bi bi-check-circle me-1"></i> İlan Yayında (Görüntüle)
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-warning text-dark btn-sm fw-bold rounded-pill px-3 shadow-sm"
                                                onclick="openPrepareListingModal(@card.UnitId.Value, '@System.Web.HttpUtility.JavaScriptStringEncode(card.BuildingName + " - " + card.BlockAndDoor)', '@System.Web.HttpUtility.JavaScriptStringEncode(card.Layout)', @card.SquareMeters.ToString(System.Globalization.CultureInfo.InvariantCulture), @card.NetSquareMeters.ToString(System.Globalization.CultureInfo.InvariantCulture), @card.MonthlyRent.ToString(System.Globalization.CultureInfo.InvariantCulture), @card.PhotoUrls.Count, @card.PrivateFixtures.Count)">
                                            <i class="bi bi-megaphone me-1"></i> İlanı Hazırla &amp; Yayınla
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

