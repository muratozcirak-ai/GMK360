@model IEnumerable<GMK360.Core.Entities.Property>
@{
    ViewData["Title"] = "Mülk & Kiracı Takip Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentMonth = DateTime.Now.ToString("MMMM yyyy");
}

<div class="container-fluid py-4">
    <!-- BAŞLIK -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-house-door-fill text-primary me-2"></i>Mülk Portföyüm & Kiracılarım</h2>
            <p class="text-muted mb-0">Evlerinizin durumunu, kira sözleşmelerini ve aylık kira tahsilatlarını buradan tek tıkla yönetin.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addPropertyModal">
            <i class="bi bi-plus-lg me-2"></i> Yeni Mülk Ekle
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-4 mb-4 border-0 border-start border-success border-5">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <strong>@TempData["SuccessMessage"]</strong>
        </div>
    }

    <!-- ÖZET KARTLARI -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card bg-gradient-primary h-100 rounded-4 border-0 shadow-sm text-white hover-shadow">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-sm mb-1 opacity-75 fw-bold">Toplam Mülk Sayısı</p>
                        <h2 class="fw-bold mb-0 text-white">@ViewBag.TotalProperties <small class="fs-6 opacity-75">Adet</small></h2>
                    </div>
                    <div class="bg-white bg-opacity-25 p-3 rounded-circle">
                        <i class="bi bi-buildings fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-md-6">
            <div class="card bg-white h-100 rounded-4 border-0 shadow-sm hover-shadow border-start border-success border-5">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-sm mb-1 text-muted fw-bold">Aktif Kiracılı</p>
                        <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalRented <small class="fs-6 text-muted">Daire/Dükkan</small></h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-person-check-fill text-success fs-1"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card bg-white h-100 rounded-4 border-0 shadow-sm hover-shadow border-start border-warning border-5">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-sm mb-1 text-muted fw-bold">Beklenen Aylık Kira Geliri</p>
                        <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalMonthlyRent.ToString("N0") <small class="fs-6 text-muted">TL</small></h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-cash-stack text-warning fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MÜLK LİSTESİ -->
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-list-ul text-primary me-2"></i> Mülklerimin Durumu</h5>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-light border border-dashed rounded-4 p-5 text-center">
                    <i class="bi bi-house-x fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">Henüz Sisteme Mülk Eklenmemiş</h5>
                    <p class="text-muted">Ev veya dükkanlarınızı ekleyerek kiracı takibine hemen başlayabilirsiniz.</p>
                </div>
            </div>
        }

        @foreach(var prop in Model)
        {
            bool hasTenant = !string.IsNullOrEmpty(prop.TenantName);
            // Simülasyon: Rastgele kiranın ödenip ödenmediği durumu
            bool rentPaid = (prop.Id % 2 == 0); 
            
            <div class="col-xl-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-shadow transition-all">
                    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-1">@prop.Title</h5>
                            <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill text-primary"></i> @(prop.Building?.Name ?? "Adres/Bina Girilmemiş")</p>
                        </div>
                        @if(hasTenant)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2"><i class="bi bi-person-check-fill me-1"></i> Kirada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-3 py-2"><i class="bi bi-door-open-fill me-1"></i> Boş</span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <hr class="text-muted opacity-25 mt-0 mb-3">
                        
                        <div class="row align-items-center">
                            @if(hasTenant)
                            {
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-light p-3 rounded-circle me-3">
                                            <i class="bi bi-person-badge fs-4 text-dark"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@prop.TenantName</h6>
                                            <span class="text-muted small"><i class="bi bi-telephone-fill me-1"></i> @(prop.TenantPhone ?? "Telefon Yok")</span>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted fw-bold small">Aylık Kira:</span>
                                        <span class="fw-bold text-dark">@prop.RentAmount?.ToString("N0") TL</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted fw-bold small">Sözleşme Bitiş:</span>
                                        <span class="fw-bold text-dark">@(prop.ContractEndDate?.ToString("dd.MM.yyyy") ?? "Belirtilmemiş")</span>
                                    </div>
                                </div>
                                <div class="col-md-5 text-md-end text-center mt-3 mt-md-0 border-start-md border-0 ps-md-4">
                                    <p class="text-muted fw-bold small mb-2">@currentMonth Kirası</p>
                                    @if(rentPaid)
                                    {
                                        <div class="d-inline-block bg-success bg-opacity-10 text-success px-4 py-2 rounded-4 fw-bold mb-3 border border-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Tahsil Edildi
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-inline-block bg-danger bg-opacity-10 text-danger px-4 py-2 rounded-4 fw-bold mb-3 border border-danger">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> Bekliyor
                                        </div>
                                        <form asp-action="MarkRentPaid" method="post" class="d-grid">
                                            <input type="hidden" name="propertyId" value="@prop.Id" />
                                            <input type="hidden" name="month" value="@currentMonth" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill fw-bold">
                                                <i class="bi bi-check2"></i> Tahsil Edildi İşaretle
                                            </button>
                                        </form>
                                    }
                                    
                                    <button class="btn btn-sm btn-link text-primary mt-2 w-100" data-bs-toggle="modal" data-bs-target="#editTenantModal-@prop.Id">Kiracıyı Düzenle</button>
                                </div>
                            }
                            else
                            {
                                <div class="col-12 text-center py-4">
                                    <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                                        <button class="btn btn-light border shadow-sm rounded-pill fw-bold text-primary px-4" data-bs-toggle="modal" data-bs-target="#editTenantModal-@prop.Id">
                                            <i class="bi bi-person-plus-fill me-2"></i> Eski Kiracıyı Ekle
                                        </button>
                                        <a href="/Property/Create?sourcePropertyId=@prop.Id" class="btn btn-warning border-0 shadow-sm rounded-pill fw-bold text-dark px-4" title="Tek tıkla GMK360 Emlak Portalında ilana çıkın">
                                            <i class="bi bi-megaphone-fill me-2"></i> Hemen İlana Çıkar
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kiracı Düzenle/Ekle Modal -->
            <div class="modal fade" id="editTenantModal-@prop.Id" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow-lg">
                        <div class="modal-header bg-primary bg-opacity-10 border-0">
                            <h5 class="modal-title fw-bold text-dark"><i class="bi bi-file-earmark-text-fill text-primary me-2"></i> Kiracı ve Sözleşme Bilgileri</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="SaveTenant" method="post">
                            <input type="hidden" name="propertyId" value="@prop.Id" />
                            <div class="modal-body p-4 bg-light">
                                <div class="mb-3 text-center">
                                    <span class="badge bg-dark rounded-pill px-3 py-2 fs-6">@prop.Title</span>
                                </div>
                                <div class="mb-3">
                                    <label class="fw-bold form-label">Kiracı Ad Soyad</label>
                                    <input type="text" name="tenantName" class="form-control rounded-3" value="@prop.TenantName" required />
                                </div>
                                <div class="mb-3">
                                    <label class="fw-bold form-label">Telefon Numarası</label>
                                    <input type="text" name="tenantPhone" class="form-control rounded-3" value="@prop.TenantPhone" />
                                </div>
                                <div class="mb-3">
                                    <label class="fw-bold form-label">Aylık Kira Tutarı (TL)</label>
                                    <input type="number" name="rentAmount" class="form-control rounded-3" value="@prop.RentAmount" required />
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="fw-bold form-label">Sözleşme Başlangıç</label>
                                        <input type="date" name="startDate" class="form-control rounded-3" value="@(prop.ContractStartDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold form-label">Sözleşme Bitiş</label>
                                        <input type="date" name="endDate" class="form-control rounded-3" value="@(prop.ContractEndDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.AddYears(1).ToString("yyyy-MM-dd"))" />
                                    </div>
                                </div>
                                <div class="alert alert-warning mt-4 mb-0 rounded-3 border-0 small">
                                    <i class="bi bi-info-circle me-1"></i> Sistemi kaydettiğinizde kiracınıza <strong>Müşteri/Kiracı Paneli</strong> giriş linki otomatik olarak iletilebilir.
                                </div>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Değişiklikleri Kaydet</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow { transition: box-shadow 0.3s ease, transform 0.3s ease; }
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
    .transition-all { transition: all 0.3s ease; }
</style>
