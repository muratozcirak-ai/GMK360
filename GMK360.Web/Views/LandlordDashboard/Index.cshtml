<!-- MODALLER: TÜFE KİRA ARTIŞ HESAPLAYICI -->
<!-- ========================================================================= -->
<div class="modal fade" id="tufeCalculatorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-calculator me-2"></i> Yasal TÜFE Kira Artış Asistanı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 row g-3">
                <div class="col-12">
                    <div class="alert alert-info border-0 rounded-3 small mb-0">
                        <i class="bi bi-info-circle me-1"></i> 6098 sayılı Türk Borçlar Kanunu Md. 344 uyarınca konut kiralarında artış tavanı <strong>12 Aylık TÜFE Ortalaması</strong> ile sınırlıdır.
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Mevcut Kira Bedeli (TL)</label>
                    <input type="number" id="calcOldRent" class="form-control fw-bold" value="25000" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">12 Aylık TÜFE Oranı (%)</label>
                    <input type="number" step="0.01" id="calcTufeRate" class="form-control fw-bold text-primary" value="62.83" />
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary fw-bold rounded-pill w-100 py-2" onclick="calculateTufe()">
                        <i class="bi bi-arrow-repeat me-1"></i> Yeni Yasal Kirayı Hesapla
                    </button>
                </div>
                <div class="col-12" id="calcResultBox" style="display:none;">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">Maksimum Yasal Zam Tutarı:</span>
                            <strong class="text-danger" id="calcIncreaseAmount">0 ₺</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 fs-5">
                            <span class="fw-bold text-dark">Yeni Yasal Kira Tavanı:</span>
                            <strong class="text-success" id="calcNewRent">0 ₺</strong>
                        </div>
                        <textarea class="form-control small font-monospace mt-2" rows="3" id="calcNoticeText" readonly></textarea>
                        <button class="btn btn-sm btn-outline-dark rounded-pill mt-2 w-100" onclick="navigator.clipboard.writeText(document.getElementById('calcNoticeText').value); alert('İhtar metni panoya kopyalandı!');">
                            <i class="bi bi-clipboard me-1"></i> İhtar Metnini Kopyala
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    function calculateTufe() {
        var oldRent = parseFloat(document.getElementById('calcOldRent').value) || 0;
        var rate = parseFloat(document.getElementById('calcTufeRate').value) || 0;

        var increase = oldRent * (rate / 100);
        var newRent = oldRent + increase;

        document.getElementById('calcIncreaseAmount').innerText = increase.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        document.getElementById('calcNewRent').innerText = newRent.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';

        var notice = "Sayın Kiracım, TBK Madde 344 uyarınca 12 aylık TÜFE ortalaması olan %" + rate + " oranında kira artışı uygulanarak yeni dönem aylık kiranız " + newRent.toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + " TL olarak belirlenmiştir. Bilgilerinize sunarım.";
        document.getElementById('calcNoticeText').value = notice;

        document.getElementById('calcResultBox').style.display = 'block';
    }

    function openUnitEditModal(unitId, title, layout, grossSqm, netSqm, facade, rentPrice) {
        document.getElementById('ueUnitId').value = unitId;
        document.getElementById('ueTitle').innerText = title;
        document.getElementById('ueRoomLayout').value = (layout && layout !== 'Belirtilmedi') ? layout : '3+1';
        document.getElementById('ueGrossSqm').value = grossSqm > 0 ? grossSqm : '';
        document.getElementById('ueNetSqm').value = netSqm > 0 ? netSqm : '';
        document.getElementById('ueFacade').value = facade || '';
        document.getElementById('ueListPrice').value = rentPrice > 0 ? rentPrice : '';
        new bootstrap.Modal(document.getElementById('unitEditModal')).show();
    }

    function openAddFixtureModal(unitId, doorLabel) {
        document.getElementById('fxUnitId').value = unitId;
        document.getElementById('fxDoorLabel').innerText = doorLabel;
        new bootstrap.Modal(document.getElementById('unitFixtureModal')).show();
    }

    async function loadUnitAnalysis(unitId, title) {
        const modal = new bootstrap.Modal(document.getElementById('neighborhoodAnalysisModal'));
        document.getElementById('naTitle').innerText = title;
        document.getElementById('naBody').innerHTML = '<div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Bölge ve emsal verileri yükleniyor...</div>';
        modal.show();
        try {
            const res = await fetch('/Landlord/GetUnitNeighborhoodAnalysis?unitId=' + unitId);
            const data = await res.json();
            if (!data.success) {
                document.getElementById('naBody').innerHTML = '<div class="alert alert-warning mb-0">Bölge analizi alınamadı.</div>';
                return;
            }
            const avgText = data.avgListingPrice ? Number(data.avgListingPrice).toLocaleString('tr-TR') + ' ₺' : 'Yeterli emsal yok';
            document.getElementById('naBody').innerHTML = `
                <div class="p-3 bg-light rounded-3 border mb-3 small">
                    <div><strong>Konum:</strong> ${data.location}</div>
                    <div><strong>Bağımsız Bölüm:</strong> ${data.unitSummary}</div>
                    <div><strong>İlçe Aktif İlan:</strong> ${data.comparableCount} adet • <strong>Ortalama Emsal:</strong> ${avgText}</div>
                </div>
                <div class="small text-dark" style="white-space: pre-line;">${data.reportHtml}</div>`;
        } catch (e) {
            document.getElementById('naBody').innerHTML = '<div class="alert alert-danger mb-0">Analiz sırasında bağlantı hatası oluştu.</div>';
        }
    }

    function openPrepareListingModal(unitId, title, layout, grossSqm, netSqm, price, photoCount, fixtureCount) {
        document.getElementById('plUnitId').value = unitId;
        document.getElementById('plTitle').value = title + ' - Kiralık';
        document.getElementById('plRoomCount').value = (layout && layout !== 'Belirtilmedi') ? layout : '3+1';
        document.getElementById('plGrossArea').value = grossSqm > 0 ? Math.round(grossSqm) : '';
        document.getElementById('plNetArea').value = netSqm > 0 ? Math.round(netSqm) : '';
        document.getElementById('plPrice').value = price > 0 ? Math.round(price) : '';
        document.getElementById('plChecklistWarning').style.display = (photoCount === 0 || layout === 'Belirtilmedi') ? 'block' : 'none';
        new bootstrap.Modal(document.getElementById('prepareListingModal')).show();
    }
</script>

