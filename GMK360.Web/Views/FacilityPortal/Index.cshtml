@{
    Layout = null;
    string activeRole = ViewBag.ActiveRole as string ?? "Resident";
    bool canSwitch = ViewBag.CanSwitchPreview is bool cs && cs;
    var managedBuildings = ViewBag.ManagedBuildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var portalBuildings = ViewBag.PortalBuildings as List<GMK360.Core.Entities.Building> ?? new List<GMK360.Core.Entities.Building>();
    var selectedBuilding = ViewBag.SelectedBuilding as GMK360.Core.Entities.Building;
    int buildingId = ViewBag.SelectedBuildingId is int sb ? sb : 0;
    string activeSiteName = selectedBuilding != null
        ? $"{selectedBuilding.Name}{(!string.IsNullOrWhiteSpace(selectedBuilding.BlockName) ? " • " + selectedBuilding.BlockName : "")}"
        : "GMK360 Bina & Yaşam Portalı";
    var staffProfile = ViewBag.StaffProfile as GMK360.Core.Entities.BuildingStaff;
    var staffList = ViewBag.BuildingStaffList as List<GMK360.Core.Entities.BuildingStaff> ?? new List<GMK360.Core.Entities.BuildingStaff>();
    var residentUnits = ViewBag.ResidentUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
    var tickets = ViewBag.Tickets as List<GMK360.Core.Entities.BuildingTaskTicket> ?? new List<GMK360.Core.Entities.BuildingTaskTicket>();
    var budget = ViewBag.BudgetSummary as GMK360.Web.Services.BuildingMonthlyBudgetSummary ?? new GMK360.Web.Services.BuildingMonthlyBudgetSummary();
    var meetings = ViewBag.Meetings as List<GMK360.Core.Entities.SystemMeeting> ?? new List<GMK360.Core.Entities.SystemMeeting>();
    var boardMembership = ViewBag.BoardMembership as GMK360.Core.Entities.BuildingManager;
    var pendingApprovals = ViewBag.PendingApprovals as List<GMK360.Core.Entities.ApprovalRequest> ?? new List<GMK360.Core.Entities.ApprovalRequest>();
    var currentUserProfile = ViewBag.CurrentUserProfile as GMK360.Core.Entities.Identity.ApplicationUser;
    var bankAccounts = ViewBag.BuildingBankAccounts as List<GMK360.Core.Entities.BankAccount> ?? new List<GMK360.Core.Entities.BankAccount>();
    var fixedExpenses = ViewBag.FixedExpenses as List<GMK360.Core.Entities.BuildingFixedExpense> ?? new List<GMK360.Core.Entities.BuildingFixedExpense>();
    var plannedMaintenances = ViewBag.PlannedMaintenances as List<GMK360.Core.Entities.SpaceFixture> ?? new List<GMK360.Core.Entities.SpaceFixture>();
    var recentExpenses = ViewBag.RecentBuildingExpenses as List<GMK360.Core.Entities.BuildingExpense> ?? new List<GMK360.Core.Entities.BuildingExpense>();
    var meetingProposals = ViewBag.MeetingProposals as List<GMK360.Core.Entities.SupportTicket> ?? new List<GMK360.Core.Entities.SupportTicket>();
    int rootBuildingId = ViewBag.RootBuildingId is int rbid ? rbid : buildingId;

    var allDebts = residentUnits.SelectMany(u => u.Debts ?? new List<GMK360.Core.Entities.UnitDebt>()).Where(d => !d.IsArchived).ToList();
    var ownerDebts = allDebts.Where(d => d.PayerRole == "Owner").ToList();
    var tenantDebts = allDebts.Where(d => d.PayerRole != "Owner").ToList();
    string boardRoleLabel = boardMembership?.Role == GMK360.Core.Entities.BuildingManagerRole.BoardMember
        ? "Aza (Yönetim Kurulu)"
        : boardMembership?.Role == GMK360.Core.Entities.BuildingManagerRole.Auditor
            ? "Denetçi"
            : boardMembership?.Role == GMK360.Core.Entities.BuildingManagerRole.HeadManager
                ? "Yönetici"
                : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <partial name="_PwaHeadPartial" />
    <title>GMK360 Saha PWA (@activeRole)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f1f5f9; font-family: system-ui, -apple-system, sans-serif; padding-bottom: 80px; }
        .pwa-header { background: linear-gradient(135deg, #14532d 0%, #15803d 100%); color: #fff; }
        .pwa-card { border: 0; border-radius: 18px; box-shadow: 0 4px 18px rgba(15,23,42,.06); }
        .proof-thumb { width: 100%; max-height: 180px; object-fit: cover; border-radius: 12px; }
    </style>
</head>
<body>
    <!-- ÜST PWA BAR -->
    <div class="pwa-header px-3 py-3 shadow-sm sticky-top">
        <div class="container" style="max-width: 780px;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small fw-bold">
                        @(activeRole == "Manager" ? "Yönetici" : activeRole == "Staff" ? "Görevli" : activeRole == "Tenant" ? "Kiracı" : "Kat Maliki")
                    </span>
                    <div class="fw-bold fs-5 mt-1">@activeSiteName</div>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <a href="/Dashboard/Hub" class="btn btn-sm btn-outline-light rounded-pill px-3" title="Ana Sayfa / Çalışma Alanlarım">
                        <i class="bi bi-grid-fill me-1"></i>Panellerim
                    </a>
                    @if (!string.IsNullOrEmpty(boardRoleLabel))
                    {
                        <span class="badge bg-info text-dark rounded-pill px-2 py-1 fw-semibold">@boardRoleLabel</span>
                    }
                    <a href="/Profile" class="btn btn-sm btn-outline-light rounded-pill px-3" title="E-posta / Telefon Doğrulama &amp; Gizli PIN">
                        <i class="bi bi-shield-lock me-1"></i>Profil &amp; PIN
                    </a>
                    @if (canSwitch)
                    {
                        <a href="/BuildingManager/Index" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold">Web Panele Dön</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">Çıkış</button>
                    </form>
                </div>
            </div>

            @if (portalBuildings.Count > 1)
            {
                <div class="d-flex flex-wrap gap-1 mt-2 pt-2 border-top border-white border-opacity-25">
                    <small class="text-white-50 me-2 align-self-center">Yerleşke / Bina:</small>
                    @foreach (var pb in portalBuildings)
                    {
                        var pbTitle = !string.IsNullOrWhiteSpace(pb.BlockName) ? $"{pb.Name} ({pb.BlockName})" : pb.Name;
                        <a href="/FacilityPortal/Index?buildingId=@pb.Id@(canSwitch ? "&previewRole=" + activeRole : "")"
                           class="btn btn-sm @(pb.Id == buildingId ? "btn-light text-dark fw-bold" : "btn-outline-light") rounded-pill px-2 py-0">
                            @pbTitle
                        </a>
                    }
                </div>
            }

            @if (canSwitch)
            {
                <div class="d-flex flex-wrap gap-1 mt-3 pt-2 border-top border-white border-opacity-25">
                    <small class="text-white-50 me-2 align-self-center">Rol Önizleme:</small>
                    <a href="/FacilityPortal/Index?previewRole=Manager&buildingId=@buildingId" class="btn btn-sm @(activeRole == "Manager" ? "btn-warning text-dark fw-bold" : "btn-outline-light") rounded-pill px-2 py-0">Yönetici</a>
                    <a href="/FacilityPortal/Index?previewRole=Owner&buildingId=@buildingId" class="btn btn-sm @(activeRole == "Owner" ? "btn-warning text-dark fw-bold" : "btn-outline-light") rounded-pill px-2 py-0">Kat Maliki</a>
                    <a href="/FacilityPortal/Index?previewRole=Tenant&buildingId=@buildingId" class="btn btn-sm @(activeRole == "Tenant" ? "btn-warning text-dark fw-bold" : "btn-outline-light") rounded-pill px-2 py-0">Kiracı</a>
                    <a href="/FacilityPortal/Index?previewRole=Staff&buildingId=@buildingId" class="btn btn-sm @(activeRole == "Staff" ? "btn-warning text-dark fw-bold" : "btn-outline-light") rounded-pill px-2 py-0">Site Görevlisi</a>
                </div>
            }
        </div>
    </div>

    <div class="container py-3" style="max-width: 780px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-4 border-0 shadow-sm">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning rounded-4 border-0 shadow-sm">@TempData["WarningMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger rounded-4 border-0 shadow-sm">@TempData["ErrorMessage"]</div>
        }

        <!-- Telefona Uygulama (PWA) Kurulum Kartı (Yalnızca tarayıcıda açıkken görünür, kurulduktan sonra gizlenir) -->
        <div id="portalPwaGuideCard" class="card pwa-card border border-warning-subtle bg-warning bg-opacity-10 p-3 mb-3 d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-phone-vibrate-fill text-warning-emphasis fs-4"></i>
                    <div class="small">
                        <strong class="text-dark d-block">Site / Daire Uygulamasını Telefonunuza Ekleyin (PWA)</strong>
                        <span id="portalPwaGuideHint" class="text-muted">Tek dokunuşla ana ekranınızdan hızlı giriş yapın.</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="portalPwaInstallBtn" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 d-none" onclick="if(window.gmkTriggerPwaInstall){window.gmkTriggerPwaInstall();}">
                        <i class="bi bi-download me-1"></i>Uygulamayı Kur
                    </button>
                    <button type="button" class="btn-close btn-sm" aria-label="Gizle" onclick="sessionStorage.setItem('gmk_portal_pwa_hide','1');document.getElementById('portalPwaGuideCard').classList.add('d-none');"></button>
                </div>
            </div>
        </div>

        @if (activeRole == "Manager")
        {
            <!-- ==================== ROL 1: SİTE YÖNETİCİSİ PWA ==================== -->
            <div class="row g-2 mb-3">
                <div class="col-4">
                    <div class="card pwa-card p-3 bg-white text-center">
                        <small class="text-muted fw-bold">İşletme Bütçe</small>
                        <div class="fw-bold text-success fs-5">@budget.TotalMonthlyOperatingBudget.ToString("N0") ₺</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card pwa-card p-3 bg-white text-center">
                        <small class="text-muted fw-bold">Kıdem Fonu</small>
                        <div class="fw-bold text-danger fs-5">@budget.TotalMonthlyCapitalBudget.ToString("N0") ₺</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card pwa-card p-3 bg-white text-center">
                        <small class="text-muted fw-bold">Açık Talep</small>
                        <div class="fw-bold text-primary fs-5">@tickets.Count(t => t.Status != "Tamamlandi" && t.Status != "Iptal")</div>
                    </div>
                </div>
            </div>

            <div class="card pwa-card bg-white p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="bi bi-camera text-success me-1"></i> Yöneticiden Görev / Denetim Kaydı Aç</h6>
                    <a href="/BuildingManager/Accounting?buildingId=@buildingId" class="small fw-semibold text-decoration-none">Bordro &amp; SGK &rarr;</a>
                </div>
                <form asp-action="CreateTaskTicket" method="post" enctype="multipart/form-data" class="row g-2 compressed-photo-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@buildingId" />
                    <input type="hidden" name="createdByRole" value="Yonetici" />
                    <input type="hidden" name="previewRole" value="Manager" />
                    <div class="col-6">
                        <select name="category" class="form-select form-select-sm">
                            <option value="Temizlik/Cop">Temizlik / Çöp (Oto Atama)</option>
                            <option value="Elektrik/Aydinlatma">Elektrik / Aydınlatma</option>
                            <option value="Asansor">Asansör</option>
                            <option value="Bahce">Bahçe / Ağaç Bakımı</option>
                            <option value="Guvenlik">Güvenlik</option>
                            <option value="Diger">Diğer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <select name="priority" class="form-select form-select-sm">
                            <option value="Normal">Normal Öncelik</option>
                            <option value="Acil">Acil Müdahale</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <input type="text" name="locationNote" class="form-control form-control-sm" placeholder="Konum (Örn: B Blok 3. Kat Merdiven)" />
                    </div>
                    <div class="col-12">
                        <input type="text" name="description" class="form-control form-control-sm" required placeholder="Kısa görev açıklaması..." />
                    </div>
                    <div class="col-8">
                        <input type="file" name="beforePhoto" class="form-control form-control-sm pwa-camera-input" accept="image/*" capture="environment" />
                        <small class="text-muted compress-status d-block mt-1" style="font-size:.7rem;">Kamera otomatik 1024px (~150KB) sıkıştırılır</small>
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-sm btn-success w-100 rounded-pill fw-bold">Gönder</button>
                    </div>
                </form>
            </div>

            <h6 class="fw-bold text-dark mb-2 px-1">Açık Talepler &amp; Görev Atama Havuzu</h6>
            @foreach (var tk in tickets)
            {
                <div class="card pwa-card bg-white p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge @(tk.Priority == "Acil" ? "bg-danger" : "bg-secondary")">@tk.Priority</span>
                            <span class="badge bg-light text-dark border">@tk.Category</span>
                            <strong class="ms-1">#@tk.Id</strong>
                            <div class="small text-muted mt-1">@tk.CreatedByRole • @(tk.BuildingUnit != null ? $"Daire {tk.BuildingUnit.DoorNumber}" : "Ortak Alan") • @tk.LocationNote</div>
                        </div>
                        <span class="badge @(tk.Status == "Tamamlandi" ? "bg-success" : tk.Status == "Atandi" ? "bg-primary" : "bg-warning text-dark")">@tk.Status</span>
                    </div>
                    <p class="small text-dark mb-2">@tk.Description</p>
                    <div class="row g-2 mb-2">
                        @if (!string.IsNullOrEmpty(tk.BeforePhotoUrl))
                        {
                            <div class="col-6">
                                <small class="text-muted d-block">Öncesi (Bildirim)</small>
                                <img src="@tk.BeforePhotoUrl" class="proof-thumb" alt="Öncesi" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(tk.AfterPhotoUrl))
                        {
                            <div class="col-6">
                                <small class="text-success fw-bold d-block">Sonrası (Kanıt)</small>
                                <img src="@tk.AfterPhotoUrl" class="proof-thumb" alt="Sonrası" />
                            </div>
                        }
                    </div>
                    @if (tk.Status != "Tamamlandi" && staffList.Any())
                    {
                        <form asp-action="AssignTaskTicket" method="post" class="row g-2 align-items-center mt-1 pt-2 border-top">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@tk.Id" />
                            <input type="hidden" name="buildingId" value="@tk.BuildingId" />
                            <input type="hidden" name="previewRole" value="Manager" />
                            <div class="col-6">
                                <select name="assignedStaffId" class="form-select form-select-sm" required>
                                    <option value="">Görevli Seç...</option>
                                    @foreach (var st in staffList)
                                    {
                                        if (tk.AssignedStaffId == st.Id)
                                        {
                                            <option value="@st.Id" selected>@st.FullName (@st.RoleType)</option>
                                        }
                                        else
                                        {
                                            <option value="@st.Id">@st.FullName (@st.RoleType)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-3">
                                <select name="priority" class="form-select form-select-sm">
                                    <option value="Normal">Normal</option>
                                    <option value="Acil">Acil</option>
                                </select>
                            </div>
                            <div class="col-3">
                                <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill">Ata</button>
                            </div>
                        </form>
                    }
                    else if (tk.AssignedStaff != null)
                    {
                        <div class="small text-muted pt-1 border-top">Görevli: <b>@tk.AssignedStaff.FullName</b> @(!string.IsNullOrEmpty(tk.StaffCompletionNote) ? $"• Not: {tk.StaffCompletionNote}" : "")</div>
                    }
                </div>
            }
        }
        else if (activeRole == "Owner" || activeRole == "Tenant")
        {
            <!-- ==================== ROL 2: KAT MALİKİ / KİRACI PWA ==================== -->
            var firstUnit = residentUnits.FirstOrDefault();
            bool ownerLivesInUnit = activeRole == "Owner" && firstUnit != null && (firstUnit.IsEmpty || string.IsNullOrWhiteSpace(firstUnit.TenantName));
            var relevantDebts = activeRole == "Tenant"
                ? tenantDebts
                : (ownerLivesInUnit ? allDebts : ownerDebts);
            decimal unpaidSum = Math.Max(0m, relevantDebts.Where(d => !d.IsPaid).Sum(d => d.Amount));
            decimal paidSum = relevantDebts.Where(d => d.IsPaid).Sum(d => d.Amount);
            var openDebtItems = relevantDebts.Where(d => !d.IsPaid).OrderByDescending(d => d.Id).ToList();
            decimal? unitFixedDues = firstUnit?.FixedMonthlyDues;
            var duesCalc = GMK360.Web.Services.FacilityGovernanceService.ComputeUnitEffectiveMonthlyDues(firstUnit, firstUnit?.Building?.DefaultBaseMonthlyDues ?? 0m);
            int dueDayOfMonth = firstUnit?.Building?.DuesPaymentDay ?? fixedExpenses.FirstOrDefault()?.DueDayOfMonth ?? 5;
            decimal payDefaultAmount = unpaidSum > 0 ? unpaidSum : duesCalc.Amount;

            <div class="card pwa-card bg-white p-3 mb-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge @(activeRole == "Owner" ? "bg-danger" : "bg-primary") mb-1">
                            @(activeRole == "Owner" ? (ownerLivesInUnit ? "Kat Maliki (Oturan / Aidat & Demirbaş)" : "Kat Maliki (Demirbaş & Kıdem Fonu)") : "Kiracı (Aylık İşletme Aidatı)")
                        </span>
                        <h6 class="fw-bold mb-0">@(firstUnit != null ? $"{firstUnit.Building?.Name} • Daire {firstUnit.DoorNumber}" : activeSiteName)</h6>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">Açık Borç / Bakiye</small>
                        <strong class="fs-5 @(unpaidSum > 0 ? "text-danger" : "text-success")">@unpaidSum.ToString("N2") ₺</strong>
                    </div>
                </div>

                <div class="row g-2 bg-light rounded-3 p-2 mb-2 small">
                    <div class="col-5">
                        <span class="text-muted d-block">Tanımlı Aidat</span>
                        <strong>@(duesCalc.IsExempt ? "Tam Muaf (0,00 ₺)" : (duesCalc.Amount > 0 ? $"{duesCalc.Amount:N0} ₺/ay" : "Dağıtıma Göre"))</strong>
                        <small class="d-block text-muted" style="font-size:.7rem;">@duesCalc.BreakdownNote</small>
                    </div>
                    <div class="col-4">
                        <span class="text-muted d-block">Ödeme Günü</span>
                        <strong>Her ayın @dueDayOfMonth. günü</strong>
                    </div>
                    <div class="col-3 text-end">
                        <span class="text-muted d-block">Ödenen</span>
                        <strong class="text-success">@paidSum.ToString("N2") ₺</strong>
                    </div>
                </div>

                @if (openDebtItems.Any())
                {
                    <div class="border rounded-3 p-2 mb-2 bg-white small">
                        <div class="fw-bold text-dark mb-1">Bekleyen Aidat &amp; Pay Kalemleri (@openDebtItems.Count)</div>
                        @foreach (var od in openDebtItems.Take(5))
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <div>
                                    <span class="text-dark fw-semibold">@(od.BuildingExpense?.Description ?? "Aidat / Gider Payı")</span>
                                    <span class="text-muted ms-1">(@(od.BuildingExpense?.Date.ToString("dd.MM.yyyy") ?? "-") • @(od.PayerRole == "Owner" ? "Malik" : "İşletme"))</span>
                                </div>
                                <strong class="text-danger">@od.Amount.ToString("N2") ₺</strong>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top">
                    <div class="small text-muted">
                        @if (activeRole == "Owner" && firstUnit != null)
                        {
                            <span>Kiracı Durumu: <b>@(string.IsNullOrWhiteSpace(firstUnit.TenantName) ? "Yok / Boş" : firstUnit.TenantName)</b></span>
                        }
                        else
                        {
                            <span>Dönem Aidat Ödeme Kanalları:</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#payDuesModal">
                            <i class="bi bi-bank me-1"></i> Öde (IBAN / Havale Bildir)
                        </button>
                        @if (payDefaultAmount > 0)
                        {
                            <a href="/Payment/Checkout?amount=@payDefaultAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)&subMerchantKey=SITE_@buildingId&description=@System.Net.WebUtility.UrlEncode($"{activeSiteName} Aidat/Borç Ödemesi")"
                               class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" title="iyzico Kart Ödeme Altyapısı (Test / Sandbox)">
                                <i class="bi bi-credit-card me-1"></i> Kartla Öde (iyzico)
                            </a>
                        }
                    </div>
                </div>
            </div>

            @if (boardMembership != null)
            {
                <div class="card pwa-card bg-white p-3 mb-3 border border-info border-opacity-50">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div>
                            <span class="badge bg-info text-dark rounded-pill">@boardRoleLabel Yetkisi</span>
                            <h6 class="fw-bold mb-0 mt-1">Kurul &amp; Denetim Özeti — @(boardMembership.Building?.Name ?? "Site / Bina")</h6>
                        </div>
                        @if (rootBuildingId > 0)
                        {
                            <a href="/BuildingManager/Detail/@rootBuildingId" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                Bina Paneline Geç &rarr;
                            </a>
                        }
                    </div>
                    <div class="row g-2 mb-2 small">
                        <div class="col-6">
                            <div class="bg-light rounded-3 p-2">
                                <span class="text-muted d-block">Aylık İşletme Bütçesi</span>
                                <strong class="text-success">@budget.TotalMonthlyOperatingBudget.ToString("N0") ₺</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light rounded-3 p-2">
                                <span class="text-muted d-block">Kıdem / Demirbaş Fonu</span>
                                <strong class="text-danger">@budget.TotalMonthlyCapitalBudget.ToString("N0") ₺</strong>
                            </div>
                        </div>
                    </div>
                    @if (pendingApprovals.Any())
                    {
                        <div class="border-top pt-2 mt-1">
                            <div class="small fw-bold text-warning-emphasis mb-2">
                                <i class="bi bi-shield-lock-fill me-1"></i>Onay Bekleyen İşlemler (@pendingApprovals.Count)
                            </div>
                            @foreach (var req in pendingApprovals)
                            {
                                bool isManagerTransfer = req.RequestType == "MANAGER_TRANSFER";
                                bool canDecideThis = boardMembership.Role != GMK360.Core.Entities.BuildingManagerRole.Auditor || isManagerTransfer;
                                <div class="bg-light rounded-3 p-2 mb-2 small">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="badge @(isManagerTransfer ? "bg-danger" : "bg-warning text-dark")">
                                                @(isManagerTransfer ? "YÖNETİCİ DEVRİ (PIN)" : req.RequestType) (@req.ApprovalCount/@req.RequiredApprovals)
                                            </span>
                                            <div class="fw-semibold text-dark mt-1">@req.Reason</div>
                                        </div>
                                        @if (canDecideThis)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-1">
                                                <form asp-action="DecideBoardApproval" method="post" class="d-flex align-items-center gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@req.Id" />
                                                    <input type="hidden" name="buildingId" value="@buildingId" />
                                                    <input type="hidden" name="approve" value="true" />
                                                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                                    @if (isManagerTransfer)
                                                    {
                                                        <input type="text" name="confirmationPin" maxlength="6" class="form-control form-control-sm" style="width:110px;" placeholder="6 Haneli PIN" required />
                                                    }
                                                    <button type="submit" class="btn btn-xs btn-success rounded-pill px-2 fw-bold">Onayla</button>
                                                </form>
                                                <form asp-action="DecideBoardApproval" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@req.Id" />
                                                    <input type="hidden" name="buildingId" value="@buildingId" />
                                                    <input type="hidden" name="approve" value="false" />
                                                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger rounded-pill px-2">Reddet</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted">Şu an aza onayı bekleyen kritik bir kasa/iptal veya yönetici devri işlemi bulunmuyor.</div>
                    }

                    <div class="mt-2 pt-2 border-top">
                        <a class="small fw-semibold text-danger text-decoration-none" data-bs-toggle="collapse" href="#managerTransferCollapse" role="button">
                            <i class="bi bi-arrow-left-right me-1"></i>Yönetici Değişikliği / Devir Başlat (Kurul Onay + PIN) &rsaquo;
                        </a>
                        <div class="collapse mt-2" id="managerTransferCollapse">
                            <form asp-action="InitiateManagerTransfer" method="post" class="row g-2 bg-light p-2 rounded-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="buildingId" value="@buildingId" />
                                <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                <div class="col-12">
                                    <small class="text-muted d-block">Yönetici ayrıldığında veya ulaşılamadığında kurul onay PIN'i ile yetki yeni yöneticiye devredilir; eski yöneticinin şahsi hesabı korunur.</small>
                                </div>
                                <div class="col-6">
                                    <input type="text" name="newManagerFullName" class="form-control form-control-sm" placeholder="Yeni Yönetici Ad Soyad" required />
                                </div>
                                <div class="col-6">
                                    <input type="email" name="newManagerEmail" class="form-control form-control-sm" placeholder="Yeni Yönetici E-posta" required />
                                </div>
                                <div class="col-6">
                                    <input type="text" name="newManagerPhone" class="form-control form-control-sm" placeholder="Telefon (05XX...)" />
                                </div>
                                <div class="col-6">
                                    <input type="text" name="newManagerTcNo" maxlength="11" class="form-control form-control-sm" placeholder="T.C. Kimlik (Opsiyonel)" />
                                </div>
                                <div class="col-12">
                                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="Devir nedeni (Örn: Genel Kurul Kararı #12)" />
                                </div>
                                <div class="col-12 text-end">
                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Devir Talebi &amp; Onay PIN'i Oluştur</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <!-- FOTOĞRAFLI TALEP GÖNDER KARTI -->
            <div class="card pwa-card bg-white p-3 mb-3 border border-success border-opacity-25">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-camera-fill me-1"></i> Fotoğraflı Arıza / Talep Bildirimi Gönder</h6>
                <form asp-action="CreateTaskTicket" method="post" enctype="multipart/form-data" class="row g-2 compressed-photo-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildingId" value="@buildingId" />
                    <input type="hidden" name="createdByRole" value="@(activeRole == "Owner" ? "MalSahibi" : "Kiraci")" />
                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                    @if (residentUnits.Count > 1)
                    {
                        <div class="col-12">
                            <select name="buildingUnitId" class="form-select form-select-sm">
                                @foreach (var u in residentUnits)
                                {
                                    <option value="@u.Id">@u.Building?.Name — Daire @u.DoorNumber</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="buildingUnitId" value="@firstUnit?.Id" />
                    }
                    <div class="col-6">
                        <select name="category" class="form-select form-select-sm" id="resCatSelect" onchange="toggleAutoCleanHint()">
                            <option value="Temizlik/Cop">Temizlik / Çöp (Oto Görevli)</option>
                            <option value="Elektrik/Aydinlatma">Elektrik / Lamba</option>
                            <option value="Asansor">Asansör</option>
                            <option value="Bahce">Ortak Alan / Bahçe</option>
                            <option value="Guvenlik">Güvenlik</option>
                            <option value="Sikayet">📣 Şikayet (Yönetim / Komşu)</option>
                            <option value="Oneri">💡 Öneri / İstek (Kurula Sunulacak)</option>
                            <option value="Diger">Diğer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <input type="text" name="locationNote" class="form-control form-control-sm" value="@(firstUnit != null ? $"Daire {firstUnit.DoorNumber} / Blok İçi" : "Ortak Alan")" />
                    </div>
                    <div class="col-12">
                        <input type="text" name="description" class="form-control form-control-sm" required placeholder="Tek cümle ile yazın (Örn: B blok 3. kat lamba patlamış)..." />
                    </div>
                    <div class="col-12">
                        <label class="btn btn-outline-success btn-sm w-100 rounded-pill fw-semibold">
                            <i class="bi bi-camera me-1"></i> Arka Kamera ile Fotoğraf Çek
                            <input type="file" name="beforePhoto" class="d-none pwa-camera-input" accept="image/*" capture="environment" />
                        </label>
                        <small class="text-muted compress-status d-block text-center mt-1" style="font-size:.72rem;">Fotoğraf cihazınızda 1024px (~150KB) sıkıştırılarak gönderilir.</small>
                    </div>
                    <div class="col-12" id="autoCleanBadge">
                        <span class="badge bg-success-subtle text-success w-100 py-1">Temizlik/Çöp seçildiğinde yönetici onayı beklemeden temizlik görevlisine iletilir.</span>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2">Bildirimi Gönder</button>
                    </div>
                </form>
            </div>

            <h6 class="fw-bold text-dark mb-2 px-1">Taleplerim &amp; Çözüm Kanıtları</h6>
            @foreach (var tk in tickets)
            {
                <div class="card pwa-card bg-white p-3 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong>@tk.Category (@tk.LocationNote)</strong>
                        <span class="badge @(tk.Status == "Tamamlandi" ? "bg-success" : tk.Status == "Atandi" ? "bg-primary" : "bg-warning text-dark")">@tk.Status</span>
                    </div>
                    <p class="small text-muted mb-2">@tk.Description</p>
                    <div class="row g-2">
                        @if (!string.IsNullOrEmpty(tk.BeforePhotoUrl))
                        {
                            <div class="col-6"><img src="@tk.BeforePhotoUrl" class="proof-thumb" alt="Bildirim" /></div>
                        }
                        @if (!string.IsNullOrEmpty(tk.AfterPhotoUrl))
                        {
                            <div class="col-6"><img src="@tk.AfterPhotoUrl" class="proof-thumb" alt="Çözüm Kanıtı" /></div>
                        }
                    </div>
                </div>
            }

            var residentUnitIdSet = residentUnits.Select(u => u.Id).ToHashSet();
            var tenantAuthorizedMeetings = activeRole == "Tenant"
                ? meetings.Where(m =>
                    string.Equals(m.InvitationScope, "AllResidents", StringComparison.OrdinalIgnoreCase)
                    || (m.Votes ?? new List<GMK360.Core.Entities.BuildingDecisionVote>()).Any(v => !v.IsDeleted && v.ParticipationType == "Vekil" && residentUnitIdSet.Contains(v.BuildingUnitId))).ToList()
                : meetings;
            if (activeRole == "Owner" || tenantAuthorizedMeetings.Any())
            {
            <!-- TOPLANTILAR & KARAR DEFTERİ (MALİK TOPLANTI & OYLAMA YAPAR; KİRACI YALNIZCA VEKALET VARSA GÖRÜR) -->
            <div class="card pwa-card bg-white p-3 mt-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-journal-bookmark text-primary me-1"></i> Toplantılar &amp; Karar Defteri</h6>
                    <span class="badge bg-light text-dark border">@tenantAuthorizedMeetings.Count Toplantı / Karar</span>
                </div>
                @if (!tenantAuthorizedMeetings.Any())
                {
                    <p class="small text-muted mb-2">Henüz planlanmış toplantı veya yayınlanmış karar bulunmuyor.</p>
                }
                else
                {
                    var allEligibleBuildingUnits = ViewBag.AllEligibleBuildingUnits as List<GMK360.Core.Entities.BuildingUnit> ?? new List<GMK360.Core.Entities.BuildingUnit>();
                    @foreach (var m in tenantAuthorizedMeetings.Take(6))
                    {
                        var scopeUnitsForMeeting = m.IsSiteWide
                            ? allEligibleBuildingUnits
                            : allEligibleBuildingUnits.Where(u => u.BuildingId == m.ContextId).ToList();
                        var quorum = GMK360.Web.Helpers.KmkQuorumHelper.Compute(scopeUnitsForMeeting, m.Votes, m.QuorumType);
                        var mVotes = (m.Votes ?? new List<GMK360.Core.Entities.BuildingDecisionVote>()).Where(v => !v.IsDeleted).ToList();
                        var mAttachments = (m.Attachments ?? new List<GMK360.Core.Entities.BuildingDecisionAttachment>()).Where(a => !a.IsDeleted).OrderByDescending(a => a.CreatedAt).ToList();
                        var proxyUnitIds = mVotes.Where(v => v.ParticipationType == "Vekil").Select(v => v.BuildingUnitId).ToHashSet();
                        var scopedResidentUnits = m.IsSiteWide
                            ? residentUnits
                            : residentUnits.Where(u => u.BuildingId == m.ContextId).ToList();
                        var eligibleUnitsForUser = activeRole == "Owner"
                            ? scopedResidentUnits
                            : scopedResidentUnits.Where(u => proxyUnitIds.Contains(u.Id)).ToList();
                        bool isDiscussionStage = string.Equals(m.WorkflowStage, "Discussion", StringComparison.OrdinalIgnoreCase);
                        bool canDiscuss = activeRole == "Owner"
                            || string.Equals(m.InvitationScope, "AllResidents", StringComparison.OrdinalIgnoreCase)
                            || eligibleUnitsForUser.Any()
                            || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("BinaYoneticisi");

                        <div class="border rounded-3 p-2 mb-2 @(m.IsConcluded ? "bg-light" : isDiscussionStage ? "bg-primary bg-opacity-10 border-primary" : "bg-warning bg-opacity-10 border-warning")">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <strong class="small text-dark">
                                    @(isDiscussionStage ? "Toplantı" : "Karar") #@(m.DecisionNumber ?? m.Id.ToString("D2")) — @m.AgendaTitle
                                </strong>
                                <span class="badge @(m.IsConcluded ? "bg-success" : isDiscussionStage ? "bg-primary" : "bg-warning text-dark")">
                                    @(m.IsConcluded ? "Karara Bağlandı" : isDiscussionStage ? "🤝 Açık Toplantı & Müzakere" : "📒 Karar Defteri Oylaması")
                                </span>
                            </div>
                            <div class="text-muted d-flex flex-wrap justify-content-between align-items-center gap-1 mt-1" style="font-size:.75rem;">
                                <span><i class="bi bi-calendar3 me-1"></i>@m.MeetingDate.ToString("dd.MM.yyyy HH:mm")</span>
                                @if (isDiscussionStage)
                                {
                                    <span class="badge bg-white text-primary border">
                                        Davet: @(m.InvitationScope == "AllResidents" ? "Tüm Malik & Kiracılar" : m.InvitationScope == "OwnersOnly" ? "Sadece Mal Sahipleri" : "Malikler + Vekaletli Kiracılar")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge @(quorum.IsQuorumMet ? "bg-success-subtle text-success" : "bg-light text-dark border")">
                                        Ön Onay: @quorum.ApprovedUnits/@quorum.TotalUnits Malik (%@quorum.ApprovalUnitPercent)
                                    </span>
                                }
                            </div>
                            @if (m.Decisions != null && m.Decisions.Any())
                            {
                                <div class="mt-1 pt-1 border-top small">
                                    @foreach (var dec in m.Decisions)
                                    {
                                        <div><i class="bi bi-check2-circle text-success me-1"></i>@dec.DecisionText</div>
                                    }
                                </div>
                            }
                            @if (mAttachments.Any())
                            {
                                <div class="mt-2 pt-1 border-top" style="font-size:.78rem;">
                                    <div class="fw-bold text-muted mb-1">Belgeler &amp; Görüşler (@mAttachments.Count):</div>
                                    @foreach (var att in mAttachments.Take(5))
                                    {
                                        <div class="bg-white rounded border px-2 py-1 mb-1">
                                            <strong>@att.AuthorName</strong> <span class="text-muted">(@att.AuthorRoleLabel)</span>:
                                            @if (!string.IsNullOrWhiteSpace(att.CommentText)) { <span>@att.CommentText</span> }
                                            @if (!string.IsNullOrWhiteSpace(att.FileUrl))
                                            {
                                                <a href="@att.FileUrl" target="_blank" class="ms-1 fw-semibold"><i class="bi bi-paperclip"></i>@(att.DocumentTitle ?? "Belgeyi Aç")</a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (!isDiscussionStage && !m.IsConcluded && eligibleUnitsForUser.Any())
                            {
                                <div class="mt-2 pt-2 border-top bg-white rounded-3 p-2">
                                    <div class="fw-bold mb-1" style="font-size:.78rem;">
                                        <i class="bi bi-hand-thumbs-up text-success me-1"></i>Uzaktan Ön Onayınız (PIN Gerektirmez — İmza Deftere Yazılınca Alınır):
                                    </div>
                                    @foreach (var eu in eligibleUnitsForUser)
                                    {
                                        var myVote = mVotes.FirstOrDefault(v => v.BuildingUnitId == eu.Id);
                                        <div class="border rounded-2 p-2 mb-1 bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:.76rem;">
                                                <strong>Daire @eu.DoorNumber (@(activeRole == "Owner" ? "Asil Malik" : "Yazılı Vekil"))</strong>
                                                @if (myVote != null && myVote.VoteChoice != "Pending")
                                                {
                                                    <span class="badge @(myVote.VoteChoice == "Kabul" ? "bg-success" : "bg-danger")">
                                                        Seçiminiz: @myVote.VoteChoice
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                                <form asp-action="SubmitRemoteDecisionVote" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@buildingId" />
                                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                                    <input type="hidden" name="buildingUnitId" value="@eu.Id" />
                                                    <input type="hidden" name="voteChoice" value="Kabul" />
                                                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                                    <button type="submit" class="btn btn-xs @(myVote?.VoteChoice == "Kabul" ? "btn-success" : "btn-outline-success") rounded-pill px-3 fw-bold">
                                                        ✅ Katılıyorum (Ön Onay)
                                                    </button>
                                                </form>
                                                <form asp-action="SubmitRemoteDecisionVote" method="post" class="d-flex gap-1 flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="buildingId" value="@buildingId" />
                                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                                    <input type="hidden" name="buildingUnitId" value="@eu.Id" />
                                                    <input type="hidden" name="voteChoice" value="Ret" />
                                                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                                    <input type="text" name="dissentNote" class="form-control form-control-sm" value="@myVote?.DissentNote" placeholder="Şerh / gerekçe (isteğe bağlı)" style="font-size:.74rem;" />
                                                    <button type="submit" class="btn btn-xs @(myVote?.VoteChoice == "Ret" ? "btn-danger" : "btn-outline-danger") rounded-pill px-2 fw-bold text-nowrap">
                                                        ❌ Katılmıyorum
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!m.IsConcluded && canDiscuss)
                            {
                                <form asp-action="AddRemoteMeetingComment" method="post" enctype="multipart/form-data" class="mt-2 pt-2 border-top row g-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="buildingId" value="@buildingId" />
                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                    <div class="col-7">
                                        <input type="text" name="commentText" class="form-control form-control-sm" placeholder="@(isDiscussionStage ? "Konu hakkında görüş / öneri / itiraz yazın..." : "Görüş / öneri yazın...")" />
                                    </div>
                                    <div class="col-3">
                                        <input type="file" name="attachmentFile" class="form-control form-control-sm" title="Belge/Teklif Ekle" />
                                    </div>
                                    <div class="col-2">
                                        <button type="submit" class="btn btn-xs btn-primary w-100 rounded-pill fw-bold">Gönder</button>
                                    </div>
                                </form>
                            }
                            else if (!m.IsConcluded && isDiscussionStage && activeRole == "Tenant")
                            {
                                <div class="alert alert-light border py-1 px-2 mt-2 mb-0 small text-muted">
                                    <i class="bi bi-shield-lock me-1"></i>Bu toplantıya görüş eklemek için mülk sahibiniz tarafından adınıza <strong>yazılı vekalet</strong> tanımlanmalıdır.
                                </div>
                            }
                            @if (activeRole == "Owner" && !m.IsConcluded)
                            {
                                <form asp-action="ProposeMeetingAgenda" method="post" class="mt-1 d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="buildingId" value="@buildingId" />
                                    <input type="hidden" name="meetingId" value="@m.Id" />
                                    <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                                    <input type="text" name="agendaSubject" class="form-control form-control-sm" required placeholder="Bu toplantıya eklenecek ek gündem konunuz..." />
                                    <button type="submit" class="btn btn-xs btn-warning text-dark fw-bold rounded-pill px-2 text-nowrap">Konu Ekle</button>
                                </form>
                            }
                        </div>
                    }
                }

                @if (activeRole == "Owner")
                {
                    @if (meetingProposals.Any())
                    {
                        <div class="bg-light rounded-3 p-2 mb-2 small border">
                            <div class="fw-bold text-dark mb-1">Kat Maliklerinden İletilen Gündem Konuları (@meetingProposals.Count)</div>
                            @foreach (var mp in meetingProposals.Take(4))
                            {
                                <div class="py-1 border-bottom d-flex justify-content-between gap-2">
                                    <span>@mp.Title</span>
                                    <span class="badge bg-secondary">@mp.Status</span>
                                </div>
                            }
                        </div>
                    }

                    <form asp-action="ProposeMeetingAgenda" method="post" class="border-top pt-2 mt-2 row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="buildingId" value="@buildingId" />
                        <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">Yeni Toplantı / Genel Kurul Gündem Konusu Aç (Kat Maliki)</label>
                        </div>
                        <div class="col-8">
                            <input type="text" name="agendaSubject" class="form-control form-control-sm" required placeholder="Örn: Otopark bariyeri veya çatı yalıtımı gündeme alınsın..." />
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill fw-semibold">Konu Aç</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="small text-muted border-top pt-2 mt-1">
                        <i class="bi bi-info-circle me-1"></i>Yalnızca mülk sahibinizin yazılı vekalet verdiği toplantılar görüntülenir.
                    </div>
                }
            </div>
            }

            @if (activeRole == "Owner")
            {
                <!-- MALİK ŞEFFAFLIK ALANI (SALT OKUNUR: PLANLI İŞLER & BİNA GİDER ÖZETİ) -->
                <div class="card pwa-card bg-white p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-calendar2-check text-success me-1"></i> Planlı İşler &amp; Bakım Takvimi</h6>
                        <span class="badge bg-light text-muted border">Salt Okunur</span>
                    </div>
                    @if (!plannedMaintenances.Any())
                    {
                        <p class="small text-muted mb-0">Yönetim tarafından henüz ileri tarihli planlı bakım kaydı girilmemiş.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-1 small">
                            @foreach (var pm in plannedMaintenances)
                            {
                                <div class="bg-light rounded-3 px-2 py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-dark">@pm.ItemName</strong>
                                        <span class="text-muted ms-1">(@pm.Category @(!string.IsNullOrWhiteSpace(pm.TechnicalServiceName) ? $"• {pm.TechnicalServiceName}" : ""))</span>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        @pm.NextMaintenanceDate?.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="card pwa-card bg-white p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-wallet2 text-primary me-1"></i> Bina Kasa &amp; Gider Şeffaflığı</h6>
                        <span class="badge bg-light text-muted border">@(boardMembership != null ? "Kurul İzleme" : "Salt Okunur (İşlem Yetkisi Yok)")</span>
                    </div>
                    <div class="row g-2 mb-2 small">
                        <div class="col-6">
                            <div class="bg-light rounded-3 p-2">
                                <span class="text-muted d-block">Aylık İşletme Bütçesi</span>
                                <strong class="text-success">@budget.TotalMonthlyOperatingBudget.ToString("N0") ₺</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light rounded-3 p-2">
                                <span class="text-muted d-block">Kıdem / Demirbaş Fonu</span>
                                <strong class="text-danger">@budget.TotalMonthlyCapitalBudget.ToString("N0") ₺</strong>
                            </div>
                        </div>
                    </div>
                    @if (recentExpenses.Any())
                    {
                        <div class="small border rounded-3 p-2 bg-white">
                            <div class="fw-bold text-muted mb-1">Son Kesilen Bina Giderleri</div>
                            @foreach (var ex in recentExpenses)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-dark">@ex.Description <small class="text-muted">(@ex.Date.ToString("dd.MM.yyyy"))</small></span>
                                    <strong>@ex.TotalAmount.ToString("N2") ₺</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">Henüz yayınlanmış fatura / gider kaydı bulunmuyor.</p>
                    }
                </div>
            }
        }
        else
        {
            <!-- ==================== ROL 3: SİTE GÖREVLİSİ PWA ==================== -->
            var latestPayroll = staffProfile?.MonthlyPayrolls?.OrderByDescending(p => p.Year).ThenByDescending(p => p.Month).FirstOrDefault();
            int usedDays = staffProfile?.Leaves?.Where(l => l.LeaveYear == DateTime.Today.Year && l.LeaveType == "YillikIzin" && !l.IsDeleted).Sum(l => l.TotalDays) ?? 0;
            int entitlement = staffProfile?.AnnualLeaveEntitlementDays ?? 14;

            <div class="card pwa-card bg-white p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-dark mb-1">@(staffProfile?.RoleType ?? "Site Görevlisi")</span>
                        <h5 class="fw-bold mb-0">@(staffProfile?.FullName ?? "Görevli Profili")</h5>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">Yıllık İzin Hakkı</small>
                        <strong class="text-success">@Math.Max(0, entitlement - usedDays) / @entitlement Gün</strong>
                    </div>
                </div>
                @if (latestPayroll != null)
                {
                    <div class="small bg-light p-2 rounded-3 mt-2 d-flex justify-content-between">
                        <span>@latestPayroll.Year-@latestPayroll.Month.ToString("00") Hak Ediş: <b>@latestPayroll.NetPayableToStaff.ToString("N2") ₺</b></span>
                        <span class="text-success">Bayram: +@latestPayroll.HolidayExtraPay.ToString("N2") ₺</span>
                    </div>
                }
                @if (staffProfile != null)
                {
                    <form asp-action="RequestStaffLeave" method="post" class="row g-2 mt-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="buildingStaffId" value="@staffProfile.Id" />
                        <input type="hidden" name="buildingId" value="@staffProfile.BuildingId" />
                        <input type="hidden" name="leaveType" value="YillikIzin" />
                        <input type="hidden" name="previewRole" value="@(canSwitch ? "Staff" : "")" />
                        <div class="col-4"><input type="date" name="startDate" class="form-control form-control-sm" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" /></div>
                        <div class="col-4"><input type="date" name="endDate" class="form-control form-control-sm" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" /></div>
                        <div class="col-4"><button type="submit" class="btn btn-sm btn-outline-warning text-dark w-100 rounded-pill fw-bold">İzin İste</button></div>
                    </form>
                }
            </div>

            <h6 class="fw-bold text-dark mb-2 px-1">Bugünkü Görevlerim (@tickets.Count(t => t.Status != "Tamamlandi"))</h6>
            @if (!tickets.Any())
            {
                <div class="card pwa-card bg-white p-4 text-center text-muted small">Üzerinize atanmış açık görev bulunmuyor.</div>
            }
            @foreach (var tk in tickets)
            {
                <div class="card pwa-card bg-white p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div>
                            <span class="badge @(tk.Priority == "Acil" ? "bg-danger" : "bg-primary")">@tk.Priority</span>
                            <strong class="ms-1">@tk.Category</strong>
                        </div>
                        <span class="badge @(tk.Status == "Tamamlandi" ? "bg-success" : "bg-warning text-dark")">@tk.Status</span>
                    </div>
                    <div class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@tk.LocationNote</div>
                    <p class="small text-dark mb-2">@tk.Description</p>
                    @if (!string.IsNullOrEmpty(tk.BeforePhotoUrl))
                    {
                        <img src="@tk.BeforePhotoUrl" class="proof-thumb mb-2" alt="Sorun" />
                    }
                    @if (tk.Status != "Tamamlandi")
                    {
                        <form asp-action="CompleteTaskTicket" method="post" enctype="multipart/form-data" class="row g-2 compressed-photo-form pt-2 border-top">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@tk.Id" />
                            <input type="hidden" name="buildingId" value="@tk.BuildingId" />
                            <input type="hidden" name="previewRole" value="@(canSwitch ? "Staff" : "")" />
                            <div class="col-12">
                                <input type="text" name="completionNote" class="form-control form-control-sm" placeholder="Kapanış notu (Örn: Temizlendi / Ampul değiştirildi)" />
                            </div>
                            <div class="col-12">
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold">
                                    <i class="bi bi-camera-fill me-1"></i> Tamamlandı Kanıt Fotoğrafı Çek
                                    <input type="file" name="afterPhoto" class="d-none pwa-camera-input" accept="image/*" capture="environment" />
                                </label>
                                <small class="text-muted compress-status d-block text-center mt-1" style="font-size:.7rem;">Otomatik 1024px (~150KB) sıkıştırılır</small>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold">İşi Bitirdim (Tamamlandı)</button>
                            </div>
                        </form>
                    }
                </div>
            }
        }
    </div>

    <!-- IBAN / AİDAT ÖDEME BİLDİRİM MODALI -->
    <div class="modal fade" id="payDuesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content rounded-4 border-0 shadow" asp-action="SubmitBankPaymentNotice" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buildingId" value="@buildingId" />
                <input type="hidden" name="buildingUnitId" value="@(residentUnits.FirstOrDefault()?.Id)" />
                <input type="hidden" name="previewRole" value="@(canSwitch ? activeRole : "")" />
                <div class="modal-header bg-success text-white border-0">
                    <h6 class="modal-title fw-bold"><i class="bi bi-bank me-2"></i>IBAN ile Aidat / Borç Öde &amp; Bildir</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 row g-3">
                    <div class="col-12">
                        @if (bankAccounts.Any())
                        {
                            <div class="small fw-bold text-dark mb-2">Yönetimin Resmi Banka / IBAN Hesapları:</div>
                            @foreach (var ba in bankAccounts)
                            {
                                <div class="border rounded-3 p-2 mb-2 bg-light d-flex justify-content-between align-items-center gap-2 small">
                                    <div>
                                        <div class="fw-bold text-dark">@ba.BankName — @ba.AccountName</div>
                                        <code class="text-primary">@ba.IBAN</code>
                                    </div>
                                    <button type="button" class="btn btn-xs btn-outline-dark rounded-pill px-2 fw-semibold"
                                            onclick="navigator.clipboard.writeText('@ba.IBAN').then(() => alert('IBAN kopyalandı:\n@ba.IBAN'))">
                                        Kopyala
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning small rounded-3 py-2 mb-0">
                                Yönetim henüz Muhasebe ekranından IBAN tanımlamamış; ancak havale/elden ödeme yaptıysanız tutarı aşağıdan yönetime bildirebilirsiniz.
                            </div>
                        }
                    </div>
                    @if (bankAccounts.Any())
                    {
                        <div class="col-12">
                            <label class="form-label small fw-bold">Gönderim Yapılan Hesap</label>
                            <select name="bankAccountId" class="form-select form-select-sm">
                                @foreach (var ba in bankAccounts)
                                {
                                    <option value="@ba.Id">@ba.BankName — @ba.IBAN</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-6">
                        <label class="form-label small fw-bold">Ödenen Tutar (₺) *</label>
                        @{
                            var firstU = residentUnits.FirstOrDefault();
                            var modalDebts = activeRole == "Tenant" ? tenantDebts : ownerDebts;
                            var modalOpenSum = Math.Max(0m, modalDebts.Where(d => !d.IsPaid).Sum(d => d.Amount));
                            var suggestedPay = modalOpenSum > 0 ? modalOpenSum : (firstU?.FixedMonthlyDues ?? 0m);
                        }
                        <input type="number" step="0.01" min="1" name="amount" class="form-control form-control-sm" value="@(suggestedPay > 0 ? suggestedPay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" required placeholder="Örn: 1500" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Gönderen / Dekont Notu</label>
                        <input type="text" name="senderInfo" class="form-control form-control-sm" placeholder="Ad Soyad / Daire No" />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-sm btn-light rounded-pill" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 fw-bold">Ödeme Bildirimini Yönetime İlet</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @{ ViewData["FeedbackModule"] = (activeRole == "Owner" || activeRole == "Tenant") ? "SakinPortal" : "SiteYonetimi"; }
    <partial name="_FeedbackWidgetPartial" />
    <partial name="_PwaScriptsPartial" />
    <script>
        (function () {
            var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
            var card = document.getElementById('portalPwaGuideCard');
            var btn = document.getElementById('portalPwaInstallBtn');
            var hint = document.getElementById('portalPwaGuideHint');
            if (!card || isStandalone || sessionStorage.getItem('gmk_portal_pwa_hide')) return;

            var ua = navigator.userAgent || '';
            var isIos = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
            if (isIos) {
                card.classList.remove('d-none');
                if (hint) hint.innerHTML = 'iPhone Safari alt menüden <strong>Paylaş</strong> &rarr; <strong>Ana Ekrana Ekle</strong> seçin.';
            } else if (window.__gmkDeferredPwaPrompt) {
                card.classList.remove('d-none');
                if (btn) btn.classList.remove('d-none');
            }

            window.addEventListener('gmk:pwa-ready', function () {
                if (sessionStorage.getItem('gmk_portal_pwa_hide')) return;
                card.classList.remove('d-none');
                if (btn) btn.classList.remove('d-none');
            });
            window.addEventListener('gmk:pwa-installed', function () {
                card.classList.add('d-none');
            });
        })();

        function toggleAutoCleanHint() {
            const sel = document.getElementById('resCatSelect');
            const b = document.getElementById('autoCleanBadge');
            if (sel && b) b.style.display = sel.value === 'Temizlik/Cop' ? 'block' : 'none';
        }

        // Client-Side Fotoğraf Sıkıştırma (Canvas API -> max 1024px, ~150KB JPEG)
        function compressImageFile(file, maxWidth = 1024, quality = 0.78) {
            return new Promise((resolve) => {
                if (!file || !file.type.startsWith('image/')) { resolve(file); return; }
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const img = new Image();
                    img.onload = function () {
                        let w = img.width, h = img.height;
                        if (w > maxWidth) {
                            h = Math.round(h * (maxWidth / w));
                            w = maxWidth;
                        }
                        const canvas = document.createElement('canvas');
                        canvas.width = w;
                        canvas.height = h;
                        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                        canvas.toBlob(function (blob) {
                            if (!blob) { resolve(file); return; }
                            const compressed = new File([blob], (file.name || 'photo').replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' });
                            resolve(compressed);
                        }, 'image/jpeg', quality);
                    };
                    img.onerror = function () { resolve(file); };
                    img.src = ev.target.result;
                };
                reader.onerror = function () { resolve(file); };
                reader.readAsDataURL(file);
            });
        }

        document.querySelectorAll('.pwa-camera-input').forEach(function (inp) {
            inp.addEventListener('change', async function () {
                if (!this.files || !this.files.length) return;
                const orig = this.files[0];
                const form = this.closest('form');
                const statusEl = form ? form.querySelector('.compress-status') : null;
                if (statusEl) statusEl.innerText = 'Fotoğraf sıkıştırılıyor...';

                const small = await compressImageFile(orig, 1024, 0.78);
                const dt = new DataTransfer();
                dt.items.add(small);
                this.files = dt.files;

                if (statusEl) {
                    const kb = Math.max(1, Math.round(small.size / 1024));
                    statusEl.innerHTML = `<span class="text-success fw-bold">Hazır (${kb} KB • 1024px JPEG)</span>`;
                }
            });
        });
    </script>
</body>
</html>
