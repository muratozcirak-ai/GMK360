@model IEnumerable<GMK360.Core.Entities.BuildingUnit>
@{
    ViewData["Title"] = "Müşteri Portalı - Evlerim";
}

<div class=""container mt-4 mb-5"">
    <div class=""d-flex justify-content-between align-items-center mb-4"">
        <h2 class=""fw-bold text-dark"">Müşteri Portalı</h2>
        <span class=""badge bg-primary rounded-pill px-3 py-2""><i class=""bi bi-person-check me-1""></i> Hoş Geldiniz</span>
    </div>

    @if (!Model.Any())
    {
        <div class=""alert alert-info border-0 shadow-sm rounded-4 p-4 text-center"">
            <i class=""bi bi-house-x text-muted"" style=""font-size: 3rem;""></i>
            <h5 class=""fw-bold mt-3"">Henüz Kayıtlı Bir Mülkünüz Yok</h5>
            <p class=""text-muted"">Sistemimizde adınıza kayıtlı bir konut veya proje bulunamadı. Lütfen satış temsilcinizle iletişime geçin.</p>
        </div>
    }
    else
    {
        <div class=""row g-4"">
            @foreach (var unit in Model)
            {
                <div class=""col-md-6 col-lg-4"">
                    <div class=""card border-0 shadow-sm rounded-4 h-100 overflow-hidden transition-hover"">
                        <div class=""bg-light position-relative"" style=""height: 180px;"">
                            @if (!string.IsNullOrEmpty(unit.Building?.ConstructionProject?.CoverImageUrl))
                            {
                                <img src=""@unit.Building.ConstructionProject.CoverImageUrl"" class=""w-100 h-100 object-fit-cover"" alt=""Proje Görseli"">
                            }
                            else
                            {
                                <div class=""d-flex justify-content-center align-items-center w-100 h-100 bg-secondary text-white"">
                                    <i class=""bi bi-building"" style=""font-size: 3rem;""></i>
                                </div>
                            }
                            <div class=""position-absolute top-0 start-0 m-3"">
                                <span class=""badge bg-dark bg-opacity-75 rounded-pill"">@unit.Building?.ConstructionProject?.Name</span>
                            </div>
                        </div>
                        
                        <div class=""card-body p-4"">
                            <h5 class=""fw-bold mb-1"">Blok: @unit.Building?.BlockName</h5>
                            <p class=""text-primary fw-bold fs-5 mb-3"">Daire: @unit.UnitNumber <small class=""text-muted fs-6 fw-normal"">(@unit.FloorLevel. Kat)</small></p>
                            
                            <div class=""d-flex gap-2"">
                                <a href=""@Url.Action("MyUnitProgress", "CustomerPortal", new { unitId = unit.Id })"" class=""btn btn-outline-primary rounded-pill flex-grow-1"">
                                    <i class=""bi bi-activity""></i> İnşaat Durumu
                                </a>
                                <a href=""@Url.Action("MyUnitMaterials", "CustomerPortal", new { unitId = unit.Id })"" class=""btn btn-primary rounded-pill flex-grow-1"">
                                    <i class=""bi bi-palette""></i> Seçimler
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .object-fit-cover { object-fit: cover; }
</style>
