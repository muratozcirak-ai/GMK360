                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Lokasyon</label>
                            <input type="text" name="location" class="form-control rounded-3" placeholder="Örn: Kadıköy / Caferağa" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Fiyat (₺)</label>
                            <input type="number" name="price" class="form-control rounded-3" placeholder="0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Oda Sayısı</label>
