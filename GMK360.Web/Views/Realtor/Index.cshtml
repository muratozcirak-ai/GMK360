                            <label class="form-label small fw-bold text-muted">İlgili Mülk / Portföy</label>
                            <select name="propertyTitle" class="form-select rounded-3">
                                @foreach(var l in Model.Listings)
                                {
                                    <option value="@l.Title">@l.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
