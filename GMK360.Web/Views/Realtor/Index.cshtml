    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form action="/Realtor/AssignConsultant" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="listingId" id="assignListingId" />
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-navy">Danışmana Portföy Devret</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small" id="assignListingTitle"></p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Bölge Danışmanını Seçin</label>
                        <select name="consultantName" class="form-select rounded-3">
                            @foreach(var staff in Model.BrokerTeam)
                            {
                                <option value="@staff.FullName">@staff.FullName (@staff.SpecializedTerritory)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Danışmana Ata</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openAssignModal(id, title) {
        document.getElementById('assignListingId').value = id;
        document.getElementById('assignListingTitle').innerText = 'Seçilen İlan: ' + title;
        new bootstrap.Modal(document.getElementById('assignModal')).show();
    }

    function copyGreeting() {
        const text = document.getElementById('greetingTextSample').innerText;
        navigator.clipboard.writeText(text).then(() => {
            alert('Bayram tebrik metni panoya kopyalandı! WhatsApp Web veya telefonunuzdan müşterilerinize yapıştırabilirsiniz.');
        });
    }

    function copyAdvisory(title, m2) {
        fetch(`/Realtor/GetTadilatQuote?propertyTitle=${encodeURIComponent(title)}&m2=${m2}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    navigator.clipboard.writeText(data.text).then(() => {
                        alert('Tadilat Danışmanlık Maliyet Özeti panoya kopyalandı! Alıcı veya satıcı müşterinize WhatsApp üzerinden gönderebilirsiniz.');
                    });
                }
            });
    }
</script>
