                            <label class="form-label small fw-bold text-muted">Alıcı Telefonu</label>
                            <input type="text" name="buyerPhone" class="form-control rounded-3" placeholder="0532..." required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                                <label class="form-label small fw-bold text-primary">Alıcının Telaffuz Ettiği Teklif (₺)</label>
                                <input type="number" name="buyerOfferedPrice" class="form-control rounded-3 mb-2" placeholder="0" required />
                                <label class="form-label small fw-bold text-primary">Alıcıya Ne Dedim? (Taktik Mesajı)</label>
                                <textarea name="whatIToldBuyer" class="form-control rounded-3" rows="2" placeholder="Örn: Ev sahibinin 7.1M tabanı olduğunu ama tadilat masrafı için indirim isteyeceğimi söyledim..."></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                                <label class="form-label small fw-bold text-danger">Satıcının Gerçek Taban / Razı Fiyatı (₺)</label>
                                <input type="number" name="sellerBottomPrice" class="form-control rounded-3 mb-2" placeholder="0" required />
                                <label class="form-label small fw-bold text-danger">Satıcıya Ne Dedim? (Geri Bildirim)</label>
                                <textarea name="whatIToldSeller" class="form-control rounded-3" rows="2" placeholder="Örn: Alıcının piyasa durgunluğundan 6.9M verdiğini ama 7.0M'e bitirebileceğimi belirttim..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Gizli Taktik Notu (Sadece Siz Görürsünüz)</label>
                        <input type="text" name="secretNotes" class="form-control rounded-3" placeholder="Örn: Alıcının eşi mutfağı yenilemek istiyor, tadilat tablosuyla ikna edeceğiz." />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">Kayıt Et (Korumalı)</button>
                </div>
            </form>
        </div>
    </div>
</div>

