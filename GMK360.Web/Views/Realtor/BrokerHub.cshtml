@model GMK360.Web.Models.RealtorDashboardViewModel
@{
    ViewData["Title"] = "Remax & Mega Broker Yönetim Üssü";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4 px-lg-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold mb-1">
                <i class="ph-bold ph-buildings me-1"></i> Mega Broker & Zincir Ofis Kokpiti
            </span>
            <h2 class="fw-bold text-navy mb-0">@Model.AgencyName - Danışman Yönetim Üssü</h2>
            <p class="text-muted small mb-0">Merkeze gelen portföyleri saha danışmanlarına dağıtın, komisyon ve işlem performansını izleyin.</p>
        </div>
        <a href="/Realtor" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
            <i class="ph-bold ph-arrow-left me-1"></i> Emlak Masasına Dön
        </a>
    </div>

    <!-- EKİP METRİKLERİ -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-bold text-uppercase">Aktif Danışman</div>
                <h3 class="fw-bold text-navy mb-0">@Model.BrokerTeam.Count</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-bold text-uppercase">Toplam Portföy</div>
                <h3 class="fw-bold text-primary mb-0">@Model.BrokerTeam.Sum(b => b.ActiveListingsCount)</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-muted small fw-bold text-uppercase">Bu Ay Kapanan Satış</div>
                <h3 class="fw-bold text-success mb-0">@Model.BrokerTeam.Sum(b => b.MonthlyDealsClosed)</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white text-center">
                <div class="text-white-50 small fw-bold text-uppercase">Sistem Lisansı</div>
                <h3 class="fw-bold mb-0">Ücretsiz Mega Lisans</h3>
            </div>
        </div>
    </div>

    <!-- DANIŞMAN LİSTESİ -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
            <h5 class="fw-bold mb-0 text-navy">Ofis Danışman Kadrosu ve Yetki Alanları</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th class="ps-4">DANIŞMAN</th>
                        <th>UZMANLIK BÖLGESİ</th>
                        <th class="text-center">AKTİF İLAN</th>
                        <th class="text-center">BU AY KAPANAN</th>
                        <th class="text-center">KOMİSYON PAYI</th>
                        <th class="text-end pe-4">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var staff in Model.BrokerTeam)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-navy">@staff.FullName</div>
                                <small class="text-muted">@staff.Title</small>
                            </td>
                            <td><i class="ph-bold ph-map-pin text-primary me-1"></i>@staff.SpecializedTerritory</td>
                            <td class="text-center fw-bold">@staff.ActiveListingsCount</td>
                            <td class="text-center fw-bold text-success">@staff.MonthlyDealsClosed</td>
                            <td class="text-center">
                                <span class="badge bg-info bg-opacity-10 text-info fw-bold">
                                    %@staff.CommissionSharePercent Danışman / %@(100 - staff.CommissionSharePercent) Ofis
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="tel:@staff.Phone" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                    <i class="ph-bold ph-phone me-1"></i> Ara
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
