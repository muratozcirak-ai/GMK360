@{
    ViewData["Title"] = "Konum ve Adres Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Adres Yönetim Merkezi</h2>
            <p class="text-muted">Türkiye geneli il, ilçe, mahalle ve binaların yönetim/birleştirme paneli.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Stats -->
            <div class="col-md-3">
                <a href="/AdminLocation/Cities" class="text-decoration-none">
                    <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Şehir / İl</h5>
                            <h2 class="display-4 fw-bold mb-0">@ViewBag.CityCount</h2>
                            <p class="mb-0 text-white-50 mt-2">Toplam İl <i class="bi bi-arrow-right ms-1"></i></p>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-md-3">
                <a href="/AdminLocation/Districts" class="text-decoration-none">
                    <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">İlçe</h5>
                            <h2 class="display-4 fw-bold mb-0">@ViewBag.DistrictCount</h2>
                            <p class="mb-0 text-white-50 mt-2">Toplam İlçe <i class="bi bi-arrow-right ms-1"></i></p>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-md-3">
                <div class="card bg-warning text-dark border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Mahalle</h5>
                        <h2 class="display-4 fw-bold mb-0">@ViewBag.NeighborhoodCount</h2>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <a href="/AdminLocation/Streets" class="text-decoration-none">
                    <div class="card bg-info text-white border-0 shadow-sm rounded-4 h-100 p-3" style="transition: transform 0.2s;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Sokak / Cadde</h5>
                            <h2 class="display-4 fw-bold mb-0">@ViewBag.StreetCount</h2>
                            <p class="mb-0 text-white-50 mt-2">Sokakları Yönet <i class="bi bi-arrow-right ms-1"></i></p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- YENİ: Mahalle Bölme ve Toplu İşlemler -->
        <div class="col-md-12 mb-2">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-primary" style="border-left: 5px solid #0d6efd !important;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-4">
                            <i class="bi bi-diagram-3 text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Bölge Bölme ve Birleştirme</h4>
                            <p class="text-muted small mb-0">Mahalleleri bölün, binlerce sokağı tek tıkla başka mahalleye aktarın veya yeni sokak ekleyin.</p>
                        </div>
                    </div>
                    <a href="/AdminLocation/BulkMove" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                        İşlem Paneline Git <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Shortcuts -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-magic text-warning me-2"></i> Hatalı Binaları Birleştir</h5>
                    <p class="text-muted small mb-4">Kullanıcıların yanlış isimle girdiği aynı binaları tek çatı altında birleştirin ve veritabanını temizleyin.</p>
                    <a href="/AdminLocation/Buildings" class="btn btn-outline-primary rounded-pill w-100">Bina Birleştirme Paneli <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square text-info me-2"></i> Sokak / Mahalle İsimlerini Düzenle</h5>
                    <p class="text-muted small mb-4">Belediye veya devlet tarafından adı değiştirilen sokak/caddeleri buradan güncelleyebilirsiniz.</p>
                    <a href="/AdminLocation/Streets" class="btn btn-outline-info rounded-pill w-100">Sokak Düzenleme Paneli <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
