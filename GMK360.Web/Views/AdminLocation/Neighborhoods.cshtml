@model IEnumerable<GMK360.Core.Entities.Neighborhood>
@{
    ViewData["Title"] = "Mahalle Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cities = ViewBag.Cities as List<GMK360.Core.Entities.City>;
    var selectedCityId = ViewBag.SelectedCityId as int?;
    var selectedDistrictId = ViewBag.SelectedDistrictId as int?;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Mahalle Yönetimi</h2>
            <p class="text-muted">Mahalle isimlerini düzenleyin, yeni mahalle ekleyin veya mahalleyi başka bir ilçeye taşıyın.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary rounded-pill me-2" data-bs-toggle="modal" data-bs-target="#addNeighborhoodModal">
                <i class="bi bi-plus-lg me-2"></i> Yeni Mahalle Ekle
            </button>
            <a href="/AdminLocation/Index" class="btn btn-light rounded-pill"><i class="bi bi-arrow-left me-2"></i> Merkeze Dön</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end" id="filterForm">
                <div class="col-md-4">
                    <label class="form-label text-muted small">İl</label>
                    <select name="cityId" id="filterCity" class="form-select rounded-3">
                        <option value="">-- Tüm İller --</option>
                        @foreach(var city in cities)
                        {
                            if (selectedCityId == city.Id) {
                                <option value="@city.Id" selected>@city.Name</option>
                            } else {
                                <option value="@city.Id">@city.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">İlçe</label>
                    <select name="districtId" id="filterDistrict" class="form-select rounded-3">
                        <option value="">-- İlçe Seçin --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary rounded-pill w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>İl</th>
                            <th>İlçe</th>
                            <th>Mahalle Adı</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@item.Id</td>
                                <td>@item.District?.City?.Name</td>
                                <td>@item.District?.Name</td>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="editNeighborhood(@item.Id, '@item.Name', @item.District?.CityId, @item.DistrictId)">Düzenle / Taşı</button>
                                </td>
                            </tr>
                        }
                        @if(!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Kayıt bulunamadı. Lütfen filtreleme yapın.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Neighborhood Modal -->
<div class="modal fade" id="addNeighborhoodModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Yeni Mahalle Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/AdminLocation/AddNeighborhood" method="post">
                <div class="modal-body py-0">
                    <div class="mb-3">
                        <label class="form-label text-muted small">İl</label>
                        <select id="addCity" class="form-select rounded-3" required>
                            <option value="">-- Seçiniz --</option>
                            @foreach(var city in cities)
                            {
                                <option value="@city.Id">@city.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Bağlı Olacağı İlçe</label>
                        <select id="addDistrict" name="districtId" class="form-select rounded-3" required>
                            <option value="">-- Önce İl Seçiniz --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Mahalle Adı</label>
                        <input type="text" name="name" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Neighborhood Modal -->
<div class="modal fade" id="editNeighborhoodModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Mahalleyi Düzenle / Taşı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/AdminLocation/EditNeighborhood" method="post">
                <input type="hidden" id="editId" name="id" />
                <div class="modal-body py-0">
                    <div class="mb-3">
                        <label class="form-label text-muted small">İl</label>
                        <select id="editCity" class="form-select rounded-3" required>
                            <option value="">-- Seçiniz --</option>
                            @foreach(var city in cities)
                            {
                                <option value="@city.Id">@city.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Bağlı Olduğu İlçe</label>
                        <select id="editDistrict" name="districtId" class="form-select rounded-3" required>
                            <option value="">-- Önce İl Seçiniz --</option>
                        </select>
                        <small class="text-primary">Mahalleyi başka bir ilçeye taşımak istiyorsanız buradan değiştirebilirsiniz.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Mahalle Adı</label>
                        <input type="text" id="editName" name="name" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function loadDistricts(cityId, targetSelectId, selectedDistrictId = null) {
        var targetSelect = document.getElementById(targetSelectId);
        targetSelect.innerHTML = '<option value="">Yükleniyor...</option>';
        if(!cityId) {
            targetSelect.innerHTML = '<option value="">-- İlçe Seçin --</option>';
            return;
        }
        fetch('/AdminLocation/GetDistricts?cityId=' + cityId)
            .then(response => response.json())
            .then(data => {
                targetSelect.innerHTML = '<option value="">-- Seçiniz --</option>';
                data.forEach(function (d) {
                    var isSelected = (selectedDistrictId == d.id) ? 'selected' : '';
                    targetSelect.innerHTML += `<option value="${d.id}" ${isSelected}>${d.name}</option>`;
                });
            });
    }

    document.getElementById('filterCity').addEventListener('change', function() {
        loadDistricts(this.value, 'filterDistrict');
    });
    
    document.getElementById('addCity').addEventListener('change', function() {
        loadDistricts(this.value, 'addDistrict');
    });
    
    document.getElementById('editCity').addEventListener('change', function() {
        loadDistricts(this.value, 'editDistrict');
    });

    // Initialize filter dropdown on load
    window.addEventListener('load', function() {
        var currentCityId = document.getElementById('filterCity').value;
        var currentDistrictId = '@(selectedDistrictId)';
        if(currentCityId) {
            loadDistricts(currentCityId, 'filterDistrict', currentDistrictId);
        }
    });

    function editNeighborhood(id, currentName, currentCityId, currentDistrictId) {
        document.getElementById('editId').value = id;
        document.getElementById('editName').value = currentName;
        document.getElementById('editCity').value = currentCityId;
        
        // Load districts for this city and select the current one
        loadDistricts(currentCityId, 'editDistrict', currentDistrictId);
        
        var modal = new bootstrap.Modal(document.getElementById('editNeighborhoodModal'));
        modal.show();
    }
</script>
