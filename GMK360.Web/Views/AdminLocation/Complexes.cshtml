@model IEnumerable<GMK360.Core.Entities.Complex>
@{
    var neighborhood = ViewBag.Neighborhood as GMK360.Core.Entities.Neighborhood;
    ViewData["Title"] = $"{neighborhood?.Name} - Binalar ve Siteler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="mb-3">
        <a href="/AdminLocation/Neighborhoods?districtId=@neighborhood?.DistrictId" class="text-decoration-none text-muted"><i class="ph ph-arrow-left"></i> Mahallelere Dön</a>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="ph ph-buildings"></i> @neighborhood?.Name - Binalar ve Siteler</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Durum</th>
                            <th>Bina / Site Adı</th>
                            <th>Sokak Adı</th>
                            <th>Kapı No</th>
                            <th>Bloklu mu?</th>
                            <th>Eklenme Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    @if (c.IsApproved)
                                    {
                                        <span class="badge bg-success"><i class="ph ph-check-circle"></i> Onaylı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="ph ph-clock"></i> Bekliyor</span>
                                    }
                                </td>
                                <td class="fw-bold">@c.Name</td>
                                <td>@(c.Street != null ? c.Street.Name : "-")</td>
                                <td>@(string.IsNullOrEmpty(c.BuildingNumber) ? "-" : c.BuildingNumber)</td>
                                <td>@(c.HasBlocks ? "Evet" : "Hayır")</td>
                                <td>@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a href="/AdminLocation/ComplexDetail/@c.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="ph ph-eye"></i> İncele
                                    </a>
                                    <form action="/AdminLocation/DeleteComplex" method="post" class="d-inline" onsubmit="return confirm('Bu binayı kalıcı olarak silmek istediğinize emin misiniz? (Örn: Mükerrer kayıt)');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="ph ph-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if(!Model.Any()) {
                            <tr><td colspan="7" class="text-center text-muted py-4">Bu mahallede kayıtlı bina veya site bulunamadı.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
