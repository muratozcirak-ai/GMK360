@model IEnumerable<GMK360.Core.Entities.Building>
@{
    ViewData["Title"] = "Bina Yönetimi ve Birleştirme (Merge)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Binalar ve Akıllı Birleştirme</h2>
            <p class="text-muted">Kayıtlı binaları arayın, hatalı olanı seçip doğru binanın içine taşıyın.</p>
        </div>
        <a href="/AdminLocation/Index" class="btn btn-light rounded-pill"><i class="bi bi-arrow-left me-2"></i> Geri Dön</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3">
                <div class="col-md-8">
                    <input type="text" name="searchQuery" class="form-control form-control-lg bg-light border-0" placeholder="Bina Adı ile Ara (Örn: Yaşar Bey Apt)">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill"><i class="bi bi-search me-2"></i> Binaları Ara</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>İl / İlçe</th>
                            <th>Mahalle / Sokak</th>
                            <th>Bina / Kapı No</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var b in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@b.Id</td>
                                <td>@b.City?.Name / @b.District?.Name</td>
                                <td>@b.Neighborhood?.Name / @b.Street</td>
                                <td class="fw-bold">@b.Name</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-warning rounded-pill" onclick="openMergeModal(@b.Id, '@b.Name', @b.StreetId)">
                                        <i class="bi bi-magic"></i> Birleştir (Merge)
                                    </button>
                                </td>
                            </tr>
                        }
                        @if(!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Sonuç bulunamadı.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Merge Modal -->
<div class="modal fade" id="mergeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle text-warning me-2"></i> Binayı Birleştir / Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">
                    <strong>Dikkat!</strong> Bu işlem <u>geri alınamaz</u>. Kaynak binadaki tüm daireler Hedef binaya taşınacak ve Kaynak Bina silinecektir.
                </div>
                
                <input type="hidden" id="sourceId">
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Kaynak (Silinecek Hatalı) Bina</label>
                    <input type="text" class="form-control bg-light border-0" id="sourceName" readonly>
                </div>
                
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Hedef (Doğru) Bina (Aynı sokaktakiler)</label>
                    <select class="form-select bg-light border-0" id="targetSelect">
                        <option value="">Yükleniyor...</option>
                    </select>
                </div>
                
                <button type="button" class="btn btn-danger w-100 rounded-pill" id="btnMerge" onclick="executeMerge()">
                    <i class="bi bi-magic me-2"></i> İçeriği Taşı ve Sil
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openMergeModal(sourceId, sourceName, streetId) {
            document.getElementById('sourceId').value = sourceId;
            document.getElementById('sourceName').value = sourceName + " (ID: " + sourceId + ")";
            
            // Fetch target buildings in the same street
            let select = document.getElementById('targetSelect');
            select.innerHTML = '<option value="">Binalar aranıyor...</option>';
            
            let res = await fetch(`/api/LocationApi/buildings/${streetId}`);
            let data = await res.json();
            
            select.innerHTML = '<option value="">Doğru binayı seçin...</option>';
            data.forEach(b => {
                if(b.id !== sourceId) {
                    select.innerHTML += `<option value="${b.id}">${b.name} (ID: ${b.id})</option>`;
                }
            });
            
            new bootstrap.Modal(document.getElementById('mergeModal')).show();
        }

        async function executeMerge() {
            let sourceId = document.getElementById('sourceId').value;
            let targetId = document.getElementById('targetSelect').value;
            
            if(!targetId) { alert("Lütfen hedef binayı seçin."); return; }
            if(!confirm("Emin misiniz? Tüm kayıtlar taşınıp eski bina SİLİNECEKTİR!")) return;
            
            document.getElementById('btnMerge').disabled = true;
            document.getElementById('btnMerge').innerHTML = "Birleştiriliyor...";
            
            let formData = new FormData();
            formData.append('sourceBuildingId', sourceId);
            formData.append('targetBuildingId', targetId);
            
            let res = await fetch('/AdminLocation/MergeBuildings', {
                method: 'POST',
                body: formData
            });
            
            if(res.ok) {
                alert("Başarıyla birleştirildi!");
                window.location.reload();
            } else {
                alert("Hata oluştu.");
                document.getElementById('btnMerge').disabled = false;
                document.getElementById('btnMerge').innerHTML = '<i class="bi bi-magic me-2"></i> İçeriği Taşı ve Sil';
            }
        }
    </script>
}
