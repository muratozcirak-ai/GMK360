<!-- Merge Modal -->
<div class="modal fade" id="mergeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle text-warning me-2"></i> BinayÄ± BirleÅŸtir / Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger small border-0 bg-danger bg-opacity-10 text-danger mb-4">
                    <strong>Dikkat!</strong> Bu iÅŸlem <u>geri alÄ±namaz</u>. Kaynak binadaki tÃ¼m daireler Hedef binaya taÅŸÄ±nacak ve Kaynak Bina silinecektir.
                </div>
                
                <input type="hidden" id="sourceId">
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Kaynak (Silinecek HatalÄ±) Bina</label>
                    <input type="text" class="form-control bg-light border-0" id="sourceName" readonly>
                </div>
                
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Hedef (DoÄŸru) Bina (AynÄ± sokaktakiler)</label>
                    <select class="form-select bg-light border-0" id="targetSelect">
                        <option value="">YÃ¼kleniyor...</option>
                    </select>
                </div>
                
                <button type="button" class="btn btn-danger w-100 rounded-pill" id="btnMerge" onclick="executeMerge()">
                    <i class="bi bi-magic me-2"></i> Ä°Ã§eriÄŸi TaÅŸÄ± ve Sil
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openMergeModal(sourceId, sourceName, streetId) {
            document.getElementById('sourceId').value = sourceId;
            document.getElementById('sourceName').value = sourceName + " (ID: " + sourceId + ")";
            
            // Fetch target buildings in the same street
            let select = document.getElementById('targetSelect');
            select.innerHTML = '<option value="">Binalar aranÄ±yor...</option>';
            
            let res = await fetch(`/api/LocationApi/buildings/${streetId}`);
            let data = await res.json();
            
            select.innerHTML = '<option value="">DoÄŸru binayÄ± seÃ§in...</option>';
            data.forEach(b => {
                if(b.id !== sourceId) {
                    select.innerHTML += `<option value="${b.id}">${b.name} (ID: ${b.id})</option>`;
                }
            });
            
            new bootstrap.Modal(document.getElementById('mergeModal')).show();
        }

        async function executeMerge() {
            let sourceId = document.getElementById('sourceId').value;
            let targetId = document.getElementById('targetSelect').value;
            
            if(!targetId) { alert("LÃ¼tfen hedef binayÄ± seÃ§in."); return; }
            if(!confirm("Emin misiniz? TÃ¼m kayÄ±tlar taÅŸÄ±nÄ±p eski bina SÄ°LÄ°NECEKTÄ°R!")) return;
            
            document.getElementById('btnMerge').disabled = true;
            document.getElementById('btnMerge').innerHTML = "BirleÅŸtiriliyor...";
            
            let formData = new FormData();
            formData.append('sourceBuildingId', sourceId);
            formData.append('targetBuildingId', targetId);
            
            let res = await fetch('/AdminLocation/MergeBuildings', {
                method: 'POST',
                body: formData
            });
            
            if(res.ok) {
                alert("BaÅŸarÄ±yla birleÅŸtirildi!");
                window.location.reload();
            } else {
                alert("Hata oluÅŸtu.");
                document.getElementById('btnMerge').disabled = false;
                document.getElementById('btnMerge').innerHTML = '<i class="bi bi-magic me-2"></i> Ä°Ã§eriÄŸi TaÅŸÄ± ve Sil';
            }
        }
    </script>
}

