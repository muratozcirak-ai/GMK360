@{
    ViewData["Title"] = "Gelen Malzeme Talepleri";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-inboxes"></i> Gelen Fiyat Talepleri (Nalbur Paneli)</h5>
    </div>
    <div class="card-body">
        
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Talep No</th>
                        <th>Usta / İsteyen</th>
                        <th>Liste Başlığı</th>
                        <th>Kalem Sayısı</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#ML-1024</td>
                        <td>Hasan Usta (Boya & Badana)</td>
                        <td>Kadıköy Boya İşi Malzemeleri</td>
                        <td>4 Kalem</td>
                        <td>Bugün 10:30</td>
                        <td><span class="badge bg-danger">Teklif Bekliyor</span></td>
                        <td>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#offerModal"><i class="bi bi-cash"></i> Fiyat Ver</button>
                        </td>
                    </tr>
                    <tr>
                        <td>#ML-1018</td>
                        <td>Elektrikçi Ali</td>
                        <td>Ataşehir Tesisat Değişimi</td>
                        <td>12 Kalem</td>
                        <td>Dün 15:45</td>
                        <td><span class="badge bg-success">Teklif Verildi (4.500 ₺)</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i> İncele</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- Teklif Verme Modalı -->
<div class="modal fade" id="offerModal" tabindex="-1" aria-labelledby="offerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title" id="offerModalLabel">Teklif Ver: #ML-1024 (Hasan Usta)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body">
        <h6>İstenen Malzemeler:</h6>
        <ul class="list-group mb-3">
            <li class="list-group-item d-flex justify-content-between align-items-center">
                20 Kg Saten Alçı
                <span class="badge bg-secondary rounded-pill">3 Çuval</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                Polisan Elegans Beyaz
                <span class="badge bg-secondary rounded-pill">2 Kutu</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                Rulo Fırça Seti
                <span class="badge bg-secondary rounded-pill">1 Adet</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                Hışır Örtü
                <span class="badge bg-secondary rounded-pill">5 Adet</span>
            </li>
        </ul>

        <hr />
        <div class="mb-3">
            <label class="form-label fw-bold">Toplam Teklif Fiyatınız (TL)</label>
            <input type="number" class="form-control form-control-lg text-primary fw-bold" placeholder="Örn: 2500" />
            <div class="form-text">Tüm liste için KDV dahil vereceğiniz toplam rakamı giriniz.</div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Açıklama / Not</label>
            <textarea class="form-control" rows="2" placeholder="Örn: Nakliye bize aittir, aynı gün teslim edebiliriz."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
        <button type="button" class="btn btn-success"><i class="bi bi-check2-circle"></i> Teklifi Gönder</button>
      </div>
    </div>
  </div>
</div>
