@model GMK360.Core.Entities.Marketplace.MarketplaceJob
@{
    ViewData["Title"] = "Yeni İlan Ver";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <h3 class="fw-bold text-dark mb-0">Yeni İş İlanı Oluştur</h3>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">İptal</a>
                </div>

                <form asp-action="Create" method="post">
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-bold">İlan Başlığı</label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="Örn: Komple Ev Boyanacak" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="JobType" class="form-label fw-bold">İş Kategorisi</label>
                            <select asp-for="JobType" class="form-select form-select-lg rounded-3" required>
                                <option value="">Seçiniz...</option>
                                <option value="Boya">Boya / Badana</option>
                                <option value="Tesisat">Elektrik / Su Tesisatı</option>
                                <option value="Fayans">Fayans / Seramik</option>
                                <option value="Kaba İnşaat">Kaba İnşaat</option>
                                <option value="Genel Tadilat">Genel Tadilat</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="EstimatedBudget" class="form-label fw-bold">Tahmini Bütçe (Opsiyonel)</label>
                            <div class="input-group">
                                <input asp-for="EstimatedBudget" type="number" class="form-control form-control-lg" placeholder="0.00" />
                                <span class="input-group-text">₺</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Location" class="form-label fw-bold">Konum / Adres Özeti</label>
                        <input asp-for="Location" class="form-control rounded-3" placeholder="Örn: İstanbul / Kadıköy - Moda" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">İşin Detayları</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="5" placeholder="Ölçüler, malzemeler kimden olacak, özel istekleriniz..." required></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill">İlanı Yayınla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

