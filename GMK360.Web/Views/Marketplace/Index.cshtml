@model IEnumerable<GMK360.Core.Entities.Marketplace.MarketplaceJob>
@{
    ViewData["Title"] = "Açık Market (Taşeron Pano)";
    var currentFilter = ViewBag.CurrentFilter as string;
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-shop me-2 text-primary"></i>Açık Market / İlanlar</h2>
            <p class="text-muted mb-0">İhtiyacınızı paylaşın veya uygun işlere teklif verin.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> Yeni İlan Ver
        </a>
    </div>

    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "all" ? "active rounded-pill" : "text-dark")" asp-action="Index" asp-route-filter="all">Tüm İlanlar</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "my" ? "active rounded-pill" : "text-dark")" asp-action="Index" asp-route-filter="my">Benim İlanlarım</a>
        </li>
    </ul>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-light border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-clipboard-x text-muted mb-3" style="font-size: 3rem;"></i>
            <h5 class="fw-bold">Henüz hiç ilan yok</h5>
            <p class="text-muted">Burada ustalar ve taşeronlar için açık ilanlar listelenir.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">@job.JobType</span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@job.CreatedAt.ToString("dd MMM yyyy")</small>
                            </div>
                            
                            <h5 class="fw-bold mb-2">@job.Title</h5>
                            <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @job.Description
                            </p>
                            
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-geo-alt text-danger me-2"></i>
                                <span class="small fw-medium">@job.Location</span>
                            </div>
                            
                            @if(job.EstimatedBudget.HasValue)
                            {
                                <div class="mb-3">
                                    <span class="small text-muted">Tahmini Bütçe:</span>
                                    <strong class="text-success">@job.EstimatedBudget.Value.ToString("N0") ₺</strong>
                                </div>
                            }
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <div class="small text-muted">
                                    <i class="bi bi-person-circle me-1"></i> @(job.CreatedByUser?.FirstName ?? "Anonim")
                                </div>
                                <div class="small">
                                    <i class="bi bi-chat-text me-1"></i> @job.Bids.Count Teklif
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <a asp-action="Detail" asp-route-id="@job.Id" class="btn btn-outline-primary w-100 rounded-pill">İncele ve Teklif Ver</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>

