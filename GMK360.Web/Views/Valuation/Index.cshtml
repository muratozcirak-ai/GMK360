@{
    ViewData["Title"] = "Bölge Kira & Satýþ Deðerleme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0" style="border-radius: 1rem;">
                <div class="card-header bg-primary text-white text-center" style="border-radius: 1rem 1rem 0 0; padding: 1.5rem;">
                    <h3 class="mb-0 fw-bold"><i class="ph ph-chart-line-up me-2"></i> Akýllý Bölge Deðerleme (V2)</h3>
                    <p class="mb-0 mt-2 text-white-50">Yapay Zeka ve Google Places Destekli Kapsamlý Rapor</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="ph ph-check-circle fs-4 me-2"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                    }

                    <form asp-controller="Valuation" asp-action="RequestValuation" method="post">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Ýl</label>
                                <input type="text" name="il" class="form-control form-control-lg" required placeholder="Örn: Ýzmir">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Ýlçe</label>
                                <input type="text" name="ilce" class="form-control form-control-lg" required placeholder="Örn: Karþýyaka">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Mahalle</label>
                                <input type="text" name="mahalle" class="form-control form-control-lg" required placeholder="Örn: Bostanlý">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mülk Tipi</label>
                                <select name="mulkTipi" class="form-select form-select-lg" required>
                                    <option value="Daire">Daire</option>
                                    <option value="Dükkan">Dükkan</option>
                                    <option value="Ofis">Ofis</option>
                                    <option value="Villa">Villa</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Oda Sayýsý / Büyüklük</label>
                                <input type="text" name="odaSayisi" class="form-control form-control-lg" required placeholder="Örn: 2+1 veya 150m2">
                            </div>
                        </div>

                        <div class="mt-4 text-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow-sm" style="border-radius: 10px;">
                                <i class="ph ph-magic-wand me-2"></i> Raporu Hazýrla ve Gönder
                            </button>
                            <div class="form-text mt-3">Ýþlem arka planda yapýlacak ve sonuçlar e-posta adresinize iletilecektir.</div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
