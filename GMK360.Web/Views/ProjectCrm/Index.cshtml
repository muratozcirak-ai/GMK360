@model IEnumerable<GMK360.Core.Entities.CrmContact>
@{
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
    ViewData["Title"] = "Müşteri & Potansiyel Alıcı Takibi (CRM)";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-people"></i> Müşteri & Ziyaretçi CRM</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCrmModal">
            <i class="bi bi-person-plus"></i> Yeni Kayıt Ekle
        </button>
    </div>
    <p class="text-muted">Bizden daire satın alan veya şantiyemizi/ofisimizi ziyaret edip daire bakan potansiyel müşterilerinizi buradan takip edebilirsiniz.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Müşteri Adı Soyadı</th>
                            <th>Telefon</th>
                            <th>Durum (Kategori)</th>
                            <th>Görüşme Notları</th>
                            <th>Kayıt Tarihi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-info text-white rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                            @item.FirstName.Substring(0,1)
                                        </div>
                                        <h6 class="mb-0">@item.FirstName @item.LastName</h6>
                                    </div>
                                </td>
                                <td>@item.PhoneNumber</td>
                                <td>
                                    @if(item.ContactType == "Potansiyel Alici") { <span class="badge bg-warning text-dark">Potansiyel Alıcı (Gezdi/Almadı)</span> }
                                    else if(item.ContactType == "Daire Sahibi") { <span class="badge bg-success">Daire Sahibi (Satış Yapıldı)</span> }
                                    else { <span class="badge bg-secondary">@item.ContactType</span> }
                                </td>
                                <td><small class="text-muted">@item.Notes</small></td>
                                <td>@item.CreatedAt.ToShortDateString()</td>
                            </tr>
                        }
                        @if(!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Henüz hiç CRM müşteri kaydınız bulunmuyor.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCrmModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Müşteri/Ziyaretçi Kaydı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row g-3">
                <div class="col-6">
                    <label class="form-label">Ad</label>
                    <input type="text" name="FirstName" class="form-control" required />
                </div>
                <div class="col-6">
                    <label class="form-label">Soyad</label>
                    <input type="text" name="LastName" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Telefon Numarası</label>
                    <input type="text" name="PhoneNumber" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Müşteri Durumu</label>
                    <select name="ContactType" class="form-select" required>
                        <option value="Potansiyel Alici">Potansiyel Alıcı (Şantiyeyi/Projeyi Gezdi)</option>
                        <option value="Daire Sahibi">Daire Sahibi (Satış Tamamlandı)</option>
                        <option value="Yatirimci">Yatırımcı (Fırsat Bekliyor)</option>
                        <option value="Diger">Diğer</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Görüşme Notları / Talepleri</label>
                    <textarea name="Notes" class="form-control" rows="3" placeholder="Örn: 3+1 güney cephe bakıyor, 1 ay sonra dönüş yapılacak..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>