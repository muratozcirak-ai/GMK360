@model IEnumerable<GMK360.Core.Entities.BuildingUnit>
@functions {
    public string GetFloorNameBySlabIndex(GMK360.Core.Entities.Building b, int slabIndex) {
        if (b == null) return slabIndex + ". Kat";
        int current = 1;
        int basements = b.BasementFloors;
        if (slabIndex <= basements) {
            int bodrumNo = (basements - slabIndex) + 1;
            return $"-{bodrumNo}. Bodrum";
        }
        current += basements;

        if (b.HasGroundFloor) {
            if (slabIndex == current) return "Zemin Kat";
            current++;
        }

        int totalF = b.TotalFloors ?? 0;
        int normalKatIndex = slabIndex - current + 1;
        
        if (b.HasRoof && normalKatIndex == totalF + 1) {
            return "Çatı Katı";
        }
        
        return $"{normalKatIndex}. Kat";
    }
}

@{
    ViewData["Title"] = "Satış & Kiralama Havuzu";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1 text-dark fw-bold"><i class="bi bi-building-check text-warning me-2"></i>Satış, Daire Portföyü & Müşteri Sözleşme Havuzu</h4>
        <p class="text-muted small mb-0">Projelerde şirketimize kalan satılık/kiralık daireler, dükkanlar, kapora/opsiyon işlemleri ve taksit/senetli satış sözleşmeleri.</p>
    </div>
    <a href="/ProjectCrm/Index" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-people-fill me-1"></i> Müşteri Cari & Senet Dosyaları
    </a>
</div>

<!-- Üst Sekme Barı: Satış Portföyü vs Alıcı & Müşteri Takibi -->
<ul class="nav nav-tabs mb-3 border-bottom">
    <li class="nav-item">
        <a href="/ProjectCrm/SalesPool" class="nav-link active fw-bold text-dark">
            <i class="bi bi-building-check text-warning me-1"></i>🏢 Satış & Kiralama Havuzu (Daireler & Dükkanlar)
            <span class="badge bg-warning text-dark rounded-pill ms-1">@(Model?.Count() ?? 0)</span>
        </a>
    </li>
    <li class="nav-item">
        <a href="/ProjectCrm/Index" class="nav-link fw-semibold text-secondary">
            <i class="bi bi-people-fill text-primary me-1"></i>👥 Alıcı & Müşteri Cari / Senet Takibi
            @if (ViewBag.CrmContactCount != null)
            {
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill ms-1">@ViewBag.CrmContactCount</span>
            }
        </a>
    </li>
</ul>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Proje & Şantiye</th>
                        <th>Blok / Kule</th>
                        <th>Kat</th>
                        <th>Kapı No</th>
                        <th>Birim Tipi</th>
                        <th>Brüt (m²)</th>
                        <th>Cephe</th>
                        <th>Liste / Satış Fiyatı</th>
                        <th>Alıcı / Malik</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">Satış & Sözleşme İşlemleri</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var unit in Model)
                        {
                            var projectName = unit.Building?.ConstructionProject?.Name ?? "Bilinmeyen Proje";
                            var blockName = unit.Building?.BlockName ?? "Ana Blok";
                            var floorName = GetFloorNameBySlabIndex(unit.Building, unit.FloorLevel);
                            var doorNo = unit.DoorNumber;
                            var category = string.IsNullOrWhiteSpace(unit.Category) ? "Mesken" : unit.Category;
                            var gross = unit.GrossSquareMeters > 0 ? unit.GrossSquareMeters.ToString() + " m²" : "-";
                            var facade = string.IsNullOrWhiteSpace(unit.FacadeDirection) ? "-" : unit.FacadeDirection;
                            string icon = (category == "Dükkan" || category == "Ticari") ? "bi-shop text-primary" : "bi-door-open-fill text-success";
                            var formattedPrice = unit.ListPrice.HasValue ? unit.ListPrice.Value.ToString("C0") : "<span class='text-muted fst-italic' style='font-size:0.75rem;'>Fiyat Girilmedi</span>";
                            var statusStr = string.IsNullOrWhiteSpace(unit.SalesStatus) ? "Müsait" : unit.SalesStatus;
                            var statusBadge = statusStr == "Satıldı" ? "bg-danger text-white" : (statusStr == "Opsiyonlu" ? "bg-warning text-dark" : "bg-success-subtle text-success border border-success-subtle");
                            var unitTitle = $"{projectName} - {blockName} {floorName} No:{doorNo}";

                            <tr>
                                <td class="ps-4 fw-bold text-dark">@projectName</td>
                                <td>@blockName</td>
                                <td>@floorName</td>
                                <td><span class="badge bg-light text-dark border">No: @doorNo</span></td>
                                <td>
                                    <i class="bi @icon me-1"></i> @category
                                    @if (!string.IsNullOrWhiteSpace(unit.RoomLayout) && unit.RoomLayout != category)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border ms-1" style="font-size:0.7rem;">@unit.RoomLayout</span>
                                    }
                                </td>
                                <td>@gross</td>
                                <td>@facade</td>
                                <td class="fw-bold">@Html.Raw(formattedPrice)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(unit.OwnerName))
                                    {
                                        <span class="fw-semibold text-dark"><i class="bi bi-person-check-fill text-success me-1"></i>@unit.OwnerName</span>
                                        @if (!string.IsNullOrEmpty(unit.OwnerPhone))
                                        {
                                            <div class="small text-muted">@unit.OwnerPhone</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Müteahhit Portföyü</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-2 py-1">@statusStr</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-success fw-semibold py-1 px-2"
                                                onclick="openUnitSaleModal('@unit.Id', '@Html.Raw(unitTitle.Replace("'", "\\'"))', 'Satis', '@(unit.ListPrice ?? 0)')">
                                            <i class="bi bi-cash-coin me-1"></i> Satış & Senet Planı
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold py-1 px-2"
                                                onclick="openUnitSaleModal('@unit.Id', '@Html.Raw(unitTitle.Replace("'", "\\'"))', 'Opsiyon', '@(unit.ListPrice ?? 0)')">
                                            <i class="bi bi-lock me-1"></i> Kapora / Opsiyon
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="bi bi-inboxes fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5>Şu an portföyde bağımsız bölüm bulunmuyor</h5>
                                <p class="small">Projelerinizde kat/daire planı oluşturulduğunda satılık daire ve dükkanlar otomatik olarak burada listelenir.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- DAİRE SATIŞ SÖZLEŞMESİ / KAPORA & SENET PLANI MODALI -->
<div class="modal fade" id="unitSaleModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="SellOrReserveUnit" method="post" class="modal-content border-0 shadow-lg rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="unitId" id="saleUnitId" />
            <input type="hidden" name="actionType" id="saleActionType" value="Satis" />
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold" id="saleModalTitle"><i class="bi bi-house-check-fill text-warning me-2"></i>Daire Satış Sözleşmesi, Peşinat & Taksit/Senet Planı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info border-0 small mb-3">
                    <strong>Seçili Bağımsız Bölüm:</strong> <span id="saleUnitSummary" class="fw-bold text-dark"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Alıcı Adı *</label>
                        <input type="text" name="buyerFirstName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Alıcı Soyadı *</label>
                        <input type="text" name="buyerLastName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">11 Haneli TC Kimlik No</label>
                        <input type="text" name="buyerIdentityNo" maxlength="11" class="form-control" placeholder="Tapu ve sözleşme için" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Cep Telefonu *</label>
                        <input type="text" name="buyerPhone" class="form-control" placeholder="05XX XXX XX XX" required />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Alıcı Tebligat / İkametgah Adresi</label>
                        <input type="text" name="buyerAddress" class="form-control" placeholder="Sözleşmede yer alacak açık adres..." />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-primary">Anlaşılan Satış Bedeli (₺) *</label>
                        <input type="number" step="0.01" name="salePrice" id="salePriceInput" class="form-control fw-bold border-primary" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-success">Alınan Peşinat / Kapora (₺)</label>
                        <input type="number" step="0.01" name="downPayment" class="form-control fw-bold border-success" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Kalan Bakiye Taksit / Senet Sayısı (Ay)</label>
                        <input type="number" min="0" max="120" name="installmentCount" class="form-control" value="12" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Sözleşme, Tapu Devri & Özel Şart Notları</label>
                        <input type="text" name="salesNotes" class="form-control" placeholder="Örn: %40 peşinat alındı, kalanı 12 ay eşit senet, iskan sonrası tapu devri..." />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                    <i class="bi bi-check2-circle me-1"></i> Sözleşmeyi Kaydet ve 360° Müşteri Cari Kartını Aç
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openUnitSaleModal(unitId, unitSummary, actionType, defaultPrice) {
        document.getElementById('saleUnitId').value = unitId;
        document.getElementById('saleUnitSummary').innerText = unitSummary;
        document.getElementById('saleActionType').value = actionType;
        document.getElementById('salePriceInput').value = defaultPrice > 0 ? defaultPrice : '';
        document.getElementById('saleModalTitle').innerHTML = actionType === 'Satis'
            ? '<i class="bi bi-house-check-fill text-warning me-2"></i>Daire Satış Sözleşmesi, Peşinat & Taksit/Senet Planı'
            : '<i class="bi bi-lock-fill text-warning me-2"></i>Daire Kapora / Opsiyon & Müşteri Kaydı';
        var modal = new bootstrap.Modal(document.getElementById('unitSaleModal'));
        modal.show();
    }
</script>
