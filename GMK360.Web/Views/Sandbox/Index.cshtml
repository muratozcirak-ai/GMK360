@{
    ViewData["Title"] = "B2B & Pazaryeri Sandbox";
    Layout = "_Layout";
}

<div class="container py-5">
    <h1 class="mb-4 text-primary"><i class="fas fa-flask me-2"></i> B2B & Pazaryeri Sandbox (Test Ekranı)</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4 py-3">
                    <h5 class="card-title mb-0"><i class="fas fa-tools me-2"></i> İş Atama Testi</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="TestAssignTradesman" method="post">
                        <div class="mb-3">
                            <label class="form-label">Tadilat/İş ID</label>
                            <input type="number" name="renovationId" class="form-control" required value="1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Usta Kullanıcı ID</label>
                            <input type="text" name="tradesmanId" class="form-control" required placeholder="Usta AppUserId" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Ustaya Ata</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-top-4 py-3">
                    <h5 class="card-title mb-0"><i class="fas fa-star me-2"></i> İş Tamamlama & Anket</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="TestCompleteJobAndSurvey" method="post">
                        <div class="mb-3">
                            <label class="form-label">Tadilat/İş ID</label>
                            <input type="number" name="renovationId" class="form-control" required value="1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Puan (1-5)</label>
                            <input type="number" name="rating" class="form-control" min="1" max="5" required value="5" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yorum</label>
                            <textarea name="comments" class="form-control" rows="2" placeholder="Harika iş çıkardı..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100">İşi Tamamla & Değerlendir</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="card shadow-sm border-0 rounded-4 mt-4">
                <div class="card-header bg-warning text-dark rounded-top-4 py-3">
                    <h5 class="card-title mb-0"><i class="fas fa-money-bill-wave me-2"></i> Evrensel Ödeme (Iyzico Pazaryeri) Testi</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="TestMarketplacePayment" method="post">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Gönderen User ID</label>
                                <input type="text" name="senderId" class="form-control" required placeholder="Ödeyen AppUserId" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Alıcı Hesap ID</label>
                                <input type="number" name="receiverAccountId" class="form-control" required placeholder="FinancialAccount ID (Alt Üye İşyeri)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tutar (₺)</label>
                                <input type="number" step="0.01" name="amount" class="form-control" required value="1000.00" />
                            </div>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-warning px-5 fw-bold">Ödemeyi Çek (Platform Komisyonu Dahil)</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
