@model GMK360.Core.Entities.B2B.B2BNetworkContact
@{
    ViewData["Title"] = "Yeni Tedarikçi / Taþeron Ekle";
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" asp-route-type="@ViewBag.Type" class="btn btn-light rounded-circle p-2 me-3">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <h2 class="fw-bold mb-0">Yeni @(ViewBag.Type == "tedarikci" ? "Tedarikçi" : "Taþeron") Ekle (Havuza)</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-bold">Firma Unvaný <span class="text-danger">*</span></label>
                                <input asp-for="CompanyName" class="form-control form-control-lg rounded-3" placeholder="Örn: ABC Demir A.Þ." required />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SectorCategory" class="form-label fw-bold">Kategori <span class="text-danger">*</span></label>
                                @if (ViewBag.Type == "tedarikci")
                                {
                                    <select asp-for="SectorCategory" class="form-select form-select-lg rounded-3" required>
                                        <option value="Malzeme Tedarikçisi" selected>Malzeme Tedarikçisi</option>
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="SectorCategory" class="form-select form-select-lg rounded-3" required>
                                        <option value="">-- Taþeron Tipi Seçiniz --</option>
                                        <option value="Kaba Ýnþaat">Kaba Ýnþaat (Demir, Beton, Kalýp)</option>
                                        <option value="Ýnce Ýþçilik">Ýnce Ýþçilik (Seramik, Boya, Alçý)</option>
                                        <option value="Tesisat">Tesisat (Elektrik, Su, Doðalgaz)</option>
                                        <option value="Hafriyat / Yýkým">Hafriyat / Yýkým</option>
                                        <option value="Diðer">Diðer Hizmet</option>
                                    </select>
                                }
                                <span asp-validation-for="SectorCategory" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ContactPerson" class="form-label fw-bold">Yetkili Kiþi <span class="text-danger">*</span></label>
                                <input asp-for="ContactPerson" class="form-control form-control-lg rounded-3" placeholder="Örn: Ahmet Yýlmaz" required />
                                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">Telefon Numarasý <span class="text-danger">*</span></label>
                                <input asp-for="PhoneNumber" type="tel" class="form-control form-control-lg rounded-3" placeholder="0555..." required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-bold">E-Posta Adresi (Opsiyonel)</label>
                                <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" placeholder="Firma daveti için önemlidir" />
                            </div>
                        </div>

                        <div class="alert alert-info border-0 bg-primary bg-opacity-10 mt-4 rounded-3 d-flex align-items-center">
                            <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
                            <div>
                                <strong>Bilgi:</strong> Eklediðiniz bu firma þimdilik "Gölge Profil" olarak havuzunuza eklenir. Ýleride þantiye sözleþmesi yaptýðýnýzda veya ihale daveti gönderdiðinizde, verdiðiniz numara/mail üzerinden GMK360'a davet edilebilir.
                            </div>
                        </div>

                        <hr class="my-5" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" asp-route-type="@ViewBag.Type" class="btn btn-light btn-lg rounded-pill px-4">Ýptal</a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">Havuza Ekle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

