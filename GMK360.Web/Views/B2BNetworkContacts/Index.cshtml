@model IEnumerable<GMK360.Core.Entities.B2B.B2BNetworkContact>
@{
    ViewData["Title"] = ViewBag.ListType;
    Layout = "_ConstructionLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-briefcase text-primary me-2"></i>@ViewBag.ListType</h2>
            <p class="text-muted mb-0">Merkez havuzunuz. Tüm baðlantýlarýnýzý ekleyin, daha sonra dilediðiniz þantiyeye atayýn.</p>
        </div>
        <a asp-action="Create" asp-route-type="@ViewBag.Type" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg fw-bold me-1"></i> Yeni Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3">Firma / Unvan</th>
                            <th class="py-3">Yetkili Kiþi</th>
                            <th class="py-3">Sektör / Kategori</th>
                            <th class="py-3">Ýletiþim</th>
                            <th class="py-3">Durum</th>
                            <th class="px-4 py-3 text-center">Ýþlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x display-4 mb-2 d-block"></i>
                                    Havuzunuzda henüz kayýtlý tedarikçi veya taþeron bulunmuyor.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold">@item.CompanyName</td>
                                <td>@item.ContactPerson</td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-dark">@item.SectorCategory</span></td>
                                <td>
                                    <div><i class="bi bi-telephone-fill text-muted me-1"></i> @item.PhoneNumber</div>
                                    @if(!string.IsNullOrEmpty(item.Email))
                                    {
                                        <div class="small text-muted"><i class="bi bi-envelope-fill me-1"></i> @item.Email</div>
                                    }
                                </td>
                                <td>
                                    @if(item.IsRegistered)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Sisteme Kayýtlý</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Gölge Profil (Davet Bekliyor)</span>
                                    }
                                </td>
                                <td class="px-4 text-center">
                                    <button class="btn btn-sm btn-light border" disabled><i class="bi bi-pencil"></i> Düzenle</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

