@{
    ViewData["Title"] = "Kişisel Emlak Ajandam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-journal-text text-primary me-2"></i> Kişisel Emlak Ajandam</h2>
            <p class="text-muted mb-0">İlanlar ve emlakçılar hakkındaki gizli notlarınız. Bu ekranı sizden başka kimse göremez.</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary rounded-pill shadow-sm"><i class="bi bi-plus-lg me-1"></i> Yeni Not Ekle</button>
        </div>
    </div>

    <div class="row">
        <!-- SOL: AJANDA AKIŞI -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    
                    <!-- Not 1 -->
                    <div class="d-flex mb-4 pb-4 border-bottom">
                        <img src="https://via.placeholder.com/100x100" class="rounded-3 shadow-sm me-3" alt="İlan">
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <h5 class="fw-bold text-dark mb-1">Kadıköy 3+1 Daire Görüşmesi</h5>
                                <span class="badge bg-warning text-dark rounded-pill">Randevu: Bugün 14:00</span>
                            </div>
                            <p class="text-primary small fw-bold mb-2"><i class="bi bi-building"></i> Yılmaz Emlak (Ahmet Bey)</p>
                            <div class="bg-light p-3 rounded-3 border-start border-4 border-primary">
                                <p class="mb-0 text-dark"><i class="bi bi-lock-fill text-muted me-1"></i> <strong>Gizli Notum:</strong> Mutfak dolapları eskiydi, fiyattan 50.000 TL düşürmeyi teklif edeceğim. Balkon cephesini mutlaka sor.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Not 2 -->
                    <div class="d-flex">
                        <img src="https://via.placeholder.com/100x100" class="rounded-3 shadow-sm me-3" alt="İlan">
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <h5 class="fw-bold text-dark mb-1">Manavgat Villa (Günlük Kiralık)</h5>
                                <span class="badge bg-success rounded-pill">Rezervasyon</span>
                            </div>
                            <p class="text-primary small fw-bold mb-2"><i class="bi bi-person"></i> Mehmet Yılmaz (Mülk Sahibi)</p>
                            <div class="bg-light p-3 rounded-3 border-start border-4 border-success">
                                <p class="mb-0 text-dark"><i class="bi bi-lock-fill text-muted me-1"></i> <strong>Gizli Notum:</strong> Havuz ısıtması için ekstra ücret istemiyorlar, sözleşmeye yazdırılacak.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- SAĞ: TAKVİM VE HIZLI ERİŞİM -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-calendar3 display-1 text-muted mb-3 opacity-25"></i>
                    <h5 class="fw-bold">Takvim Görünümü</h5>
                    <p class="small text-muted">Yakında takvim entegrasyonu ile tüm randevularınızı aylık düzlemde görebileceksiniz.</p>
                    <button class="btn btn-outline-secondary w-100 rounded-pill" disabled>Yakında Eklenecek</button>
                </div>
            </div>
        </div>
    </div>
</div>
