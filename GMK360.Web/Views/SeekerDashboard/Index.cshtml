@{
    ViewData["Title"] = "Özet Panelim - Bireysel Arayan";
    Layout = "~/Views/Shared/_Layout.cshtml"; // GMK360 standart layout
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark"><i class="bi bi-person-workspace text-primary me-2"></i> Bireysel Arayan Paneli</h2>
            <p class="text-muted">Emlak arayışınızı, günlük kiralama süreçlerinizi ve kişisel notlarınızı tek ekrandan yönetin.</p>
        </div>
    </div>

    <!-- DINAMİK WIDGET KARTLARI -->
    <div class="row g-4 mb-5">
        <!-- Aktif Teklif Durumu -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 rounded-4 border-start border-warning border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-muted mb-0">Bekleyen Teklifler</h6>
                        <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">1 Adet</h3>
                    <p class="small text-muted mb-0">Kadıköy 3+1 (2.500.000 TL) teklifiniz değerlendiriliyor.</p>
                </div>
            </div>
        </div>

        <!-- Yaklaşan Rezervasyon (Günlük Kiralama - Organik CRM) -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 rounded-4 border-start border-success border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-muted mb-0">Yaklaşan Rezervasyon</h6>
                        <i class="bi bi-calendar-check fs-4 text-success"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">7 Gün Kaldı</h3>
                    <p class="small text-muted mb-0">Manavgat Villa Konaklaması</p>
                    <a href="#" class="btn btn-sm btn-outline-success mt-2 rounded-pill w-100">Ev Sahibine Mesaj At</a>
                </div>
            </div>
        </div>

        <!-- Ajanda Hatırlatıcısı -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 rounded-4 border-start border-primary border-4 bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-primary mb-0">Bugünkü Randevum</h6>
                        <i class="bi bi-clock-history fs-4 text-primary"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">14:00 - Yılmaz Emlak</h5>
                    <p class="small text-dark mb-0 fw-bold"><i class="bi bi-pin-angle-fill text-danger"></i> Gizli Notum: Balkon cephesini sor.</p>
                </div>
            </div>
        </div>

        <!-- Talep Hafızası (Yeni Eşleşmeler) -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 rounded-4 border-start border-info border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-muted mb-0">Talep Hafızası</h6>
                        <i class="bi bi-bell-fill fs-4 text-info"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">3 Yeni İlan</h3>
                    <p class="small text-muted mb-0">"Antalya Sahile Yakın" kriterinize uygun yeni eşleşmeler bulundu.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- HIZLI ERİŞİM MENÜSÜ -->
    <div class="row g-4">
        <div class="col-md-4">
            <a href="/SeekerDashboard/Agenda" class="text-decoration-none">
                <div class="card bg-dark text-white border-0 shadow-lg rounded-4 hover-scale transition-all">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-journal-text display-4 mb-3"></i>
                        <h4 class="fw-bold">Kişisel Emlak Ajandam</h4>
                        <p class="opacity-75 small">Görüştüğünüz mülkleri ve gizli notlarınızı yönetin.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Emlak" class="text-decoration-none">
                <div class="card bg-primary text-white border-0 shadow-lg rounded-4 hover-scale transition-all">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-search display-4 mb-3"></i>
                        <h4 class="fw-bold">İlan Keşfet</h4>
                        <p class="opacity-75 small">Dinamik asenkron arama ve yan yana kıyaslama.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/SeekerDashboard/Favorites" class="text-decoration-none">
                <div class="card bg-danger text-white border-0 shadow-lg rounded-4 hover-scale transition-all">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-star-fill display-4 mb-3"></i>
                        <h4 class="fw-bold">Favorilerim</h4>
                        <p class="opacity-75 small">Beğendiğiniz ilanları ızgara (Grid) yapısında kıyaslayın.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .hover-scale:hover { transform: scale(1.03); cursor: pointer; }
    .transition-all { transition: all 0.3s ease; }
</style>
