@{
    ViewData["Title"] = "Favorilerim ve Yan Yana Kıyaslama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-star-fill text-warning me-2"></i> Favorilerim & Kıyaslama</h2>
            <p class="text-muted mb-0">Sabitlediğiniz ilanları sıfır karmaşa (Zero Overlap) kuralıyla yan yana kıyaslayın.</p>
        </div>
    </div>

    <!-- IZGARA (GRID) KIYASLAMA EKRANI -->
    <div class="row g-4">
        <!-- Ev 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <img src="https://via.placeholder.com/400x250" class="card-img-top rounded-top-4" alt="Ev 1">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Kadıköy Moda 3+1 Daire</h5>
                    <h3 class="text-primary fw-bold mb-3">2.500.000 TL</h3>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between px-0"><span class="text-muted">Metrekare</span> <strong>120 m²</strong></li>
                        <li class="list-group-item d-flex justify-content-between px-0"><span class="text-muted">Oda Sayısı</span> <strong>3+1</strong></li>
                        <li class="list-group-item d-flex justify-content-between px-0"><span class="text-muted">Cephe</span> <strong>Güney</strong></li>
                    </ul>
                    <div class="bg-warning bg-opacity-10 p-2 rounded-2 mb-3">
                        <small class="fw-bold text-dark"><i class="bi bi-journal-text me-1"></i> Ajanda Notum:</small>
                        <p class="small mb-0 mt-1">Mutfak eski ama konumu harika.</p>
                    </div>
                    <button class="btn btn-outline-danger w-100 rounded-pill"><i class="bi bi-trash"></i> Favorilerden Çıkar</button>
                </div>
            </div>
        </div>

        <!-- Ev 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <img src="https://via.placeholder.com/400x250" class="card-img-top rounded-top-4" alt="Ev 2">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Üsküdar Merkez 2+1</h5>
                    <h3 class="text-primary fw-bold mb-3">2.100.000 TL</h3>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between px-0"><span class="text-muted">Metrekare</span> <strong>95 m²</strong></li>
                        <li class="list-group-item d-flex justify-content-between px-0"><span class="text-muted">Oda Sayısı</span> <strong>2+1</strong></li>
                        <li class="list-group-item d-flex justify-content-between px-0"><span class="text-muted">Cephe</span> <strong>Kuzey</strong></li>
                    </ul>
                    <div class="bg-warning bg-opacity-10 p-2 rounded-2 mb-3">
                        <small class="fw-bold text-dark"><i class="bi bi-journal-text me-1"></i> Ajanda Notum:</small>
                        <p class="small mb-0 mt-1">Fiyat uygun ama ulaşım biraz sıkıntılı.</p>
                    </div>
                    <button class="btn btn-outline-danger w-100 rounded-pill"><i class="bi bi-trash"></i> Favorilerden Çıkar</button>
                </div>
            </div>
        </div>

        <!-- Boş Kıyaslama Yuvası -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-2 border-dashed border-secondary shadow-none rounded-4 h-100 bg-light d-flex align-items-center justify-content-center p-5 text-center">
                <i class="bi bi-plus-circle display-4 text-muted mb-3 opacity-50"></i>
                <h5 class="fw-bold text-muted">Kıyaslamak İçin İlan Ekle</h5>
                <p class="small text-muted">Arama ekranından beğendiğiniz ilanları sabitleyerek (Pin) buraya ekleyebilirsiniz.</p>
                <a href="/Emlak" class="btn btn-primary rounded-pill mt-2 px-4">İlan Keşfet</a>
            </div>
        </div>
    </div>
</div>
