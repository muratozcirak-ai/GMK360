@model List<GMK360.Core.Entities.Construction.Workflows.DnaProfession>
@{
    ViewData["Title"] = "İş Branşları (Usta/Meslek) Tanımlamaları";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="h3 mb-0 text-gray-800">
                <i class="fas fa-hard-hat text-warning me-2"></i>İş Branşları Tanımlamaları
            </h2>
            <p class="text-muted mt-2">
                Pazar yeri entegrasyonu ve DNA şablonlarında kullanılacak standart usta ve taşeron mesleklerini buradan yönetebilirsiniz.
            </p>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-1"></i> Şablonlara Dön
            </a>
            <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addProfessionModal">
                <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Yeni Branş Ekle
            </button>
        </div>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">#ID</th>
                            <th>Branş / Meslek Adı (Pazar Yeri Anahtar Kelimesi)</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var p in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@p.Id</td>
                                    <td>
                                        <span class="badge bg-info text-dark fs-6">@p.Name</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editProfessionModal-@p.Id">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteProfessionModal-@p.Id">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                <!-- Edit Modal -->
                                <div class="modal fade" id="editProfessionModal-@p.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="UpdateProfession" method="post">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <div class="modal-header bg-light">
                                                    <h5 class="modal-title"><i class="fas fa-edit text-primary me-2"></i>Branş Düzenle</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Branş Adı</label>
                                                        <input type="text" name="name" class="form-control" value="@p.Name" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer bg-light">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                    <button type="submit" class="btn btn-primary">Kaydet</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteProfessionModal-@p.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content border-danger">
                                            <form asp-action="DeleteProfession" method="post">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Silme Onayı</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0"><strong>@p.Name</strong> branşını silmek istediğinize emin misiniz?</p>
                                                    <p class="text-danger small mt-2">Bu işlem, bu branşın kullanıldığı tüm şablonları etkileyebilir.</p>
                                                </div>
                                                <div class="modal-footer bg-light">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                    <button type="submit" class="btn btn-danger">Evet, Sil</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                                    Henüz tanımlanmış bir iş branşı bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addProfessionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddProfession" method="post">
                <div class="modal-header bg-light">
                    <h5 class="modal-title"><i class="fas fa-plus text-primary me-2"></i>Yeni Branş Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Branş Adı <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="Örn: Seramikçi, Çatı Ustası" required />
                        <div class="form-text">Pazar yerindeki arama terimiyle aynı olmalıdır.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>