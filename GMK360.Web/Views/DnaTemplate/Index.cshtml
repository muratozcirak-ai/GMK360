@model List<GMK360.Core.Entities.Construction.Workflows.DnaTemplateStep>
@{
    ViewData["Title"] = "DNA Profil Şablonları";
    Layout = "~/Views/Shared/_ConstructionLayout.cshtml";
}
<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fas fa-network-wired text-primary me-2"></i>DNA Profil Şablonları (Tanımlamalar)</h3>
        <div>
            <a href="/DnaTemplate/Professions" class="btn btn-info shadow-sm me-2 text-white">
                <i class="fas fa-hard-hat me-1"></i> İş Branşlarını Yönet
            </a>
            <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addStepModal">
                <i class="fas fa-plus me-1"></i> Yeni Adım Ekle
            </button>
        </div>
    </div>
    
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0 fw-bold text-secondary"><i class="fas fa-list-ol me-2"></i> Adımlar</h5>
        </div>
        <div class="card-body">
            @if(Model != null && Model.Count > 0)
            {
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sıra No</th>
                            <th>Adım Adı</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var step in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@step.StepOrder</span></td>
                                <td class="fw-bold">@step.StepName</td>
                                <td class="text-end">
                                    <a href="/DnaTemplate/Questions?stepId=@step.Id" class="btn btn-sm btn-outline-info me-1"><i class="fas fa-list me-1"></i> Soruları Yönet</a>
                                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editStepModal-@step.Id">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-action="DeleteStep" asp-route-id="@step.Id" method="post" class="d-inline" onsubmit="return confirm('Bu adımı silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <!-- Edit Modal -->
                            <div class="modal fade" id="editStepModal-@step.Id" tabindex="-1" aria-hidden="true">
                              <div class="modal-dialog">
                                <div class="modal-content">
                                  <form asp-controller="DnaTemplate" asp-action="UpdateStep" method="post">
                                      <input type="hidden" name="id" value="@step.Id" />
                                      <div class="modal-header bg-light">
                                        <h5 class="modal-title"><i class="fas fa-edit text-primary me-2"></i>Adımı Düzenle</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body text-start">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Adım Adı <span class="text-danger">*</span></label>
                                            <input type="text" name="stepName" class="form-control" value="@step.StepName" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Sıra No</label>
                                            <input type="number" name="stepOrder" class="form-control" value="@step.StepOrder" required />
                                        </div>
                                      </div>
                                      <div class="modal-footer bg-light">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Güncelle</button>
                                      </div>
                                  </form>
                                </div>
                              </div>
                            </div>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning text-center mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i> Henüz hiçbir DNA şablon adımı eklenmemiş. Lütfen sağ üstten "Yeni Adım Ekle" butonuna tıklayarak başlayın.
                </div>
            }
        </div>
    </div>
</div>

<!-- Yeni Adım Ekle Modal -->
<div class="modal fade" id="addStepModal" tabindex="-1" aria-labelledby="addStepModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-controller="DnaTemplate" asp-action="AddStep" method="post">
          <div class="modal-header bg-light">
            <h5 class="modal-title" id="addStepModalLabel"><i class="fas fa-layer-group text-primary me-2"></i>Yeni Adım Ekle</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Adım Adı <span class="text-danger">*</span></label>
                <input type="text" name="stepName" class="form-control" placeholder="Örn: Adım 0: Mecburi Statik" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Sıra No</label>
                <input type="number" name="stepOrder" class="form-control" value="0" required />
                <div class="form-text">Listeleme sırasında hangi hizada çıkacağını belirler (Küçükten büyüğe).</div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Kaydet</button>
          </div>
      </form>
    </div>
  </div>
</div>