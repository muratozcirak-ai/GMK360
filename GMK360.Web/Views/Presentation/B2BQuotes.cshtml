@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "B2B Tedarikçi İhale Platformu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-handshake text-primary me-2"></i>B2B Tedarikçi İhale (Pazar Yeri)</h2>
        <span class="badge bg-dark fs-6"><i class="fas fa-project-diagram me-1"></i> DXF Entegre</span>
    </div>

    <!-- İhale Talebi Özeti -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <h5 class="card-title fw-bold text-secondary"><i class="fas fa-file-invoice me-2"></i>Aktif Talep (DXF'ten Okunan)</h5>
            <div class="row mt-3">
                <div class="col-md-3">
                    <p class="mb-1 text-muted small">Malzeme Grubu</p>
                    <p class="fw-bold">Ytong (20'lik Gazbeton)</p>
                </div>
                <div class="col-md-3">
                    <p class="mb-1 text-muted small">Toplam Metraj (DXF)</p>
                    <p class="fw-bold">10.000 m²</p>
                </div>
                <div class="col-md-3">
                    <p class="mb-1 text-muted small">Proje Konumu</p>
                    <p class="fw-bold">İstanbul / Ataşehir</p>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-outline-primary btn-sm"><i class="fas fa-sync-alt me-1"></i>Teklifleri Yenile</button>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3 text-secondary"><i class="fas fa-gavel me-2"></i>Gelen Teklifler</h4>

    <!-- Teklifler Tablosu -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Tedarikçi Firma</th>
                    <th class="text-center">Birim Fiyat (TL/m²)</th>
                    <th class="text-center">Ödeme Vadesi</th>
                    <th class="text-end">Toplam Maliyet</th>
                    <th class="text-center">Sistem Analizi</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><i class="fas fa-store text-muted me-2"></i>Yılmazlar Yapı Market</td>
                    <td class="text-center fw-bold">100,00 TL</td>
                    <td class="text-center"><span class="badge bg-info text-dark">Peşin</span></td>
                    <td class="text-end fw-bold">1.000.000 TL</td>
                    <td class="text-center"><span class="badge bg-secondary">En Ucuz / Nakit Gerekli</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary">İncele</button></td>
                </tr>
                <tr class="table-success border-success">
                    <td><i class="fas fa-store text-muted me-2"></i>Demirhan Lojistik & Malzeme <i class="fas fa-check-circle text-success ms-1" title="Sistem Tavsiyesi"></i></td>
                    <td class="text-center fw-bold text-success">105,00 TL</td>
                    <td class="text-center"><span class="badge bg-warning text-dark">30 Gün</span></td>
                    <td class="text-end fw-bold text-success">1.050.000 TL</td>
                    <td class="text-center"><span class="badge bg-success"><i class="fas fa-star text-warning"></i> Optimum Seçim</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-success fw-bold shadow-sm">Kabul Et</button></td>
                </tr>
                <tr>
                    <td><i class="fas fa-store text-muted me-2"></i>Güvenal İnşaat Malzemeleri</td>
                    <td class="text-center fw-bold">110,00 TL</td>
                    <td class="text-center"><span class="badge bg-danger">60 Gün</span></td>
                    <td class="text-end fw-bold">1.100.000 TL</td>
                    <td class="text-center"><span class="badge bg-secondary">Uzun Vade / Yüksek Fiyat</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary">İncele</button></td>
                </tr>
                <tr>
                    <td><i class="fas fa-store text-muted me-2"></i>Asya Tedarik A.Ş.</td>
                    <td class="text-center fw-bold">108,00 TL</td>
                    <td class="text-center"><span class="badge bg-warning text-dark">45 Gün</span></td>
                    <td class="text-end fw-bold">1.080.000 TL</td>
                    <td class="text-center"><span class="badge bg-secondary">Dengeli</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-secondary">İncele</button></td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <div class="mt-4 text-end">
        <a href="/Presentation/FeasibilitySimulator" class="btn btn-primary fw-bold px-4 shadow-sm">Fizibilite Simülatörüne Geç <i class="fas fa-arrow-right ms-2"></i></a>
    </div>
</div>
