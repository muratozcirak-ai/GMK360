@model IEnumerable<GMK360.Core.Entities.Message>
@{
    ViewData["Title"] = "Gelen Kutusu";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action active">Gelen Kutusu</a>
                <a href="#" class="list-group-item list-group-item-action">Gönderilenler</a>
                <a href="#" class="list-group-item list-group-item-action">Çöp Kutusu</a>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Mesajlarım</h4>
                </div>
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var msg in Model)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center @(msg.IsRead ? "" : "bg-light fw-bold")">
                                    <div>
                                        <h6 class="mb-1">@msg.Sender?.Email</h6>
                                        <p class="mb-0 text-muted">@(msg.Content.Length > 50 ? msg.Content.Substring(0, 50) + "..." : msg.Content)</p>
                                    </div>
                                    <small class="text-muted">@msg.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="ph ph-chat-teardrop-slash" style="font-size: 3rem;"></i>
                            <p class="mt-2">Henüz mesajınız bulunmuyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
