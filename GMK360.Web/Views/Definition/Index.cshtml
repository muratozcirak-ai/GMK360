@model IEnumerable<GMK360.Core.Entities.DefinitionCategory>
@{
    ViewData["Title"] = "Tanımlama Kategorileri";
    var systemCategories = new[] { "PROPERTY_STATUS", "PROPERTY_TYPE", "FROM_WHOM", "SUB_TYPE_RESIDENTIAL", "SUB_TYPE_COMMERCIAL", "SUB_TYPE_LAND" };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800 fw-bold">Genel Tanımlamalar (Kategoriler)</h2>
            <p class="text-muted mt-1">Emlak durumu, konut tipi, ısınma tipi gibi sistem geneli ayarlar</p>
        </div>
        <div>
            <a href="/Definition/LiabilityTypes" class="btn btn-outline-success me-2" style="border-radius: 8px;">
                <i class="ph ph-wallet me-2"></i>Finans/Vergi Türleri
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary" style="border-radius: 8px;">
                <i class="ph ph-desktop me-2"></i>Canlı Siteye Dön
            </a>
        </div>
    </div>

    <!-- Add Category Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
        <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3"><i class="ph ph-plus-circle me-2 text-primary"></i>Yeni Kategori Ekle</h5>
            <form asp-action="AddCategory" method="post" id="addCategoryForm">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select name="prefix" id="categoryType" class="form-select">
                                <option value="">Standart (Genel)</option>
                                <option value="DROPDOWN_">İlan Ekle - Açılır Liste</option>
                                <option value="PROPERTY_FEATURE_">İlan Ekle - Özellik Grubu</option>
                            </select>
                            <label for="categoryType">Kategori Tipi</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" name="name" id="catName" class="form-control" placeholder="Kategori Adı" required />
                            <label for="catName">Kategori Adı (Örn: İlan Durumu)</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold" style="border-radius: 10px;">
                            <i class="ph ph-plus me-1"></i> Ekle
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Category Accordion -->
    <div class="accordion shadow-sm" id="categoryAccordion" style="border-radius: 15px; overflow: hidden;">
        @foreach (var category in Model)
        {
            <div class="accordion-item border-0 border-bottom">
                <h2 class="accordion-header" id="heading-@category.Id">
                    <button class="accordion-button collapsed fw-bold bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@category.Id" aria-expanded="false" aria-controls="collapse-@category.Id">
                        <i class="ph ph-folder-open text-warning me-2 fs-5"></i>
                        @category.Name 
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 ms-3">@category.Values?.Count() Seçenek</span>
                    </button>
                </h2>
                <div id="collapse-@category.Id" class="accordion-collapse collapse" aria-labelledby="heading-@category.Id" data-bs-parent="#categoryAccordion">
                    <div class="accordion-body p-4 bg-white">
                        
                        <!-- Header Actions (Edit / Delete Category) -->
                        <div class="d-flex justify-content-end mb-3">
                            <button type="button" class="btn btn-sm btn-outline-warning me-2" data-bs-toggle="modal" data-bs-target="#editCatModal-@category.Id">
                                <i class="ph ph-pencil-simple"></i> Kategoriyi Düzenle
                            </button>
                            @if(!systemCategories.Contains(category.SystemCode))
                            {
                                <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi (ve içindeki tüm seçenekleri) silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@category.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="ph ph-trash"></i> Kategoriyi Sil
                                    </button>
                                </form>
                            }
                        </div>

                        <!-- Edit Modal -->
                        <div class="modal fade text-start" id="editCatModal-@category.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Kategori Düzenle</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-action="EditCategory" method="post">
                                        <div class="modal-body">
                                            <input type="hidden" name="id" value="@category.Id" />
                                            <div class="mb-3">
                                                <label class="form-label">Kategori Adı</label>
                                                <input type="text" name="name" class="form-control" value="@category.Name" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                            <button type="submit" class="btn btn-primary">Kaydet</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Values List -->
                        @if (category.Values != null && category.Values.Any())
                        {
                            <div class="table-responsive mb-4">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sıra</th>
                                            <th>Seçenek (Değer)</th>
                                            <th>Matris Ayarları</th>
                                            <th class="text-end">İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var val in category.Values.OrderBy(v => v.Order))
                                        {
                                            <tr>
                                                <td>@val.Order</td>
                                                <td class="fw-semibold">@val.Name</td>
                                                <td>
                                                    @if(val.HasCount) { <span class="badge bg-info">Adet Soruluyor</span> }
                                                    @if(!string.IsNullOrEmpty(val.SubOptions)) { <small class="text-muted">(@val.SubOptions)</small> }
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#editValModal-@val.Id"><i class="ph ph-pencil-simple"></i></button>
                                                    <form asp-action="DeleteValue" method="post" class="d-inline ms-1" onsubmit="return confirm('Bu seçeneği silmek istediğinize emin misiniz?');">
                                                        <input type="hidden" name="id" value="@val.Id" />
                                                        <input type="hidden" name="categoryId" value="@category.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ph ph-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>

                                            <!-- Edit Value Modal -->
                                            <div class="modal fade text-start" id="editValModal-@val.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Seçeneği Düzenle</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-action="EditValue" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@val.Id" />
                                                                <div class="mb-3">
                                                                    <label class="form-label">Seçenek Adı</label>
                                                                    <input type="text" name="name" class="form-control" value="@val.Name" required />
                                                                </div>
                                                                <div class="row mb-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label">Sıra No</label>
                                                                        <input type="number" name="order" class="form-control" value="@val.Order" />
                                                                    </div>
                                                                    <div class="col-md-6 d-flex align-items-end">
                                                                        <div class="form-check form-switch mb-2">
                                                                            <input class="form-check-input" type="checkbox" name="hasCount" value="true" @(val.HasCount ? "checked" : "") id="editHasCount-@val.Id">
                                                                            <label class="form-check-label" for="editHasCount-@val.Id">Adet Sorulsun mu?</label>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label">Alt Seçenekler (Virgülle ayırın)</label>
                                                                    <input type="text" name="subOptions" class="form-control" value="@val.SubOptions" placeholder="Örn: Açık,Kapalı" />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                                <button type="submit" class="btn btn-primary">Kaydet</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light text-center border text-muted">
                                Bu kategori altında henüz hiçbir seçenek yok.
                            </div>
                        }

                        <!-- Inline Add Value Form -->
                        <div class="card border border-primary border-opacity-25 bg-primary bg-opacity-10 mt-3">
                            <div class="card-body p-3">
                                <h6 class="text-primary mb-3"><i class="ph ph-plus-circle"></i> Hızlı Seçenek Ekle</h6>
                                <form asp-action="AddValue" method="post">
                                    <input type="hidden" name="categoryId" value="@category.Id" />
                                    <div class="row g-2 align-items-center">
                                        <div class="col-md-4">
                                            <input type="text" name="name" class="form-control form-control-sm" placeholder="Seçenek Adı (Örn: Asansör)" required />
                                        </div>
                                        <div class="col-md-2">
                                            <input type="number" name="order" class="form-control form-control-sm" placeholder="Sıra No" value="@((category.Values?.Count() ?? 0) + 1)" />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" name="subOptions" class="form-control form-control-sm" placeholder="Alt Seçe. (Virgüllü)" />
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <div class="form-check form-switch d-inline-block mt-1">
                                                <input class="form-check-input" type="checkbox" name="hasCount" value="true" id="hasCount-@category.Id">
                                                <label class="form-check-label small" for="hasCount-@category.Id">Adetli mi?</label>
                                            </div>
                                        </div>
                                        <div class="col-md-1">
                                            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="ph ph-plus"></i></button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
