@model IEnumerable<GMK360.Core.Entities.LiabilityType>
@{
    ViewData["Title"] = "Finansal Gider/Vergi Tanımlamaları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <!-- Navbar / Sidebar for Admin (Basit Bir Başlık) -->
    <div class="d-flex align-items-center mb-4">
        <a href="/Definition/Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h3 class="fw-bold mb-0">Finansal Gider Türleri (Liability Types)</h3>
            <p class="text-muted mb-0">Mülk sahiplerinin (Emlak Vergisi, Aidat, DASK vb.) takip edeceği finansal kalemler</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Yeni Ekleme -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 position-sticky" style="top: 2rem;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle text-primary me-2"></i> Yeni Tür Ekle</h5>
                    <form asp-action="AddLiabilityType" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Gider Adı</label>
                            <input type="text" name="name" class="form-control bg-light border-0" placeholder="Örn: Asansör Bakım Masrafı" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold">Kategori</label>
                            <select name="category" class="form-select bg-light border-0">
                                <option value="Vergi">Vergi</option>
                                <option value="Sigorta">Sigorta</option>
                                <option value="Sabit Gider">Sabit Gider (Aidat vb.)</option>
                                <option value="Özel Gider" selected>Özel Gider (Tadilat vb.)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Ekle</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Mevcut Liste -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-muted small">
                                <tr>
                                    <th>Gider Adı</th>
                                    <th>Kategorisi</th>
                                    <th>Sistem Tipi Mi?</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@item.Name</td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">@item.Category</span>
                                        </td>
                                        <td>
                                            @if (item.IsSystemType)
                                            {
                                                <i class="bi bi-lock-fill text-warning me-1" title="Sistem Tipi"></i> <small class="text-muted">Kilitli</small>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!item.IsSystemType)
                                            {
                                                <form asp-action="DeleteLiabilityType" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu gider türünü silmek istediğinize emin misiniz?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle"><i class="bi bi-trash"></i></button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light text-muted rounded-circle" disabled><i class="bi bi-slash-circle"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
