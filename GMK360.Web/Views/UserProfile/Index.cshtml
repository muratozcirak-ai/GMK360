@{
    ViewData["Title"] = "Profil Ayarlarım";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; // assuming a customer layout exists
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center">
                    <img src="https://ui-avatars.com/api/?name=User&background=random" class="rounded-circle mb-3" width="100" height="100" alt="Avatar">
                    <h5 class="fw-bold">Ahmet Yılmaz</h5>
                    <p class="text-muted small">Bireysel Üye</p>
                    <span class="badge bg-success"><i class="ph ph-check-circle"></i> e-Devlet Onaylı</span>
                </div>
            </div>
            
            <div class="list-group shadow-sm border-0">
                <a href="#kimlik" class="list-group-item list-group-item-action active" data-bs-toggle="list">Kimlik ve Görsel</a>
                <a href="#iletisim" class="list-group-item list-group-item-action" data-bs-toggle="list">İletişim & Doğrulama</a>
                <a href="#finans" class="list-group-item list-group-item-action" data-bs-toggle="list">Finans & IBAN</a>
                <a href="#guvenlik" class="list-group-item list-group-item-action" data-bs-toggle="list">Güvenlik & PIN Kodu</a>
            </div>
        </div>
        
        <div class="col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="tab-content">
                        
                        <!-- Kimlik -->
                        <div class="tab-pane fade show active" id="kimlik">
                            <h4 class="fw-bold mb-4">Kimlik ve Görsel</h4>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Ad</label>
                                    <input type="text" class="form-control" value="Ahmet" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Soyad</label>
                                    <input type="text" class="form-control" value="Yılmaz" readonly>
                                </div>
                                <div class="col-md-12 mt-4">
                                    <label class="form-label">Profil Fotoğrafı veya Şirket Logosu</label>
                                    <input type="file" class="form-control">
                                </div>
                                <div class="col-12 mt-4 text-end">
                                    <button class="btn btn-primary px-4">Kaydet</button>
                                </div>
                            </div>
                        </div>

                        <!-- Doğrulama -->
                        <div class="tab-pane fade" id="iletisim">
                            <h4 class="fw-bold mb-4">İletişim & Doğrulama</h4>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label">E-Posta Adresi</label>
                                    <input type="email" class="form-control" value="ahmet@example.com">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Cep Telefonu</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" value="0555 555 5555">
                                        <button class="btn btn-outline-success">SMS Onayı İste</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Finans -->
                        <div class="tab-pane fade" id="finans">
                            <h4 class="fw-bold mb-4">Finans & IBAN Bilgileri</h4>
                            <div class="alert alert-info">Nakit çekim talepleri (Withdrawal) için adınıza kayıtlı bir IBAN girmelisiniz.</div>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label">Hesap Sahibi</label>
                                    <input type="text" class="form-control" value="Ahmet Yılmaz">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">IBAN Numarası</label>
                                    <input type="text" class="form-control" placeholder="TR00 0000 0000 0000 0000 0000 00">
                                </div>
                                <div class="col-12 mt-3 text-end">
                                    <button class="btn btn-primary px-4">IBAN Kaydet</button>
                                </div>
                            </div>
                        </div>

                        <!-- Güvenlik / PIN -->
                        <div class="tab-pane fade" id="guvenlik">
                            <h4 class="fw-bold mb-4">Güvenlik & İşlem PIN Kodu</h4>
                            <div class="alert alert-warning">B2B modüllerinde evrak imzalarken veya para çekerken bu PIN kodu istenecektir.</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Yeni İşlem PIN Kodu (6 Hane)</label>
                                    <input type="password" class="form-control" maxlength="6" placeholder="******">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">PIN Kodu Tekrar</label>
                                    <input type="password" class="form-control" maxlength="6" placeholder="******">
                                </div>
                                <div class="col-12 mt-3 text-end">
                                    <button class="btn btn-primary px-4">PIN Oluştur</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>