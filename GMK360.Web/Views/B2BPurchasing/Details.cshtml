@model GMK360.Core.Entities.B2B.B2BQuoteRequest

@{
    ViewData["Title"] = Model.Title;
    var building = ViewBag.Building as GMK360.Core.Entities.Building;
    var meeting = ViewBag.Meeting as GMK360.Core.Entities.SystemMeeting;
    Layout = Model.SourceModule == "BuildingMeeting"
        ? "~/Views/Shared/_FacilityLayout.cshtml"
        : "~/Views/Shared/_ConstructionLayout.cshtml";
    var proj = ViewBag.Project as GMK360.Core.Entities.Construction.ConstructionProject;
    var legalDoc = ViewBag.LegalDocument as GMK360.Core.Entities.Construction.ProjectLegalDocument;
    var phonebookContacts = ViewBag.PhonebookContacts as List<GMK360.Core.Entities.Construction.AgencyPhonebook> ?? new List<GMK360.Core.Entities.Construction.AgencyPhonebook>();
    var b2bStatusMap = ViewBag.B2bStatusMap as Dictionary<string, GMK360.Core.Entities.B2b.B2bCompany> ?? new Dictionary<string, GMK360.Core.Entities.B2b.B2bCompany>();
    bool isPhaseZeroOrService = Model.SourceModule == "PhaseZeroDocument" || (Model.Items == null || !Model.Items.Any());
    int? newlyInvitedId = TempData["NewlyInvitedId"] as int?;
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-3 d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                <span class="fw-semibold">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                <span class="fw-semibold">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (Model.SourceModule == "PhaseZeroDocument" && proj != null)
                {
                    <a href="/ConstructionProject/Analysis/@proj.Id#burokrasiSec" class="btn btn-sm btn-outline-dark rounded-pill fw-bold px-3">
                        <i class="bi bi-arrow-left me-1"></i> Aday Projeye / Bürokrasi Masasına Dön (@proj.Name)
                    </a>
                }
                else if (Model.SourceModule == "ConstructionProject" && proj != null)
                {
                    <a href="/Metraj/DrawingArchive?projectId=@proj.Id#masterBomCard" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3">
                        <i class="bi bi-arrow-left me-1"></i> Şantiye Malzeme Matrisine Dön (@proj.Name)
                    </a>
                }
                else if (Model.SourceModule == "BuildingMeeting")
                {
                    <a href="/BuildingManager/Oylamalar@(building != null ? $"?buildingId={building.Id}" : "")" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3">
                        <i class="bi bi-arrow-left me-1"></i> Toplantı &amp; Karar Masasına Dön @(building != null ? $"({building.Name})" : "")
                    </a>
                }
                @if (Model.SourceModule != "BuildingMeeting")
                {
                    <a href="/B2BPurchasing/Index" class="btn btn-sm btn-light border rounded-pill text-muted px-3">
                        <i class="bi bi-list-ul me-1"></i> Tüm Satın Alma &amp; İhaleler
                    </a>
                }
            </div>
            <h3 class="fw-bold mb-0">@Model.Title</h3>
            <div class="text-muted small">
                Talep #@Model.Id | Oluşturulma: @Model.CreatedAt.ToString("dd MMM yyyy")
                @if (legalDoc != null && !string.IsNullOrEmpty(legalDoc.Stage))
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 ms-2">@legalDoc.Stage</span>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model.Status == "Draft" || Model.Status == "Published" || Model.Status == "Open")
            {
                <button class="btn btn-primary fw-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#inviteSupplierModal">
                    <i class="bi bi-person-plus-fill me-1"></i> + Tanıdık Firma / Usta Ekle & Link Gönder
                </button>
                var eligibleCount = (ViewBag.TotalEligibleMarketCompaniesCount as int?) ?? 0;
                if (eligibleCount > 0)
                {
                    <form method="post" action="/B2BPurchasing/BroadcastQuoteToMarketplace" class="d-inline" onsubmit="return confirm('Pazar yerindeki ilgili sektörde bulunan ' + @eligibleCount + ' firmaya açık ihale duyurusu ve teklif bağlantısı gönderilecek. Onaylıyor musunuz?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="quoteId" value="@Model.Id" />
                        <button type="submit" class="btn btn-warning text-dark fw-bold shadow-sm">
                            <i class="bi bi-megaphone-fill me-1"></i> Pazar Yerine Açık İhale Duyur (@eligibleCount Firma)
                        </button>
                    </form>
                }
            }
            else
            {
                <span class="badge bg-success p-2 px-3 fs-6"><i class="bi bi-check-all me-1"></i> Onaylandı & Tamamlandı</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- İşin İçeriği ve Kapsam Kartı -->
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-text text-primary me-2"></i>İşin İçeriği & Teklif Kapsamı</span>
                    @if (legalDoc != null && legalDoc.EstimatedCost.HasValue && legalDoc.EstimatedCost.Value > 0)
                    {
                        <span class="badge bg-light text-dark border px-3 py-2">
                            Referans / Önceki Maliyet: <strong class="text-primary">@legalDoc.EstimatedCost.Value.ToString("N0") ₺</strong>
                        </span>
                    }
                </div>
                <div class="card-body">
                    <p class="mb-3 text-dark fw-semibold">@Model.Description</p>
                    <div class="row text-muted small border-top pt-2">
                        <div class="col-sm-6">
                            <strong><i class="bi bi-calendar-event me-1"></i> Son Teklif Tarihi:</strong> @Model.Deadline.ToString("dd MMM yyyy")
                        </div>
                        <div class="col-sm-6">
                            <strong><i class="bi bi-geo-alt me-1"></i> Şantiye / Proje:</strong> @(proj?.Name ?? "Genel Şantiye") @( !string.IsNullOrEmpty(proj?.Address) ? $"({proj.Address})" : "" )
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sadece Malzeme Alımıysa Malzeme Kalemlerini Göster -->
            @if (!isPhaseZeroOrService)
            {
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                    <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-box-seam text-primary me-2"></i>İstenilen Malzemeler (Kalemler)</span>
                        @if (Model.Status == "Draft" || Model.Status == "Published" || Model.Status == "Open")
                        {
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addQuoteItemModal">
                                <i class="bi bi-plus"></i> Yeni Kalem Ekle
                            </button>
                        }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Malzeme (Katalog)</th>
                                    <th>Miktar</th>
                                    <th>Birim</th>
                                    <th>Açıklama</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@item.MaterialCatalog?.Name</td>
                                        <td><strong>@item.Quantity</strong></td>
                                        <td>@item.MaterialCatalog?.DefaultUnit</td>
                                        <td class="small text-muted">@item.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Davet Edilen Firmalar & Gelen Teklifler -->
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span><i class="bi bi-people-fill text-primary me-2"></i>Davet Edilen Firmalar / Ustalar ve Gelen Teklifler</span>
                    @if (Model.Status == "Draft" || Model.Status == "Published" || Model.Status == "Open")
                    {
                        <button class="btn btn-sm btn-primary fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#inviteSupplierModal">
                            <i class="bi bi-person-plus-fill me-1"></i> + Tanıdık Firma / Usta Ekle
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.Invites != null && Model.Invites.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Firma / Usta & Referans Durumu</th>
                                        <th>İletişim</th>
                                        <th>Teklif Fiyatı</th>
                                        <th>Durum & Keşif Randevusu</th>
                                        <th class="text-end">Link Gönder & İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invite in Model.Invites)
                                    {
                                        var compKey = (invite.NetworkContact?.CompanyName ?? "").Trim().ToLowerInvariant();
                                        b2bStatusMap.TryGetValue(compKey, out var b2bComp);
                                        bool isActiveMember = b2bComp != null && (b2bComp.InvitationStatus == GMK360.Core.Entities.B2b.B2bInvitationStatus.Active || b2bComp.InvitationStatus == GMK360.Core.Entities.B2b.B2bInvitationStatus.Pro);
                                        bool isNewRow = newlyInvitedId.HasValue && newlyInvitedId.Value == invite.Id;

                                        <tr class="@(isNewRow ? "table-success" : "")">
                                            <td>
                                                <div class="fw-bold text-dark">@invite.NetworkContact?.CompanyName</div>
                                                <div class="small text-muted">@invite.NetworkContact?.ContactPerson</div>
                                                @if (isActiveMember)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success small mt-1" title="Davet ettiğiniz firma gölgeden çıkıp sisteme dahil oldu! Kazan-Kazan referans kazancınız işlendi.">
                                                        <i class="bi bi-award-fill me-1"></i> Aktif Üye (Kazan-Kazan Referansı İşlendi)
                                                    </span>
                                                }
                                                else if (invite.OfferNotes != null && invite.OfferNotes.Contains("[AÇIK İHALE]"))
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary small mt-1">
                                                        <i class="bi bi-megaphone-fill me-1"></i> Pazar Yeri Açık İhale
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning bg-opacity-15 text-dark border border-warning small mt-1" title="Firma linke tıklayıp sisteme dahil olduğunda firmanız adına Kazan-Kazan referansı işlenir.">
                                                        <i class="bi bi-person-plus-fill me-1"></i> Tanıdık / Gölge Davet (Kazan-Kazan Adayı)
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="small">
                                                    @if (!string.IsNullOrEmpty(invite.NetworkContact?.PhoneNumber))
                                                    {
                                                        <div><i class="bi bi-telephone text-primary me-1"></i> @invite.NetworkContact.PhoneNumber</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(invite.NetworkContact?.Email))
                                                    {
                                                        <div><i class="bi bi-envelope text-muted me-1"></i> @invite.NetworkContact.Email</div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (invite.OfferedPrice.HasValue)
                                                {
                                                    <strong class="fs-5 text-success">@invite.OfferedPrice.Value.ToString("N2") ₺</strong>
                                                    <div class="small text-muted">@(invite.IsVatIncludedGlobally ? "KDV Dahil" : "KDV Hariç")</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Linkten yanıt bekleniyor</span>
                                                }
                                            </td>
                                            <td>
                                                @if (invite.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Pending)
                                                {
                                                    <span class="badge bg-secondary">Yanıt Bekliyor</span>
                                                }
                                                else if (invite.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Submitted)
                                                {
                                                    <span class="badge bg-success">Teklif Geldi</span>
                                                }
                                                else if (invite.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Accepted)
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check2-all"></i> Onaylandı / İşi Aldı</span>
                                                    <a href="/Agenda/Meetings" class="btn btn-xs btn-outline-primary rounded-pill px-2 d-inline-block mt-1" style="font-size:0.75rem;"><i class="bi bi-journal-text me-1"></i> Karar Masası</a>
                                                }

                                                @if (!string.IsNullOrEmpty(invite.OfferNotes))
                                                {
                                                    <div class="small mt-1" style="max-width:280px; white-space:normal;">
                                                        @if (invite.OfferNotes.Contains("[KEŞİF TALEBİ]"))
                                                        {
                                                            <div class="p-2 rounded bg-warning bg-opacity-25 border border-warning mb-2 shadow-xs">
                                                                <strong class="text-dark small d-block mb-1"><i class="bi bi-bell-fill text-warning me-1"></i> Görmem Lazım / Keşif Talebi!</strong>
                                                                <span class="text-secondary small d-block mb-2">@invite.OfferNotes</span>
                                                                <button type="button" class="btn btn-xs btn-warning text-dark fw-bold rounded-pill px-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#confirmInspectionModal_@invite.Id" style="font-size:0.75rem;">
                                                                    <i class="bi bi-calendar-check me-1"></i> Randevuyu Kesinleştir
                                                                </button>
                                                            </div>

                                                            <!-- Kesinleştirme Modalı -->
                                                            <div class="modal fade text-start" id="confirmInspectionModal_@invite.Id" tabindex="-1">
                                                                <div class="modal-dialog modal-dialog-centered">
                                                                    <div class="modal-content border-0 shadow-lg rounded-4">
                                                                        <div class="modal-header bg-warning text-dark border-0 py-3">
                                                                            <h5 class="modal-title fw-bold"><i class="bi bi-calendar-check me-2"></i> Keşif Randevusunu Kesinleştir</h5>
                                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                        </div>
                                                                        <form method="post" action="/B2BPurchasing/ConfirmInspectionAppointment">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="inviteId" value="@invite.Id" />
                                                                            <div class="modal-body p-4">
                                                                                <div class="alert alert-light border small text-muted mb-3">
                                                                                    <strong>@invite.NetworkContact?.CompanyName</strong> yetkilisiyle kararlaştırdığınız kesin saha buluşma gününü ve saatini giriniz.
                                                                                </div>
                                                                                <div class="row g-2 mb-3">
                                                                                    <div class="col-7">
                                                                                        <label class="form-label fw-bold small text-muted">
                                                                                            <i class="bi bi-calendar-event text-dark me-1"></i> ŞANTİYE BULUŞMA TARİHİ
                                                                                        </label>
                                                                                        <input type="date" name="appointmentDate" class="form-control fw-bold rounded-3" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                                                                                    </div>
                                                                                    <div class="col-5">
                                                                                        <label class="form-label fw-bold small text-muted">
                                                                                            <i class="bi bi-clock text-dark me-1"></i> BULUŞMA SAATİ
                                                                                        </label>
                                                                                        <input type="time" name="appointmentTime" class="form-control fw-bold rounded-3" value="10:00" required />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label fw-bold small text-muted">RANDEVU NOTU (TOPLANTI & KARAR MASASINA İŞLENECEK)</label>
                                                                                    <textarea name="managerNotes" class="form-control" rows="2" placeholder="Örn: Sahada yerinde inceleme ve numune/metraj tespiti yapılacak."></textarea>
                                                                                </div>
                                                                            </div>
                                                                            <div class="modal-footer bg-light border-0 p-3">
                                                                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                                                                                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">
                                                                                    <i class="bi bi-check2-circle me-1"></i> Onayla ve Takvime Kaydet
                                                                                </button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (invite.OfferNotes.Contains("[RANDEVU KESİNLEŞTİ]"))
                                                        {
                                                            <div class="p-2 rounded bg-success bg-opacity-10 border border-success mb-1">
                                                                <span class="badge bg-success mb-1"><i class="bi bi-calendar-check me-1"></i> Randevu Kesinleşti</span>
                                                                <span class="small text-dark d-block">@invite.OfferNotes</span>
                                                            </div>
                                                        }
                                                        else if (invite.OfferNotes.Contains("[Ödeme:"))
                                                        {
                                                            var termEnd = invite.OfferNotes.IndexOf(']');
                                                            var termText = termEnd > 0 ? invite.OfferNotes.Substring(1, termEnd - 1) : "";
                                                            var noteRest = termEnd > 0 && invite.OfferNotes.Length > termEnd + 1 ? invite.OfferNotes.Substring(termEnd + 1).Trim() : "";
                                                            <span class="badge bg-warning text-dark"><i class="bi bi-wallet2 me-1"></i>@termText</span>
                                                            @if (!string.IsNullOrEmpty(noteRest))
                                                            {
                                                                <span class="text-muted d-block mt-1">@noteRest</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted"><i class="bi bi-chat-left-dots me-1"></i>@invite.OfferNotes</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @{
                                                    var cleanPhone = (invite.NetworkContact?.PhoneNumber ?? "").Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "");
                                                    if (cleanPhone.StartsWith("0")) cleanPhone = "90" + cleanPhone.Substring(1);
                                                    else if (!cleanPhone.StartsWith("90") && !string.IsNullOrEmpty(cleanPhone)) cleanPhone = "90" + cleanPhone;

                                                    string mapsLink = "";
                                                    if (proj != null && proj.Latitude.HasValue && proj.Longitude.HasValue)
                                                    {
                                                        mapsLink = $"https://www.google.com/maps?q={proj.Latitude},{proj.Longitude}";
                                                    }
                                                    else if (proj != null && !string.IsNullOrEmpty(proj.Address))
                                                    {
                                                        mapsLink = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(proj.Address)}";
                                                    }

                                                    var portalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/B2BPartnerPortal/Invite/{invite.AccessToken}";
                                                    var recipientName = !string.IsNullOrEmpty(invite.NetworkContact?.ContactPerson) ? invite.NetworkContact.ContactPerson : invite.NetworkContact?.CompanyName;
                                                    var waMsg = $"Merhaba {recipientName},\n" +
                                                                $"📌 İşin Konusu: {Model.Title}\n" +
                                                                $"📝 İşin İçeriği: {Model.Description}\n" +
                                                                (!string.IsNullOrEmpty(mapsLink) ? $"📍 Şantiye Konumu: {mapsLink}\n" : "") +
                                                                $"🔗 Fiyat teklifinizi girmek veya 'Sahayı Görmem Lazım (Keşif Randevusu)' talebi iletmek için özel bağlantınız:\n{portalUrl}";
                                                }
                                                @if (!string.IsNullOrEmpty(cleanPhone))
                                                {
                                                    <a href="https://wa.me/@cleanPhone?text=@Uri.EscapeDataString(waMsg)" target="_blank" class="btn btn-sm btn-success fw-bold me-1" title="İşin içeriği ve konumla birlikte WhatsApp'tan davet linki gönder">
                                                        <i class="bi bi-whatsapp"></i> WhatsApp Link Gönder
                                                    </a>
                                                }
                                                <a href="/B2BPartnerPortal/Invite/@invite.AccessToken" target="_blank" class="btn btn-sm btn-outline-primary fw-bold me-1" title="Karşı Tarafa Giden Teklif & Randevu Ekranını Aç">
                                                    <i class="bi bi-box-arrow-up-right"></i> Linki Aç (Karşı Taraf Ekranı)
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="navigator.clipboard.writeText('@portalUrl'); alert('Özel davet linki kopyalandı:\n@portalUrl');" title="Linki Kopyala">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>

                                                @if (invite.Status == GMK360.Core.Entities.B2B.QuoteInviteStatus.Submitted && (Model.Status == "Draft" || Model.Status == "Published" || Model.Status == "Open"))
                                                {
                                                    <button type="button" class="btn btn-sm btn-success fw-bold mt-1" data-bs-toggle="modal" data-bs-target="#acceptQuoteModal_@invite.Id">
                                                        <i class="bi bi-check-circle me-1"></i> Teklifi Onayla
                                                    </button>

                                                    <!-- Accept Modal for this Invite -->
                                                    <div class="modal fade text-start" id="acceptQuoteModal_@invite.Id" tabindex="-1">
                                                        <div class="modal-dialog modal-lg">
                                                            <div class="modal-content border-0 shadow-lg">
                                                                <div class="modal-header bg-success text-white">
                                                                    <h5 class="modal-title fw-bold">Teklifi Onayla & Cariye İşle</h5>
                                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <form method="post" action="/B2BPurchasing/AcceptAndComplete">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="quoteRequestId" value="@Model.Id" />
                                                                    <input type="hidden" name="inviteId" value="@invite.Id" />

                                                                    <div class="modal-body">
                                                                        <div class="alert alert-info small mb-3">
                                                                            <strong>@invite.NetworkContact?.CompanyName</strong> firmasının <strong>@invite.OfferedPrice?.ToString("N2") ₺</strong> tutarındaki teklifini onaylıyorsunuz. Sistem otomatik olarak:
                                                                            <ul class="mb-0 mt-1">
                                                                                @if (Model.SourceModule == "PhaseZeroDocument")
                                                                                {
                                                                                    <li><strong>Evrak ve Bürokrasi Masası</strong>'ndaki ilgili satırın maliyetini ve kurum adını güncelleyecek.</li>
                                                                                }
                                                                                <li>Firma için <strong>Cari Hesap</strong> (yoksa) açıp tutarı işleyecek.</li>
                                                                                <li><strong>Toplantı & Karar Masası</strong>'na iş/teslimat takip kaydı oluşturacak.</li>
                                                                            </ul>
                                                                        </div>

                                                                        @if (!isPhaseZeroOrService)
                                                                        {
                                                                            <h6 class="fw-bold border-bottom pb-2">Tedarikçi Kalem Fiyatları (Özet)</h6>
                                                                            <table class="table table-sm table-bordered align-middle">
                                                                                <thead class="table-light small">
                                                                                    <tr>
                                                                                        <th>Malzeme</th>
                                                                                        <th class="text-end" style="width: 120px;">İstenen</th>
                                                                                        <th class="text-end" style="width: 120px;">Alınacak Miktar</th>
                                                                                        <th class="text-end">Birim Fiyat</th>
                                                                                        <th class="text-end">Ara Toplam</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @if (invite.InviteItems != null && invite.InviteItems.Any())
                                                                                    {
                                                                                        int i = 0;
                                                                                        foreach (var invItem in invite.InviteItems)
                                                                                        {
                                                                                            <tr id="row_@invite.Id\_@i">
                                                                                                <td class="small fw-semibold">
                                                                                                    @(invItem.QuoteItem?.MaterialCatalog?.Name ?? invItem.QuoteItem?.Description ?? "Malzeme Kalemi")
                                                                                                    <input type="hidden" name="inviteItemIds" value="@invItem.Id" />
                                                                                                    <input type="hidden" id="price_@invite.Id\_@i" value="@invItem.OfferedUnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                                                                                </td>
                                                                                                <td class="small text-end text-muted">@invItem.QuoteItem?.Quantity @invItem.QuoteItem?.MaterialCatalog?.DefaultUnit</td>
                                                                                                <td class="small text-end">
                                                                                                    <input type="number" step="0.01" min="0" name="acceptedQuantities" class="form-control form-control-sm text-end qty-input" data-invite="@invite.Id" data-index="@i" value="@((invItem.QuoteItem?.Quantity ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                                                                                                </td>
                                                                                                <td class="small text-end fw-bold text-primary">@invItem.OfferedUnitPrice.ToString("N2") ₺</td>
                                                                                                <td class="small text-end fw-bold row-total-@invite.Id" id="rowTotal_@invite.Id\_@i">@((invItem.OfferedUnitPrice * (invItem.QuoteItem?.Quantity ?? 0)).ToString("N2")) ₺</td>
                                                                                            </tr>
                                                                                            i++;
                                                                                        }
                                                                                    }
                                                                                    else if (Model.Items != null && Model.Items.Any())
                                                                                    {
                                                                                        int i = 0;
                                                                                        foreach (var qItem in Model.Items)
                                                                                        {
                                                                                            <tr id="row_@invite.Id\_@i">
                                                                                                <td class="small fw-semibold">
                                                                                                    @(qItem.MaterialCatalog?.Name ?? qItem.Description ?? "Malzeme Kalemi")
                                                                                                </td>
                                                                                                <td class="small text-end text-muted">@qItem.Quantity @(qItem.MaterialCatalog?.DefaultUnit ?? "Adet")</td>
                                                                                                <td class="small text-end">@qItem.Quantity.ToString("N2")</td>
                                                                                                <td class="small text-end text-muted">Toplu Paket Fiyatına Dahil</td>
                                                                                                <td class="small text-end fw-bold">-</td>
                                                                                            </tr>
                                                                                            i++;
                                                                                        }
                                                                                    }
                                                                                </tbody>
                                                                                <tfoot class="table-light">
                                                                                    <tr>
                                                                                        <td colspan="4" class="text-end fw-bold">Genel Anlaşma Toplamı:</td>
                                                                                        <td class="text-end fw-bold text-success fs-6" id="grandTotal_@invite.Id">@invite.OfferedPrice?.ToString("N2") ₺</td>
                                                                                    </tr>
                                                                                </tfoot>
                                                                            </table>

                                                                            <div class="row g-3 mb-3 mt-2">
                                                                                <div class="col-md-6">
                                                                                    <label class="form-label fw-bold small">Malzemeler Hangi Şantiyeye / Depoya İnecek?</label>
                                                                                    <select name="warehouseId" class="form-select">
                                                                                        <option value="">-- Depo Seçiniz (Opsiyonel) --</option>
                                                                                        @foreach (var wh in ViewBag.Warehouses)
                                                                                        {
                                                                                            <option value="@wh.Id">@wh.Name</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <div class="col-md-6">
                                                                                    <label class="form-label fw-bold small">Şantiyede Kim Teslim Alacak?</label>
                                                                                    <select name="assignedUserId" class="form-select">
                                                                                        <option value="">-- Sorumlu Personel Seçiniz --</option>
                                                                                        @foreach (var cons in ViewBag.Consultants)
                                                                                        {
                                                                                            <option value="@cons.UserId">@cons.User.DisplayName (@cons.User.PhoneNumber)</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                        <div class="card p-3 bg-light border-0 rounded-3 mb-2">
                                                                            <label class="form-label fw-bold small text-muted text-uppercase mb-2"><i class="bi bi-wallet2 text-success me-1"></i> Anlaşma Onay & Cari Bağlantı Modu</label>
                                                                            <div class="form-check mb-2 p-2 px-3 rounded border border-success bg-white">
                                                                                <input class="form-check-input ms-0 me-2" type="radio" name="approvalMode" id="purContractOnly_@invite.Id" value="ContractOnly" checked onclick="document.getElementById('purDueDateDiv_@invite.Id').style.display='none';" />
                                                                                <label class="form-check-label fw-bold text-success" for="purContractOnly_@invite.Id">
                                                                                    📋 Anlaşma Olarak Cariye Bağla (Toplu Fiyat & Birim Fiyatlar Caride Dursun, Sipariş Verdikçe Ödensin)
                                                                                </label>
                                                                                <small class="d-block text-muted mt-1">Onayladığınızda <strong>Firma Carisi</strong> açılır; <strong>@invite.OfferedPrice?.ToString("N2") ₺</strong> toplu anlaşma tutarı <em>Beklenen Çıkış (Ödenmemiş Anlaşma)</em> olarak ve tüm <strong>Birim Fiyatlar</strong> cariye kaydedilir. Şartları ve ödeme planını caride belirler, oradan birim fiyatlarla sipariş verirsiniz.</small>
                                                                            </div>
                                                                            <div class="form-check mb-2 px-3">
                                                                                <input class="form-check-input" type="radio" name="approvalMode" id="purVadeli_@invite.Id" value="Vadeli" onclick="document.getElementById('purDueDateDiv_@invite.Id').style.display='block';" />
                                                                                <label class="form-check-label fw-bold text-dark" for="purVadeli_@invite.Id">
                                                                                    ⏱️ Hemen Tamamını Faturalandır / Vadeli Borca İşle
                                                                                </label>
                                                                                <small class="d-block text-muted">Tüm paket tutarı doğrudan firma cari hesabına kesinleşmiş borç olarak işlenir.</small>
                                                                            </div>
                                                                            <div class="form-check px-3">
                                                                                <input class="form-check-input" type="radio" name="approvalMode" id="purPesin_@invite.Id" value="Pesin" onclick="document.getElementById('purDueDateDiv_@invite.Id').style.display='none';" />
                                                                                <label class="form-check-label fw-bold text-dark" for="purPesin_@invite.Id">
                                                                                    💵 Peşin Ödendi (Kasa / Banka Çıkışı Yapıldı)
                                                                                </label>
                                                                                <small class="d-block text-muted">Ödeme işlenir, cari hesap bakiyesi kapatılır.</small>
                                                                            </div>
                                                                            <div class="mt-3" id="purDueDateDiv_@invite.Id" style="display:none;">
                                                                                <label class="form-label fw-bold small text-muted">ÖDEME VADESİ (SON ÖDEME GÜNÜ)</label>
                                                                                <input type="date" name="dueDate" class="form-control" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer bg-light">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                                        <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-check-circle me-1"></i> Teklifi Onayla & Firma Carisini Aç</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-send-plus fs-1 text-primary opacity-50 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Henüz Firma veya Usta Davet Edilmedi</h6>
                            <p class="small mb-3 px-4">Kendi tanıdığınız firmayı/ustayı <strong>Ad Soyad, Firma ve Telefon</strong> bilgisiyle ekleyip işin içeriğiyle birlikte doğrudan davet linki gönderebilir veya alttaki <strong>Pazar Yeri</strong> listesinden seçebilirsiniz.</p>
                            <button class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#inviteSupplierModal">
                                <i class="bi bi-person-plus-fill me-1"></i> + Tanıdık Firma / Usta Ekle & Link Gönder
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ Sütun: Kazan-Kazan (Win-Win) ve Süreç Özeti -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px; background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-3 p-2 me-3 shadow-sm">
                            <i class="bi bi-award-fill fs-4"></i>
                        </div>
                        <div>
                            <span class="badge bg-warning text-dark fw-bold mb-1">KAZAN - KAZAN SİSTEMİ</span>
                            <h6 class="fw-bold text-dark mb-0">Tanıdık Firma / Usta Daveti Nasıl Çalışır?</h6>
                        </div>
                    </div>
                    <ol class="small text-secondary ps-3 mb-0" style="line-height: 1.65;">
                        <li class="mb-2">
                            <strong class="text-dark">Ad Soyad, Firma ve Telefon Girin:</strong> Tanıdığınız ustayı veya firmayı işin içeriğiyle birlikte eklediğinizde sistem ona özel bir <strong>Teklif & Randevu Linki</strong> üretir.
                        </li>
                        <li class="mb-2">
                            <strong class="text-dark">İster Fiyat Versin, İster Keşif İstesin:</strong> Karşı taraf linki açtığında şantiye konumunu ve işin içeriğini görür; doğrudan fiyatını yazar ya da <em>"Görmem lazım (Keşif Randevusu)"</em> talep eder.
                        </li>
                        <li>
                            <strong class="text-dark">Referans Kazancı (Kazan-Kazan):</strong> Davet ettiğiniz firma sözlü görüşmüş olsanız bile bu linkten girip gölge hesaptan aktif kullanıcıya geçtiğinde, <strong>firmanız adına Kazan-Kazan referans kazancı</strong> otomatik işlenir!
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Yeni Kalem Ekle -->
    <div class="modal fade" id="addQuoteItemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Yeni Kalem Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/B2BPurchasing/AddQuoteItem">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quoteRequestId" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Katalogdan Malzeme Seçiniz</label>
                            <select name="materialCatalogId" class="form-select" required>
                                <option value="">-- Malzeme Seçiniz --</option>
                                <option value="1">Çimento (50kg)</option>
                                <option value="2">Demir (12mm)</option>
                                <option value="3">El Arabası</option>
                                <option value="4">Kürek</option>
                                <option value="5">Kürek Sapı</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Miktar</label>
                            <input type="number" step="0.01" name="quantity" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Özel Açıklama (Opsiyonel)</label>
                            <textarea name="description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Sepete Ekle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Tanıdık Firma / Usta Ekle & Link Gönder -->
    <div class="modal fade" id="inviteSupplierModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white border-0 py-3">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Tanıdık Firma / Usta Ekle & Link Gönder</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/B2BPurchasing/InviteSupplier">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quoteId" value="@Model.Id" />
                    <div class="modal-body p-4">
                        <div class="alert alert-primary bg-opacity-10 border-primary border-opacity-25 small mb-3">
                            <i class="bi bi-award-fill text-primary me-1"></i>
                            <strong>Kazan-Kazan Davet Linki:</strong> Firma/usta adını, yetkiliyi ve telefonu girdiğinizde işin içeriğiyle birlikte özel teklif/randevu linki hazırlanır. Davet edilen firma sisteme dahil olduğunda <strong>firmanız adına referans kazancı</strong> işlenir.
                        </div>

                        @if (phonebookContacts.Any())
                        {
                            <div class="mb-3 p-2 px-3 bg-light rounded-3 border">
                                <label class="form-label fw-bold small text-primary mb-1">
                                    <i class="bi bi-journal-bookmark-fill me-1"></i> Rehberimdeki Tanıdık Firma / Ustadan Hızlı Doldur (Opsiyonel)
                                </label>
                                <select class="form-select form-select-sm" id="quickPhonebookSelect" onchange="fillFromPhonebook(this)">
                                    <option value="">-- Yeni Firma/Usta Yazacağım veya Rehberden Seçin --</option>
                                    @foreach (var pb in phonebookContacts)
                                    {
                                        <option value="@pb.Id"
                                                data-name="@pb.Name"
                                                data-person="@pb.AuthorizedPerson"
                                                data-phone="@pb.PhoneNumber"
                                                data-email="@pb.Email">
                                            @pb.Name @(!string.IsNullOrEmpty(pb.AuthorizedPerson) ? $"({pb.AuthorizedPerson})" : "") - @pb.PhoneNumber
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Firma veya Usta Adı <span class="text-danger">*</span></label>
                            <input type="text" name="companyName" id="invCompanyName" class="form-control" placeholder="Örn: Özkan Yapı Denetim / Hasan Usta Hafriyat" required />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Ad Soyad (Yetkili / Usta) <span class="text-danger">*</span></label>
                                <input type="text" name="contactPerson" id="invContactPerson" class="form-control" placeholder="Örn: Ahmet Özkan" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Telefon (Link Gidecek Numara) <span class="text-danger">*</span></label>
                                <input type="text" name="phoneNumber" id="invPhoneNumber" class="form-control" placeholder="05XX XXX XX XX" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">İşin İçeriği & Firmaya Gidecek Açıklama</label>
                            <textarea name="workDescription" class="form-control" rows="2" placeholder="Yapılacak işin detayını yazınız...">@Model.Description</textarea>
                            <div class="form-text small">Karşı taraf linki açtığında bu açıklamayı ve şantiye konumunu görerek fiyat verecek veya keşif randevusu isteyecektir.</div>
                        </div>

                        <div class="mb-1">
                            <label class="form-label small text-muted">E-Posta (Opsiyonel)</label>
                            <input type="email" name="email" id="invEmail" class="form-control form-control-sm" placeholder="ornek@firma.com" />
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4">
                            <i class="bi bi-link-45deg me-1"></i> Kaydet ve Davet Linki Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- AKILLI PAZAR YERİ ÖNERİ MOTORU -->
    <div class="row mt-2">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-white" style="border-radius: 12px; overflow:hidden;">
                <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: white;">
                    <div class="fw-bold fs-5">
                        <i class="bi bi-stars text-warning me-2"></i> Pazar Yerinden Bul & Sektöre Açık İhale Duyur
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (ViewBag.TotalEligibleMarketCompaniesCount != null && (int)ViewBag.TotalEligibleMarketCompaniesCount > 0 && (Model.Status == "Draft" || Model.Status == "Published"))
                        {
                            var totalEligible = (int)ViewBag.TotalEligibleMarketCompaniesCount;
                            <form method="post" action="/B2BPurchasing/BroadcastQuoteToMarketplace" class="d-inline" onsubmit="return confirm('Pazar yerindeki ilgili sektörde bulunan ' + @totalEligible + ' firmaya açık ihale duyurusu ve teklif bağlantısı gönderilecek. Onaylıyor musunuz?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="quoteId" value="@Model.Id" />
                                <button type="submit" class="btn btn-warning text-dark fw-bold px-3 py-1 shadow-sm">
                                    <i class="bi bi-megaphone-fill me-1"></i> Tüm Sektöre Açık İhale Duyur (@totalEligible Firma)
                                </button>
                            </form>
                        }
                        <span class="badge bg-white text-primary rounded-pill px-3 py-2">GMK360 Pazar Yeri Havuzu</span>
                    </div>
                </div>
                <div class="card-body bg-light p-4">
                    <p class="text-muted small mb-4">
                        <i class="bi bi-info-circle me-1"></i> Kendi tanıdığınız firmalar dışında, aradığınız <strong>@Model.Title</strong> alanında sistemde kayıtlı bölgesel firmalar aşağıda listelenmiştir. Tek tıkla davet linki gönderebilirsiniz.
                    </p>

                    @{
                        var recs = ViewBag.RecommendedCompanies as List<GMK360.Core.Entities.B2b.B2bCompany> ?? new List<GMK360.Core.Entities.B2b.B2bCompany>();
                    }
                    <div class="row g-3">
                        @if (recs.Any())
                        {
                            foreach (var rec in recs)
                            {
                                var contact = rec.Contacts?.FirstOrDefault();
                                <div class="col-md-4">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius:10px;">
                                        <div class="card-body position-relative">
                                            <div class="position-absolute top-0 end-0 mt-2 me-2">
                                                @if (rec.InvitationStatus == GMK360.Core.Entities.B2b.B2bInvitationStatus.Pro)
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill"><i class="bi bi-star-fill text-warning"></i> PRO Firma</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill"><i class="bi bi-shield-check"></i> Doğrulanmış</span>
                                                }
                                            </div>
                                            <h6 class="fw-bold mb-1 mt-2">@rec.Name</h6>
                                            <div class="text-warning small mb-2">
                                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                                <span class="text-muted ms-1">(@(rec.Rating > 0 ? rec.Rating.ToString("N1") : "5.0"))</span>
                                            </div>
                                            <p class="small text-muted mb-3">
                                                <i class="bi bi-geo-alt"></i> @(rec.Branches?.FirstOrDefault()?.City ?? "Merkez"), @(rec.Branches?.FirstOrDefault()?.District ?? "Ana Bölge")
                                                @if (contact != null && !string.IsNullOrEmpty(contact.MobilePhone))
                                                {
                                                    <br /><i class="bi bi-telephone text-primary"></i> @contact.MobilePhone
                                                }
                                            </p>

                                            <form method="post" action="/B2BPurchasing/InviteExistingB2bCompany">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="quoteId" value="@Model.Id" />
                                                <input type="hidden" name="b2bCompanyId" value="@rec.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-bold">
                                                    <i class="bi bi-send me-1"></i> Bunu da Davet Et
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                Bu kategoride sistemde henüz başka açık pazar yeri firması bulunamadı. Üstteki <strong>"+ Tanıdık Firma / Usta Ekle & Link Gönder"</strong> butonu ile dilediğiniz firmayı kolayca ekleyebilirsiniz.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillFromPhonebook(sel) {
            var opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) return;
            document.getElementById('invCompanyName').value = opt.getAttribute('data-name') || '';
            document.getElementById('invContactPerson').value = opt.getAttribute('data-person') || opt.getAttribute('data-name') || '';
            document.getElementById('invPhoneNumber').value = opt.getAttribute('data-phone') || '';
            document.getElementById('invEmail').value = opt.getAttribute('data-email') || '';
        }

        $(document).ready(function() {
            $('.qty-input').on('input', function() {
                var inviteId = $(this).data('invite');
                var grandTotal = 0;

                $('.qty-input[data-invite="' + inviteId + '"]').each(function() {
                    var idx = $(this).data('index');
                    var qty = parseFloat($(this).val()) || 0;
                    var priceStr = $('#price_' + inviteId + '_' + idx).val();
                    var price = parseFloat(priceStr.replace(',', '.')) || 0;

                    var rowTotal = qty * price;
                    $('#rowTotal_' + inviteId + '_' + idx).text(rowTotal.toFixed(2).replace('.', ',') + ' ₺');

                    if(qty === 0) {
                        $('#row_' + inviteId + '_' + idx).addClass('opacity-50 text-decoration-line-through');
                    } else {
                        $('#row_' + inviteId + '_' + idx).removeClass('opacity-50 text-decoration-line-through');
                    }

                    grandTotal += rowTotal;
                });

                $('#grandTotal_' + inviteId).text(grandTotal.toFixed(2).replace('.', ',') + ' ₺');
            });
        });
    </script>
}
