@model GMK360.Core.Entities.Identity.ApplicationUser
@{
    ViewData["Title"] = "Müşteri Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var properties = ViewBag.Properties as IEnumerable<GMK360.Core.Entities.Property>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Müşteri Profili</h2>
        </div>
        <a href="/AdminCRM/Index" class="btn btn-light rounded-pill"><i class="bi bi-arrow-left me-2"></i> CRM Listesi</a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 32px; font-weight: bold;">
                        @(string.IsNullOrEmpty(Model.FirstName) ? "G" : Model.FirstName[0].ToString())
                    </div>
                    <h4 class="fw-bold">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted mb-4">@Model.Email</p>

                    @if(Model.IsShadowAccount)
                    {
                        <div class="alert alert-secondary border-0 mb-0">
                            <strong>Gölge Kullanıcı:</strong> Bu hesap sistem veya bina yöneticisi tarafından oluşturuldu, henüz sahibi tarafından aktive edilmedi.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success border-0 mb-0">
                            <strong>Aktif Müşteri:</strong> Sistemimizi aktif olarak kullanıyor.
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary mb-0"><i class="bi bi-building me-2"></i>Kullanıcıya Ait Mülkler</h5>
                </div>
                <div class="card-body">
                    @if(properties != null && properties.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach(var prop in properties)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-light">
                                    <div>
                                        <h6 class="mb-1 fw-bold">@prop.Title</h6>
                                        <small class="text-muted">
                                            @if(prop.Building != null)
                                            {
                                                <span><i class="bi bi-geo-alt me-1"></i>Bina: @prop.Building.Name</span>
                                            }
                                        </small>
                                    </div>
                                    <span class="badge bg-light text-dark border">ID: @prop.Id</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Kullanıcıya ait herhangi bir mülk kaydı bulunamadı.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
