@using GMK360.Core.Entities
@{
    ViewData["Title"] = "Kurumlar, Siteler & Alt Domain Kişiselleştirme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var agencies = ViewBag.Agencies as List<Agency> ?? new List<Agency>();
    var projectCounts = ViewBag.ProjectCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var agencyOwners = ViewBag.AgencyOwners as Dictionary<int, string> ?? new Dictionary<int, string>();
    var complexes = ViewBag.Complexes as List<HousingComplex> ?? new List<HousingComplex>();
    var allRootBuildings = ViewBag.AllRootBuildings as List<Building> ?? new List<Building>();
    var standaloneBuildings = ViewBag.StandaloneBuildings as List<Building> ?? new List<Building>();
    var unitCounts = ViewBag.UnitCountsByBuilding as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-0 text-navy"><i class="ph ph-globe-hemisphere-west text-orange me-2"></i>Kurumlar, Siteler &amp; Alt Domain Kişiselleştirme</h2>
            <p class="text-muted mb-0">Sistemde kayıtlı inşaat/emlak firmaları ile site/apartman yönetimlerinin alt domain, logo, tema rengi ve kurumsal bilgilerini buradan özelleştirin.</p>
        </div>
        <form asp-action="AutoAssignMissingSubdomains" asp-controller="AdminCRM" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-dark rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-magic me-1"></i> Eksik Alt Domainleri Otomatik Ata
            </button>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. SİTELER VE APARTMAN YÖNETİMLERİ -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-buildings-fill me-2"></i>Site &amp; Apartman Yönetimleri (@(complexes.Count + standaloneBuildings.Count))</h5>
            <span class="badge bg-white text-success rounded-pill px-3">Bağımsız Site Kimliği &amp; Subdomain</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-3">Site / Apartman Adı</th>
                            <th>Alt Domain (`*.gmk360.com`)</th>
                            <th>Yönetim Tipi</th>
                            <th>Blok / Daire / Yönetici</th>
                            <th class="text-end pe-3">Kaydet / Önizle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cx in complexes)
                        {
                            var blocks = allRootBuildings.Where(b => b.HousingComplexId == cx.Id).ToList();
                            var mgrEmail = blocks.Select(b => b.ManagerUser?.Email).FirstOrDefault(e => !string.IsNullOrWhiteSpace(e)) ?? "-";
                            int totalUnits = blocks.Sum(b => unitCounts.TryGetValue(b.Id, out var c) ? c : 0);
                            var formId = $"cx-form-{cx.Id}";
                            <tr>
                                <td class="ps-3">
                                    <form id="@formId" asp-action="SaveSiteBranding" asp-controller="AdminCRM" method="post" class="d-none">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="complexId" value="@cx.Id" />
                                    </form>
                                    <input form="@formId" type="text" name="siteName" value="@cx.Name" class="form-control form-control-sm fw-bold" required />
                                    <small class="text-muted">@cx.District?.Name / @cx.City?.Name</small>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm" style="max-width:260px;">
                                        <input form="@formId" type="text" name="subdomain" value="@cx.Subdomain" class="form-control" placeholder="yesilvadi" />
                                        <span class="input-group-text">.gmk360.com</span>
                                    </div>
                                </td>
                                <td>
                                    <select form="@formId" name="isIndependentSite" class="form-select form-select-sm">
                                        @if (cx.IsIndependentSite)
                                        {
                                            <option value="true" selected>Bağımsız Site Yönetimi</option>
                                            <option value="false">Yönetim Firması Portföyü</option>
                                        }
                                        else
                                        {
                                            <option value="true">Bağımsız Site Yönetimi</option>
                                            <option value="false" selected>Yönetim Firması Portföyü</option>
                                        }
                                    </select>
                                </td>
                                <td class="small">
                                    <div><strong>@blocks.Count Blok</strong> • @totalUnits Daire</div>
                                    <div class="text-muted">Yönetici: @mgrEmail</div>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button form="@formId" type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">Kaydet</button>
                                        @if (!string.IsNullOrWhiteSpace(cx.Subdomain))
                                        {
                                            <a href="/TenantPortal/Site?subdomain=@cx.Subdomain" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-2" title="Site Kapısını Önizle">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        @foreach (var sb in standaloneBuildings)
                        {
                            int uCnt = unitCounts.TryGetValue(sb.Id, out var uc) ? uc : 0;
                            var formId = $"sb-form-{sb.Id}";
                            <tr>
                                <td class="ps-3">
                                    <form id="@formId" asp-action="SaveSiteBranding" asp-controller="AdminCRM" method="post" class="d-none">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="buildingId" value="@sb.Id" />
                                    </form>
                                    <input form="@formId" type="text" name="siteName" value="@sb.Name" class="form-control form-control-sm fw-bold" required />
                                    <small class="text-muted">@sb.District?.Name / @sb.City?.Name (Müstakil Bina)</small>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm" style="max-width:260px;">
                                        <input form="@formId" type="text" name="subdomain" value="@sb.Subdomain" class="form-control" placeholder="gunesapt" />
                                        <span class="input-group-text">.gmk360.com</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">Tekil Apartman</span>
                                </td>
                                <td class="small">
                                    <div><strong>@uCnt Daire</strong></div>
                                    <div class="text-muted">Yönetici: @(sb.ManagerUser?.Email ?? "-")</div>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button form="@formId" type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">Kaydet</button>
                                        @if (!string.IsNullOrWhiteSpace(sb.Subdomain))
                                        {
                                            <a href="/TenantPortal/Site?subdomain=@sb.Subdomain" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-2" title="Kapıyı Önizle">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. İNŞAAT & EMLAK FİRMALARI (AGENCIES) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-cone-striped me-2"></i>İnşaat &amp; Kurumsal Emlak Firmaları (@agencies.Count)</h5>
            <span class="badge bg-white text-primary rounded-pill px-3">Marka, Logo, Renk &amp; Özel Domain</span>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                @foreach (var ag in agencies)
                {
                    int projCount = projectCounts.TryGetValue(ag.Id, out var pc) ? pc : 0;
                    string ownerMail = agencyOwners.TryGetValue(ag.Id, out var om) ? om : "-";
                    string primaryCol = !string.IsNullOrWhiteSpace(ag.ThemePrimaryColor) && ag.ThemePrimaryColor.StartsWith("#") ? ag.ThemePrimaryColor : "#1d4ed8";
                    string accentCol = !string.IsNullOrWhiteSpace(ag.ThemeAccentColor) && ag.ThemeAccentColor.StartsWith("#") ? ag.ThemeAccentColor : "#f97316";
                    <div class="col-lg-6">
                        <form asp-action="SaveAgencyBranding" asp-controller="AdminCRM" method="post" enctype="multipart/form-data" class="border rounded-4 p-3 bg-light h-100">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="agencyId" value="@ag.Id" />
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(ag.LogoUrl) && ag.LogoUrl != "-" && !ag.LogoUrl.Contains("default-logo"))
                                    {
                                        <img src="@ag.LogoUrl" alt="@ag.CompanyName" style="height:36px;max-width:80px;object-fit:contain;" class="rounded bg-white p-1 border" />
                                    }
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary">#@ag.Id • @projCount Proje</span>
                                        <small class="text-muted d-block">Yetkili: @ownerMail</small>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ag.Subdomain) && ag.Subdomain != "-")
                                {
                                    <a href="@(projCount > 0 ? $"/TenantPortal/Construction?subdomain={ag.Subdomain}" : $"/AgencyStore/Index?subdomain={ag.Subdomain}")" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-3 fw-semibold">
                                        Vitrini Önizle &rarr;
                                    </a>
                                }
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-0">Firma Ünvanı</label>
                                    <input type="text" name="companyName" value="@ag.CompanyName" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-0">Alt Domain (`*.gmk360.com`)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" name="subdomain" value="@ag.Subdomain" class="form-control" placeholder="bayraktar" />
                                        <span class="input-group-text">.gmk360.com</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-0">Telefon / WhatsApp</label>
                                    <input type="text" name="whatsAppNumber" value="@(ag.WhatsAppNumber == "-" ? "" : ag.WhatsAppNumber)" class="form-control form-control-sm" placeholder="05XX..." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-0">Vergi No</label>
                                    <input type="text" name="taxNumber" value="@(ag.TaxNumber == "-" ? "" : ag.TaxNumber)" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-0">Özel Domain</label>
                                    <input type="text" name="customDomain" value="@(ag.CustomDomain == "-" ? "" : ag.CustomDomain)" class="form-control form-control-sm" placeholder="www.firma.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-0">Adres</label>
                                    <input type="text" name="address" value="@(ag.Address == "-" ? "" : ag.Address)" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-0">Ana Renk</label>
                                    <input type="color" name="themePrimaryColor" value="@primaryCol" class="form-control form-control-sm form-control-color w-100" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-0">Vurgu Rengi</label>
                                    <input type="color" name="themeAccentColor" value="@accentCol" class="form-control form-control-sm form-control-color w-100" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small fw-bold mb-0">Logo Yükle (PNG/JPG/WEBP)</label>
                                    <input type="file" name="logoFile" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp,.svg" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill fw-bold">Markayı Kaydet</button>
                                </div>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
