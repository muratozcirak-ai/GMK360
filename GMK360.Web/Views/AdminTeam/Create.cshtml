@{
    ViewData["Title"] = "Yeni Personel Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as IEnumerable<GMK360.Core.Entities.Identity.ApplicationRole>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Sistem Personeli Oluştur</h2>
            <p class="text-muted">Muhasebe, Satış veya Destek ekibiniz için yeni bir hesap açın.</p>
        </div>
        <a href="/AdminTeam/Index" class="btn btn-light rounded-pill"><i class="bi bi-arrow-left me-2"></i> Ekibe Dön</a>
    </div>

    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ad</label>
                                <input type="text" name="firstName" class="form-control bg-light border-0 py-2" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Soyad</label>
                                <input type="text" name="lastName" class="form-control bg-light border-0 py-2" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Kurumsal E-posta (Giriş ID)</label>
                            <input type="email" name="email" class="form-control bg-light border-0 py-2" placeholder="orn: muhasebe@gmk360.com" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Geçici Şifre</label>
                            <input type="password" name="password" class="form-control bg-light border-0 py-2" required />
                            <small class="text-muted">Personel ilk girişte şifresini değiştirebilir.</small>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold d-block mb-3">Departman / Yetki Rolleri</label>
                            <div class="row g-3">
                                @if(roles != null)
                                {
                                    @foreach(var role in roles)
                                    {
                                        <div class="col-md-4">
                                            <div class="form-check custom-checkbox bg-light p-3 rounded-3 border-0">
                                                <input class="form-check-input ms-1 me-2 mt-1" type="checkbox" name="selectedRoles" value="@role.Name" id="role_@role.Id">
                                                <label class="form-check-label fw-semibold" for="role_@role.Id">
                                                    @role.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold fs-5 shadow-sm">
                            <i class="bi bi-person-check me-2"></i> Personel Hesabını Oluştur
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
