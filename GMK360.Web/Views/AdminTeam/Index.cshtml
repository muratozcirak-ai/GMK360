@model IEnumerable<GMK360.Core.Entities.Identity.ApplicationUser>
@{
    ViewData["Title"] = "Platform Ekibi ve Yetkilendirme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roleMap = ViewBag.UserRolesMap as Dictionary<string, IList<string>>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Platform Ekibi</h2>
            <p class="text-muted">GMK360 Yönetim, Muhasebe, Pazarlama ve Destek personellerini buradan yönetin.</p>
        </div>
        <a href="/AdminTeam/Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-person-plus me-2"></i> Yeni Personel Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Ad Soyad</th>
                            <th>E-posta (Kullanıcı Adı)</th>
                            <th>Departman / Yetki Rolleri</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var user in Model)
                        {
                            var roles = roleMap != null && roleMap.ContainsKey(user.Id) ? roleMap[user.Id] : new List<string>();
                            var isSuspended = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow;
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                                            @(string.IsNullOrEmpty(user.FirstName) ? "A" : user.FirstName[0].ToString())
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@user.FirstName @user.LastName</h6>
                                            <small class="text-muted">ID: @user.Id.Substring(0,8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @foreach(var r in roles)
                                    {
                                        var badgeColor = r == "SuperAdmin" ? "bg-danger" : (r == "Muhasebe" ? "bg-success" : "bg-info");
                                        <span class="badge @badgeColor rounded-pill me-1">@r</span>
                                    }
                                </td>
                                <td>
                                    @if(isSuspended)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-lock me-1"></i> Askıda</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle me-1"></i> Aktif</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="ToggleStatus" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @if(user.Email != User.Identity.Name)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill">
                                                @(isSuspended ? "Aktifleştir" : "Askıya Al")
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Kendiniz</span>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
