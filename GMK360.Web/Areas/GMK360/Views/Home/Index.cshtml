<!-- Üye Kazanımı & Hizmetlerimiz Bölümü -->
<section class="py-5" style="background-color: #f8fafc;">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #1e293b;">Neden Bize Katılmalısınız?</h2>
            <p class="text-muted fs-5">Tek bir platformda gayrimenkul ve yaşam alanınızdaki tüm ihtiyaçlarınızı çözün.</p>
        </div>

        <div class="row g-4 text-center">
            <!-- Hizmet 1 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-hover" style="background: white;">
                    <div class="display-4 mb-3" style="color: #8b5cf6;"><i class="fas fa-home"></i></div>
                    <h4 class="fw-bold mb-3">Ev Sahipleri & Kiracılar</h4>
                    <p class="text-muted mb-4">Kiranızı takip edin, aidatlarınızı ödeyin ve evinizdeki arızalar için anında usta çağırın. Her şey tek ekranda.</p>
                    <a href="/Account/Register?role=resident" class="btn btn-outline-primary rounded-pill mt-auto fw-bold">Sakin Olarak Katıl</a>
                </div>
            </div>

            <!-- Hizmet 2 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-hover" style="background: white;">
                    <div class="display-4 mb-3" style="color: #ea580c;"><i class="fas fa-chart-line"></i></div>
                    <h4 class="fw-bold mb-3">Emlak Danışmanları</h4>
                    <p class="text-muted mb-4">Portföyünüzü milyonlara ulaştırın, yapay zeka ile değerleme yapın ve sıcak müşteri (Lead) havuzuna erişin.</p>
                    <a href="/Account/Register?role=consultant" class="btn btn-outline-warning rounded-pill mt-auto fw-bold text-dark">Danışman Olarak Katıl</a>
                </div>
            </div>

            <!-- Hizmet 3 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-hover" style="background: white;">
                    <div class="display-4 mb-3" style="color: #10b981;"><i class="fas fa-tools"></i></div>
                    <h4 class="fw-bold mb-3">Usta & Kurumsal Firmalar</h4>
                    <p class="text-muted mb-4">Bölgenizdeki tadilat ve tamirat ihalelerine teklif verin, yeni müşteriler bulun ve işinizi dijitalden büyütün.</p>
                    <a href="/Account/Register?role=serviceprovider" class="btn btn-outline-success rounded-pill mt-auto fw-bold">Hizmet Veren Ol</a>
                </div>
            </div>
        </div>
    </div>
</section>
