@{
    ViewData["Title"] = "GMK360 - Vitrin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Hero Bölümü (Vitrin) */
    .hero-vitrin {
        position: relative;
        background: url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center center / cover no-repeat;
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 80px; /* Navbar altından başlaması için */
        margin-top: -60px; /* Navbar'ı sönümlemek için, gerekirse kaldırılabilir */
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 900px;
        text-align: center;
    }

    .hero-title {
        color: white;
        font-weight: 800;
        font-size: 2.5rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        margin-bottom: 0.5rem;
    }

    .hero-subtitle {
        color: #e2e8f0;
        font-size: 1.1rem;
        margin-bottom: 2rem;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
    }

    /* Glassmorphism Arama Kutusu */
    .search-glass-panel {
        background: rgba(40, 40, 40, 0.6);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    /* Arama Sekmeleri */
    .nav-tabs-custom {
        border-bottom: 1px solid rgba(255,255,255,0.2);
        margin-bottom: 1.5rem;
    }
    .nav-tabs-custom .nav-link {
        color: #cbd5e1;
        border: none;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        background: transparent;
        transition: all 0.2s;
    }
    .nav-tabs-custom .nav-link:hover {
        color: white;
    }
    .nav-tabs-custom .nav-link.active {
        color: white;
        background: rgba(255,255,255,0.15);
        border-radius: 8px 8px 0 0;
        border-bottom: 2px solid #8b5cf6;
    }

    /* Form Elemanları */
    .search-glass-panel .form-select,
    .search-glass-panel .form-control {
        background: #f8fafc;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
    }
    .search-glass-panel .form-control::placeholder {
        color: #94a3b8;
    }
    .btn-search-primary {
        background: #8b5cf6;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: background 0.2s;
    }
    .btn-search-primary:hover {
        background: #7c3aed;
        color: white;
    }
    .radio-group label {
        color: white;
        margin-right: 1.5rem;
        cursor: pointer;
    }

    /* Vitrin İlanları */
    .vitrin-section {
        background: #ffffff;
        padding: 3rem 0;
    }
    .vitrin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 0.75rem;
    }
    .vitrin-header h3 {
        font-weight: 800;
        color: #1e293b;
        margin: 0;
        font-size: 1.4rem;
    }
    .btn-all-listings {
        color: #ea580c; /* Turuncu */
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
    }
    .btn-all-listings:hover {
        text-decoration: underline;
    }

    /* Vitrin Card (Zebra / Card Karışımı) */
    .property-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
        color: inherit;
        display: block;
        height: 100%;
        background: white;
    }
    .property-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        color: inherit;
    }
    .pc-image {
        position: relative;
        height: 180px;
        background: #f1f5f9;
    }
    .pc-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .pc-price-tag {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ea580c;
        color: white;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 1rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
    .pc-body {
        padding: 1rem;
    }
    .pc-title {
        font-weight: 700;
        color: #1e293b;
        font-size: 1rem;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pc-location {
        color: #64748b;
        font-size: 0.85rem;
    }
</style>

<!-- Hero Section -->
<section class="hero-vitrin">
    <div class="hero-overlay"></div>
    <div class="hero-content px-3">
        <h1 class="hero-title">Yeni Hayatınıza İlk Adımı Atın</h1>
        <p class="hero-subtitle">Türkiye'nin en seçkin gayrimenkul ve günlük kiralık portföyünü keşfedin.</p>

        <!-- Glassmorphism Arama Paneli -->
        <div class="search-glass-panel text-start">
            
            <!-- Sekmeler -->
            <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#konut" type="button" role="tab">
                        <i class="fas fa-home me-2"></i>Konut
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#isyeri" type="button" role="tab">
                        <i class="fas fa-city me-2"></i>İşyeri
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#arsa" type="button" role="tab">
                        <i class="fas fa-tree me-2"></i>Arsa
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#gunluk" type="button" role="tab">
                        <i class="fas fa-calendar-alt me-2"></i>Günlük Kiralık
                    </button>
                </li>
            </ul>

            <!-- İçerik -->
            <div class="tab-content">
                <div class="tab-pane fade show active" id="konut" role="tabpanel">
                    
                    <div class="radio-group mb-3 d-flex align-items-center">
                        <label class="d-flex align-items-center">
                            <input type="radio" name="IslemTipi" value="Satilik" class="form-check-input me-2 mt-0" checked>
                            Satılık
                        </label>
                        <label class="d-flex align-items-center">
                            <input type="radio" name="IslemTipi" value="Kiralik" class="form-check-input me-2 mt-0">
                            Kiralık
                        </label>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <select class="form-select">
                                <option>İl Seçin</option>
                                <option>İstanbul</option>
                                <option>Ankara</option>
                                <option>İzmir</option>
                                <option>Antalya</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select">
                                <option>İlçe Seçin</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select">
                                <option>Mahalle Seçin</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-4 d-flex align-items-center bg-light rounded" style="background: #f8fafc !important;">
                            <input type="text" class="form-control border-0 bg-transparent" placeholder="Min TL">
                            <span class="text-muted mx-1">-</span>
                            <input type="text" class="form-control border-0 bg-transparent" placeholder="Max TL">
                        </div>
                        <div class="col-md-4">
                            <select class="form-select">
                                <option>Oda Sayısı</option>
                                <option>1+1</option>
                                <option>2+1</option>
                                <option>3+1</option>
                                <option>4+1 ve üzeri</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-search-primary w-100 h-100">
                                <i class="fas fa-search me-2"></i>Arama Yap
                            </button>
                        </div>
                    </div>

                </div>
                
                <!-- Diğer sekmeler (Örnek) -->
                <div class="tab-pane fade" id="isyeri" role="tabpanel">
                    <p class="text-white mb-0">İşyeri arama filtreleri buraya gelecek...</p>
                </div>
                <div class="tab-pane fade" id="arsa" role="tabpanel">
                    <p class="text-white mb-0">Arsa arama filtreleri buraya gelecek...</p>
                </div>
                <div class="tab-pane fade" id="gunluk" role="tabpanel">
                    <p class="text-white mb-0">Günlük kiralık arama filtreleri buraya gelecek...</p>
                </div>
            </div>

        </div>
    </div>
</section>

