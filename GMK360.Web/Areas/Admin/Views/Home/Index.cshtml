@{
    ViewData["Title"] = "Admin Kontrol Paneli";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Genel Durum Özeti (Dashboard)</h1>
        <p class="text-muted small">Sistemdeki anlık hareketler ve istatistikler</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-secondary"><i class="bi bi-share"></i> Paylaş</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Dışa Aktar</button>
        </div>
        <button type="button" class="btn btn-sm btn-primary">
            <i class="bi bi-calendar"></i> Bu Hafta
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0" style="background: linear-gradient(135deg, var(--admin-primary) 0%, var(--admin-primary-dark) 100%);">
            <div class="card-body text-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase fw-semibold mb-0 opacity-75">Onay Bekleyen İlan</h6>
                    <div class="p-2 bg-white bg-opacity-25 rounded"><i class="bi bi-clock-history fs-5"></i></div>
                </div>
                <h2 class="display-5 fw-bold mb-0">12</h2>
                <div class="mt-2 text-white-50 small">
                    <i class="bi bi-arrow-up-right me-1"></i> Düne göre %5 artış
                </div>
            </div>
            <a href="/Admin/Moderation/Index" class="card-footer bg-transparent border-0 text-white text-decoration-none d-flex justify-content-between align-items-center py-3">
                <span class="small fw-semibold">Detayları Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
            <div class="card-body text-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase fw-semibold mb-0 opacity-75">Bekleyen Çekim</h6>
                    <div class="p-2 bg-white bg-opacity-25 rounded"><i class="bi bi-cash-coin fs-5"></i></div>
                </div>
                <h2 class="display-5 fw-bold mb-0">3</h2>
                <div class="mt-2 text-white-50 small">
                    <i class="bi bi-exclamation-circle me-1"></i> Bekleyen toplam ₺4.500
                </div>
            </div>
            <a href="/Admin/Finance/Index" class="card-footer bg-transparent border-0 text-white text-decoration-none d-flex justify-content-between align-items-center py-3">
                <span class="small fw-semibold">Detayları Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0" style="background: linear-gradient(135deg, var(--admin-secondary) 0%, #d97706 100%);">
            <div class="card-body text-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase fw-semibold mb-0 opacity-75 text-dark">Sistemdeki Emlakçılar</h6>
                    <div class="p-2 bg-dark bg-opacity-10 rounded"><i class="bi bi-building fs-5 text-dark"></i></div>
                </div>
                <h2 class="display-5 fw-bold mb-0 text-dark">450</h2>
                <div class="mt-2 text-dark opacity-75 small">
                    <i class="bi bi-people me-1"></i> Kurumsal üyeler
                </div>
            </div>
            <a href="/Admin/UserManager/Index" class="card-footer bg-transparent border-0 text-dark text-decoration-none d-flex justify-content-between align-items-center py-3">
                <span class="small fw-semibold">Detayları Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
            <div class="card-body text-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-uppercase fw-semibold mb-0 opacity-75">Sistemdeki Ustalar</h6>
                    <div class="p-2 bg-white bg-opacity-25 rounded"><i class="bi bi-tools fs-5"></i></div>
                </div>
                <h2 class="display-5 fw-bold mb-0">120</h2>
                <div class="mt-2 text-white-50 small">
                    <i class="bi bi-wrench me-1"></i> Hizmet veren üyeler
                </div>
            </div>
            <a href="/Admin/UserManager/Index" class="card-footer bg-transparent border-0 text-white text-decoration-none d-flex justify-content-between align-items-center py-3">
                <span class="small fw-semibold">Detayları Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <h5 class="fw-bold text-dark mb-3">Hızlı İşlemler & Ayarlar</h5>
    </div>
    
    <div class="col-md-4 mb-4">
        <a href="/Admin/DefinitionManager/Index" class="card shadow-sm h-100 text-decoration-none border-0 hover-lift transition-all">
            <div class="card-body text-center p-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                    <i class="ph ph-list-checks fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark">Dinamik Özellikler</h5>
                <p class="text-muted small mb-0">Ev, Bina ve İç özellikleri (Otopark, Asansör vb.) tanımlayın ve yönetin.</p>
            </div>
        </a>
    </div>
    
    <div class="col-md-4 mb-4">
        <a href="/Admin/UserManager/Index" class="card shadow-sm h-100 text-decoration-none border-0 hover-lift transition-all">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                    <i class="ph ph-users fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark">Kullanıcı Yönetimi</h5>
                <p class="text-muted small mb-0">Emlakçılar, Ev Sahipleri ve Ustaları yönetin.</p>
            </div>
        </a>
    </div>
    
    <div class="col-md-4 mb-4">
        <a href="/Admin/LegalAgreement/Index" class="card shadow-sm h-100 text-decoration-none border-0 hover-lift transition-all">
            <div class="card-body text-center p-4">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3 mb-3">
                    <i class="ph ph-file-text fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark">Sözleşme & Evraklar</h5>
                <p class="text-muted small mb-0">Kira sözleşme şablonlarını ve yasal metinleri güncelleyin.</p>
            </div>
        </a>
    </div>
</div>

<style>
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition-all {
        transition: all .3s ease;
    }
</style>

<div class="row mt-4">
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary">Aylık Sistem Hacmi (Geliştirilecek)</h6>
                <div class="dropdown no-arrow">
                    <a class="dropdown-toggle text-muted" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="#">Yenile</a></li>
                        <li><a class="dropdown-item" href="#">Rapor Çıkar</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-bar-chart-line display-1 opacity-25"></i>
                    <p class="mt-3">Buraya Chart.js veya ApexCharts entegrasyonu gelecek.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary">Son Aktiviteler</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-4 py-3 d-flex align-items-center">
                        <div class="bg-primary text-white rounded-circle p-2 me-3">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold">Yeni Emlakçı Kaydı</h6>
                            <small class="text-muted">Ahmet Yılmaz (İstanbul)</small>
                        </div>
                        <small class="text-muted ms-auto">5 dk</small>
                    </li>
                    <li class="list-group-item px-4 py-3 d-flex align-items-center">
                        <div class="bg-success text-white rounded-circle p-2 me-3">
                            <i class="bi bi-cash"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold">Para Çekim Talebi</h6>
                            <small class="text-muted">Mehmet Usta (₺1,500)</small>
                        </div>
                        <small class="text-muted ms-auto">12 dk</small>
                    </li>
                    <li class="list-group-item px-4 py-3 d-flex align-items-center">
                        <div class="bg-warning text-dark rounded-circle p-2 me-3">
                            <i class="bi bi-house-door"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-semibold">Yeni İlan Eklendi</h6>
                            <small class="text-muted">Kadıköy 3+1 Kiralık</small>
                        </div>
                        <small class="text-muted ms-auto">45 dk</small>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-white text-center py-3">
                <a href="#" class="text-decoration-none fw-semibold">Tümünü Gör</a>
            </div>
        </div>
    </div>
</div>

