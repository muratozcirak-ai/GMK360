@{
    ViewData["Title"] = "Dinamik Özellik ve Tanımlama Yönetimi";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Dinamik Özellik Yönetimi</h1>
        <p class="text-muted small">Mülk, Bina ve İç özellikleri (Otopark, Asansör, Duşakabin vb.) buradan sisteme ekleyip çıkarabilirsiniz.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
            <i class="ph ph-plus me-1"></i> Yeni Özellik Grubu Ekle
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Bina Özellikleri Kartı -->
    <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h6 class="m-0 fw-bold text-primary"><i class="ph ph-buildings me-2"></i>Bina Özellikleri</h6>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown">
                        <i class="ph ph-dots-three-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="ph ph-pencil-simple me-2"></i>Düzenle</a></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="ph ph-trash me-2"></i>Sil</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush border-top">
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Asansör</span>
                            <small class="text-muted d-block">Var / Yok</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Otopark (Açık)</span>
                            <small class="text-muted d-block">Mevcut</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Otopark (Kapalı)</span>
                            <small class="text-muted d-block">Mevcut</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">7/24 Güvenlik</span>
                            <small class="text-muted d-block">Var / Yok</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                </ul>
                <button class="btn btn-sm btn-outline-primary w-100 mt-3 border-dashed" data-bs-toggle="modal" data-bs-target="#newValueModal">
                    <i class="ph ph-plus me-1"></i> Yeni Seçenek Ekle
                </button>
            </div>
        </div>
    </div>

    <!-- İç Özellikler Kartı -->
    <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h6 class="m-0 fw-bold text-success"><i class="ph ph-armchair me-2"></i>İç Özellikler</h6>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown">
                        <i class="ph ph-dots-three-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="ph ph-pencil-simple me-2"></i>Düzenle</a></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="ph ph-trash me-2"></i>Sil</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush border-top">
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Duşakabin</span>
                            <small class="text-muted d-block">Var</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Ebeveyn Banyosu</span>
                            <small class="text-muted d-block">Var</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Cam Balkon</span>
                            <small class="text-muted d-block">Var</small>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                    </li>
                </ul>
                <button class="btn btn-sm btn-outline-success w-100 mt-3 border-dashed" data-bs-toggle="modal" data-bs-target="#newValueModal">
                    <i class="ph ph-plus me-1"></i> Yeni Seçenek Ekle
                </button>
            </div>
        </div>
    </div>
    
    <!-- Eşya Tanımları Kartı -->
    <div class="col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h6 class="m-0 fw-bold text-warning"><i class="ph ph-plug me-2"></i>Eşya ve Donanım Listesi</h6>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown">
                        <i class="ph ph-dots-three-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="ph ph-pencil-simple me-2"></i>Düzenle</a></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="ph ph-trash me-2"></i>Sil</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush border-top">
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Beyaz Eşya & Elektronik</span>
                            <small class="text-muted d-block">7 Alt Öğe (Buzdolabı, TV...)</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-light me-1"><i class="ph ph-list"></i></button>
                            <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                        </div>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Mutfak & Banyo</span>
                            <small class="text-muted d-block">5 Alt Öğe (Ankastre, Fırın...)</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-light me-1"><i class="ph ph-list"></i></button>
                            <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                        </div>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">Salon Mobilyaları</span>
                            <small class="text-muted d-block">4 Alt Öğe (Koltuk, Masa...)</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-light me-1"><i class="ph ph-list"></i></button>
                            <button class="btn btn-sm text-danger"><i class="ph ph-x"></i></button>
                        </div>
                    </li>
                </ul>
                <button class="btn btn-sm btn-outline-warning w-100 mt-3 border-dashed text-dark" data-bs-toggle="modal" data-bs-target="#newValueModal">
                    <i class="ph ph-plus me-1"></i> Yeni Eşya Kategorisi Ekle
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Yeni Kategori Ekle -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark"><i class="ph ph-folder-plus text-primary me-2"></i>Yeni Özellik Grubu Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Grup Adı</label>
                        <input type="text" class="form-control" placeholder="Örn: Manzara Özellikleri">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Sistem Kodu</label>
                        <input type="text" class="form-control" placeholder="Örn: VIEW_FEATURES">
                        <small class="text-muted">Boşluk bırakmadan İngilizce karakterlerle yazın.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Seçim Tipi</label>
                        <select class="form-select">
                            <option>Çoklu Seçim (Checkbox)</option>
                            <option>Tekli Seçim (Radio Button)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary px-4">Kaydet</button>
            </div>
        </div>
    </div>
</div>
