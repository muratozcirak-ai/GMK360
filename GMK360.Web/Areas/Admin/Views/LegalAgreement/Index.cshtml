@model IEnumerable<GMK360.Core.Entities.LegalAgreement>

@{
    ViewData["Title"] = "Sözleşme Yönetimi";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary"><i class="bi bi-file-earmark-text"></i> Yasal Sözleşmeler ve Metinler</h5>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sözleşme Adı</th>
                            <th>Tip</th>
                            <th>Versiyon</th>
                            <th>Durum</th>
                            <th>Zorunlu Mu?</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-bold">@item.Title</td>
                                <td><span class="badge bg-secondary">@item.Type</span></td>
                                <td>v@(item.Version)</td>
                                <td>
                                    @if(item.IsActive) { <span class="badge bg-success">Aktif</span> }
                                    else { <span class="badge bg-danger">Pasif</span> }
                                </td>
                                <td>
                                    @if(item.IsRequired) { <i class="bi bi-check-circle-fill text-success"></i> }
                                    else { <i class="bi bi-x-circle text-muted"></i> }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i> Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
