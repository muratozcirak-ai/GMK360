@model GMK360.Core.Entities.GlobalObligationRule

@{
    ViewData["Title"] = "Yeni Vergi/Kural Ekle";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary">Yeni Kural / Vergi Kesintisi Ekle</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-3">
                            <label asp-for="RuleName" class="form-label fw-bold">Kural Adı (Örn: 2026 Yılı Referans Stopajı)</label>
                            <input asp-for="RuleName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="TargetExpenseCategoryId" class="form-label fw-bold">Kategori / Tür</label>
                            <select asp-for="TargetExpenseCategoryId" class="form-select">
                                <option value="">Tüm Giderler / Genel Kural</option>
                                <option value="1">Stopaj Kesintisi</option>
                                <option value="2">Hizmet Bedeli</option>
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold">Geçerlilik Başlangıcı</label>
                                <input asp-for="StartDate" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold">Bitiş Tarihi (Boş bırakılabilir)</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-4 align-items-end">
                            <div class="col-md-8">
                                <label asp-for="Rate" class="form-label fw-bold">Kesinti Oranı (Örn: %20 için 0.20)</label>
                                <div class="input-group">
                                    <input asp-for="Rate" type="number" step="0.0001" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-12 mt-1">
                                <small class="text-muted">Lütfen ondalıklı olarak giriniz.</small>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                            <label class="form-check-label fw-bold" asp-for="IsActive">Aktif Et (Eski kuralı otomatik kapatır)</label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Geri Dön
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-plus-circle"></i> Kuralı Ekle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
