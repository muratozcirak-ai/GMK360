@model IEnumerable<GMK360.Core.Entities.GlobalObligationRule>

@{
    ViewData["Title"] = "Vergi ve Kural Motoru";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary"><i class="bi bi-bank"></i> Sistem Vergi ve Kesinti Kuralları</h5>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Yeni Kural Ekle
            </a>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="alert alert-info">
                <strong>Bilgi:</strong> Bir kural türünden aynı anda sadece 1 tanesi aktif olabilir. Yeni bir kural eklendiğinde, aynı türe ait eski kurallar otomatik olarak pasife alınır ve geçerlilik tarihleri bitirilir. (Geçmişe dönük raporların bozulmaması için eski kurallar silinmez).
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Kural Adı</th>
                            <th>Türü</th>
                            <th>Geçerlilik Aralığı</th>
                            <th>Oran / Tutar</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.RuleName</td>
                                <td>
                                    <span class="badge bg-secondary">@(item.TargetExpenseCategory?.Name ?? "Tümü")</span>
                                </td>
                                <td>
                                    <small>
                                        <i class="bi bi-calendar-check text-success"></i> @item.StartDate.ToShortDateString() <br />
                                        <i class="bi bi-calendar-x text-danger"></i> @(item.EndDate?.ToShortDateString() ?? "Süresiz")
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">%@(item.Rate * 100)</span>
                                </td>
                                <td>
                                    @if(item.IsActive) { <span class="badge bg-success">Aktif</span> }
                                    else { <span class="badge bg-danger">Pasif (Eski)</span> }
                                </td>
                                <td class="text-end">
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kuralı pasife almak istediğinize emin misiniz? Sistem yeni bir kural eklenene kadar bu işlemi dikkate almayacaktır.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle"></i> Pasife Al
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Sistemde tanımlı hiçbir kural bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
